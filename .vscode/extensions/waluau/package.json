{
  "name": "waluau-vscode",
  "displayName": "Waluau Language Server (repo-local)",
  "description": "Connects VS Code to the Waluau compiler's language server for .walu files",
  "version": "0.1.0",
  "publisher": "waluau-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.walu",
    "onLanguage:lua"
  ],
  "contributes": {
    "configuration": {
      "title": "Waluau",
      "properties": {
        "waluau.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the waluau-lsp executable or launcher. Empty uses the repo's tools/editors/waluau-lsp script, which builds the server on demand."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild extension.js --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --minify-whitespace"
  },
  "devDependencies": {
    "vscode-languageclient": "^9.0.1",
    "esbuild": "^0.24.0"
  }
}