{
  "name": "waluau-vscode",
  "displayName": "Waluau Language Support (repo-local)",
  "description": "Adds Waluau syntax highlighting and connects VS Code to the compiler's language server",
  "version": "0.1.0",
  "publisher": "waluau-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node ./esbuild.mjs",
    "check:bundle": "node ./esbuild.mjs --check",
    "test": "pnpm run check:bundle && node --test test/*.test.js"
  },
  "activationEvents": [
    "workspaceContains:**/*.walu",
    "onLanguage:waluau"
  ],
  "contributes": {
    "languages": [
      {
        "id": "waluau",
        "aliases": [
          "Waluau",
          "waluau"
        ],
        "extensions": [
          ".walu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "waluau",
        "scopeName": "source.waluau",
        "path": "./syntaxes/waluau.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Waluau",
      "properties": {
        "waluau.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the waluau-lsp executable or launcher. Empty uses the repo's tools/editors/waluau-lsp script, which builds the server on demand."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
