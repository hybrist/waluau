-- Core builtin functions
-- These are host functions that provide basic runtime functionality

-- Print a string to stdout
declare function print(message: string): unit

-- Lua pattern-matching primitives backing `string.find`/`string.match`/
-- `string.gmatch`/`string.gsub`. `pm_find`/`pm_match` return 1 when a match
-- was found and 0 otherwise; on success the match bounds and captures are
-- readable through the `pm_match_*`/`pm_capture_*` accessors until the next
-- pm_* call. All indices crossing this boundary are 1-based, matching Lua.
declare function pm_find(haystack: string, pattern: string, init: i32, plain: bool): i32
declare function pm_match(haystack: string, pattern: string, init: i32): i32
declare function pm_match_start(): i32
declare function pm_match_end(): i32
-- Capture accessors: index 0 is the whole match, indices 1..n the pattern's
-- captures. `pm_capture_position` reads a `()` position capture's value.
declare function pm_capture_string(index: i32): string
declare function pm_capture_position(index: i32): i32
-- One-shot gsub with a replacement-string template (%0-%9, %%). A negative
-- max_count means "no limit". The match/substitution count of the last
-- completed gsub is read back with pm_gsub_count.
declare function pm_gsub(source: string, pattern: string, replacement: string, max_count: i32): string
declare function pm_gsub_count(): i32
-- Stepwise gsub used when the replacement is a guest function: begin returns
-- a handle; each pm_gsub_next positions the next match (captures readable via
-- pm_capture_*) and expects exactly one pm_gsub_replace/pm_gsub_keep before
-- the following pm_gsub_next; finish returns the built string.
declare function pm_gsub_begin(source: string, pattern: string, max_count: i32): i32
declare function pm_gsub_next(handle: i32): i32
declare function pm_gsub_replace(handle: i32, replacement: string): unit
declare function pm_gsub_keep(handle: i32): unit
declare function pm_gsub_finish(handle: i32): string
-- string.gmatch iteration: pm_gmatch returns a handle; pm_gmatch_next
-- advances it, exposing each match through the pm_capture_* accessors.
declare function pm_gmatch(haystack: string, pattern: string): i32
declare function pm_gmatch_next(handle: i32): i32

-- Low-level string primitives backing the `string.*` builtin namespace.
-- Index-taking functions use 0-based indices. `string_sub` treats `last == -1`
-- as the end of the string.
declare function string_len(value: string): i32
declare function string_sub(value: string, first: i32, last: i32): string
declare function string_rep(value: string, count: i32, separator: string): string
declare function string_byte(value: string, index: i32): i32
declare function string_upper(value: string): string
declare function string_lower(value: string): string

declare function string_char0(): string
declare function string_char1(a: i32): string
declare function string_char2(a: i32, b: i32): string
declare function string_char3(a: i32, b: i32, c: i32): string
declare function string_char4(a: i32, b: i32, c: i32, d: i32): string
declare function string_char5(a: i32, b: i32, c: i32, d: i32, e: i32): string
declare function string_char6(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32): string
declare function string_char7(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32): string
declare function string_char8(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32): string

declare function string_format0(format: string): string
declare function string_format1(format: string, a: string): string
declare function string_format2(format: string, a: string, b: string): string
declare function string_format3(format: string, a: string, b: string, c: string): string
declare function string_format4(format: string, a: string, b: string, c: string, d: string): string
declare function string_format5(format: string, a: string, b: string, c: string, d: string, e: string): string
declare function string_format6(format: string, a: string, b: string, c: string, d: string, e: string, f: string): string
declare function string_format7(format: string, a: string, b: string, c: string, d: string, e: string, f: string, g: string): string
declare function string_format8(format: string, a: string, b: string, c: string, d: string, e: string, f: string, g: string, h: string): string
