{
  "name": "ante",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:retained-ui": "node tools/check-retained-ui.mjs",
    "test": "pnpm check:retained-ui && vitest run",
    "test:unit": "pnpm check:retained-ui && vitest run",
    "test:e2e": "pnpm test:gameplay && pnpm test:renderer",
    "storybook": "node tools/build-church-meshes.mjs && storybook dev -p 6006 --no-open",
    "build-storybook": "node tools/build-church-meshes.mjs && storybook build -o dist/storybook",
    "meshes:church": "node tools/build-church-meshes.mjs",
    "test:visual": "playwright test -c playwright.visual.config.js",
    "test:gameplay": "pnpm test:gameplay-guard && pnpm check:gameplay && playwright test",
    "test:renderer": "playwright test -c playwright.renderer.config.js",
    "check:gameplay": "node tools/check-gameplay.mjs",
    "test:gameplay-guard": "node --test tools/check-gameplay.test.mjs"
  },
  "dependencies": {
    "@waluau/vite-plugin": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/browser-playwright": "^4.0.8",
    "@waluau/storybook": "workspace:*",
    "get-port": "^7.2.0",
    "playwright": "^1.60.0",
    "storybook": "^10.5.5",
    "vite": "^8.0.14",
    "vitest": "^4.0.8"
  }
}
