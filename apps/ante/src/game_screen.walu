-- The duel screen: the run, the rules/flow/choreography triple behind the
-- live board, plus the keyboard and mouse adapters that drive it. The entry
-- module only routes engine callbacks here while this screen is active; audio
-- unlock and resource lifetime stay with the entry module, so by the time
-- input reaches this screen the browser gesture requirement is already
-- satisfied.
--
-- One screen spans a whole run: clearing a duel deals the next one in place
-- rather than handing control back to the entry module, so the run's carried
-- gold never has to leave this screen. The shop between two duels is part of
-- that span — it spends the same carried gold — so this screen owns it too, and
-- routes input and drawing to it while it stands.
--
-- Where the run stands is also a place on the shared city map, which this
-- screen aims but does not own: the shop is a vendor on a street corner and
-- the duel is the house at the end of the next block. `leaving_fence` is the
-- one moment the two disagree — the offers are still on the screen while the
-- map they are drawn on dissolves into the duel that has already been dealt
-- behind it — so that walking into a duel is one movement instead of a list
-- vanishing and a board appearing.
local game = require("./game")
local spells = require("./spells/spell")
local run_module = require("./run")
local render = require("./render")
local choreography = require("./choreography")
local city_map = require("./city_map")
local flow = require("./flow")
local shop = require("./shop")
local shop_entity = require("./entities/shop")
local layout = require("./layout")
local ui = require("./ui/node")
local divine_intervention = require("./divine_intervention")

export type State = {
    run: run_module.State,
    rules: game.State,
    ui: flow.State,
    presentation: choreography.State,
    board: render.Board,
    shop: shop.State,
    shop_ui: shop_entity.Stateful,
    intervention: divine_intervention.State,
    leaving_fence: bool
}

type ScreenAction = "none" | "exit"

-- Browser key strings are open-ended. Decode that host boundary once into the
-- closed set the game understands; `other` is the deliberate fallback for
-- future browser values and unmapped controls.
enum Key {
    exit,
    restart,
    history,
    help,
    confirm,
    select,
    cancel,
    left,
    right,
    up,
    down,
    sort_ascending,
    sort_descending,
    pass,
    other
}

function decode_key(key: string): Key
    if key == "m" or key == "M" then
        return Key.exit
    end
    if key == "r" or key == "R" then
        return Key.restart
    end
    if key == "h" or key == "H" then
        return Key.history
    end
    if key == "?" or key == "/" then
        return Key.help
    end
    if key == "Enter" then
        return Key.confirm
    end
    if key == " " then
        return Key.select
    end
    if key == "Escape" then
        return Key.cancel
    end
    if key == "ArrowLeft" or key == "a" then
        return Key.left
    end
    if key == "ArrowRight" or key == "d" then
        return Key.right
    end
    if key == "ArrowUp" or key == "w" then
        return Key.up
    end
    if key == "ArrowDown" or key == "s" then
        return Key.down
    end
    if key == "c" or key == "C" then
        return Key.sort_ascending
    end
    if key == "v" or key == "V" then
        return Key.sort_descending
    end
    if key == "p" or key == "P" then
        return Key.pass
    end
    return Key.other
end

function State.new(): State
    local run: run_module.State = run_module.State.new(spells.SpellKind.Firebolt, false)
    local rules: game.State = game.State.new(run:boss(), run.spells, run.gold)
    local intermission: shop.State = shop.State.new(run)
    intermission:close()
    return {
        run = run,
        rules = rules,
        ui = flow.State.new(),
        presentation = choreography.State.new(),
        board = render.Board.new(rules:view(), run:view("none")),
        shop = intermission,
        shop_ui = shop_entity.Stateful.new(intermission, run),
        intervention = divine_intervention.State.new(),
        leaving_fence = false
    }
end

-- Whether the map is the screen. The shop stands on it; a duel that has been
-- walked into has taken it over, and so has one whose shop is being left.
function State:on_map(): bool
    return self.shop.open and not self.leaving_fence
end

-- Deal the duel the run is currently on: its variant and opening gold are the
-- run's to say, so nothing outside this screen decides what the next duel is
-- dealt as.
function State:deal_vault(): unit
    local run: run_module.State = self.run
    self.rules:reset(run:boss(), run.spells, run.gold)
    self.ui:reset()
    self.presentation:reset()
    self.board:pointer_leave()
    self.board:focus_hand(0)
    self.intervention:reset()
    -- The opening deal is already reflected in rules self; choreography
    -- reveals that settled result as the screen comes alive.
    self.presentation:opening_deal(self.rules:view())
end

function State:close_fence(): unit
    self.shop_ui:pointer_leave()
    self.shop:close()
    self.leaving_fence = false
end

-- A run that is starting or starting over sets out from the vendor its opening
-- spell was picked at, so the map is put back at the mouth of the route instead
-- of walking the whole city back to it.
function open_route(city: city_map.State): unit
    city:warp(city_map.shop_stop(1))
end

-- Start a run at its first duel. `rush` is the boss-rush run and `spell` the
-- starting spell every duel of it is fought with; the entry module passes the
-- menu's choices, and an in-game restart replays the same pair from duel one.
function State:reset(city: city_map.State, rush: bool, spell: spells.SpellKind): unit
    self.run:restart(spell, rush)
    self:close_fence()
    open_route(city)
    self:deal_vault()
end

-- The live duel has been fought to a verdict and the player asked for what
-- comes next. The run settles on which duel that is — the next one of this
-- run, or the first of a fresh one.
--
-- A taken duel is followed by the shop rather than by a deal: the run has
-- already moved on and is holding what the target left of the gold it carried
-- out, which is exactly what the intermission spends. Taking the last duel of
-- the table walks the same way — the run is won and goes on regardless. A lost
-- run has nothing to spend and no loadout to spend it on, so its fresh first
-- duel is dealt straight away.
function State:advance_run(city: city_map.State): unit
    local outcome: run_module.Outcome = self.run:settle(self.rules:is_victory(), self.rules:gold())
    if run_module.outcome_walks_on(outcome) then
        self.shop:open_for(self.run)
        self.leaving_fence = false
        return
    end
    self:close_fence()
    open_route(city)
    self:deal_vault()
end

-- The shop is done with: deal the duel the run has been standing in front of,
-- loadout, prices, and remaining gold as the shop left them. The offers are not
-- taken down here — the map carries them out as it dissolves, and `update`
-- clears them once it has.
function State:leave_shop(): unit
    self.leaving_fence = true
    self:deal_vault()
end

-- Which stop of the route carries the last duel the run's target table is
-- written for. The route runs past it — a run that takes it walks on into the
-- endless city — so this names a landmark, not an end.
function State:landmark_stop(): i32
    return city_map.duel_stop(run_module.run_length(self.run.rush))
end

-- Which stop of the route the run stands on: the vendor before the live duel
-- while the intermission is up, and the duel's own house otherwise.
function State:city_stop(): i32
    if self:on_map() then
        return city_map.shop_stop(self.run.duel)
    end
    return city_map.duel_stop(self.run.duel)
end

-- Aim the map at where the run stands and say whether the map or the duel is
-- the picture. Called every frame, resources loaded or not, so the walk between
-- two stops keeps time with the run rather than with the asset loader.
function State:steer_city(city: city_map.State): unit
    city:follow(self:city_stop())
    if self:on_map() then
        city:show()
    else
        city:hide()
    end
end

-- The same aim, with the travel and the dive already finished: for a run that
-- is being set down rather than played into place, which is what a development
-- snapshot coming back is.
function State:place_city(city: city_map.State): unit
    self:steer_city(city)
    city:warp(self:city_stop())
    city:settle()
end

function State:fence_open(): bool
    return self.shop.open
end

-- The verdict on the live duel, which only this screen can see: the run has
-- not settled on it yet, because the verdict is drawn over a finished board and
-- settling only happens once the player asks for what comes next. Reading it
-- from the same classifier the settle uses is what keeps the screen and the
-- movement it announces in agreement. A live duel has no verdict yet.
function State:run_outcome(): run_module.Outcome
    if not self.rules:is_finished() and self.run.hearts > 0 then
        return "none"
    end
    local run: run_module.State = self.run
    return run_module.outcome_of(
        run.duel,
        run.rush,
        run.hearts,
        self.rules:is_victory(),
        self.rules:gold()
    )
end

-- Losing the last heart finishes the screen's live duel immediately even when
-- the duel rules have not reached their own verdict yet.
function State:vault_finished(): bool
    return self.run.hearts <= 0 or self.rules:is_finished()
end

function key_command(key: Key): flow.Command
    match key do
    case Key.exit then
        return "none"
    case Key.restart then
        return "restart"
    case Key.history then
        return "history"
    case Key.help then
        return "help"
    case Key.confirm then
        return "advance"
    case Key.select then
        return "advance"
    case Key.cancel then
        return "advance"
    case Key.left then
        return "none"
    case Key.right then
        return "none"
    case Key.up then
        return "none"
    case Key.down then
        return "none"
    case Key.sort_ascending then
        return "none"
    case Key.sort_descending then
        return "none"
    case Key.pass then
        return "none"
    case Key.other then
        return "none"
    end
end

-- Returns how many card-flip sound cues this tick earned; the entry module
-- owns audio resources and playback.
function State:update(city: city_map.State, dt: f64): i32
    -- The shop is a still screen standing between two duels: the board behind
    -- it is already settled, so nothing advances while it is up. Once it has
    -- been left the duel is dealt and running, and the offers only wait for
    -- the map under them to finish dissolving before they are taken down.
    if self:on_map() then
        return 0
    end
    if self.leaving_fence and not city:visible() then
        self:close_fence()
    end
    if self.intervention.active then
        self.presentation:update_fan(self.board:fan_focus(true), dt)
        local touched: {i32} = self.intervention:update(dt)
        for target in touched do
            self.rules:divine_intervention(target)
        end
        return 0
    end
    local ui: flow.State = self.ui
    local presentation: choreography.State = self.presentation
    local animating: bool = presentation:is_animating()
    presentation:update_fan(self.board:fan_focus(animating), dt)
    local community_count: i32 = self.rules:community_size()
    -- Rules rotate or clear the live board as soon as play resolves, while the
    -- reveal still presents the five cards recorded in the trick. Keep spell
    -- effects anchored to that revealed board until the reveal is dismissed.
    if ui.revealing then
        local revealed: game.Trick? = self.rules:last_trick()
        if revealed ~= nil then
            community_count = #(revealed::game.Trick).middle
        end
    end
    local burned_table_card: i32 = presentation:update_power(community_count, dt)
    if burned_table_card >= 0 then
        local discarded: game.Card? = self.rules:resolve_firebolt(burned_table_card)
        if discarded ~= nil then
            local rules_view: game.View = self.rules:view()
            presentation:firebolt_resolved(
                discarded::game.Card,
                rules_view.middle[burned_table_card],
                burned_table_card,
                #rules_view.middle
            )
        end
    end
    if ui.revealing then
        return presentation:update_reveal(dt)
    end
    if ui.modal == "none" then
        return presentation:update(dt)
    end
    return 0
end

-- The duel board. The entry module draws it under the city map whenever the
-- map is not the whole picture, so a dissolve always has a duel to arrive at.
function State:draw_vault(surface: ui.Surface): unit
    local ui: flow.State = self.ui
    local aimed_slot: i32? = ui.cast_slot
    self.presentation:draw(
        self.board,
        surface,
        self.rules:view(),
        self.run:view(self:run_outcome()),
        {
            hand_focus = self.board:fan_focus(self.presentation:is_animating()),
            play_picks = ui.play_picks,
            swap_hand = ui.swap_hand,
            swap_table_cards = ui.swap_table_cards,
            modal = ui.modal,
            revealing = ui.revealing,
            finished = self:vault_finished(),
            casting = aimed_slot ~= nil,
            cast_slot = aimed_slot or 0
        }
    )
    render.draw_divine_intervention(
        surface,
        self.intervention.clock,
        self.intervention.active,
        self.presentation.fan_parts
    )
end

-- The shop's offers arrive once the street under them is visible and are gone
-- before the walk to the next house begins.
function State:draw_fence(city: city_map.State, viewport: layout.State, surface: ui.Surface): unit
    if city.street <= 0.0 then
        return
    end
    self.shop_ui:present(self.shop, self.run)
    self.shop_ui:draw(surface, viewport.width, viewport.height)
end

function State:submit_swap(): unit
    local ui: flow.State = self.ui
    local outcome: game.SwapOutcome?
    if #ui.swap_hand == 0 and #ui.swap_table_cards == 0 then
        outcome = self.rules:resolve_swap({}, {})
    elseif #ui.swap_hand ~= #ui.swap_table_cards or #ui.swap_hand > self.rules:gold() or #ui.swap_hand < self.rules:minimum_swap() then
        return
    else
        outcome = self.rules:resolve_swap(ui.swap_hand, ui.swap_table_cards)
    end
    ui:clear_picks()
    if outcome ~= nil then
        -- A resolved swap thaws every table_card, so a Freeze Ray standing on the
        -- board loses its condition with it. Which spell is standing there is
        -- the presentation's own reading, not a question for the loadout.
        self.presentation:clear_freeze()
        self.presentation:swap(outcome::game.SwapOutcome)
    end
end

-- Pay for and launch the spell in the aimed loadout slot at the given table_card. The
-- rules charge the gold only when they accept the cast, so a cancelled or
-- unaffordable attempt costs nothing; targeting mode ends either way.
function State:confirm_cast(slot: i32, table_card: i32): unit
    if self.rules:cast_spell(slot, table_card) then
        local kind: spells.SpellKind? = self.rules:spell_kind(slot)
        if kind ~= nil then
            self.presentation:apply_power(kind::spells.SpellKind, table_card)
        end
    end
    self.ui.cast_slot = nil
end

function State:submit_round(): unit
    local ui: flow.State = self.ui
    if #ui.play_picks ~= 2 then
        return
    end
    local trick: game.Trick? = self.rules:play(ui.play_picks[0], ui.play_picks[1])
    if trick == nil then
        return
    end
    local resolved: game.Trick = trick::game.Trick
    if resolved.winner < 0 then
        self.run:lose_hand()
    end
    self.presentation:record_burned_losers(resolved)
    ui:begin_reveal()
    -- A stalemate leaves both pairs standing, so this reveal has no pair to
    -- burn and its ash never starts.
    self.presentation:begin_reveal(resolved.winner ~= 0)
end

function State:perform_board_action(city: city_map.State, action: render.BoardAction): unit
    if action.kind == "none" then
        return
    end
    if action.kind == "modal" then
        self:consume_gate(city, "primary")
        return
    end
    local ui: flow.State = self.ui
    local rules: game.State = self.rules
    if action.kind == "hand" then
        if rules:swap_open() then
            flow.toggle(ui.swap_hand, action.index, rules:community_size())
        else
            flow.toggle(ui.play_picks, action.index, 2)
        end
    elseif action.kind == "table-card" then
        local aimed_slot: i32? = ui.cast_slot
        if aimed_slot ~= nil then
            self:confirm_cast(aimed_slot::i32, action.index)
        elseif rules:swap_open() and not rules:is_frozen(action.index) then
            flow.toggle(ui.swap_table_cards, action.index, rules:community_size())
        end
    elseif action.kind == "commit" then
        if rules:swap_open() then
            self:submit_swap()
        else
            self:submit_round()
        end
    end
end

function State:consume_gate(city: city_map.State, command: flow.Command): bool
    local result: flow.GateResult = self.ui:gate(
        self:vault_finished(),
        self.presentation:is_animating(),
        self.presentation:reveal_finished(),
        command
    )
    if result == "live" then
        return false
    end
    -- Restart is a run restart, not a redeal of the live duel: a duel the
    -- run already paid gold into cannot be fought a second time.
    if result == "reset" then
        self:reset(city, self.run.rush, self.run.start_spell)
    elseif result == "advance" then
        self:advance_run(city)
    elseif result == "refill" then
        local trick: game.Trick? = self.rules:last_trick()
        if trick ~= nil then
            self.presentation:resolved_breach_cleanup(self.rules:view(), trick::game.Trick)
        end
    elseif result == "skip" then
        self.presentation:skip()
    elseif result == "finish-reveal" then
        self.presentation:finish_reveal()
    end
    return true
end

-- Which loadout slot a key casts, or -1 for every other key. One key per slot,
-- numbered the way the loadout is: the spell learned second answers to 2.
function cast_slot_for(key: string, slots: i32): i32
    for slot = 0::i32, slots - 1 do
        if key == tostring(slot + 1) then
            return slot
        end
    end
    return -1
end

function State:keypressed(city: city_map.State, key: string): ScreenAction
    local ui: flow.State = self.ui
    local rules: game.State = self.rules
    local presentation: choreography.State = self.presentation
    local control: Key = decode_key(key)
    if control == Key.exit then
        return "exit"
    end
    -- The shop answers its own list; nothing on the settled board behind it is
    -- reachable until the next duel is dealt. Restarting the run is the one
    -- gesture that still works everywhere, the shop included. A shop already
    -- left answers nothing: the offers on the screen are a picture the map is
    -- carrying out, and the board underneath is the live one.
    if self:on_map() then
        if control == Key.restart then
            self:reset(city, self.run.rush, self.run.start_spell)
        elseif self.shop:keypressed(self.run, key) then
            self:leave_shop()
        end
        return "none"
    end
    -- Recognition sits ahead of ordinary board controls so the completing A
    -- belongs to the invocation, not to one last cursor movement. Earlier
    -- arrows remain normal play until the full hidden sequence is known.
    if self.intervention.active then
        return "none"
    end
    if not self:vault_finished() and not ui.revealing and ui.modal == "none" and not presentation:firebolt_pending() and self.intervention:keypressed(
        key
    ) then
        presentation:skip()
        ui:clear_picks()
        ui.cast_slot = nil
        return "none"
    end
    -- Keep the struck table_card stable until Firebolt's burn commits its discard
    -- and replacement. Other spell conditions are persistent and do not lock
    -- the board, but advancing the turn during this one-shot effect could make
    -- its target name a newly dealt table_card instead of the card the bolt hit.
    if presentation:firebolt_pending() then
        return "none"
    end
    local cast_slot: i32 = cast_slot_for(key, rules:spell_count())
    if cast_slot >= 0 then
        if ui.modal ~= "none" or ui.revealing or self:vault_finished() then
            return "none"
        end
        -- A cast key toggles: pressing the aimed spell's own key again calls it
        -- off, while the other spell's key swings the aim over to that one.
        if ui.cast_slot == cast_slot then
            ui.cast_slot = nil
            return "none"
        end
        if not rules:can_cast(cast_slot) then
            return "none"
        end
        -- The cast should respond on the first gesture. If the opening deal
        -- is still running, settle it before targeting begins so the table cards
        -- are visibly present for the aim cursor.
        if presentation:is_animating() then
            presentation:skip()
        end
        ui.cast_slot = cast_slot
        self.board:focus_table(0)
        return "none"
    end
    local aimed_slot: i32? = ui.cast_slot
    if aimed_slot ~= nil then
        match control do
        case Key.cancel then
            ui.cast_slot = nil
            self.board:focus_hand(0)
        case Key.left then
            self.board:navigate("left")
        case Key.right then
            self.board:navigate("right")
        case Key.confirm then
            local target: i32 = self.board:focused_table()
            if target < 0 then
                target = 0
            end
            self:confirm_cast(aimed_slot::i32, target)
        case Key.select then
            self:perform_board_action(city, self.board:activate())
        case Key.exit then
        case Key.restart then
        case Key.history then
        case Key.help then
        case Key.up then
        case Key.down then
        case Key.sort_ascending then
        case Key.sort_descending then
        case Key.pass then
        case Key.other then
        end
        return "none"
    end
    if (ui.modal ~= "none" or ui.revealing) and (control == Key.confirm or control == Key.select) then
        self:perform_board_action(city, self.board:activate_modal())
        return "none"
    end
    if self:consume_gate(city, key_command(control)) then
        return "none"
    end

    match control do
    case Key.left then
        self.board:navigate("left")
    case Key.right then
        self.board:navigate("right")
    case Key.up then
        self.board:navigate("up")
    case Key.down then
        self.board:navigate("down")
    case Key.select then
        self:perform_board_action(city, self.board:activate())
    case Key.sort_ascending then
        local order: {i32} = rules:sort_player_hand(true)
        ui:apply_hand_order(order)
        presentation:apply_hand_order(order)
        self.board:apply_hand_order(order)
    case Key.sort_descending then
        local order: {i32} = rules:sort_player_hand(false)
        ui:apply_hand_order(order)
        presentation:apply_hand_order(order)
        self.board:apply_hand_order(order)
    case Key.pass then
        if rules:swap_open() then
            ui.swap_hand = {}
            ui.swap_table_cards = {}
            self:submit_swap()
        end
    case Key.confirm then
        if rules:swap_open() or #ui.play_picks == 2 then
            self:perform_board_action(city, { kind = "commit", index = 0 })
        else
            self:perform_board_action(city, self.board:activate())
        end
    case Key.exit then
    case Key.restart then
    case Key.history then
    case Key.help then
    case Key.cancel then
    case Key.other then
    end
    return "none"
end

function State:mousemoved(x: f64, y: f64): unit
    if self:on_map() then
        self.shop_ui:mousemoved(x, y)
        return
    end
    if self.intervention.active then
        return
    end
    local ui: flow.State = self.ui
    if ui:gate(
        self:vault_finished(),
        self.presentation:is_animating(),
        self.presentation:reveal_finished(),
        "none"
    ) ~= "live" then
        return
    end
    self.board:pointer_move(x, y)
end

function State:mousepressed(city: city_map.State, x: f64, y: f64, button: i32): unit
    if button ~= 1 then
        return
    end
    -- The retained shop starts a possible click here and commits it only when
    -- release lands on the same row.
    if self:on_map() then
        self.shop_ui:mousepressed(x, y, button)
        return
    end
    if self.intervention.active then
        return
    end
    if self.presentation:firebolt_pending() then
        return
    end
    if self.presentation:is_animating() then
        self:consume_gate(city, "primary")
        return
    end
    self.board:pointer_down(x, y, button)
end

-- Both shop and board controls commit only when release lands on the same
-- retained target that received the press.
function State:mousereleased(city: city_map.State, x: f64, y: f64, button: i32): unit
    if self:on_map() then
        if self.shop_ui:mousereleased(x, y, button) then
            self:leave_shop()
        end
        return
    end
    if button ~= 1 then
        return
    end
    self:perform_board_action(city, self.board:pointer_up(x, y, button))
end

-- Five independently versioned development-snapshot payloads, in the same
-- order restore expects them. The entry module owns the frame around them.
function State:snapshot(): {string}
    return {
        self.run:snapshot(),
        self.rules:snapshot(),
        self.ui:snapshot(),
        self.presentation:snapshot(),
        self.shop:snapshot()
    }
end

function State.restore(
    run_payload: string,
    rules_payload: string,
    ui_payload: string,
    presentation_payload: string,
    shop_payload: string
): State?
    local run: run_module.State? = run_module.State.restore(run_payload)
    local rules: game.State? = game.State.restore(rules_payload)
    local ui: flow.State? = flow.State.restore(ui_payload)
    local presentation: choreography.State? = choreography.State.restore(presentation_payload)
    local intermission: shop.State? = shop.State.restore(shop_payload)
    if run == nil then
        return nil
    end
    if rules == nil then
        return nil
    end
    if ui == nil then
        return nil
    end
    if presentation == nil then
        return nil
    end
    if intermission == nil then
        return nil
    end
    local restored_ui: flow.State = ui::flow.State
    local restored_rules: game.State = rules::game.State
    -- An aim is an in-flight gesture, and this is the one place that can see
    -- both halves of it: a cast_slot the restored loadout has no spell in names
    -- nothing, so the aim settles as cancelled rather than coming back pointing
    -- at a spell that is not there.
    local restored_cast_slot: i32? = restored_ui.cast_slot
    if restored_cast_slot ~= nil and (restored_cast_slot or 0) >= restored_rules:spell_count() then
        restored_ui.cast_slot = nil
    end
    local restored_run: run_module.State = run::run_module.State
    local restored_shop: shop.State = intermission::shop.State
    return {
        run = restored_run,
        rules = restored_rules,
        ui = restored_ui,
        presentation = presentation::choreography.State,
        board = render.Board.new(restored_rules:view(), restored_run:view("none")),
        shop = restored_shop,
        shop_ui = shop_entity.Stateful.new(restored_shop, restored_run),
        intervention = divine_intervention.State.new(),
        -- Leaving a shop is a moment of movement, not a phase of the run. A
        -- snapshot lands on one side of it: an open shop comes back standing,
        -- and `place_city` puts the map and the offers where that leaves the
        -- run.
        leaving_fence = false
    }
end
