-- The duel screen: the run, the rules/flow/choreography triple behind the
-- live board, plus the keyboard and mouse adapters that drive it. The entry
-- module only routes engine callbacks here while this screen is active; audio
-- unlock and resource lifetime stay with the entry module, so by the time
-- input reaches this screen the browser gesture requirement is already
-- satisfied.
--
-- One screen spans a whole run: clearing a duel deals the next one in place
-- rather than handing control back to the entry module, so the run's carried
-- gold never has to leave this screen. The shop between two duels is part of
-- that span — it spends the same carried gold — so this screen owns it too, and
-- routes input and drawing to it while it stands.
--
-- Where the run stands is also a place on the shared city map, which this
-- screen aims but does not own: the shop is a vendor on a street corner and
-- the duel is the house at the end of the next block. `leaving_fence` is the
-- one moment the two disagree — the offers are still on the screen while the
-- map they are drawn on dissolves into the duel that has already been dealt
-- behind it — so that walking into a duel is one movement instead of a list
-- vanishing and a board appearing.

local engine = require("waluau:engine")
local game = require("./game")
local run_module = require("./run")
local render = require("./render")
local choreography = require("./choreography")
local city_map = require("./city_map")
local flow = require("./flow")
local shop = require("./shop")
local shop_render = require("./shop_render")
local layout = require("./layout")
local entity = require("./entity")
local divine_intervention = require("./divine_intervention")

type State = {
    run: run_module.State,
    rules: game.State,
    ui: flow.State,
    presentation: choreography.State,
    shop: shop.State,
    intervention: divine_intervention.State,
    leaving_fence: bool,
    fence_fade: f64
}

type ScreenAction = "none" | "exit"

-- Browser key strings are open-ended. Decode that host boundary once into the
-- closed set the game understands; `other` is the deliberate fallback for
-- future browser values and unmapped controls.
enum Key {
    exit,
    restart,
    history,
    help,
    confirm,
    select,
    cancel,
    left,
    right,
    up,
    down,
    sort_ascending,
    sort_descending,
    pass,
    other
}

function decode_key(key: string): Key
    if key == "m" or key == "M" then return Key.exit end
    if key == "r" or key == "R" then return Key.restart end
    if key == "h" or key == "H" then return Key.history end
    if key == "?" or key == "/" then return Key.help end
    if key == "Enter" then return Key.confirm end
    if key == " " then return Key.select end
    if key == "Escape" then return Key.cancel end
    if key == "ArrowLeft" or key == "a" then return Key.left end
    if key == "ArrowRight" or key == "d" then return Key.right end
    if key == "ArrowUp" or key == "w" then return Key.up end
    if key == "ArrowDown" or key == "s" then return Key.down end
    if key == "c" or key == "C" then return Key.sort_ascending end
    if key == "v" or key == "V" then return Key.sort_descending end
    if key == "p" or key == "P" then return Key.pass end
    return Key.other
end

function new(): State
    local run: run_module.State = run_module.new(game.spell_firebolt, false)
    return {
        run = run,
        rules = game.new(run:boss(), run.spells, run.gold),
        ui = flow.new(),
        presentation = choreography.new(),
        shop = shop.new(),
        intervention = divine_intervention.new(),
        leaving_fence = false,
        fence_fade = 0.0,
    }
end

-- Whether the map is the screen. The shop stands on it; a duel that has been
-- walked into has taken it over, and so has one whose shop is being left.
function on_map(state: State): bool
    return state.shop.open and not state.leaving_fence
end

-- Deal the duel the run is currently on: its variant and opening gold are the
-- run's to say, so nothing outside this screen decides what the next duel is
-- dealt as.
function deal_vault(state: State): unit
    local run: run_module.State = state.run
    state.rules:reset(run:boss(), run.spells, run.gold)
    flow.reset(state.ui)
    choreography.reset(state.presentation)
    divine_intervention.reset(state.intervention)
    -- The opening deal is already reflected in rules state; choreography
    -- reveals that settled result as the screen comes alive.
    choreography.opening_deal(game.view(state.rules), state.presentation)
end

function close_fence(state: State): unit
    shop.close(state.shop)
    state.leaving_fence = false
end

-- A run that is starting or starting over sets out from the vendor its opening
-- spell was picked at, so the map is put back at the mouth of the route instead
-- of walking the whole city back to it.
function open_route(city: city_map.State): unit
    city_map.warp(city, city_map.shop_stop(1))
end

-- Start a run at its first duel. `rush` is the boss-rush run and `spell` the
-- starting spell every duel of it is fought with; the entry module passes the
-- menu's choices, and an in-game restart replays the same pair from duel one.
function reset(state: State, city: city_map.State, rush: bool, spell: i32): unit
    state.run:restart(spell, rush)
    close_fence(state)
    open_route(city)
    deal_vault(state)
end

-- The live duel has been fought to a verdict and the player asked for what
-- comes next. The run settles on which duel that is — the next one of this
-- run, or the first of a fresh one.
--
-- A taken duel is followed by the shop rather than by a deal: the run has
-- already moved on and is holding what the target left of the gold it carried
-- out, which is exactly what the intermission spends. Taking the last duel of
-- the table walks the same way — the run is won and goes on regardless. A lost
-- run has nothing to spend and no loadout to spend it on, so its fresh first
-- duel is dealt straight away.
function advance_run(state: State, city: city_map.State): unit
    local outcome: run_module.Outcome = state.run:settle(
        state.rules:is_victory(), state.rules:gold())
    if outcome == "advance"
        or outcome == "won"
    then
        shop.open_for(state.shop, state.run)
        state.leaving_fence = false
        return
    end
    close_fence(state)
    open_route(city)
    deal_vault(state)
end

-- The shop is done with: deal the duel the run has been standing in front of,
-- loadout, prices, and remaining gold as the shop left them. The offers are not
-- taken down here — the map carries them out as it dissolves, and `update`
-- clears them once it has.
function leave_shop(state: State): unit
    state.leaving_fence = true
    deal_vault(state)
end

-- Which stop of the route carries the last duel the run's target table is
-- written for. The route runs past it — a run that takes it walks on into the
-- endless city — so this names a landmark, not an end.
function landmark_stop(state: State): i32
    return city_map.duel_stop(run_module.run_length(state.run.rush))
end

-- Which stop of the route the run stands on: the vendor before the live duel
-- while the intermission is up, and the duel's own house otherwise.
function city_stop(state: State): i32
    if on_map(state) then return city_map.shop_stop(state.run.duel) end
    return city_map.duel_stop(state.run.duel)
end

-- How much of the offer list is on the screen. Leaving a shop takes it down
-- before the walk to the next house is under way, and the map's own `street`
-- keeps it from arriving while the camera is still inside the last duel: a
-- list about where the duel is standing waits until it is standing there.
const FENCE_FADE_SECONDS: f64 = 0.28

function fade_toward(value: f64, goal: f64, step: f64): f64
    if value < goal then
        local next: f64 = value + step
        if next > goal then return goal end
        return next
    end
    local next: f64 = value - step
    if next < goal then return goal end
    return next
end

-- Aim the map at where the run stands and say whether the map or the duel is
-- the picture. Called every frame, resources loaded or not, so the walk between
-- two stops keeps time with the run rather than with the asset loader.
function steer_city(state: State, city: city_map.State, dt: f64): unit
    city_map.follow(city, city_stop(state))
    local standing: f64 = 0.0
    if on_map(state) then
        city_map.show(city)
        standing = 1.0
    else
        city_map.hide(city)
    end
    state.fence_fade = fade_toward(
        state.fence_fade, standing, dt / FENCE_FADE_SECONDS)
end

-- The same aim, with the travel and the dive already finished: for a run that
-- is being set down rather than played into place, which is what a development
-- snapshot coming back is.
function place_city(state: State, city: city_map.State): unit
    -- A whole fade's worth of time in one step is how this asks for the aim to
    -- have already arrived, offers included.
    steer_city(state, city, FENCE_FADE_SECONDS)
    city_map.warp(city, city_stop(state))
    city_map.settle(city)
end

function fence_open(state: State): bool
    return state.shop.open
end

-- The verdict on the live duel, which only this screen can see: the run has
-- not settled on it yet, because the verdict is drawn over a finished board and
-- settling only happens once the player asks for what comes next. Reading it
-- from the same classifier the settle uses is what keeps the screen and the
-- movement it announces in agreement. A live duel has no verdict yet.
function run_outcome(state: State): run_module.Outcome
    if not state.rules:is_finished() then return "none" end
    local run: run_module.State = state.run
    return run_module.outcome_of(
        run.duel, run.rush, state.rules:is_victory(), state.rules:gold())
end

function key_command(key: Key): flow.Command
    match key do
    case Key.exit then return "none"
    case Key.restart then return "restart"
    case Key.history then return "history"
    case Key.help then return "help"
    case Key.confirm then return "advance"
    case Key.select then return "advance"
    case Key.cancel then return "advance"
    case Key.left then return "none"
    case Key.right then return "none"
    case Key.up then return "none"
    case Key.down then return "none"
    case Key.sort_ascending then return "none"
    case Key.sort_descending then return "none"
    case Key.pass then return "none"
    case Key.other then return "none"
    end
end


-- Returns how many card-flip sound cues this tick earned; the entry module
-- owns audio resources and playback.
function update(state: State, city: city_map.State, dt: f64): i32
    -- The shop is a still screen standing between two duels: the board behind
    -- it is already settled, so nothing advances while it is up. Once it has
    -- been left the duel is dealt and running, and the offers only wait for
    -- the map under them to finish dissolving before they are taken down.
    if on_map(state) then return 0 end
    if state.leaving_fence and not city_map.visible(city) then close_fence(state) end
    if state.intervention.active then
        choreography.update_fan(state.presentation, flow.fan_focus(state.ui, true), dt)
        local touched: {i32} = divine_intervention.update(state.intervention, dt)
        for target in touched do state.rules:divine_intervention(target) end
        return 0
    end
    local ui: flow.State = state.ui
    local presentation: choreography.State = state.presentation
    local animating: bool = choreography.is_animating(presentation)
    choreography.update_fan(presentation, flow.fan_focus(ui, animating), dt)
    local burned_table_card: i32 = choreography.update_power(presentation, dt)
    if burned_table_card >= 0 then
        local discarded: game.Card? = state.rules:resolve_firebolt(burned_table_card)
        if discarded ~= nil then
            local rules_view: game.View = game.view(state.rules)
            choreography.firebolt_resolved(
                presentation,
                discarded::game.Card,
                rules_view.middle[burned_table_card],
                burned_table_card)
        end
    end
    if ui.revealing then
        return choreography.update_reveal(presentation, dt)
    end
    if ui.modal == "none" then
        return choreography.update(presentation, dt)
    end
    return 0
end

-- The duel board. The entry module draws it under the city map whenever the
-- map is not the whole picture, so a dissolve always has a duel to arrive at.
function draw_vault(state: State, surface: entity.Surface): unit
    local ui: flow.State = state.ui
    local aimed_slot: i32? = ui.cast_slot
    choreography.draw(
        surface,
        game.view(state.rules),
        run_module.view(state.run, run_outcome(state)),
        state.presentation,
        {
            hand_focus = flow.fan_focus(
                ui, choreography.is_animating(state.presentation)),
            table_card_cursor = ui.table_card_cursor,
            cursor_area = ui.cursor_area,
            play_picks = ui.play_picks,
            swap_hand = ui.swap_hand,
            swap_table_cards = ui.swap_table_cards,
            modal = ui.modal,
            revealing = ui.revealing,
            casting = aimed_slot ~= nil,
            cast_slot = aimed_slot or 0,
        })
    render.draw_divine_intervention(
        surface, state.intervention.clock, state.intervention.active,
        state.presentation.fan_parts)
end

-- The shop's offers, at the opacity of the street they are laid out on: they
-- arrive as the camera comes back out of the last duel, and are gone before
-- the walk to the next house begins.
function draw_fence(state: State, city: city_map.State, viewport: layout.State, graphics: engine.Graphics): unit
    shop_render.draw(
        state.shop, state.run, viewport, graphics, state.fence_fade * city.street)
end

function submit_swap(state: State): unit
    local ui: flow.State = state.ui
    local outcome: game.SwapOutcome?
    if #ui.swap_hand == 0 and #ui.swap_table_cards == 0 then
        outcome = state.rules:resolve_swap({}, {})
    elseif #ui.swap_hand ~= #ui.swap_table_cards
        or #ui.swap_hand > state.rules:gold()
        or #ui.swap_hand < state.rules:minimum_swap()
    then
        return
    else
        outcome = state.rules:resolve_swap(ui.swap_hand, ui.swap_table_cards)
    end
    flow.clear_picks(ui)
    if outcome ~= nil then
        -- A resolved swap thaws every table_card, so a Freeze Ray standing on the
        -- board loses its condition with it. Which spell is standing there is
        -- the presentation's own reading, not a question for the loadout.
        choreography.clear_freeze(state.presentation)
        choreography.swap(outcome::game.SwapOutcome, state.presentation)
    end
end

-- Pay for and launch the spell in the aimed loadout slot at the given table_card. The
-- rules charge the gold only when they accept the cast, so a cancelled or
-- unaffordable attempt costs nothing; targeting mode ends either way.
function confirm_cast(state: State, slot: i32, table_card: i32): unit
    if state.rules:cast_spell(slot, table_card) then
        local kind: game.SpellKind? = state.rules:spell_kind(slot)
        if kind ~= nil then
            choreography.apply_power(state.presentation, kind::game.SpellKind, table_card)
        end
    end
    state.ui.cast_slot = nil
end

function submit_round(state: State): unit
    local ui: flow.State = state.ui
    if #ui.play_picks ~= 2 then return end
    local trick: game.Trick? = state.rules:play(ui.play_picks[0], ui.play_picks[1])
    if trick == nil then return end
    local resolved: game.Trick = trick::game.Trick
    choreography.record_burned_losers(state.presentation, resolved)
    flow.begin_reveal(ui)
    -- A stalemate leaves both pairs standing, so this reveal has no pair to
    -- burn and its ash never starts.
    choreography.begin_reveal(state.presentation, resolved.winner ~= 0)
end

-- The swap prompt has exactly two rows, so up and down both mean "the other
-- one".
function toggle_cursor_area(ui: flow.State): unit
    if ui.cursor_area == "hand" then
        ui.cursor_area = "table-cards"
    else
        ui.cursor_area = "hand"
    end
end

function consume_gate(state: State, city: city_map.State, command: flow.Command): bool
    local result: flow.GateResult = flow.gate(
        state.ui, state.rules:is_finished(),
        choreography.is_animating(state.presentation),
        choreography.reveal_finished(state.presentation), command)
    if result == "live" then return false end
    -- Restart is a run restart, not a redeal of the live duel: a duel the
    -- run already paid gold into cannot be fought a second time.
    if result == "reset" then
        reset(state, city, state.run.rush, state.run.start_spell)
    elseif result == "advance" then
        advance_run(state, city)
    elseif result == "refill" then
        local trick: game.Trick? = state.rules:last_trick()
        if trick ~= nil then
            choreography.resolved_breach_cleanup(
                game.view(state.rules), trick::game.Trick, state.presentation)
        end
    elseif result == "skip" then
        choreography.skip(state.presentation)
    elseif result == "finish-reveal" then
        choreography.finish_reveal(state.presentation)
    end
    return true
end

-- Which loadout slot a key casts, or -1 for every other key. One key per slot,
-- numbered the way the loadout is: the spell learned second answers to 2.
function cast_slot_for(key: string, slots: i32): i32
    for slot = 0::i32, slots - 1 do
        if key == tostring(slot + 1) then return slot end
    end
    return -1
end

function keypressed(state: State, city: city_map.State, key: string): ScreenAction
    local ui: flow.State = state.ui
    local rules: game.State = state.rules
    local presentation: choreography.State = state.presentation
    local control: Key = decode_key(key)
    if control == Key.exit then return "exit" end
    -- The shop answers its own list; nothing on the settled board behind it is
    -- reachable until the next duel is dealt. Restarting the run is the one
    -- gesture that still works everywhere, the shop included. A shop already
    -- left answers nothing: the offers on the screen are a picture the map is
    -- carrying out, and the board underneath is the live one.
    if on_map(state) then
        if control == Key.restart then
            reset(state, city, state.run.rush, state.run.start_spell)
        elseif shop.keypressed(state.shop, state.run, key) == "leave" then
            leave_shop(state)
        end
        return "none"
    end
    -- Recognition sits ahead of ordinary board controls so the completing A
    -- belongs to the invocation, not to one last cursor movement. Earlier
    -- arrows remain normal play until the full hidden sequence is known.
    if state.intervention.active then return "none" end
    if not rules:is_finished()
        and not ui.revealing
        and ui.modal == "none"
        and not choreography.firebolt_pending(presentation)
        and divine_intervention.keypressed(state.intervention, key)
    then
        choreography.skip(presentation)
        flow.clear_picks(ui)
        ui.cast_slot = nil
        return "none"
    end
    -- Keep the struck table_card stable until Firebolt's burn commits its discard
    -- and replacement. Other spell conditions are persistent and do not lock
    -- the board, but advancing the turn during this one-shot effect could make
    -- its target name a newly dealt table_card instead of the card the bolt hit.
    if choreography.firebolt_pending(presentation) then return "none" end
    local cast_slot: i32 = cast_slot_for(key, rules:spell_count())
    if cast_slot >= 0 then
        if ui.modal ~= "none" or ui.revealing or rules:is_finished() then
            return "none"
        end
        -- A cast key toggles: pressing the aimed spell's own key again calls it
        -- off, while the other spell's key swings the aim over to that one.
        if ui.cast_slot == cast_slot then
            ui.cast_slot = nil
            return "none"
        end
        if not rules:can_cast(cast_slot) then return "none" end
        -- The cast should respond on the first gesture. If the opening deal
        -- is still running, settle it before targeting begins so the table cards
        -- are visibly present for the aim cursor.
        if choreography.is_animating(presentation) then
            choreography.skip(presentation)
        end
        ui.cast_slot = cast_slot
        return "none"
    end
    local aimed_slot: i32? = ui.cast_slot
    if aimed_slot ~= nil then
        match control do
        case Key.cancel then ui.cast_slot = nil
        case Key.left then
            ui.table_card_cursor -= 1
            if ui.table_card_cursor < 0 then ui.table_card_cursor = 2 end
        case Key.right then
            ui.table_card_cursor = (ui.table_card_cursor + 1) % 3
        case Key.confirm then
            confirm_cast(state, aimed_slot::i32, ui.table_card_cursor)
        case Key.select then
            confirm_cast(state, aimed_slot::i32, ui.table_card_cursor)
        case Key.exit then
        case Key.restart then
        case Key.history then
        case Key.help then
        case Key.up then
        case Key.down then
        case Key.sort_ascending then
        case Key.sort_descending then
        case Key.pass then
        case Key.other then
        end
        return "none"
    end
    if consume_gate(state, city, key_command(control)) then return "none" end

    match control do
    case Key.left then
        if ui.cursor_area == "hand" then
            ui.hand_cursor -= 1
            if ui.hand_cursor < 0 then ui.hand_cursor = rules:hand_size() - 1 end
        else
            ui.table_card_cursor -= 1
            if ui.table_card_cursor < 0 then ui.table_card_cursor = 2 end
        end
    case Key.right then
        if ui.cursor_area == "hand" then
            ui.hand_cursor = (ui.hand_cursor + 1) % rules:hand_size()
        else
            ui.table_card_cursor = (ui.table_card_cursor + 1) % 3
        end
    case Key.up then
        if rules:swap_open() then toggle_cursor_area(ui) end
    case Key.down then
        if rules:swap_open() then toggle_cursor_area(ui) end
    case Key.select then
        if rules:swap_open() then
            if ui.cursor_area == "hand" then
                flow.toggle(ui.swap_hand, ui.hand_cursor, 3)
            elseif not rules:is_frozen(ui.table_card_cursor) then
                flow.toggle(ui.swap_table_cards, ui.table_card_cursor, 3)
            end
        else
            flow.toggle(ui.play_picks, ui.hand_cursor, 2)
        end
    case Key.sort_ascending then
        local order: {i32} = rules:sort_player_hand(true)
        flow.apply_hand_order(ui, order)
        choreography.apply_hand_order(presentation, order)
    case Key.sort_descending then
        local order: {i32} = rules:sort_player_hand(false)
        flow.apply_hand_order(ui, order)
        choreography.apply_hand_order(presentation, order)
    case Key.pass then
        if rules:swap_open() then
            ui.swap_hand = {}
            ui.swap_table_cards = {}
            submit_swap(state)
        end
    case Key.confirm then
        if rules:swap_open() then submit_swap(state) else submit_round(state) end
    case Key.exit then
    case Key.restart then
    case Key.history then
    case Key.help then
    case Key.cancel then
    case Key.other then
    end
    return "none"
end

function mousemoved(state: State, x: f64, y: f64): unit
    local viewport: layout.State = layout.current()
    if on_map(state) then
        shop.focus(
            state.shop, state.run,
            shop_render.row_at(viewport, x, y, shop.row_count(state.shop, state.run)))
        return
    end
    if state.intervention.active then return end
    local ui: flow.State = state.ui
    if flow.gate(
        ui, state.rules:is_finished(),
        choreography.is_animating(state.presentation),
        choreography.reveal_finished(state.presentation), "none"
    ) ~= "live" then return end
    local at: render.Point = render.point(x, y)
    -- While aiming a cast, the pointer only steers the table_card the spell would
    -- hit; the fan below stays folded and unfocused.
    if ui.cast_slot ~= nil then
        local target: i32 = render.hit_table_card(viewport, at)
        if target >= 0 then ui.table_card_cursor = target end
        return
    end
    local hand: i32 = choreography.hit_hand(state.presentation, at)
    if hand >= 0 then
        ui.cursor_area = "hand"
        ui.hand_cursor = hand
        return
    end
    if state.rules:swap_open() then
        local table_card: i32 = render.hit_table_card(viewport, at)
        if table_card >= 0 then
            ui.cursor_area = "table-cards"
            ui.table_card_cursor = table_card
        end
    end
end

function mousepressed(state: State, city: city_map.State, x: f64, y: f64, button: i32): unit
    if button ~= 1 then return end
    local viewport: layout.State = layout.current()
    -- Clicking an offer buys it the same way Enter on it does; a click on the
    -- chrome between the lines buys nothing rather than taking whatever the
    -- cursor happened to rest on.
    if on_map(state) then
        local row: i32 = shop_render.row_at(
            viewport, x, y, shop.row_count(state.shop, state.run))
        if row < 0 then return end
        shop.focus(state.shop, state.run, row)
        if shop.activate(state.shop, state.run) == "leave" then
            leave_shop(state)
        end
        return
    end
    if state.intervention.active then return end
    if choreography.firebolt_pending(state.presentation) then return end
    if consume_gate(state, city, "primary") then return end

    local ui: flow.State = state.ui
    local rules: game.State = state.rules
    local at: render.Point = render.point(x, y)
    -- Clicking a table_card while aiming confirms the cast on it; anywhere else
    -- keeps targeting open for the keyboard to finish or cancel.
    local aimed_slot: i32? = ui.cast_slot
    if aimed_slot ~= nil then
        local target: i32 = render.hit_table_card(viewport, at)
        if target >= 0 then
            ui.table_card_cursor = target
            confirm_cast(state, aimed_slot::i32, target)
        end
        return
    end
    local hand: i32 = choreography.hit_hand(state.presentation, at)
    if hand >= 0 then
        ui.cursor_area = "hand"
        ui.hand_cursor = hand
        if rules:swap_open() then flow.toggle(ui.swap_hand, hand, 3)
        else flow.toggle(ui.play_picks, hand, 2) end
        return
    end
    if rules:swap_open() then
        local table_card: i32 = render.hit_table_card(viewport, at)
        if table_card >= 0 then
            ui.cursor_area = "table-cards"
            ui.table_card_cursor = table_card
            if not rules:is_frozen(table_card) then flow.toggle(ui.swap_table_cards, table_card, 3) end
            return
        end
        if render.hit_pass(at) then
            ui.swap_hand = {}
            ui.swap_table_cards = {}
            submit_swap(state)
            return
        end
    end
    if render.hit_commit(at) then
        if rules:swap_open() then submit_swap(state) else submit_round(state) end
    end
end

-- Five independently versioned development-snapshot payloads, in the same
-- order restore expects them. The entry module owns the frame around them.
function snapshot(state: State): {string}
    return {
        run_module.snapshot(state.run),
        game.snapshot(state.rules),
        flow.snapshot(state.ui),
        choreography.snapshot(state.presentation),
        shop.snapshot(state.shop),
    }
end

function restore(
    run_payload: string,
    rules_payload: string,
    ui_payload: string,
    presentation_payload: string,
    shop_payload: string
): State?
    local run: run_module.State? = run_module.restore(run_payload)
    local rules: game.State? = game.restore(rules_payload)
    local ui: flow.State? = flow.restore(ui_payload)
    local presentation: choreography.State? = choreography.restore(presentation_payload)
    local intermission: shop.State? = shop.restore(shop_payload)
    if run == nil then return nil end
    if rules == nil then return nil end
    if ui == nil then return nil end
    if presentation == nil then return nil end
    if intermission == nil then return nil end
    local restored_ui: flow.State = ui::flow.State
    local restored_rules: game.State = rules::game.State
    -- An aim is an in-flight gesture, and this is the one place that can see
    -- both halves of it: a cast_slot the restored loadout has no spell in names
    -- nothing, so the aim settles as cancelled rather than coming back pointing
    -- at a spell that is not there.
    local restored_cast_slot: i32? = restored_ui.cast_slot
    if restored_cast_slot ~= nil
        and (restored_cast_slot or 0) >= restored_rules:spell_count()
    then
        restored_ui.cast_slot = nil
    end
    return {
        run = run::run_module.State,
        rules = restored_rules,
        ui = restored_ui,
        presentation = presentation::choreography.State,
        shop = intermission::shop.State,
        intervention = divine_intervention.new(),
        -- Leaving a shop is a moment of movement, not a phase of the run. A
        -- snapshot lands on one side of it: an open shop comes back standing,
        -- and `place_city` puts the map and the offers where that leaves the
        -- run.
        leaving_fence = false,
        fence_fade = 0.0,
    }
end

return {
    new = new,
    reset = reset,
    update = update,
    steer_city = steer_city,
    place_city = place_city,
    fence_open = fence_open,
    draw_vault = draw_vault,
    draw_fence = draw_fence,
    keypressed = keypressed,
    mousemoved = mousemoved,
    mousepressed = mousepressed,
    snapshot = snapshot,
    restore = restore,
    landmark_stop = landmark_stop,
}
