-- The heist screen: the rules/flow/choreography triple behind the live board,
-- plus the keyboard and mouse adapters that drive it. The entry module only
-- routes engine callbacks here while this screen is active; audio unlock and
-- resource lifetime stay with the entry module, so by the time input reaches
-- this screen the browser gesture requirement is already satisfied.

local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local game = require("./game")
local render = require("./render")
local choreography = require("./choreography")
local flow = require("./flow")

type State = {
    rules: game.State,
    ui: flow.State,
    presentation: choreography.State
}

const ACTION_NONE: i32 = 0
const ACTION_EXIT: i32 = 1

function new(): State
    return {
        rules = game.new(false, game.spell_firebolt),
        ui = flow.new(),
        presentation = choreography.new(),
    }
end

-- `boss` picks the variant the fresh heist is dealt as and `spell` the
-- starting spell it is fought with; the entry module passes the menu's
-- choices, and in-game restarts replay the current pair.
function reset(state: State, boss: bool, spell: i32): unit
    state.rules:reset(boss, spell)
    flow.reset(state.ui)
    choreography.reset(state.presentation)
    -- The opening deal is already reflected in rules state; choreography
    -- reveals that settled result as the screen comes alive.
    choreography.opening_deal(game.view(state.rules), state.presentation)
end

function key_command(key: string): i32
    if key == "r" or key == "R" then return flow.command_restart end
    if key == "h" or key == "H" then return flow.command_history end
    if key == "?" or key == "/" then return flow.command_help end
    if key == "Enter" or key == " " or key == "Escape" then
        return flow.command_advance
    end
    return flow.command_none
end


-- Returns how many card-flip sound cues this tick earned; the entry module
-- owns audio resources and playback.
function update(state: State, dt: f64): i32
    local ui: flow.State = state.ui
    local presentation: choreography.State = state.presentation
    local animating: bool = choreography.is_animating(presentation)
    choreography.update_fan(presentation, flow.fan_focus(ui, animating), dt)
    local burned_ward: i32 = choreography.update_power(presentation, dt)
    if burned_ward >= 0 then
        local discarded: game.Card? = state.rules:resolve_firebolt(burned_ward)
        if discarded ~= nil then
            choreography.firebolt_resolved(
                presentation,
                discarded::game.Card,
                state.rules.middle[burned_ward],
                burned_ward)
        end
    end
    if ui.revealing then
        return choreography.update_reveal(presentation, dt)
    end
    if ui.modal == flow.modal_none then
        return choreography.update(presentation, dt)
    end
    return 0
end

function draw(
    state: State,
    graphics: engine.Graphics,
    effects: render.EffectShaders,
    card_back: graphics_module.Texture?
): unit
    local ui: flow.State = state.ui
    choreography.draw(
        graphics,
        effects,
        game.view(state.rules),
        state.presentation,
        {
            hand_focus = flow.fan_focus(
                ui, choreography.is_animating(state.presentation)),
            ward_cursor = ui.ward_cursor,
            cursor_area = ui.cursor_area,
            play_picks = ui.play_picks,
            swap_hand = ui.swap_hand,
            swap_wards = ui.swap_wards,
            modal = ui.modal,
            revealing = ui.revealing,
            casting = ui.casting,
        },
        card_back
    )
end

function submit_swap(state: State): unit
    local ui: flow.State = state.ui
    local outcome: game.FeintOutcome?
    if #ui.swap_hand == 0 and #ui.swap_wards == 0 then
        outcome = state.rules:resolve_swap({}, {})
    elseif #ui.swap_hand ~= #ui.swap_wards or #ui.swap_hand > state.rules:mana() then
        return
    else
        outcome = state.rules:resolve_swap(ui.swap_hand, ui.swap_wards)
    end
    flow.clear_picks(ui)
    if outcome ~= nil then
        if state.rules:spell_kind() == game.spell_freeze_ray then
            choreography.apply_power(state.presentation, 0, 0)
        end
        choreography.feint(outcome::game.FeintOutcome, state.presentation)
    end
end

-- Pay for and launch the chosen spell at the given ward. The rules charge the
-- mana only when they accept the cast, so a cancelled or unaffordable attempt
-- costs nothing; targeting mode ends either way.
function confirm_cast(state: State, ward: i32): unit
    if state.rules:cast_spell(ward) then
        choreography.apply_power(
            state.presentation, state.rules:spell_kind(), ward)
    end
    state.ui.casting = false
end

function submit_breach(state: State): unit
    local ui: flow.State = state.ui
    if #ui.play_picks ~= 2 then return end
    local trick: game.Trick? = state.rules:play(ui.play_picks[0], ui.play_picks[1])
    if trick == nil then return end
    choreography.record_burned_losers(state.presentation, trick::game.Trick)
    flow.begin_reveal(ui)
    choreography.begin_reveal(state.presentation)
end

function consume_gate(state: State, command: i32): bool
    local result: i32 = flow.gate(
        state.ui, state.rules:is_finished(),
        choreography.is_animating(state.presentation),
        choreography.reveal_finished(state.presentation), command)
    if result == flow.result_live then return false end
    if result == flow.result_reset then
        reset(state, state.rules:is_boss(), state.rules:spell_kind())
    elseif result == flow.result_refill then
        local trick: game.Trick? = state.rules:last_trick()
        if trick ~= nil then
            choreography.resolved_breach_cleanup(
                game.view(state.rules), trick::game.Trick, state.presentation)
        end
    elseif result == flow.result_skip then
        choreography.skip(state.presentation)
    elseif result == flow.result_finish_reveal then
        choreography.finish_reveal(state.presentation)
    end
    return true
end

-- TODO(waluau-language): Exhaustive enums and pattern matching for host key
-- values would replace this string ladder and make unmapped controls a
-- compile-time decision shared by every input adapter.
function keypressed(state: State, key: string): i32
    local ui: flow.State = state.ui
    local rules: game.State = state.rules
    local presentation: choreography.State = state.presentation
    if key == "m" or key == "M" then return ACTION_EXIT end
    -- Keep the struck ward stable until Firebolt's burn commits its discard
    -- and replacement. Other spell conditions are persistent and do not lock
    -- the board, but advancing the turn during this one-shot effect could make
    -- its target name a newly dealt ward instead of the card the bolt hit.
    if choreography.firebolt_pending(presentation) then return ACTION_NONE end
    if key == "1" then
        if ui.modal ~= flow.modal_none or ui.revealing or rules:is_finished() then
            return ACTION_NONE
        end
        -- The cast key toggles: a second press while aiming calls it off.
        if ui.casting then
            ui.casting = false
            return ACTION_NONE
        end
        if not rules:can_cast() then return ACTION_NONE end
        -- The cast should respond on the first gesture. If the opening deal
        -- is still running, settle it before targeting begins so the wards
        -- are visibly present for the aim cursor.
        if choreography.is_animating(presentation) then
            choreography.skip(presentation)
        end
        ui.casting = true
        return ACTION_NONE
    end
    if ui.casting then
        if key == "Escape" then
            ui.casting = false
        elseif key == "ArrowLeft" or key == "a" then
            ui.ward_cursor -= 1
            if ui.ward_cursor < 0 then ui.ward_cursor = 2 end
        elseif key == "ArrowRight" or key == "d" then
            ui.ward_cursor = (ui.ward_cursor + 1) % 3
        elseif key == "Enter" or key == " " then
            confirm_cast(state, ui.ward_cursor)
        end
        return ACTION_NONE
    end
    if consume_gate(state, key_command(key)) then return ACTION_NONE end

    if key == "ArrowLeft" or key == "a" then
        if ui.cursor_area == flow.cursor_hand then
            ui.hand_cursor -= 1
            if ui.hand_cursor < 0 then ui.hand_cursor = rules:hand_size() - 1 end
        else
            ui.ward_cursor -= 1
            if ui.ward_cursor < 0 then ui.ward_cursor = 2 end
        end
    elseif key == "ArrowRight" or key == "d" then
        if ui.cursor_area == flow.cursor_hand then
            ui.hand_cursor = (ui.hand_cursor + 1) % rules:hand_size()
        else
            ui.ward_cursor = (ui.ward_cursor + 1) % 3
        end
    elseif rules:feint_open() and (
        key == "ArrowUp" or key == "ArrowDown" or key == "w" or key == "s"
    ) then
        ui.cursor_area = 1 - ui.cursor_area
    elseif key == " " then
        if rules:feint_open() then
            if ui.cursor_area == flow.cursor_hand then
                flow.toggle(ui.swap_hand, ui.hand_cursor, 3)
            elseif not rules:is_frozen(ui.ward_cursor) then
                flow.toggle(ui.swap_wards, ui.ward_cursor, 3)
            end
        else
            flow.toggle(ui.play_picks, ui.hand_cursor, 2)
        end
    elseif key == "c" or key == "C" then
        local order: {i32} = rules:sort_player_hand(true)
        flow.apply_hand_order(ui, order)
        choreography.apply_hand_order(presentation, order)
    elseif key == "v" or key == "V" then
        local order: {i32} = rules:sort_player_hand(false)
        flow.apply_hand_order(ui, order)
        choreography.apply_hand_order(presentation, order)
    elseif key == "p" or key == "P" then
        if rules:feint_open() then
            ui.swap_hand = {}
            ui.swap_wards = {}
            submit_swap(state)
        end
    elseif key == "Enter" then
        if rules:feint_open() then submit_swap(state) else submit_breach(state) end
    end
    return ACTION_NONE
end

function mousemoved(state: State, x: f64, y: f64): unit
    local ui: flow.State = state.ui
    if flow.gate(
        ui, state.rules:is_finished(),
        choreography.is_animating(state.presentation),
        choreography.reveal_finished(state.presentation), flow.command_none
    ) ~= flow.result_live then return end
    local at: render.Point = render.point(x, y)
    -- While aiming a cast, the pointer only steers the ward the spell would
    -- hit; the fan below stays folded and unfocused.
    if ui.casting then
        local target: i32 = render.hit_ward(at)
        if target >= 0 then ui.ward_cursor = target end
        return
    end
    local hand: i32 = choreography.hit_hand(state.presentation, at)
    if hand >= 0 then
        ui.cursor_area = flow.cursor_hand
        ui.hand_cursor = hand
        return
    end
    if state.rules:feint_open() then
        local ward: i32 = render.hit_ward(at)
        if ward >= 0 then
            ui.cursor_area = flow.cursor_wards
            ui.ward_cursor = ward
        end
    end
end

function mousepressed(state: State, x: f64, y: f64, button: i32): unit
    if button ~= 1 then return end
    if choreography.firebolt_pending(state.presentation) then return end
    if consume_gate(state, flow.command_primary) then return end

    local ui: flow.State = state.ui
    local rules: game.State = state.rules
    local at: render.Point = render.point(x, y)
    -- Clicking a ward while aiming confirms the cast on it; anywhere else
    -- keeps targeting open for the keyboard to finish or cancel.
    if ui.casting then
        local target: i32 = render.hit_ward(at)
        if target >= 0 then
            ui.ward_cursor = target
            confirm_cast(state, target)
        end
        return
    end
    if render.hit_help(at) then
        flow.gate(
            ui, rules:is_finished(), false,
            choreography.reveal_finished(state.presentation), flow.command_help)
        return
    end
    local hand: i32 = choreography.hit_hand(state.presentation, at)
    if hand >= 0 then
        ui.cursor_area = flow.cursor_hand
        ui.hand_cursor = hand
        if rules:feint_open() then flow.toggle(ui.swap_hand, hand, 3)
        else flow.toggle(ui.play_picks, hand, 2) end
        return
    end
    if rules:feint_open() then
        local ward: i32 = render.hit_ward(at)
        if ward >= 0 then
            ui.cursor_area = flow.cursor_wards
            ui.ward_cursor = ward
            if not rules:is_frozen(ward) then flow.toggle(ui.swap_wards, ward, 3) end
            return
        end
        if render.hit_pass(at) then
            ui.swap_hand = {}
            ui.swap_wards = {}
            submit_swap(state)
            return
        end
    end
    if render.hit_commit(at, rules:feint_open()) then
        if rules:feint_open() then submit_swap(state) else submit_breach(state) end
    end
end

-- Three independently versioned development-snapshot payloads, in the same
-- order restore expects them. The entry module owns the frame around them.
function snapshot(state: State): {string}
    return {
        game.snapshot(state.rules),
        flow.snapshot(state.ui),
        choreography.snapshot(state.presentation),
    }
end

function restore(
    rules_payload: string,
    ui_payload: string,
    presentation_payload: string
): State?
    local rules: game.State? = game.restore(rules_payload)
    local ui: flow.State? = flow.restore(ui_payload)
    local presentation: choreography.State? = choreography.restore(presentation_payload)
    if rules == nil then return nil end
    if ui == nil then return nil end
    if presentation == nil then return nil end
    return {
        rules = rules::game.State,
        ui = ui::flow.State,
        presentation = presentation::choreography.State,
    }
end

return {
    new = new,
    reset = reset,
    update = update,
    draw = draw,
    keypressed = keypressed,
    mousemoved = mousemoved,
    mousepressed = mousepressed,
    snapshot = snapshot,
    restore = restore,
    action_none = ACTION_NONE,
    action_exit = ACTION_EXIT,
}
