-- The heist screen: the run, the rules/flow/choreography triple behind the
-- live board, plus the keyboard and mouse adapters that drive it. The entry
-- module only routes engine callbacks here while this screen is active; audio
-- unlock and resource lifetime stay with the entry module, so by the time
-- input reaches this screen the browser gesture requirement is already
-- satisfied.
--
-- One screen spans a whole run: clearing a vault deals the next one in place
-- rather than handing control back to the entry module, so the run's carried
-- mana never has to leave this screen. The fence between two vaults is part of
-- that span — it spends the same carried mana — so this screen owns it too, and
-- routes input and drawing to it while it stands.

local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local game = require("./game")
local run_module = require("./run")
local render = require("./render")
local choreography = require("./choreography")
local flow = require("./flow")
local shop = require("./shop")
local shop_render = require("./shop_render")

type State = {
    run: run_module.State,
    rules: game.State,
    ui: flow.State,
    presentation: choreography.State,
    shop: shop.State
}

const ACTION_NONE: i32 = 0
const ACTION_EXIT: i32 = 1

function new(): State
    local run: run_module.State = run_module.new(game.spell_firebolt, false)
    return {
        run = run,
        rules = game.new(run:boss(), run.spells, run.mana),
        ui = flow.new(),
        presentation = choreography.new(),
        shop = shop.new(),
    }
end

-- Deal the vault the run is currently on: its variant and opening mana are the
-- run's to say, so nothing outside this screen decides what the next heist is
-- dealt as.
function deal_vault(state: State): unit
    local run: run_module.State = state.run
    shop.close(state.shop)
    state.rules:reset(run:boss(), run.spells, run.mana)
    flow.reset(state.ui)
    choreography.reset(state.presentation)
    -- The opening deal is already reflected in rules state; choreography
    -- reveals that settled result as the screen comes alive.
    choreography.opening_deal(game.view(state.rules), state.presentation)
end

-- Start a run at its first vault. `rush` is the boss-rush run and `spell` the
-- starting spell every vault of it is fought with; the entry module passes the
-- menu's choices, and an in-game restart replays the same pair from vault one.
function reset(state: State, rush: bool, spell: i32): unit
    state.run:restart(spell, rush)
    deal_vault(state)
end

-- The live vault has been fought to a verdict and the player asked for what
-- comes next. The run settles on which vault that is — the next one of this
-- run, or the first of a fresh one.
--
-- A taken vault is followed by the fence rather than by a deal: the run has
-- already moved on and is holding the mana it carried out, which is exactly
-- what the intermission spends. A lost run has nothing to spend and no loadout
-- to spend it on, so its fresh first vault is dealt straight away.
function advance_run(state: State): unit
    local cleared: bool = state.rules:is_victory()
    state.run:settle(cleared, state.rules:mana())
    if cleared then
        shop.open_for(state.shop, state.run)
        return
    end
    deal_vault(state)
end

-- The fence is done with: deal the vault the run has been standing in front of,
-- loadout, prices, and remaining mana as the shop left them.
function leave_shop(state: State): unit
    deal_vault(state)
end

-- What the renderer needs to know about the run behind the live board.
function run_view(state: State): render.RunView
    local run: run_module.State = state.run
    return {
        vault = run.vault,
        cleared = run.cleared,
        boss = run:boss(),
        next_is_boss = run:next_is_boss(),
        carried_mana = run.mana,
    }
end

function key_command(key: string): i32
    if key == "r" or key == "R" then return flow.command_restart end
    if key == "h" or key == "H" then return flow.command_history end
    if key == "?" or key == "/" then return flow.command_help end
    if key == "Enter" or key == " " or key == "Escape" then
        return flow.command_advance
    end
    return flow.command_none
end


-- Returns how many card-flip sound cues this tick earned; the entry module
-- owns audio resources and playback.
function update(state: State, dt: f64): i32
    -- The fence is a still screen standing between two vaults: the board behind
    -- it is already settled, so nothing advances while it is up.
    if state.shop.open then return 0 end
    local ui: flow.State = state.ui
    local presentation: choreography.State = state.presentation
    local animating: bool = choreography.is_animating(presentation)
    choreography.update_fan(presentation, flow.fan_focus(ui, animating), dt)
    local burned_ward: i32 = choreography.update_power(presentation, dt)
    if burned_ward >= 0 then
        local discarded: game.Card? = state.rules:resolve_firebolt(burned_ward)
        if discarded ~= nil then
            choreography.firebolt_resolved(
                presentation,
                discarded::game.Card,
                state.rules.middle[burned_ward],
                burned_ward)
        end
    end
    if ui.revealing then
        return choreography.update_reveal(presentation, dt)
    end
    if ui.modal == flow.modal_none then
        return choreography.update(presentation, dt)
    end
    return 0
end

function draw(
    state: State,
    graphics: engine.Graphics,
    effects: render.EffectShaders,
    card_back: graphics_module.Texture?
): unit
    if state.shop.open then
        shop_render.draw(state.shop, state.run, graphics)
        return
    end
    local ui: flow.State = state.ui
    choreography.draw(
        graphics,
        effects,
        game.view(state.rules),
        run_view(state),
        state.presentation,
        {
            hand_focus = flow.fan_focus(
                ui, choreography.is_animating(state.presentation)),
            ward_cursor = ui.ward_cursor,
            cursor_area = ui.cursor_area,
            play_picks = ui.play_picks,
            swap_hand = ui.swap_hand,
            swap_wards = ui.swap_wards,
            modal = ui.modal,
            revealing = ui.revealing,
            casting = ui.casting,
            cast_slot = ui.cast_slot,
        },
        card_back
    )
end

function submit_swap(state: State): unit
    local ui: flow.State = state.ui
    local outcome: game.FeintOutcome?
    if #ui.swap_hand == 0 and #ui.swap_wards == 0 then
        outcome = state.rules:resolve_swap({}, {})
    elseif #ui.swap_hand ~= #ui.swap_wards or #ui.swap_hand > state.rules:mana() then
        return
    else
        outcome = state.rules:resolve_swap(ui.swap_hand, ui.swap_wards)
    end
    flow.clear_picks(ui)
    if outcome ~= nil then
        -- A resolved feint thaws every ward, so a Freeze Ray standing on the
        -- board loses its condition with it. Which spell is standing there is
        -- the presentation's own reading, not a question for the loadout.
        choreography.clear_freeze(state.presentation)
        choreography.feint(outcome::game.FeintOutcome, state.presentation)
    end
end

-- Pay for and launch the spell in the aimed loadout slot at the given ward. The
-- rules charge the mana only when they accept the cast, so a cancelled or
-- unaffordable attempt costs nothing; targeting mode ends either way.
function confirm_cast(state: State, slot: i32, ward: i32): unit
    if state.rules:cast_spell(slot, ward) then
        choreography.apply_power(
            state.presentation, state.rules:spell_kind(slot), ward)
    end
    state.ui.casting = false
end

function submit_breach(state: State): unit
    local ui: flow.State = state.ui
    if #ui.play_picks ~= 2 then return end
    local trick: game.Trick? = state.rules:play(ui.play_picks[0], ui.play_picks[1])
    if trick == nil then return end
    local resolved: game.Trick = trick::game.Trick
    choreography.record_burned_losers(state.presentation, resolved)
    flow.begin_reveal(ui)
    -- A stalemate leaves both pairs standing, so this reveal has no pair to
    -- burn and its ash never starts.
    choreography.begin_reveal(state.presentation, resolved.winner ~= 0)
end

function consume_gate(state: State, command: i32): bool
    local result: i32 = flow.gate(
        state.ui, state.rules:is_finished(),
        choreography.is_animating(state.presentation),
        choreography.reveal_finished(state.presentation), command)
    if result == flow.result_live then return false end
    -- Restart is a run restart, not a redeal of the live vault: a vault the
    -- run already paid mana into cannot be fought a second time.
    if result == flow.result_reset then
        reset(state, state.run.rush, state.run.start_spell)
    elseif result == flow.result_advance then
        advance_run(state)
    elseif result == flow.result_refill then
        local trick: game.Trick? = state.rules:last_trick()
        if trick ~= nil then
            choreography.resolved_breach_cleanup(
                game.view(state.rules), trick::game.Trick, state.presentation)
        end
    elseif result == flow.result_skip then
        choreography.skip(state.presentation)
    elseif result == flow.result_finish_reveal then
        choreography.finish_reveal(state.presentation)
    end
    return true
end

-- Which loadout slot a key casts, or -1 for every other key. One key per slot,
-- numbered the way the loadout is: the spell learned second answers to 2.
function cast_slot_for(key: string, slots: i32): i32
    for slot = 0::i32, slots - 1 do
        if key == tostring(slot + 1) then return slot end
    end
    return -1
end

-- TODO(waluau-language): Exhaustive enums and pattern matching for host key
-- values would replace this string ladder and make unmapped controls a
-- compile-time decision shared by every input adapter.
function keypressed(state: State, key: string): i32
    local ui: flow.State = state.ui
    local rules: game.State = state.rules
    local presentation: choreography.State = state.presentation
    if key == "m" or key == "M" then return ACTION_EXIT end
    -- The fence answers its own list; nothing on the settled board behind it is
    -- reachable until the next vault is dealt. Restarting the run is the one
    -- gesture that still works everywhere, the fence included.
    if state.shop.open then
        if key == "r" or key == "R" then
            reset(state, state.run.rush, state.run.start_spell)
        elseif shop.keypressed(state.shop, state.run, key) == shop.result_leave then
            leave_shop(state)
        end
        return ACTION_NONE
    end
    -- Keep the struck ward stable until Firebolt's burn commits its discard
    -- and replacement. Other spell conditions are persistent and do not lock
    -- the board, but advancing the turn during this one-shot effect could make
    -- its target name a newly dealt ward instead of the card the bolt hit.
    if choreography.firebolt_pending(presentation) then return ACTION_NONE end
    local cast_slot: i32 = cast_slot_for(key, rules:spell_count())
    if cast_slot >= 0 then
        if ui.modal ~= flow.modal_none or ui.revealing or rules:is_finished() then
            return ACTION_NONE
        end
        -- A cast key toggles: pressing the aimed spell's own key again calls it
        -- off, while the other spell's key swings the aim over to that one.
        if ui.casting and ui.cast_slot == cast_slot then
            ui.casting = false
            return ACTION_NONE
        end
        if not rules:can_cast(cast_slot) then return ACTION_NONE end
        -- The cast should respond on the first gesture. If the opening deal
        -- is still running, settle it before targeting begins so the wards
        -- are visibly present for the aim cursor.
        if choreography.is_animating(presentation) then
            choreography.skip(presentation)
        end
        ui.casting = true
        ui.cast_slot = cast_slot
        return ACTION_NONE
    end
    if ui.casting then
        if key == "Escape" then
            ui.casting = false
        elseif key == "ArrowLeft" or key == "a" then
            ui.ward_cursor -= 1
            if ui.ward_cursor < 0 then ui.ward_cursor = 2 end
        elseif key == "ArrowRight" or key == "d" then
            ui.ward_cursor = (ui.ward_cursor + 1) % 3
        elseif key == "Enter" or key == " " then
            confirm_cast(state, ui.cast_slot, ui.ward_cursor)
        end
        return ACTION_NONE
    end
    if consume_gate(state, key_command(key)) then return ACTION_NONE end

    if key == "ArrowLeft" or key == "a" then
        if ui.cursor_area == flow.cursor_hand then
            ui.hand_cursor -= 1
            if ui.hand_cursor < 0 then ui.hand_cursor = rules:hand_size() - 1 end
        else
            ui.ward_cursor -= 1
            if ui.ward_cursor < 0 then ui.ward_cursor = 2 end
        end
    elseif key == "ArrowRight" or key == "d" then
        if ui.cursor_area == flow.cursor_hand then
            ui.hand_cursor = (ui.hand_cursor + 1) % rules:hand_size()
        else
            ui.ward_cursor = (ui.ward_cursor + 1) % 3
        end
    elseif rules:feint_open() and (
        key == "ArrowUp" or key == "ArrowDown" or key == "w" or key == "s"
    ) then
        ui.cursor_area = 1 - ui.cursor_area
    elseif key == " " then
        if rules:feint_open() then
            if ui.cursor_area == flow.cursor_hand then
                flow.toggle(ui.swap_hand, ui.hand_cursor, 3)
            elseif not rules:is_frozen(ui.ward_cursor) then
                flow.toggle(ui.swap_wards, ui.ward_cursor, 3)
            end
        else
            flow.toggle(ui.play_picks, ui.hand_cursor, 2)
        end
    elseif key == "c" or key == "C" then
        local order: {i32} = rules:sort_player_hand(true)
        flow.apply_hand_order(ui, order)
        choreography.apply_hand_order(presentation, order)
    elseif key == "v" or key == "V" then
        local order: {i32} = rules:sort_player_hand(false)
        flow.apply_hand_order(ui, order)
        choreography.apply_hand_order(presentation, order)
    elseif key == "p" or key == "P" then
        if rules:feint_open() then
            ui.swap_hand = {}
            ui.swap_wards = {}
            submit_swap(state)
        end
    elseif key == "Enter" then
        if rules:feint_open() then submit_swap(state) else submit_breach(state) end
    end
    return ACTION_NONE
end

function mousemoved(state: State, x: f64, y: f64): unit
    if state.shop.open then
        shop.focus(
            state.shop, state.run,
            shop_render.row_at(x, y, shop.row_count(state.shop, state.run)))
        return
    end
    local ui: flow.State = state.ui
    if flow.gate(
        ui, state.rules:is_finished(),
        choreography.is_animating(state.presentation),
        choreography.reveal_finished(state.presentation), flow.command_none
    ) ~= flow.result_live then return end
    local at: render.Point = render.point(x, y)
    -- While aiming a cast, the pointer only steers the ward the spell would
    -- hit; the fan below stays folded and unfocused.
    if ui.casting then
        local target: i32 = render.hit_ward(at)
        if target >= 0 then ui.ward_cursor = target end
        return
    end
    local hand: i32 = choreography.hit_hand(state.presentation, at)
    if hand >= 0 then
        ui.cursor_area = flow.cursor_hand
        ui.hand_cursor = hand
        return
    end
    if state.rules:feint_open() then
        local ward: i32 = render.hit_ward(at)
        if ward >= 0 then
            ui.cursor_area = flow.cursor_wards
            ui.ward_cursor = ward
        end
    end
end

function mousepressed(state: State, x: f64, y: f64, button: i32): unit
    if button ~= 1 then return end
    -- Clicking an offer buys it the same way Enter on it does; a click on the
    -- chrome between the lines buys nothing rather than taking whatever the
    -- cursor happened to rest on.
    if state.shop.open then
        local row: i32 = shop_render.row_at(
            x, y, shop.row_count(state.shop, state.run))
        if row < 0 then return end
        shop.focus(state.shop, state.run, row)
        if shop.activate(state.shop, state.run) == shop.result_leave then
            leave_shop(state)
        end
        return
    end
    if choreography.firebolt_pending(state.presentation) then return end
    if consume_gate(state, flow.command_primary) then return end

    local ui: flow.State = state.ui
    local rules: game.State = state.rules
    local at: render.Point = render.point(x, y)
    -- Clicking a ward while aiming confirms the cast on it; anywhere else
    -- keeps targeting open for the keyboard to finish or cancel.
    if ui.casting then
        local target: i32 = render.hit_ward(at)
        if target >= 0 then
            ui.ward_cursor = target
            confirm_cast(state, ui.cast_slot, target)
        end
        return
    end
    if render.hit_help(at) then
        flow.gate(
            ui, rules:is_finished(), false,
            choreography.reveal_finished(state.presentation), flow.command_help)
        return
    end
    local hand: i32 = choreography.hit_hand(state.presentation, at)
    if hand >= 0 then
        ui.cursor_area = flow.cursor_hand
        ui.hand_cursor = hand
        if rules:feint_open() then flow.toggle(ui.swap_hand, hand, 3)
        else flow.toggle(ui.play_picks, hand, 2) end
        return
    end
    if rules:feint_open() then
        local ward: i32 = render.hit_ward(at)
        if ward >= 0 then
            ui.cursor_area = flow.cursor_wards
            ui.ward_cursor = ward
            if not rules:is_frozen(ward) then flow.toggle(ui.swap_wards, ward, 3) end
            return
        end
        if render.hit_pass(at) then
            ui.swap_hand = {}
            ui.swap_wards = {}
            submit_swap(state)
            return
        end
    end
    if render.hit_commit(at, rules:feint_open()) then
        if rules:feint_open() then submit_swap(state) else submit_breach(state) end
    end
end

-- Five independently versioned development-snapshot payloads, in the same
-- order restore expects them. The entry module owns the frame around them.
function snapshot(state: State): {string}
    return {
        run_module.snapshot(state.run),
        game.snapshot(state.rules),
        flow.snapshot(state.ui),
        choreography.snapshot(state.presentation),
        shop.snapshot(state.shop),
    }
end

function restore(
    run_payload: string,
    rules_payload: string,
    ui_payload: string,
    presentation_payload: string,
    shop_payload: string
): State?
    local run: run_module.State? = run_module.restore(run_payload)
    local rules: game.State? = game.restore(rules_payload)
    local ui: flow.State? = flow.restore(ui_payload)
    local presentation: choreography.State? = choreography.restore(presentation_payload)
    local intermission: shop.State? = shop.restore(shop_payload)
    if run == nil then return nil end
    if rules == nil then return nil end
    if ui == nil then return nil end
    if presentation == nil then return nil end
    if intermission == nil then return nil end
    local restored_ui: flow.State = ui::flow.State
    local restored_rules: game.State = rules::game.State
    -- An aim is an in-flight gesture, and this is the one place that can see
    -- both halves of it: a cast_slot the restored loadout has no spell in names
    -- nothing, so the aim settles as cancelled rather than coming back pointing
    -- at a spell that is not there.
    if restored_ui.cast_slot >= restored_rules:spell_count() then
        restored_ui.casting = false
        restored_ui.cast_slot = 0
    end
    return {
        run = run::run_module.State,
        rules = restored_rules,
        ui = restored_ui,
        presentation = presentation::choreography.State,
        shop = intermission::shop.State,
    }
end

return {
    new = new,
    reset = reset,
    update = update,
    draw = draw,
    keypressed = keypressed,
    mousemoved = mousemoved,
    mousepressed = mousepressed,
    snapshot = snapshot,
    restore = restore,
    action_none = ACTION_NONE,
    action_exit = ACTION_EXIT,
}
