-- Retained, DOM-free layout storage for Ante's UI tree. A Box is constructed
-- with its stable children once, then keeps its intrinsic measurement,
-- arranged rectangle, and flex scratch across frames. Measuring and arranging
-- mutate those records in place: a settled tree performs the work each frame
-- without rebuilding trees, frame lists, rectangles, or solve arrays.
export type Rect = { x: f64, y: f64, width: f64, height: f64 }
export type Edges = { left: f64, top: f64, right: f64, bottom: f64 }
export type Intrinsic = {
    min_width: f64,
    preferred_width: f64,
    max_width: f64,
    min_height: f64,
    preferred_height: f64,
    max_height: f64,
    baseline: f64
}
export type Axis = "row" | "column"
export type Justify = "start" | "center" | "end" | "space-between"
export type Align = "start" | "center" | "end" | "stretch" | "baseline"
export type Style = { axis: Axis, gap: f64, justify: Justify, align: Align, padding: Edges }
export type Result = {
    content: Rect,
    overflow_x: f64,
    overflow_y: f64,
    overflowed: bool,
    set: bool,
    left: f64,
    top: f64,
    right: f64,
    bottom: f64
}
-- Arrangement state is mutated only by this module. Keeping it opaque also
-- bounds the recursive structural checking tracked by waluau-4ggh.
export opaque type Box = {
    kind: "leaf" | "flow" | "layer" | "padding" | "minimum",
    children: {Box},
    style: Style,
    intrinsic: Intrinsic,
    bounds: Rect,
    baseline: f64,
    grow: f64,
    shrink: f64,
    sizes: {f64},
    insets: Edges,
    floor_width: f64,
    floor_height: f64,
    wide: bool,
    result: Result
}

-- Large enough to mean "no authored cap" without allowing infinities into
-- distribution arithmetic.
const UNBOUNDED: f64 = 1000000000000.0
const EPSILON: f64 = 0.000001

function rect(x: f64, y: f64, width: f64, height: f64): Rect
    return { x = x, y = y, width = width, height = height }
end

function edges(left: f64, top: f64, right: f64, bottom: f64): Edges
    return { left = left, top = top, right = right, bottom = bottom }
end

function even_edges(horizontal: f64, vertical: f64): Edges
    return edges(horizontal, vertical, horizontal, vertical)
end

function no_edges(): Edges
    return edges(0.0, 0.0, 0.0, 0.0)
end

function style(axis: Axis, gap: f64, justify: Justify, align: Align, padding: Edges): Style
    return { axis = axis, gap = gap, justify = justify, align = align, padding = padding }
end

function row(gap: f64, justify: Justify, align: Align): Style
    return style("row", gap, justify, align, no_edges())
end

function column(gap: f64, justify: Justify, align: Align): Style
    return style("column", gap, justify, align, no_edges())
end

function empty_intrinsic(): Intrinsic
    return {
        min_width = 0.0,
        preferred_width = 0.0,
        max_width = 0.0,
        min_height = 0.0,
        preferred_height = 0.0,
        max_height = 0.0,
        baseline = -1.0
    }
end

function result(): Result
    return {
        content = rect(0.0, 0.0, 0.0, 0.0),
        overflow_x = 0.0,
        overflow_y = 0.0,
        overflowed = false,
        set = false,
        left = 0.0,
        top = 0.0,
        right = 0.0,
        bottom = 0.0
    }
end

function valid_number(value: f64): bool
    return value == value and value >= -UNBOUNDED and value <= UNBOUNDED
end

function validate_intrinsic(value: Intrinsic): unit
    assert(valid_number(value.min_width) and value.min_width >= 0.0)
    assert(valid_number(value.preferred_width) and value.preferred_width >= value.min_width)
    assert(valid_number(value.max_width) and value.max_width >= value.preferred_width)
    assert(valid_number(value.min_height) and value.min_height >= 0.0)
    assert(valid_number(value.preferred_height) and value.preferred_height >= value.min_height)
    assert(valid_number(value.max_height) and value.max_height >= value.preferred_height)
    assert(valid_number(value.baseline))
    assert(value.baseline < 0.0 or value.baseline <= value.min_height)
end

function validate_edges(value: Edges): unit
    assert(valid_number(value.left) and value.left >= 0.0)
    assert(valid_number(value.top) and value.top >= 0.0)
    assert(valid_number(value.right) and value.right >= 0.0)
    assert(valid_number(value.bottom) and value.bottom >= 0.0)
end

function validate_style(value: Style): unit
    assert(valid_number(value.gap))
    assert(value.axis == "row" or value.align ~= "baseline")
    validate_edges(value.padding)
end

function set_rect(target: Rect, x: f64, y: f64, width: f64, height: f64): unit
    target.x = x
    target.y = y
    target.width = width
    target.height = height
end

function copy_intrinsic(target: Intrinsic, value: Intrinsic): unit
    target.min_width = value.min_width
    target.preferred_width = value.preferred_width
    target.max_width = value.max_width
    target.min_height = value.min_height
    target.preferred_height = value.preferred_height
    target.max_height = value.max_height
    target.baseline = value.baseline
end

function fixed_into(target: Intrinsic, width: f64, height: f64): unit
    target.min_width = width
    target.preferred_width = width
    target.max_width = width
    target.min_height = height
    target.preferred_height = height
    target.max_height = height
    target.baseline = -1.0
    validate_intrinsic(target)
end

-- Leaf measurement callbacks write into retained storage. Keeping the fixed
-- spelling here avoids allocating a throwaway Intrinsic on every frame.
function set_fixed(target: Intrinsic, width: f64, height: f64): unit
    fixed_into(target, width, height)
end

function Intrinsic.fixed(width: f64, height: f64): Intrinsic
    local value: Intrinsic = empty_intrinsic()
    fixed_into(value, width, height)
    return value
end

function make(kind: "leaf" | "flow" | "layer" | "padding" | "minimum", children: {Box}): Box
    local owned: {Box} = {}
    local sizes: {f64} = {}
    for child in children do
        table.insert(owned, child)
        table.insert(sizes, 0.0)
    end
    return {
        kind = kind,
        children = owned,
        style = row(0.0, "start", "start"),
        intrinsic = empty_intrinsic(),
        bounds = rect(0.0, 0.0, 0.0, 0.0),
        baseline = -1.0,
        grow = 0.0,
        shrink = 1.0,
        sizes = sizes,
        insets = no_edges(),
        floor_width = 0.0,
        floor_height = 0.0,
        wide = false,
        result = result()
    }
end

function Box.leaf(value: Intrinsic): Box
    validate_intrinsic(value)
    local box: Box = make("leaf", {})
    copy_intrinsic(box.intrinsic, value)
    return box
end

function Box.fixed(width: f64, height: f64): Box
    local box: Box = make("leaf", {})
    fixed_into(box.intrinsic, width, height)
    return box
end

function Box.flow(children: {Box}, flow_style: Style): Box
    validate_style(flow_style)
    local box: Box = make("flow", children)
    box:present_style(flow_style)
    return box
end

function Box.layer(children: {Box}): Box
    return make("layer", children)
end

function Box.padding(child: Box, insets: Edges): Box
    validate_edges(insets)
    local box: Box = make("padding", {child})
    box.insets.left = insets.left
    box.insets.top = insets.top
    box.insets.right = insets.right
    box.insets.bottom = insets.bottom
    box.grow = child.grow
    box.shrink = child.shrink
    return box
end

function Box.minimum(child: Box, width: f64, height: f64, is_wide: bool): Box
    assert(valid_number(width) and width >= 0.0)
    assert(valid_number(height) and height >= 0.0)
    local box: Box = make("minimum", {child})
    box.floor_width = width
    box.floor_height = height
    box.wide = is_wide
    box.grow = child.grow
    box.shrink = child.shrink
    return box
end

-- Presentation and style changes pass through methods so future invalidation
-- can be added here without changing callers.
function Box:present_intrinsic(value: Intrinsic): unit
    assert(self.kind == "leaf")
    validate_intrinsic(value)
    copy_intrinsic(self.intrinsic, value)
end

function Box:present_fixed(width: f64, height: f64): unit
    assert(self.kind == "leaf")
    fixed_into(self.intrinsic, width, height)
end

function Box:present_style(value: Style): unit
    assert(self.kind == "flow")
    validate_style(value)
    self.style.axis = value.axis
    self.style.gap = value.gap
    self.style.justify = value.justify
    self.style.align = value.align
    self.style.padding.left = value.padding.left
    self.style.padding.top = value.padding.top
    self.style.padding.right = value.padding.right
    self.style.padding.bottom = value.padding.bottom
end

function Box:flex(grow: f64, shrink: f64): Box
    assert(valid_number(grow) and grow >= 0.0)
    assert(valid_number(shrink) and shrink >= 0.0)
    self.grow = grow
    self.shrink = shrink
    return self
end

function cap(value: f64): f64
    return math.min(UNBOUNDED, value)
end

function nonnegative(value: f64): f64
    return math.max(0.0, value)
end

function gap_count(children: {Box}): f64
    local count: f64 = 0.0
    for _ in children do
        count += 1.0
    end
    return math.max(0.0, count - 1.0)
end

function child_baseline(value: Intrinsic): f64
    if value.baseline >= 0.0 then
        return value.baseline
    end
    return value.preferred_height
end

function baseline_at_height(value: Intrinsic, height: f64): f64
    if value.baseline >= 0.0 then
        return value.baseline
    end
    return height
end

function measure_flow(self: Box): unit
    local horizontal: bool = self.style.axis == "row"
    local min_main: f64 = 0.0
    local preferred_main: f64 = 0.0
    local max_main: f64 = 0.0
    local min_cross: f64 = 0.0
    local preferred_cross: f64 = 0.0
    local max_cross: f64 = 0.0
    local baseline: f64 = -1.0
    local min_ascent: f64 = 0.0
    local preferred_ascent: f64 = 0.0
    local max_ascent: f64 = 0.0
    local min_descent: f64 = 0.0
    local preferred_descent: f64 = 0.0
    local max_descent: f64 = 0.0

    for child in self.children do
        local value: Intrinsic = child:measure()
        if horizontal then
            min_main += value.min_width
            preferred_main += value.preferred_width
            max_main = cap(max_main + value.max_width)
            min_cross = math.max(min_cross, value.min_height)
            preferred_cross = math.max(preferred_cross, value.preferred_height)
            max_cross = math.max(max_cross, value.max_height)
            baseline = math.max(baseline, child_baseline(value))
            if self.style.align == "baseline" then
                local min_base: f64 = baseline_at_height(value, value.min_height)
                local preferred_base: f64 = child_baseline(value)
                local max_base: f64 = baseline_at_height(value, value.max_height)
                min_ascent = math.max(min_ascent, min_base)
                preferred_ascent = math.max(preferred_ascent, preferred_base)
                max_ascent = math.max(max_ascent, max_base)
                min_descent = math.max(min_descent, value.min_height - min_base)
                preferred_descent = math.max(
                    preferred_descent,
                    value.preferred_height - preferred_base
                )
                max_descent = math.max(max_descent, value.max_height - max_base)
            end
        else
            min_main += value.min_height
            preferred_main += value.preferred_height
            max_main = cap(max_main + value.max_height)
            min_cross = math.max(min_cross, value.min_width)
            preferred_cross = math.max(preferred_cross, value.preferred_width)
            max_cross = math.max(max_cross, value.max_width)
            if baseline < 0.0 then
                baseline = child_baseline(value)
            end
        end
    end

    if horizontal and self.style.align == "baseline" then
        min_cross = min_ascent + min_descent
        preferred_cross = preferred_ascent + preferred_descent
        max_cross = cap(max_ascent + max_descent)
        baseline = preferred_ascent
    end

    local gaps: f64 = 0.0
    if #self.children > 1 then
        gaps = self.style.gap * gap_count(self.children)
    end
    min_main = nonnegative(min_main + gaps)
    preferred_main = math.max(min_main, preferred_main + gaps)
    max_main = math.max(preferred_main, cap(max_main + gaps))

    local padding_main: f64 = self.style.padding.top + self.style.padding.bottom
    local padding_cross: f64 = self.style.padding.left + self.style.padding.right
    if horizontal then
        padding_main = self.style.padding.left + self.style.padding.right
        padding_cross = self.style.padding.top + self.style.padding.bottom
    end
    min_main += padding_main
    preferred_main += padding_main
    max_main = cap(max_main + padding_main)
    min_cross += padding_cross
    preferred_cross += padding_cross
    max_cross = cap(max_cross + padding_cross)
    if baseline >= 0.0 then
        baseline += self.style.padding.top
    end

    local value: Intrinsic = self.intrinsic
    if horizontal then
        value.min_width = min_main
        value.preferred_width = preferred_main
        value.max_width = max_main
        value.min_height = min_cross
        value.preferred_height = preferred_cross
        value.max_height = max_cross
    else
        value.min_width = min_cross
        value.preferred_width = preferred_cross
        value.max_width = max_cross
        value.min_height = min_main
        value.preferred_height = preferred_main
        value.max_height = max_main
    end
    value.baseline = baseline
end

function Box:measure(): Intrinsic
    if self.kind == "leaf" then
        validate_intrinsic(self.intrinsic)
        return self.intrinsic
    end
    if self.kind == "flow" then
        measure_flow(self)
        return self.intrinsic
    end

    local value: Intrinsic = self.intrinsic
    if self.kind == "layer" then
        fixed_into(value, 0.0, 0.0)
        for child in self.children do
            local child_value: Intrinsic = child:measure()
            value.min_width = math.max(value.min_width, child_value.min_width)
            value.preferred_width = math.max(value.preferred_width, child_value.preferred_width)
            value.max_width = math.max(value.max_width, child_value.max_width)
            value.min_height = math.max(value.min_height, child_value.min_height)
            value.preferred_height = math.max(value.preferred_height, child_value.preferred_height)
            value.max_height = math.max(value.max_height, child_value.max_height)
            value.baseline = math.max(value.baseline, child_value.baseline)
        end
        return value
    end

    local child_value: Intrinsic = self.children[1]:measure()
    if self.kind == "padding" then
        local horizontal: f64 = self.insets.left + self.insets.right
        local vertical: f64 = self.insets.top + self.insets.bottom
        value.min_width = child_value.min_width + horizontal
        value.preferred_width = child_value.preferred_width + horizontal
        value.max_width = cap(child_value.max_width + horizontal)
        value.min_height = child_value.min_height + vertical
        value.preferred_height = child_value.preferred_height + vertical
        value.max_height = cap(child_value.max_height + vertical)
        value.baseline = child_value.baseline
        if value.baseline >= 0.0 then
            value.baseline += self.insets.top
        end
        return value
    end

    value.min_width = math.max(child_value.min_width, self.floor_width)
    value.preferred_width = math.max(child_value.preferred_width, self.floor_width)
    value.max_width = math.max(child_value.max_width, self.floor_width)
    if self.wide then
        value.max_width = UNBOUNDED
    end
    value.min_height = math.max(child_value.min_height, self.floor_height)
    value.preferred_height = math.max(child_value.preferred_height, self.floor_height)
    value.max_height = math.max(child_value.max_height, self.floor_height)
    value.baseline = child_value.baseline
    return value
end

function main_min(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.min_width
    end
    return value.min_height
end

function main_preferred(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.preferred_width
    end
    return value.preferred_height
end

function main_max(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.max_width
    end
    return value.max_height
end

function cross_min(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.min_height
    end
    return value.min_width
end

function cross_preferred(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.preferred_height
    end
    return value.preferred_width
end

function cross_max(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.max_height
    end
    return value.max_width
end

function clamp(value: f64, low: f64, high: f64): f64
    return math.max(low, math.min(high, value))
end

function distribute_grow(self: Box, horizontal: bool, extra: f64): f64
    local remaining: f64 = extra
    local pass: i32 = 0
    while pass < #self.children do
        local total_weight: f64 = 0.0
        local index: i32 = 0
        while index < #self.children do
            local child: Box = self.children[index]
            if child.grow > 0.0 and self.sizes[index] < main_max(
                child.intrinsic,
                horizontal
            ) - EPSILON then
                total_weight += child.grow
            end
            index += 1
        end
        if total_weight <= 0.0 then
            break
        end
        local spent: f64 = 0.0
        index = 0
        while index < #self.children do
            local child: Box = self.children[index]
            local room: f64 = main_max(child.intrinsic, horizontal) - self.sizes[index]
            if child.grow > 0.0 and room > EPSILON then
                local applied: f64 = math.min(room, remaining * child.grow / total_weight)
                self.sizes[index] += applied
                spent += applied
            end
            index += 1
        end
        if spent <= EPSILON then
            break
        end
        remaining -= spent
        if remaining <= EPSILON then
            return 0.0
        end
        pass += 1
    end
    return remaining
end

function distribute_shrink(self: Box, horizontal: bool, deficit: f64): f64
    local remaining: f64 = deficit
    local pass: i32 = 0
    while pass < #self.children do
        local total_weight: f64 = 0.0
        local index: i32 = 0
        while index < #self.children do
            local child: Box = self.children[index]
            if child.shrink > 0.0 and self.sizes[index] > main_min(
                child.intrinsic,
                horizontal
            ) + EPSILON then
                total_weight += child.shrink * self.sizes[index]
            end
            index += 1
        end
        if total_weight <= 0.0 then
            break
        end
        local reduced: f64 = 0.0
        index = 0
        while index < #self.children do
            local child: Box = self.children[index]
            local weight: f64 = child.shrink * self.sizes[index]
            local room: f64 = self.sizes[index] - main_min(child.intrinsic, horizontal)
            if weight > 0.0 and room > EPSILON then
                local applied: f64 = math.min(room, remaining * weight / total_weight)
                self.sizes[index] -= applied
                reduced += applied
            end
            index += 1
        end
        if reduced <= EPSILON then
            break
        end
        remaining -= reduced
        if remaining <= EPSILON then
            return 0.0
        end
        pass += 1
    end
    return remaining
end

function include(into: Result, bounds: Rect): unit
    local right: f64 = bounds.x + bounds.width
    local bottom: f64 = bounds.y + bounds.height
    if not into.set then
        into.set = true
        into.left = bounds.x
        into.top = bounds.y
        into.right = right
        into.bottom = bottom
        return
    end
    into.left = math.min(into.left, bounds.x)
    into.top = math.min(into.top, bounds.y)
    into.right = math.max(into.right, right)
    into.bottom = math.max(into.bottom, bottom)
end

function arrange_box(self: Box, into: Result): unit
    local bounds: Rect = self.bounds
    include(into, bounds)
    self.baseline = -1.0
    if self.intrinsic.baseline >= 0.0 then
        self.baseline = bounds.y + self.intrinsic.baseline
    end
    if self.kind == "leaf" then
        return
    end

    if self.kind == "layer" or self.kind == "minimum" then
        for child in self.children do
            local target: Box = child
            set_rect(target.bounds, bounds.x, bounds.y, bounds.width, bounds.height)
            arrange_box(target, into)
        end
        return
    end
    if self.kind == "padding" then
        local child: Box = self.children[1]
        set_rect(
            child.bounds,
            bounds.x + self.insets.left,
            bounds.y + self.insets.top,
            nonnegative(bounds.width - self.insets.left - self.insets.right),
            nonnegative(bounds.height - self.insets.top - self.insets.bottom)
        )
        arrange_box(child, into)
        return
    end
    if #self.children == 0 then
        return
    end

    local horizontal: bool = self.style.axis == "row"
    local inner_x: f64 = bounds.x + self.style.padding.left
    local inner_y: f64 = bounds.y + self.style.padding.top
    local inner_width: f64 = nonnegative(
        bounds.width - self.style.padding.left - self.style.padding.right
    )
    local inner_height: f64 = nonnegative(
        bounds.height - self.style.padding.top - self.style.padding.bottom
    )
    local available_main: f64 = inner_width
    local available_cross: f64 = inner_height
    if not horizontal then
        available_main = inner_height
        available_cross = inner_width
    end

    local used: f64 = 0.0
    local index: i32 = 0
    while index < #self.children do
        local measured_child: Box = self.children[index]
        local size: f64 = main_preferred(measured_child.intrinsic, horizontal)
        self.sizes[index] = size
        used += size
        index += 1
    end
    local gap: f64 = self.style.gap
    if #self.children > 1 then
        used += gap * gap_count(self.children)
    end

    local free: f64 = available_main - used
    if free > EPSILON then
        free = distribute_grow(self, horizontal, free)
    elseif free < -EPSILON then
        free = -distribute_shrink(self, horizontal, -free)
    else
        free = 0.0
    end

    local offset: f64 = 0.0
    if self.style.justify == "center" then
        offset = free * 0.5
    elseif self.style.justify == "end" then
        offset = free
    elseif self.style.justify == "space-between" and free > 0.0 and #self.children > 1 then
        gap += free / gap_count(self.children)
    end

    local row_baseline: f64 = 0.0
    if horizontal and self.style.align == "baseline" then
        for child in self.children do
            local target: Box = child
            row_baseline = math.max(row_baseline, child_baseline(target.intrinsic))
        end
    end

    local cursor: f64 = offset
    index = 0
    while index < #self.children do
        local child: Box = self.children[index]
        local value: Intrinsic = child.intrinsic
        local child_cross: f64 = cross_preferred(value, horizontal)
        if self.style.align == "stretch" then
            child_cross = clamp(
                available_cross,
                cross_min(value, horizontal),
                cross_max(value, horizontal)
            )
        end
        local cross_offset: f64 = 0.0
        if self.style.align == "center" then
            cross_offset = (available_cross - child_cross) * 0.5
        elseif self.style.align == "end" then
            cross_offset = available_cross - child_cross
        elseif horizontal and self.style.align == "baseline" then
            cross_offset = row_baseline - child_baseline(value)
        end

        if horizontal then
            set_rect(
                child.bounds,
                inner_x + cursor,
                inner_y + cross_offset,
                self.sizes[index],
                child_cross
            )
        else
            set_rect(
                child.bounds,
                inner_x + cross_offset,
                inner_y + cursor,
                child_cross,
                self.sizes[index]
            )
        end
        arrange_box(child, into)
        cursor += self.sizes[index] + gap
        index += 1
    end
end

function Box:arrange(x: f64, y: f64, width: f64, height: f64): Result
    assert(valid_number(x) and valid_number(y))
    assert(valid_number(width) and width >= 0.0)
    assert(valid_number(height) and height >= 0.0)
    self:measure()
    set_rect(self.bounds, x, y, width, height)
    local into: Result = self.result
    into.set = false
    into.left = 0.0
    into.top = 0.0
    into.right = 0.0
    into.bottom = 0.0
    arrange_box(self, into)
    set_rect(into.content, into.left, into.top, into.right - into.left, into.bottom - into.top)
    into.overflow_x = math.max(0.0, x - into.left) + math.max(0.0, into.right - (x + width))
    into.overflow_y = math.max(0.0, y - into.top) + math.max(0.0, into.bottom - (y + height))
    into.overflowed = into.overflow_x > EPSILON or into.overflow_y > EPSILON
    return into
end

function Box:measurement(): Intrinsic
    return self.intrinsic
end

function Box:rectangle(): Rect
    return self.bounds
end

function Box:absolute_baseline(): f64
    return self.baseline
end

function contains(bounds: Rect, x: f64, y: f64): bool
    return x >= bounds.x and x <= bounds.x + bounds.width and y >= bounds.y and y <= bounds.y + bounds.height
end

return {
    unbounded = UNBOUNDED,
    rect = rect,
    edges = edges,
    even_edges = even_edges,
    style = style,
    row = row,
    column = column,
    contains = contains,
    set_fixed = set_fixed
}
