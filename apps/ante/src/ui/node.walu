-- Retained UI nodes join Ante's layout storage to measurement and painting.
-- Constructors run when a screen/entity is created; present methods update
-- what that stable node shows; draw performs measure, arrange, and paint over
-- the existing tree. Layout and hit testing therefore share the exact bounds
-- most recently painted.
local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local effect_shaders = require("../effect_shaders")
local ink = require("../ink")
local layout = require("./layout")

export type Graphics = engine.Graphics

export type Surface = {
    graphics: Graphics,
    effects: effect_shaders.EffectShaders,
    card_back: graphics_module.Texture?,
    suit_symbols: graphics_module.Texture?,
    face_cards: graphics_module.Texture?
}
export type Measure = (Graphics?, layout.Intrinsic) -> unit
export type Paint = (Surface, layout.Rect) -> unit
export type HitBehavior = "transparent" | "target" | "opaque"
-- Keep the recursive retained graph behind its behavioral API. Besides
-- enforcing controlled mutation, this prevents the structural expansion
-- tracked by waluau-4ggh from leaking through every presenter signature.
export opaque type Node = {
    box: layout.Box,
    children: {Node},
    measure_content: (Graphics?, layout.Intrinsic) -> unit,
    paint_content: (Surface, layout.Rect) -> unit,
    pointer_key: i32,
    hit_behavior: HitBehavior,
    hit_test: (layout.Rect, f64, f64) -> bool,
    visible: bool,
    enabled: bool
}
export type FlowSpec = {
    gap: f64?,
    justify: layout.Justify?,
    align: layout.Align?,
    padding: layout.Edges?
}

function empty_paint(surface: Surface, bounds: layout.Rect): unit
end
function empty_measure(graphics: Graphics?, into: layout.Intrinsic): unit
end

const FALLBACK_ADVANCE: f64 = 0.75

function text_width(graphics: Graphics?, value: string, size: f64): f64
    if graphics == nil then
        return (#value::f64) * size * FALLBACK_ADVANCE
    end
    return ink.text_width(graphics::Graphics, value, size)
end

function rectangular_hit(bounds: layout.Rect, x: f64, y: f64): bool
    return layout.contains(bounds, x, y)
end

function own(children: {Node}): {Node}
    local result: {Node} = {}
    for child in children do
        table.insert(result, child)
    end
    return result
end

function boxes(children: {Node}): {layout.Box}
    local result: {layout.Box} = {}
    for child in children do
        local node: Node = child
        table.insert(result, node.box)
    end
    return result
end

function make(
    box: layout.Box,
    children: {Node},
    measure: (Graphics?, layout.Intrinsic) -> unit,
    paint: (Surface, layout.Rect) -> unit
): Node
    return {
        box = box,
        children = own(children),
        measure_content = measure,
        paint_content = paint,
        pointer_key = -1,
        hit_behavior = "transparent",
        hit_test = rectangular_hit,
        visible = true,
        enabled = true
    }
end

function Node.sized(width: f64, height: f64, paint: (Surface, layout.Rect) -> unit): Node
    return make(layout.Box.fixed(width, height), {}, empty_measure, paint)
end

-- The callback writes into the node's retained intrinsic record. Entity-local
-- presentation state belongs beside this callback and is updated before draw;
-- the callback itself is created only once.
function Node.measured(
    measure: (Graphics?, layout.Intrinsic) -> unit,
    paint: (Surface, layout.Rect) -> unit
): Node
    return make(layout.Box.fixed(0.0, 0.0), {}, measure, paint)
end

function Node.gap(width: f64, height: f64): Node
    return Node.sized(width, height, empty_paint)
end

-- A retained spacer with no preferred size and an unbounded main-axis cap.
-- Its flex weight lets a surrounding flow assign it leftover room.
function Node.stretch(weight: f64): Node
    local node: Node = Node.measured(
        function(graphics: Graphics?, into: layout.Intrinsic): unit
            into.min_width = 0.0
            into.preferred_width = 0.0
            into.max_width = layout.unbounded
            into.min_height = 0.0
            into.preferred_height = 0.0
            into.max_height = layout.unbounded
            into.baseline = -1.0
        end,
        empty_paint
    )
    return node:flex(weight, 1.0)
end

function Node.flow(children: {Node}, flow_style: layout.Style): Node
    return make(layout.Box.flow(boxes(children), flow_style), children, empty_measure, empty_paint)
end

function Node.layer(children: {Node}): Node
    return make(layout.Box.layer(boxes(children)), children, empty_measure, empty_paint)
end

function Node:padding(insets: layout.Edges): Node
    return make(layout.Box.padding(self.box, insets), {self}, empty_measure, empty_paint)
end

function Node:padded(horizontal: f64, vertical: f64): Node
    return self:padding(layout.even_edges(horizontal, vertical))
end

function Node:min_width(width: f64): Node
    return make(
        layout.Box.minimum(self.box, math.max(0.0, width), 0.0, false),
        {self},
        empty_measure,
        empty_paint
    )
end

function Node:min_height(height: f64): Node
    return make(
        layout.Box.minimum(self.box, 0.0, math.max(0.0, height), false),
        {self},
        empty_measure,
        empty_paint
    )
end

function Node:wide(): Node
    return make(layout.Box.minimum(self.box, 0.0, 0.0, true), {self}, empty_measure, empty_paint)
end

function Node:widened(): Node
    return self:wide()
end

function Node:flex(grow: f64, shrink: f64): Node
    self.box:flex(grow, shrink)
    return self
end

function spec_style(axis: layout.Axis, spec: FlowSpec): layout.Style
    return layout.style(
        axis,
        spec.gap or 0.0,
        spec.justify or "start",
        spec.align or "start",
        spec.padding or layout.edges(0.0, 0.0, 0.0, 0.0)
    )
end

function Node.down(spec: FlowSpec, children: {Node}): Node
    return Node.flow(children, spec_style("column", spec))
end

function Node.across(spec: FlowSpec, children: {Node}): Node
    return Node.flow(children, spec_style("row", spec))
end

-- Controlled leaf presentation is the place a later invalidation version can
-- distinguish layout-affecting changes from paint-only changes.
function Node:present_fixed(width: f64, height: f64): unit
    self.box:present_fixed(width, height)
end

function Node:present_style(value: layout.Style): unit
    self.box:present_style(value)
end

function refresh(self: Node, graphics: Graphics?): unit
    self.measure_content(graphics, self.box:measurement())
    for child in self.children do
        refresh(child, graphics)
    end
end

function Node:measure(graphics: Graphics?): layout.Intrinsic
    refresh(self, graphics)
    return self.box:measure()
end

function Node:arrange(x: f64, y: f64, width: f64, height: f64): layout.Result
    return self.box:arrange(x, y, width, height)
end

function paint_tree(self: Node, surface: Surface): unit
    self.paint_content(surface, self.box:rectangle())
    for child in self.children do
        paint_tree(child, surface)
    end
end

function Node:paint(surface: Surface): unit
    paint_tree(self, surface)
end

function Node:draw(surface: Surface, x: f64, y: f64, width: f64, height: f64): unit
    self:measure(surface.graphics)
    self:arrange(x, y, width, height)
    self:paint(surface)
end

function draw(root: Node, surface: Surface, x: f64, y: f64, width: f64, height: f64): unit
    root:draw(surface, x, y, width, height)
end

function Node:bounds(): layout.Rect
    return self.box:rectangle()
end

function Node:baseline(): f64
    return self.box:absolute_baseline()
end

function Node:accept_pointer(key: i32): Node
    assert(key >= 0)
    self.pointer_key = key
    self.hit_behavior = "target"
    return self
end

-- Pointer-transparent nodes still allow their children to respond. Opaque
-- nodes stop traversal at their painted shape without becoming a target; this
-- is useful for modal shields and other overlays that intentionally eat input.
function Node:pointer_transparent(): Node
    self.pointer_key = -1
    self.hit_behavior = "transparent"
    return self
end

function Node:pointer_opaque(): Node
    self.pointer_key = -1
    self.hit_behavior = "opaque"
    return self
end

function Node:set_hit_test(test: (layout.Rect, f64, f64) -> bool): Node
    self.hit_test = test
    return self
end

function Node:set_visible(value: bool): Node
    self.visible = value
    return self
end

function Node:set_enabled(value: bool): Node
    self.enabled = value
    return self
end

function Node:is_visible(): bool
    return self.visible
end

function Node:is_enabled(): bool
    return self.enabled
end

const HIT_MISS: i32 = -1
const HIT_BLOCKED: i32 = -2

function clear_path(path: {i32}): unit
    while #path > 0 do
        table.remove(path)
    end
end

-- The path is retained by the caller and filled leaf-to-root. Integer responder
-- identities are stable semantic keys: routers can persist focus and pointer
-- state without exposing the recursive node representation.
function hit_path_from(self: Node, x: f64, y: f64, path: {i32}): i32
    if not self.visible then
        return HIT_MISS
    end

    local index: i32 = #self.children
    while index >= 1 do
        local found: i32 = hit_path_from(self.children[index], x, y, path)
        if found == HIT_BLOCKED then
            return HIT_BLOCKED
        end
        if found >= 0 then
            if self.hit_behavior == "target" and self.enabled then
                table.insert(path, self.pointer_key)
            end
            return found
        end
        index -= 1
    end

    if not self.hit_test(self.box:rectangle(), x, y) then
        return HIT_MISS
    end
    if self.hit_behavior == "opaque" then
        return HIT_BLOCKED
    end
    if self.hit_behavior == "target" then
        if not self.enabled then
            return HIT_BLOCKED
        end
        table.insert(path, self.pointer_key)
        return self.pointer_key
    end
    return HIT_MISS
end

function Node:hit_path(x: f64, y: f64, path: {i32}): i32
    clear_path(path)
    local found: i32 = hit_path_from(self, x, y, path)
    if found == HIT_BLOCKED then
        clear_path(path)
        return HIT_MISS
    end
    return found
end

-- Children paint after parents and later siblings paint over earlier ones, so
-- reverse traversal gives pointer routing the same winner as drawing.
function Node:hit(x: f64, y: f64): i32
    local path: {i32} = {}
    return self:hit_path(x, y, path)
end

return { draw = draw, text_width = text_width }
