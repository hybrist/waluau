-- DOM-free checks for the four fixed positions of the ready-ability HUD.
require("waluau:vitest")

local game = require("./game")
local spells = require("./spells/spell")
local box = require("./ui/layout")
local ability_diamond = require("./entities/ability_diamond")

describe(
    "ability diamond",
    function(): unit
        it(
            "places loadout order at South, West, North, then East",
            function(): unit
                expect(ability_diamond.slot_count):toBe(4)

                expect(ability_diamond.slot_x(0)):toBe(ability_diamond.slot_x(2))
                expect(ability_diamond.slot_y(0)):toBeGreaterThan(ability_diamond.slot_y(2))
                expect(ability_diamond.slot_y(1)):toBe(ability_diamond.slot_y(3))
                expect(ability_diamond.slot_x(1)):toBeLessThan(ability_diamond.slot_x(3))
            end
        )

        it(
            "keeps all four sockets in the HUD with one carried spell",
            function(): unit
                local state: game.State = game.State.new(
                    false,
                    {spells.Spell.new(spells.SpellKind.Firebolt, 1)},
                    game.starting_gold
                )
                local size = ability_diamond.node(state:view()):measure(nil)

                expect(size.preferred_width):toBe(ability_diamond.width)
                expect(size.preferred_height):toBe(ability_diamond.height)
                expect(ability_diamond.short_name(spells.SpellKind.Firebolt)):toBe("FIRE")
            end
        )

        it(
            "divides the whole diamond between the four sockets",
            function(): unit
                local bounds: box.Rect = box.rect(
                    0.0,
                    0.0,
                    ability_diamond.width,
                    ability_diamond.height
                )
                -- Each position claims the box around it, so a socket is a far
                -- larger thing to hit than the ring drawn for it.
                for slot = 0::i32, ability_diamond.slot_count - 1 do
                    expect(
                        ability_diamond.nearest_slot(
                            bounds,
                            ability_diamond.slot_x(slot),
                            ability_diamond.slot_y(slot)
                        )
                    ):toBe(slot)
                end
                -- Well outside every ring, and still the socket it is nearest:
                -- the box's own edges belong to the position facing them.
                local center_x: f64 = ability_diamond.width * 0.5
                local center_y: f64 = ability_diamond.height * 0.5
                expect(ability_diamond.nearest_slot(bounds, center_x, 1.0)):toBe(2)
                expect(
                    ability_diamond.nearest_slot(bounds, center_x, ability_diamond.height - 1.0)
                ):toBe(0)
                expect(ability_diamond.nearest_slot(bounds, 1.0, center_y)):toBe(1)
                expect(
                    ability_diamond.nearest_slot(bounds, ability_diamond.width - 1.0, center_y)
                ):toBe(3)
            end
        )
    end
)
