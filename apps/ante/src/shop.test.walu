-- Deterministic, DOM-free checks for the shop between two duels: what a visit's
-- slots stock, what they charge, and what the run walks out with.

require("waluau:vitest")

local game = require("./game")
local run = require("./run")
local shop = require("./shop")
local spells = require("./spells/spell")

-- A run standing in front of its next duel with a purse to spend. The gold is
-- set rather than won: what a duel leaves behind is the run module's business,
-- and every price here is about the pool, not how it was earned.
local function shopping_run(spell: spells.SpellKind, gold: i32): run.State
    local state: run.State = run.new(spell, false)
    state:settle(true, gold)
    -- The purse is set rather than carried: settle charges the duel its target
    -- on the way out, and what the target costs is the run module's business.
    -- Every price below is about the pool, not about how it got that size.
    state.gold = gold
    return state
end

local function open_shop(state: run.State): shop.State
    local intermission: shop.State = shop.new()
    shop.open_for(intermission, state)
    return intermission
end

-- Stock a visit with exactly the goods a test is about, in place of the roll,
-- priced the way the roll would have priced them. Everything downstream of the
-- roll — prices, availability, buying, trading — is what these tests are
-- checking, and none of it should depend on the dice.
local function stock_slots(
    intermission: shop.State, state: run.State, goods: {shop.Goods}
): unit
    local slots: {shop.Slot} = {}
    for item in goods do
        table.insert(slots, {
            category = "spells",
            goods = item,
            item = shop.item_for(item),
            price = shop.price_of(item, state),
            sold = false,
        })
    end
    intermission.slots = slots
    intermission.cursor = 0
end

local function upgrade_goods(kind: spells.SpellKind): shop.Goods
    return Upgrade({ kind = kind })
end

local function learn_goods(kind: spells.SpellKind): shop.Goods
    return Spell({ kind = kind })
end

-- Whether the offer in that slot has been bought.
local function slot_sold(intermission: shop.State, slot: i32): bool
    return intermission.slots[slot].sold
end

-- Move the cursor onto the first trade line, so a test names the choice it means
-- instead of counting rows.
local function point_at_choice(intermission: shop.State, state: run.State, key: i32): unit
    local rows: {shop.Row} = shop.rows(intermission, state)
    for index, row in rows do
        if row.kind == "choice" and row.key == key then
            intermission.cursor = index
            return
        end
    end
    assert(false)
end

-- Move the cursor onto the line that backs out of the question.
local function point_at_cancel(intermission: shop.State, state: run.State): unit
    local rows: {shop.Row} = shop.rows(intermission, state)
    for index, row in rows do
        if row.kind == "cancel" then
            intermission.cursor = index
            return
        end
    end
    assert(false)
end

describe("Ante Magic shop stock", function()
    it("opens on a full row of slots and a way into the duel", function()
        math.randomseed(101)
        local state: run.State = shopping_run(spells.SpellKind.Firebolt, 30)
        local intermission: shop.State = open_shop(state)
        expect(intermission.open):toBe(true)
        expect(shop.choosing(intermission)):toBe(false)
        expect(intermission.cursor):toBe(0)
        expect(#intermission.slots):toBe(#shop.slot_layout())

        -- No slot is ever filled twice over, and every offer is about a spell
        -- the run can actually be sold something for.
        local seen: {number} = {}
        for slot in intermission.slots do
            expect(slot.sold):toBe(false)
            expect(slot.price > 0):toBe(true)
            if Upgrade(upgrade) = slot.goods then
                expect(state:carries(upgrade.kind)):toBe(true)
            end
            if Spell(spell) = slot.goods then
                expect(state:carries(spell.kind)):toBe(false)
            end
            -- Drawn without replacement: the same spell cannot fill two slots.
            local good_kind = slot.goods:spell_kind()
            local good_kind_num = 0
            if good_kind ~= nil then
                good_kind_num = good_kind:tonumber()
            end
            for kind in seen do
                expect(kind == good_kind_num):toBe(false)
            end
            table.insert(seen, good_kind_num)
        end

        local rows: {shop.Row} = shop.rows(intermission, state)
        expect(#rows):toBe(#shop.slot_layout() + 1)
        expect(tostring(rows[2].kind)):toBe("leave")
    end)

    it("stocks only what the run could be sold", function()
        math.randomseed(103)
        local state: run.State = shopping_run(spells.SpellKind.Firebolt, 30)
        expect(state:learn(spells.SpellKind.Clone, 1)):toBe(true)
        -- Two spells carried leaves two to teach and two to upgrade.
        expect(#shop.spell_stock(state)):toBe(4)

        -- A spell at its price floor is not something the shop can sell any
        -- more, so it leaves the stock entirely.
        local steps: i32 = game.spell_cost - run.min_spell_cost
        for _ = 1, steps do expect(state:upgrade(0)):toBe(true) end
        local pool: {shop.Goods} = shop.spell_stock(state)
        expect(#pool):toBe(3)
        for goods in pool do
            local closed: bool = false
            if Upgrade(upgrade) = goods then
                closed = upgrade.kind == spells.SpellKind.Firebolt
            end
            expect(closed):toBe(false)
        end
    end)

    it("greys out what the purse cannot cover", function()
        math.randomseed(107)
        local state: run.State = shopping_run(spells.SpellKind.Clone, 5)
        local intermission: shop.State = open_shop(state)
        stock_slots(intermission, state, {
            upgrade_goods(spells.SpellKind.Clone),
            learn_goods(spells.SpellKind.Firebolt),
        })
        local rows: {shop.Row} = shop.rows(intermission, state)
        expect(rows[0].price):toBe(shop.price_of(upgrade_goods(spells.SpellKind.Clone), state))
        expect(rows[0].available):toBe(true)
        expect(rows[1].price):toBe(shop.learn_price)
        expect(rows[1].available):toBe(false)
        -- The way out is never for sale, so it is never out of reach.
        expect(rows[2].available):toBe(true)

        -- Pressing an offer the run cannot pay for buys nothing rather than
        -- falling through to the next line.
        intermission.cursor = 1
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(state.gold):toBe(5)
        expect(state:spell_count()):toBe(1)
        expect(shop.choosing(intermission)):toBe(false)
        expect(slot_sold(intermission, 1)):toBe(false)
    end)
end)

describe("Ante Magic shop purchases", function()
    it("marks a bought offer sold instead of restocking it", function()
        math.randomseed(109)
        local state: run.State = shopping_run(spells.SpellKind.Firebolt, 40)
        local intermission: shop.State = open_shop(state)
        stock_slots(intermission, state, {
            upgrade_goods(spells.SpellKind.Firebolt),
            learn_goods(spells.SpellKind.Clone),
        })

        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(state.spells[0].cost):toBe(spells.DEFAULT_SPELL_COST - 1)
        expect(state.gold):toBe(36)

        -- The line stays where it was, spent: the same spell is not upgraded a
        -- second time at this shop however often it is pressed, and the offer
        -- beside it is untouched.
        local rows: {shop.Row} = shop.rows(intermission, state)
        expect(#rows):toBe(3)
        expect(rows[0].sold):toBe(true)
        expect(rows[0].available):toBe(false)
        expect(rows[1].sold):toBe(false)
        expect(rows[1].available):toBe(true)

        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(state.spells[0].cost):toBe(spells.DEFAULT_SPELL_COST - 1)
        expect(state.gold):toBe(36)

        -- The other offer is still live, and buying it spends its own price.
        intermission.cursor = 1
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(state:spell_count()):toBe(2)
        expect(state.spells[1].kind::i32):toBe(spells.SpellKind.Clone::i32)
        expect(state.gold):toBe(36 - shop.learn_price)
        local spent: {shop.Row} = shop.rows(intermission, state)
        expect(spent[0].sold):toBe(true)
        expect(spent[1].sold):toBe(true)
        -- Both offers spent leaves the way into the duel and nothing else.
        expect(tostring(spent[2].kind)):toBe("leave")
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(state.gold):toBe(36 - shop.learn_price)
    end)

    it("charges more for each gold already taken off a cast", function()
        math.randomseed(113)
        local state: run.State = shopping_run(spells.SpellKind.FreezeRay, 40)
        local intermission: shop.State = open_shop(state)
        local sharpen: shop.Goods = upgrade_goods(spells.SpellKind.FreezeRay)

        -- The step a spell is on is the run's, not the visit's: a fresh shop
        -- quotes the next step up for a spell an earlier one upgraded.
        expect(shop.price_of(sharpen, state)):toBe(4)
        stock_slots(intermission, state, { sharpen })
        shop.activate(intermission, state)
        expect(state.spells[0].cost):toBe(game.spell_cost - 1)
        expect(state.gold):toBe(36)

        expect(shop.price_of(sharpen, state)):toBe(6)
        stock_slots(intermission, state, { sharpen })
        shop.activate(intermission, state)
        expect(state.spells[0].cost):toBe(game.spell_cost - 2)
        expect(state.gold):toBe(30)

        expect(shop.price_of(sharpen, state)):toBe(8)
        stock_slots(intermission, state, { sharpen })
        shop.activate(intermission, state)
        expect(state.spells[0].cost):toBe(run.min_spell_cost)
        expect(state.gold):toBe(22)

        -- A cast is never free, so the shop cannot offer that spell again at
        -- all: it is out of the stock, and a stale offer for it is closed.
        expect(#shop.spell_stock(state)):toBe(3)
        stock_slots(intermission, state, { sharpen })
        local rows: {shop.Row} = shop.rows(intermission, state)
        expect(rows[0].available):toBe(false)
        shop.activate(intermission, state)
        expect(state.spells[0].cost):toBe(run.min_spell_cost)
        expect(state.gold):toBe(22)
    end)

    it("gives a learned spell the next cast key by itself", function()
        math.randomseed(127)
        local state: run.State = shopping_run(spells.SpellKind.Firebolt, 30)
        local intermission: shop.State = open_shop(state)
        local taught: shop.Goods = learn_goods(spells.SpellKind.RaiseCard)
        stock_slots(intermission, state, { taught })
        expect(shop.destination(taught, state)):toBe(1)
        expect(tostring(shop.activate(intermission, state))):toBe("stay")

        expect(state:spell_count()):toBe(2)
        expect(state.spells[1].kind:tonumber()):toBe(spells.SpellKind.RaiseCard:tonumber())
        expect(state.spells[1].cost):toBe(game.spell_cost)
        expect(state.gold):toBe(30 - shop.learn_price)
        expect(slot_sold(intermission, 0)):toBe(true)
    end)

    it("asks a full loadout which spell a third one replaces", function()
        math.randomseed(131)
        local state: run.State = shopping_run(spells.SpellKind.Firebolt, 40)
        expect(state:learn(spells.SpellKind.Clone, 1)):toBe(true)
        local intermission: shop.State = open_shop(state)
        local taught: shop.Goods = learn_goods(spells.SpellKind.FreezeRay)
        stock_slots(intermission, state, {
            upgrade_goods(spells.SpellKind.Firebolt),
            taught,
        })

        intermission.cursor = 1
        expect(shop.destination(taught, state)):toBe(-1)
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        -- Being asked is not yet buying: the purse, the loadout, and the offer
        -- are all untouched until a spell is named.
        expect(shop.choosing(intermission)):toBe(true)
        expect(shop.pending_slot(intermission)):toBe(1)
        expect(state.gold):toBe(40)
        expect(state:spell_count()):toBe(2)
        expect(slot_sold(intermission, 1)):toBe(false)

        local choices: {shop.Row} = shop.rows(intermission, state)
        expect(#choices):toBe(3)
        expect(tostring(choices[0].kind)):toBe("choice")
        expect((choices[0].spell or spells.SpellKind.Clone):tonumber()):toBe(spells.SpellKind.Firebolt:tonumber())
        expect((choices[1].spell or spells.SpellKind.Firebolt):tonumber()):toBe(spells.SpellKind.Clone:tonumber())
        expect(tostring(choices[2].kind)):toBe("cancel")

        point_at_choice(intermission, state, 1)
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(shop.choosing(intermission)):toBe(false)
        expect(state:spell_count()):toBe(2)
        expect(state.spells[0].kind:tonumber()):toBe(spells.SpellKind.Firebolt:tonumber())
        expect(state.spells[1].kind:tonumber()):toBe(spells.SpellKind.FreezeRay:tonumber())
        expect(state:carries(spells.SpellKind.Clone)):toBe(false)
        expect(state.gold):toBe(40 - shop.learn_price)
        expect(slot_sold(intermission, 1)):toBe(true)
        -- The cursor comes back to the line that was bought, and that line is
        -- spent rather than restocked.
        expect(intermission.cursor):toBe(1)
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(state.gold):toBe(40 - shop.learn_price)
    end)

    it("closes an offer whose spell the other one traded away", function()
        math.randomseed(137)
        local state: run.State = shopping_run(spells.SpellKind.Firebolt, 40)
        expect(state:learn(spells.SpellKind.Clone, 1)):toBe(true)
        local intermission: shop.State = open_shop(state)
        stock_slots(intermission, state, {
            upgrade_goods(spells.SpellKind.Clone),
            learn_goods(spells.SpellKind.RaiseCard),
        })

        -- Trade the very spell the first offer was about.
        intermission.cursor = 1
        shop.activate(intermission, state)
        point_at_choice(intermission, state, 1)
        shop.activate(intermission, state)
        expect(state:carries(spells.SpellKind.Clone)):toBe(false)

        -- An offer names a spell rather than a key, so the upgrading one is
        -- simply closed instead of quietly upgrading whatever moved in.
        local rows: {shop.Row} = shop.rows(intermission, state)
        expect(rows[0].available):toBe(false)
        local before: i32 = state.gold
        intermission.cursor = 0
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(state.gold):toBe(before)
        expect(state.spells[1].cost):toBe(game.spell_cost)
    end)

    it("keeps both spells when the trade is called off", function()
        math.randomseed(139)
        local state: run.State = shopping_run(spells.SpellKind.RaiseCard, 40)
        expect(state:learn(spells.SpellKind.FreezeRay, 1)):toBe(true)
        local intermission: shop.State = open_shop(state)
        stock_slots(intermission, state, {
            learn_goods(spells.SpellKind.Clone),
            upgrade_goods(spells.SpellKind.RaiseCard),
        })
        shop.activate(intermission, state)
        expect(shop.choosing(intermission)):toBe(true)

        point_at_cancel(intermission, state)
        expect(tostring(shop.activate(intermission, state))):toBe("stay")
        expect(shop.choosing(intermission)):toBe(false)
        expect(state.gold):toBe(40)
        expect(state.spells[0].kind:tonumber()):toBe(spells.SpellKind.RaiseCard:tonumber())
        expect(state.spells[1].kind:tonumber()):toBe(spells.SpellKind.FreezeRay:tonumber())
        -- Calling off a trade is not buying: the offer is still for sale, and
        -- the cursor is back on it.
        expect(slot_sold(intermission, 0)):toBe(false)
        expect(intermission.cursor):toBe(0)

        -- Escape backs out of the same question, and then out of the shop.
        shop.activate(intermission, state)
        expect(shop.choosing(intermission)):toBe(true)
        expect(tostring(shop.keypressed(intermission, state, "Escape"))):toBe("stay")
        expect(shop.choosing(intermission)):toBe(false)
        expect(intermission.cursor):toBe(0)
        expect(tostring(shop.keypressed(intermission, state, "Escape"))):toBe("leave")
    end)
end)

describe("Ante Magic shop controls", function()
    it("wraps the cursor over the offers it is showing", function()
        math.randomseed(149)
        local state: run.State = shopping_run(spells.SpellKind.Clone, 30)
        local intermission: shop.State = open_shop(state)
        local count: i32 = shop.row_count(intermission, state)
        expect(count):toBe(3)
        shop.move(intermission, state, -1)
        expect(intermission.cursor):toBe(count - 1)
        shop.move(intermission, state, 1)
        expect(intermission.cursor):toBe(0)
        shop.keypressed(intermission, state, "ArrowDown")
        expect(intermission.cursor):toBe(1)
        shop.keypressed(intermission, state, "ArrowUp")
        expect(intermission.cursor):toBe(0)

        -- A pointer between the lines leaves the cursor where it was.
        shop.focus(intermission, state, 2)
        expect(intermission.cursor):toBe(2)
        shop.focus(intermission, state, -1)
        expect(intermission.cursor):toBe(2)
        shop.focus(intermission, state, count)
        expect(intermission.cursor):toBe(2)

        -- The last line is the way into the duel, whichever gesture takes it.
        expect(tostring(shop.keypressed(intermission, state, "Enter"))):toBe("leave")
    end)

    it("round-trips the visit through development snapshots", function()
        math.randomseed(151)
        local state: run.State = shopping_run(spells.SpellKind.Firebolt, 40)
        expect(state:learn(spells.SpellKind.Clone, 1)):toBe(true)
        local intermission: shop.State = open_shop(state)
        stock_slots(intermission, state, {
            upgrade_goods(spells.SpellKind.Firebolt),
            learn_goods(spells.SpellKind.FreezeRay),
        })
        intermission.cursor = 0
        shop.activate(intermission, state)
        intermission.cursor = 1
        shop.activate(intermission, state)
        expect(shop.choosing(intermission)):toBe(true)

        local encoded: string = shop.snapshot(intermission)
        local restored: shop.State? = shop.restore(encoded)
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            local visit: shop.State = restored
            expect(visit.open):toBe(true)
            expect(#visit.slots):toBe(2)
            -- The spent offer comes back spent: what a visit has already sold is
            -- as much a part of it as what it still has.
            expect(slot_sold(visit, 0)):toBe(true)
            expect(visit.slots[0].goods is Upgrade):toBe(true)
            expect((visit.slots[0].goods:spell_kind() or spells.SpellKind.Clone):tonumber()):toBe(spells.SpellKind.Firebolt:tonumber())
            expect(visit.slots[1].goods is Spell):toBe(true)
            expect((visit.slots[1].goods:spell_kind() or spells.SpellKind.Firebolt):tonumber()):toBe(spells.SpellKind.FreezeRay:tonumber())
            -- The price a visit quoted is part of the visit, not something
            -- re-derived on the way back in.
            expect(visit.slots[1].price):toBe(shop.learn_price)
            expect(shop.pending_slot(visit)):toBe(1)
            expect(visit.cursor):toBe(intermission.cursor)
            expect(shop.snapshot(visit)):toBe(encoded)
        end

        -- A payload from another build, or one this build could not have
        -- written, is a normal refusal rather than a crash.
        local intact: string =
            "duel-shop-v3,1,2,spells,upgrade,1,4,0,spells,spell,2,7,0,0,0"
        expect(shop.restore(intact) == nil):toBe(false)
        expect(shop.restore("duel-shop-v2,1,0,0,-1") == nil):toBe(true)
        expect(shop.restore(intact .. ",unexpected") == nil):toBe(true)
        -- An unknown category, an unknown kind of goods, a spell that does not
        -- exist, and a negative price each fail on their own terms.
        expect(shop.restore(
            "duel-shop-v3,1,1,relics,upgrade,1,4,0,0,0") == nil):toBe(true)
        expect(shop.restore(
            "duel-shop-v3,1,1,spells,charm,1,4,0,0,0") == nil):toBe(true)
        expect(shop.restore(
            "duel-shop-v3,1,1,spells,spell,9,7,0,0,0") == nil):toBe(true)
        expect(shop.restore(
            "duel-shop-v3,1,1,spells,spell,2,-1,0,0,0") == nil):toBe(true)
        -- A pending question must name a slot of this visit.
        expect(shop.restore(
            "duel-shop-v3,1,1,spells,spell,2,7,0,0,1,4,1,0") == nil):toBe(true)
        -- A trade key the loadout could never hold is refused the same way.
        expect(shop.restore(
            "duel-shop-v3,1,1,spells,spell,2,7,0,0,1,0,1,9") == nil):toBe(true)

        -- Closing the shop leaves nothing of the visit behind.
        shop.close(intermission)
        expect(intermission.open):toBe(false)
        expect(#intermission.slots):toBe(0)
        expect(shop.choosing(intermission)):toBe(false)
        expect(intermission.cursor):toBe(0)
    end)
end)
