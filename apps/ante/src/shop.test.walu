-- Deterministic, DOM-free coverage for item stock, purchases, loadout limits,
-- and the development snapshot carried across hot replacement.
require("waluau:vitest")

local item_ = require("./items/item")
local item_catalog = require("./items/catalog")
local run_ = require("./run")
local scroll_ = require("./items/scroll")
local shop_ = require("./shop")
local spell_ = require("./spells/spell")

type Item = item_.Item
type RunState = run_.State
type ShopState = shop_.State
type SpellKind = spell_.SpellKind
type SpellScroll = scroll_.SpellScroll

local function shopping_run(spell: SpellKind, gold: i32)
    local run: RunState = RunState.new(spell, false)
    run:settle(true, gold + run:target())
    return run, ShopState.new(run)
end

local function stock(shop: ShopState, item: Item, price: i32): unit
    shop.slots = {{ item = item, price = price, sold = false }}
    shop.cursor = 0
end

describe(
    "Ante Magic item shop",
    function()
        it(
            "opens with two offers and a way into the duel",
            function()
                math.randomseed(101)
                local _, shop = shopping_run(SpellKind.Firebolt, 30)
                expect(shop.open):toBe(true)
                expect(shop.cursor):toBe(0)
                expect(#shop.slots):toBe(shop_.DEFAULT_SHOP_ITEM_COUNT)

                shop:move(-1)
                expect(shop.cursor):toBe(#shop.slots)
                expect(shop:confirm_choice(RunState.new(SpellKind.Firebolt, false))):toBe(true)
            end
        )

        it(
            "buys an available scroll once and never overspends",
            function()
                local run, shop = shopping_run(SpellKind.Firebolt, 8)
                stock(shop, SpellScroll.new(SpellKind.Firebolt, 2)::Item, 4)

                expect(shop:slot_available(run, 0)):toBe(true)
                expect(shop:confirm_choice(run)):toBe(false)
                expect(run.gold):toBe(4)
                expect(run.spells[1].level):toBe(2)
                expect(shop.slots[1].sold):toBe(true)

                expect(shop:confirm_choice(run)):toBe(false)
                expect(run.gold):toBe(4)
                expect(run.spells[1].level):toBe(2)

                local poor, poor_shop = shopping_run(SpellKind.Clone, 3)
                stock(poor_shop, SpellScroll.new(SpellKind.Clone, 2)::Item, 4)
                expect(poor_shop:slot_available(poor, 0)):toBe(false)
                poor_shop:confirm_choice(poor)
                expect(poor.gold):toBe(3)
                expect(poor.spells[1].level):toBe(1)
                expect(poor_shop.slots[1].sold):toBe(false)
            end
        )

        it(
            "teaches into open space or raises a known spell without replacing it",
            function()
                local run: RunState = RunState.new(SpellKind.Firebolt, false)
                local learn: SpellScroll = SpellScroll.new(SpellKind.Clone, 1)
                expect(learn:can_use(run)):toBe(true)
                learn:use(run)
                expect(run.spells[2].kind):toBe(SpellKind.Clone)
                expect(run.spells[2].level):toBe(1)

                -- Preserve the carried spell record's cast price while changing only
                -- its level; scrolls do not revive the old sharpening product.
                run.spells[1].cost = spell_.DEFAULT_SPELL_COST - 1
                local next_level: SpellScroll = SpellScroll.new(SpellKind.Firebolt, 2)
                expect(next_level:can_use(run)):toBe(true)
                next_level:use(run)
                expect(run.spells[1].level):toBe(2)
                expect(run.spells[1].cost):toBe(spell_.DEFAULT_SPELL_COST - 1)
            end
        )

        it(
            "cannot forget a carried spell to make room for another",
            function()
                local run: RunState = RunState.new(SpellKind.Firebolt, false)
                expect(run:learn_spell(spell_.Spell.new(SpellKind.Clone, 1))):toBe(true)
                local offered: SpellScroll = SpellScroll.new(SpellKind.FreezeRay, 1)
                expect(offered:can_use(run)):toBe(false)

                local shop: ShopState = ShopState.new(run)
                stock(shop, offered::Item, 4)
                local gold: i32 = run.gold
                shop:confirm_choice(run)
                expect(run.gold):toBe(gold)
                expect(run:spell_count()):toBe(2)
                expect(run:carries(SpellKind.Firebolt)):toBe(true)
                expect(run:carries(SpellKind.Clone)):toBe(true)
                expect(run:carries(SpellKind.FreezeRay)):toBe(false)
            end
        )

        it(
            "opens a fresh visit and closes to an empty inert state",
            function()
                local run, shop = shopping_run(SpellKind.Firebolt, 30)
                shop:close()
                expect(shop.open):toBe(false)
                expect(#shop.slots):toBe(0)
                expect(shop.cursor):toBe(0)

                math.randomseed(137)
                shop:open_for(run)
                expect(shop.open):toBe(true)
                expect(#shop.slots):toBe(shop_.DEFAULT_SHOP_ITEM_COUNT)
                expect(shop.cursor):toBe(0)
            end
        )

        it(
            "round-trips item behavior and refuses malformed snapshots",
            function()
                local run, shop = shopping_run(SpellKind.Firebolt, 30)
                stock(shop, SpellScroll.new(SpellKind.Firebolt, 2)::Item, 4)
                shop.slots[1].sold = true
                local encoded: string = shop:snapshot()
                local restored: ShopState? = ShopState.restore(encoded)
                expect(restored == nil):toBe(false)
                if restored ~= nil then
                    local visit: ShopState = restored::ShopState
                    expect(visit.open):toBe(true)
                    expect(visit.slots[1].sold):toBe(true)
                    expect(visit.slots[1].item:describe()):toBe("Firebolt (level 2)")
                    expect(visit:snapshot()):toBe(encoded)
                end

                local stale: string = string.gsub(encoded, "duel%-shop%-v5", "duel-shop-v4")
                expect(ShopState.restore(stale) == nil):toBe(true)
                local unknown_item: string = string.gsub(encoded, "spell%-scroll", "unknown-item")
                expect(ShopState.restore(unknown_item) == nil):toBe(true)
                local negative: string = string.gsub(encoded, '"price":4', '"price":-1')
                expect(ShopState.restore(negative) == nil):toBe(true)

                local invalid_scroll: item_.Snapshot = {
                    kind = "spell-scroll",
                    payload = '{"kind":1,"level":0}'
                }
                expect(item_catalog.restore(invalid_scroll) == nil):toBe(true)

                shop:close()
                local closed: ShopState? = ShopState.restore(shop:snapshot())
                expect(closed == nil):toBe(false)
                if closed ~= nil then
                    expect((closed::ShopState).open):toBe(false)
                    expect(#(closed::ShopState).slots):toBe(0)
                end
            end
        )
    end
)
