-- Vite-managed shader imports and presentation lifetime for Ante Magic effects.
-- Each require becomes a stateful host module that owns compilation, HMR, and
-- its WebGLProgram on the engine canvas across Wasm generations.
local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local shader_program = require("./shader_program")
local card_paper = require("./shaders/card-paper.frag")
local gold_shimmer = require("./shaders/gold-shimmer.frag")
local defeat_shroud = require("./shaders/defeat-shroud.frag")
local card_burn = require("./shaders/card-burn.frag")
local red_fire = require("./shaders/red-fire.frag")
local blue_caustics = require("./shaders/blue-caustics.frag")
local black_hole = require("./shaders/black-hole.frag")
local green_growth = require("./shaders/green-growth.frag")
local ice_freeze = require("./shaders/ice-freeze.frag")
local astral_sea = require("./shaders/astral-sea.frag")

type Graphics = engine.Graphics
export type EffectShaders = {
    card_paper: shader_program.State,
    gold_shimmer: shader_program.State,
    defeat_shroud: shader_program.State,
    card_burn: shader_program.State,
    red_fire: shader_program.State,
    blue_caustics: shader_program.State,
    black_hole: shader_program.State,
    green_growth: shader_program.State,
    ice_freeze: shader_program.State,
    astral_sea: shader_program.State,
    -- The tileable data texture the ice shader samples. Presentation resource
    -- loading fills it in; it travels with the effect registry.
    noise_texture: graphics_module.Texture?,
    -- The baked card stock: the paper shader's two passes rendered once — the
    -- opaque board and the translucent press — so a card costs two sprite
    -- draws instead of two per-pixel procedural evaluations. card.walu fills
    -- these in lazily once the paper program compiles; a rebuild of that
    -- program drops them so the next card re-bakes from the new source.
    paper_board: graphics_module.RenderTarget?,
    paper_press: graphics_module.RenderTarget?,
    -- The still astral sea a viewer who prefers reduced motion sees, baked
    -- once at the board's size by the backdrop and dropped here whenever the
    -- sea program is rebuilt, so the next frame re-bakes from the new source.
    sea_still: graphics_module.RenderTarget?
}
export type State = { shaders: EffectShaders, programs: {shader_program.State} }
export type Diagnostics = { fatal_error: string, warnings: string }

function State.new(): State
    local paper: shader_program.State = shader_program.State.new(card_paper, "card paper", false)
    local gold: shader_program.State = shader_program.State.new(gold_shimmer, "gold shimmer", false)
    local defeat: shader_program.State = shader_program.State.new(
        defeat_shroud,
        "defeat shroud",
        true
    )
    local burn: shader_program.State = shader_program.State.new(card_burn, "card burn", false)
    local red: shader_program.State = shader_program.State.new(red_fire, "red", false)
    local blue: shader_program.State = shader_program.State.new(blue_caustics, "blue", false)
    local black: shader_program.State = shader_program.State.new(black_hole, "black", false)
    local green: shader_program.State = shader_program.State.new(green_growth, "green", false)
    local ice: shader_program.State = shader_program.State.new(ice_freeze, "ice", false)
    local sea: shader_program.State = shader_program.State.new(astral_sea, "astral sea", false)
    return {
        shaders = {
            card_paper = paper,
            gold_shimmer = gold,
            defeat_shroud = defeat,
            card_burn = burn,
            red_fire = red,
            blue_caustics = blue,
            black_hole = black,
            green_growth = green,
            ice_freeze = ice,
            astral_sea = sea,
            noise_texture = nil,
            paper_board = nil,
            paper_press = nil,
            sea_still = nil
        },
        programs = {paper, gold, defeat, burn, red, blue, black, green, ice, sea}
    }
end

-- Refresh every imported handle before drawing. Each host module compiles its
-- own revisions independently and retains its last good program on failure.
function State:refresh(graphics: Graphics): unit
    for program in self.programs do
        local changed: bool = program:refresh(graphics)
        -- A rebuilt paper program orphans the baked card stock; dropping the
        -- bake here lets the next drawn card re-bake from the new source.
        if program.label == self.shaders.card_paper.label and changed then
            self:release_paper_bake(graphics)
        end
        if program.label == self.shaders.astral_sea.label and changed then
            self:release_sea_bake(graphics)
        end
    end
end

function State:release_sea_bake(graphics: Graphics): unit
    local still: graphics_module.RenderTarget? = self.shaders.sea_still
    if still ~= nil then
        graphics:release_render_target(still::graphics_module.RenderTarget)
    end
    self.shaders.sea_still = nil
end

function State:release_paper_bake(graphics: Graphics): unit
    local board: graphics_module.RenderTarget? = self.shaders.paper_board
    if board ~= nil then
        graphics:release_render_target(board::graphics_module.RenderTarget)
    end
    self.shaders.paper_board = nil
    local press: graphics_module.RenderTarget? = self.shaders.paper_press
    if press ~= nil then
        graphics:release_render_target(press::graphics_module.RenderTarget)
    end
    self.shaders.paper_press = nil
end

function append_warning(warnings: string, warning: string): string
    if #warning == 0 then
        return warnings
    end
    if #warnings > 0 then
        warnings ..= "; "
    end
    return warnings .. warning
end

function State:diagnostics(): Diagnostics
    local fatal_error: string = ""
    local warnings: string = ""
    for program in self.programs do
        if program.required then
            fatal_error = program.error
        else
            warnings = append_warning(warnings, program.error)
        end
    end
    return { fatal_error = fatal_error, warnings = warnings }
end

function State:release(graphics: Graphics): unit
    for program in self.programs do
        program:release(graphics)
    end
    self:release_paper_bake(graphics)
    self:release_sea_bake(graphics)
    local noise: graphics_module.Texture? = self.shaders.noise_texture
    if noise ~= nil then
        graphics:release_texture(noise::graphics_module.Texture)
    end
    self.shaders.noise_texture = nil
end
