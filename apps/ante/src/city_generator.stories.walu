-- Isolated city laboratory: the gameplay map deliberately does not import it.
local storybook = require("waluau:engine/storybook")
local engine = require("waluau:engine")
local generator = require("./city_generator")
local plan = require("./city_plan_render")

local seed = storybook.range("seed", 41, 1, 999, 1)
local bridges = storybook.range("bridges", 1, 0, 2, 1)
local relief = storybook.range("relief", 10, 0, 20, 1)
local size = storybook.range("settlement size", 90, 30, 900, 10)
local density = storybook.range("housing density", 85, 0, 100, 5)
local water = storybook.range("river", 1, 0, 1, 1)
local graph = storybook.range("junction overlay", 0, 0, 1, 1)
local parcels = storybook.range("access overlay", 0, 0, 1, 1)
local terrain = storybook.range("terrain overlay", 1, 0, 1, 1)
local route_start = storybook.range("route start node", 1, 1, 900, 1)
local route_end = storybook.range("route end node", 2, 1, 900, 1)

type View = { city: generator.City, route: {i32}, heights: {f64} }
local view: View = {
    city = generator.generate(
        { seed = 41, bridges = 1, river = true, relief = 1.0, size = 90, density = 85 }
    ),
    route = {},
    heights = {}
}

local function load(): unit
    view.city = generator.generate(
        {
            seed = seed.value(),
            bridges = bridges.value(),
            river = water.value() > 0,
            relief = (relief.value()::f64) / 10.0,
            size = size.value(),
            density = density.value()
        }
    )
    view.route = generator.shortest_path(view.city, route_start.value(), route_end.value())
    view.heights = plan.sample_heights(view.city)
end

local function draw(graphics: engine.Graphics, _alpha: f64): unit
    graphics:use_builtin_font()
    graphics:set_font("12px")
    local city: generator.City = view.city
    local scale: f64 = math.min(936.0 / city.width, 560.0 / city.height)
    local origin_x: f64 = (960.0 - city.width * scale) * 0.5
    local origin_y: f64 = 49.0
    graphics:push()
    graphics:translate(origin_x, origin_y)
    graphics:scale(scale, scale)
    plan.draw(
        graphics,
        city,
        view.heights,
        {
            terrain = terrain.value() > 0,
            access = parcels.value() > 0,
            junctions = graph.value() > 0
        }
    )
    plan.draw_route(graphics, city, view.route)
    graphics:pop()
    -- Labels stay readable at the largest map size instead of shrinking with
    -- individual houses. Place coordinates remain available in generated data.
    for place in city.landmarks do
        local x: f64 = origin_x + place.center.x * scale
        -- The church sits near the old market; label it to the other side so
        -- their captions remain separate when the largest city is fit to view.
        if place.kind == "church" then
            x -= 94.0
        end
        local y: f64 = origin_y + (place.center.y - place.radius) * scale - 6.0
        graphics:set_font("11px")
        graphics:set_color("#f0e8d6")
        graphics:fill_rectangle(x - 2.0, y - 11.0, 94.0, 14.0)
        graphics:set_color("#493e34")
        graphics:print(place.name, x, y)
    end
    graphics:set_font("12px")
    graphics:set_color("#f0e8d6")
    graphics:fill_rectangle(0.0, 0.0, 960.0, 43.0)
    graphics:fill_rectangle(0.0, 618.0, 960.0, 22.0)
    graphics:set_color("#493e34")
    graphics:print("CITY LAYOUT LAB / SEED " .. tostring(seed.value()), 18.0, 18.0)
    graphics:print(
        tostring(
            #city.nodes
        ) .. " junctions / " .. tostring(
            #city.edges
        ) .. " streets / " .. tostring(#city.buildings) .. " houses",
        18.0,
        34.0
    )
    if #view.route == 0 then
        graphics:print("NO ROUTE BETWEEN SELECTED NODES", 458.0, 26.0)
    else
        graphics:print(
            "ROUTE " .. tostring(
                route_start.value()
            ) .. " > " .. tostring(
                route_end.value()
            ) .. " / " .. tostring(
                math.floor(generator.route_length(city, view.route))::i32
            ) .. " units",
            560.0,
            26.0
        )
    end
    graphics:print(
        "Old town: shared walls / narrow passages / courtyards    Outskirts: detached houses",
        18.0,
        633.0
    )
end

storybook.publish(
    {
        storybook.story(
            "Medieval layout",
            { load = load, draw = draw, width = 960, height = 640, background = "#cdd1b0" },
            {
                seed.declaration,
                bridges.declaration,
                relief.declaration,
                size.declaration,
                density.declaration,
                water.declaration,
                graph.declaration,
                parcels.declaration,
                terrain.declaration,
                route_start.declaration,
                route_end.declaration
            }
        )
    }
)
