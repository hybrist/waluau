-- DOM-free checks for the live viewport layout and its semantic board bands.

require("waluau:vitest")

local layout = require("./layout")

describe("Ante Magic canvas layout", function()
    it("uses additional width as logical layout space", function()
        layout.update(1200.0, 600.0)
        local state: layout.State = layout.current()

        expect(state.scale):toBe(1.0)
        expect(state.width):toBe(1200.0)
        expect(state.height):toBe(600.0)
        expect(state.center_x):toBe(600.0)
        expect(state.side_right):toBe(1040.0)
        -- The hand lane caps at five card widths however much width there is.
        expect(state.hand_span):toBe(520.0)
    end)

    it("scales every element up together when both dimensions allow it", function()
        layout.update(2100.0, 1200.0)
        local state: layout.State = layout.current()

        -- Twice the canvas is the same board drawn at twice the unit size:
        -- the logical viewport reads the same as half the canvas would.
        expect(state.scale):toBe(2.0)
        expect(state.width):toBe(1050.0)
        expect(state.height):toBe(600.0)
        expect(state.computer_y):toBe(116.0)
        expect(state.player_y):toBe(509.0)
        expect(state.footer_y):toBe(582.0)
    end)

    it("sizes the board from the actual width when the canvas turns narrow", function()
        layout.update(350.0, 600.0)
        local state: layout.State = layout.current()

        -- The width is the tighter fit, so the unit scale answers to it and
        -- the logical viewport grows tall instead of the cards going tiny.
        expect(state.scale):toBe(0.5)
        expect(state.width):toBe(700.0)
        expect(state.height):toBe(1200.0)
        expect(layout.canvas_x(100.0)):toBe(200.0)
        expect(layout.canvas_y(250.0)):toBe(500.0)

        -- Extra height spreads through the bands rather than pooling in one
        -- gap: the title band grows, the fan lifts off the floor, and the
        -- rows keep clear daylight between them.
        expect(state.computer_y):toBeGreaterThan(116.0)
        expect(state.player_y):toBeLessThan(state.height - 91.0)
        expect(state.table_card_y):toBeGreaterThan(state.computer_y + 128.0)
        expect(state.table_card_y + 128.0):toBeLessThan(state.player_y - 64.0)
    end)

    it("keeps a usable hand lane at the packed board width", function()
        layout.update(700.0, 600.0)
        local state: layout.State = layout.current()

        expect(state.scale):toBe(1.0)
        expect(state.width):toBe(700.0)
        expect(state.hand_span):toBe(260.0)
        -- The table_card row still clears both side columns.
        expect(state.center_x - 168.0):toBeGreaterThan(state.side_left + 104.0)
        expect(state.center_x + 168.0):toBeLessThan(state.side_right)
    end)

    it("survives an unmeasured canvas", function()
        layout.update(0.0, 0.0)
        local state: layout.State = layout.current()

        expect(state.scale):toBeGreaterThan(0.0)
        expect(state.width):toBeGreaterThan(0.0)
        expect(state.height):toBeGreaterThan(0.0)
    end)
end)
