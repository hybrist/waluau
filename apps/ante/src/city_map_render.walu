-- The live city is the same landscape and spell as the scrying study.
-- The run still owns travel, camera timing, and the handover to the duel.
local engine = require("waluau:engine")
local gpu = require("waluau:engine/graphics")
local city_map = require("./city_map")
local generator = require("./city_generator")
local city_render = require("./city_generator_render")
local route_render = require("./city_route_render")
local lens = require("./city_scrying.frag")

export type State = {
    seed: i32,
    city: generator.City?,
    heights: {f64},
    target: gpu.RenderTarget?,
    owner: engine.Graphics?
}

function State.new(): State
    return { seed = -1, city = nil, heights = {}, target = nil, owner = nil }
end

function prepare_city(view: State, seed: i32): unit
    if view.city ~= nil and view.seed == seed then
        return
    end
    local city = generator.generate(
        { seed = seed, bridges = 1, river = true, relief = 1.0, size = 90, density = 85 }
    )
    view.city = city
    view.seed = seed
    view.heights = {}
    for y = 0::i32, 47::i32 do
        for x = 0::i32, 71::i32 do
            table.insert(
                view.heights,
                generator.elevation(
                    city,
                    { x = (x::f64) * city.width / 72.0, y = (y::f64) * city.height / 48.0 }
                )
            )
        end
    end
end

function State:draw(state: city_map.State, graphics: engine.Graphics, landmark: i32): unit
    if not state:visible() then
        return
    end
    prepare_city(self, state.scenery_seed)
    local width: i32 = math.ceil(state.view_width)::i32
    local height: i32 = math.ceil(state.view_height)::i32
    local owner = self.owner
    local previous = self.target
    if owner ~= nil then
        if (owner::engine.Graphics).disposed then
            self.target = nil
        elseif previous ~= nil then
            local target = previous::gpu.RenderTarget
            if target.width ~= width or target.height ~= height then
                (owner::engine.Graphics):release_render_target(target)
                self.target = nil
            end
        end
    end
    if self.target == nil then
        local created = graphics:create_render_target(width, height)
        if not created.ok then
            error("Scrying target: " .. created.error.message)
        end
        self.target = created.target
        self.owner = graphics
    end
    local maybe_target = self.target
    local maybe_city = self.city
    if maybe_target ~= nil then
        if maybe_city ~= nil then
            local target: gpu.RenderTarget = maybe_target::gpu.RenderTarget
            local city: generator.City = maybe_city::generator.City
            if not graphics:set_render_target(target) then
                error("Cannot bind scrying target")
            end
            graphics:clear("#cdd1b0")
            -- Capture in logical pixels even when the caller has scaled its UI.
            graphics:push_identity()
            graphics:translate(state.anchor_x, state.anchor_y)
            graphics:scale(
                state.zoom * city_map.width / city.width,
                state.zoom * city_map.height / city.height
            )
            graphics:translate(
                -state.camera_x * city.width / city_map.width,
                -state.camera_y * city.height / city_map.height
            )
            city_render.draw(graphics, city, self.heights, true, false)
            graphics:pop()
            graphics:set_screen_target()
            local bound = graphics:bind_imported_shader(
                lens,
                {
                    gpu.float_parameter("u_width", state.view_width),
                    gpu.float_parameter("u_height", state.view_height),
                    gpu.float_parameter("u_focus_x", state.anchor_x / state.view_width),
                    gpu.float_parameter("u_focus_y", 1.0 - state.anchor_y / state.view_height),
                    gpu.float_parameter("u_opacity", state.cover),
                    gpu.float_parameter("u_clock", state.pan_clock),
                    gpu.float_parameter("u_strength", 1.0),
                    gpu.float_parameter("u_static_circle", 1.0),
                    gpu.float_parameter("u_peak_time", 0.3),
                    gpu.float_parameter("u_travel_time", 7.0)
                }
            )
            if not bound.ok then
                error("Scrying lens: " .. bound.error.message)
            end
            graphics:set_color("#ffffff")
            graphics:draw_render_target(target, 0.0, 0.0, state.view_width, state.view_height)
            graphics:use_default_shader()
            route_render.draw(state, graphics, landmark)
        end
    end
end
