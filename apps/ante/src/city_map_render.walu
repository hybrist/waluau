-- WebGL2 presentation for the DOM-free city map. Muted rooftops keep whatever
-- list is standing over them readable; the saturated things are the route the
-- duel walks and the thief streak passing somewhere else in the city.
--
-- Everything is drawn at `alpha`, so the same picture serves both the map
-- screens and the handover into and out of a duel. At full opacity it clears
-- the frame; at anything less it lays itself over whatever is already there,
-- which is the duel the map is giving the screen to.
--
-- The push into a house is drawn as well as zoomed. As the camera closes, the
-- route furniture and then the surrounding city drop away, so what is left
-- growing into the frame is the one house being entered — its dark interior
-- becomes the room the duel's own backdrop fades in behind.
local engine = require("waluau:engine")
local ink = require("./ink")
local plate = require("./plate")
local city_map = require("./city_map")

type Graphics = engine.Graphics
type Point = city_map.Point

const STREAK_LENGTH: f64 = 118.0

const NIGHT: string = "#05060a"
const ASPHALT: string = "#303330"
const SCRIM: string = "#05060a"
const SCRIM_STRENGTH: f64 = 0.34

-- The road already walked, and the road still to come. The walked half is the
-- one gold thing on the map; the rest is a dashed intention.
const ROUTE_DONE: string = "#fbbf24"
const ROUTE_AHEAD: string = "#5b5f70"
const DASH_LENGTH: f64 = 13.0
const DASH_GAP: f64 = 11.0

-- A stop the route has already reached is lit rather than merely brighter:
-- the tone it is drawn in also spills into the street around it, which is what
-- separates a landmark from a symbol on a key.
const LANTERN_RINGS: i32 = 5
const LANTERN_STRENGTH: f64 = 0.30

function draw_lantern(
    graphics: Graphics,
    stop: city_map.Stop,
    tone: string,
    reach: f64,
    alpha: f64
): unit
    graphics:set_color(tone)
    plate.halo(
        graphics,
        stop.x,
        stop.y,
        reach * 0.35,
        reach,
        LANTERN_RINGS,
        LANTERN_STRENGTH * alpha
    )
end

const VAULT_INK: string = "#fbbf24"
const VAULT_DIM: string = "#6b6f7d"
const VENDOR_INK: string = "#67e8f9"
const VENDOR_DIM: string = "#4a5560"

-- Roof palettes belong to neighborhoods: copper, terracotta, slate and plum.
function roof_tone(tone: i32): string
    if tone == 0 then
        return "#65756c"
    end
    if tone == 1 then
        return "#976951"
    end
    if tone == 2 then
        return "#62788b"
    end
    return "#796477"
end

-- Hipped tile roofs, with a raised ridge, stone walls, eaves and chimneys.
-- Geometry stays local so the same house can face a lane at a slight angle.
function house(graphics: Graphics, x: f64, y: f64, w: f64, h: f64, tone: i32, alpha: f64): unit
    graphics:set_color(ink.fade("#090e14", alpha * 0.8))
    graphics:fill_quad(x, y + h, x + w, y + h, x + w + 9.0, y + h + 10.0, x + 9.0, y + h + 10.0)
    graphics:set_color(ink.fade("#574c42", alpha))
    graphics:fill_rectangle(x + 1.0, y + 5.0, w - 2.0, h)
    graphics:set_color(ink.fade(roof_tone(tone), alpha))
    graphics:fill_quad(x, y, x + w, y, x + w - 5.0, y + h * 0.48, x + 5.0, y + h * 0.48)
    graphics:set_color(ink.fade("#354049", alpha))
    graphics:fill_quad(x + 5.0, y + h * 0.48, x + w - 5.0, y + h * 0.48, x + w, y + h, x, y + h)
    graphics:set_color(ink.fade("#4c5358", alpha))
    graphics:emit_triangle(x, y, x + 5.0, y + h * 0.48, x, y + h)
    graphics:emit_triangle(x + w, y, x + w, y + h, x + w - 5.0, y + h * 0.48)
    graphics:set_line_width(0.7)
    graphics:set_color(ink.fade("#b2a087", alpha * 0.6))
    graphics:line(x + 5.0, y + h * 0.48, x + w - 5.0, y + h * 0.48)
    for tile = 1::i32, 3 do
        local ty: f64 = y + h * (tile::f64) * 0.12
        graphics:line(x + 3.0, ty, x + w - 3.0, ty)
    end
    graphics:set_color(ink.fade("#b4a18a", alpha))
    graphics:fill_rectangle(x + w * 0.7, y + 2.0, 3.0, 5.0)
    graphics:set_color(ink.fade("#26282c", alpha))
    graphics:fill_rectangle(x + w * 0.7, y + 2.0, 3.0, 2.0)
    graphics:set_color(ink.fade("#d5a461", alpha * 0.85))
    graphics:fill_rectangle(x + 5.0, y + h + 2.0, 2.0, 2.0)
end

function tower(graphics: Graphics, x: f64, y: f64, radius: f64, pointed: bool, alpha: f64): unit
    graphics:set_color(ink.fade("#080e15", alpha * 0.8))
    graphics:fill_circle(x + 7.0, y + 10.0, radius + 2.0)
    graphics:set_color(ink.fade("#8c8777", alpha))
    graphics:fill_circle(x, y + 3.0, radius + 1.5)
    graphics:set_color(ink.fade("#424d56", alpha))
    graphics:fill_circle(x, y, radius)
    for side = 0::i32, 7 do
        local angle: f64 = (side::f64) * 0.785398
        local ax: f64 = x + math.cos(angle) * radius
        local ay: f64 = y + math.sin(angle) * radius
        if pointed then
            graphics:set_color(ink.fade("#647f8d", alpha))
            if side > 3 then
                graphics:set_color(ink.fade("#354455", alpha))
            end
            graphics:emit_triangle(
                x - 2.0,
                y - 5.0,
                ax,
                ay,
                x + math.cos(angle + 0.785398) * radius,
                y + math.sin(angle + 0.785398) * radius
            )
        else
            graphics:set_color(ink.fade("#b1a38a", alpha))
            graphics:fill_rectangle(ax - 1.5, ay - 1.5, 3.0, 3.0)
        end
    end
    if pointed then
        graphics:set_color(ink.fade("#dfbb79", alpha))
        graphics:fill_circle(x - 2.0, y - 5.0, 1.5)
    end
end

function tree(graphics: Graphics, x: f64, y: f64, radius: f64, alpha: f64): unit
    graphics:set_color(ink.fade("#0d1718", alpha))
    graphics:fill_circle(x + 3.0, y + 4.0, radius)
    graphics:set_color(ink.fade("#354f43", alpha))
    graphics:fill_circle(x, y, radius)
    graphics:set_color(ink.fade("#536a50", alpha))
    graphics:fill_circle(x - 2.0, y - 2.0, radius * 0.65)
end

-- Each generated parcel is a small district, not one oversized house. The
-- footprint and seed choose its architecture; no randomness runs per frame.
function draw_rooftop(graphics: Graphics, building: city_map.Building, alpha: f64): unit
    graphics:push()
    graphics:translate(building.x + building.width * 0.5, building.y + building.height * 0.5)
    graphics:rotate(math.sin(building.x * 0.13 + building.y * 0.07) * 0.16)
    local w: f64 = building.width
    local h: f64 = building.height
    if building.detail == 1 or building.detail == 3 then
        graphics:rotate(1.570796)
        w = building.height
        h = building.width
    end
    local x: f64 = -w * 0.5
    local y: f64 = -h * 0.5
    local kind: i32 = building.detail
    if kind == 5 then
        -- Walled keep: an open bailey, four crenellated towers and a great hall.
        plate.border(
            graphics,
            x + 9.0,
            y + 8.0,
            w - 18.0,
            h - 16.0,
            ink.fade("#8a8270", alpha),
            4.0
        )
        house(graphics, x + w * 0.29, y + h * 0.27, w * 0.42, h * 0.42, 2, alpha)
        tower(graphics, x + 10.0, y + 9.0, 8.0, false, alpha)
        tower(graphics, -x - 10.0, y + 9.0, 8.0, false, alpha)
        tower(graphics, x + 10.0, -y - 9.0, 8.0, false, alpha)
        tower(graphics, -x - 10.0, -y - 9.0, 8.0, false, alpha)
    elseif kind == 6 then
        -- Cruciform cathedral, buttresses, apse and a tall crossing spire.
        for buttress = 1::i32, 4 do
            graphics:set_color(ink.fade("#a29983", alpha))
            graphics:fill_rectangle(-w * 0.23, y + (buttress::f64) * h * 0.16, w * 0.46, 3.0)
        end
        tower(graphics, 0.0, y + 12.0, w * 0.17, false, alpha)
        house(graphics, x + 7.0, -h * 0.13, w - 14.0, h * 0.26, 2, alpha)
        house(graphics, -w * 0.17, y + 8.0, w * 0.34, h - 16.0, 2, alpha)
        tower(graphics, 0.0, -3.0, 10.0, true, alpha)
    elseif kind == 7 then
        -- Market square: striped canvas, crates and a stone fountain.
        for row = 0::i32, 1 do
            for stall = 0::i32, 3 do
                local sx: f64 = x + 5.0 + (stall::f64) * (w - 14.0) / 4.0
                local sy: f64 = y + 4.0 + (row::f64) * (h - 20.0)
                house(graphics, sx, sy, 16.0, 11.0, building.tone, alpha)
                graphics:set_color(ink.fade("#d3bb8c", alpha))
                for stripe = 0::i32, 2 do
                    graphics:fill_rectangle(sx + (stripe::f64) * 6.0, sy, 2.5, 10.0)
                end
            end
        end
        graphics:set_color(ink.fade("#a19a82", alpha))
        graphics:fill_circle(0.0, 0.0, 10.0)
        graphics:set_color(ink.fade("#416575", alpha))
        graphics:fill_circle(0.0, 0.0, 7.0)
        graphics:set_color(ink.fade("#b0b6a7", alpha))
        graphics:fill_circle(-1.0, -2.0, 3.0)
    elseif kind == 8 then
        -- An arcane college in a wooded close, with satellite turrets.
        house(graphics, -w * 0.3, -h * 0.2, w * 0.6, h * 0.4, 3, alpha)
        tower(graphics, 0.0, -4.0, 15.0, true, alpha)
        tower(graphics, -w * 0.3, h * 0.13, 7.0, true, alpha)
        tower(graphics, w * 0.3, h * 0.13, 7.0, true, alpha)
        for index = 0::i32, 3 do
            tree(graphics, x + 8.0 + (index::f64) * (w - 16.0) / 3.0, -y - 5.0, 6.0, alpha)
        end
    else
        -- Narrow houses face a crooked internal lane. Alternating setbacks,
        -- wings and gardens give each block a broken, inhabited silhouette.
        local count: i32 = math.max(2.0, math.floor(w / 25.0))::i32
        local span: f64 = w / (count::f64)
        for row = 0::i32, 1 do
            for index = 0::i32, count - 1 do
                local sx: f64 = x + (index::f64) * span + 2.0
                local sy: f64 = y + (row::f64) * h * 0.57 + ((index + kind) % 3)::f64 * 2.0
                local rh: f64 = h * 0.34 + ((index + kind) % 2)::f64 * 4.0
                house(graphics, sx, sy, span - 3.0, rh, (building.tone + index % 2) % 4, alpha)
                if (index + kind) % 3 == 0 then
                    house(graphics, sx + 2.0, sy + rh - 3.0, span * 0.45, 9.0, building.tone, alpha)
                end
            end
        end
        tree(graphics, x + w * 0.7, y + h * 0.5, 4.0, alpha)
    end
    graphics:pop()
end

-- Worn cobble seams, drawn only where they can be seen. `across` bounds pick the
-- streets on the screen and `along` bounds the stretch of each one that is on
-- it, which is what keeps a city several screens wide costing one screen.
function draw_street_marks(
    graphics: Graphics,
    streets: {f64},
    vertical: bool,
    limit: i32,
    across_low: f64,
    across_high: f64,
    along_low: f64,
    along_high: f64,
    alpha: f64
): unit
    local first: i32 = math.floor(along_low / 28.0)::i32 * 28
    if first < 8 then
        first = 8
    end
    local last: i32 = math.floor(along_high)::i32 + 28
    if last > limit - 8 then
        last = limit - 8
    end
    graphics:set_color(ink.fade("#777360", alpha * 0.35))
    graphics:set_line_width(1.0)
    for street in streets do
        if street >= across_low and street <= across_high then
            for mark = first, last, 28 do
                if vertical then
                    graphics:line(street - 4.0, mark::f64, street + 3.0, (mark + 1)::f64)
                else
                    graphics:line(mark::f64, street - 4.0, (mark + 1)::f64, street + 3.0)
                end
            end
        end
    end
end

-- The canal follows one generated avenue. Stone bridges at every crossing
-- keep the route connected, including cities whose route uses the towpath.
function draw_canal(state: city_map.State, graphics: Graphics, alpha: f64): unit
    local index: i32 = math.floor((#state.vertical_streets)::f64 * 0.55)::i32
    local x: f64 = state.vertical_streets[index]
    graphics:set_color(ink.fade("#686a5d", alpha))
    graphics:fill_rectangle(x - 14.0, 0.0, 28.0, city_map.height)
    graphics:set_color(ink.fade("#253f49", alpha))
    graphics:fill_rectangle(x - 11.0, 0.0, 22.0, city_map.height)
    graphics:set_line_width(0.7)
    graphics:set_color(ink.fade("#799698", alpha * 0.35))
    for ripple = 0::i32, 140 do
        local y: f64 = (ripple::f64) * 13.0
        local offset: f64 = math.sin(y * 0.3) * 5.0
        graphics:line(x - 4.0 + offset, y, x + 2.0 + offset, y - 2.0)
    end
    for crossing in state.horizontal_streets do
        graphics:set_color(ink.fade("#101d24", alpha * 0.8))
        graphics:fill_rectangle(x - 14.0, crossing + 5.0, 33.0, 8.0)
        graphics:set_color(ink.fade("#777569", alpha))
        graphics:fill_rectangle(x - 19.0, crossing - 8.0, 38.0, 16.0)
        graphics:set_color(ink.fade("#b4a68a", alpha))
        graphics:fill_rectangle(x - 19.0, crossing - 9.0, 38.0, 2.0)
        graphics:fill_rectangle(x - 19.0, crossing + 7.0, 38.0, 2.0)
    end
end

function clamp(value: f64, low: f64, high: f64): f64
    if value < low then
        return low
    end
    if value > high then
        return high
    end
    return value
end

-- 0 at or below `low`, 1 at or above `high`, eased between them.
function ramp(value: f64, low: f64, high: f64): f64
    if value <= low then
        return 0.0
    end
    if value >= high then
        return 1.0
    end
    local progress: f64 = (value - low) / (high - low)
    return progress * progress * (3.0 - 2.0 * progress)
end

function draw_streak(state: city_map.State, graphics: Graphics, color: string, alpha: f64): unit
    if state.streak_clock < 0.0 or state.streak_clock > state.streak_duration then
        return
    end
    local progress: f64 = state.streak_clock / state.streak_duration
    local travel: f64 = city_map.width + STREAK_LENGTH * 2.0
    if not state.streak_horizontal then
        travel = city_map.height + STREAK_LENGTH * 2.0
    end
    local head: f64 = -STREAK_LENGTH + travel * progress
    local tail: f64 = head - STREAK_LENGTH
    local limit: f64 = city_map.width
    if not state.streak_horizontal then
        limit = city_map.height
    end
    if not state.streak_forward then
        head = limit - head
        tail = limit - tail
    end
    head = clamp(head, 0.0, limit)
    tail = clamp(tail, 0.0, limit)

    graphics:set_blend_mode("add")
    graphics:set_color(ink.fade(color, alpha * 0.14))
    graphics:set_line_width(16.0)
    if state.streak_horizontal then
        graphics:line(tail, state.streak_street, head, state.streak_street)
    else
        graphics:line(state.streak_street, tail, state.streak_street, head)
    end
    graphics:set_color(ink.fade(color, alpha * 0.44))
    graphics:set_line_width(6.0)
    if state.streak_horizontal then
        graphics:line(tail, state.streak_street, head, state.streak_street)
    else
        graphics:line(state.streak_street, tail, state.streak_street, head)
    end
    graphics:set_color(ink.fade("#ffffff", alpha))
    if state.streak_horizontal then
        graphics:fill_circle(head, state.streak_street, 2.2)
    else
        graphics:fill_circle(state.streak_street, head, 2.2)
    end
    graphics:set_blend_mode("alpha")
end

-- A dashed run between two points, walked in even steps so corners of the route
-- keep the same rhythm as its straights.
function dashed_line(graphics: Graphics, from_x: f64, from_y: f64, into_x: f64, into_y: f64): unit
    local span_x: f64 = into_x - from_x
    local span_y: f64 = into_y - from_y
    local length: f64 = math.sqrt(span_x * span_x + span_y * span_y)
    if length < 1.0 then
        return
    end
    local step_x: f64 = span_x / length
    local step_y: f64 = span_y / length
    local walked: f64 = 0.0
    while walked < length do
        local ends: f64 = walked + DASH_LENGTH
        if ends > length then
            ends = length
        end
        graphics:line(
            from_x + step_x * walked,
            from_y + step_y * walked,
            from_x + step_x * ends,
            from_y + step_y * ends
        )
        walked = ends + DASH_GAP
    end
end

-- The road still to come, from wherever the duel stands to as far ahead as the
-- route has been walked out.
function draw_route_ahead(state: city_map.State, graphics: Graphics, alpha: f64): unit
    local last: i32 = state:stop_count() - 1
    local standing: Point = state:position_at(state.travel)
    local next_stop: i32 = math.floor(state.travel)::i32 + 1
    if next_stop > last then
        return
    end
    graphics:set_color(ink.fade(ROUTE_AHEAD, alpha * 0.85))
    graphics:set_line_width(2.0)
    local from_x: f64 = standing.x
    local from_y: f64 = standing.y
    for index = next_stop, last do
        dashed_line(graphics, from_x, from_y, state.stops[index + 1].x, state.stops[index + 1].y)
        from_x = state.stops[index + 1].x
        from_y = state.stops[index + 1].y
    end
end

-- The road already walked, ending exactly where the duel stands rather than at
-- the last stop it passed, so the line and the marker are never apart.
function draw_route_done(state: city_map.State, graphics: Graphics, alpha: f64): unit
    local standing: Point = state:position_at(state.travel)
    local passed: i32 = math.floor(state.travel)::i32
    -- Standing on the last stop the route has been walked out to leaves nothing
    -- past it to join up with.
    if passed > state:stop_count() - 1 then
        passed = state:stop_count() - 1
    end
    if passed < 0 then
        return
    end
    graphics:set_color(ink.fade(ROUTE_DONE, alpha * 0.30))
    graphics:set_line_width(9.0)
    for index = 0::i32, passed - 1 do
        graphics:line(
            state.stops[index + 1].x,
            state.stops[index + 1].y,
            state.stops[index + 2].x,
            state.stops[index + 2].y
        )
    end
    graphics:line(state.stops[passed + 1].x, state.stops[passed + 1].y, standing.x, standing.y)
    graphics:set_color(ink.fade(ROUTE_DONE, alpha * 0.92))
    graphics:set_line_width(2.5)
    for index = 0::i32, passed - 1 do
        graphics:line(
            state.stops[index + 1].x,
            state.stops[index + 1].y,
            state.stops[index + 2].x,
            state.stops[index + 2].y
        )
    end
    graphics:line(state.stops[passed + 1].x, state.stops[passed + 1].y, standing.x, standing.y)
end

-- A house with a duel in it: a gabled block on the corner, wearing the number
-- of the duel it holds so the map says how far into the run the duel is. The
-- number sits on its own plate, because it lands on rooftops as often as on
-- street and has to be read off either.
-- `alpha` carries the house itself and `label_alpha` the writing under it: a
-- house being gone into keeps its walls all the way in while its map label,
-- which would be a banner across the screen by then, drops away early.
-- `final` is the house the run's table ends on. The route does not stop there —
-- the city goes on and so does a run that took it — so it is drawn as a landmark
-- walked past rather than as a terminus: a second roof over the first, and a
-- label that says which duel it is the last of.
function draw_duel_stop(
    graphics: Graphics,
    stop: city_map.Stop,
    label: string,
    reached: bool,
    final: bool,
    alpha: f64,
    label_alpha: f64
): unit
    local tone: string = VAULT_DIM
    if reached then
        tone = VAULT_INK
        draw_lantern(graphics, stop, VAULT_INK, 40.0, alpha)
    end
    graphics:set_color(ink.fade("#0b0c12", alpha))
    graphics:fill_rectangle(stop.x - 15.0, stop.y - 12.0, 30.0, 26.0)
    graphics:set_color(ink.fade(tone, alpha))
    graphics:set_line_width(2.0)
    graphics:stroke_rectangle(stop.x - 15.0, stop.y - 12.0, 30.0, 26.0)
    graphics:line(stop.x - 18.0, stop.y - 12.0, stop.x, stop.y - 24.0)
    graphics:line(stop.x, stop.y - 24.0, stop.x + 18.0, stop.y - 12.0)
    if final then
        graphics:line(stop.x - 22.0, stop.y - 17.0, stop.x, stop.y - 31.0)
        graphics:line(stop.x, stop.y - 31.0, stop.x + 22.0, stop.y - 17.0)
    end
    if label_alpha <= 0.0 then
        return
    end
    -- The dial is the marker saying "duel", not part of the building: a house
    -- being walked into keeps its walls and gives that up, rather than hanging
    -- a storey-high disc in the room.
    graphics:set_color(ink.fade(tone, label_alpha))
    graphics:fill_circle(stop.x, stop.y + 1.0, 4.0)
    local writing: string = "DUEL " .. label
    local banner: f64 = 52.0
    if final then
        writing = writing .. "   LAST"
        banner = 86.0
    end
    graphics:set_color(ink.fade("#0b0c12", label_alpha * 0.9))
    plate.draw(
        graphics,
        stop.x - banner * 0.5,
        stop.y + 19.0,
        banner,
        17.0,
        ink.fade("#0b0c12", label_alpha * 0.9),
        ink.fade(tone, label_alpha * 0.35),
        1.0
    )
    ink.text_centered(graphics, writing, stop.x, stop.y + 32.0, 10, ink.fade(tone, label_alpha))
end

-- A street vendor: a stall with an awning, small enough that the houses stay
-- the landmarks of the route.
function draw_vendor_stop(graphics: Graphics, stop: city_map.Stop, reached: bool, alpha: f64): unit
    local tone: string = VENDOR_DIM
    if reached then
        tone = VENDOR_INK
        draw_lantern(graphics, stop, VENDOR_INK, 28.0, alpha)
    end
    graphics:set_color(ink.fade("#0b0c12", alpha))
    graphics:fill_rectangle(stop.x - 11.0, stop.y - 4.0, 22.0, 14.0)
    graphics:set_color(ink.fade(tone, alpha))
    graphics:set_line_width(2.0)
    graphics:stroke_rectangle(stop.x - 11.0, stop.y - 4.0, 22.0, 14.0)
    graphics:line(stop.x - 14.0, stop.y - 5.0, stop.x + 14.0, stop.y - 5.0)
    graphics:line(stop.x - 14.0, stop.y - 5.0, stop.x - 9.0, stop.y - 12.0)
    graphics:line(stop.x + 14.0, stop.y - 5.0, stop.x + 9.0, stop.y - 12.0)
    graphics:line(stop.x - 9.0, stop.y - 12.0, stop.x + 9.0, stop.y - 12.0)
end

-- The stop the camera is going into, or -1 while the map is simply being read.
-- It is the only one that keeps its full weight through a dive: the others are
-- map furniture, and the map is on its way out.
function entered_stop(state: city_map.State): i32
    if state.dive <= 0.0 then
        return -1
    end
    return math.floor(state.target + 0.5)::i32
end

-- `landmark` is the stop the run's last authored duel stands on, or -1 for a
-- map nobody is running — the menu's drifting view. A stop index rather than a
-- duel number: this module lays out a route and does not know what a run is.
function draw_stops(
    state: city_map.State,
    graphics: Graphics,
    left: f64,
    right: f64,
    top: f64,
    bottom: f64,
    alpha: f64,
    furniture: f64,
    landmark: i32
): unit
    local last: i32 = state:stop_count() - 1
    local entered: i32 = entered_stop(state)
    for index = 0::i32, last do
        local stop: city_map.Stop = state.stops[index + 1]
        if stop.x >= left and stop.x <= right and stop.y >= top and stop.y <= bottom then
            local reached: bool = (index::f64) <= state.travel + 0.001
            local final: bool = index == landmark
            if index == entered then
                draw_duel_stop(
                    graphics,
                    stop,
                    tostring(city_map.stop_duel(index)),
                    reached,
                    final,
                    alpha,
                    furniture
                )
            elseif furniture > 0.0 then
                if stop.duel then
                    draw_duel_stop(
                        graphics,
                        stop,
                        tostring(city_map.stop_duel(index)),
                        reached,
                        final,
                        furniture,
                        furniture
                    )
                else
                    draw_vendor_stop(graphics, stop, reached, furniture)
                end
            end
        end
    end
end

-- Where the player is: a breathing mote on the route, between two stops while
-- they are walking and on one while they are working.
function draw_party(state: city_map.State, graphics: Graphics, alpha: f64): unit
    local standing: Point = state:position_at(state.travel)
    local pulse: f64 = 6.5 + math.sin(state.pan_clock * 3.1) * 1.6
    graphics:set_blend_mode("add")
    graphics:set_color(ink.fade("#fde68a", alpha * 0.24))
    graphics:fill_circle(standing.x, standing.y, pulse + 7.0)
    graphics:set_blend_mode("alpha")
    graphics:set_color(ink.fade("#fde68a", alpha))
    graphics:fill_circle(standing.x, standing.y, 4.6)
    graphics:set_color(ink.fade("#3b2a06", alpha))
    graphics:fill_circle(standing.x, standing.y, 2.0)
end

-- The camera transform: the map is read from a point in the city rather than
-- from a corner of it, so the same aim works at any zoom. The anchor is where
-- on the screen that point lands, which a screen with a list down one side
-- moves out from under it.
function apply_camera(state: city_map.State, graphics: Graphics): unit
    graphics:push()
    graphics:translate(state.anchor_x, state.anchor_y)
    graphics:scale(state.zoom, state.zoom)
    graphics:translate(-state.camera_x, -state.camera_y)
end

function draw(
    state: city_map.State,
    graphics: Graphics,
    streak_color: string,
    alpha: f64,
    landmark: i32
): unit
    if alpha <= 0.0 then
        return
    end
    -- A map that owns the frame clears it; one handing the screen to a duel
    -- must leave the duel underneath it to come through.
    if alpha >= 1.0 then
        graphics:clear(NIGHT)
    end
    graphics:set_color(ink.fade(ASPHALT, alpha))
    graphics:fill_rectangle(0.0, 0.0, state.view_width, state.view_height)

    -- Going into a house sheds the map in two passes, so the last thing left
    -- growing is the house itself: the route furniture goes first, because at
    -- this zoom a dashed road is a bar across the screen, and the surrounding
    -- city follows it.
    local furniture: f64 = alpha * (1.0 - ramp(state.dive, 0.0, 0.30))
    local city_ink: f64 = alpha * (1.0 - ramp(state.dive, 0.16, 0.62))

    local left: f64 = state.camera_x - (state.anchor_x / state.zoom + 60.0)
    local right: f64 = state.camera_x + ((state.view_width - state.anchor_x) / state.zoom + 60.0)
    local top: f64 = state.camera_y - (state.anchor_y / state.zoom + 60.0)
    local bottom: f64 = state.camera_y + ((state.view_height - state.anchor_y) / state.zoom + 60.0)

    if city_ink > 0.0 then
        apply_camera(state, graphics)
        draw_canal(state, graphics, city_ink)
        for building in state.buildings do
            if building.x + building.width >= left and building.x <= right and building.y + building.height >= top and building.y <= bottom then
                draw_rooftop(graphics, building, city_ink)
            end
        end
        draw_street_marks(
            graphics,
            state.vertical_streets,
            true,
            city_map.height::i32,
            left,
            right,
            top,
            bottom,
            city_ink
        )
        draw_street_marks(
            graphics,
            state.horizontal_streets,
            false,
            city_map.width::i32,
            top,
            bottom,
            left,
            right,
            city_ink
        )
        draw_streak(state, graphics, streak_color, city_ink)
        graphics:pop()
    end

    -- The rooftops go under a scrim so a list of options reads over them; the
    -- route goes on top of it, because the route is the thing being said.
    graphics:set_color(ink.fade(SCRIM, SCRIM_STRENGTH * city_ink))
    graphics:fill_rectangle(0.0, 0.0, state.view_width, state.view_height)

    apply_camera(state, graphics)
    if furniture > 0.0 then
        draw_route_ahead(state, graphics, furniture)
        draw_route_done(state, graphics, furniture)
    end
    draw_stops(state, graphics, left, right, top, bottom, alpha, furniture, landmark)
    if furniture > 0.0 then
        draw_party(state, graphics, furniture)
    end
    graphics:pop()
end

return { draw = draw }
