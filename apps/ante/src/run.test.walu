-- Deterministic, DOM-free checks for the roguelike run around Ante Magic:
-- the boss cadence, gold carrying between duels, the spell loadout carried
-- with it, and where a run ends.
require("waluau:vitest")

local game = require("./game")
local game_fixture = require("../test/game_fixture")
local run = require("./run")
local flow = require("./flow")
local spells = require("./spells/spell")

-- One cleared duel of a run, settled the way the duel screen settles it: the
-- rules say what gold survived, and the run says what is dealt next.
local function settle_vault(state: run.State, gold: i32): game.State
    local rules: game.State = game.State.new(state:boss(), state.spells, state.gold)
    game_fixture.set_player_points(rules, gold)
    game_fixture.clear(rules)
    state:settle(rules:is_victory(), rules:gold())
    return rules
end

-- Take the live duel leaving `gold` behind.
local function clear_vault(state: run.State, gold: i32): unit
    settle_vault(state, gold)
end

describe(
    "Ante Magic run cadence",
    function()
        it(
            "makes every third duel a boss battle",
            function()
                expect(run.boss_at(1, false)):toBe(false)
                expect(run.boss_at(2, false)):toBe(false)
                expect(run.boss_at(3, false)):toBe(true)
                expect(run.boss_at(4, false)):toBe(false)
                expect(run.boss_at(6, false)):toBe(true)
                expect(run.boss_at(9, false)):toBe(true)
            end
        )

        it(
            "makes every duel of a boss rush a boss battle",
            function()
                expect(run.boss_at(1, true)):toBe(true)
                expect(run.boss_at(2, true)):toBe(true)
                expect(run.boss_at(3, true)):toBe(true)
            end
        )

        it(
            "opens a run on the first duel with the starting gold",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Clone, false)
                expect(state.duel):toBe(1)
                expect(state.cleared):toBe(0)
                expect(state.gold):toBe(game.starting_gold)
                expect(state.hearts):toBe(run.max_hearts)
                -- The menu's pick is the whole opening loadout, at full price and on
                -- the first cast key.
                expect(state:spell_count()):toBe(1)
                expect(state.spells[1].kind):toBe(spells.SpellKind.Clone)
                expect(state.spells[1].cost):toBe(game.spell_cost)
                expect(state.start_spell):toBe(spells.SpellKind.Clone)
                expect(state:boss()):toBe(false)
                expect(state:next_is_boss()):toBe(false)
            end
        )

        it(
            "carries a cleared duel's gold into the next one",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                state:settle(true, 31)
                expect(state.duel):toBe(2)
                expect(state.cleared):toBe(1)
                expect(state.gold):toBe(31)
                expect(state:boss()):toBe(false)
                -- The duel after this one is where the cadence lands, so the board can
                -- warn about it while this one is still being fought.
                expect(state:next_is_boss()):toBe(true)
                state:settle(true, 18)
                expect(state.duel):toBe(3)
                expect(state.gold):toBe(18)
                expect(state:boss()):toBe(true)
                -- An empty purse still advances after a win; gold is a resource
                -- to spend, not a second condition for surviving the run.
                state:settle(true, 0)
                expect(state.duel):toBe(4)
                expect(state.gold):toBe(0)
            end
        )

        it(
            "carries lost hearts across cleared duels and refills only on restart",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                expect(state:lose_hand()):toBe(false)
                expect(state.hearts):toBe(run.max_hearts - 1)

                state:settle(true, 31)
                expect(state.duel):toBe(2)
                expect(state.hearts):toBe(run.max_hearts - 1)

                state:restart(spells.SpellKind.Firebolt, false)
                expect(state.hearts):toBe(run.max_hearts)
            end
        )

        it(
            "heals damage taken but never past the pool the run opened with",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                -- Nothing to undo yet, so there is no sale to make.
                expect(state:can_heal()):toBe(false)
                expect(state:heal(1)):toBe(false)
                expect(state.hearts):toBe(run.max_hearts)

                state:lose_hand()
                expect(state:can_heal()):toBe(true)
                expect(state:heal(1)):toBe(true)
                expect(state.hearts):toBe(run.max_hearts)

                -- Healing more than was lost tops out at full rather than banking
                -- the overflow against damage the run has not taken yet.
                state:lose_hand()
                expect(state:heal(run.max_hearts)):toBe(true)
                expect(state.hearts):toBe(run.max_hearts)

                state:lose_hand()
                expect(state:heal(0)):toBe(false)
                expect(state:heal(-1)):toBe(false)
                expect(state.hearts):toBe(run.max_hearts - 1)
            end
        )

        it(
            "cannot heal a run the last heart already ended",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                for _ = 1, run.max_hearts do
                    state:lose_hand()
                end
                expect(state.hearts):toBe(0)
                expect(state:can_heal()):toBe(false)
                expect(state:heal(1)):toBe(false)
                expect(state.hearts):toBe(0)
            end
        )

        it(
            "ends the run on the last heart, gold and all",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                state:settle(true, 31)
                for _ = 1, run.max_hearts do
                    state:lose_hand()
                end
                -- The last heart takes the carried gold with it: what follows is the
                -- first duel of a fresh run.
                state:settle(false, 31)
                expect(state.duel):toBe(1)
                expect(state.cleared):toBe(0)
                expect(state.gold):toBe(game.starting_gold)
                expect(state.start_spell):toBe(spells.SpellKind.Firebolt)
            end
        )

        it(
            "restarts a run at the first duel with a fresh pool",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                state:settle(true, 31)
                state:settle(true, 18)
                state:lose_hand()
                state:restart(spells.SpellKind.FreezeRay, true)
                expect(state.duel):toBe(1)
                expect(state.cleared):toBe(0)
                expect(state.gold):toBe(game.starting_gold)
                expect(state.hearts):toBe(run.max_hearts)
                expect(state.start_spell):toBe(spells.SpellKind.FreezeRay)
                expect(state:boss()):toBe(true)
            end
        )

        it(
            "round-trips run state through development snapshots",
            function()
                local state: run.State = run.State.new(spells.SpellKind.RaiseCard, true)
                state:lose_hand()
                state:settle(true, 27)
                local encoded: string = state:snapshot()
                local restored: run.State? = run.State.restore(encoded)
                expect(restored == nil):toBe(false)
                if restored ~= nil then
                    expect(restored.duel):toBe(2)
                    expect(restored.cleared):toBe(1)
                    expect(restored.gold):toBe(27)
                    expect(restored.hearts):toBe(run.max_hearts - 1)
                    expect(restored.spells[1].kind):toBe(spells.SpellKind.RaiseCard)
                    expect(restored.spells[1].level):toBe(1)
                    expect(restored.start_spell):toBe(spells.SpellKind.RaiseCard)
                    expect(restored.rush):toBe(true)
                    expect(restored:snapshot()):toBe(encoded)
                end

                -- A payload from another build — the old token wire format, a JSON
                -- payload carrying a stale schema marker, or one with trailing
                -- garbage — is a normal refusal rather than a crash.
                expect(run.State.restore("duel-run-v3,1,10,0,1,0") == nil):toBe(true)
                local stale_schema: string = string.gsub(encoded, "duel%-run%-v5", "duel-run-v4")
                expect(run.State.restore(stale_schema) == nil):toBe(true)
                expect(run.State.restore(encoded .. ",unexpected") == nil):toBe(true)
                -- A spell kind is bounded by the spells that exist, and health by what
                -- a run opens with; the JSON shape checks neither.
                local unknown_spell: string = string.gsub(
                    encoded,
                    '"start_spell":%d+',
                    '"start_spell":99'
                )
                expect(run.State.restore(unknown_spell) == nil):toBe(true)
                state.spells[1].level = 0
                expect(run.State.restore(state:snapshot()) == nil):toBe(true)
                state.spells[1].level = 1
                state.hearts = run.max_hearts + 1
                expect(run.State.restore(state:snapshot()) == nil):toBe(true)
            end
        )

        it(
            "round-trips a bought loadout and refuses an impossible one",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                state:settle(true, 30)
                expect(state:learn_spell(spells.Spell.new(spells.SpellKind.Clone, 3))):toBe(true)
                local encoded: string = state:snapshot()
                local restored: run.State? = run.State.restore(encoded)
                expect(restored == nil):toBe(false)
                if restored ~= nil then
                    expect(restored:spell_count()):toBe(2)
                    expect(restored.spells[1].kind):toBe(spells.SpellKind.Firebolt)
                    expect(restored.spells[1].cost):toBe(game.spell_cost)
                    expect(restored.spells[1].level):toBe(1)
                    expect(restored.spells[2].kind):toBe(spells.SpellKind.Clone)
                    expect(restored.spells[2].level):toBe(3)
                    expect(restored:snapshot()):toBe(encoded)
                end

                -- A loadout of three spells, or of none, is not a run this build could
                -- have produced, so restoring it is a normal refusal.
                local empty: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                empty.spells = {}
                expect(run.State.restore(empty:snapshot()) == nil):toBe(true)
                local crowded: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                table.insert(
                    crowded.spells,
                    { kind = spells.SpellKind.Clone, cost = game.spell_cost, level = 1 }
                )
                table.insert(
                    crowded.spells,
                    { kind = spells.SpellKind.FreezeRay, cost = game.spell_cost, level = 1 }
                )
                expect(run.State.restore(crowded:snapshot()) == nil):toBe(true)
            end
        )
    end
)

describe(
    "Ante Magic run loadout",
    function()
        it(
            "adds a new spell while there is room and refuses to forget one when full",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                expect(state:learn_spell(spells.Spell.new(spells.SpellKind.Clone, 1))):toBe(true)
                expect(state:spell_count()):toBe(2)
                expect(state.spells[2].kind):toBe(spells.SpellKind.Clone)
                expect(state.spells[2].cost):toBe(game.spell_cost)
                expect(state.spells[2].level):toBe(1)
                -- Two is as many as travel at once. A third kind cannot silently
                -- replace either spell already bound to a cast key.
                expect(
                    state:learn_spell(spells.Spell.new(spells.SpellKind.RaiseCard, 1))
                ):toBe(false)
                expect(state:spell_count()):toBe(2)
                expect(state:carries(spells.SpellKind.Firebolt)):toBe(true)
                expect(state:carries(spells.SpellKind.Clone)):toBe(true)
                expect(state:carries(spells.SpellKind.RaiseCard)):toBe(false)
            end
        )

        it(
            "refuses a spell the loadout already carries",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                expect(
                    state:learn_spell(spells.Spell.new(spells.SpellKind.Firebolt, 1))
                ):toBe(false)
                expect(state:spell_count()):toBe(1)
            end
        )

        it(
            "spends only what the carried pool covers",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Clone, false)
                expect(state:spend(4)):toBe(true)
                expect(state.gold):toBe(game.starting_gold - 4)
                expect(state:spend(game.starting_gold)):toBe(false)
                expect(state.gold):toBe(game.starting_gold - 4)
            end
        )

        it(
            "carries a bought loadout between duels and drops it with the last heart",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                state:settle(true, 26)
                expect(state:learn_spell(spells.Spell.new(spells.SpellKind.Clone, 1))):toBe(true)
                expect(state:learn_spell(spells.Spell.new(spells.SpellKind.Clone, 2))):toBe(true)
                state:settle(true, 19)
                -- The next duel is dealt the levelled pair: the loadout belongs to the
                -- run, not to the duel that bought it.
                expect(state:spell_count()):toBe(2)
                expect(state.spells[2].level):toBe(2)
                local dealt: game.State = game.State.new(state:boss(), state.spells, state.gold)
                expect(dealt:spell_count()):toBe(2)
                expect(dealt:spell_level(1)):toBe(2)

                -- Losing every heart drops everything the run bought: a fresh run
                -- sets out with its starting spell at full price.
                for _ = 1, run.max_hearts do
                    state:lose_hand()
                end
                state:settle(false, 19)
                expect(state:spell_count()):toBe(1)
                expect(state.spells[1].kind):toBe(spells.SpellKind.Firebolt)
                expect(state.spells[1].cost):toBe(game.spell_cost)
            end
        )

        it(
            "keeps the loadout out of reach of the duel it is dealt to",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                local dealt: game.State = game.State.new(state:boss(), state.spells, state.gold)
                -- The duel holds a reading of the loadout. Nothing a duel does to its
                -- own copy — and nothing done to the run's afterwards — crosses over.
                expect(state:learn_spell(spells.Spell.new(spells.SpellKind.Firebolt, 2))):toBe(true)
                expect(dealt:spell_level(0)):toBe(1)
                expect(state.spells[1].level):toBe(2)
            end
        )
    end
)

describe(
    "Ante Magic run outcomes",
    function()
        it(
            "names the things a fought duel or exhausted heart pool can become",
            function()
                expect(tostring(run.outcome_of(1, false, run.max_hearts, false))):toBe("none")
                expect(tostring(run.outcome_of(1, false, run.max_hearts, true))):toBe("advance")
                -- The last heart can disappear before the duel has otherwise ended.
                expect(tostring(run.outcome_of(1, false, 0, false))):toBe("lost-health")
            end
        )

        it(
            "loses and restarts the run when the last heart is gone",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Clone, false)
                for _ = 1, run.max_hearts do
                    state:lose_hand()
                end
                expect(state.hearts):toBe(0)
                -- Repeated terminal signals clamp rather than manufacturing negative
                -- health while the final reveal waits to be dismissed.
                expect(state:lose_hand()):toBe(true)
                expect(state.hearts):toBe(0)
                expect(tostring(state:settle(false, 99))):toBe("lost-health")
                expect(state.duel):toBe(1)
                expect(state.hearts):toBe(run.max_hearts)
                expect(state.start_spell):toBe(spells.SpellKind.Clone)
            end
        )

        it(
            "passes through the finish line once and walks on",
            function()
                local finish: i32 = run.run_length(false)
                expect(tostring(run.outcome_of(finish, false, run.max_hearts, true))):toBe("won")
                expect(
                    tostring(run.outcome_of(finish - 1, false, run.max_hearts, true))
                ):toBe("advance")
                -- Not a state the run stays in: the duel after the finish is an
                -- ordinary one again, however far past the milestone it is.
                expect(
                    tostring(run.outcome_of(finish + 1, false, run.max_hearts, true))
                ):toBe("advance")
                expect(
                    tostring(run.outcome_of(finish + 7, false, run.max_hearts, true))
                ):toBe("advance")
            end
        )

        it(
            "takes the victory milestone and keeps the run going",
            function()
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                local finish: i32 = run.run_length(false)
                state.duel = finish
                state.cleared = finish - 1
                expect(tostring(state:settle(true, 200))):toBe("won")
                -- Won, and still standing in the city: the next duel is dealt, the
                -- purse survived, and the loadout was never reset.
                expect(state.duel):toBe(finish + 1)
                expect(state.cleared):toBe(finish)
                expect(state.gold):toBe(200)
                expect(state:endless()):toBe(true)
                expect(tostring(state:settle(true, 200))):toBe("advance")
                expect(state.duel):toBe(finish + 2)
            end
        )

        it(
            "carries a run past the finish line through a snapshot",
            function()
                local state: run.State = run.State.new(spells.SpellKind.RaiseCard, false)
                state.duel = run.run_length(false) + 3
                state.cleared = run.run_length(false) + 2
                state.gold = 61
                local restored: run.State? = run.State.restore(state:snapshot())
                expect(restored == nil):toBe(false)
                if restored ~= nil then
                    expect(restored.duel):toBe(run.run_length(false) + 3)
                    expect(restored.gold):toBe(61)
                    expect(restored:endless()):toBe(true)
                end
            end
        )
    end
)

describe(
    "Ante Magic duel verdicts",
    function()
        it(
            "reports a duel as cleared only after a player win",
            function()
                math.randomseed(71)
                local state: game.State = game.State.new(
                    false,
                    {spells.Spell.new(spells.SpellKind.Firebolt, 1)},
                    game.starting_gold
                )
                expect(state:is_victory()):toBe(false)
                game_fixture.clear(state)
                expect(state:is_victory()):toBe(true)
                expect(state:view():cleared()):toBe(true)
            end
        )

        it(
            "leaves a duel live before the player wins",
            function()
                math.randomseed(73)
                local state: game.State = game.State.new(
                    false,
                    {spells.Spell.new(spells.SpellKind.Firebolt, 1)},
                    game.starting_gold
                )
                expect(state:is_victory()):toBe(false)
                expect(state:view():cleared()):toBe(false)
            end
        )

        it(
            "asks the run for what follows a verdict",
            function()
                local keyboard: flow.State = flow.State.new()
                local mouse: flow.State = flow.State.new()
                keyboard.modal = "final"
                mouse.modal = "final"
                expect(tostring(keyboard:gate(true, false, true, "advance"))):toBe("advance")
                expect(tostring(mouse:gate(true, false, true, "primary"))):toBe("advance")
                -- The verdict stays up until the screen deals whatever comes next.
                expect(tostring(keyboard.modal)):toBe("final")
                -- Restart is still its own answer: the whole run over again, rather
                -- than whatever duel the run would have moved to.
                expect(tostring(keyboard:gate(true, false, true, "restart"))):toBe("reset")
                -- The ledger opens over the verdict, and closing it puts the verdict
                -- back: a settled board is not somewhere a run can be left standing.
                expect(tostring(mouse:gate(true, false, true, "history"))):toBe("consumed")
                expect(tostring(mouse.modal)):toBe("history")
                expect(tostring(mouse:gate(true, false, true, "history"))):toBe("consumed")
                expect(tostring(mouse.modal)):toBe("final")
                expect(tostring(mouse:gate(true, false, true, "help"))):toBe("consumed")
                expect(tostring(mouse:gate(true, false, true, "advance"))):toBe("consumed")
                expect(tostring(mouse.modal)):toBe("final")
            end
        )
    end
)

-- The duel screen deals each duel from the run the same way these do: the
-- variant, spell, and opening gold are all the run's to say. What the screen
-- adds on top is choreography, which needs a canvas and is covered by the
-- app's browser suite instead.
describe(
    "Ante Magic run progression",
    function()
        it(
            "deals the next duel with the gold the last one left",
            function()
                math.randomseed(79)
                local state: run.State = run.State.new(spells.SpellKind.Firebolt, false)
                local first: game.State = settle_vault(state, 42)
                expect(first:gold()):toBe(42)
                expect(state.duel):toBe(2)
                expect(state.cleared):toBe(1)

                local second: game.State = game.State.new(state:boss(), state.spells, state.gold)
                expect(second:gold()):toBe(42)
                expect(second:is_boss()):toBe(false)
                expect(second:is_finished()):toBe(false)
                expect(second:spell_kind(0)):toBe(spells.SpellKind.Firebolt)

                clear_vault(state, 30)
                expect(state.duel):toBe(3)
                expect(state.cleared):toBe(2)
                -- The third duel is the boss battle and opens with seven cards.
                local third: game.State = game.State.new(state:boss(), state.spells, state.gold)
                expect(third:gold()):toBe(30)
                expect(third:is_boss()):toBe(true)
                expect(third:hand_size()):toBe(7)
            end
        )

        it(
            "keeps every duel of a boss rush a boss battle",
            function()
                math.randomseed(89)
                local state: run.State = run.State.new(spells.SpellKind.FreezeRay, true)
                local opening: game.State = settle_vault(state, 25)
                expect(opening:is_boss()):toBe(true)
                expect(opening:hand_size()):toBe(7)

                expect(state.duel):toBe(2)
                expect(state:boss()):toBe(true)
                expect(state:next_is_boss()):toBe(true)
                local second: game.State = game.State.new(state:boss(), state.spells, state.gold)
                expect(second:gold()):toBe(25)
                expect(second:hand_size()):toBe(7)
            end
        )
    end
)
