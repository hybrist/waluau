-- Deterministic, DOM-free checks for the roguelike run around Ante Magic:
-- the boss cadence, gold carrying between duels, the spell loadout carried
-- with it, and where a run ends.

require("waluau:vitest")

local game = require("./game")
local game_fixture = require("../test/game_fixture")
local run = require("./run")
local flow = require("./flow")
local spells = require("./spells/spell")

-- One duel of a run, fought to a verdict and settled the way the duel screen
-- settles it: the rules say whether the duel opened and what gold survived,
-- and the run says what is dealt next. `arch_mage_wins` is how many table cards the
-- Opponent held, so three of them is a lost duel.
local function settle_vault(
    state: run.State, arch_mage_wins: i32, gold: i32
): game.State
    local rules: game.State = game.new(state:boss(), state.spells, state.gold)
    game_fixture.set_player_points(rules, gold)
    game_fixture.finish(rules, arch_mage_wins)
    state:settle(rules:is_victory(), rules:gold())
    return rules
end

-- Take the live duel leaving `gold` behind, the way three survived rounds do.
local function clear_vault(state: run.State, gold: i32): unit
    settle_vault(state, 0, gold)
end

describe("Ante Magic run cadence", function()
    it("makes every third duel a boss battle", function()
        expect(run.boss_at(1, false)):toBe(false)
        expect(run.boss_at(2, false)):toBe(false)
        expect(run.boss_at(3, false)):toBe(true)
        expect(run.boss_at(4, false)):toBe(false)
        expect(run.boss_at(6, false)):toBe(true)
        expect(run.boss_at(9, false)):toBe(true)
    end)

    it("makes every duel of a boss rush a boss battle", function()
        expect(run.boss_at(1, true)):toBe(true)
        expect(run.boss_at(2, true)):toBe(true)
        expect(run.boss_at(3, true)):toBe(true)
    end)

    it("opens a run on the first duel with the starting gold", function()
        local state: run.State = run.new(spells.SpellKind.Clone, false)
        expect(state.duel):toBe(1)
        expect(state.cleared):toBe(0)
        expect(state.gold):toBe(game.starting_gold)
        expect(state.hearts):toBe(run.max_hearts)
        -- The menu's pick is the whole opening loadout, at full price and on
        -- the first cast key.
        expect(state:spell_count()):toBe(1)
        expect(state.spells[0].kind):toBe(spells.SpellKind.Clone)
        expect(state.spells[0].cost):toBe(game.spell_cost)
        expect(state.start_spell):toBe(spells.SpellKind.Clone)
        expect(state:boss()):toBe(false)
        expect(state:next_is_boss()):toBe(false)
    end)

    it("carries a cleared duel's gold into the next one", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        state:settle(true, 31)
        expect(state.duel):toBe(2)
        expect(state.cleared):toBe(1)
        -- The duel charged its target on the way out; the rest carries.
        expect(state.gold):toBe(31 - run.target_at(1, false))
        expect(state:boss()):toBe(false)
        -- The duel after this one is where the cadence lands, so the board can
        -- warn about it while this one is still being fought.
        expect(state:next_is_boss()):toBe(true)
        state:settle(true, 18)
        expect(state.duel):toBe(3)
        expect(state.gold):toBe(18 - run.target_at(2, false))
        expect(state:boss()):toBe(true)
    end)

    it("carries lost hearts across cleared duels and refills only on restart", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        expect(state:lose_hand()):toBe(false)
        expect(state.hearts):toBe(run.max_hearts - 1)

        state:settle(true, 31)
        expect(state.duel):toBe(2)
        expect(state.hearts):toBe(run.max_hearts - 1)

        state:restart(spells.SpellKind.Firebolt, false)
        expect(state.hearts):toBe(run.max_hearts)
    end)

    it("ends the run on a lost duel, gold and all", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        state:settle(true, 31)
        -- A lost duel takes the carried gold with it: what follows is the
        -- first duel of a fresh run, not a retry of the one that ended it.
        state:settle(false, 31)
        expect(state.duel):toBe(1)
        expect(state.cleared):toBe(0)
        expect(state.gold):toBe(game.starting_gold)
        expect(state.start_spell):toBe(spells.SpellKind.Firebolt)
    end)

    it("restarts a run at the first duel with a fresh pool", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        state:settle(true, 31)
        state:settle(true, 18)
        state:lose_hand()
        state:restart(spells.SpellKind.FreezeRay, true)
        expect(state.duel):toBe(1)
        expect(state.cleared):toBe(0)
        expect(state.gold):toBe(game.starting_gold)
        expect(state.hearts):toBe(run.max_hearts)
        expect(state.start_spell):toBe(spells.SpellKind.FreezeRay)
        expect(state:boss()):toBe(true)
    end)

    it("round-trips run state through development snapshots", function()
        local state: run.State = run.new(spells.SpellKind.RaiseCard, true)
        state:lose_hand()
        state:settle(true, 27)
        local encoded: string = run.snapshot(state)
        local restored: run.State? = run.restore(encoded)
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            expect(restored.duel):toBe(2)
            expect(restored.cleared):toBe(1)
            expect(restored.gold):toBe(27 - run.target_at(1, true))
            expect(restored.hearts):toBe(run.max_hearts - 1)
            expect(restored.spells[0].kind):toBe(spells.SpellKind.RaiseCard)
            expect(restored.start_spell):toBe(spells.SpellKind.RaiseCard)
            expect(restored.rush):toBe(true)
            expect(run.snapshot(restored)):toBe(encoded)
        end

        -- A payload from another build — the old token wire format, a JSON
        -- payload carrying a stale schema marker, or one with trailing
        -- garbage — is a normal refusal rather than a crash.
        expect(run.restore("duel-run-v3,1,10,0,1,0") == nil):toBe(true)
        local stale_schema: string =
            string.gsub(encoded, "duel%-run%-v4", "duel-run-v3")
        expect(run.restore(stale_schema) == nil):toBe(true)
        expect(run.restore(encoded .. ",unexpected") == nil):toBe(true)
        -- A spell kind is bounded by the spells that exist, and health by what
        -- a run opens with; the JSON shape checks neither.
        local unknown_spell: string =
            string.gsub(encoded, '"start_spell":%d+', '"start_spell":99')
        expect(run.restore(unknown_spell) == nil):toBe(true)
        state.hearts = run.max_hearts + 1
        expect(run.restore(run.snapshot(state)) == nil):toBe(true)
    end)

    it("round-trips a bought loadout and refuses an impossible one", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        state:settle(true, 30)
        expect(state:upgrade(0)):toBe(true)
        expect(state:learn(spells.SpellKind.Clone, state:open_slot())):toBe(true)
        local encoded: string = run.snapshot(state)
        local restored: run.State? = run.restore(encoded)
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            expect(restored:spell_count()):toBe(2)
            expect(restored.spells[0].kind):toBe(spells.SpellKind.Firebolt)
            expect(restored.spells[0].cost):toBe(game.spell_cost - 1)
            expect(restored.spells[1].kind):toBe(spells.SpellKind.Clone)
            expect(run.snapshot(restored)):toBe(encoded)
        end

        -- A loadout of three spells, or of none, is not a run this build could
        -- have produced, so restoring it is a normal refusal.
        local empty: run.State = run.new(spells.SpellKind.Firebolt, false)
        empty.spells = {}
        expect(run.restore(run.snapshot(empty)) == nil):toBe(true)
        local crowded: run.State = run.new(spells.SpellKind.Firebolt, false)
        table.insert(crowded.spells, { kind = spells.SpellKind.Clone, cost = game.spell_cost })
        table.insert(crowded.spells, { kind = spells.SpellKind.FreezeRay, cost = game.spell_cost })
        expect(run.restore(run.snapshot(crowded)) == nil):toBe(true)
    end)
end)

describe("Ante Magic run loadout", function()
    it("gives a learned spell the next cast key while there is room", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        expect(state:open_slot()):toBe(1)
        expect(state:learn(spells.SpellKind.Clone, 1)):toBe(true)
        expect(state:spell_count()):toBe(2)
        expect(state.spells[1].kind):toBe(spells.SpellKind.Clone)
        expect(state.spells[1].cost):toBe(game.spell_cost)
        -- Two is as many as travel at once, so nothing is open any more and a
        -- third spell has to name the slot it takes over.
        expect(state:open_slot()):toBe(-1)
        expect(state:learn(spells.SpellKind.RaiseCard, 2)):toBe(false)
        expect(state:learn(spells.SpellKind.RaiseCard, 0)):toBe(true)
        expect(state:spell_count()):toBe(2)
        expect(state.spells[0].kind):toBe(spells.SpellKind.RaiseCard)
        expect(state:carries(spells.SpellKind.Firebolt)):toBe(false)
        expect(state:carries(spells.SpellKind.Clone)):toBe(true)
    end)

    it("refuses a spell the loadout already carries", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        expect(state:learn(spells.SpellKind.Firebolt, 1)):toBe(false)
        expect(state:spell_count()):toBe(1)
    end)

    it("sharpens a spell down to a floor and no further", function()
        local state: run.State = run.new(spells.SpellKind.FreezeRay, false)
        local steps: i32 = game.spell_cost - run.min_spell_cost
        for _ = 1, steps do
            expect(state:can_sharpen(0)):toBe(true)
            expect(state:upgrade(0)):toBe(true)
        end
        expect(state.spells[0].cost):toBe(run.min_spell_cost)
        expect(state:can_sharpen(0)):toBe(false)
        expect(state:upgrade(0)):toBe(false)
        expect(state:upgrade(1)):toBe(false)
    end)

    it("spends only what the carried pool covers", function()
        local state: run.State = run.new(spells.SpellKind.Clone, false)
        expect(state:spend(4)):toBe(true)
        expect(state.gold):toBe(game.starting_gold - 4)
        expect(state:spend(game.starting_gold)):toBe(false)
        expect(state.gold):toBe(game.starting_gold - 4)
    end)

    it("carries a bought loadout between duels and drops it with the run", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        state:settle(true, 26)
        expect(state:learn(spells.SpellKind.Clone, state:open_slot())):toBe(true)
        expect(state:upgrade(1)):toBe(true)
        state:settle(true, 19)
        -- The next duel is dealt the upgraded pair: the loadout belongs to the
        -- run, not to the duel that bought it.
        expect(state:spell_count()):toBe(2)
        expect(state.spells[1].cost):toBe(game.spell_cost - 1)
        local dealt: game.State = game.new(state:boss(), state.spells, state.gold)
        expect(dealt:spell_count()):toBe(2)
        expect(dealt:spell_cost(1)):toBe(game.spell_cost - 1)

        -- The Opponent taking the duel ends the run, and everything the run
        -- bought goes with it: a fresh run sets out with its starting spell at
        -- full price.
        state:settle(false, 19)
        expect(state:spell_count()):toBe(1)
        expect(state.spells[0].kind):toBe(spells.SpellKind.Firebolt)
        expect(state.spells[0].cost):toBe(game.spell_cost)
    end)

    it("keeps the loadout out of reach of the duel it is dealt to", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        local dealt: game.State = game.new(state:boss(), state.spells, state.gold)
        -- The duel holds a reading of the loadout. Nothing a duel does to its
        -- own copy — and nothing done to the run's afterwards — crosses over.
        expect(state:upgrade(0)):toBe(true)
        expect(dealt:spell_cost(0)):toBe(game.spell_cost)
        expect(state.spells[0].cost):toBe(game.spell_cost - 1)
    end)
end)

describe("Ante Magic target", function()
    it("climbs across the run and takes its largest steps on boss duels", function()
        local previous: i32 = 0
        for duel = 1::i32, run.run_length(false) do
            local target: i32 = run.target_at(duel, false)
            expect(target):toBeGreaterThan(previous)
            previous = target
        end
        -- Every boss duel asks for more of a step up than the standard duel
        -- before it, so the end of an act is a gold wall as well as an
        -- seven-card one.
        for duel = 3::i32, run.run_length(false) do
            if run.boss_at(duel, false) then
                local boss_step: i32 = run.target_at(duel, false)
                    - run.target_at(duel - 1, false)
                local before: i32 = run.target_at(duel - 1, false)
                    - run.target_at(duel - 2, false)
                expect(boss_step):toBeGreaterThan(before)
            end
        end
        -- The table crosses what a duel pays rather than staying under it.
        -- Early duels ask for below the rarity-weighted pay measured in
        -- economy.test.walu, so a run that is going well banks a surplus;
        -- late duels spend the run out of that pile.
        expect(run.target_at(1, false)):toBeLessThan(25)
        expect(run.target_at(2, false)):toBeLessThan(25)
        expect(run.target_at(3, false)):toBeLessThan(25)
        expect(run.target_at(run.run_length(false), false)):toBeGreaterThan(36)
        expect(run.target_at(run.run_length(false) - 1, false)):toBeGreaterThan(25)
    end)

    it("keeps climbing past the table, faster than a duel can pay", function()
        local finish: i32 = run.run_length(false)
        local previous_step: i32 = 0
        for past = 1::i32, 4 do
            local step: i32 = run.target_at(finish + past, false)
                - run.target_at(finish + past - 1, false)
            expect(step):toBeGreaterThan(previous_step)
            previous_step = step
            -- The tail always ends. Every duel past the finish asks for more
            -- than a typical boss pays (measured in economy.test.walu), and
            -- the shortfall widens with the step, so a run walks on out of
            -- whatever surplus it arrived with and no further.
            expect(run.target_at(finish + past, false)):toBeGreaterThan(36)
        end
        -- Concretely: a run that finished the table holding fifty walks about
        -- two more duels, not twenty.
        local purse: i32 = 50
        local walked: i32 = 0
        for past = 1::i32, 20 do
            local target: i32 = run.target_at(finish + past, false)
            if purse + 36 < target then break end
            purse = purse + 36 - target
            walked = past
        end
        expect(walked):toBeGreaterThan(0)
        expect(walked):toBeLessThan(5)
    end)

    it("asks a boss rush for a steeper target over a shorter run", function()
        expect(run.run_length(true)):toBeLessThan(run.run_length(false))
        expect(run.target_at(1, true)):toBeGreaterThan(run.target_at(1, false))
        expect(run.target_at(3, true)):toBeGreaterThan(run.target_at(3, false))
    end)
end)

describe("Ante Magic run outcomes", function()
    it("names the things a fought duel or exhausted heart pool can become", function()
        local target: i32 = run.target_at(1, false)
        expect(tostring(run.outcome_of(1, false, run.max_hearts, false, 99)))
            :toBe("lost-vault")
        -- Holding exactly the target clears; a single gold short does not.
        expect(tostring(run.outcome_of(
            1, false, run.max_hearts, true, target))):toBe("advance")
        expect(tostring(run.outcome_of(
            1, false, run.max_hearts, true, target - 1))):toBe("lost-target")
        -- The Opponent holding the duel outranks the purse: a run that lost
        -- the run is over for that reason, whatever it was carrying.
        expect(tostring(run.outcome_of(
            1, false, run.max_hearts, false, 0))):toBe("lost-vault")
        -- The last heart can disappear before the duel has otherwise ended.
        expect(tostring(run.outcome_of(1, false, 0, false, 99)))
            :toBe("lost-health")
    end)

    it("loses and restarts the run when the last heart is gone", function()
        local state: run.State = run.new(spells.SpellKind.Clone, false)
        for _ = 1, run.max_hearts do state:lose_hand() end
        expect(state.hearts):toBe(0)
        -- Repeated terminal signals clamp rather than manufacturing negative
        -- health while the final reveal waits to be dismissed.
        expect(state:lose_hand()):toBe(true)
        expect(state.hearts):toBe(0)
        expect(tostring(state:settle(false, 99))):toBe("lost-health")
        expect(state.duel):toBe(1)
        expect(state.hearts):toBe(run.max_hearts)
        expect(state.start_spell):toBe(spells.SpellKind.Clone)
    end)

    it("passes through the finish line once and walks on", function()
        local finish: i32 = run.run_length(false)
        expect(tostring(run.outcome_of(
            finish, false, run.max_hearts, true, 999))):toBe("won")
        expect(tostring(run.outcome_of(
            finish - 1, false, run.max_hearts, true, 999))):toBe("advance")
        -- Not a state the run stays in: the duel after the finish is an
        -- ordinary one again, however far past the table it is.
        expect(tostring(run.outcome_of(
            finish + 1, false, run.max_hearts, true, 999))):toBe("advance")
        expect(tostring(run.outcome_of(
            finish + 7, false, run.max_hearts, true, 999))):toBe("advance")
    end)

    it("takes the last duel of the table and keeps the run going", function()
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        local finish: i32 = run.run_length(false)
        state.duel = finish
        state.cleared = finish - 1
        expect(tostring(state:settle(true, 200))):toBe("won")
        -- Won, and still standing in the city: the next duel is dealt, the
        -- purse survived, and the loadout was never reset.
        expect(state.duel):toBe(finish + 1)
        expect(state.cleared):toBe(finish)
        expect(state.gold):toBe(200 - run.target_at(finish, false))
        expect(state:endless()):toBe(true)
        expect(tostring(state:settle(true, 200))):toBe("advance")
        expect(state.duel):toBe(finish + 2)
    end)

    it("ends a run that opened the duel but could not pay the target", function()
        local state: run.State = run.new(spells.SpellKind.FreezeRay, false)
        state:settle(true, 40)
        local short: i32 = run.target_at(state.duel, false) - 1
        expect(tostring(state:settle(true, short))):toBe("lost-target")
        -- The same ending as the Opponent taking it: a fresh first duel, the
        -- starting spell back at full price, and the purse gone.
        expect(state.duel):toBe(1)
        expect(state.cleared):toBe(0)
        expect(state.gold):toBe(game.starting_gold)
        expect(state.start_spell):toBe(spells.SpellKind.FreezeRay)
    end)

    it("still charges an endless run, and still ends it", function()
        local state: run.State = run.new(spells.SpellKind.Clone, false)
        state.duel = run.run_length(false) + 3
        state.cleared = run.run_length(false) + 2
        local target: i32 = state:target()
        expect(tostring(state:settle(true, target - 1))):toBe("lost-target")
        expect(state.duel):toBe(1)
        expect(state:endless()):toBe(false)
    end)

    it("carries a run past the finish line through a snapshot", function()
        local state: run.State = run.new(spells.SpellKind.RaiseCard, false)
        state.duel = run.run_length(false) + 3
        state.cleared = run.run_length(false) + 2
        state.gold = 61
        local restored: run.State? = run.restore(run.snapshot(state))
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            expect(restored.duel):toBe(run.run_length(false) + 3)
            expect(restored.gold):toBe(61)
            -- The target is read back off the duel rather than stored, so a
            -- payload from before the finish line needs nothing added to it.
            expect(restored:target()):toBe(state:target())
        end
    end)
end)

describe("Ante Magic duel verdicts", function()
    it("clears a duel the Opponent failed to hold twice", function()
        math.randomseed(71)
        local state: game.State = game.new(
            false, { spells.Spell.new(spells.SpellKind.Firebolt) }, game.starting_gold)
        expect(state:is_victory()):toBe(false)
        game_fixture.finish(state, 1)
        expect(state:is_victory()):toBe(true)
        expect(game.view_cleared(game.view(state))):toBe(true)
    end)

    it("loses a duel the Opponent held three times", function()
        math.randomseed(73)
        local state: game.State = game.new(
            false, { spells.Spell.new(spells.SpellKind.Firebolt) }, game.starting_gold)
        game_fixture.finish(state, 3)
        expect(state:is_victory()):toBe(false)
        expect(game.view_cleared(game.view(state))):toBe(false)
    end)

    it("asks the run for what follows a verdict", function()
        local keyboard: flow.State = flow.new()
        local mouse: flow.State = flow.new()
        keyboard.modal = "final"
        mouse.modal = "final"
        expect(tostring(flow.gate(keyboard, true, false, true, "advance")))
            :toBe("advance")
        expect(tostring(flow.gate(mouse, true, false, true, "primary")))
            :toBe("advance")
        -- The verdict stays up until the screen deals whatever comes next.
        expect(tostring(keyboard.modal)):toBe("final")
        -- Restart is still its own answer: the whole run over again, rather
        -- than whatever duel the run would have moved to.
        expect(tostring(flow.gate(keyboard, true, false, true, "restart")))
            :toBe("reset")
        -- The ledger opens over the verdict, and closing it puts the verdict
        -- back: a settled board is not somewhere a run can be left standing.
        expect(tostring(flow.gate(mouse, true, false, true, "history")))
            :toBe("consumed")
        expect(tostring(mouse.modal)):toBe("history")
        expect(tostring(flow.gate(mouse, true, false, true, "history")))
            :toBe("consumed")
        expect(tostring(mouse.modal)):toBe("final")
        expect(tostring(flow.gate(mouse, true, false, true, "help")))
            :toBe("consumed")
        expect(tostring(flow.gate(mouse, true, false, true, "advance")))
            :toBe("consumed")
        expect(tostring(mouse.modal)):toBe("final")
    end)
end)

-- The duel screen deals each duel from the run the same way these do: the
-- variant, spell, and opening gold are all the run's to say. What the screen
-- adds on top is choreography, which needs a canvas and is covered by the
-- app's browser suite instead.
describe("Ante Magic run progression", function()
    it("deals the next duel with the gold the last one left", function()
        math.randomseed(79)
        local state: run.State = run.new(spells.SpellKind.Firebolt, false)
        local first: game.State = settle_vault(state, 0, 42)
        expect(first:gold()):toBe(42)
        expect(state.duel):toBe(2)
        expect(state.cleared):toBe(1)

        local second: game.State = game.new(state:boss(), state.spells, state.gold)
        expect(second:gold()):toBe(42 - run.target_at(1, false))
        expect(second:is_boss()):toBe(false)
        expect(second:is_finished()):toBe(false)
        expect(second:spell_kind(0)):toBe(spells.SpellKind.Firebolt)

        clear_vault(state, 30)
        expect(state.duel):toBe(3)
        expect(state.cleared):toBe(2)
        -- The third duel is the boss battle: seven cards, no replacements.
        local third: game.State = game.new(state:boss(), state.spells, state.gold)
        expect(third:gold()):toBe(30 - run.target_at(2, false))
        expect(third:is_boss()):toBe(true)
        expect(third:hand_size()):toBe(7)
    end)

    it("ends the run where the Opponent stops it", function()
        math.randomseed(83)
        local state: run.State = run.new(spells.SpellKind.Clone, false)
        clear_vault(state, 42)
        local lost: game.State = settle_vault(state, 3, 42)
        expect(lost:is_victory()):toBe(false)

        expect(state.duel):toBe(1)
        expect(state.cleared):toBe(0)
        local fresh: game.State = game.new(state:boss(), state.spells, state.gold)
        expect(fresh:gold()):toBe(game.starting_gold)
        expect(fresh:spell_kind(0)):toBe(spells.SpellKind.Clone)
    end)

    it("keeps every duel of a boss rush a boss battle", function()
        math.randomseed(89)
        local state: run.State = run.new(spells.SpellKind.FreezeRay, true)
        local opening: game.State = settle_vault(state, 0, 25)
        expect(opening:is_boss()):toBe(true)
        expect(opening:hand_size()):toBe(7)

        expect(state.duel):toBe(2)
        expect(state:boss()):toBe(true)
        expect(state:next_is_boss()):toBe(true)
        local second: game.State = game.new(state:boss(), state.spells, state.gold)
        expect(second:gold()):toBe(25 - run.target_at(1, true))
        expect(second:hand_size()):toBe(7)
    end)
end)
