-- Ante Magic's live viewport. The board is laid out from the canvas's
-- actual dimensions every frame: one derived unit scale keeps cards, text,
-- circles, and line widths proportional to each other, while the logical
-- width and height stay live so every screen places its semantic regions
-- inside all the space there actually is.
--
-- The scale is not a canvas assumption. It answers "how large can a card be
-- while the packed board still fits both dimensions", and the packed board
-- is described below purely in terms of its own content — card rows, side
-- columns, and clearances measured in card-design units. A canvas of any
-- size or aspect ratio reflows the same board; nothing anywhere assumes a
-- reference resolution.
--
type State = {
    canvas_width: f64,
    canvas_height: f64,
    scale: f64,
    width: f64,
    height: f64,
    center_x: f64,
    center_y: f64,
    computer_y: f64,
    player_y: f64,
    table_card_y: f64,
    action_y: f64,
    side_left: f64,
    side_right: f64,
    hand_span: f64,
    footer_y: f64
}

-- Card faces are drawn in a 104x128-unit design space (render.walu's
-- CARD_W/CARD_H mirror these). The cards are what size the packed board,
-- which is what turns the live canvas into a unit scale.
const CARD_WIDTH: f64 = 104.0
const CARD_HEIGHT: f64 = 128.0

-- Across, at its tightest: a margin and one card column on each flank — the
-- sealed deck on the left, the spent pile on the right — a seam between
-- each column and the play area, and the fixed three-table_card row.
-- TABLE_CARD_ROW_SPAN mirrors render.walu's table_card row: three cards on a 116-unit
-- pitch (2 * 116 + 104).
const BOARD_MARGIN: f64 = 56.0
const COLUMN_SEAM: f64 = 22.0
const TABLE_CARD_ROW_SPAN: f64 = 336.0

-- Down, at its tightest: the title band over the Opponent's sealed row,
-- three card rows, the packed clearances between the rows (the table_card prompt
-- and the action capsules live inside these), and the footer strip under
-- the fan.
const TOP_BAND: f64 = 116.0
const ROW_CLEARANCES: f64 = 73.0
const FOOTER_BAND: f64 = 27.0

-- Height beyond the packed board — a canvas whose width is the tighter fit —
-- is shared out rather than dumped into one gap: a share grows the title
-- band, a share keeps the fan off the floor, and the rest opens the middle
-- of the board through the centred table_card row.
const EXTRA_ABOVE: f64 = 0.3
const EXTRA_BELOW: f64 = 0.2

-- The table_card row rides just below the midpoint between the sealed row and the
-- fan, leaving the lower clearance for the action capsules.
const TABLE_CARD_BIAS: f64 = 12.0

-- The hand rows may spread at most five card widths — wider stops reading
-- as one hand — and keep a wide seam to the side columns so a parting fan
-- never brushes the deck or the spent pile.
const HAND_SEAM: f64 = 60.0

function min_board_width(): f64
    return (BOARD_MARGIN + CARD_WIDTH + COLUMN_SEAM) * 2.0 + TABLE_CARD_ROW_SPAN
end

function min_board_height(): f64
    return TOP_BAND + CARD_HEIGHT * 3.0 + ROW_CLEARANCES + FOOTER_BAND
end

function calculate(canvas_width: f64, canvas_height: f64): State
    if canvas_width < 1.0 then canvas_width = 1.0 end
    if canvas_height < 1.0 then canvas_height = 1.0 end

    -- The largest unit size at which the packed board still fits both
    -- dimensions of the real canvas.
    local scale: f64 = canvas_width / min_board_width()
    local height_scale: f64 = canvas_height / min_board_height()
    if height_scale < scale then scale = height_scale end

    local width: f64 = canvas_width / scale
    local height: f64 = canvas_height / scale
    local extra: f64 = height - min_board_height()
    if extra < 0.0 then extra = 0.0 end

    local computer_y: f64 = TOP_BAND + extra * EXTRA_ABOVE
    -- player_y is the fan's centre line: half a card plus the footer strip
    -- off the bottom edge, lifted by its share of any extra height.
    local player_y: f64 = height - FOOTER_BAND - CARD_HEIGHT * 0.5 - extra * EXTRA_BELOW
    local table_card_center_y: f64 = (computer_y + CARD_HEIGHT * 0.5 + player_y) * 0.5 + TABLE_CARD_BIAS
    local table_card_y: f64 = table_card_center_y - CARD_HEIGHT * 0.5

    local hand_span: f64 = width - (BOARD_MARGIN + CARD_WIDTH + HAND_SEAM) * 2.0
    local widest_span: f64 = CARD_WIDTH * 5.0
    if hand_span > widest_span then hand_span = widest_span end
    return {
        canvas_width = canvas_width,
        canvas_height = canvas_height,
        scale = scale,
        width = width,
        height = height,
        center_x = width * 0.5,
        center_y = height * 0.5,
        computer_y = computer_y,
        player_y = player_y,
        table_card_y = table_card_y,
        action_y = table_card_y + 120.0,
        side_left = BOARD_MARGIN,
        side_right = width - BOARD_MARGIN - CARD_WIDTH,
        hand_span = hand_span,
        footer_y = height - 18.0,
    }
end

-- Until the first frame measures the canvas, the board stands packed at
-- unit scale; main.walu updates from the live canvas before anything draws.
local current_state: State = calculate(min_board_width(), min_board_height())

function update(canvas_width: f64, canvas_height: f64): unit
    current_state = calculate(canvas_width, canvas_height)
end

function current(): State
    return current_state
end

function canvas_x(value: f64): f64
    return value / current_state.scale
end

function canvas_y(value: f64): f64
    return value / current_state.scale
end

return {
    update = update,
    current = current,
    canvas_x = canvas_x,
    canvas_y = canvas_y,
}
