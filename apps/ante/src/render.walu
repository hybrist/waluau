-- Engine-rendered presentation for Ante Magic. Everything visible to the
-- player lives on this one logical canvas, including secondary modal screens.

local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local particles = require("waluau:engine/particles")
local effect_shaders = require("./effect_shaders")
local burn_particles = require("./burn_particles")
local spell_cast = require("./spell_cast")
local spell_launch = require("./spell_launch")
local game = require("./game")
local layout = require("./layout")
local card_warp = require("./card_warp")
local card_draw = require("./card_draw")

type Graphics = engine.Graphics
type EffectShaders = effect_shaders.EffectShaders
-- A position on the logical canvas. Everything that travels — animation legs,
-- slot anchors, gather points, pointer hits — moves through Points, so a
-- location is one value rather than an x and a y drifting separately.
type Point = { x: f64, y: f64 }

function point(x: f64, y: f64): Point
    return { x = x, y = y }
end

function midpoint(a: Point, b: Point): Point
    return { x = (a.x + b.x) * 0.5, y = (a.y + b.y) * 0.5 }
end

function lerp(a: Point, b: Point, t: f64): Point
    return { x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t }
end

const CARD_W: f64 = 104.0
const CARD_H: f64 = 128.0
const MODAL_HISTORY: i32 = 1
const MODAL_HELP: i32 = 2
const MODAL_FINAL: i32 = 4
const FLIP_SECONDS: f64 = 0.55
const TOTAL_ROUNDS: i32 = 5
const SELECTION_HIGHLIGHT: string = "#fbbf24"
const POWER_FIREBALL: i32 = 1
const POWER_FREEZE: i32 = 2
const POWER_RAISE: i32 = 3
const POWER_GROWTH: i32 = 4
const POWER_FORM_SECONDS: f64 = 0.78
const FIREBALL_BURN_SECONDS: f64 = 1.55
const FIREBALL_ASH_FADE_SECONDS: f64 = 1.10

-- Menu labels, cast prompts, and launch dispatch all consume the same spell
-- catalog instead of maintaining parallel kind ladders.
function spell_name(kind: i32): string
    return spell_launch.name(kind)
end

function power_color(kind: i32): string
    return spell_launch.color(kind)
end

function use_gold_shimmer(graphics: Graphics, effects: EffectShaders, strength: f64, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.gold_shimmer.shader
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local strength_ok: bool = graphics:set_uniform_float("u_strength", strength)
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    return strength_ok and aspect_ok
end

function use_defeat_shroud(graphics: Graphics, effects: EffectShaders, strength: f64, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.defeat_shroud.shader
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local strength_ok: bool = graphics:set_uniform_float("u_strength", strength)
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    return strength_ok and aspect_ok
end

function use_card_burn(graphics: Graphics, effects: EffectShaders, progress: f64, seed: i32, suit: i32): bool
    local maybe_shader: graphics_module.Shader? = effects.card_burn.shader
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local progress_ok: bool = graphics:set_uniform_float("u_progress", progress)
    local seed_ok: bool = graphics:set_uniform_float("u_seed", seed::f64)
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", CARD_W / CARD_H)
    local mode_ok: bool = graphics:set_uniform_float("u_particle_mode", 0.0)
    local accent_red: f64 = 0.29
    local accent_green: f64 = 0.87
    local accent_blue: f64 = 0.50
    if suit == 0 then
        accent_red = 0.94
        accent_green = 0.27
        accent_blue = 0.27
    elseif suit == 1 then
        accent_red = 0.22
        accent_green = 0.74
        accent_blue = 0.97
    elseif suit == 2 then
        accent_red = 0.66
        accent_green = 0.33
        accent_blue = 0.97
    end
    local accent_ok: bool = graphics:set_uniform_vec3(
        "u_accent_color", accent_red, accent_green, accent_blue)
    return progress_ok and seed_ok and aspect_ok and mode_ok and accent_ok
end

function use_red_fire(graphics: Graphics, effects: EffectShaders, selected: bool, colored: bool, aspect: f64): bool
    -- TODO(waluau-engine): Typed shader parameter blocks would let all four
    -- school effects share one checked binding path instead of repeating
    -- use_shader plus individual string-keyed uniform writes.
    local maybe_shader: graphics_module.Shader? = effects.red_fire.shader
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local selected_value: f64 = 0.0
    if selected then selected_value = 1.0 end
    local colored_value: f64 = 0.0
    if colored then colored_value = 1.0 end
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    local selected_ok: bool = graphics:set_uniform_float("u_selected", selected_value)
    local colored_ok: bool = graphics:set_uniform_float("u_colored", colored_value)
    return aspect_ok and selected_ok and colored_ok
end

function use_blue_caustics(graphics: Graphics, effects: EffectShaders, selected: bool, colored: bool, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.blue_caustics.shader
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
