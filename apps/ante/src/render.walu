-- The vault board, composed. Everything the player can see is an entity that
-- knows its own size and draws itself into the rectangle it is handed
-- (`entity.walu` and `entities/`); this module decides which entities are on
-- the board this frame and which part of the live viewport each of them gets.
--
-- What stays here is what is not an entity: the cards in flight. An animation
-- leg is a card between two places rather than a thing standing in one, so it
-- is drawn against the board's slot anchors instead of being laid out — and
-- those anchors are the same box-layout frames the rows paint into, so a card
-- can only ever land where a card is actually going to be.

local graphics_module = require("waluau:engine/graphics")
local particles = require("waluau:engine/particles")
local effect_shaders = require("./effect_shaders")
local spell_cast = require("./spell_cast")
local spell_launch = require("./spell_launch")
local game = require("./game")
local run_module = require("./run")
local layout = require("./layout")
local card_warp = require("./card_warp")
local card_draw = require("./card_draw")
local box = require("./box_layout")
local entity = require("./entity")
local ink = require("./ink")
local easing = require("./easing")
local card_burn = require("./card_burn")
local card = require("./entities/card")
local card_row = require("./entities/card_row")
local hand_fan = require("./entities/hand_fan")
local ward_panel = require("./entities/ward_panel")
local deck = require("./entities/deck")
local pile = require("./entities/pile")
local hud = require("./entities/hud")
local footer = require("./entities/footer")
local action_bar = require("./entities/action_bar")
local capsule = require("./entities/capsule")
local powered_card = require("./entities/powered_card")
local backdrop = require("./entities/backdrop")
local modal = require("./entities/modal")
local help_card = require("./entities/help_card")
local ledger = require("./entities/ledger")
local verdict = require("./entities/verdict")

-- A position on the logical canvas. Everything that travels — animation legs,
-- slot anchors, gather points, pointer hits — moves through Points, so a
-- location is one value rather than an x and a y drifting separately.
type Point = { x: f64, y: f64 }

function point(x: f64, y: f64): Point
    return { x = x, y = y }
end

function midpoint(a: Point, b: Point): Point
    return { x = (a.x + b.x) * 0.5, y = (a.y + b.y) * 0.5 }
end

function lerp(a: Point, b: Point, t: f64): Point
    return { x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t }
end

function top_left(rect: box.Rect): Point
    return point(rect.x, rect.y)
end

const MODAL_HISTORY: i32 = 1
const MODAL_HELP: i32 = 2
const MODAL_FINAL: i32 = 4
const FLIP_SECONDS: f64 = 0.55

-- Where the board's own bands sit inside the live viewport. Each band says
-- where an entity starts and how wide it may be; how tall it turns out to be
-- is the entity's answer, not this module's.
const BOARD_EDGE: f64 = 32.0
const HEADER_TOP: f64 = 25.0
const FOOTER_EDGE: f64 = 17.0
const FOOTER_BOTTOM: f64 = 11.0
-- Clearance between the ward row and the line of type above it.
const PROMPT_RISE: f64 = 40.0
-- Where the continue prompt of a settled breach sits under the action band.
const CONTINUE_DROP: f64 = 30.0
const PROMPT_DROP: f64 = 18.0
const HEADLINE_TOP: f64 = 90.0

-- Board anchors card animations travel between. Choreography mirrors these ids
-- when it builds animations, the same way it mirrors the modal ids above.
const SLOT_PLAYER: i32 = 0
const SLOT_COMPUTER: i32 = 1
const SLOT_MIDDLE: i32 = 2
const SLOT_DECK: i32 = 3
-- The burn pile, mid-height on the right edge: the losing pair, reduced to
-- embers during the reveal, is recorded here — no one keeps a burned trick.
const SLOT_ASIDE: i32 = 4
-- Each side keeps the tricks it won in its own pile, stacked down the right
-- edge beside that side's hand: the Arch Mage's held wards up by its sealed
-- row, the player's breached tricks down by the fan, the burn pile between
-- them. A won trick is the whole five-card formation — the three wards plus the
-- pair that settled it.
const SLOT_COMPUTER_WON: i32 = 5
const SLOT_PLAYER_WON: i32 = 6

-- Faces an animated card shows along its flight: stay sealed, stay revealed,
-- or flip between the two mid-flight. Choreography mirrors these values too.
const FACES_DOWN: i32 = 0
const FACES_UP: i32 = 1
const FACES_FLIP_UP: i32 = 2
const FACES_FLIP_DOWN: i32 = 3
const EASE_OUT_QUINT: i32 = 0
const EASE_IN_CUBIC: i32 = 1
const EASE_IN_OUT_CUBIC: i32 = 2
const EASE_OUT_BACK: i32 = 3
const ANIM_EFFECT_MOVE: i32 = 0
const ANIM_EFFECT_ASH_REAPPEAR: i32 = 1
const ANIM_EFFECT_THROW: i32 = 2

-- The thrown card's dials, straight from the tuning the card stories settled
-- on: how long the sheet may get, how far past its slot the throw carries it
-- as a share of the journey, and how high off the board it rises toward the
-- viewer. The clock inside a throw leg is card_draw's authored one, scaled
-- to whatever duration the leg was given.
const THROW_STRETCH: f64 = 1.6
const THROW_OVERSHOOT: f64 = 0.3
const THROW_RISE: f64 = 270.0

-- Once both flips have landed, the winner's pair flies out of its row and
-- joins the three wards, so the whole five-card formation stands together in
-- the middle of the board. FLY_START leaves a beat after the second flip
-- (which finishes at 0.2 + FLIP_SECONDS * 1.7), and the second card trails
-- the first by FLY_STAGGER so the pair arrives as two beats rather than a
-- block slide.
const FLY_START: f64 = 1.3
const FLY_SECONDS: f64 = 0.45
const FLY_STAGGER: f64 = 0.12
-- The formation the pair lands in: the ward row extended to five slots on the
-- same pitch, so the wards do not move and the flanks arrive on the rhythm the
-- row already has.
const FORMATION_SLOTS: i32 = 5
const WIN_LIFT_SCALE: f64 = 1.14
const WIN_LIFT_Y: f64 = 10.0

-- Once the second card has landed, a single animated gold halo ignites
-- beneath the completed row and brightens over WIN_GLOW_FADE. It extends a
-- little beyond the cards, while its uninterrupted centre remains visible in
-- the four gaps. The cards themselves are drawn later over the light field.
-- Kept equal to FLY_START + FLY_STAGGER + FLY_SECONDS; top-level constants
-- require literal initializers.
const WIN_GLOW_START: f64 = 1.87
const WIN_GLOW_FADE: f64 = 0.35
const SHIMMER_MARGIN: f64 = 64.0

const PROMPT_SIZE: f64 = 11.0
const PROMPT_INK: string = "#d4d4d8"
const HEADLINE_SIZE: f64 = 14.0

-- One leg of a card's journey across the board. The card renders at `from`
-- until start, travels to `to` over duration, and only exists on screen
-- inside [appear, vanish) — outside that window an adjacent leg or the real
-- board slot owns the card. The card also turns from angle0 to angle1, which
-- is how a relic joins or leaves the player's tilted fan without snapping
-- upright at either end. Legs whose dest_kind names a board slot keep that
-- slot empty until they vanish, so state that already changed is not revealed
-- ahead of the animation. `known` matches the slot the card is headed for, so a
-- ward crossing into a hand carries its eye the whole way rather than sprouting
-- one the instant it lands. Most legs move an intact card; an ash-reappearance
-- leg stays at the discard anchor and rebuilds a burned card there instead.
type Anim = {
    card: game.Card,
    faces: i32,
    known: bool,
    effect: i32,
    from: Point,
    to: Point,
    angle0: f64,
    angle1: f64,
    easing: i32,
    start: f64,
    duration: f64,
    appear: f64,
    vanish: f64,
    dest_kind: i32,
    dest_index: i32
}

-- The renderer consumes one frame record instead of a conveyor of unrelated
-- parameters. New interaction or presentation state extends its own nested
-- record without changing every draw function between choreography and the
-- final spell/card implementation.
type Interaction = {
    hand_focus: i32,
    ward_cursor: i32,
    cursor_area: i32,
    play_picks: {i32},
    swap_hand: {i32},
    swap_wards: {i32},
    modal: i32,
    revealing: bool,
    casting: bool,
    -- The loadout slot being aimed while `casting` holds: which spell the aim
    -- prompt names, and whose price it quotes.
    cast_slot: i32
}
type Motion = {
    fan_parts: {f64},
    reveal_clock: f64,
    anims: {Anim},
    anim_clock: f64
}
type Piles = {
    discards: {game.Card},
    computer_won: {game.Card},
    player_won: {game.Card}
}
type SpellPresentation = {
    kind: i32,
    clock: f64,
    target: i32
}
-- Everything a spell has in the air. `sparks` is the cast's own — the carrier's
-- trail and the burst its landing threw — and belongs to the spell modules
-- behind the launch seam. The grave dust is not a cast at all: it is the ward
-- Raise Card left standing, shedding off the aperture it climbed out of for as
-- long as the condition holds.
type SpellParticles = {
    sparks: spell_cast.Sparks,
    grave_dust: particles.ParticleSystem
}
type Frame = {
    viewport: layout.State,
    view: game.View,
    run: run_module.View,
    interaction: Interaction,
    motion: Motion,
    piles: Piles,
    spell: SpellPresentation,
    -- Live emitters, not a description of them: the ash a burning card has
    -- already shed is simulation state the frame reads, and the same state the
    -- update tick advanced.
    ash: card_burn.CardAsh,
    spells: SpellParticles,
    -- Scratch geometry for thrown cards, owned by choreography like the ash:
    -- one deformable sheet, rebuilt each frame a throw is in the air. A card
    -- deformed sixty times a second should not be sixty allocations.
    sheet: card_warp.Mesh
}

function ease_progress(t: f64, kind: i32): f64
    if kind == EASE_IN_CUBIC then return easing.in_cubic(t) end
    if kind == EASE_IN_OUT_CUBIC then return easing.in_out_cubic(t) end
    if kind == EASE_OUT_BACK then return easing.out_back(t) end
    return easing.out_quint(t)
end

-- ---------------------------------------------------------------------------
-- The bands. Where each entity of the board stands inside the live viewport.
-- ---------------------------------------------------------------------------

-- Both hand rows are laid out for however many cards they currently hold, and
-- both may spread at most as far as the viewport's hand span before their
-- pitch tightens.
function hand_width(viewport: layout.State): f64
    return viewport.hand_span + card.width
end

function computer_band(viewport: layout.State): box.Rect
    local width: f64 = hand_width(viewport)
    return entity.rect(
        viewport.center_x - width * 0.5, viewport.computer_y, width, card.height)
end

function fan_band(viewport: layout.State, count: i32): box.Rect
    local width: f64 = hand_width(viewport)
    local height: f64 = hand_fan.intrinsic(count).preferred_height
    return entity.rect(
        viewport.center_x - width * 0.5, viewport.player_y - height * 0.5,
        width, height)
end

-- The middle of the board, sized for however many slots stand in it: three
-- while the vault is being fought, five once a breach has been settled and the
-- winner's pair has joined the wards.
function ward_band(viewport: layout.State, slots: i32): box.Rect
    local size: box.Intrinsic = card_row.intrinsic(slots, card_row.flat_pitch)
    return entity.rect(
        viewport.center_x - size.preferred_width * 0.5, viewport.ward_y,
        size.preferred_width, size.preferred_height)
end

function action_band(viewport: layout.State): box.Rect
    return entity.rect(0.0, viewport.action_y, viewport.width, capsule.height)
end

function deck_band(viewport: layout.State): box.Rect
    return entity.rect(
        viewport.side_left, viewport.ward_y,
        card.width, card.height + deck.caption_drop)
end

function board_rect(viewport: layout.State): box.Rect
    return entity.rect(0.0, 0.0, viewport.width, viewport.height)
end

function header_band(metrics: entity.Metrics, node: entity.Node, viewport: layout.State): box.Rect
    return entity.band(
        metrics, node, BOARD_EDGE, HEADER_TOP, viewport.width - BOARD_EDGE * 2.0)
end

function footer_band(metrics: entity.Metrics, node: entity.Node, viewport: layout.State): box.Rect
    return entity.band_above(
        metrics, node, FOOTER_EDGE, viewport.height - FOOTER_BOTTOM,
        viewport.width - FOOTER_EDGE * 2.0)
end

-- A line of type centred across the board, hung off a baseline the way the
-- board's prompts always have been.
function centered_line(
    surface: entity.Surface, viewport: layout.State,
    text: string, baseline: f64, size: f64, color: string
): unit
    ink.text_centered(surface.graphics, text, viewport.center_x, baseline, size, color)
end

-- ---------------------------------------------------------------------------
-- Slot anchors. The same box-layout frames the rows paint into, answered
-- without a frame so choreography can aim an animation at them.
-- ---------------------------------------------------------------------------

function hand_slot(viewport: layout.State, index: i32, part: f64, count: i32): box.Rect
    return hand_fan.slot_rect(fan_band(viewport, count), index, part, count)
end

function row_slot(viewport: layout.State, slots: i32, index: i32): box.Rect
    return card_row.slot_rect(
        slots, card_row.flat_pitch, ward_band(viewport, slots), index)
end

-- Top-left of a board slot's card box. The player's row reads off the closed
-- fan; the burn pile and both won piles share the right edge, one card column
-- opposite the deck, each at its owner's height: the Arch Mage's up beside its
-- sealed row, the player's down beside the fan, the burn pile centred between.
-- The count parameter sizes the two hand rows; every other slot ignores it.
function slot_pos_at(viewport: layout.State, kind: i32, index: i32, count: i32): Point
    if kind == SLOT_PLAYER then
        return top_left(hand_slot(viewport, index, 0.0, count))
    end
    if kind == SLOT_COMPUTER then
        local band: box.Rect = computer_band(viewport)
        return top_left(card_row.slot_rect(
            count, card_row.pitch_in(band, count, card_row.flat_pitch),
            band, index))
    end
    if kind == SLOT_MIDDLE then return top_left(row_slot(viewport, 3, index)) end
    if kind == SLOT_DECK then return point(viewport.side_left, viewport.ward_y) end
    if kind == SLOT_COMPUTER_WON then
        return point(viewport.side_right, viewport.computer_y)
    end
    if kind == SLOT_PLAYER_WON then
        return point(viewport.side_right, viewport.player_y - card.height * 0.5 + 7.0)
    end
    return point(
        viewport.side_right + (index::f64) * 4.0,
        viewport.ward_y + (index::f64) * 12.0)
end

-- Countless slots — the wards, the deck, and the three piles — never move
-- with the hand layout; this shorthand names them without inventing a count.
-- The two hand rows must go through slot_pos_at with their real size.
function slot_pos(viewport: layout.State, kind: i32, index: i32): Point
    return slot_pos_at(viewport, kind, index, 5)
end

-- Centre of a board slot's card box, in a hand row laid out for `count`.
function slot_center(viewport: layout.State, kind: i32, index: i32, count: i32): Point
    local slot: Point = slot_pos_at(viewport, kind, index, count)
    return point(slot.x + card.width * 0.5, slot.y + card.height * 0.5)
end

-- The two flanks of the resolved five-card formation, where the winner's pair
-- lands. They are the outer slots of the same row the wards are the middle
-- three of, so nothing has to move to make room for them.
function row_left(viewport: layout.State): Point
    return top_left(row_slot(viewport, FORMATION_SLOTS, 0))
end

function row_right(viewport: layout.State): Point
    return top_left(row_slot(viewport, FORMATION_SLOTS, FORMATION_SLOTS - 1))
end

function hand_angle_at(index: i32, part: f64, count: i32): f64
    return hand_fan.angle_at(index, part, count)
end

function hand_pos_at(viewport: layout.State, index: i32, part: f64, count: i32): Point
    return top_left(hand_slot(viewport, index, part, count))
end

function hand_part_target(index: i32, focus: i32): f64
    return hand_fan.part_target(index, focus)
end

-- Centre of a bound relic in the fan: the bind lift rises along the card's
-- tilted axis, so the launch point folds that lift through the relic's angle
-- instead of lifting straight up the screen.
function bound_hand_center(viewport: layout.State, index: i32, part: f64, count: i32): Point
    local angle: f64 = hand_fan.angle_at(index, part, count)
    local slot: box.Rect = hand_slot(viewport, index, part, count)
    return point(
        slot.x + card.width * 0.5 + math.sin(angle) * card.bind_lift,
        slot.y + card.height * 0.5 - math.cos(angle) * card.bind_lift)
end

function slot_hidden(anims: {Anim}, clock: f64, kind: i32, index: i32): bool
    for anim in anims do
        if anim.dest_kind == kind and anim.dest_index == index and clock < anim.vanish then
            return true
        end
    end
    return false
end

function hidden_slots(anims: {Anim}, clock: f64, kind: i32, count: i32): {bool}
    local flags: {bool} = {}
    for index = 0::i32, count - 1 do
        table.insert(flags, slot_hidden(anims, clock, kind, index))
    end
    return flags
end

function is_picked(picks: {i32}, value: i32): bool
    for pick in picks do if pick == value then return true end end
    return false
end

-- ---------------------------------------------------------------------------
-- Pointer hits. Every one of these answers from the same rectangle the entity
-- was painted into.
-- ---------------------------------------------------------------------------

function hit_hand(viewport: layout.State, at: Point, parts: {f64}): i32
    return hand_fan.hit(fan_band(viewport, #parts), parts, at.x, at.y)
end

-- The ward under a point, or -1. Wards lie square to the board.
function hit_ward(viewport: layout.State, at: Point): i32
    for index = 0::i32, 2::i32 do
        if entity.contains(row_slot(viewport, 3, index), at.x, at.y) then
            return index
        end
    end
    return -1
end

-- The rectangles the last painted frame put its type-sized controls in. Where
-- a capsule or the help caption ends up is a measurement — of a string,
-- against whichever font has actually loaded — so the pointer answers from
-- what was drawn rather than from a second description of it. A control the
-- frame did not draw keeps the empty rectangle, which no point is inside, so
-- it is not there to click either.
type Targets = { help: box.Rect, commit: box.Rect, pass: box.Rect }

function nowhere(): box.Rect
    return entity.rect(0.0, 0.0, -1.0, -1.0)
end

function no_targets(): Targets
    return { help = nowhere(), commit = nowhere(), pass = nowhere() }
end

local targets: Targets = no_targets()

function clear_targets(): unit
    targets = no_targets()
end

function hit_commit(at: Point): bool
    return entity.contains(targets.commit, at.x, at.y)
end

function hit_pass(at: Point): bool
    return entity.contains(targets.pass, at.x, at.y)
end

function hit_help(at: Point): bool
    return entity.contains(targets.help, at.x, at.y)
end

-- ---------------------------------------------------------------------------
-- Cards in flight, and the reveal's own effects.
-- ---------------------------------------------------------------------------

-- One quad backs the entire winning formation. A player win gets the radiant
-- gold shimmer; an Arch Mage win gets the contracting defeat shroud. Because
-- it is drawn before all five cards, the cards mask its centre while the
-- continuous field remains visible around them and through every gap.
function use_result_field(
    surface: entity.Surface, strength: f64, aspect: f64, player_won: bool
): bool
    local effects: effect_shaders.EffectShaders = surface.effects
    local maybe_shader: graphics_module.Shader? = effects.defeat_shroud.shader
    if player_won then maybe_shader = effects.gold_shimmer.shader end
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not surface.graphics:use_shader(shader) then return false end
    local strength_ok: bool = surface.graphics:set_uniform_float("u_strength", strength)
    local aspect_ok: bool = surface.graphics:set_uniform_float("u_aspect", aspect)
    return strength_ok and aspect_ok
end

function draw_result_field(
    surface: entity.Surface, bounds: box.Rect, strength: f64, player_won: bool
): unit
    if strength <= 0.0 then return end
    local graphics = surface.graphics
    local quad_width: f64 = bounds.width + SHIMMER_MARGIN * 2.0
    local quad_height: f64 = bounds.height + SHIMMER_MARGIN * 2.0
    if not use_result_field(
        surface, strength, quad_width / quad_height, player_won)
    then
        ink.stop_effect(graphics)
        ink.panel(
            graphics, bounds.x - 10.0, bounds.y + 34.0, bounds.width + 20.0, 60.0,
            "#2a001d", "#ff00ff")
        ink.text_centered(
            graphics, "RESULT SHADER ERROR",
            bounds.x + bounds.width * 0.5, bounds.y + 71.0, 14, "#ff66ff")
        return
    end
    graphics:set_color("#ffffffff")
    graphics:fill_rectangle(
        bounds.x - SHIMMER_MARGIN, bounds.y - SHIMMER_MARGIN,
        quad_width, quad_height)
    ink.stop_effect(graphics)
end

-- Fakes a card picked up off the table and turned over midair: cos
-- collapses the width (back, edge-on, then face) while sin lifts the card
-- toward the viewer — rising and growing around mid-flip — so the rotation
-- happens in the air instead of sweeping through the table surface. A
-- slight sin-driven skew tilts the silhouette for perspective. Everything
-- inherits the transform stack, so the regular card renderer draws both
-- halves of the flip.
function draw_flipping_card(
    surface: entity.Surface, value: game.Card, x: f64, y: f64,
    clock: f64, delay: f64, colored: bool
): unit
    local graphics = surface.graphics
    local progress: f64 = easing.clamp01((clock - delay) / FLIP_SECONDS)
    local turn: f64 = easing.in_out_cubic(progress)
    local angle: f64 = turn * math.pi
    local flat: f64 = math.cos(angle)
    local depth: f64 = math.sin(angle)
    local hidden: bool = flat >= 0.0
    local width_scale: f64 = flat
    if not hidden then width_scale = -flat end
    local lift: f64 = 1.0 + 0.14 * depth
    graphics:push()
    graphics:translate(x + card.width * 0.5, y + card.height * 0.5 - 10.0 * depth)
    graphics:apply_transform(width_scale * lift, 0.18 * depth, 0.0, lift, 0.0, 0.0)
    -- A card being turned over is on its way to public: whether the other side
    -- knew it a moment ago stops mattering the instant it lands face up, so no
    -- eye rides the flip.
    card.draw_at(
        surface, card.look(value, false, false, hidden, colored, false),
        -(card.width * 0.5), -(card.height * 0.5))
    graphics:pop()
end

-- A card thrown to a ward slot: the deck draw the card stories rehearse,
-- played on the live board. The card is card_warp's sheet rather than a
-- rectangle — it rises toward the viewer, stretches with its own momentum,
-- turns over past its leading edge, overshoots and drops onto the slot — so
-- this leg projects the sheet itself instead of using the transform stack.
-- The face is captured fresh each frame, the same bargain ash reappearance
-- strikes: a throw is short and rare, and a captured card is exact.
function draw_throw_card(
    surface: entity.Surface, anim: Anim, part: f64, sheet: card_warp.Mesh
): unit
    local graphics = surface.graphics
    local clock: f64 = part * card_draw.land_end
    local throw: card_draw.Draw = {
        from_x = anim.from.x + card.width * 0.5,
        from_y = anim.from.y + card.height * 0.5,
        to_x = anim.to.x + card.width * 0.5,
        to_y = anim.to.y + card.height * 0.5,
        width = card.width,
        height = card.height,
        stretch_limit = THROW_STRETCH,
        overshoot = THROW_OVERSHOOT,
        rise = THROW_RISE,
        arc = card_draw.arc_very_late
    }
    local pose: card_warp.Pose = card_draw.pose_at(throw, clock)
    local face_up: bool = card_draw.shows_face(throw, clock)
    local target: graphics_module.RenderTarget? = card.capture(
        surface, card.look(anim.card, false, false, not face_up, false, anim.known))
    if target == nil then
        -- Without a capture there is no texture for the sheet; the plain
        -- card at the pose's centre keeps the deal legible until assets are
        -- ready to be captured.
        card.draw_at(
            surface,
            card.look(anim.card, false, false, not face_up, false, anim.known),
            pose.center_x - card.width * 0.5, pose.center_y - card.height * 0.5)
        return
    end
    local captured: graphics_module.RenderTarget = target::graphics_module.RenderTarget
    card_warp.build(sheet, pose)
    -- Seen from behind, a card's face reads the wrong way round unless its
    -- source region is taken right to left.
    local source_x: f64 = 0.0
    local source_width: f64 = card.width
    if face_up then
        source_x = card.width
        source_width = -card.width
    end
    local texture: graphics_module.Texture = graphics:texture_from_render_target(
        captured)
    graphics:set_color_rgba(1.0, 1.0, 1.0, 1.0)
    graphics:draw_sprite_mesh(
        texture, sheet.columns, sheet.rows, sheet.xs, sheet.ys, sheet.shades,
        source_x, 0.0, source_width, card.height)
    graphics:release_render_target(captured)
end

-- A card mid-deal or mid-swap: eased travel between two board anchors with
-- an optional mid-flight flip, turning to meet the tilt of wherever it lands
-- and lifted slightly toward the viewer while it moves (matching the reveal
-- flip's midair feel).
function draw_anim_card(
    surface: entity.Surface, anim: Anim, clock: f64, sheet: card_warp.Mesh
): unit
    if clock < anim.appear or clock >= anim.vanish then return end
    local graphics = surface.graphics
    local t: f64 = 1.0
    if anim.duration > 0.0 then t = (clock - anim.start) / anim.duration end
    t = easing.clamp01(t)
    if anim.effect == ANIM_EFFECT_THROW then
        draw_throw_card(surface, anim, t, sheet)
        return
    end
    local ease: f64 = ease_progress(t, anim.easing)
    local at: Point = lerp(anim.from, anim.to, ease)
    if anim.effect == ANIM_EFFECT_ASH_REAPPEAR then
        card_burn.draw_reappearance(surface, anim.card, at.x, at.y, ease)
        return
    end
    local hidden: bool = anim.faces == FACES_DOWN
    local width_scale: f64 = 1.0
    local turn: f64 = easing.in_out_cubic(t)
    if anim.faces == FACES_FLIP_UP or anim.faces == FACES_FLIP_DOWN then
        local flat: f64 = math.cos(turn * math.pi)
        if anim.faces == FACES_FLIP_UP then hidden = flat >= 0.0 else hidden = flat < 0.0 end
        width_scale = flat
        if width_scale < 0.0 then width_scale = -width_scale end
    end
    local depth: f64 = math.sin(turn * math.pi)
    local lift: f64 = 1.0 + 0.08 * depth
    graphics:push()
    graphics:translate(
        at.x + card.width * 0.5, at.y + card.height * 0.5 - 8.0 * depth)
    graphics:rotate(anim.angle0 + (anim.angle1 - anim.angle0) * ease)
    graphics:apply_transform(width_scale * lift, 0.0, 0.0, lift, 0.0, 0.0)
    card.draw_at(
        surface, card.look(anim.card, false, false, hidden, false, anim.known),
        -(card.width * 0.5), -(card.height * 0.5))
    graphics:pop()
end

function draw_anims(
    surface: entity.Surface, anims: {Anim}, clock: f64, sheet: card_warp.Mesh
): unit
    for anim in anims do draw_anim_card(surface, anim, clock, sheet) end
end

-- A stronger cubic acceleration/deceleration gives the winner's flight a
-- deliberate launch and a decisive landing, while remaining exactly bounded.
function fly_ease(clock: f64, delay: f64): f64
    local t: f64 = (clock - delay) / FLY_SECONDS
    if t < 0.0 then return 0.0 end
    if t > 1.0 then t = 1.0 end
    return easing.in_out_cubic(t)
end

-- One winner card travelling from its revealed pose (`start`, a card centre)
-- to a flank of the formation (`dest`, a card top-left): the centre lerps, the
-- source tilt unwinds to flat, and the same sin-driven lift the other flights
-- use keeps it airborne in between. ease 0 means the flight has not begun and
-- the card still sits in its row, so nothing is drawn.
function draw_winner_flight(
    surface: entity.Surface, value: game.Card, start: Point, sangle: f64,
    dest: Point, ease: f64, colored: bool
): unit
    if ease <= 0.0 then return end
    local graphics = surface.graphics
    local dest_center: Point = point(
        dest.x + card.width * 0.5, dest.y + card.height * 0.5)
    local at: Point = lerp(start, dest_center, ease)
    local depth: f64 = math.sin(ease * math.pi)
    local lift: f64 = 1.0 + 0.08 * depth
    graphics:push()
    graphics:translate(at.x, at.y - 8.0 * depth)
    graphics:rotate(sangle * (1.0 - ease))
    graphics:apply_transform(lift, 0.0, 0.0, lift, 0.0, 0.0)
    card.draw_at(
        surface, card.look(value, false, false, false, colored, false),
        -(card.width * 0.5), -(card.height * 0.5))
    graphics:pop()
end

-- How far the losing pair has burned, read off the reveal clock alone. The
-- update tick steers the ash emitters from this and the resolution board draws
-- the sheet from it, so the flakes and the front they leave never disagree.
function loss_burn_progress(reveal_clock: f64): f64
    return card_burn.progress_over(
        reveal_clock, WIN_GLOW_START, card_burn.disintegrate_seconds)
end

-- A relic coming apart inside the fan. Past full burn there is no sheet left
-- to capture, only the last flakes falling — and they fall inside the relic's
-- own tilt, the way they did while it was still there.
function draw_hand_disintegration(
    surface: entity.Surface, viewport: layout.State, value: game.Card,
    index: i32, part: f64, count: i32, progress: f64, seed: i32,
    ash: particles.ParticleSystem
): unit
    local graphics = surface.graphics
    local slot: box.Rect = hand_slot(viewport, index, part, count)
    local target: graphics_module.RenderTarget? = nil
    if progress < 1.0 then
        target = card.capture_face(surface, card.plain(value))
    end
    graphics:push()
    graphics:translate(slot.x + card.width * 0.5, slot.y + card.height * 0.5)
    graphics:rotate(hand_fan.angle_at(index, part, count))
    if target == nil then
        card_burn.draw_ash(
            surface, ash,
            -(card.width * 0.5), -(card.height * 0.5) - card.bind_lift, seed + 401)
    else
        local captured: graphics_module.RenderTarget =
            target::graphics_module.RenderTarget
        card_burn.draw_captured(
            surface, captured,
            -(card.width * 0.5), -(card.height * 0.5) - card.bind_lift,
            progress, seed, value.suit, ash)
        graphics:release_render_target(captured)
    end
    graphics:pop()
end

-- ---------------------------------------------------------------------------
-- Spell particles, which the update tick owns and this module tunes.
-- ---------------------------------------------------------------------------

function new_spell_particles(): SpellParticles
    return {
        sparks = spell_launch.new_sparks(),
        grave_dust = powered_card.new_grave_dust(),
    }
end

-- One tick of everything a spell has in the air. The launch seam is given the
-- target in board coordinates, which is the only thing the spell modules cannot
-- work out for themselves; the grave reads the same formation the raised ward
-- is drawn from.
function step_spell_particles(
    spells: SpellParticles, viewport: layout.State,
    kind: i32, clock: f64, target: i32, dt: f64
): unit
    local slot: Point = slot_pos(viewport, SLOT_MIDDLE, target)
    spell_launch.step(
        spells.sparks, kind, clock, dt,
        slot.x + card.width * 0.5, slot.y + card.height * 0.5)
    powered_card.step_grave_dust(
        spells.grave_dust, powered_card.grave_progress(kind, clock), dt)
end

function draw_spell_launch(
    surface: entity.Surface, viewport: layout.State,
    kind: i32, clock: f64, target: i32, sparks: spell_cast.Sparks
): unit
    local slot: Point = slot_pos(viewport, SLOT_MIDDLE, target)
    spell_launch.draw(
        surface.graphics, surface.effects, kind, clock,
        slot.x + card.width * 0.5, slot.y + card.height * 0.5, sparks)
end

-- ---------------------------------------------------------------------------
-- The board, composed.
-- ---------------------------------------------------------------------------

function draw_backdrop(surface: entity.Surface, viewport: layout.State): unit
    backdrop.draw_at(surface, board_rect(viewport))
end

function draw_hud(
    surface: entity.Surface, viewport: layout.State,
    state: game.View, run: run_module.View
): unit
    local band: entity.Node = hud.node(state, run)
    band.paint(surface, header_band(entity.metrics_of(surface), band, viewport))
end

function draw_footer(surface: entity.Surface, viewport: layout.State, state: game.View): unit
    local metrics: entity.Metrics = entity.metrics_of(surface)
    local strip: entity.Node = footer.node(state)
    local bounds: box.Rect = footer_band(metrics, strip, viewport)
    strip.paint(surface, bounds)
    targets.help = footer.help_rect(metrics, state, bounds)
end

function draw_deck(surface: entity.Surface, viewport: layout.State, count: i32): unit
    deck.node(count).paint(surface, deck_band(viewport))
end

-- How many of a pile's cards have actually arrived: the ledger's total minus
-- every card still flying a leg that lands on that pile, so the stack only
-- thickens when a card visibly reaches it. The feint's aside legs pass the burn
-- anchor as a waypoint, but they carry dest_kind -1 and stay uncounted.
function pile_landed(cards: {game.Card}, anims: {Anim}, clock: f64, dest_kind: i32): i32
    local pending: i32 = 0
    for anim in anims do
        if anim.dest_kind == dest_kind and clock < anim.vanish then pending += 1 end
    end
    return #cards - pending
end

function draw_pile(
    surface: entity.Surface, viewport: layout.State,
    cards: {game.Card}, count: i32, kind: i32
): unit
    local slot: Point = slot_pos(viewport, kind, 0)
    pile.node(cards, count).paint(
        surface, entity.rect(slot.x, slot.y, card.width, card.height))
end

-- Draws whichever of the three right-edge piles hold cards.
function draw_piles(
    surface: entity.Surface, viewport: layout.State,
    discards: {game.Card}, discard_count: i32,
    computer_won: {game.Card}, computer_won_count: i32,
    player_won: {game.Card}, player_won_count: i32
): unit
    draw_pile(surface, viewport, computer_won, computer_won_count, SLOT_COMPUTER_WON)
    draw_pile(surface, viewport, discards, discard_count, SLOT_ASIDE)
    draw_pile(surface, viewport, player_won, player_won_count, SLOT_PLAYER_WON)
end

-- One slot of the middle row, powered or plain. A ward at rest is face up for
-- both sides to read, so it never carries an eye: the mark only says something
-- about a hand.
function ward_node(frame: Frame, value: game.Card, index: i32, selected: bool, focused: bool, colored: bool): entity.Node
    local look: card.Look = card.look(value, selected, focused, false, colored, false)
    if index == frame.spell.target then
        return powered_card.node(
            look, frame.spell.kind, frame.spell.clock, frame.ash,
            frame.spells.grave_dust)
    end
    return card.node(look)
end

function trick_scoring(trick: game.Trick): {bool}
    if trick.winner == 0 then return { false, false, false, false, false } end
    local winner: game.TrickSide = game.trick_side(trick, trick.winner)
    local loser: game.TrickSide = game.trick_side(trick, -trick.winner)
    return game.scoring_cards(
        { trick.middle[0], trick.middle[1], trick.middle[2], winner.cards[0], winner.cards[1] },
        winner.value, loser.value)
end

-- The three wards on their field: a panel, and the row of slots standing on
-- it. Both take the same band, so the field is always exactly as wide as the
-- row it backs.
function draw_ward_band(surface: entity.Surface, viewport: layout.State, slots: {entity.Node}): unit
    local band: box.Rect = ward_band(viewport, #slots)
    ward_panel.node().paint(surface, band)
    card_row.node(slots, card_row.flat_pitch).paint(surface, band)
end

function draw_resolution_board(surface: entity.Surface, frame: Frame): unit
    local graphics = surface.graphics
    local viewport: layout.State = frame.viewport
    local state: game.View = frame.view
    local fan_parts: {f64} = frame.motion.fan_parts
    local reveal_clock: f64 = frame.motion.reveal_clock
    local discards: {game.Card} = frame.piles.discards
    local trick: game.Trick = state.history[#state.history - 1]
    -- The reveal shows the hands as they were played, so the rows keep the
    -- trick's layout even though a boss battle's live hands have already
    -- shrunk underneath it.
    local hand_count: i32 = #trick.player_hand
    draw_hud(surface, viewport, state, frame.run)
    draw_deck(surface, viewport, state.deck_count)
    local scoring: {bool} = trick_scoring(trick)
    -- Flight progress for the winner's two cards; a stalemate has no winner,
    -- so nothing takes off and both played pairs stay where they revealed.
    local fly0: f64 = 0.0
    local fly1: f64 = 0.0
    if trick.winner ~= 0 then
        fly0 = fly_ease(reveal_clock, FLY_START)
        fly1 = fly_ease(reveal_clock, FLY_START + FLY_STAGGER)
    end
    -- The shimmer waits for the second card to land, then ramps to full.
    -- reveal_clock holds at its cap once the reveal is over, so the settled
    -- shimmer stays live instead of resetting. A stalemate completes no
    -- formation, so nothing ignites.
    local glow: f64 = 0.0
    local lift_progress: f64 = 0.0
    local loss_progress: f64 = 0.0
    if trick.winner ~= 0 then
        local glow_time: f64 = easing.clamp01(
            (reveal_clock - WIN_GLOW_START) / WIN_GLOW_FADE)
        glow = easing.out_quint(glow_time)
        lift_progress = easing.out_back(glow_time)
        loss_progress = loss_burn_progress(reveal_clock)
    end
    -- The won piles are settled here — this trick joins its winner's pile only
    -- once play advances and the scoop carries it there. The losing pair is
    -- already in the ledger too, but remains visibly absent until advancing
    -- the result rebuilds both cards from ash directly on the neutral pile.
    local burn_landed: i32 = #discards
    if trick.winner ~= 0 then burn_landed -= 2 end
    draw_piles(
        surface, viewport, discards, burn_landed,
        frame.piles.computer_won, #frame.piles.computer_won,
        frame.piles.player_won, #frame.piles.player_won)
    if trick.winner > 0 then
        centered_line(
            surface, viewport,
            "DEFENSE BREACHED +" .. tostring(trick.points),
            HEADLINE_TOP + HEADLINE_SIZE, HEADLINE_SIZE, "#67e8f9")
    elseif trick.winner < 0 then
        centered_line(
            surface, viewport, "THE WARDS HOLD",
            HEADLINE_TOP + HEADLINE_SIZE, HEADLINE_SIZE, "#fca5a5")
    else
        centered_line(
            surface, viewport, "MAGICS CANCEL",
            HEADLINE_TOP + HEADLINE_SIZE, HEADLINE_SIZE, "#fbbf24")
    end
    centered_line(
        surface, viewport,
        game.category_name(trick.player_value) .. "  VS  "
            .. game.category_name(trick.computer_value),
        viewport.ward_y - PROMPT_RISE, PROMPT_SIZE, PROMPT_INK)

    -- The played Arch Mage cards flip in their original slots, then fly to
    -- the formation if the wards held; a slot goes empty the moment its card
    -- takes off. Everything else stays sealed, so only the winning formation
    -- gains suit color.
    for i = 0::i32, #trick.computer_hand - 1 do
        local slot: Point = slot_pos_at(viewport, SLOT_COMPUTER, i, hand_count)
        if i == trick.computer_first then
            if trick.winner >= 0 or fly0 <= 0.0 then
                if trick.winner > 0 and loss_progress > 0.0 then
                    card_burn.draw_disintegrating(
                        surface, card.plain(trick.computer_cards[0]),
                        slot.x, slot.y, loss_progress, 11, frame.ash.reveal_first)
                else
                    draw_flipping_card(
                        surface, trick.computer_cards[0], slot.x, slot.y,
                        reveal_clock, 0.2, trick.winner < 0 and scoring[3])
                end
            end
        elseif i == trick.computer_second then
            if trick.winner >= 0 or fly1 <= 0.0 then
                if trick.winner > 0 and loss_progress > 0.0 then
                    card_burn.draw_disintegrating(
                        surface, card.plain(trick.computer_cards[1]),
                        slot.x, slot.y, loss_progress, 29, frame.ash.reveal_second)
                else
                    draw_flipping_card(
                        surface, trick.computer_cards[1], slot.x, slot.y,
                        reveal_clock, 0.2 + FLIP_SECONDS * 0.7,
                        trick.winner < 0 and scoring[4])
                end
            end
        else
            card.draw_at(
                surface,
                card.sealed(trick.computer_hand[i].card, trick.computer_hand[i].known),
                slot.x, slot.y)
        end
    end

    -- The panel marks the landing zone, sized for the whole formation. Before
    -- the halo ignites, the three wards remain part of this ordinary table
    -- layer; once the formation is complete, they move into the foreground
    -- layer with the winning pair.
    local formation: box.Rect = ward_band(viewport, FORMATION_SLOTS)
    ward_panel.node().paint(surface, formation)
    if glow <= 0.0 then
        for i = 0::i32, 2::i32 do
            ward_node(
                frame, trick.middle[i], i, false, false,
                trick.winner ~= 0 and scoring[i]
            ).paint(surface, row_slot(viewport, 3, i))
        end
    end

    centered_line(
        surface, viewport, "CLICK OR ENTER CONTINUES",
        viewport.action_y + CONTINUE_DROP, 12, "#fbbf24")
    -- The cursor is not live while a breach resolves, so the fan is already
    -- easing shut; it settles closed behind the flips. The committed relics
    -- stay bound and lifted until their flight begins, so it stays clear
    -- which cards faced the Arch Mage; after takeoff their fan slots simply
    -- stand empty, the way a spent relic's would.
    local fan: box.Rect = fan_band(viewport, hand_count)
    for i = 0::i32, #trick.player_hand - 1 do
        if i == trick.player_first then
            if trick.winner <= 0 or fly0 <= 0.0 then
                if trick.winner < 0 and loss_progress > 0.0 then
                    draw_hand_disintegration(
                        surface, viewport, trick.player_cards[0], i, fan_parts[i],
                        hand_count, loss_progress, 47, frame.ash.reveal_first)
                else
                    hand_fan.draw_slot(
                        surface,
                        card.look(
                            trick.player_cards[0], true, false, false,
                            trick.winner > 0 and scoring[3], false),
                        fan, i, fan_parts[i], hand_count)
                end
            end
        elseif i == trick.player_second then
            if trick.winner <= 0 or fly1 <= 0.0 then
                if trick.winner < 0 and loss_progress > 0.0 then
                    draw_hand_disintegration(
                        surface, viewport, trick.player_cards[1], i, fan_parts[i],
                        hand_count, loss_progress, 71, frame.ash.reveal_second)
                else
                    hand_fan.draw_slot(
                        surface,
                        card.look(
                            trick.player_cards[1], true, false, false,
                            trick.winner > 0 and scoring[4], false),
                        fan, i, fan_parts[i], hand_count)
                end
            end
        else
            hand_fan.draw_slot(
                surface,
                card.sealed(trick.player_hand[i].card, trick.player_hand[i].known),
                fan, i, fan_parts[i], hand_count)
        end
    end
    draw_footer(surface, viewport, state)

    -- Once complete, the entire winning formation becomes a foreground layer:
    -- it eases toward the viewer around its shared centre, rises slightly, and
    -- draws after every remaining UI element. The larger halo shares this
    -- transform, so its beams and rings can wash over the table while the five
    -- cards remain crisp on top of it.
    local foreground: bool = glow > 0.0
    if foreground then
        local scale: f64 = 1.0 + (WIN_LIFT_SCALE - 1.0) * lift_progress
        local center_x: f64 = formation.x + formation.width * 0.5
        local center_y: f64 = formation.y + card.height * 0.5
        graphics:push()
        graphics:translate(center_x, center_y - WIN_LIFT_Y * lift_progress)
        graphics:apply_transform(scale, 0.0, 0.0, scale, 0.0, 0.0)
        graphics:translate(-center_x, -center_y)
        draw_result_field(surface, formation, glow, trick.winner > 0)
        for i = 0::i32, 2::i32 do
            ward_node(frame, trick.middle[i], i, false, false, scoring[i])
                .paint(surface, row_slot(viewport, 3, i))
        end
    end

    -- The winner's pair sails over whatever it passes, then joins the same
    -- transformed foreground layer as the wards. The fan pose folds the bind
    -- lift into the start centre — rotate the lift by the relic's tilt — so
    -- takeoff continues the lift instead of snapping back down to the slot.
    if trick.winner < 0 then
        draw_winner_flight(
            surface, trick.computer_cards[0],
            slot_center(viewport, SLOT_COMPUTER, trick.computer_first, hand_count),
            0.0, row_left(viewport), fly0, scoring[3])
        draw_winner_flight(
            surface, trick.computer_cards[1],
            slot_center(viewport, SLOT_COMPUTER, trick.computer_second, hand_count),
            0.0, row_right(viewport), fly1, scoring[4])
    elseif trick.winner > 0 then
        local angle0: f64 = hand_fan.angle_at(
            trick.player_first, fan_parts[trick.player_first], hand_count)
        local angle1: f64 = hand_fan.angle_at(
            trick.player_second, fan_parts[trick.player_second], hand_count)
        draw_winner_flight(
            surface, trick.player_cards[0],
            bound_hand_center(
                viewport, trick.player_first, fan_parts[trick.player_first], hand_count),
            angle0, row_left(viewport), fly0, scoring[3])
        draw_winner_flight(
            surface, trick.player_cards[1],
            bound_hand_center(
                viewport, trick.player_second, fan_parts[trick.player_second], hand_count),
            angle1, row_right(viewport), fly1, scoring[4])
    end
    if foreground then graphics:pop() end
    draw_spell_launch(
        surface, viewport, frame.spell.kind, frame.spell.clock,
        frame.spell.target, frame.spells.sparks)
end

-- The Arch Mage's sealed row. Slots claimed by an in-flight card stay empty
-- until it lands, so the already-updated game state cannot leak ahead of the
-- animation.
function draw_computer_row(surface: entity.Surface, frame: Frame): unit
    local state: game.View = frame.view
    local hidden: {bool} = hidden_slots(
        frame.motion.anims, frame.motion.anim_clock, SLOT_COMPUTER,
        #state.computer_hand)
    local slots: {entity.Node} = {}
    for i = 0::i32, #state.computer_hand - 1 do
        if hidden[i] then
            table.insert(slots, entity.sized(
                card.width, card.height,
                function(surface: entity.Surface, bounds: box.Rect): unit end))
        else
            table.insert(slots, card.node(card.sealed(
                state.computer_hand[i].card, state.computer_hand[i].known)))
        end
    end
    card_row.node(slots, card_row.flat_pitch).paint(
        surface, computer_band(frame.viewport))
end

-- The player's fan, with the binds and the cursor the screen is holding.
function draw_player_fan(surface: entity.Surface, frame: Frame): unit
    local state: game.View = frame.view
    local interaction: Interaction = frame.interaction
    local looks: {card.Look} = {}
    for i = 0::i32, #state.player_hand - 1 do
        local selected: bool = is_picked(interaction.play_picks, i)
        if state.swap_open then selected = is_picked(interaction.swap_hand, i) end
        table.insert(looks, card.look(
            state.player_hand[i].card, selected, i == interaction.hand_focus,
            false, false, state.player_hand[i].known))
    end
    hand_fan.node(
        looks, frame.motion.fan_parts,
        hidden_slots(
            frame.motion.anims, frame.motion.anim_clock, SLOT_PLAYER, #looks)
    ).paint(surface, fan_band(frame.viewport, #looks))
end

-- Draw the controls of the band and remember where they landed, in the order
-- the band offers them: commit first, then pass.
function draw_actions(
    surface: entity.Surface, actions: {action_bar.Action}, band: box.Rect
): unit
    action_bar.node(actions).paint(surface, band)
    local rects: {box.Rect} = entity.place(
        entity.metrics_of(surface), action_bar.capsules(actions),
        action_bar.bar_style(), band)
    targets.commit = rects[0]
    if #rects > 1 then targets.pass = rects[1] end
end

-- What the board is asking for, and the controls it is asking with.
function draw_action_band(surface: entity.Surface, frame: Frame): unit
    local viewport: layout.State = frame.viewport
    local state: game.View = frame.view
    local interaction: Interaction = frame.interaction
    local band: box.Rect = action_band(viewport)
    if interaction.casting then
        -- Target selection replaces the phase prompts and commit capsules:
        -- nothing else accepts input until the cast lands or is called off. The
        -- prompt names the spell whose key opened targeting, at its own price.
        local aimed: game.Spell = state.spells[interaction.cast_slot]
        centered_line(
            surface, viewport,
            "AIM " .. spell_launch.name(aimed.kind) .. " AT A WARD",
            viewport.ward_y - PROMPT_RISE, PROMPT_SIZE,
            spell_launch.color(aimed.kind))
        action_bar.prompt(
            "ARROWS MOVE   ENTER CASTS " .. tostring(aimed.cost)
                .. " MANA   ESC CANCELS"
        ).paint(surface, entity.rect(
            band.x, viewport.action_y + PROMPT_DROP - action_bar.prompt_size,
            band.width, action_bar.prompt_size))
        return
    end
    if state.swap_open then
        centered_line(
            surface, viewport, "FEINT: BIND MATCHING RELICS + WARDS",
            viewport.ward_y - PROMPT_RISE, PROMPT_SIZE, "#fbbf24")
        -- Mirrors the screen's submit rule so the capsule only lights up when
        -- a commit would actually be accepted.
        local available: bool = true
        for ward in interaction.swap_wards do
            if state.frozen_middle[ward] then available = false end
        end
        local balanced: bool = available
            and #interaction.swap_hand == #interaction.swap_wards
            and #interaction.swap_hand <= state.player_points
        draw_actions(surface, {
            action_bar.action("COMMIT FEINT", balanced),
            action_bar.action("PASS", true),
        }, band)
        return
    end
    if #interaction.play_picks == 2 then
        local preview: i32 = game.value_for_pair(
            game.hand_cards(state.player_hand), state.middle,
            interaction.play_picks[0], interaction.play_picks[1])
        centered_line(
            surface, viewport, "OFFER: " .. game.category_name(preview),
            viewport.ward_y - PROMPT_RISE, PROMPT_SIZE, PROMPT_INK)
        draw_actions(
            surface, { action_bar.action("COMMIT BREACH", true) }, band)
        return
    end
    action_bar.prompt("BREACH: BIND TWO RELICS").paint(surface, entity.rect(
        band.x, viewport.action_y + PROMPT_DROP - action_bar.prompt_size,
        band.width, action_bar.prompt_size))
end

function draw_playfield(surface: entity.Surface, frame: Frame): unit
    local viewport: layout.State = frame.viewport
    local state: game.View = frame.view
    local anims: {Anim} = frame.motion.anims
    local anim_clock: f64 = frame.motion.anim_clock
    if frame.interaction.revealing and #state.history > 0 then
        draw_resolution_board(surface, frame)
        return
    end
    draw_hud(surface, viewport, state, frame.run)
    draw_deck(surface, viewport, state.deck_count)
    draw_piles(
        surface, viewport,
        frame.piles.discards,
        pile_landed(frame.piles.discards, anims, anim_clock, SLOT_ASIDE),
        frame.piles.computer_won,
        pile_landed(frame.piles.computer_won, anims, anim_clock, SLOT_COMPUTER_WON),
        frame.piles.player_won,
        pile_landed(frame.piles.player_won, anims, anim_clock, SLOT_PLAYER_WON))
    draw_computer_row(surface, frame)

    local ward_hidden: {bool} = hidden_slots(
        anims, anim_clock, SLOT_MIDDLE, #state.middle)
    local slots: {entity.Node} = {}
    for i = 0::i32, #state.middle - 1 do
        if ward_hidden[i] then
            table.insert(slots, entity.sized(
                card.width, card.height,
                function(surface: entity.Surface, bounds: box.Rect): unit end))
        else
            local selected: bool = state.swap_open
                and is_picked(frame.interaction.swap_wards, i)
            -- Targeting a cast borrows the ward focus ring for its aim cursor,
            -- whichever phase the board is in.
            local focused: bool = (state.swap_open
                and frame.interaction.cursor_area == 1
                and frame.interaction.ward_cursor == i)
                or (frame.interaction.casting and frame.interaction.ward_cursor == i)
            table.insert(
                slots, ward_node(frame, state.middle[i], i, selected, focused, false))
        end
    end
    draw_ward_band(surface, viewport, slots)

    draw_action_band(surface, frame)
    draw_player_fan(surface, frame)
    draw_footer(surface, viewport, state)
    draw_anims(surface, anims, anim_clock, frame.sheet)
    draw_spell_launch(
        surface, viewport, frame.spell.kind, frame.spell.clock,
        frame.spell.target, frame.spells.sparks)
end

function draw_help(surface: entity.Surface, viewport: layout.State): unit
    modal.show(surface, board_rect(viewport), help_card.node())
end

function draw_history(surface: entity.Surface, viewport: layout.State, state: game.View): unit
    modal.show(surface, board_rect(viewport), ledger.node(state))
end

function draw_final(
    surface: entity.Surface, viewport: layout.State,
    state: game.View, run: run_module.View
): unit
    modal.show(surface, board_rect(viewport), verdict.node(state, run))
end

function draw(surface: entity.Surface, frame: Frame): unit
    local viewport: layout.State = frame.viewport
    local state: game.View = frame.view
    local modal_kind: i32 = frame.interaction.modal
    -- Every control the pointer can reach is recorded by the paint that draws
    -- it, so a frame starts with nothing clickable on it.
    clear_targets()
    draw_backdrop(surface, viewport)
    -- The terminal breach still flips on the board, so keep the playfield up
    -- while a reveal is running even after the game finishes.
    if not state.finished or frame.interaction.revealing then
        draw_playfield(surface, frame)
    else
        draw_hud(surface, viewport, state, frame.run)
    end
    if modal_kind == MODAL_HISTORY then draw_history(surface, viewport, state)
    elseif modal_kind == MODAL_HELP then draw_help(surface, viewport)
    elseif modal_kind == MODAL_FINAL then draw_final(surface, viewport, state, frame.run) end
end

function draw_shader_error(surface: entity.Surface, viewport: layout.State, detail: string): unit
    draw_backdrop(surface, viewport)
    local graphics = surface.graphics
    local top: f64 = viewport.center_y - 130.0
    ink.panel(graphics, 90.0, top, viewport.width - 180.0, 260.0, "#220016", "#ff00ff")
    centered_line(
        surface, viewport, "SHADER COMPILATION FAILED", top + 65.0, 21, "#ff66ff")
    centered_line(
        surface, viewport, "THE RESULT EFFECT IS REQUIRED", top + 112.0, 13, "#f8fafc")
    ink.text(graphics, detail, 125.0, top + 170.0, 11, "#fecdd3")
end

function draw_audio_error(
    surface: entity.Surface, viewport: layout.State,
    path: string, code: string, detail: string
): unit
    draw_backdrop(surface, viewport)
    local graphics = surface.graphics
    local top: f64 = viewport.center_y - 165.0
    ink.panel(graphics, 70.0, top, viewport.width - 140.0, 330.0, "#260b08", "#fb7185")
    centered_line(
        surface, viewport, "REQUIRED SOUND EFFECT FAILED", top + 70.0, 21, "#fb7185")
    centered_line(
        surface, viewport, "ANTE MAGIC HAS STOPPED", top + 113.0, 13, "#f8fafc")
    ink.text(graphics, "ASSET: " .. path, 105.0, top + 175.0, 11, "#fecdd3")
    ink.text(graphics, "CODE: " .. code, 105.0, top + 207.0, 11, "#fecdd3")
    ink.text(graphics, "HOST: " .. detail, 105.0, top + 239.0, 11, "#fecdd3")
    ink.text(
        graphics, "CHECK THE TYPED ASSET MANIFEST AND BROWSER AUDIO HOST.",
        105.0, top + 286.0, 10, "#fda4af")
end

return {
    draw = draw,
    draw_shader_error = draw_shader_error,
    draw_audio_error = draw_audio_error,
    draw_backdrop = draw_backdrop,
    draw_help = draw_help,
    -- One relic turning over, which is the board's own flip and the storybook's.
    draw_flipping_card = draw_flipping_card,
    -- The band the player's hand is dealt into, so a story can run the real
    -- measure-then-arrange pipeline instead of a copy of it.
    fan_band = fan_band,
    -- Where the board puts things, which is what an animation aims at.
    point = point,
    midpoint = midpoint,
    slot_pos = slot_pos,
    slot_pos_at = slot_pos_at,
    slot_center = slot_center,
    hand_angle_at = hand_angle_at,
    hand_pos_at = hand_pos_at,
    hand_part_target = hand_part_target,
    row_left = row_left,
    row_right = row_right,
    -- Pointer hits, each answered from the rectangle its entity was painted in.
    hit_hand = hit_hand,
    hit_ward = hit_ward,
    hit_commit = hit_commit,
    hit_pass = hit_pass,
    hit_help = hit_help,
    -- The board anchor, face-mode, and easing vocabulary Anim records use.
    -- Declared once here so choreography builds animations against the same
    -- ids this module interprets, instead of mirroring the integers.
    slot_player = SLOT_PLAYER,
    slot_computer = SLOT_COMPUTER,
    slot_middle = SLOT_MIDDLE,
    slot_deck = SLOT_DECK,
    slot_aside = SLOT_ASIDE,
    slot_computer_won = SLOT_COMPUTER_WON,
    slot_player_won = SLOT_PLAYER_WON,
    faces_down = FACES_DOWN,
    faces_up = FACES_UP,
    faces_flip_up = FACES_FLIP_UP,
    faces_flip_down = FACES_FLIP_DOWN,
    ease_out_quint = EASE_OUT_QUINT,
    ease_in_cubic = EASE_IN_CUBIC,
    ease_in_out_cubic = EASE_IN_OUT_CUBIC,
    ease_out_back = EASE_OUT_BACK,
    anim_effect_move = ANIM_EFFECT_MOVE,
    anim_effect_ash_reappear = ANIM_EFFECT_ASH_REAPPEAR,
    anim_effect_throw = ANIM_EFFECT_THROW,
    -- The reveal's own burn reading, and the spell clocks the screen steers by.
    loss_burn_progress = loss_burn_progress,
    firebolt_burn_finished = powered_card.firebolt_burn_finished,
    fireball_formation = powered_card.fireball_formation,
    power_settled_clock = powered_card.settled_clock,
    -- The ash emitters choreography owns and ticks.
    new_card_ash = card_burn.new_card_ash,
    step_reveal_ash = card_burn.step_sheet_ash,
    step_ward_ash = card_burn.step_ward_ash,
    -- A spell's own emitters, on the same terms: choreography holds them and
    -- ticks them, and everything about how they look, where the carrier is, and
    -- where the board puts the target lives on this side.
    new_spell_particles = new_spell_particles,
    step_spell_particles = step_spell_particles,
}
