-- DOM-free effects for items bought between duels. The shop decides which
-- items appear, what they cost, and whether a selection can be made; an Item
-- only knows what happens when that selection is committed.
--
-- `UseState` is deliberately the whole mutable run plus the destination the
-- shop selected. That small interface is enough for effects which change the
-- purse or health directly and for effects which add, replace, or alter a
-- spell. Adding another effect does not add another purchase branch to the
-- shop.

local run_module = require("./run")
local spells = require("./spells/spell")

export type UseState = { run: run_module.State, key: i32 }

-- A bought item has one operation. Independently constructed effects all cross
-- this same method seam, including effects authored in tests or in future stock
-- categories.
export type Item = { effect: (UseState) -> unit }

function Item.new(effect: (UseState) -> unit): Item
    return { effect = effect }
end

function Item:use(state: UseState): unit
    self.effect(state)
end

-- Take one gold off the named spell's cast. The shop has already established
-- that the spell is still carried and has room to become cheaper.
function Item.sharpen(kind: spells.SpellKind): Item
    return Item.new(function(state: UseState): unit
        state.run:upgrade(state.run:slot_of(kind))
    end)
end

-- Add the named spell at the destination chosen by the shop. That destination
-- is either the next open key or the carried spell the player chose to trade.
function Item.learn(kind: spells.SpellKind): Item
    return Item.new(function(state: UseState): unit
        state.run:learn(kind, state.key)
    end)
end

