-- Ante's entity-story boundary. A story supplies one entity; this module owns the
-- canvas, presentation resources, and the flex stage that places that entity.
-- The stage authors no size for its child. It gives the entity the whole
-- logical canvas as available space and lets the entity's intrinsic
-- measurement plus grow/shrink factors decide the rectangle it receives.
local engine = require("waluau:engine")
local storybook = require("waluau:engine/storybook")
local entity = require("./entities/adapter")
local presentation_resources = require("./presentation_resources")

export type Book = { assets: presentation_resources.State, started: bool }

type Scene = {
    node: () -> entity.Node,
    present: (() -> unit)?,
    width: f64,
    height: f64,
    scale: f64,
    background: string,
    load: (() -> unit)?,
    update: ((f64, engine.Input) -> unit)?,
    keypressed: ((string) -> unit)?,
    keyreleased: ((string) -> unit)?,
    mousepressed: ((f64, f64, i32) -> unit)?,
    mousereleased: ((f64, f64, i32) -> unit)?,
    mousemoved: ((f64, f64, f64, f64) -> unit)?
}

function Book.new(): Book
    return { assets = presentation_resources.State.new(), started = false }
end

function Book:load_assets(): i32
    return self.assets:load_async()
end

function Book:prepare(): unit
    if self.started then
        return
    end
    self.started = true
    local loader: thread = coroutine.create(
        function(): i32
            return self:load_assets()
        end
    )
    coroutine.resume(loader)
end

-- A one-child row is the story's flex container. With centre justification
-- and alignment, unused room surrounds the subject. The direct child keeps
-- its own flex factors, so available width is distributed through the same
-- layout path the entity uses on the live board.
function stage(node: entity.Node): entity.Node
    return entity.Node.across({ justify = "center", align = "center" }, {node})
end

function Book:scene(spec: Scene): storybook.Scene
    assert(spec.width > 0.0 and spec.height > 0.0 and spec.scale > 0.0)

    local function load(): unit
        self:prepare()
        local hook: (() -> unit)? = spec.load
        if hook ~= nil then
            hook()
        end
    end

    -- Construct the subject and stage once. Story controls update presentation
    -- through `present`; drawing only remeasures, arranges, and paints this tree.
    local root: entity.Node = stage(spec.node())

    local function draw(graphics: engine.Graphics, alpha: f64): unit
        self.assets:prepare(graphics)
        local present: (() -> unit)? = spec.present
        if present ~= nil then present() end
        local surface = self.assets:surface(graphics)
        graphics:push()
        graphics:scale(spec.scale, spec.scale)
        root.paint(surface, {
            x = 0.0,
            y = 0.0,
            width = graphics.width / spec.scale,
            height = graphics.height / spec.scale,
        })
        graphics:pop()
    end

    return {
        draw = draw,
        load = load,
        update = spec.update,
        keypressed = spec.keypressed,
        keyreleased = spec.keyreleased,
        mousepressed = spec.mousepressed,
        mousereleased = spec.mousereleased,
        mousemoved = spec.mousemoved,
        width = (spec.width * spec.scale)::u32,
        height = (spec.height * spec.scale)::u32,
        background = spec.background
    }
end

return { stage = stage }
