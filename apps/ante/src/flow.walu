-- DOM-free duel flow. Keyboard and mouse arrive as plain intents here;
-- phase ordering, action acceptance, focus, pending binds, and development
-- snapshot ownership live here.
-- A non-nil `cast_slot` is the spell-targeting mode: entered by a cast key, it
-- confines retained UI focus to the table-card row until the player confirms
-- or cancels. While it holds, ordinary binding input is suspended. Its value is
-- the loadout slot being aimed — one cast key per slot.
type Modal = "none" | "history" | "help" | "final"
export type Command = "none" | "advance" | "restart" | "history" | "help" | "primary"
-- What `gate` decided about an input. "live" is the only result that permits
-- an adapter to interpret board-specific input. "advance" means the verdict
-- is up and the player asked for what comes next; which duel that is — the
-- next duel of the run, or the first duel of a fresh one — is the run's
-- decision, not this module's.
export type GateResult = "live" | "consumed" | "reset" | "refill" | "skip" | "finish-reveal" | "advance"
export type State = {
    play_picks: {i32},
    swap_hand: {i32},
    swap_table_cards: {i32},
    modal: Modal,
    revealing: bool,
    cast_slot: i32?
}

const UI_SNAPSHOT_SCHEMA: string = "duel-flow-v7"

function State.new(): State
    return {
        play_picks = {},
        swap_hand = {},
        swap_table_cards = {},
        modal = "none",
        revealing = false,
        cast_slot = nil
    }
end

function toggle(picks: {i32}, value: i32, limit: i32): unit
    for index, pick in picks do
        if pick == value then
            table.remove(picks, index + 1)
            return
        end
    end
    if #picks < limit then
        table.insert(picks, value)
    end
end

function State:clear_picks(): unit
    self.play_picks = {}
    self.swap_hand = {}
    self.swap_table_cards = {}
end

function State:reset(): unit
    local fresh: State = State.new()
    self.play_picks = fresh.play_picks
    self.swap_hand = fresh.swap_hand
    self.swap_table_cards = fresh.swap_table_cards
    self.modal = fresh.modal
    self.revealing = fresh.revealing
    self.cast_slot = fresh.cast_slot
end

function State:begin_reveal(): unit
    self:clear_picks()
    self.modal = "none"
    self.revealing = true
    self.cast_slot = nil
end

function State:apply_hand_order(order: {i32}): unit
    local old_to_new: {i32} = {}
    for _ in order do
        table.insert(old_to_new, 0)
    end
    for new_slot, old_slot in order do
        old_to_new[old_slot] = new_slot
    end
    for index, pick in self.play_picks do
        self.play_picks[index] = old_to_new[pick]
    end
    for index, pick in self.swap_hand do
        self.swap_hand[index] = old_to_new[pick]
    end
end

-- Closing a modal returns to whatever is underneath it: the live board, or the
-- verdict when the duel has already been settled. A ledger opened over the
-- verdict must not close onto a finished board, which has no way on.
function State:close_modal(finished: bool): unit
    if finished then
        self.modal = "final"
    else
        self.modal = "none"
    end
end

-- Enforce the same phase ordering for every input adapter.
function State:gate(
    finished: bool,
    animating: bool,
    reveal_finished: bool,
    command: Command
): GateResult
    if self.revealing then
        if command == "restart" then
            return "reset"
        end
        if command == "advance" or command == "primary" then
            if not reveal_finished then
                return "finish-reveal"
            end
            self.revealing = false
            if finished then
                self.modal = "final"
            else
                return "refill"
            end
        end
        return "consumed"
    end

    if command == "restart" then
        return "reset"
    end
    if command == "history" then
        if self.modal == "history" then
            self:close_modal(finished)
        else
            self.modal = "history"
        end
        return "consumed"
    end
    if command == "help" then
        if self.modal == "help" then
            self:close_modal(finished)
        else
            self.modal = "help"
        end
        return "consumed"
    end

    -- The verdict is the one modal that does not simply close: dismissing it
    -- is asking for the next duel, so it answers to the same advance gesture
    -- every other screen uses as well as to a click.
    if self.modal == "final" then
        if command == "advance" or command == "primary" then
            return "advance"
        end
        return "consumed"
    end
    if self.modal ~= "none" then
        if command == "advance" or command == "primary" then
            self:close_modal(finished)
        end
        return "consumed"
    end
    if animating then
        if command == "advance" or command == "primary" then
            return "skip"
        end
        return "consumed"
    end
    return "live"
end

-- Development snapshots ride the built-in JSON codec. The wrapper record
-- carries the schema marker, and unpacking already validates the shape.
-- Literal-union fields decode as plain strings, so the modal domain is checked
-- by restore itself.
type Snapshot = { schema: string, state: State }

function State:snapshot(): string
    local payload: Snapshot = { schema = UI_SNAPSHOT_SCHEMA, state = self }
    return json.pack(payload)
end

function State.restore(snapshot_value: string): State?
    local decoded = json.unpack<Snapshot>(snapshot_value)
    if decoded == nil then
        return nil
    end
    if decoded.schema ~= UI_SNAPSHOT_SCHEMA then
        return nil
    end
    local restored: State = decoded.state
    -- An unknown modal is another build's payload.
    if restored.modal ~= "none" and restored.modal ~= "history" and restored.modal ~= "help" and restored.modal ~= "final" then
        return nil
    end
    -- The slot being aimed is a cast key, never negative. Whether the
    -- restored loadout has a spell under that key is the screen module's
    -- cross-check, since only it sees both halves.
    if (restored.cast_slot or 0) < 0 then
        return nil
    end
    return restored
end

return { toggle = toggle }
