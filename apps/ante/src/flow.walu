-- DOM-free duel flow. Keyboard and mouse arrive as plain intents here;
-- phase ordering, action acceptance, focus, pending binds, and development
-- snapshot ownership live here.

-- A non-nil `cast_slot` is the spell-targeting mode: entered by a cast key, it points
-- table_card_cursor at the table_card the spell would hit until the player confirms or
-- cancels. While it holds, ordinary binding input is suspended. Its value is
-- the loadout slot being aimed — one cast key per slot.
type Modal = "none" | "history" | "help" | "final"
export type Command = "none" | "advance" | "restart" | "history" | "help" | "primary"
-- What `gate` decided about an input. "live" is the only result that permits
-- an adapter to interpret board-specific input. "advance" means the verdict
-- is up and the player asked for what comes next; which duel that is — the
-- next duel of the run, or the first duel of a fresh one — is the run's
-- decision, not this module's.
export type GateResult =
    "live" | "consumed" | "reset" | "refill" | "skip" | "finish-reveal" | "advance"
type CursorArea = "hand" | "table-cards"

export type State = {
    hand_cursor: i32,
    table_card_cursor: i32,
    cursor_area: CursorArea,
    play_picks: {i32},
    swap_hand: {i32},
    swap_table_cards: {i32},
    modal: Modal,
    revealing: bool,
    cast_slot: i32?
}

const FAN_CLOSED: i32 = -1
const UI_SNAPSHOT_SCHEMA: string = "duel-flow-v6"

function new(): State
    return {
        hand_cursor = 0,
        table_card_cursor = 0,
        cursor_area = "hand",
        play_picks = {},
        swap_hand = {},
        swap_table_cards = {},
        modal = "none",
        revealing = false,
        cast_slot = nil,
    }
end

function toggle(picks: {i32}, value: i32, limit: i32): unit
    for index, pick in picks do
        if pick == value then
            table.remove(picks, index)
            return
        end
    end
    if #picks < limit then table.insert(picks, value) end
end

function clear_picks(state: State): unit
    state.play_picks = {}
    state.swap_hand = {}
    state.swap_table_cards = {}
    state.cursor_area = "hand"
    state.hand_cursor = 0
    state.table_card_cursor = 0
end

function reset(state: State): unit
    local fresh: State = new()
    state.hand_cursor = fresh.hand_cursor
    state.table_card_cursor = fresh.table_card_cursor
    state.cursor_area = fresh.cursor_area
    state.play_picks = fresh.play_picks
    state.swap_hand = fresh.swap_hand
    state.swap_table_cards = fresh.swap_table_cards
    state.modal = fresh.modal
    state.revealing = fresh.revealing
    state.cast_slot = fresh.cast_slot
end

function begin_reveal(state: State): unit
    clear_picks(state)
    state.modal = "none"
    state.revealing = true
    state.cast_slot = nil
end

function apply_hand_order(state: State, order: {i32}): unit
    local old_to_new: {i32} = {}
    for _ in order do table.insert(old_to_new, 0) end
    for new_slot, old_slot in order do old_to_new[old_slot] = new_slot end
    state.hand_cursor = old_to_new[state.hand_cursor]
    for index, pick in state.play_picks do state.play_picks[index] = old_to_new[pick] end
    for index, pick in state.swap_hand do state.swap_hand[index] = old_to_new[pick] end
end

function fan_focus(state: State, animating: bool): i32
    if state.revealing or animating then return FAN_CLOSED end
    -- Targeting a spell points at the table cards, so the fan folds shut the same
    -- way it does when the cursor crosses up to the table_card row.
    if state.cast_slot ~= nil then return FAN_CLOSED end
    if state.cursor_area ~= "hand" then return FAN_CLOSED end
    return state.hand_cursor
end

-- Closing a modal returns to whatever is underneath it: the live board, or the
-- verdict when the duel has already been settled. A ledger opened over the
-- verdict must not close onto a finished board, which has no way on.
function close_modal(state: State, finished: bool): unit
    if finished then
        state.modal = "final"
    else
        state.modal = "none"
    end
end

-- Enforce the same phase ordering for every input adapter.
function gate(
    state: State,
    finished: bool,
    animating: bool,
    reveal_finished: bool,
    command: Command
): GateResult
    if state.revealing then
        if command == "restart" then return "reset" end
        if command == "advance" or command == "primary" then
            if not reveal_finished then return "finish-reveal" end
            state.revealing = false
            if finished then state.modal = "final"
            else return "refill" end
        end
        return "consumed"
    end

    if command == "restart" then return "reset" end
    if command == "history" then
        if state.modal == "history" then close_modal(state, finished)
        else state.modal = "history" end
        return "consumed"
    end
    if command == "help" then
        if state.modal == "help" then close_modal(state, finished)
        else state.modal = "help" end
        return "consumed"
    end

    -- The verdict is the one modal that does not simply close: dismissing it
    -- is asking for the next duel, so it answers to the same advance gesture
    -- every other screen uses as well as to a click.
    if state.modal == "final" then
        if command == "advance" or command == "primary" then
            return "advance"
        end
        return "consumed"
    end
    if state.modal ~= "none" then
        if command == "advance" or command == "primary" then
            close_modal(state, finished)
        end
        return "consumed"
    end
    if animating then
        if command == "advance" or command == "primary" then return "skip" end
        return "consumed"
    end
    return "live"
end

-- Development snapshots ride the built-in JSON codec. The wrapper record
-- carries the schema marker, and unpacking already validates the shape.
-- Literal-union fields decode as plain strings, so the modal and cursor-area
-- domains are checked by restore itself.
type Snapshot = { schema: string, state: State }

function snapshot(state: State): string
    local payload: Snapshot = { schema = UI_SNAPSHOT_SCHEMA, state = state }
    return json.pack(payload)
end

function restore(snapshot_value: string): State?
    local decoded = json.unpack<Snapshot>(snapshot_value)
    if decoded == nil then return nil end
    if decoded.schema ~= UI_SNAPSHOT_SCHEMA then return nil end
    local restored: State = decoded.state
    -- An unknown modal or cursor area is another build's payload.
    if restored.modal ~= "none" and restored.modal ~= "history"
        and restored.modal ~= "help" and restored.modal ~= "final"
    then
        return nil
    end
    if restored.cursor_area ~= "hand" and restored.cursor_area ~= "table-cards" then
        return nil
    end
    -- The slot being aimed is a cast key, never negative. Whether the
    -- restored loadout has a spell under that key is the screen module's
    -- cross-check, since only it sees both halves.
    if (restored.cast_slot or 0) < 0 then return nil end
    return restored
end

return {
    new = new,
    reset = reset,
    toggle = toggle,
    clear_picks = clear_picks,
    begin_reveal = begin_reveal,
    apply_hand_order = apply_hand_order,
    fan_focus = fan_focus,
    gate = gate,
    snapshot = snapshot,
    restore = restore,
}
