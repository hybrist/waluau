-- Host-independent heist flow. Keyboard and mouse are adapters at this seam;
-- phase ordering, action acceptance, focus, pending binds, and development
-- snapshot ownership live here.

local snapshot_data = require("./snapshot")

type State = {
    hand_cursor: i32,
    ward_cursor: i32,
    cursor_area: i32,
    play_picks: {i32},
    swap_hand: {i32},
    swap_wards: {i32},
    modal: i32,
    revealing: bool,
    reveal_clock: f64
}

const MODAL_NONE: i32 = 0
const MODAL_HISTORY: i32 = 1
const MODAL_HELP: i32 = 2
const MODAL_FINAL: i32 = 4

const COMMAND_NONE: i32 = 0
const COMMAND_ADVANCE: i32 = 1
const COMMAND_RESTART: i32 = 2
const COMMAND_HISTORY: i32 = 3
const COMMAND_HELP: i32 = 4
const COMMAND_PRIMARY: i32 = 5

const RESULT_LIVE: i32 = 0
const RESULT_CONSUMED: i32 = 1
const RESULT_RESET: i32 = 2
const RESULT_REFILL: i32 = 3
const RESULT_SKIP: i32 = 4

const CURSOR_HAND: i32 = 0
const CURSOR_WARDS: i32 = 1
const FAN_CLOSED: i32 = -1
const BOARD_REVEAL_SECONDS: f64 = 2.3
const UI_SNAPSHOT_SCHEMA: string = "ante-flow-v1"
const UI_SNAPSHOT_COLLECTION_LIMIT: i32 = 256

function new(): State
    return {
        hand_cursor = 0,
        ward_cursor = 0,
        cursor_area = CURSOR_HAND,
        play_picks = {},
        swap_hand = {},
        swap_wards = {},
        modal = MODAL_NONE,
        revealing = false,
        reveal_clock = 0.0,
    }
end

function toggle(picks: {i32}, value: i32, limit: i32): unit
    for index, pick in picks do
        if pick == value then
            table.remove(picks, index)
            return
        end
    end
    if #picks < limit then table.insert(picks, value) end
end

function clear_picks(state: State): unit
    state.play_picks = {}
    state.swap_hand = {}
    state.swap_wards = {}
    state.cursor_area = CURSOR_HAND
    state.hand_cursor = 0
    state.ward_cursor = 0
end

function reset(state: State): unit
    local fresh: State = new()
    state.hand_cursor = fresh.hand_cursor
    state.ward_cursor = fresh.ward_cursor
    state.cursor_area = fresh.cursor_area
    state.play_picks = fresh.play_picks
    state.swap_hand = fresh.swap_hand
    state.swap_wards = fresh.swap_wards
    state.modal = fresh.modal
    state.revealing = fresh.revealing
    state.reveal_clock = fresh.reveal_clock
end

function begin_reveal(state: State): unit
    clear_picks(state)
    state.modal = MODAL_NONE
    state.revealing = true
    state.reveal_clock = 0.0
end

function apply_hand_order(state: State, order: {i32}): unit
    local old_to_new: {i32} = {}
    for _ in order do table.insert(old_to_new, 0) end
    for new_slot, old_slot in order do old_to_new[old_slot] = new_slot end
    state.hand_cursor = old_to_new[state.hand_cursor]
    for index, pick in state.play_picks do state.play_picks[index] = old_to_new[pick] end
    for index, pick in state.swap_hand do state.swap_hand[index] = old_to_new[pick] end
end

function fan_focus(state: State, animating: bool): i32
    if state.revealing or animating then return FAN_CLOSED end
    if state.cursor_area ~= CURSOR_HAND then return FAN_CLOSED end
    return state.hand_cursor
end

function update_reveal(state: State, dt: f64): {f64}
    local previous: f64 = state.reveal_clock
    state.reveal_clock += dt
    if state.reveal_clock >= BOARD_REVEAL_SECONDS then
        state.reveal_clock = BOARD_REVEAL_SECONDS
    end
    return { previous, state.reveal_clock }
end

-- Enforce the same phase ordering for every input adapter. RESULT_LIVE is the
-- only result that permits an adapter to interpret board-specific input.
function gate(state: State, finished: bool, animating: bool, command: i32): i32
    if state.revealing then
        if command == COMMAND_RESTART then return RESULT_RESET end
        if command == COMMAND_ADVANCE or command == COMMAND_PRIMARY then
            if state.reveal_clock < BOARD_REVEAL_SECONDS then
                state.reveal_clock = BOARD_REVEAL_SECONDS
            else
                state.revealing = false
                if finished then state.modal = MODAL_FINAL
                else return RESULT_REFILL end
            end
        end
        return RESULT_CONSUMED
    end

    if command == COMMAND_RESTART then return RESULT_RESET end
    if command == COMMAND_HISTORY then
        if state.modal == MODAL_HISTORY then state.modal = MODAL_NONE
        else state.modal = MODAL_HISTORY end
        return RESULT_CONSUMED
    end
    if command == COMMAND_HELP then
        if state.modal == MODAL_HELP then state.modal = MODAL_NONE
        else state.modal = MODAL_HELP end
        return RESULT_CONSUMED
    end

    if state.modal == MODAL_FINAL then
        if command == COMMAND_PRIMARY then return RESULT_RESET end
        return RESULT_CONSUMED
    end
    if state.modal ~= MODAL_NONE then
        if command == COMMAND_ADVANCE or command == COMMAND_PRIMARY then
            state.modal = MODAL_NONE
        end
        return RESULT_CONSUMED
    end
    if animating then
        if command == COMMAND_ADVANCE or command == COMMAND_PRIMARY then return RESULT_SKIP end
        return RESULT_CONSUMED
    end
    return RESULT_LIVE
end

function snapshot(state: State): string
    local parts: {string} = { UI_SNAPSHOT_SCHEMA }
    snapshot_data.append_i32(parts, state.hand_cursor)
    snapshot_data.append_i32(parts, state.ward_cursor)
    snapshot_data.append_i32(parts, state.cursor_area)
    snapshot_data.append_indices(parts, state.play_picks)
    snapshot_data.append_indices(parts, state.swap_hand)
    snapshot_data.append_indices(parts, state.swap_wards)
    snapshot_data.append_i32(parts, state.modal)
    snapshot_data.append_bool(parts, state.revealing)
    snapshot_data.append_f64(parts, state.reveal_clock)
    return table.concat(parts, ",")
end

function restore(snapshot_value: string): State?
    local reader: snapshot_data.Reader = snapshot_data.reader(
        snapshot_value, UI_SNAPSHOT_COLLECTION_LIMIT)
    if reader:next_string() ~= UI_SNAPSHOT_SCHEMA then return nil end
    local hand_cursor: i32 = reader:next_i32()
    local ward_cursor: i32 = reader:next_i32()
    local cursor_area: i32 = reader:next_i32()
    local play_picks: {i32} = reader:next_indices()
    local swap_hand: {i32} = reader:next_indices()
    local swap_wards: {i32} = reader:next_indices()
    local modal: i32 = reader:next_i32()
    local revealing: bool = reader:next_bool()
    local reveal_clock: f64 = reader:next_f64()
    local restored: State = {
        hand_cursor = hand_cursor,
        ward_cursor = ward_cursor,
        cursor_area = cursor_area,
        play_picks = play_picks,
        swap_hand = swap_hand,
        swap_wards = swap_wards,
        modal = modal,
        revealing = revealing,
        reveal_clock = reveal_clock,
    }
    if not reader:complete() then return nil end
    return restored
end

return {
    new = new,
    reset = reset,
    toggle = toggle,
    clear_picks = clear_picks,
    begin_reveal = begin_reveal,
    apply_hand_order = apply_hand_order,
    fan_focus = fan_focus,
    update_reveal = update_reveal,
    gate = gate,
    snapshot = snapshot,
    restore = restore,
    command_none = COMMAND_NONE,
    command_advance = COMMAND_ADVANCE,
    command_restart = COMMAND_RESTART,
    command_history = COMMAND_HISTORY,
    command_help = COMMAND_HELP,
    command_primary = COMMAND_PRIMARY,
    result_live = RESULT_LIVE,
    result_consumed = RESULT_CONSUMED,
    result_reset = RESULT_RESET,
    result_refill = RESULT_REFILL,
    result_skip = RESULT_SKIP,
    cursor_hand = CURSOR_HAND,
    cursor_wards = CURSOR_WARDS,
    modal_none = MODAL_NONE,
    modal_history = MODAL_HISTORY,
    modal_help = MODAL_HELP,
    modal_final = MODAL_FINAL,
}
