-- DOM-free recognition and timing for Ante's hidden divine intervention.
-- Rendering owns what the fairy looks like; this module only says when it is
-- flying and which of the five cards it has reached.

type State = {
    matched: i32,
    active: bool,
    clock: f64,
    converted: i32
}

const TARGET_COUNT: i32 = 5
const FIRST_CONTACT: f64 = 0.58
const CONTACT_STEP: f64 = 0.52
const TOTAL_SECONDS: f64 = 3.18

function new(): State
    return { matched = 0, active = false, clock = 0.0, converted = 0 }
end

function reset(state: State): unit
    state.matched = 0
    state.active = false
    state.clock = 0.0
    state.converted = 0
end

function sequence_key(index: i32): string
    if index == 0 or index == 1 then return "ArrowUp" end
    if index == 2 or index == 3 then return "ArrowDown" end
    if index == 4 or index == 6 then return "ArrowLeft" end
    if index == 5 or index == 7 then return "ArrowRight" end
    if index == 8 then return "b" end
    return "a"
end

function normalized(key: string): string
    if key == "A" then return "a" end
    if key == "B" then return "b" end
    return key
end

-- Returns true only for the keystroke that completes the code. A wrong key
-- restarts at one when it is itself the first Up, preserving the useful
-- overlap in sequences such as Up, Up, Up, Down...
function keypressed(state: State, key: string): bool
    if state.active then return false end
    local value: string = normalized(key)
    if value == sequence_key(state.matched) then
        state.matched += 1
    elseif value == sequence_key(0) then
        -- Up, Up, Up still ends in the opening Up, Up pair.
        if state.matched == 2 then state.matched = 2 else state.matched = 1 end
    else
        state.matched = 0
    end
    if state.matched < 10 then return false end
    state.matched = 0
    state.active = true
    state.clock = 0.0
    state.converted = 0
    return true
end

function contact_time(index: i32): f64
    return FIRST_CONTACT + CONTACT_STEP * (index::f64)
end

-- Advances the flight and returns every newly touched card. A list keeps a
-- long frame from dropping conversions if it crosses more than one landing.
function update(state: State, dt: f64): {i32}
    local due: {i32} = {}
    if not state.active then return due end
    state.clock += dt
    while state.converted < TARGET_COUNT
        and state.clock >= contact_time(state.converted)
    do
        table.insert(due, state.converted)
        state.converted += 1
    end
    if state.clock >= TOTAL_SECONDS then
        state.clock = TOTAL_SECONDS
        state.active = false
    end
    return due
end

return {
    new = new,
    reset = reset,
    keypressed = keypressed,
    update = update,
    contact_time = contact_time,
    target_count = TARGET_COUNT,
    total_seconds = TOTAL_SECONDS,
}
