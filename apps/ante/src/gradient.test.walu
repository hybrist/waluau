-- Ante's Waluau test suite, run by vitest: @waluau/vite-plugin compiles this
-- file with the waluau CLI and registers the suites during collection.

require("waluau:vitest")

local gradient = require("./gradient")

describe("gradient math", function(): unit
    it("mixes linearly between two channels", function(): unit
        expect(gradient.mix(0.0, 1.0, 0.25)):toBe(0.25)
        expect(gradient.mix(0.2, 0.8, 0.5)):toBeCloseTo(0.5)
        expect(gradient.mix(1.0, 0.0, 1.0)):toBe(0.0)
    end)

    it("clamps channel values into [0, 1]", function(): unit
        expect(gradient.clamp01(-0.5)):toBe(0.0)
        expect(gradient.clamp01(0.42)):toBe(0.42)
        expect(gradient.clamp01(1.5)):toBe(1.0)
    end)

    describe("the u_time wave", function(): unit
        it("stays inside [0, 1]", function(): unit
            local time: f64 = 0.0
            while time < 20.0 do
                local value: f64 = gradient.wave(time, 0.5)
                expect(value):toBeGreaterThanOrEqual(0.0)
                expect(value):toBeLessThanOrEqual(1.0)
                time = time + 0.25
            end
        end)

        it("starts at its midpoint for x = 0", function(): unit
            expect(gradient.wave(0.0, 0.0)):toBeCloseTo(0.5)
        end)
    end)
end)
