-- Retained visual ownership for the live duel board. The representation is
-- opaque outside this module so renderer functions pass one small nominal
-- handle instead of repeatedly expanding every presenter, node and callback.
-- This is the intended deep-module boundary; waluau-4ggh separately tracks
-- the compiler's pathological expansion of equivalent transparent graphs.
local particles = require("waluau:engine/particles")
local game = require("../game")
local run_module = require("../run")
local spells = require("../spells/spell")
local card_burn = require("../card_burn")
local box = require("../ui/layout")
local ui = require("../ui/node")
local input_module = require("./interaction")
local card = require("../entities/card")
local hand_fan = require("../entities/hand_fan")
local table_card_panel = require("../entities/table_card_panel")
local deck = require("../entities/deck")
local pile = require("../entities/pile")
local hud = require("../entities/hud")
local footer = require("../entities/footer")
local action_bar = require("../entities/action_bar")
local capsule = require("../entities/capsule")
local powered_card = require("../entities/powered_card")
local modal = require("../entities/modal")
local help_card = require("../entities/help_card")
local ledger = require("../entities/ledger")
local verdict = require("../entities/verdict")

const HAND_CAPACITY: i32 = 7
const TABLE_CAPACITY: i32 = 5

export opaque type State = {
    root: ui.Node,
    input: input_module.State,
    surface: ui.Surface?,
    table_nodes: {ui.Node},
    commit_node: ui.Node,
    hud_node: ui.Node,
    footer_node: ui.Node,
    deck_node: ui.Node,
    pile_node: ui.Node,
    player_node: ui.Node,
    computer_nodes: {ui.Node},
    panel_node: ui.Node,
    hud_view: hud.Stateful,
    footer_view: footer.Stateful,
    deck_view: deck.Stateful,
    pile_view: pile.Stateful,
    player_view: hand_fan.Stateful,
    computer_views: {card.Stateful},
    table_views: {powered_card.Stateful},
    panel_view: ui.Node,
    action_view: action_bar.Stateful,
    action_items: {action_bar.Action},
    player_looks: {card.Look},
    player_hidden: {bool},
    computer_hidden: {bool},
    table_hidden: {bool},
    modal_kind: "none" | "history" | "help" | "final",
    modal_content: ui.Node?
}

function new(state: game.View, run: run_module.View): State
    local sample: game.Card = { rank = 2, suit = 0 }
    if #state.middle > 0 then
        sample = state.middle[1]
    end
    local computer_views: {card.Stateful} = {}
    for _ = 0::i32, HAND_CAPACITY - 1 do
        table.insert(computer_views, card.Stateful.new(card.sealed(sample, false)))
    end
    local table_views: {powered_card.Stateful} = {}
    for _ = 0::i32, TABLE_CAPACITY - 1 do
        table.insert(
            table_views,
            powered_card.Stateful.new(
                card.plain(sample),
                nil,
                0.0,
                card_burn.CardAsh.new(),
                powered_card.new_grave_dust()
            )
        )
    end
    local hud_view: hud.Stateful = hud.Stateful.new(state, run)
    local footer_view: footer.Stateful = footer.Stateful.new(state, run)
    local deck_view: deck.Stateful = deck.Stateful.new(state.deck_count)
    local pile_view: pile.Stateful = pile.Stateful.new({}, 0)
    local player_view: hand_fan.Stateful = hand_fan.Stateful.new({}, {}, {})
    local panel_view: ui.Node = table_card_panel.node()
    local action_items: {action_bar.Action} = {action_bar.action("CONFIRM", false)}
    local action_view: action_bar.Stateful = action_bar.Stateful.new(action_items)

    local hud_node: ui.Node = hud_view.root
    local footer_node: ui.Node = footer_view.root
    local deck_node: ui.Node = deck_view.root
    local pile_node: ui.Node = pile_view.root
    local player_node: ui.Node = player_view.root
    local visual_children: {ui.Node} = {hud_node, footer_node, deck_node, pile_node}
    local computer_nodes: {ui.Node} = {}
    for view in computer_views do
        local node: ui.Node = view.root
        table.insert(computer_nodes, node)
        table.insert(visual_children, node)
    end
    local panel_node: ui.Node = panel_view
    table.insert(visual_children, panel_node)
    local table_nodes: {ui.Node} = {}
    for view in table_views do
        local node: ui.Node = view.root
        table.insert(table_nodes, node)
        table.insert(visual_children, node)
    end
    local commit_node: ui.Node = action_view.capsules[1].root
    table.insert(visual_children, commit_node)
    table.insert(visual_children, player_node)
    local input: input_module.State = input_module.new(visual_children, table_nodes, commit_node)
    return {
        root = input:root_node(),
        input = input,
        surface = nil,
        table_nodes = table_nodes,
        commit_node = commit_node,
        hud_node = hud_node,
        footer_node = footer_node,
        deck_node = deck_node,
        pile_node = pile_node,
        player_node = player_node,
        computer_nodes = computer_nodes,
        panel_node = panel_node,
        hud_view = hud_view,
        footer_view = footer_view,
        deck_view = deck_view,
        pile_view = pile_view,
        player_view = player_view,
        computer_views = computer_views,
        table_views = table_views,
        panel_view = panel_view,
        action_view = action_view,
        action_items = action_items,
        player_looks = {},
        player_hidden = {},
        computer_hidden = {},
        table_hidden = {},
        modal_kind = "none",
        modal_content = nil
    }
end

function clear_bool(values: {bool}): unit
    while #values > 0 do
        table.remove(values)
    end
end

function State:present_chrome(
    state: game.View,
    run: run_module.View,
    discards: {game.Card},
    discard_count: i32
): unit
    self.hud_view:present(state, run)
    self.footer_view:present(state, run)
    self.deck_view:present(state.deck_count)
    self.pile_view:present(discards, discard_count)
end

function State:present_pile(discards: {game.Card}, count: i32): unit
    self.pile_view:present(discards, count)
end

function State:begin_player(): unit
    while #self.player_looks > 0 do
        table.remove(self.player_looks)
    end
    clear_bool(self.player_hidden)
end

function State:add_player(value: card.Look, hidden: bool): unit
    table.insert(self.player_looks, value)
    table.insert(self.player_hidden, hidden)
end

function State:end_player(parts: {f64}): unit
    self.player_view:present(self.player_looks, parts, self.player_hidden)
end

function State:begin_computer(): unit
    clear_bool(self.computer_hidden)
end

function State:present_computer(index: i32, value: card.Look, hidden: bool): unit
    table.insert(self.computer_hidden, hidden)
    self.computer_views[index]:present(value)
end

function State:present_input(frame: input_module.Frame): unit
    self.input:present(frame)
end

function State:begin_table(): unit
    clear_bool(self.table_hidden)
end

function State:present_table(
    index: i32,
    value: card.Look,
    kind: spells.SpellKind?,
    clock: f64,
    ash: card_burn.CardAsh,
    dust: particles.ParticleSystem,
    hidden: bool
): unit
    table.insert(self.table_hidden, hidden)
    self.table_views[index]:present(value, kind, clock, ash, dust)
end

function State:present_modal(
    kind: "none" | "history" | "help" | "final",
    state: game.View,
    run: run_module.View
): unit
    if kind == self.modal_kind then
        return
    end
    self.modal_kind = kind
    if kind == "help" then
        self.modal_content = help_card.node()
    elseif kind == "history" then
        self.modal_content = ledger.node(state)
    elseif kind == "final" then
        self.modal_content = verdict.node(state, run)
    else
        self.modal_content = nil
    end
end

function State:prepare_surface(surface: ui.Surface): unit
    local retained: ui.Surface? = self.surface
    if retained == nil then
        self.surface = {
            graphics = surface.graphics,
            effects = surface.effects,
            card_back = surface.card_back,
            suit_symbols = surface.suit_symbols
        }
        return
    end
    local current: ui.Surface = retained::ui.Surface
    current.graphics = surface.graphics
    current.effects = surface.effects
    current.card_back = surface.card_back
    current.suit_symbols = surface.suit_symbols
end

function State:measure_arrange(surface: ui.Surface, width: f64, height: f64): unit
    self:prepare_surface(surface)
    self.root:measure(surface.graphics)
    self.root:arrange(0.0, 0.0, width, height)
    self.input:arrange()
end

function State:paint_node(node: ui.Node, bounds: box.Rect): unit
    local retained: ui.Surface? = self.surface
    assert(retained ~= nil)
    node:draw(retained::ui.Surface, bounds.x, bounds.y, bounds.width, bounds.height)
end

function State:hud_height(graphics: ui.Graphics?): f64
    return self.hud_view.root:measure(graphics).preferred_height
end

function State:footer_height(graphics: ui.Graphics?): f64
    return self.footer_view.root:measure(graphics).preferred_height
end

function State:paint_hud(bounds: box.Rect): unit
    self:paint_node(self.hud_node, bounds)
end
function State:paint_footer(bounds: box.Rect): unit
    self:paint_node(self.footer_node, bounds)
end
function State:paint_deck(bounds: box.Rect): unit
    self:paint_node(self.deck_node, bounds)
end
function State:paint_pile(bounds: box.Rect): unit
    self:paint_node(self.pile_node, bounds)
end
function State:paint_panel(bounds: box.Rect): unit
    self:paint_node(self.panel_node, bounds)
end

function State:paint_table(index: i32, bounds: box.Rect): unit
    if not self.table_hidden[index] then
        self:paint_node(self.table_nodes[index], bounds)
    end
end

function State:paint_computer(index: i32, bounds: box.Rect): unit
    if not self.computer_hidden[index] then
        self:paint_node(self.computer_nodes[index], bounds)
    end
end

function State:paint_player(bounds: box.Rect): unit
    self:paint_node(self.player_node, bounds)
end

function State:paint_action(text: string, active: bool, band: box.Rect): unit
    self.action_items[1].text = text
    self.action_items[1].active = active
    self.action_view:present(self.action_items)
    local retained: ui.Surface? = self.surface
    assert(retained ~= nil)
    local width: f64 = self.commit_node:measure((retained::ui.Surface).graphics).preferred_width
    self:paint_node(
        self.commit_node,
        box.rect(band.x + (band.width - width) * 0.5, band.y, width, capsule.height)
    )
end

function State:paint_modal(surface: ui.Surface, bounds: box.Rect): unit
    local content: ui.Node? = self.modal_content
    if content ~= nil then
        modal.show(surface, bounds, content::ui.Node)
    end
end

function State:focus_hand(index: i32): bool
    return self.input:focus_hand(index)
end
function State:focus_table(index: i32): bool
    return self.input:focus_table(index)
end
function State:focused_hand(): i32
    return self.input:focused_hand()
end
function State:focused_table(): i32
    return self.input:focused_table()
end
function State:repair_table_focus(): bool
    return self.input:repair_table_focus()
end
function State:fan_focus(animating: bool): i32
    return self.input:fan_focus(animating)
end
function State:apply_hand_order(order: {i32}): unit
    self.input:apply_hand_order(order)
end
function State:pointer_move(x: f64, y: f64): i32
    return self.input:pointer_move(x, y)
end
function State:pointer_down(x: f64, y: f64, button: i32): i32
    return self.input:pointer_down(x, y, button)
end
function State:pointer_up(x: f64, y: f64, button: i32): input_module.Action
    return self.input:pointer_up(x, y, button)
end
function State:pointer_leave(): unit
    self.input:pointer_leave()
end
function State:navigate(direction: "left" | "right" | "up" | "down"): bool
    return self.input:navigate(direction)
end
function State:activate(): input_module.Action
    return self.input:activate()
end
function State:activate_modal(): input_module.Action
    return self.input:activate_modal()
end

return { new = new }
