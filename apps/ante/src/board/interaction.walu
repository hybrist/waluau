-- Retained input state for the live duel board. The caller supplies the
-- stable visual nodes in paint order; table cards, the commit capsule, the
-- ability sockets and the standing controls are registered directly, while the
-- rotated fan gets parallel custom-shape leaves because it is painted by one
-- presenter.
local box = require("../ui/layout")
local ui = require("../ui/node")
local router_module = require("../ui/interaction")
local card = require("../entities/card")
local hand_fan = require("../entities/hand_fan")
local control_bar = require("../entities/control_bar")

const HAND_CAPACITY: i32 = 7

-- "spell" carries a loadout slot; the rest ignore the index. The four chrome
-- kinds have no keyboard equivalent to route through, because the keys that
-- reach them are the ones printed on their own labels.
export type Action = {
    kind: "none" | "hand" | "table-card" | "commit" | "modal" | "spell" | "menu" | "help" | "history" | "restart",
    index: i32
}

-- The stable leaves this module binds, all of them owned and painted by the
-- board's visual side. `visuals` is that side's paint order; the rest name
-- which of those leaves answer to what.
export type Controls = {
    visuals: {ui.Node},
    tables: {ui.Node},
    commit: ui.Node,
    spells: {ui.Node},
    chrome: {ui.Node}
}

export type Frame = {
    viewport_width: f64,
    viewport_height: f64,
    fan_bounds: box.Rect,
    fan_parts: {f64},
    hand_count: i32,
    table_count: i32,
    frozen_table: {bool},
    swap_open: bool,
    casting: bool,
    modal_open: bool,
    finished: bool,
    play_pick_count: i32,
    spell_count: i32,
    -- The smallest a chrome control's hit area may be, in board units. The
    -- board scales with the canvas, so its chrome is painted far under a
    -- fingertip on a phone; a caller that has no pointer to serve passes 0.
    touch_minimum: f64
}

type Presentation = {
    viewport_width: f64,
    viewport_height: f64,
    fan_bounds: box.Rect,
    fan_parts: {f64},
    hand_count: i32,
    table_count: i32,
    touch_minimum: f64,
    pending: Action
}

export opaque type State = {
    presentation: Presentation,
    root: ui.Node,
    router: router_module.Router,
    board_scope: i32,
    modal_scope: i32,
    hand_nodes: {ui.Node},
    hand_targets: {router_module.Target},
    table_nodes: {ui.Node},
    table_targets: {router_module.Target},
    commit_node: ui.Node,
    commit_target: router_module.Target,
    spell_targets: {router_module.Target},
    chrome_targets: {router_module.Target},
    modal_node: ui.Node,
    modal_target: router_module.Target
}

function State:root_node(): ui.Node
    return self.root
end

-- DOM-free layout seam for focused interaction tests without a WebGL canvas.
function State:prepare_headless(frame: Frame): unit
    self:present(frame)
    self.root:measure(nil)
    self.root:arrange(0.0, 0.0, frame.viewport_width, frame.viewport_height)
    self:arrange()
    self.commit_target:set_visible(false)
end

function State:hand_bounds(index: i32): box.Rect
    return self.hand_nodes[index + 1]:bounds()
end

function State:fan_parts(): {f64}
    return self.presentation.fan_parts
end

function State:set_table_enabled(index: i32, enabled: bool): unit
    self.table_targets[index + 1]:set_enabled(enabled)
end

function State:set_hand_enabled(index: i32, enabled: bool): unit
    self.hand_nodes[index + 1]:set_enabled(enabled)
end

function State:hand_enabled(index: i32): bool
    return self.hand_nodes[index + 1]:is_enabled()
end

function empty_paint(surface: ui.Surface, bounds: box.Rect): unit
end

function handlers(
    presentation: Presentation,
    kind: "none" | "hand" | "table-card" | "commit" | "modal" | "spell" | "menu" | "help" | "history" | "restart",
    index: i32
): router_module.Handlers
    local callbacks: router_module.Handlers = router_module.handlers()
    callbacks.on_activate = function(): unit
        presentation.pending = { kind = kind, index = index }
    end
    return callbacks
end

-- Which action a standing control stands for. The bar owns the order and the
-- labels; this is the only place that turns one into an intent.
function chrome_kind(control: i32): "menu" | "help" | "history" | "restart"
    if control == control_bar.help then
        return "help"
    end
    if control == control_bar.history then
        return "history"
    end
    if control == control_bar.restart then
        return "restart"
    end
    return "menu"
end

-- A control painted at chrome size is a sliver of screen once the board has
-- scaled down to a phone, so its hit area grows to a fingertip's worth of
-- height while what is drawn stays where the bar put it. Only the height
-- grows: these controls sit in a row, and widening them would make neighbours
-- fight over the gap between them.
function comfortable_hit(presentation: Presentation, node: ui.Node): ui.Node
    return node:set_hit_test(
        function(bounds: box.Rect, x: f64, y: f64): bool
            local grow: f64 = (presentation.touch_minimum - bounds.height) * 0.5
            if grow < 0.0 then
                grow = 0.0
            end
            return box.contains(
                box.rect(bounds.x, bounds.y - grow, bounds.width, bounds.height + grow * 2.0),
                x,
                y
            )
        end
    )
end

function State.new(controls: Controls): State
    local visual_children: {ui.Node} = controls.visuals
    local table_nodes: {ui.Node} = controls.tables
    local commit_node: ui.Node = controls.commit
    local presentation: Presentation = {
        viewport_width = 0.0,
        viewport_height = 0.0,
        fan_bounds = box.rect(0.0, 0.0, 0.0, 0.0),
        fan_parts = {},
        hand_count = 0,
        table_count = 0,
        touch_minimum = 0.0,
        pending = { kind = "none", index = -1 }
    }
    local hand_nodes: {ui.Node} = {}
    for index = 0::i32, HAND_CAPACITY - 1 do
        local slot_index: i32 = index
        local node: ui.Node = ui.Node.sized(card.width, card.height, empty_paint)
        node:set_hit_test(
            function(bounds: box.Rect, x: f64, y: f64): bool
                if slot_index >= presentation.hand_count then
                    return false
                end
                return hand_fan.hit(
                    presentation.fan_bounds,
                    presentation.fan_parts,
                    x,
                    y
                ) == slot_index
            end
        )
        table.insert(hand_nodes, node)
        table.insert(visual_children, node)
    end
    local modal_node: ui.Node = ui.Node.sized(1.0, 1.0, empty_paint)
    table.insert(visual_children, modal_node)
    local root: ui.Node = ui.Node.layer(visual_children)
    local router: router_module.Router = router_module.Router.new(root)
    local board_scope: i32 = router:add_scope("spatial", true)
    local modal_scope: i32 = router:add_scope("column", true)
    local hand_targets: {router_module.Target} = {}
    for index, node in hand_nodes do
        table.insert(
            hand_targets,
            router:add(node, board_scope, true, handlers(presentation, "hand", index - 1))
        )
    end
    local table_targets: {router_module.Target} = {}
    for index, node in table_nodes do
        table.insert(
            table_targets,
            router:add(node, board_scope, true, handlers(presentation, "table-card", index - 1))
        )
    end
    local commit_target: router_module.Target = router:add(
        commit_node,
        board_scope,
        true,
        handlers(presentation, "commit", 0)
    )
    -- Sockets and standing controls stay out of the focus ring: arrow keys walk
    -- the cards, and every one of these controls already has a key of its own.
    -- They are pointer targets and nothing else. The bar's controls are also
    -- the only targets no phase ever takes away — leaving, reading and
    -- restarting are answers the duel owes wherever it has got to — so
    -- `present` never has to reconsider them. Under a modal they stop
    -- answering through the scope, not through their own visibility.
    local spell_targets: {router_module.Target} = {}
    for index, node in controls.spells do
        table.insert(
            spell_targets,
            router:add(node, board_scope, false, handlers(presentation, "spell", index - 1))
        )
    end
    local chrome_targets: {router_module.Target} = {}
    for index, node in controls.chrome do
        table.insert(
            chrome_targets,
            router:add(
                comfortable_hit(presentation, node),
                board_scope,
                false,
                handlers(presentation, chrome_kind(index - 1), 0)
            )
        )
    end
    local modal_target: router_module.Target = router:add(
        modal_node,
        modal_scope,
        true,
        handlers(presentation, "modal", 0)
    )
    router:activate_scope(board_scope)
    return {
        presentation = presentation,
        root = root,
        router = router,
        board_scope = board_scope,
        modal_scope = modal_scope,
        hand_nodes = hand_nodes,
        hand_targets = hand_targets,
        table_nodes = table_nodes,
        table_targets = table_targets,
        commit_node = commit_node,
        commit_target = commit_target,
        spell_targets = spell_targets,
        chrome_targets = chrome_targets,
        modal_node = modal_node,
        modal_target = modal_target
    }
end

function State:focused_hand(): i32
    local key: i32 = self.router:focused()
    for index, target in self.hand_targets do
        if target.key == key then
            return index - 1
        end
    end
    return -1
end

function State:focused_table(): i32
    local key: i32 = self.router:focused()
    for index, target in self.table_targets do
        if target.key == key then
            return index - 1
        end
    end
    return -1
end

function State:focus_hand(index: i32): bool
    if index < 0 or index >= #self.hand_targets then
        return false
    end
    -- Input can move focus between presentations, before the next draw has
    -- refreshed target visibility for the new mode.
    self.hand_targets[index + 1]:set_visible(true)
    return self.router:focus(self.hand_targets[index + 1].key)
end

function State:focus_table(index: i32): bool
    if index < 0 or index >= #self.table_targets then
        return false
    end
    self.table_targets[index + 1]:set_visible(true)
    return self.router:focus(self.table_targets[index + 1].key)
end

-- A condition such as Freeze Ray can make the focused table card stop being
-- actionable between frames. Move to the next live card in the same row.
function State:repair_table_focus(): bool
    local focused: i32 = self:focused_table()
    if focused < 0 then
        return false
    end
    local count: i32 = self.presentation.table_count
    if focused < count and self.table_nodes[focused + 1]:is_visible() and self.table_nodes[focused + 1]:is_enabled() then
        return false
    end
    for offset = 1::i32, count - 1 do
        local index: i32 = (focused + offset) % count
        local node: ui.Node = self.table_nodes[index + 1]
        if node:is_visible() and node:is_enabled() then
            self.router:focus(self.table_targets[index + 1].key)
            return true
        end
    end
    self.router:clear_focus()
    return true
end

function State:present(frame: Frame): unit
    local presentation: Presentation = self.presentation
    presentation.viewport_width = frame.viewport_width
    presentation.viewport_height = frame.viewport_height
    presentation.fan_bounds = frame.fan_bounds
    presentation.fan_parts = frame.fan_parts
    presentation.hand_count = frame.hand_count
    presentation.table_count = frame.table_count
    presentation.touch_minimum = frame.touch_minimum
    local board_live: bool = not frame.modal_open and not frame.finished

    for index, target in self.hand_targets do
        local slot: i32 = index - 1
        target:set_visible(board_live and not frame.casting and slot < frame.hand_count)
        if slot < frame.hand_count then
            target:link(
                "left",
                self.hand_targets[(slot + frame.hand_count - 1) % frame.hand_count + 1]
            )
            target:link("right", self.hand_targets[(slot + 1) % frame.hand_count + 1])
            if frame.swap_open and frame.table_count > 0 then
                target:link("up", self.table_targets[slot % frame.table_count + 1])
            end
        end
    end
    for index, target in self.table_targets do
        local slot: i32 = index - 1
        target:set_visible(
            board_live and (frame.swap_open or frame.casting) and slot < frame.table_count
        )
        target:set_enabled(
            slot < frame.table_count and (frame.casting or not frame.frozen_table[slot + 1])
        )
        if slot < frame.table_count then
            target:link(
                "left",
                self.table_targets[(slot + frame.table_count - 1) % frame.table_count + 1]
            )
            target:link("right", self.table_targets[(slot + 1) % frame.table_count + 1])
            if frame.hand_count > 0 then
                target:link("down", self.hand_targets[slot % frame.hand_count + 1])
            end
        end
    end
    -- Aiming a spell takes the action band away: the capsule is not painted
    -- then, so it is not re-arranged either, and a target left standing would
    -- answer for the whole board out of the box the root laid it in.
    self.commit_target:set_visible(
        board_live and not frame.casting and (frame.swap_open or frame.play_pick_count == 2)
    )
    -- A socket answers whenever the loadout has a spell in it, aiming included:
    -- that is how the same tap that armed a spell calls it off again.
    for index, target in self.spell_targets do
        target:set_visible(board_live and index - 1 < frame.spell_count)
    end
    self.modal_target:set_visible(frame.modal_open)
    if frame.modal_open then
        self.router:activate_scope(self.modal_scope)
    else
        self.router:activate_scope(self.board_scope)
    end
    if board_live and (frame.swap_open or frame.casting) then
        self:repair_table_focus()
    end
    if board_live and frame.casting and self:focused_table() < 0 then
        self:focus_table(0)
    elseif board_live and not frame.casting and not frame.swap_open and self:focused_table() >= 0 then
        self:focus_hand(0)
    elseif board_live and self.router:focused() < 0 then
        self:focus_hand(0)
    end
end

function State:arrange(): unit
    local presentation: Presentation = self.presentation
    for index, node in self.hand_nodes do
        local slot: i32 = index - 1
        if slot < presentation.hand_count then
            local bounds: box.Rect = hand_fan.slot_rect(
                presentation.fan_bounds,
                slot,
                presentation.fan_parts[index],
                presentation.hand_count
            )
            node:arrange(bounds.x, bounds.y, bounds.width, bounds.height)
        end
    end
    self.modal_node:arrange(0.0, 0.0, presentation.viewport_width, presentation.viewport_height)
end

function State:fan_focus(animating: bool): i32
    if animating then
        return hand_fan.closed
    end
    return self:focused_hand()
end

function State:apply_hand_order(order: {i32}): unit
    local focused: i32 = self:focused_hand()
    if focused < 0 then
        return
    end
    for new_slot, old_slot in order do
        if old_slot == focused then
            self:focus_hand(new_slot)
            return
        end
    end
end

-- Which of the board's standing controls a point lands on, asked before any
-- phase gating has decided whether the board itself is listening. The control
-- bar answers wherever the duel has got to, the same as the keys printed on
-- it; a socket answers as soon as the deal in flight can be settled out of the
-- way. Everything else is ordinary board input and waits its turn.
function State:standing_at(x: f64, y: f64): "none" | "chrome" | "spell"
    local hit: i32 = self.root:hit(x, y)
    if hit < 0 then
        return "none"
    end
    for target in self.chrome_targets do
        if target.key == hit then
            return "chrome"
        end
    end
    for target in self.spell_targets do
        if target.key == hit then
            return "spell"
        end
    end
    return "none"
end

function State:pointer_move(x: f64, y: f64): i32
    local target: i32 = self.router:pointer_move(x, y)
    if target >= 0 then
        self.router:focus(target)
    end
    return target
end

function State:pointer_down(x: f64, y: f64, button: i32): i32
    return self.router:pointer_down(x, y, button)
end

function State:pointer_up(x: f64, y: f64, button: i32): Action
    self.presentation.pending = { kind = "none", index = -1 }
    self.router:pointer_up(x, y, button)
    return self:take_action()
end

function State:pointer_leave(): unit
    self.router:pointer_leave()
end

function State:navigate(direction: router_module.Direction): bool
    return self.router:navigate(direction)
end

function State:activate(): Action
    self.presentation.pending = { kind = "none", index = -1 }
    self.router:activate_focused()
    return self:take_action()
end

function State:activate_modal(): Action
    self.modal_target:set_visible(true)
    self.router:activate_scope(self.modal_scope)
    self.router:focus(self.modal_target.key)
    return self:activate()
end

function State:take_action(): Action
    local action: Action = self.presentation.pending
    self.presentation.pending = { kind = "none", index = -1 }
    return action
end

return { new = State.new }
