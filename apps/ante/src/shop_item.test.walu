-- The item seam is intentionally smaller than the shop: any effect receives
-- the mutable run and the selected destination, then changes only what it owns.

require("waluau:vitest")

local game = require("./game")
local run = require("./run")
local shop_item = require("./shop_item")

describe("Ante Magic shop items", function()
    it("passes enough mutable state for independent run effects", function()
        local state: run.State = run.new(game.spell_firebolt, false)
        state.gold = 21
        state.hearts = 2

        local halve_gold: shop_item.Item = shop_item.new(
            function(context: shop_item.UseState): unit
                context.run.gold //= 2
            end)
        local add_health: shop_item.Item = shop_item.new(
            function(context: shop_item.UseState): unit
                context.run.hearts += 1
            end)

        halve_gold:use({ run = state, key = -1 })
        add_health:use({ run = state, key = -1 })

        expect(state.gold):toBe(10)
        expect(state.hearts):toBe(3)
    end)

    it("uses the selected destination for an item which adds a spell", function()
        local state: run.State = run.new(game.spell_firebolt, false)
        local add_spell: shop_item.Item = shop_item.learn(game.spell_clone)

        add_spell:use({ run = state, key = 1 })

        expect(state:spell_count()):toBe(2)
        expect(state.spells[1].kind):toBe(game.spell_clone)
    end)
end)
