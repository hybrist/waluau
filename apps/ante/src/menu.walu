-- The menu screen shown before a duel begins: a cursor-driven option list,
-- not a tap-through splash. It owns the pre-game presentation and turns raw
-- input into screen actions; the entry module decides what starting the duel
-- means (audio unlock, fresh deal, screen switch), so this module stays free
-- of resource and rules concerns.
--
-- Picking NEW RUN or BOSS RUSH leads to a second list: the starting spell the
-- player bring on the job. That list is the run's first shop — a street
-- vendor standing at the mouth of the route — so this screen aims the shared
-- city map at it and lets the map pan there from the drifting view the title
-- sits over. Only confirming a spell emits a start action, so the entry module
-- always receives a complete mode-plus-spell choice. Both entries start a run —
-- a sequence of duels sharing one gold pool; they differ only in how often a
-- duel is fought as a boss battle.
--
-- The map itself belongs to the entry module and outlives this screen, which is
-- why it arrives as a parameter rather than living here: the pan that starts on
-- this screen finishes on the duel's.

local engine = require("waluau:engine")
local render = require("./render")
local ink = require("./ink")
local effect_shaders = require("./effect_shaders")
local spell_launch = require("./spell_launch")
local spells = require("./spells/spell")
local city_map = require("./city_map")
local layout = require("./layout")

export type MenuAction = "none" | "start" | "start-rush"

type Stage = "main" | "spell"

export type State = {
    clock: f64,
    cursor: i32,
    help_open: bool,
    stage: Stage,
    rush_choice: bool,
    spell_cursor: i32
}

const ITEM_NEW_RUN: i32 = 0
const ITEM_BOSS_RUSH: i32 = 1
const ITEM_HOW_TO_PLAY: i32 = 2
const ITEM_COUNT: i32 = 3
const SPELL_COUNT: i32 = 4
const ITEM_W: f64 = 380.0
const ITEM_H: f64 = 52.0
const ITEM_PITCH: f64 = 60.0

function item_x(viewport: layout.State): f64
    return viewport.center_x - ITEM_W * 0.5
end

function title_y(viewport: layout.State): f64
    return viewport.height * 0.3533333333
end

function item_start_y(viewport: layout.State): f64
    return viewport.height * 0.51
end

function State.new(): State
    return {
        clock = 0.0,
        cursor = ITEM_NEW_RUN,
        help_open = false,
        stage = "main",
        rush_choice = false,
        spell_cursor = 0,
    }
end

-- Coming back to the menu is coming back to a different job: a new city, and a
-- new route through it for the next run to walk.
function State:reset(city: city_map.State): unit
    self.clock = 0.0
    self.cursor = ITEM_NEW_RUN
    self.help_open = false
    self.stage = "main"
    self.rush_choice = false
    self.spell_cursor = 0
    city:regenerate()
end

-- Aim the map: the title sits over a city sweeping past, and the spell list
-- sits over the vendor the run sets out from. Nothing else changes, so the
-- change of stage is a pan rather than a cut.
function State:update(city: city_map.State, dt: f64): unit
    self.clock += dt
    city:show()
    if self.stage == "spell" then
        city:follow(city_map.shop_stop(1))
    else
        city:drift()
    end
end

-- The starting spell the current selection names, as the rules' spell kind.
function State:selected_spell(): spells.SpellKind
    local kind: spells.SpellKind? = spells.SpellKind.from(self.spell_cursor + 1)
    assert(kind ~= nil)
    return kind::spells.SpellKind
end

function item_top(viewport: layout.State, index: i32): f64
    return item_start_y(viewport) + (index::f64) * ITEM_PITCH
end

-- Both stages share the option-list geometry; only the row count differs.
function item_at(viewport: layout.State, x: f64, y: f64, count: i32): i32
    local left: f64 = item_x(viewport)
    if x < left or x > left + ITEM_W then return -1 end
    for index = 0::i32, count - 1 do
        local top: f64 = item_top(viewport, index)
        if y >= top and y <= top + ITEM_H then return index end
    end
    return -1
end

function stage_item_count(state: State): i32
    if state.stage == "spell" then return SPELL_COUNT end
    return ITEM_COUNT
end

-- Starting a run — standard cadence or boss rush — first routes through the
-- spell list; HOW TO PLAY is presentation the menu can satisfy itself with
-- the shared help modal.
function activate(state: State, item: i32): MenuAction
    if item == ITEM_NEW_RUN or item == ITEM_BOSS_RUSH then
        state.stage = "spell"
        state.rush_choice = item == ITEM_BOSS_RUSH
        -- The shared cursor now points into the spell list; keep it on the
        -- remembered spell so the halo and the eventual pick agree.
        state.cursor = state.spell_cursor
        return "none"
    end
    state.help_open = true
    return "none"
end

function start_action(state: State): MenuAction
    if state.rush_choice then return "start-rush" end
    return "start"
end

function draw_item(state: State, viewport: layout.State, graphics: engine.Graphics, index: i32, label: string, idle_ink: string): unit
    local top: f64 = item_top(viewport, index)
    local left: f64 = item_x(viewport)
    local edge: string = "#52525b"
    local tone: string = idle_ink
    if index == state.cursor then
        edge = "#fbbf24"
        tone = "#fbbf24"
        -- A halo breathing around the selected option: the one moving element
        -- on an otherwise still screen, pointing at what Enter will do.
        local grow: f64 = 4.0 + math.sin(state.clock * 2.4) * 2.5
        graphics:set_color("#fbbf24")
        graphics:set_line_width(1.0)
        graphics:stroke_rectangle(
            left - grow, top - grow, ITEM_W + grow * 2.0, ITEM_H + grow * 2.0)
    end
    ink.panel(graphics, left, top, ITEM_W, ITEM_H, "#17171c", edge)
    ink.text_centered(graphics, label, viewport.center_x, top + 33.0, 15, tone)
end

function draw_spell_stage(state: State, viewport: layout.State, graphics: engine.Graphics): unit
    local heading_y: f64 = title_y(viewport)
    -- The pick lasts the whole run, not one duel, and the gold it burns is
    -- the same pool the next duel inherits. It is bought at a vendor like
    -- every later upgrade, which is what the map behind this list is showing.
    local mode: string = "NEW RUN"
    if state.rush_choice then mode = "BOSS RUSH" end
    ink.text_centered(graphics, "CHOOSE YOUR START", viewport.center_x, heading_y, 30, "#fbbf24")
    ink.text_centered(
        graphics, "CHOOSE A STARTING SPELL", viewport.center_x, heading_y + 34.0, 12, "#d4d4d8")
    ink.text_centered(
        graphics, mode .. "   CARRIED ALL RUN, EVERY USE COSTS 5 GOLD",
        viewport.center_x, heading_y + 56.0, 11, "#a1a1aa")
    for spell = 0::i32, SPELL_COUNT - 1 do
        local kind: spells.SpellKind? = spells.SpellKind.from(spell + 1)
        assert(kind ~= nil)
        local active: spells.SpellKind = kind::spells.SpellKind
        -- Each idle row wears its spell's colour, so the list doubles as the
        -- legend for the effect the pick will launch in the duel.
        draw_item(
            state, viewport, graphics, spell,
            spell_launch.name(active), spell_launch.color(active))
    end
    ink.text_centered(
        graphics, "ARROWS MOVE   ENTER OR CLICK SELECTS   ESC GOES BACK",
        viewport.center_x, viewport.height - 34.0, 11, "#a1a1aa")
end

-- `ready` reports whether the required flip sound has finished loading. The
-- menu accepts NEW RUN either way — the duel screen already waits for its
-- resources — but says so instead of promising a start that visibly stalls.
--
-- The city map is already on the screen by the time this runs: the entry module
-- draws it under whichever screen is live, so what is drawn here is only the
-- list standing over it.
function State:draw(viewport: layout.State, graphics: engine.Graphics, effects: effect_shaders.EffectShaders, ready: bool): unit
    local heading_y: f64 = title_y(viewport)
    if self.help_open then
        -- The same help card the duel shows, drawn on a surface with no card
        -- back: nothing on it is a card.
        render.draw_help(
            { graphics = graphics, effects = effects, card_back = nil }, viewport)
        return
    end
    if self.stage == "spell" then
        draw_spell_stage(self, viewport, graphics)
        return
    end
    ink.text_centered(graphics, "ANTE MAGIC", viewport.center_x, heading_y, 52, "#fbbf24")
    ink.text_centered(
        graphics, "DUEL AFTER DUEL ON ONE POOL OF GOLD. ONE HAND EACH",
        viewport.center_x, heading_y + 40.0, 12, "#d4d4d8")
    -- The four colors of magic as small gold motes under the title, in the
    -- same colours the footer legend uses in the duel.
    for i = 0::i32, 3::i32 do
        graphics:set_color(ink.color_ink(i))
        graphics:fill_circle(viewport.center_x - 54.0 + (i::f64) * 36.0, heading_y + 70.0, 6.0)
    end

    draw_item(self, viewport, graphics, ITEM_NEW_RUN, "NEW RUN", "#8a8a92")
    -- A boss battle deals seven cards and never replaces a spent one. The
    -- standard run reaches one every third duel; the rush is nothing else.
    -- Both labels carry the stakes without needing their own help screen.
    draw_item(self, viewport, graphics, ITEM_BOSS_RUSH, "BOSS RUSH", "#8a8a92")
    draw_item(self, viewport, graphics, ITEM_HOW_TO_PLAY, "HOW TO PLAY", "#8a8a92")
    if self.cursor == ITEM_NEW_RUN then
        ink.text_centered(
            graphics, "EVERY THIRD DUEL IS A CHALLENGE. GOLD CARRIES OVER",
            viewport.center_x, item_top(viewport, ITEM_COUNT) + 16.0, 10, "#fbbf24")
    elseif self.cursor == ITEM_BOSS_RUSH then
        ink.text_centered(
            graphics, "EVERY DUEL IS A CHALLENGE. SEVEN CARDS, NO REPLACEMENTS",
            viewport.center_x, item_top(viewport, ITEM_COUNT) + 16.0, 10, "#fbbf24")
    elseif not ready then
        ink.text_centered(
            graphics, "PREPARING THE DUEL", viewport.center_x, item_top(viewport, ITEM_COUNT) + 16.0, 10, "#8a8a92")
    end

    ink.text_centered(
        graphics, "ARROWS MOVE   ENTER OR CLICK SELECTS",
        viewport.center_x, viewport.height - 76.0, 11, "#a1a1aa")
    ink.text_centered(
        graphics, "IN A DUEL: ? HELP   H HISTORY   R RESTART RUN   M MENU",
        viewport.center_x, viewport.height - 52.0, 10, "#8a8a92")
end

function State:keypressed(key: string): MenuAction
    if self.help_open then
        if key == "Enter" or key == " " or key == "Escape" or key == "?" or key == "/" then
            self.help_open = false
        end
        return "none"
    end
    if self.stage == "spell" then
        if key == "Escape" then
            self.stage = "main"
            self.cursor = ITEM_NEW_RUN
            if self.rush_choice then self.cursor = ITEM_BOSS_RUSH end
            return "none"
        end
        if key == "ArrowUp" or key == "w" or key == "W" then
            self.spell_cursor -= 1
            if self.spell_cursor < 0 then self.spell_cursor = SPELL_COUNT - 1 end
            self.cursor = self.spell_cursor
            return "none"
        end
        if key == "ArrowDown" or key == "s" or key == "S" then
            self.spell_cursor = (self.spell_cursor + 1) % SPELL_COUNT
            self.cursor = self.spell_cursor
            return "none"
        end
        if key == "Enter" or key == " " then
            return start_action(self)
        end
        return "none"
    end
    if key == "ArrowUp" or key == "w" or key == "W" then
        self.cursor -= 1
        if self.cursor < 0 then self.cursor = ITEM_COUNT - 1 end
        return "none"
    end
    if key == "ArrowDown" or key == "s" or key == "S" then
        self.cursor = (self.cursor + 1) % ITEM_COUNT
        return "none"
    end
    if key == "?" or key == "/" then
        self.help_open = true
        return "none"
    end
    if key == "Enter" or key == " " then
        return activate(self, self.cursor)
    end
    return "none"
end

function State:mousemoved(viewport: layout.State, x: f64, y: f64): unit
    if self.help_open then return end
    local item: i32 = item_at(viewport, x, y, stage_item_count(self))
    if item < 0 then return end
    self.cursor = item
    if self.stage == "spell" then self.spell_cursor = item end
end

function State:mousepressed(viewport: layout.State, x: f64, y: f64, button: i32): MenuAction
    if button ~= 1 then return "none" end
    if self.help_open then
        self.help_open = false
        return "none"
    end
    local item: i32 = item_at(viewport, x, y, stage_item_count(self))
    if item < 0 then return "none" end
    self.cursor = item
    if self.stage == "spell" then
        self.spell_cursor = item
        return start_action(self)
    end
    return activate(self, item)
end
