-- Ante Magic's retained menu screen. Its node tree and interaction router are
-- constructed once with the screen, then presented with the current viewport
-- and resource readiness each frame. The small public interface turns browser
-- input into menu actions; list geometry, hover, focus, and activation stay
-- together behind that seam.
local render = require("./render")
local ink = require("./ink")
local plate = require("./plate")
local spell_launch = require("./spell_launch")
local spells = require("./spells/spell")
local city_map = require("./city_map")
local viewport_layout = require("./layout")
local ui = require("./ui/node")
local ui_layout = require("./ui/layout")
local interaction = require("./ui/interaction")
local control_chip = require("./entities/control_chip")

export type MenuAction = "none" | "start" | "start-rush"

type Stage = "main" | "spell"
type Model = {
    clock: f64,
    cursor: i32,
    help_open: bool,
    stage: Stage,
    rush_choice: bool,
    spell_cursor: i32,
    pending_action: MenuAction
}
type Presentation = { model: Model, viewport: viewport_layout.State, ready: bool }

export type State = {
    model: Model,
    presentation: Presentation,
    root: ui.Node,
    main_list: ui.Node,
    spell_list: ui.Node,
    back: ui.Node,
    help: ui.Node,
    router: interaction.Router,
    main_scope: i32,
    spell_scope: i32,
    help_scope: i32,
    main_targets: {interaction.Target},
    spell_targets: {interaction.Target}
}

const ITEM_NEW_RUN: i32 = 0
const ITEM_BOSS_RUSH: i32 = 1
const ITEM_HOW_TO_PLAY: i32 = 2
const ITEM_COUNT: i32 = 3
const SPELL_COUNT: i32 = 4
const BACK_INSET: f64 = 16.0
const ITEM_W: f64 = 380.0
const ITEM_H: f64 = 52.0
const ITEM_PITCH: f64 = 60.0

-- The selection glow: how far it stands off the plate at rest, how much
-- further the breath carries it, and how many rings it is drawn in.
const SELECT_INK: string = "#fbbf24"
const SELECT_REACH: f64 = 6.0
const SELECT_SWELL: f64 = 5.0
const SELECT_RINGS: i32 = 6
const SELECT_STRENGTH: f64 = 0.55

-- The four school orbs under the title.
const ORB_RADIUS: f64 = 6.0
const ORB_GLOW: f64 = 9.0
const ORB_RINGS: i32 = 5
const ORB_STRENGTH: f64 = 0.40
const ORB_RIM: f64 = 0.75
const ORB_CROWN: f64 = 1.45

function title_y(viewport: viewport_layout.State): f64
    return viewport.height * 0.3533333333
end

function item_start_y(viewport: viewport_layout.State): f64
    return viewport.height * 0.51
end

function list_style(viewport: viewport_layout.State): ui_layout.Style
    return ui_layout.style(
        "column",
        ITEM_PITCH - ITEM_H,
        "start",
        "center",
        ui_layout.edges(0.0, item_start_y(viewport), 0.0, 0.0)
    )
end

function start_action(model: Model): MenuAction
    if model.rush_choice then
        return "start-rush"
    end
    return "start"
end

-- Backing out of the spell list returns to whichever run the list was opened
-- from, so the choice that led here is still the one under the cursor.
function leave_spell_stage(model: Model): unit
    model.stage = "main"
    model.cursor = ITEM_NEW_RUN
    if model.rush_choice then
        model.cursor = ITEM_BOSS_RUSH
    end
end

function activate_main(model: Model, item: i32): unit
    if item == ITEM_NEW_RUN or item == ITEM_BOSS_RUSH then
        model.stage = "spell"
        model.rush_choice = item == ITEM_BOSS_RUSH
        model.cursor = model.spell_cursor
        return
    end
    model.help_open = true
end

function draw_item(
    presentation: Presentation,
    surface: ui.Surface,
    bounds: ui_layout.Rect,
    index: i32,
    label: string,
    idle_ink: string
): unit
    local model: Model = presentation.model
    local graphics = surface.graphics
    local edge: string = "#52525b"
    local tone: string = idle_ink
    if index == model.cursor then
        edge = "#fbbf24"
        tone = "#fbbf24"
        -- The selection breathes as a glow standing off the plate rather than
        -- as one hairline creeping in and out. Both the reach and the strength
        -- ride the same breath, so the pulse is the light changing rather than
        -- a line moving.
        local breath: f64 = 0.5 + math.sin(model.clock * 2.4) * 0.5
        graphics:set_color(SELECT_INK)
        plate.aura(
            graphics,
            bounds.x,
            bounds.y,
            bounds.width,
            bounds.height,
            SELECT_REACH + breath * SELECT_SWELL,
            SELECT_RINGS,
            SELECT_STRENGTH * (0.65 + breath * 0.35)
        )
    end
    ink.panel(graphics, bounds.x, bounds.y, bounds.width, bounds.height, "#17171c", edge)
    ink.text_centered(graphics, label, bounds.x + bounds.width * 0.5, bounds.y + 33.0, 15, tone)
end

function main_row(presentation: Presentation, index: i32, label: string): ui.Node
    return ui.Node.sized(
        ITEM_W,
        ITEM_H,
        function(surface: ui.Surface, bounds: ui_layout.Rect): unit
            if presentation.model.stage ~= "main" or presentation.model.help_open then
                return
            end
            draw_item(presentation, surface, bounds, index, label, "#8a8a92")
        end
    )
end

function spell_row(presentation: Presentation, index: i32): ui.Node
    local kind: spells.SpellKind? = spells.SpellKind.from(index + 1)
    assert(kind ~= nil)
    local spell: spells.SpellKind = kind::spells.SpellKind
    return ui.Node.sized(
        ITEM_W,
        ITEM_H,
        function(surface: ui.Surface, bounds: ui_layout.Rect): unit
            if presentation.model.stage ~= "spell" or presentation.model.help_open then
                return
            end
            draw_item(
                presentation,
                surface,
                bounds,
                index,
                spell_launch.name(spell),
                spell_launch.color(spell)
            )
        end
    )
end

function draw_chrome(presentation: Presentation, surface: ui.Surface, bounds: ui_layout.Rect): unit
    local model: Model = presentation.model
    if model.help_open then
        return
    end
    local viewport: viewport_layout.State = presentation.viewport
    local graphics = surface.graphics
    local heading_y: f64 = title_y(viewport)
    if model.stage == "spell" then
        local mode: string = "NEW RUN"
        if model.rush_choice then
            mode = "BOSS RUSH"
        end
        ink.text_centered(
            graphics,
            "CHOOSE YOUR START",
            viewport.center_x,
            heading_y,
            30,
            "#fbbf24"
        )
        ink.text_centered(
            graphics,
            "CHOOSE A STARTING SPELL",
            viewport.center_x,
            heading_y + 34.0,
            12,
            "#d4d4d8"
        )
        ink.text_centered(
            graphics,
            mode .. "   CARRIED ALL RUN, EVERY USE COSTS 5 GOLD",
            viewport.center_x,
            heading_y + 56.0,
            11,
            "#a1a1aa"
        )
        ink.text_centered(
            graphics,
            "ARROWS MOVE   ENTER OR CLICK SELECTS   ESC GOES BACK",
            viewport.center_x,
            viewport.height - 34.0,
            11,
            "#a1a1aa"
        )
        return
    end

    ink.text_centered(graphics, "ANTE MAGIC", viewport.center_x, heading_y, 52, "#fbbf24")
    ink.text_centered(
        graphics,
        "DUEL AFTER DUEL ON ONE POOL OF GOLD. ONE HAND EACH",
        viewport.center_x,
        heading_y + 40.0,
        12,
        "#d4d4d8"
    )
    -- The four schools under the title are lit orbs, not dots: each one glows
    -- into the field around it and is domed toward the same light the rest of
    -- the menu's chrome is lit by.
    for i = 0::i32, 3::i32 do
        local orb_x: f64 = viewport.center_x - 54.0 + (i::f64) * 36.0
        local orb_y: f64 = heading_y + 70.0
        graphics:set_color(ink.color_ink(i))
        plate.halo(
            graphics,
            orb_x,
            orb_y,
            ORB_RADIUS,
            ORB_RADIUS + ORB_GLOW,
            ORB_RINGS,
            ORB_STRENGTH
        )
        plate.dome(graphics, orb_x, orb_y, ORB_RADIUS, ORB_RIM, ORB_CROWN)
    end

    local detail_y: f64 = item_start_y(viewport) + (ITEM_COUNT::f64) * ITEM_PITCH + 16.0
    if model.cursor == ITEM_NEW_RUN then
        ink.text_centered(
            graphics,
            "EVERY THIRD DUEL IS A CHALLENGE. GOLD CARRIES OVER",
            viewport.center_x,
            detail_y,
            10,
            "#fbbf24"
        )
    elseif model.cursor == ITEM_BOSS_RUSH then
        ink.text_centered(
            graphics,
            "EVERY DUEL IS A CHALLENGE. KEEP SEVEN CARDS IN HAND",
            viewport.center_x,
            detail_y,
            10,
            "#fbbf24"
        )
    elseif not presentation.ready then
        ink.text_centered(
            graphics,
            "PREPARING THE DUEL",
            viewport.center_x,
            detail_y,
            10,
            "#8a8a92"
        )
    end
    ink.text_centered(
        graphics,
        "ARROWS MOVE   ENTER OR CLICK SELECTS",
        viewport.center_x,
        viewport.height - 76.0,
        11,
        "#a1a1aa"
    )
    ink.text_centered(
        graphics,
        "IN A DUEL: ? HELP   H HISTORY   R RESTART RUN   M MENU",
        viewport.center_x,
        viewport.height - 52.0,
        10,
        "#8a8a92"
    )
end

function row_handlers(model: Model, stage: Stage, index: i32): interaction.Handlers
    local callbacks: interaction.Handlers = interaction.handlers()
    callbacks.on_focus = function(): unit
        if stage == "spell" then
            model.spell_cursor = index
        end
        model.cursor = index
    end
    callbacks.on_activate = function(): unit
        if stage == "spell" then
            model.spell_cursor = index
            model.cursor = index
            model.pending_action = start_action(model)
        else
            activate_main(model, index)
        end
    end
    return callbacks
end

function State.new(): State
    local model: Model = {
        clock = 0.0,
        cursor = ITEM_NEW_RUN,
        help_open = false,
        stage = "main",
        rush_choice = false,
        spell_cursor = 0,
        pending_action = "none"
    }
    local presentation: Presentation = {
        model = model,
        viewport = viewport_layout.current(),
        ready = false
    }
    local main_rows: {ui.Node} = {
        main_row(presentation, ITEM_NEW_RUN, "NEW RUN"),
        main_row(presentation, ITEM_BOSS_RUSH, "BOSS RUSH"),
        main_row(presentation, ITEM_HOW_TO_PLAY, "HOW TO PLAY")
    }
    local spell_rows: {ui.Node} = {}
    for index = 0::i32, SPELL_COUNT - 1 do
        table.insert(spell_rows, spell_row(presentation, index))
    end
    local chrome: ui.Node = ui.Node.measured(
        function(graphics: ui.Graphics?, into: ui_layout.Intrinsic): unit
        end,
        function(surface: ui.Surface, bounds: ui_layout.Rect): unit
            draw_chrome(presentation, surface, bounds)
        end
    )
    local main_list: ui.Node = ui.Node.flow(main_rows, list_style(presentation.viewport))
    local spell_list: ui.Node = ui.Node.flow(spell_rows, list_style(presentation.viewport))
    local help: ui.Node = ui.Node.measured(
        function(graphics: ui.Graphics?, into: ui_layout.Intrinsic): unit
        end,
        function(surface: ui.Surface, bounds: ui_layout.Rect): unit
            if model.help_open then
                render.draw_help(surface, presentation.viewport)
            end
        end
    )
    -- The way back off the spell list, in the corner rather than in the list:
    -- a fifth row would push the list off the bottom of a phone-sized board,
    -- and this is chrome rather than one of the choices. Escape still does the
    -- same thing, so the chip carries that key on its face.
    local back: ui.Node = control_chip.gated(
        "ESC BACK",
        function(): bool
            return model.stage == "spell" and not model.help_open
        end
    ):padded(BACK_INSET, BACK_INSET)
    local back_layer: ui.Node = ui.Node.across({ justify = "start", align = "end" }, {back})
    local root: ui.Node = ui.Node.layer({chrome, main_list, spell_list, back_layer, help})
    local router: interaction.Router = interaction.Router.new(root)
    local main_scope: i32 = router:add_scope("column", true)
    local spell_scope: i32 = router:add_scope("column", true)
    local help_scope: i32 = router:add_scope("column", true)
    local main_targets: {interaction.Target} = {}
    for index, row in main_rows do
        table.insert(
            main_targets,
            router:add(row, main_scope, true, row_handlers(model, "main", index - 1))
        )
    end
    local spell_targets: {interaction.Target} = {}
    for index, row in spell_rows do
        table.insert(
            spell_targets,
            router:add(row, spell_scope, true, row_handlers(model, "spell", index - 1))
        )
    end
    -- Out of the focus ring: the arrow keys walk the spells, and Escape is
    -- already the key this stands for.
    local back_callbacks: interaction.Handlers = interaction.handlers()
    back_callbacks.on_activate = function(): unit
        leave_spell_stage(model)
    end
    router:add(back, spell_scope, false, back_callbacks)
    local help_callbacks: interaction.Handlers = interaction.handlers()
    help_callbacks.on_activate = function(): unit
        model.help_open = false
    end
    router:add(help, help_scope, true, help_callbacks)
    main_list:set_visible(true)
    spell_list:set_visible(false)
    back:set_visible(false)
    help:set_visible(false)
    router:activate_scope(main_scope)
    return {
        model = model,
        presentation = presentation,
        root = root,
        main_list = main_list,
        spell_list = spell_list,
        back = back,
        help = help,
        router = router,
        main_scope = main_scope,
        spell_scope = spell_scope,
        help_scope = help_scope,
        main_targets = main_targets,
        spell_targets = spell_targets
    }
end

function State:sync_scope(): unit
    local model: Model = self.model
    self.main_list:set_visible(not model.help_open and model.stage == "main")
    self.spell_list:set_visible(not model.help_open and model.stage == "spell")
    self.back:set_visible(not model.help_open and model.stage == "spell")
    self.help:set_visible(model.help_open)
    if model.help_open then
        self.router:activate_scope(self.help_scope)
    elseif model.stage == "spell" then
        local desired: i32 = model.spell_cursor
        self.router:activate_scope(self.spell_scope)
        self.router:focus(self.spell_targets[desired + 1].key)
    else
        local desired: i32 = model.cursor
        self.router:activate_scope(self.main_scope)
        self.router:focus(self.main_targets[desired + 1].key)
    end
end

function State:take_action(): MenuAction
    local action: MenuAction = self.model.pending_action
    self.model.pending_action = "none"
    return action
end

function State:reset(city: city_map.State): unit
    local model: Model = self.model
    model.clock = 0.0
    model.cursor = ITEM_NEW_RUN
    model.help_open = false
    model.stage = "main"
    model.rush_choice = false
    model.spell_cursor = 0
    model.pending_action = "none"
    self:sync_scope()
    city:regenerate()
end

function State:update(city: city_map.State, dt: f64): unit
    self.model.clock += dt
    city:show()
    if self.model.stage == "spell" then
        city:follow(city_map.shop_stop(1))
    else
        city:drift()
    end
end

function State:selected_spell(): spells.SpellKind
    local kind: spells.SpellKind? = spells.SpellKind.from(self.model.spell_cursor + 1)
    assert(kind ~= nil)
    return kind::spells.SpellKind
end

function State:draw(viewport: viewport_layout.State, surface: ui.Surface, ready: bool): unit
    self.presentation.viewport = viewport
    self.presentation.ready = ready
    local style: ui_layout.Style = list_style(viewport)
    self.main_list:present_style(style)
    self.spell_list:present_style(style)
    self:sync_scope()
    self.root:draw(surface, 0.0, 0.0, viewport.width, viewport.height)
end

function State:keypressed(key: string): MenuAction
    local model: Model = self.model
    if model.help_open then
        if key == "Enter" or key == " " or key == "Escape" or key == "?" or key == "/" then
            model.help_open = false
            self:sync_scope()
        end
        return "none"
    end
    if model.stage == "spell" and key == "Escape" then
        leave_spell_stage(model)
        self:sync_scope()
        return "none"
    end
    if model.stage == "main" and (key == "?" or key == "/") then
        model.help_open = true
        self:sync_scope()
        return "none"
    end
    local routed: string = key
    if key == "w" or key == "W" then
        routed = "ArrowUp"
    end
    if key == "s" or key == "S" then
        routed = "ArrowDown"
    end
    self.router:key_pressed(routed)
    self:sync_scope()
    return self:take_action()
end

function State:mousemoved(x: f64, y: f64): unit
    local hit: i32 = self.router:pointer_move(x, y)
    if hit >= 0 then
        self.router:focus(hit)
    end
end

function State:mousepressed(x: f64, y: f64, button: i32): unit
    if button ~= 1 then
        return
    end
    self.router:pointer_down(x, y, button)
end

function State:mousereleased(x: f64, y: f64, button: i32): MenuAction
    if button ~= 1 then
        return "none"
    end
    self.router:pointer_up(x, y, button)
    self:sync_scope()
    return self:take_action()
end
