-- The menu screen shown before a heist begins: a cursor-driven option list,
-- not a tap-through splash. It owns the pre-game presentation and turns raw
-- input into screen actions; the entry module decides what starting the heist
-- means (audio unlock, fresh deal, screen switch), so this module stays free
-- of resource and rules concerns.
--
-- Picking NEW RUN or BOSS RUSH leads to a second list: the starting spell the
-- robbers bring on the job. That list is the run's first fence — a street
-- vendor standing at the mouth of the route — so this screen aims the shared
-- city map at it and lets the map pan there from the drifting view the title
-- sits over. Only confirming a spell emits a start action, so the entry module
-- always receives a complete mode-plus-spell choice. Both entries start a run —
-- a sequence of vaults sharing one mana pool; they differ only in how often a
-- vault is fought as a boss battle.
--
-- The map itself belongs to the entry module and outlives this screen, which is
-- why it arrives as a parameter rather than living here: the pan that starts on
-- this screen finishes on the heist's.

local engine = require("waluau:engine")
local render = require("./render")
local city_map = require("./city_map")
local layout = require("./layout")

type State = {
    clock: f64,
    cursor: i32,
    help_open: bool,
    stage: i32,
    rush_choice: bool,
    spell_cursor: i32
}

const ACTION_NONE: i32 = 0
const ACTION_START: i32 = 1
const ACTION_START_RUSH: i32 = 2

const STAGE_MAIN: i32 = 0
const STAGE_SPELL: i32 = 1

const ITEM_NEW_RUN: i32 = 0
const ITEM_BOSS_RUSH: i32 = 1
const ITEM_HOW_TO_PLAY: i32 = 2
const ITEM_COUNT: i32 = 3
const SPELL_COUNT: i32 = 4
const ITEM_W: f64 = 380.0
const ITEM_H: f64 = 52.0
const ITEM_PITCH: f64 = 60.0

function item_x(viewport: layout.State): f64
    return viewport.center_x - ITEM_W * 0.5
end

function title_y(viewport: layout.State): f64
    return viewport.height * 0.3533333333
end

function item_start_y(viewport: layout.State): f64
    return viewport.height * 0.51
end

function new(): State
    return {
        clock = 0.0,
        cursor = ITEM_NEW_RUN,
        help_open = false,
        stage = STAGE_MAIN,
        rush_choice = false,
        spell_cursor = 0,
    }
end

-- Coming back to the menu is coming back to a different job: a new city, and a
-- new route through it for the next run to walk.
function reset(state: State, city: city_map.State): unit
    state.clock = 0.0
    state.cursor = ITEM_NEW_RUN
    state.help_open = false
    state.stage = STAGE_MAIN
    state.rush_choice = false
    state.spell_cursor = 0
    city_map.regenerate(city)
end

-- Aim the map: the title sits over a city sweeping past, and the spell list
-- sits over the vendor the run sets out from. Nothing else changes, so the
-- change of stage is a pan rather than a cut.
function update(state: State, city: city_map.State, dt: f64): unit
    state.clock += dt
    city_map.show(city)
    if state.stage == STAGE_SPELL then
        city_map.follow(city, city_map.fence_stop(1))
    else
        city_map.drift(city)
    end
end

-- The starting spell the current selection names, as the rules' spell kind.
function selected_spell(state: State): i32
    return state.spell_cursor + 1
end

function item_top(viewport: layout.State, index: i32): f64
    return item_start_y(viewport) + (index::f64) * ITEM_PITCH
end

-- Both stages share the option-list geometry; only the row count differs.
function item_at(viewport: layout.State, x: f64, y: f64, count: i32): i32
    local left: f64 = item_x(viewport)
    if x < left or x > left + ITEM_W then return -1 end
    for index = 0::i32, count - 1 do
        local top: f64 = item_top(viewport, index)
        if y >= top and y <= top + ITEM_H then return index end
    end
    return -1
end

function stage_item_count(state: State): i32
    if state.stage == STAGE_SPELL then return SPELL_COUNT end
    return ITEM_COUNT
end

-- Starting a run — standard cadence or boss rush — first routes through the
-- spell list; HOW TO PLAY is presentation the menu can satisfy itself with
-- the shared help modal.
function activate(state: State, item: i32): i32
    if item == ITEM_NEW_RUN or item == ITEM_BOSS_RUSH then
        state.stage = STAGE_SPELL
        state.rush_choice = item == ITEM_BOSS_RUSH
        -- The shared cursor now points into the spell list; keep it on the
        -- remembered spell so the halo and the eventual pick agree.
        state.cursor = state.spell_cursor
        return ACTION_NONE
    end
    state.help_open = true
    return ACTION_NONE
end

function start_action(state: State): i32
    if state.rush_choice then return ACTION_START_RUSH end
    return ACTION_START
end

function draw_item(state: State, viewport: layout.State, graphics: engine.Graphics, index: i32, label: string, idle_ink: string): unit
    local top: f64 = item_top(viewport, index)
    local left: f64 = item_x(viewport)
    local edge: string = "#52525b"
    local ink: string = idle_ink
    if index == state.cursor then
        edge = "#fbbf24"
        ink = "#fbbf24"
        -- A halo breathing around the selected option: the one moving element
        -- on an otherwise still screen, pointing at what Enter will do.
        local grow: f64 = 4.0 + math.sin(state.clock * 2.4) * 2.5
        graphics:set_color("#fbbf24")
        graphics:set_line_width(1.0)
        graphics:stroke_rectangle(
            left - grow, top - grow, ITEM_W + grow * 2.0, ITEM_H + grow * 2.0)
    end
    render.panel(graphics, left, top, ITEM_W, ITEM_H, "#17171c", edge)
    render.text_centered(graphics, label, viewport.center_x, top + 33.0, 15, ink)
end

function draw_spell_stage(state: State, viewport: layout.State, graphics: engine.Graphics): unit
    local heading_y: f64 = title_y(viewport)
    -- The pick lasts the whole run, not one vault, and the mana it burns is
    -- the same pool the next vault inherits. It is bought at a vendor like
    -- every later upgrade, which is what the map behind this list is showing.
    local mode: string = "NEW RUN"
    if state.rush_choice then mode = "BOSS RUSH" end
    render.text_centered(graphics, "THE FIRST FENCE", viewport.center_x, heading_y, 30, "#fbbf24")
    render.text_centered(
        graphics, "CHOOSE A STARTING SPELL", viewport.center_x, heading_y + 34.0, 12, "#d4d4d8")
    render.text_centered(
        graphics, mode .. "   CARRIED ALL RUN, EVERY CAST COSTS 5 MANA",
        viewport.center_x, heading_y + 56.0, 11, "#a1a1aa")
    for spell = 0::i32, SPELL_COUNT - 1 do
        local kind: i32 = spell + 1
        -- Each idle row wears its spell's colour, so the list doubles as the
        -- legend for the effect the pick will launch in the vault.
        draw_item(
            state, viewport, graphics, spell,
            render.spell_name(kind), render.power_color(kind))
    end
    render.text_centered(
        graphics, "ARROWS MOVE   ENTER OR CLICK SELECTS   ESC GOES BACK",
        viewport.center_x, viewport.height - 34.0, 11, "#a1a1aa")
end

-- `ready` reports whether the required flip sound has finished loading. The
-- menu accepts NEW RUN either way — the heist screen already waits for its
-- resources — but says so instead of promising a start that visibly stalls.
--
-- The city map is already on the screen by the time this runs: the entry module
-- draws it under whichever screen is live, so what is drawn here is only the
-- list standing over it.
function draw(state: State, viewport: layout.State, graphics: engine.Graphics, effects: render.EffectShaders, ready: bool): unit
    local heading_y: f64 = title_y(viewport)
    if state.help_open then
        render.draw_help(graphics, effects)
        return
    end
    if state.stage == STAGE_SPELL then
        draw_spell_stage(state, viewport, graphics)
        return
    end
    render.text_centered(graphics, "ANTE MAGIC", viewport.center_x, heading_y, 52, "#fbbf24")
    render.text_centered(
        graphics, "VAULT AFTER VAULT ON ONE POOL OF MANA. FIVE BREACHES EACH",
        viewport.center_x, heading_y + 40.0, 12, "#d4d4d8")
    -- The four schools of magic as small mana motes under the title, in the
    -- same colours the footer legend uses in the vault.
    for i = 0::i32, 3::i32 do
        graphics:set_color(render.school_color(i))
        graphics:fill_circle(viewport.center_x - 54.0 + (i::f64) * 36.0, heading_y + 70.0, 6.0)
    end

    draw_item(state, viewport, graphics, ITEM_NEW_RUN, "NEW RUN", "#8a8a92")
    -- A boss battle deals eleven relics and never replaces a spent one. The
    -- standard run reaches one every third vault; the rush is nothing else.
    -- Both labels carry the stakes without needing their own help screen.
    draw_item(state, viewport, graphics, ITEM_BOSS_RUSH, "BOSS RUSH", "#8a8a92")
    draw_item(state, viewport, graphics, ITEM_HOW_TO_PLAY, "HOW TO PLAY", "#8a8a92")
    if state.cursor == ITEM_NEW_RUN then
        render.text_centered(
            graphics, "EVERY THIRD VAULT IS A BOSS BATTLE. MANA CARRIES OVER",
            viewport.center_x, item_top(viewport, ITEM_COUNT) + 16.0, 10, "#fbbf24")
    elseif state.cursor == ITEM_BOSS_RUSH then
        render.text_centered(
            graphics, "EVERY VAULT A BOSS. ELEVEN RELICS, NO REPLACEMENTS",
            viewport.center_x, item_top(viewport, ITEM_COUNT) + 16.0, 10, "#fbbf24")
    elseif not ready then
        render.text_centered(
            graphics, "PREPARING THE VAULT", viewport.center_x, item_top(viewport, ITEM_COUNT) + 16.0, 10, "#8a8a92")
    end

    render.text_centered(
        graphics, "ARROWS MOVE   ENTER OR CLICK SELECTS",
        viewport.center_x, viewport.height - 76.0, 11, "#a1a1aa")
    render.text_centered(
        graphics, "IN THE VAULT: ? HELP   H LEDGER   R RESTART RUN   M MENU",
        viewport.center_x, viewport.height - 52.0, 10, "#8a8a92")
end

function keypressed(state: State, key: string): i32
    if state.help_open then
        if key == "Enter" or key == " " or key == "Escape" or key == "?" or key == "/" then
            state.help_open = false
        end
        return ACTION_NONE
    end
    if state.stage == STAGE_SPELL then
        if key == "Escape" then
            state.stage = STAGE_MAIN
            state.cursor = ITEM_NEW_RUN
            if state.rush_choice then state.cursor = ITEM_BOSS_RUSH end
            return ACTION_NONE
        end
        if key == "ArrowUp" or key == "w" or key == "W" then
            state.spell_cursor -= 1
            if state.spell_cursor < 0 then state.spell_cursor = SPELL_COUNT - 1 end
            state.cursor = state.spell_cursor
            return ACTION_NONE
        end
        if key == "ArrowDown" or key == "s" or key == "S" then
            state.spell_cursor = (state.spell_cursor + 1) % SPELL_COUNT
            state.cursor = state.spell_cursor
            return ACTION_NONE
        end
        if key == "Enter" or key == " " then
            return start_action(state)
        end
        return ACTION_NONE
    end
    if key == "ArrowUp" or key == "w" or key == "W" then
        state.cursor -= 1
        if state.cursor < 0 then state.cursor = ITEM_COUNT - 1 end
        return ACTION_NONE
    end
    if key == "ArrowDown" or key == "s" or key == "S" then
        state.cursor = (state.cursor + 1) % ITEM_COUNT
        return ACTION_NONE
    end
    if key == "?" or key == "/" then
        state.help_open = true
        return ACTION_NONE
    end
    if key == "Enter" or key == " " then
        return activate(state, state.cursor)
    end
    return ACTION_NONE
end

function mousemoved(state: State, viewport: layout.State, x: f64, y: f64): unit
    if state.help_open then return end
    local item: i32 = item_at(viewport, x, y, stage_item_count(state))
    if item < 0 then return end
    state.cursor = item
    if state.stage == STAGE_SPELL then state.spell_cursor = item end
end

function mousepressed(state: State, viewport: layout.State, x: f64, y: f64, button: i32): i32
    if button ~= 1 then return ACTION_NONE end
    if state.help_open then
        state.help_open = false
        return ACTION_NONE
    end
    local item: i32 = item_at(viewport, x, y, stage_item_count(state))
    if item < 0 then return ACTION_NONE end
    state.cursor = item
    if state.stage == STAGE_SPELL then
        state.spell_cursor = item
        return start_action(state)
    end
    return activate(state, item)
end

return {
    new = new,
    reset = reset,
    update = update,
    draw = draw,
    keypressed = keypressed,
    mousemoved = mousemoved,
    mousepressed = mousepressed,
    selected_spell = selected_spell,
    action_none = ACTION_NONE,
    action_start = ACTION_START,
    action_boss_rush = ACTION_START_RUSH,
}
