-- One independently managed fragment program behind a small lifecycle
-- interface. The effect registry coordinates programs as data instead of
-- duplicating poll, rebuild, diagnostic, and release branches per shader.
local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local shader_sources = require("waluau:engine/shader_sources")

type Graphics = engine.Graphics
type Source = shader_sources.Source
export type State = {
    label: string,
    required: bool,
    source: Source,
    text: string,
    ready: bool,
    error: string,
    shader: graphics_module.Shader?
}

function State.new(name: string, label: string, required: bool): State
    return {
        label = label,
        required = required,
        source = shader_sources.open(name),
        text = "",
        ready = false,
        error = "",
        shader = nil
    }
end

-- Consume one source revision and report whether this program must rebuild.
function State:poll(): bool
    local update: shader_sources.SourceUpdate = self.source:poll()
    if not update.changed then
        return false
    end
    if update.ok then
        self.text = update.source
        self.ready = true
        self.error = ""
    else
        self.ready = false
        self.error = self.label .. " " .. update.error.code .. ": " .. update.error.message
    end
    return true
end

function rebuild(
    state: State,
    graphics: Graphics,
    vertex_text: string
): graphics_module.ShaderResult
    if state.shader == nil then
        return graphics:create_shader(vertex_text, state.text)
    end
    return graphics:replace_shader(state.shader::graphics_module.Shader, vertex_text, state.text)
end

function State:refresh(
    graphics: Graphics,
    vertex_text: string,
    vertex_changed: bool,
    source_changed: bool
): unit
    if not self.ready or (not vertex_changed and not source_changed) then
        return
    end
    local result: graphics_module.ShaderResult = rebuild(self, graphics, vertex_text)
    if result.ok then
        self.shader = result.shader
        self.error = ""
    else
        self.error = self.label .. " " .. result.error.code .. ": " .. result.error.message
    end
end

function State:release(graphics: Graphics): unit
    local shader: graphics_module.Shader? = self.shader
    if shader ~= nil then
        graphics:release_shader(shader::graphics_module.Shader)
    end
    self.shader = nil
end
