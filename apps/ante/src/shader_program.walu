-- One Vite-managed fragment program behind a small application interface.
-- The host owns compilation, HMR, and the WebGLProgram; Ante keeps only the
-- current generation's typed shader view and presentation diagnostics.
local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")

type Graphics = engine.Graphics
export type State = {
    label: string,
    required: bool,
    imported: extern,
    revision: i32,
    error: string,
    shader: graphics_module.Shader?
}

function State.new(imported: extern, label: string, required: bool): State
    return {
        label = label,
        required = required,
        imported = imported,
        revision = -1,
        error = "",
        shader = nil
    }
end

-- Refresh this Wasm generation's view of the host-owned program. The host
-- compiles only new source revisions, so this is cheap to call every frame.
-- Returning a revision change lets callers invalidate shader-derived caches.
function State:refresh(graphics: Graphics): bool
    local previous_revision: i32 = self.revision
    local result: graphics_module.ShaderResult = graphics:compile_shader(self.imported)
    if result.ok then
        self.shader = result.shader
        self.revision = result.shader.revision
        self.error = ""
    else
        self.error = self.label .. " " .. result.error.code .. ": " .. result.error.message
    end
    return self.revision ~= previous_revision
end

function State:release(graphics: Graphics): unit
    local shader: graphics_module.Shader? = self.shader
    if shader ~= nil then
        graphics:release_shader(shader::graphics_module.Shader)
    end
    self.shader = nil
end
