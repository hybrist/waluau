-- DOM-free city map behind every screen of a run: the streets and rooftops the
-- player cross, the route they take through them, and the camera that follows
-- it. One module owns that picture for the menu, for the shop between duels,
-- and for the dive into a duel, so the map never restarts when the screen
-- does.
--
-- The route alternates the two things a run is made of: a street vendor the
-- player shop at, then a house whose duel they enter. Stop 0 is the vendor
-- the starting spell is picked from, which is why the menu's spell list and
-- every later shop stand on the same map at their own corner of the city.
--
-- Nothing here knows what a duel contains or what a shop sells. It knows
-- where the next stop is, how far along the way the duel stands, and how much
-- of the screen the map is currently worth — `cover`, which is 1.0 while the
-- map is the picture and 0.0 once the duel has taken it over. Its private
-- random stream keeps generation and animation timing from changing the duel's
-- deck shuffle.
local generator = require("./city_generator")
local route = require("./city_route")
export type Stop = route.Stop
export type Point = route.Point
export type State = {
    scenery_seed: i32,
    route: route.State,
    travel: f64,
    target: f64,
    drifting: bool,
    dive: f64,
    dive_target: f64,
    camera_x: f64,
    camera_y: f64,
    view_width: f64,
    view_height: f64,
    anchor_x: f64,
    anchor_y: f64,
    zoom: f64,
    cover: f64,
    street: f64,
    rng: f64,
    pan_clock: f64
}

-- Wide enough that a route of a dozen stops is a journey across a city rather
-- than a lap of one neighbourhood.
const CITY_WIDTH: f64 = 2560.0
const CITY_HEIGHT: f64 = 1720.0
const RANDOM_MODULUS: f64 = 2147483647.0
const RANDOM_MULTIPLIER: f64 = 16807.0

-- The map is read at 1:1, and a duel is gone into rather than cut to: the
-- camera closes on the house until the room behind its door is the whole
-- screen, which is where the duel's own backdrop takes over. Nine octaves of
-- doubling would be a telescope; five puts a map marker across the screen.
const MAP_ZOOM: f64 = 1.0
const DIVE_OCTAVES: f64 = 4.9
-- Where on the screen the stop being followed sits. A map screen carries a
-- list of options down its left — the shop's offers, the menu's spells — so
-- the stop stands a fixed length in from the left edge, clear of that column;
-- a canvas too narrow for that length parks it at three-quarters of whatever
-- width there is instead. The length is fixed rather than a share of the
-- width. Near the city's edges the camera clamps to keep the landscape in
-- view. Vertically the stop rides just past half the live height. A duel is
-- dived into head-on, so the push walks both anchors back to the middle.
const STOP_ANCHOR_X: f64 = 736.0
const STOP_ANCHOR_MAX_SHARE_X: f64 = 0.75
const STOP_ANCHOR_SHARE_Y: f64 = 0.51
-- The two movements a screen change is made of, each walked at a steady pace so
-- it takes the same time every time: the player cross a block to the door, and
-- then the camera goes in after them. They never overlap — a push into a house
-- the duel has not reached yet would be a push into the road outside it.
const STOP_SECONDS: f64 = 0.62
const DIVE_SECONDS: f64 = 0.80
-- How much of the dive is spent purely closing on the house. Until then the map
-- keeps the whole screen: the push in is the thing being shown, not something
-- to fade through. The rest of it hands over to the duel's own backdrop, by
-- which time the door is wide enough to be the frame around it.
const DIVE_HANDOVER: f64 = 0.5
const CAMERA_RATE: f64 = 3.2
-- How far past the stop being walked to the route is kept generated. Three
-- duels of dashed road ahead is enough to read as a plan without the map
-- promising a run that has an end.
const LOOKAHEAD: i32 = 7

function random(state: State): f64
    local next: f64 = state.rng * RANDOM_MULTIPLIER
    next = next - math.floor(next / RANDOM_MODULUS) * RANDOM_MODULUS
    if next < 1.0 then
        next = 1.0
    end
    state.rng = next
    return (next - 1.0) / (RANDOM_MODULUS - 1.0)
end

function generate_route(seed: i32): route.State
    local city = generator.generate(
        { seed = seed, bridges = 1, river = true, relief = 1.0, size = 90, density = 85 }
    )
    local path = route.State.new(city, CITY_WIDTH, CITY_HEIGHT)
    path:ensure_stops(LOOKAHEAD)
    return path
end

function State:ensure_stops(count: i32): unit
    self.route:ensure_stops(count)
end

-- Duels and vendors alternate along the route: the run sets out from the
-- vendor standing before its first duel, so duel `n` is stop 2n-1 and the
-- shop before it stop 2n-2. Duel numbers are the run's, and 1-based.
function duel_stop(duel: i32): i32
    return duel * 2 - 1
end

function shop_stop(duel: i32): i32
    return duel * 2 - 2
end

function State:stop_count(): i32
    return #self.route.stops
end

-- Which duel a stop is, counting from one. Vendor stops answer with the duel
-- they stand before, which is the one the map is on its way to.
function stop_duel(index: i32): i32
    return math.floor((index::f64) / 2.0)::i32 + 1
end

-- Where on the route a fractional stop position stands. Past the generated end
-- it stands on the last stop there is, so a caller that reads ahead of the walk
-- never falls off the route.
function State:position_at(travel: f64): Point
    return self.route:position_at(travel)
end

function State:position(): Point
    return self:position_at(self.travel)
end

-- Two long, slightly different periods make a gentle sweep over the map that
-- does not visibly repeat. This is the menu's camera: no route is being walked,
-- so the city itself is the subject.
function drift_center_x(state: State): f64
    local span: f64 = CITY_WIDTH - state.view_width
    if span < 0.0 then
        span = 0.0
    end
    return CITY_WIDTH * 0.5 + math.sin(state.pan_clock * 0.021) * span * 0.42
end

function drift_center_y(state: State): f64
    local span: f64 = CITY_HEIGHT - state.view_height
    if span < 0.0 then
        span = 0.0
    end
    return CITY_HEIGHT * 0.5 + math.sin(state.pan_clock * 0.017) * span * 0.42
end

function camera_target(state: State): Point
    if state.drifting then
        return { x = drift_center_x(state), y = drift_center_y(state) }
    end
    return state:position()
end

-- Two raised to a power, for the octaves the push in walks. The language has no
-- pow, and this only ever runs over a bounded, gentle range: whole octaves are
-- doublings, and the fraction is a cubic fit of 2^f that is exact at both ends
-- and inside a twentieth of a percent between them.
function two_to_the(power: f64): f64
    local whole: f64 = math.floor(power)
    local fraction: f64 = power - whole
    local scale: f64 = 1.0 + fraction * (0.6931472 + fraction * (0.2402265 + fraction * 0.0666263))
    for _ = 1, whole::i32 do
        scale = scale * 2.0
    end
    return scale
end

-- Ease in and out, so a movement leaves and arrives without a jolt.
function smooth(progress: f64): f64
    if progress <= 0.0 then
        return 0.0
    end
    if progress >= 1.0 then
        return 1.0
    end
    return progress * progress * (3.0 - 2.0 * progress)
end

-- Everything the dive is worth, read off its one progress value. Zoom walks
-- octaves because that is what a closing camera looks like; the map keeps the
-- screen until the handover; and the anchor comes back to the middle over the
-- same stretch, because the list it was standing clear of is going with it.
function dive_zoom(dive: f64): f64
    return MAP_ZOOM * two_to_the(DIVE_OCTAVES * smooth(dive))
end

function dive_cover(dive: f64): f64
    if dive <= DIVE_HANDOVER then
        return 1.0
    end
    return 1.0 - smooth((dive - DIVE_HANDOVER) / (1.0 - DIVE_HANDOVER))
end

-- The stop anchor for the live viewport: the fixed length in from the left,
-- unless the canvas is too narrow to hold it, and the height's share down.
function stop_anchor_x(state: State): f64
    return math.min(STOP_ANCHOR_X, state.view_width * STOP_ANCHOR_MAX_SHARE_X)
end

function stop_anchor_y(state: State): f64
    return state.view_height * STOP_ANCHOR_SHARE_Y
end

function dive_anchor_x(state: State, dive: f64): f64
    local map_anchor: f64 = stop_anchor_x(state)
    local vault_anchor: f64 = state.view_width * 0.5
    return map_anchor + (vault_anchor - map_anchor) * smooth(dive / DIVE_HANDOVER)
end

function dive_anchor_y(state: State, dive: f64): f64
    local map_anchor: f64 = stop_anchor_y(state)
    local vault_anchor: f64 = state.view_height * 0.5
    return map_anchor + (vault_anchor - map_anchor) * smooth(dive / DIVE_HANDOVER)
end

-- Put every value the dive owns where its progress says they are. `street` is
-- the second reading of the same movement: `cover` is how much of the screen
-- the map is worth, and this is how much of it is the street the duel is
-- standing on rather than a house it is inside. A screen that belongs to a stop
-- — a shop's offers — is worth this much, so it waits for the camera to come
-- back out instead of arriving while the room is still the picture.
function apply_dive(state: State): unit
    state.zoom = dive_zoom(state.dive)
    state.cover = dive_cover(state.dive)
    state.street = 1.0 - smooth(state.dive)
    state.anchor_x = dive_anchor_x(state, state.dive)
    state.anchor_y = dive_anchor_y(state, state.dive)
end

-- Keep the visible rectangle inside the generated city, so no screen edge ever
-- shows the void past the last street. `before` and `after` are how much city
-- the anchor has on each side of it, which is not half the view once the anchor
-- is off centre.
function clamp_camera(value: f64, limit: f64, before: f64, after: f64): f64
    if before + after >= limit then
        return limit * 0.5
    end
    if value < before then
        return before
    end
    if value > limit - after then
        return limit - after
    end
    return value
end

function clamp_camera_x(state: State, value: f64): f64
    return clamp_camera(
        value,
        CITY_WIDTH,
        state.anchor_x / state.zoom,
        (state.view_width - state.anchor_x) / state.zoom
    )
end

function clamp_camera_y(state: State, value: f64): f64
    return clamp_camera(
        value,
        CITY_HEIGHT,
        state.anchor_y / state.zoom,
        (state.view_height - state.anchor_y) / state.zoom
    )
end

function approach(dt: f64, rate: f64): f64
    local step: f64 = dt * rate
    if step > 1.0 then
        return 1.0
    end
    if step < 0.0 then
        return 0.0
    end
    return step
end

-- Walk a value toward a goal at a steady pace, landing on it exactly. Movements
-- spelled this way take the same time however far into them a frame lands,
-- which is what lets two of them be given the screen in turn.
function step_toward(value: f64, goal: f64, step: f64): f64
    if value < goal then
        local next: f64 = value + step
        if next > goal then
            return goal
        end
        return next
    end
    if value > goal then
        local next: f64 = value - step
        if next < goal then
            return goal
        end
        return next
    end
    return goal
end

-- Stand on the stop being headed for, with the camera already over it. Ground
-- the map is moved across without being walked is ground nobody watched it
-- cover.
function place_camera(state: State): unit
    state.travel = state.target
    local aim: Point = camera_target(state)
    state.camera_x = clamp_camera_x(state, aim.x)
    state.camera_y = clamp_camera_y(state, aim.y)
end

-- Put every moving value where it is heading, the dive included. Used when the
-- map is not the picture on screen and therefore has nothing to animate for,
-- which is what a development snapshot coming back is.
function State:settle(): unit
    self.dive = self.dive_target
    apply_dive(self)
    place_camera(self)
end

function State.new(seed: i32): State
    local value: f64 = math.floor(math.abs(seed::f64))
    value = value - math.floor(value / (RANDOM_MODULUS - 1.0)) * (RANDOM_MODULUS - 1.0)
    local state: State = {
        scenery_seed = (value + 1.0)::i32,
        route = generate_route((value + 1.0)::i32),
        travel = 0.0,
        target = 0.0,
        drifting = true,
        dive = 0.0,
        dive_target = 0.0,
        camera_x = CITY_WIDTH * 0.5,
        camera_y = CITY_HEIGHT * 0.5,
        -- Unmeasured until the first frame: the entry module resizes the map
        -- from the live canvas before anything is drawn, and the settle below
        -- recomputes the anchors from whatever the view is.
        view_width = 1.0,
        view_height = 1.0,
        anchor_x = 0.0,
        anchor_y = 0.0,
        zoom = MAP_ZOOM,
        cover = 1.0,
        street = 1.0,
        rng = value + 1.0,
        pan_clock = 0.0
    }
    state:settle()
    return state
end

-- The city camera consumes the live logical viewport. Resizing does not
-- regenerate the route or move the party; it only changes how much city is
-- visible and where a duel dive converges.
function State:resize(width: f64, height: f64): unit
    if width < 1.0 or height < 1.0 then
        return
    end
    if self.view_width == width and self.view_height == height then
        return
    end
    self.view_width = width
    self.view_height = height
    apply_dive(self)
    self.camera_x = clamp_camera_x(self, self.camera_x)
    self.camera_y = clamp_camera_y(self, self.camera_y)
end

-- A different city, and a different route through it. The menu redraws the map
-- between runs; a run in progress never does, because the ground it has already
-- covered is the progress it is showing.
--
-- The dissolve is left running rather than settled: abandoning a duel for the
-- menu asks for the map back, and the new city rises over the board being left
-- instead of replacing it between two frames.
function State:regenerate(): unit
    self.pan_clock = 0.0
    self.drifting = true
    self.dive_target = 0.0
    random(self)
    self.scenery_seed = self.rng::i32
    self.route = generate_route(self.scenery_seed)
    self.travel = 0.0
    self.target = 0.0
    place_camera(self)
end

-- Let go of the route: the camera sweeps the city instead of watching the
-- duel. This is the menu's view of the map.
function State:drift(): unit
    self.drifting = true
end

-- Head for that stop, walking the streets in between. Everything past it that
-- the map will need to draw as road ahead is generated here.
function State:follow(stop: i32): unit
    self.drifting = false
    self.target = stop::f64
    self:ensure_stops(stop + LOOKAHEAD)
end

-- Stand on that stop with no walk at all: the route is being restarted, not
-- travelled.
function State:warp(stop: i32): unit
    self:follow(stop)
    place_camera(self)
end

-- Come back out of the house, or go into it. Both are a request for the whole
-- movement — the camera closing or opening, and the map handing the screen over
-- or taking it back; `settle` is how a caller asks for it to have already
-- happened.
function State:show(): unit
    self.dive_target = 0.0
end

function State:hide(): unit
    self.dive_target = 1.0
end

-- Whether the map still owes the screen anything. A duel that has fully taken
-- over does not pay for a map draw underneath it.
function State:visible(): bool
    return self.cover > 0.002
end

function State:update(dt: f64): unit
    self.pan_clock += dt

    -- The two movements take turns. On the map the duel walks; once it is on
    -- the doorstep the camera goes in after it, and coming back out the camera
    -- opens up before anyone steps into the street. Either way what is on the
    -- screen is one thing moving rather than two.
    --
    -- A camera part way out of one house and asked into another it has not
    -- walked to yet owes both movements, and the walk is the one that has to
    -- happen first: it needs the street. So the dive finishes coming out
    -- before the turn passes to the walk. Leaving a shop during the pull-out
    -- that opened it is exactly that — without this the two would each wait
    -- for the other and the map would stand still forever.
    if self.dive <= 0.0 then
        self.travel = step_toward(self.travel, self.target, dt / STOP_SECONDS)
    end
    local dive_aim: f64 = self.dive_target
    if self.travel ~= self.target and self.dive < self.dive_target then
        dive_aim = 0.0
    end
    self.dive = step_toward(self.dive, dive_aim, dt / DIVE_SECONDS)
    apply_dive(self)

    -- The camera closes at a steady speed on the screen rather than in the
    -- city: a lag of a few paces is a soft follow on the map and half a room
    -- out of frame once the push in has magnified it twentyfold.
    local aim: Point = camera_target(self)
    local pan: f64 = approach(dt, CAMERA_RATE * self.zoom)
    self.camera_x += (aim.x - self.camera_x) * pan
    self.camera_y += (aim.y - self.camera_y) * pan
    self.camera_x = clamp_camera_x(self, self.camera_x)
    self.camera_y = clamp_camera_y(self, self.camera_y)
end

return {
    stop_duel = stop_duel,
    duel_stop = duel_stop,
    shop_stop = shop_stop,
    width = CITY_WIDTH,
    height = CITY_HEIGHT,
    lookahead = LOOKAHEAD
}
