local game_ = require("./game")
local run_ = require("./run")
local item_ = require("./items/item")
local scroll_ = require("./items/scroll")
local spell_ = require("./spells/spell")

type RunState = run_.State
type SpellKind = spell_.SpellKind
type Item = item_.Item

const DEFAULT_SHOP_ITEM_COUNT = 2

export type Slot = { item: Item, price: number, sold: bool }

export type State = { open: bool, slots: {Slot}, cursor: i32 }

const SNAPSHOT_SCHEMA: string = "duel-shop-v5"

function State.new(run: RunState): State
    return { open = true, slots = roll_slots(run), cursor = 0 }
end

function all_scroll_items(run: RunState): {Item}
    local scrolls: {Item} = {}
    for name, kind in pairs(spell_.SpellKind) do
        -- TODO: current level + 1 where "not known" is level 0
        local level = 1
        table.insert(scrolls, scroll_.SpellScroll.new(kind, 1)::Item)
    end
    return scrolls
end

function roll_slots(run: RunState): {Slot}
    local slots: {Slot} = {}

    -- For now: Pick only spells.
    -- TODO: Only pick spells when there's space for a new spell.
    local items = all_scroll_items(run)

    for i = 1, DEFAULT_SHOP_ITEM_COUNT do
        local index = math.random(#items) - 1
        local item = table.remove(items, index)
        table.insert(slots, { item = item, price = item:base_price(run), sold = false })
    end

    return slots
end

-- Returns true if this exits the shop.
function State:confirm_choice(run: RunState): bool
    if self.cursor < 0 or self.cursor >= #self.slots then
        return true
    end

    local slot = self.slots[self.cursor]
    local item = slot.item
    if not slot.sold and item:can_use(run) then
        item:use(run)
        run.gold -= slot.price::i32
        slot.sold = true
    end
    return false
end

function State:move(run: RunState, delta: i32): unit
    local count = #self.slots + 1
    self.cursor = (self.cursor + delta + count) % count
end

-- Returns true if this wraps up the shopping episode.
function State:keypressed(run: RunState, key: string): bool
    if key == "ArrowUp" or key == "w" or key == "W" then
        self:move(run, -1)
        return false
    end
    if key == "ArrowDown" or key == "s" or key == "S" then
        self:move(run, 1)
        return false
    end

    if key == "Enter" or key == " " then
        return self:confirm_choice(run)
    end

    return key == "Escape"
end

