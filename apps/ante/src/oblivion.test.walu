require("waluau:vitest")
local game = require("./game")
local fixture = require("../test/game_fixture")
local screen_ = require("./game_screen")
local choreography = require("./choreography")
local spells = require("./spells/spell")

type GameState = game.State
type Presentation = choreography.State

function ready(): screen_.State
    local screen = screen_.State.new()
    screen.run.spells = {
        spells.Spell.new(spells.SpellKind.MindRead, 1),
        spells.Spell.new(spells.SpellKind.Oblivion, 1)
    }
    screen:deal_vault()
    screen.presentation:skip()
    fixture.set_player_points(screen.rules, 100)
    return screen
end

function same_card(left: game.Card, right: game.Card): bool
    return left.rank == right.rank and left.suit == right.suit
end

describe(
    "Oblivion",
    function()
        it(
            "destroys exposed cards on both sides, preserves concealed cards and the center, and refills from the deck",
            function()
                math.randomseed(149)
                local screen = ready()
                local hand: {game.Card} = {}
                for held in screen.rules:view().player_hand do
                    table.insert(hand, held.card)
                end
                fixture.arrange_player(screen.rules, hand, {true, false, true, false, false})
                local middle: {game.Card} = {}
                for card in screen.rules:view().middle do
                    table.insert(middle, card)
                end
                screen:arm_spell(0)
                local targets = screen.rules:oblivion_targets()
                expect(#targets):toBe(7)
                local deck = screen.rules:view().deck_count
                screen.ui.play_picks = {0, 1}
                screen.ui.swap_hand = {0}
                screen.ui.swap_table_cards = {1}
                screen:arm_spell(1)
                local after = screen.rules:view()
                expect(#after.player_hand):toBe(5)
                expect(#after.computer_hand):toBe(5)
                expect(after.deck_count):toBe(deck - 7)
                expect(screen.rules:gold()):toBe(90)
                expect(screen.rules:is_finished()):toBe(false)
                expect(#screen.rules:oblivion_targets()):toBe(0)
                expect(#screen.ui.play_picks):toBe(0)
                expect(#screen.ui.swap_hand):toBe(0)
                expect(#screen.ui.swap_table_cards):toBe(0)
                expect(screen.ui.cast_slot == nil):toBe(true)
                for index, card in middle do
                    expect(same_card(after.middle[index], card)):toBe(true)
                end
                for index in {2::i32, 4::i32, 5::i32} do
                    expect(same_card(after.player_hand[index].card, hand[index])):toBe(true)
                end
                expect(#screen.presentation.session.discards):toBe(7)
                for index, target in targets do
                    expect(
                        same_card(screen.presentation.session.discards[index], target.card)
                    ):toBe(true)
                    local replacement = after.player_hand[1]
                    if target.opponent then
                        replacement = after.computer_hand[target.index + 1]
                    else
                        replacement = after.player_hand[target.index + 1]
                    end
                    expect(same_card(replacement.card, target.card)):toBe(false)
                    expect(replacement.known):toBe(false)
                    expect(replacement.revealed == true):toBe(false)
                end
                expect(screen.presentation:is_animating()):toBe(true)
                local saved = screen.rules:snapshot()
                local restored: GameState? = GameState.restore(saved)
                expect(restored ~= nil):toBe(true)
                if restored ~= nil then
                    expect((restored::GameState):snapshot()):toBe(saved)
                end
                local visuals: Presentation? = Presentation.restore(screen.presentation:snapshot())
                expect(visuals ~= nil):toBe(true)
                if visuals ~= nil then
                    expect(#(visuals::Presentation).session.discards):toBe(7)
                    expect((visuals::Presentation):is_animating()):toBe(false)
                end
                screen.presentation:skip()
                screen:arm_spell(1)
                expect(screen.rules:gold()):toBe(90)
                expect(#screen.presentation.session.discards):toBe(7)
            end
        )

        it(
            "refuses a fresh concealed hand and an unaffordable cast without changing anything",
            function()
                local screen = ready()
                local before = screen.rules:snapshot()
                screen:arm_spell(1)
                expect(screen.rules:snapshot()):toBe(before)
                screen:arm_spell(0)
                fixture.set_player_points(screen.rules, 4)
                local exposed = screen.rules:snapshot()
                screen:arm_spell(1)
                expect(screen.rules:snapshot()):toBe(exposed)
                expect(#screen.presentation.session.discards):toBe(0)
            end
        )

        it(
            "destroys opponent cards exposed by an exchange without requiring Mind Read",
            function()
                local screen = ready()
                fixture.arrange_arch_mage(
                    screen.rules,
                    {{ rank = 2, suit = 1 }, { rank = 4, suit = 2 }, { rank = 6, suit = 3 }},
                    {
                        { rank = 10, suit = 0 },
                        { rank = 11, suit = 0 },
                        { rank = 12, suit = 0 },
                        { rank = 13, suit = 0 },
                        { rank = 14, suit = 0 }
                    }
                )
                screen.rules:resolve_swap({}, {})
                local targets = screen.rules:oblivion_targets()
                expect(#targets):toBe(3)
                for target in targets do
                    expect(target.opponent):toBe(true)
                    expect(
                        screen.rules:view().computer_hand[target.index + 1].revealed == true
                    ):toBe(false)
                end
                screen:arm_spell(1)
                expect(#screen.presentation.session.discards):toBe(3)
                expect(#screen.rules:oblivion_targets()):toBe(0)
                expect(screen.rules:gold()):toBe(95)
            end
        )

        it(
            "refills even a fully revealed boss hand and does not scale destruction by level",
            function()
                local rules = GameState.new(
                    true,
                    {
                        spells.Spell.new(spells.SpellKind.MindRead, 1),
                        spells.Spell.new(spells.SpellKind.Oblivion, 9)
                    },
                    50
                )
                expect(rules:cast_spell(0, -1)):toBe(true)
                local deck = rules:view().deck_count
                expect(#rules:oblivion_targets()):toBe(7)
                expect(rules:cast_spell(1, -1)):toBe(true)
                expect(#rules:view().computer_hand):toBe(7)
                expect(#rules:view().player_hand):toBe(7)
                expect(rules:view().deck_count):toBe(deck - 7)
                expect(rules:is_finished()):toBe(false)
                expect(#rules:oblivion_targets()):toBe(0)
            end
        )

        it(
            "refuses the whole cast if the deck cannot refill every exposed slot",
            function()
                local screen = ready()
                local casts: i32 = 0
                while casts < 20 do
                    expect(screen.rules:cast_spell(0, -1)):toBe(true)
                    if not screen.rules:can_cast(1) then
                        break
                    end
                    expect(screen.rules:cast_spell(1, -1)):toBe(true)
                    casts += 1
                end
                expect(casts > 0 and casts < 20):toBe(true)
                expect(screen.rules:view().deck_count < #screen.rules:oblivion_targets()):toBe(true)
                local before = screen.rules:snapshot()
                expect(screen.rules:cast_spell(1, -1)):toBe(false)
                expect(screen.rules:snapshot()):toBe(before)
            end
        )
    end
)
