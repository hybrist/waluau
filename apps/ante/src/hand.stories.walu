-- The player's card hand as a layout laboratory. Unlike a card story, this
-- is about the relationship between several cards: their shared centre,
-- overlap, arc, tilt, parting, and stacking states.
local storybook = require("waluau:engine/storybook")
local game = require("./game")
local ui = require("./ui/node")
local ui_story = require("./ui/story")
local card = require("./entities/card")
local hand_fan = require("./entities/hand_fan")

const WIDTH: u32 = 900
const HEIGHT: u32 = 420
const BACKGROUND: string = "#0b0b12"
local book = ui_story.Book.new()

type Position = "none" | "first" | "left-middle" | "middle" | "right-middle" | "last"
local hand_count = storybook.range("count", 5, 1, 11, 1)
local hand_selected = storybook.select(
    "selected",
    "none"::Position,
    {
        storybook.choice("None", "none"::Position),
        storybook.choice("First", "first"::Position),
        storybook.choice("Left of middle", "left-middle"::Position),
        storybook.choice("Middle", "middle"::Position),
        storybook.choice("Right of middle", "right-middle"::Position),
        storybook.choice("Last", "last"::Position)
    }
)
local hand_focused = storybook.select(
    "focused",
    "none"::Position,
    {
        storybook.choice("None", "none"::Position),
        storybook.choice("First", "first"::Position),
        storybook.choice("Left of middle", "left-middle"::Position),
        storybook.choice("Middle", "middle"::Position),
        storybook.choice("Right of middle", "right-middle"::Position),
        storybook.choice("Last", "last"::Position)
    }
)

local function card_at(index: i32): game.Card
    return { rank = 14 - index, suit = (index % 4) }
end

-- State controls name useful positions instead of raw indices, so they keep
-- meaning as the count changes. For an even hand, Middle is the left of the
-- two central cards.
local function controlled_index(choice: Position, count: i32): i32
    if choice == "none" then
        return -1
    end
    if choice == "first" then
        return 0
    end
    if choice == "last" then
        return count - 1
    end
    local middle: i32 = math.floor(((count - 1)::f64) * 0.5)::i32
    if choice == "left-middle" then
        middle -= 1
        if middle < 0 then
            middle = 0
        end
    elseif choice == "right-middle" then
        middle += 1
        if middle >= count then
            middle = count - 1
        end
    end
    return middle
end

local function hand_values(): ({card.Look}, {f64}, {bool})
    local count: i32 = hand_count.value()
    local selected: i32 = controlled_index(storybook.selected<Position>(hand_selected), count)
    local focused: i32 = controlled_index(storybook.selected<Position>(hand_focused), count)
    local looks: {card.Look} = {}
    local parts: {f64} = {}
    local hidden: {bool} = {}
    for index = 0::i32, count - 1 do
        table.insert(
            looks,
            card.look(card_at(index), index == selected, index == focused, false, false, false)
        )
        table.insert(parts, hand_fan.part_target(index, focused))
        table.insert(hidden, false)
    end
    return looks, parts, hidden
end

local initial_looks: {card.Look} = {card.look(card_at(0), false, false, false, false, false)}
local hand_view: hand_fan.Stateful = hand_fan.Stateful.new(initial_looks, {0.0}, {false})

local function present_hand(): unit
    local looks, parts, hidden = hand_values()
    hand_view:present(looks, parts, hidden)
end

local function hand(): ui.Node
    return hand_view.root
end

storybook.publish(
    {
        storybook.story(
            "Fan",
            book:scene(
                {
                    node = hand,
                    present = present_hand,
                    width = WIDTH,
                    height = HEIGHT,
                    scale = 1.0,
                    background = BACKGROUND
                }
            ),
            {hand_count.declaration, hand_selected.declaration, hand_focused.declaration}
        )
    }
)
