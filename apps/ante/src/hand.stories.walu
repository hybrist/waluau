-- The player's card hand as a layout laboratory. Unlike a card story, this
-- is about the relationship between several cards: their shared centre,
-- overlap, arc, tilt, parting, and stacking states.
local storybook = require("waluau:engine/storybook")
local game = require("./game")
local entity = require("./entity")
local entity_story = require("./entity_story")
local card = require("./entities/card")
local hand_fan = require("./entities/hand_fan")

const WIDTH: u32 = 900
const HEIGHT: u32 = 420
const BACKGROUND: string = "#0b0b12"
local book = entity_story.new()

local function card_at(index: i32): game.Card
    return { rank = 14 - index, suit = index % 4 }
end

-- State controls name useful positions instead of raw indices, so they keep
-- meaning as the count changes. For an even hand, Middle is the left of the
-- two central cards.
-- TODO(waluau-6lc5.5): Read a typed Storybook position choice instead of magic
-- `arg_i32` values; the count-relative index calculation can remain here.
local function controlled_index(choice: i32, count: i32): i32
    if choice == 0 then
        return -1
    end
    if choice == 1 then
        return 0
    end
    if choice == 5 then
        return count - 1
    end
    local middle: i32 = math.floor(((count - 1)::f64) * 0.5)::i32
    if choice == 2 then
        middle -= 1
        if middle < 0 then
            middle = 0
        end
    elseif choice == 4 then
        middle += 1
        if middle >= count then
            middle = count - 1
        end
    end
    return middle
end

local function hand(): entity.Node
    local count: i32 = storybook.arg_i32("count")
    local selected: i32 = controlled_index(storybook.arg_i32("selected"), count)
    local focused: i32 = controlled_index(storybook.arg_i32("focused"), count)
    local looks: {card.Look} = {}
    local parts: {f64} = {}
    local hidden: {bool} = {}
    for index = 0::i32, count - 1 do
        table.insert(
            looks,
            card.look(card_at(index), index == selected, index == focused, false, false, false)
        )
        table.insert(parts, hand_fan.part_target(index, focused))
        table.insert(hidden, false)
    end
    return hand_fan.node(looks, parts, hidden)
end

storybook.publish(
    {
        storybook.story(
            "Fan",
            entity_story.scene(
                book,
                {
                    node = hand,
                    width = WIDTH,
                    height = HEIGHT,
                    scale = 1.0,
                    background = BACKGROUND
                }
            ),
            {
                storybook.range("count", 5, 1, 11, 1),
                storybook.select(
                    "selected",
                    0,
                    {"None", "First", "Left of middle", "Middle", "Right of middle", "Last"}
                ),
                storybook.select(
                    "focused",
                    0,
                    {"None", "First", "Left of middle", "Middle", "Right of middle", "Last"}
                )
            }
        )
    }
)
