-- Ante Magic hosted by the 2D engine. This entry module is intentionally an
-- adapter: it owns the engine session, the shared presentation resources, the
-- city map every screen stands on, and which screen is live. The menu and the
-- duel board each live behind their own screen module; neither knows the other
-- exists.
--
-- The city map is shared rather than owned by a screen because the run crosses
-- it: the menu's title drifts over it, the starting spell is picked at its first
-- vendor, every shop between two duels is another one, and a duel is the
-- house the camera goes into. Drawing it here — under whichever screen is live,
-- and only while it still owes the frame anything — is what makes each of those
-- a pan and a push in rather than a cut.
local engine = require("waluau:engine")
local hot = require("waluau:engine/hot")
local city_map = require("./city_map")
local city_map_render = require("./city_map_render")
local menu = require("./menu")
local game_screen = require("./game_screen")
local ink = require("./ink")
local layout = require("./layout")
local presentation_resources = require("./presentation_resources")
local spells = require("./spells/spell")

const HOT_SNAPSHOT_SCHEMA: string = "duel-hmr-v5"
-- The duel screen's five independently versioned sections.
const HOT_SNAPSHOT_SECTIONS: i32 = 5

type ActiveScreen = "menu" | "game"

-- Hot replacement carries the live screen marker plus one section per duel
-- state module. Packing them as one JSON record keeps restore atomic without
-- making any section understand the others' schemas.
type HotSnapshot = { schema: string, screen: ActiveScreen, sections: {string} }

function play_flip_cues(assets: presentation_resources.State, count: i32): unit
    for _ = 1, count do
        assets:play_flip()
    end
end

function install_ante_magic(): unit
    local screen: ActiveScreen = "menu"
    local menu_state: menu.State = menu.State.new()
    local duel: game_screen.State = game_screen.State.new()
    local city: city_map.State = city_map.State.new(math.random(2147483646))
    local assets: presentation_resources.State = presentation_resources.State.new()
    local function load_assets_async(): i32
        return assets:load_async()
    end

    local function load(): unit
        local loader: thread = coroutine.create(load_assets_async)
        coroutine.resume(loader)
    end

    -- The begin gesture doubles as the browser audio unlock. No reseed: the
    -- host seeds math.random per instance, so each run deals a different
    -- shuffle. sim.test.walu pins its own seeds. `rush` is the menu's choice
    -- between the standard run — where every third duel is a boss battle —
    -- and the boss rush, where every duel is; `spell` is the starting spell
    -- picked on the menu's second list and carried for the whole run.
    local function begin_run(rush: bool, spell: spells.SpellKind): unit
        if not assets:unlock_audio() then
            return
        end
        duel:reset(city, rush, spell)
        screen = "game"
    end

    local function leave_run(): unit
        menu_state:reset(city)
        screen = "menu"
    end

    local function update(dt: f64, input: engine.Input): unit
        -- Whichever screen is live aims the map first, and the map is advanced
        -- once afterwards. A duel whose resources are still loading still gets
        -- to aim, so its walk between two stops keeps time with the run rather
        -- than with the asset loader.
        if screen == "menu" then
            menu_state:update(city, dt)
        else
            duel:steer_city(city)
            if assets:can_update() then
                play_flip_cues(assets, duel:update(city, dt))
            end
        end
        city:update(dt)
    end

    -- Three layers, bottom to top: the duel board, the city map over it, and
    -- the live screen's own list over that. The map is what gives way, so the
    -- board is drawn whenever the map is not the whole picture and skipped once
    -- it is.
    local function draw(graphics: engine.Graphics, alpha: f64): unit
        -- The canvas itself is the viewport. One uniform unit scale preserves
        -- local shape proportions; the logical width and height stay live, so
        -- every screen can place its semantic regions in all available space.
        layout.update(graphics.width, graphics.height)
        local canvas: layout.State = layout.current()
        city:resize(canvas.width, canvas.height)
        graphics:clear("#09090b")
        graphics:push()
        graphics:scale(canvas.scale, canvas.scale)
        assets:prepare(graphics)
        if not assets:draw_failure(graphics) then
            if city.cover < 1.0 then
                duel:draw_vault(assets:surface(graphics))
            end
            if city:visible() then
                -- The menu's map is a drifting view of a city nobody is running,
                -- so it has no last duel to mark.
                local landmark: i32 = -1
                if screen ~= "menu" then
                    landmark = duel:landmark_stop()
                end
                city_map_render.draw(
                    city,
                    graphics,
                    ink.color_ink(city.streak_suit),
                    city.cover,
                    landmark
                )
            end
            if screen == "menu" then
                menu_state:draw(canvas, assets:surface(graphics), assets.sound_finished)
            elseif duel:fence_open() then
                duel:draw_fence(city, canvas, assets:surface(graphics))
            end
        end
        graphics:pop()
    end

    local function menu_action(action: menu.MenuAction): unit
        if action == "start" then
            begin_run(false, menu_state:selected_spell())
        elseif action == "start-rush" then
            begin_run(true, menu_state:selected_spell())
        end
    end

    local function keypressed(key: string): unit
        if #assets.fatal_audio_code > 0 then
            return
        end
        if screen == "menu" then
            menu_action(menu_state:keypressed(key))
            return
        end
        if duel:keypressed(city, key) == "exit" then
            leave_run()
        end
    end

    local function mousemoved(x: f64, y: f64, dx: f64, dy: f64): unit
        if #assets.fatal_audio_code > 0 then
            return
        end
        x = layout.canvas_x(x)
        y = layout.canvas_y(y)
        if screen == "menu" then
            menu_state:mousemoved(x, y)
            return
        end
        duel:mousemoved(x, y)
    end

    local function mousepressed(x: f64, y: f64, button: i32): unit
        if #assets.fatal_audio_code > 0 then
            return
        end
        x = layout.canvas_x(x)
        y = layout.canvas_y(y)
        if screen == "menu" then
            menu_state:mousepressed(x, y, button)
            return
        end
        duel:mousepressed(city, x, y, button)
    end

    local function mousereleased(x: f64, y: f64, button: i32): unit
        if #assets.fatal_audio_code > 0 then
            return
        end
        x = layout.canvas_x(x)
        y = layout.canvas_y(y)
        if screen == "menu" then
            menu_action(menu_state:mousereleased(x, y, button))
            return
        end
        duel:mousereleased(city, x, y, button)
    end

    -- No configured viewport: the canvas takes the browser's space and the
    -- layout module derives everything from whatever size that turns out to
    -- be, frame by frame.
    local session: engine.Session? = engine.start(
        {
            title = "Ante Magic",
            update_hz = 60.0,
            max_frame_seconds = 0.25,
            background = "#09090b",
            canvas_sizing = true
        },
        {
            load = load,
            update = update,
            draw = draw,
            keypressed = keypressed,
            keyreleased = nil,
            mousepressed = mousepressed,
            mousereleased = mousereleased,
            mousemoved = mousemoved
        }
    )

    hot.register(
        {
            snapshot = function(): string
                local payload: HotSnapshot = {
                    schema = HOT_SNAPSHOT_SCHEMA,
                    screen = screen,
                    sections = duel:snapshot()
                }
                return json.pack(payload)
            end,
            restore = function(snapshot_value: string): bool
                local decoded = json.unpack<HotSnapshot>(snapshot_value)
                if decoded == nil then
                    return false
                end
                if decoded.schema ~= HOT_SNAPSHOT_SCHEMA then
                    return false
                end
                -- The screen marker is a literal union, which decodes as a plain
                -- string; an unknown marker is another build's payload.
                if decoded.screen ~= "menu" and decoded.screen ~= "game" then
                    return false
                end
                -- A payload framed by a differently shaped build is a normal
                -- refusal: the sections it holds are not the ones this build
                -- would restore.
                if #decoded.sections ~= HOT_SNAPSHOT_SECTIONS then
                    return false
                end
                local payloads: {string} = decoded.sections
                local restored: game_screen.State? = game_screen.State.restore(
                    payloads[0],
                    payloads[1],
                    payloads[2],
                    payloads[3],
                    payloads[4]
                )
                if restored == nil then
                    return false
                end
                duel = restored::game_screen.State
                menu_state:reset(city)
                screen = decoded.screen
                -- A restored run is set down where it stands rather than played
                -- back to it: the map takes the duel's stop with no walk and no
                -- dissolve left to run.
                if decoded.screen == "game" then
                    duel:place_city(city)
                end
                return true
            end,
            dispose = function(): unit
                local running: engine.Session? = session
                if running ~= nil then
                    (running::engine.Session).suspend()
                    session = nil
                end
                assets:dispose()
            end
        }
    )
end

install_ante_magic()
