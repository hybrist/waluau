-- Arcane Heist hosted by the 2D engine. This entry module is intentionally an
-- adapter: it owns the engine session, the shared presentation resources, and
-- which screen is live. The menu and the heist board each live behind their
-- own screen module; neither knows the other exists.

local engine = require("waluau:engine")
local hot = require("waluau:engine/hot")
local menu = require("./menu")
local game_screen = require("./game_screen")
local snapshot_data = require("./snapshot")
local presentation_resources = require("./presentation_resources")

const HOT_SNAPSHOT_SCHEMA: string = "ante-hmr-v4"
-- The live screen marker plus the heist screen's five sections.
const HOT_SNAPSHOT_SECTIONS: i32 = 6

const SCREEN_MENU: i32 = 0
const SCREEN_GAME: i32 = 1

function play_flip_cues(assets: presentation_resources.State, count: i32): unit
    for _ = 1, count do presentation_resources.play_flip(assets) end
end

function install_arcane_heist(): unit
    local screen: i32 = SCREEN_MENU
    local menu_state: menu.State = menu.new()
    local heist: game_screen.State = game_screen.new()
    local assets: presentation_resources.State = presentation_resources.new()

    local function load_assets_async(): i32
        return presentation_resources.load_async(assets)
    end

    local function load(): unit
        local loader: thread = coroutine.create(load_assets_async)
        coroutine.resume(loader)
    end

    -- The begin gesture doubles as the browser audio unlock. No reseed: the
    -- host seeds math.random per instance, so each run deals a different
    -- shuffle. sim.test.walu pins its own seeds. `rush` is the menu's choice
    -- between the standard run — where every third vault is a boss battle —
    -- and the boss rush, where every vault is; `spell` is the starting spell
    -- picked on the menu's second list and carried for the whole run.
    local function begin_run(rush: bool, spell: i32): unit
        if not presentation_resources.unlock_audio(assets) then return end
        game_screen.reset(heist, rush, spell)
        screen = SCREEN_GAME
    end

    local function leave_run(): unit
        menu.reset(menu_state)
        screen = SCREEN_MENU
    end

    local function update(dt: f64, input: engine.Input): unit
        if screen == SCREEN_MENU then
            menu.update(menu_state, dt)
            return
        end
        if not presentation_resources.can_update(assets) then return end
        play_flip_cues(assets, game_screen.update(heist, dt))
    end

    local function draw(graphics: engine.Graphics, alpha: f64): unit
        presentation_resources.prepare(assets, graphics)
        if presentation_resources.draw_failure(assets, graphics) then return end
        if screen == SCREEN_MENU then
            menu.draw(menu_state, graphics, assets.effects, assets.sound_finished)
            return
        end
        game_screen.draw(heist, graphics, assets.effects, assets.texture)
    end

    local function menu_action(action: i32): unit
        if action == menu.action_start then
            begin_run(false, menu.selected_spell(menu_state))
        elseif action == menu.action_boss_rush then
            begin_run(true, menu.selected_spell(menu_state))
        end
    end

    local function keypressed(key: string): unit
        if #assets.fatal_audio_code > 0 then return end
        if screen == SCREEN_MENU then
            menu_action(menu.keypressed(menu_state, key))
            return
        end
        if game_screen.keypressed(heist, key) == game_screen.action_exit then
            leave_run()
        end
    end

    local function mousemoved(x: f64, y: f64, dx: f64, dy: f64): unit
        if #assets.fatal_audio_code > 0 then return end
        if screen == SCREEN_MENU then
            menu.mousemoved(menu_state, x, y)
            return
        end
        game_screen.mousemoved(heist, x, y)
    end

    local function mousepressed(x: f64, y: f64, button: i32): unit
        if #assets.fatal_audio_code > 0 then return end
        if screen == SCREEN_MENU then
            menu_action(menu.mousepressed(menu_state, x, y, button))
            return
        end
        game_screen.mousepressed(heist, x, y, button)
    end

    local session: engine.Session? = engine.start({
        title = "Arcane Heist",
        width = 960,
        height = 600,
        update_hz = 60.0,
        max_frame_seconds = 0.25,
        background = "#09090b",
    }, {
        load = load,
        update = update,
        draw = draw,
        keypressed = keypressed,
        keyreleased = nil,
        mousepressed = mousepressed,
        mousereleased = nil,
        mousemoved = mousemoved,
    })

    hot.register({
        snapshot = function(): string
            local sections: {string} = { tostring(screen) }
            for section in game_screen.snapshot(heist) do
                table.insert(sections, section)
            end
            return snapshot_data.frame(HOT_SNAPSHOT_SCHEMA, sections)
        end,
        restore = function(snapshot_value: string): bool
            local sections: {string}? = snapshot_data.unframe(
                snapshot_value, HOT_SNAPSHOT_SCHEMA, HOT_SNAPSHOT_SECTIONS)
            if sections == nil then return false end
            local payloads: {string} = sections::{string}
            local screen_token: f64? = tonumber(payloads[0])
            if screen_token == nil then return false end
            local restored_screen: i32 = (screen_token::f64)::i32
            if restored_screen ~= SCREEN_MENU and restored_screen ~= SCREEN_GAME then
                return false
            end
            local restored: game_screen.State? = game_screen.restore(
                payloads[1], payloads[2], payloads[3], payloads[4], payloads[5])
            if restored == nil then return false end
            heist = restored::game_screen.State
            menu.reset(menu_state)
            screen = restored_screen
            return true
        end,
        dispose = function(): unit
            local running: engine.Session? = session
            if running ~= nil then
                (running::engine.Session).suspend()
                session = nil
            end
            presentation_resources.dispose(assets)
        end,
    })
end

install_arcane_heist()
