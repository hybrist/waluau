-- Pure color math behind the gradient shader: the same mixing the GLSL does
-- on the GPU, expressed in Waluau so it can be unit tested.

function mix(a: f64, b: f64, ratio: f64): f64
    return a + (b - a) * ratio
end

function clamp01(value: f64): f64
    if value < 0.0 then return 0.0 end
    if value > 1.0 then return 1.0 end
    return value
end

-- The shader's u_time wave: oscillates in [0, 1].
function wave(time: f64, x: f64): f64
    return 0.5 + 0.5 * math.sin(time * 0.35 + x * 3.2)
end

return {
    mix = mix,
    clamp01 = clamp01,
    wave = wave,
}
