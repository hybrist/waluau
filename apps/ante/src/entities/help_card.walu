-- The help card: what the job is, what the four schools look like, the two
-- phases of a round, what each orb means, and every control. It is a column,
-- which is what it always was — it simply used to be a column written as
-- eighteen y coordinates that had to be kept in order by hand.

local box = require("../box_layout")
local entity = require("../entity")
local modal = require("./modal")
local label = require("./label")
local school_tile = require("./school_tile")
local orb_track = require("./orb_track")

const TILE_GAP: f64 = 16.0
const LINE_GAP: f64 = 11.0
const BLOCK_GAP: f64 = 26.0
const LEGEND_GAP: f64 = 22.0
const LEGEND_ORB: f64 = 20.0

function schools(): entity.Node
    local tiles: {entity.Node} = {}
    for suit = 0::i32, 3::i32 do table.insert(tiles, school_tile.node(suit)) end
    return entity.wide(entity.flow(
        tiles, entity.row(TILE_GAP, box.justify_center, box.align_start)))
end

-- One outcome of a resolved breach beside the orb that stands for it, so the
-- colours on the header band are readable from here.
function legend_entry(edge: string, fill: string, caption: string): entity.Node
    return entity.flow({
        entity.sized(
            LEGEND_ORB, LEGEND_ORB,
            function(surface: entity.Surface, bounds: box.Rect): unit
                orb_track.draw_orb(
                    surface,
                    bounds.x + bounds.width * 0.5,
                    bounds.y + bounds.height * 0.5,
                    edge, fill, true)
            end),
        label.left(caption, modal.body_size, modal.body_ink),
    }, entity.row(6.0, box.justify_start, box.align_center))
end

function legend(): entity.Node
    return entity.flow({
        legend_entry(orb_track.robbers_edge, orb_track.robbers_fill, "WIN"),
        legend_entry(orb_track.arch_mage_edge, orb_track.arch_mage_fill, "LOSS"),
        legend_entry(orb_track.stalemate_edge, orb_track.stalemate_fill, "TIE"),
    }, entity.row(LEGEND_GAP, box.justify_start, box.align_center))
end

function body(): entity.Node
    return modal.column({
        schools(),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        modal.heading("1. FEINT"),
        modal.body_line("BIND UP TO 3 RELICS AND THE SAME NUMBER OF WARDS."),
        modal.body_line("EACH CARD RISKS 1 MANA. PRESS P TO PASS."),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        modal.heading("2. BREACH"),
        modal.body_line("BIND 2 RELICS. THE STRONGEST FIVE-SIGIL FORMATION WINS."),
        modal.body_line(
            "LATER BREACHES ARE WORTH MORE MANA. IT CARRIES TO THE NEXT VAULT."),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        legend(),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        modal.keys_line("ARROWS MOVE   SPACE BIND   ENTER COMMIT   H HISTORY"),
        modal.keys_line("C SORT BY COLOR   V SORT BY RANK   1 AND 2 CAST SPELLS"),
        modal.keys_line("MOUSE: HOVER FOCUSES   CLICK BINDS   BUTTONS COMMIT OR PASS"),
    }, LINE_GAP)
end

-- "Three ward holds" would read as though a stalemate counted; only breaches
-- the Arch Mage actually wins end the vault early.
function node(): entity.Node
    return modal.node(
        "THE JOB",
        "SURVIVE FIVE BREACHES PER VAULT. THREE ARCH MAGE WINS END THE RUN",
        body())
end

return { node = node }
