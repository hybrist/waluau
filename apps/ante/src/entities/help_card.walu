-- The help card: what the job is, what the four colors look like, the two
-- phases of a round, what each orb means, and every control. It is a column,
-- which is what it always was — it simply used to be a column written as
-- eighteen y coordinates that had to be kept in order by hand.

local box = require("../box_layout")
local entity = require("../entity")
local modal = require("./modal")
local label = require("./label")
local color_tile = require("./color_tile")
local orb_track = require("./orb_track")

const TILE_GAP: f64 = 16.0
const LINE_GAP: f64 = 11.0
const BLOCK_GAP: f64 = 26.0
const LEGEND_GAP: f64 = 22.0
const LEGEND_ORB: f64 = 20.0

function colors(): entity.Node
    local tiles: {entity.Node} = {}
    for suit = 0::i32, 3::i32 do table.insert(tiles, color_tile.node(suit)) end
    return entity.wide(entity.flow(
        tiles, entity.row(TILE_GAP, "center", "start")))
end

-- One outcome of a resolved round beside the orb that stands for it, so the
-- colours on the header band are readable from here.
function legend_entry(edge: string, fill: string, caption: string): entity.Node
    return entity.flow({
        entity.sized(
            LEGEND_ORB, LEGEND_ORB,
            function(surface: entity.Surface, bounds: box.Rect): unit
                orb_track.draw_orb(
                    surface,
                    bounds.x + bounds.width * 0.5,
                    bounds.y + bounds.height * 0.5,
                    edge, fill, true)
            end),
        label.left(caption, modal.body_size, modal.body_ink),
    }, entity.row(6.0, "start", "center"))
end

function legend(): entity.Node
    return entity.flow({
        legend_entry(orb_track.robbers_edge, orb_track.robbers_fill, "WIN"),
        legend_entry(orb_track.arch_mage_edge, orb_track.arch_mage_fill, "LOSS"),
        legend_entry(orb_track.stalemate_edge, orb_track.stalemate_fill, "TIE"),
    }, entity.row(LEGEND_GAP, "start", "center"))
end

function body(): entity.Node
    return modal.column({
        colors(),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        modal.heading("1. SWAP"),
        modal.body_line("SELECT UP TO 3 CARDS AND THE SAME NUMBER OF TABLE CARDS."),
        modal.body_line("EACH CARD COSTS 1 GOLD. PRESS P TO SKIP."),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        modal.heading("2. PLAY"),
        modal.body_line("SELECT 2 CARDS. THE STRONGEST FIVE-CARD POKER HAND WINS."),
        modal.body_line(
            "LATER ROUNDS AND RARER HANDS ARE WORTH MORE GOLD."
                .. " THREE OPPONENT WINS END THE DUEL."),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        modal.heading("3. THE TARGET"),
        modal.body_line(
            "CLEARING A DUEL REQUIRES ITS TARGET IN GOLD."
                .. " WHAT IS LEFT CARRIES ON."),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        legend(),
        entity.gap(0.0, BLOCK_GAP - LINE_GAP),
        modal.keys_line("ARROWS MOVE   SPACE SELECT   ENTER CONFIRM   H HISTORY"),
        modal.keys_line("C SORT BY COLOR   V SORT BY RANK   1 AND 2 USE SPELLS"),
        modal.keys_line("MOUSE: HOVER FOCUSES   CLICK SELECTS   BUTTONS CONFIRM OR SKIP"),
    }, LINE_GAP)
end

-- "Three table cards hold" would read as though a tie counted; only rounds
-- the opponent actually wins end the run. Five rounds make a duel; the
-- target is what leaving it costs, which is a third thing to learn and so a
-- third numbered block — the card is a column, so it simply gets longer.
function node(): entity.Node
    return modal.node(
        "THE JOB",
        "WIN FIVE ROUNDS, THEN REACH THE GOLD TARGET TO CONTINUE",
        body())
end

return { node = node }
