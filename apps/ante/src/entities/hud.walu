-- The centred title across the top of the duel board.
local game = require("../game")
local run_module = require("../run")
local ui = require("../ui/node")
local label = require("./label")

const TITLE_SIZE: f64 = 12.0
const TITLE_INK: string = "#fbbf24"

function title(run: run_module.View): string
    if run.boss then
        return "CHALLENGE DUEL " .. tostring(run.duel)
    end
    return "DUEL " .. tostring(run.duel)
end

export type Stateful = { title: label.Stateful, root: ui.Node }

function Stateful.new(state: game.View, run: run_module.View): Stateful
    local title_view: label.Stateful = label.Stateful.new(
        title(run),
        TITLE_SIZE,
        TITLE_INK,
        label.align_center,
        true
    )
    return {
        title = title_view,
        root = ui.Node.across({ justify = "center", align = "center" }, {title_view.root})
    }
end

function Stateful:present(state: game.View, run: run_module.View): unit
    self.title:present(title(run), TITLE_SIZE, TITLE_INK, label.align_center)
end

function node(state: game.View, run: run_module.View): ui.Node
    return Stateful.new(state, run).root
end

return { node = node }
