-- The player's ready abilities in the same diamond their face buttons make:
-- the first ability at South, then West, North, and East. The keyboard still
-- casts them with 1-4, so each circle carries its number while its position
-- teaches the controller-shaped layout the game can grow into. A finger has no
-- number row, so each socket is also its own pointer target: the diamond's box
-- is divided between the four positions, which makes a socket a much larger
-- thing to hit than the ring that is drawn for it.
--
-- Every position is always present. A run that only carries its starting
-- spell therefore reads as one ready ability and three empty sockets instead
-- of a text hint whose width changes with the chosen spell.
local game = require("../game")
local spells = require("../spells/spell")
local spell_launch = require("../spell_launch")
local box = require("../ui/layout")
local ui = require("../ui/node")
local ink = require("../ink")
local plate = require("../plate")

const SLOT_COUNT: i32 = 4
const WIDTH: f64 = 124.0
const HEIGHT: f64 = 116.0
const CENTER_X: f64 = WIDTH / 2.0
const CENTER_Y: f64 = HEIGHT / 2.0
const PITCH_X: f64 = 39.0
const PITCH_Y: f64 = 37.0
const SLOT_RADIUS: f64 = 20.0
const SLOT_INSET: f64 = 3.0
const KEY_RADIUS: f64 = 7.0
const KEY_OFFSET: f64 = 14.0

const KEY_SIZE: f64 = 7.0
const NAME_SIZE: f64 = 7.0
const COST_SIZE: f64 = 6.0

const SLOT_FILL: string = "#17171c"
const EMPTY_EDGE: string = "#34343c"
const EMPTY_INK: string = "#52525b"
const SPENT_EDGE: string = "#52525b"
const SPENT_INK: string = "#8a8a92"
const KEY_FILL: string = "#09090b"
const KEY_INK: string = "#e4e4e7"
const CONNECTOR_INK: string = "#27272a"

-- The rail joining the four sockets is a channel milled into the plate, not a
-- line: a wide dark groove with a hairline of light along its upper lip.
const CHANNEL_INK: string = "#1c1c23"
const CHANNEL_WIDTH: f64 = 5.0
const CHANNEL_LIGHT: string = "#43434f"
const CHANNEL_LIGHT_WIDTH: f64 = 1.0
const CHANNEL_LIFT: f64 = 1.2

-- The socket itself: a bezel ring domed toward the light, a floor cut into
-- the plate, and — when the ability is ready and paid for — a halo the colour
-- of the school it belongs to.
const BEZEL_RIM: f64 = 1.18
const BEZEL_CROWN: f64 = 0.30
const FLOOR_RIM: f64 = 1.25
const FLOOR_DEEP: f64 = 0.55
const HALO_RINGS: i32 = 5
const HALO_REACH: f64 = 9.0
const HALO_STRENGTH: f64 = 0.26
const KEY_RIM: f64 = 1.25
const KEY_CROWN: f64 = 0.34

-- Loadout order follows the comfortable face-button order: primary at South,
-- then West, North, and East. Keeping this mapping here makes the visual
-- arrangement independent from the order it happens to be painted in.
function slot_x(slot: i32): f64
    if slot == 1 then
        return CENTER_X - PITCH_X
    end
    if slot == 3 then
        return CENTER_X + PITCH_X
    end
    return CENTER_X
end

function slot_y(slot: i32): f64
    if slot == 0 then
        return CENTER_Y + PITCH_Y
    end
    if slot == 2 then
        return CENTER_Y - PITCH_Y
    end
    return CENTER_Y
end

-- Which socket a point belongs to: the nearest of the four positions, so the
-- whole diamond is divided between them with no gap to fall into and no
-- overlap to resolve. An unoccupied socket claims its share and answers to
-- nothing, which is what keeps a tap in an empty corner from reaching the
-- spell across the diamond.
function nearest_slot(bounds: box.Rect, x: f64, y: f64): i32
    local best: i32 = 0
    local best_distance: f64 = -1.0
    for slot = 0::i32, SLOT_COUNT - 1 do
        local dx: f64 = x - (bounds.x + slot_x(slot))
        local dy: f64 = y - (bounds.y + slot_y(slot))
        local distance: f64 = dx * dx + dy * dy
        if best_distance < 0.0 or distance < best_distance then
            best = slot
            best_distance = distance
        end
    end
    return best
end

function short_name(kind: spells.SpellKind): string
    if kind == spells.SpellKind.Firebolt then
        return "FIRE"
    end
    if kind == spells.SpellKind.FreezeRay then
        return "FROST"
    end
    if kind == spells.SpellKind.RaiseCard then
        return "RAISE"
    end
    if kind == spells.SpellKind.Clone then
        return "CLONE"
    end
    return ""
end

function draw_connector(surface: ui.Surface, bounds: box.Rect): unit
    local graphics = surface.graphics
    local north_x: f64 = bounds.x + slot_x(2)
    local north_y: f64 = bounds.y + slot_y(2)
    local west_x: f64 = bounds.x + slot_x(1)
    local west_y: f64 = bounds.y + slot_y(1)
    local south_x: f64 = bounds.x + slot_x(0)
    local south_y: f64 = bounds.y + slot_y(0)
    local east_x: f64 = bounds.x + slot_x(3)
    local east_y: f64 = bounds.y + slot_y(3)
    graphics:set_color(CHANNEL_INK)
    graphics:set_line_width(CHANNEL_WIDTH)
    graphics:line(north_x, north_y, west_x, west_y)
    graphics:line(west_x, west_y, south_x, south_y)
    graphics:line(south_x, south_y, east_x, east_y)
    graphics:line(east_x, east_y, north_x, north_y)
    -- The lip: the same four rails struck a hair above the groove, which is
    -- where a channel cut into a lit plate catches the light.
    graphics:set_color(CHANNEL_LIGHT)
    graphics:set_line_width(CHANNEL_LIGHT_WIDTH)
    graphics:line(north_x, north_y - CHANNEL_LIFT, west_x, west_y - CHANNEL_LIFT)
    graphics:line(west_x, west_y - CHANNEL_LIFT, south_x, south_y - CHANNEL_LIFT)
    graphics:line(south_x, south_y - CHANNEL_LIFT, east_x, east_y - CHANNEL_LIFT)
    graphics:line(east_x, east_y - CHANNEL_LIFT, north_x, north_y - CHANNEL_LIFT)
    graphics:set_color(CONNECTOR_INK)
end

function draw_slot(surface: ui.Surface, state: game.View, bounds: box.Rect, slot: i32): unit
    local graphics = surface.graphics
    local x: f64 = bounds.x + slot_x(slot)
    local y: f64 = bounds.y + slot_y(slot)
    local occupied: bool = slot < #state.spells
    local edge: string = EMPTY_EDGE
    local caption: string = EMPTY_INK
    -- Whether this socket is lit: it holds a spell the run can currently pay
    -- for. Tracked alongside the colour rather than read back off it, so a
    -- school whose colour matched the spent grey would still glow.
    local lit: bool = false
    if occupied then
        local spell: game.Spell = state.spells[slot + 1]
        edge = spell_launch.color(spell.kind)
        caption = edge
        lit = true
        if state.player_points < spell.cost then
            edge = SPENT_EDGE
            caption = SPENT_INK
            lit = false
        end
    end

    -- A ready ability is lit from inside its own socket, so the school's
    -- colour reaches the plate around it before the bezel is drawn. An empty
    -- or unaffordable socket is dark metal and gets no halo at all.
    if lit then
        graphics:set_color(edge)
        plate.halo(graphics, x, y, SLOT_RADIUS, SLOT_RADIUS + HALO_REACH, HALO_RINGS, HALO_STRENGTH)
    end

    -- The bezel is a raised ring and the floor a cut one: a dome in the edge
    -- colour with a well sunk into it. Two curved surfaces lit from the same
    -- side give the socket a depth the old flat ring could only outline.
    graphics:set_color(edge)
    plate.dome(graphics, x, y, SLOT_RADIUS, BEZEL_RIM, BEZEL_CROWN)
    graphics:set_color(SLOT_FILL)
    plate.well(graphics, x, y, SLOT_RADIUS - SLOT_INSET, FLOOR_RIM, FLOOR_DEEP)

    if occupied then
        local spell: game.Spell = state.spells[slot + 1]
        ink.text_centered(
            graphics,
            short_name(spell.kind),
            x,
            y + NAME_SIZE * 0.5 - 3.0,
            NAME_SIZE,
            caption
        )
        ink.text_centered(
            graphics,
            tostring(spell.cost) .. "G",
            x,
            y + COST_SIZE + 7.0,
            COST_SIZE,
            caption
        )
    else
        ink.text_centered(graphics, "+", x, y + NAME_SIZE * 0.5, NAME_SIZE, EMPTY_INK)
    end

    -- The key badge overlaps the socket like a controller-button legend, so
    -- the numeral stays legible without displacing the ability identity.
    local key_x: f64 = x - KEY_OFFSET
    local key_y: f64 = y - KEY_OFFSET
    graphics:set_color(edge)
    plate.dome(graphics, key_x, key_y, KEY_RADIUS, KEY_RIM, KEY_CROWN)
    graphics:set_color(KEY_FILL)
    plate.well(graphics, key_x, key_y, KEY_RADIUS - 1.5, KEY_RIM, KEY_CROWN)
    ink.text_centered(
        graphics,
        tostring(slot + 1),
        key_x,
        key_y + KEY_SIZE * 0.5,
        KEY_SIZE,
        KEY_INK
    )
end

function empty_paint(surface: ui.Surface, bounds: box.Rect): unit
end

type DiamondPresentation = { state: game.View }
-- `sockets` are the pointer leaves, one per position, in loadout order. They
-- paint nothing: the face under them draws the whole diamond in one pass, and
-- they exist so a router can hand each position its own key.
export type Stateful = { presentation: DiamondPresentation, root: ui.Node, sockets: {ui.Node} }

function Stateful.new(state: game.View): Stateful
    local presentation: DiamondPresentation = { state = state }
    local face: ui.Node = ui.Node.sized(
        WIDTH,
        HEIGHT,
        function(surface: ui.Surface, bounds: box.Rect): unit
            draw_connector(surface, bounds)
            for slot = 0::i32, SLOT_COUNT - 1 do
                draw_slot(surface, presentation.state, bounds, slot)
            end
        end
    )
    local sockets: {ui.Node} = {}
    local children: {ui.Node} = {face}
    for index = 0::i32, SLOT_COUNT - 1 do
        local slot: i32 = index
        local socket: ui.Node = ui.Node.sized(WIDTH, HEIGHT, empty_paint)
        socket:set_hit_test(
            function(bounds: box.Rect, x: f64, y: f64): bool
                if slot >= #presentation.state.spells then
                    return false
                end
                return box.contains(bounds, x, y) and nearest_slot(bounds, x, y) == slot
            end
        )
        table.insert(sockets, socket)
        table.insert(children, socket)
    end
    return { presentation = presentation, root = ui.Node.layer(children), sockets = sockets }
end

function Stateful:present(state: game.View): unit
    self.presentation.state = state
end

function node(state: game.View): ui.Node
    return Stateful.new(state).root
end

return {
    node = node,
    nearest_slot = nearest_slot,
    slot_x = slot_x,
    slot_y = slot_y,
    short_name = short_name,
    slot_count = SLOT_COUNT,
    width = WIDTH,
    height = HEIGHT
}
