-- The dark field the duel's table cards stand on. It is chrome rather than
-- content: it takes the rectangle the cards were given and steps outside it,
-- so the panel is always exactly as wide as the row it backs and never has to
-- be re-authored when the row gains or loses a slot.
--
-- The field deliberately stops short of the cards' bottom edge. The row sits
-- on the panel rather than inside it, which is what keeps the table cards reading as
-- objects on a surface instead of tiles in a box.

local box = require("../ui/layout")
local entity = require("./adapter")
local ink = require("../ink")

const PAD_X: f64 = 34.0
const RISE: f64 = 34.0
const FIELD_HEIGHT: f64 = 148.0

const FILL: string = "#101013"
const EDGE: string = "#3f3f46"

function field_of(bounds: box.Rect): box.Rect
    return entity.rect(
        bounds.x - PAD_X, bounds.y - RISE,
        bounds.width + PAD_X * 2.0, FIELD_HEIGHT)
end

function node(): entity.Node
    return entity.Node.measured(
        function(metrics: entity.Metrics): box.Intrinsic
            return box.Intrinsic.fixed(PAD_X * 2.0, FIELD_HEIGHT)
        end,
        function(surface: entity.Surface, bounds: box.Rect): unit
            local field: box.Rect = field_of(bounds)
            ink.panel(
                surface.graphics, field.x, field.y, field.width, field.height,
                FILL, EDGE)
        end)
end

return {
    node = node,
    pad_x = PAD_X,
    rise = RISE,
    field_height = FIELD_HEIGHT,
}
