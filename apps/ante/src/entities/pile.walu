-- The spent pile on the right edge, drawn face up so it always shows the last
-- card that landed — every card in it is public history, unlike the sealed
-- draw pile. `count` is how many cards have visibly arrived; the top card is
-- read from the same ledger, so a scoop still in the air leaves both the
-- thickness and the face showing exactly what the table last saw.
--
-- The stack's shadow steps left, away from the board edge, and hangs outside
-- the box for the same reason the deck's hangs right: depth is not content.
-- The pile carries no count label — it belongs to no one, and the round orbs
-- already tally the run.

local game = require("../game")
local box = require("../box_layout")
local entity = require("../entity")
local ink = require("../ink")
local card = require("./card")

function draw_at(
    surface: entity.Surface, cards: {game.Card}, count: i32, x: f64, y: f64
): unit
    if count <= 0 then return end
    local graphics = surface.graphics
    if count > 18 then
        card.fill_silhouette(graphics, x - 6.0, y + 6.0, "#111118")
    end
    if count > 6 then
        card.fill_silhouette(graphics, x - 3.0, y + 3.0, "#15151c")
    end
    card.draw_face(surface, card.plain(cards[count - 1]), x, y)
end

function node(cards: {game.Card}, count: i32): entity.Node
    return entity.measured(
        function(metrics: entity.Metrics): box.Intrinsic
            return card.intrinsic()
        end,
        function(surface: entity.Surface, bounds: box.Rect): unit
            draw_at(surface, cards, count, bounds.x, bounds.y)
        end)
end

return {
    node = node,
    draw_at = draw_at,
}
