-- The rounds of a duel, one orb each. Each one is the verdict of the
-- round it stands for; the one the board is currently fighting wears an amber
-- ring behind it. The three outcomes a resolved round can have are declared
-- here because the help legend draws the same orbs from them, so a colour only
-- ever means one thing on screen.
local game = require("../game")
local box = require("../ui/layout")
local ui = require("../ui/node")

-- The live round's ring is the widest thing an orb ever draws, so it is what
-- an orb's box measures.
const ORB_RADIUS: f64 = 10.0
const LIVE_RADIUS: f64 = 12.0
const ORB_SIZE: f64 = 24.0
-- Daylight between neighbouring orbs, which with ORB_SIZE is the 34-unit
-- centre-to-centre pitch the track has always read at.
const ORB_GAP: f64 = 10.0

const ORB_ROBBERS_EDGE: string = "#cffafe"
const ORB_ROBBERS_FILL: string = "#22d3ee"
const ORB_ARCH_MAGE_EDGE: string = "#fecaca"
const ORB_ARCH_MAGE_FILL: string = "#f87171"
const ORB_STALEMATE_EDGE: string = "#e4e4e7"
const ORB_STALEMATE_FILL: string = "#a1a1aa"
const ORB_UNPLAYED_EDGE: string = "#52525b"
const ORB_UNPLAYED_FILL: string = "#17171c"
const LIVE_RING: string = "#fbbf24"

function draw_orb(
    surface: ui.Surface,
    x: f64,
    y: f64,
    edge: string,
    fill: string,
    played: bool
): unit
    local graphics = surface.graphics
    graphics:set_color(edge)
    graphics:fill_circle(x, y, ORB_RADIUS)
    graphics:set_color(fill)
    graphics:fill_circle(x, y, 7.0)
    if played then
        graphics:set_color("#ffffff")
        graphics:fill_circle(x - 2.5, y - 2.5, 1.5)
    end
end

-- One round's orb, keyed off the winner recorded for it. A stalemate is not a
-- table-card hold, so it does not wear the lost colour.
type TrackPresentation = { state: game.View }

function draw_round(
    presentation: TrackPresentation,
    surface: ui.Surface,
    bounds: box.Rect,
    round: i32
): unit
    local x: f64 = bounds.x + bounds.width * 0.5
    local y: f64 = bounds.y + bounds.height * 0.5
    local edge: string = ORB_UNPLAYED_EDGE
    local fill: string = ORB_UNPLAYED_FILL
    local state: game.View = presentation.state
    local played: bool = round < #state.history
    if played then
        local winner: i32 = state.history[round].winner
        if winner > 0 then
            edge = ORB_ROBBERS_EDGE
            fill = ORB_ROBBERS_FILL
        elseif winner < 0 then
            edge = ORB_ARCH_MAGE_EDGE
            fill = ORB_ARCH_MAGE_FILL
        else
            edge = ORB_STALEMATE_EDGE
            fill = ORB_STALEMATE_FILL
        end
    end
    if round == state.round - 1 then
        surface.graphics:set_color(LIVE_RING)
        surface.graphics:fill_circle(x, y, LIVE_RADIUS)
    end
    draw_orb(surface, x, y, edge, fill, played)
end

function orb_presented(presentation: TrackPresentation, round: i32): ui.Node
    return ui.Node.sized(
        ORB_SIZE,
        ORB_SIZE,
        function(surface: ui.Surface, bounds: box.Rect): unit
            draw_round(presentation, surface, bounds, round)
        end
    )
end

function orb(state: game.View, round: i32): ui.Node
    return orb_presented({ state = state }, round)
end

export type Stateful = { presentation: TrackPresentation, root: ui.Node }

function Stateful.new(state: game.View): Stateful
    local presentation: TrackPresentation = { state = state }
    local root: ui.Node = ui.Node.measured(
        function(graphics: ui.Graphics?, into: box.Intrinsic): unit
            local count: i32 = 1
            if presentation.state.boss then
                count = game.max_rounds
            end
            box.set_fixed(into, (count::f64) * ORB_SIZE + ((count - 1)::f64) * ORB_GAP, ORB_SIZE)
        end,
        function(surface: ui.Surface, bounds: box.Rect): unit
            local count: i32 = 1
            if presentation.state.boss then
                count = game.max_rounds
            end
            local width: f64 = (count::f64) * ORB_SIZE + ((count - 1)::f64) * ORB_GAP
            local left: f64 = bounds.x + (bounds.width - width) * 0.5
            for round = 0::i32, count - 1 do
                local slot: box.Rect = box.rect(
                    left + (round::f64) * (ORB_SIZE + ORB_GAP),
                    bounds.y,
                    ORB_SIZE,
                    ORB_SIZE
                )
                draw_round(presentation, surface, slot, round)
            end
        end
    )
    return { presentation = presentation, root = root }
end

function Stateful:present(state: game.View): unit
    self.presentation.state = state
end

function node(state: game.View): ui.Node
    return Stateful.new(state).root
end

return {
    node = node,
    draw_orb = draw_orb,
    robbers_edge = ORB_ROBBERS_EDGE,
    robbers_fill = ORB_ROBBERS_FILL,
    arch_mage_edge = ORB_ARCH_MAGE_EDGE,
    arch_mage_fill = ORB_ARCH_MAGE_FILL,
    stalemate_edge = ORB_STALEMATE_EDGE,
    stalemate_fill = ORB_STALEMATE_FILL
}
