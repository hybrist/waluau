-- A clickable capsule: the commit and pass controls of the duel. Inactive
-- capsules stay visible but grey — a click still lands, the screen owns the
-- rules, it simply will not satisfy them yet — so being unavailable is a
-- colour rather than a disappearance.
--
-- The capsule is as wide as its label plus its padding. That is the whole
-- reason it is an entity: COMMIT SWAP and PASS no longer need two authored
-- widths that have to be re-tuned whenever either word changes.
local box = require("../ui/layout")
local ui = require("../ui/node")
local ink = require("../ink")

const HEIGHT: f64 = 26.0
const PAD_X: f64 = 32.0
const LABEL_SIZE: f64 = 11.0

const FILL: string = "#17171c"
const ACTIVE_EDGE: string = "#fbbf24"
const QUIET_EDGE: string = "#52525b"
const QUIET_INK: string = "#8a8a92"

function width_of(graphics: ui.Graphics?, text: string): f64
    return ui.text_width(graphics, text, LABEL_SIZE) + PAD_X * 2.0
end

function intrinsic(graphics: ui.Graphics?, text: string): box.Intrinsic
    local width: f64 = width_of(graphics, text)
    return {
        min_width = width,
        preferred_width = width,
        max_width = width,
        min_height = HEIGHT,
        preferred_height = HEIGHT,
        max_height = HEIGHT,
        -- The label rides the middle of the capsule, so that is where its
        -- baseline is; a row of capsules and captions lines up on it.
        baseline = (HEIGHT + LABEL_SIZE) * 0.5
    }
end

function draw_at(surface: ui.Surface, text: string, active: bool, bounds: box.Rect): unit
    local graphics = surface.graphics
    local edge: string = QUIET_EDGE
    local caption: string = QUIET_INK
    if active then
        edge = ACTIVE_EDGE
        caption = ACTIVE_EDGE
    end
    graphics:set_color(FILL)
    graphics:fill_rectangle(bounds.x, bounds.y, bounds.width, bounds.height)
    graphics:set_color(edge)
    graphics:set_line_width(1.5)
    graphics:stroke_rectangle(bounds.x, bounds.y, bounds.width, bounds.height)
    ink.text_centered(
        graphics,
        text,
        bounds.x + bounds.width * 0.5,
        bounds.y + (bounds.height + LABEL_SIZE) * 0.5,
        LABEL_SIZE,
        caption
    )
end

type CapsulePresentation = { text: string, active: bool }
export type Stateful = { presentation: CapsulePresentation, root: ui.Node }

function Stateful.new(text: string, active: bool): Stateful
    local presentation: CapsulePresentation = { text = text, active = active }
    local root: ui.Node = ui.Node.measured(
        function(graphics: ui.Graphics?, into: box.Intrinsic): unit
            local width: f64 = width_of(graphics, presentation.text)
            into.min_width = width
            into.preferred_width = width
            into.max_width = width
            into.min_height = HEIGHT
            into.preferred_height = HEIGHT
            into.max_height = HEIGHT
            into.baseline = (HEIGHT + LABEL_SIZE) * 0.5
        end,
        function(surface: ui.Surface, bounds: box.Rect): unit
            draw_at(surface, presentation.text, presentation.active, bounds)
        end
    )
    return { presentation = presentation, root = root }
end

function Stateful:present(text: string, active: bool): unit
    self.presentation.text = text
    self.presentation.active = active
end

function node(text: string, active: bool): ui.Node
    return Stateful.new(text, active).root
end

return { node = node, draw_at = draw_at, intrinsic = intrinsic, height = HEIGHT }
