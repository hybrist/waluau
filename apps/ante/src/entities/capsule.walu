-- A clickable capsule: the commit and pass controls of the duel. Inactive
-- capsules stay visible but grey — a click still lands, the screen owns the
-- rules, it simply will not satisfy them yet — so being unavailable is a
-- colour rather than a disappearance.
--
-- The capsule is as wide as its label plus its padding. That is the whole
-- reason it is an entity: COMMIT SWAP and PASS no longer need two authored
-- widths that have to be re-tuned whenever either word changes.
local box = require("../ui/layout")
local ui = require("../ui/node")
local button = require("./button")

const HEIGHT: f64 = 26.0
const PAD_X: f64 = 32.0
const LABEL_SIZE: f64 = 11.0

-- A capsule has no idle: what the board is asking for is lit and what it is
-- not is quiet, so `active` names the two moods directly and the idle finish
-- is never reached. The glow is off — a capsule says "this would be accepted
-- now", which is a state of the board rather than a cursor's place in a list.
local LOOK: button.Look = {
    fill = "#17171c",
    idle_edge = "#52525b",
    idle_ink = "#8a8a92",
    focus_edge = "#fbbf24",
    focus_ink = "#fbbf24",
    quiet_edge = "#52525b",
    quiet_ink = "#8a8a92",
    label_size = LABEL_SIZE,
    pad_x = PAD_X,
    height = HEIGHT,
    weight = 1.5,
    aura_reach = 0.0,
    aura_swell = 0.0,
    aura_rings = 0,
    aura_strength = 0.0
}

function mood_of(active: bool): button.Mood
    if active then
        return "focused"
    end
    return "disabled"
end

function width_of(graphics: ui.Graphics?, text: string): f64
    return button.width_of(graphics, LOOK, text)
end

function draw_at(
    surface: ui.Surface,
    text: string,
    active: bool,
    touch: button.Touch,
    bounds: box.Rect
): unit
    button.draw(surface.graphics, bounds, LOOK, mood_of(active), touch, 0.0, text)
end

type CapsulePresentation = { text: string, active: bool, touch: button.Touch }
export type Stateful = { presentation: CapsulePresentation, root: ui.Node }

function Stateful.new(text: string, active: bool): Stateful
    local presentation: CapsulePresentation = { text = text, active = active, touch = "none" }
    local root: ui.Node = ui.Node.measured(
        function(graphics: ui.Graphics?, into: box.Intrinsic): unit
            button.measure_into(graphics, into, LOOK, presentation.text)
        end,
        function(surface: ui.Surface, bounds: box.Rect): unit
            draw_at(surface, presentation.text, presentation.active, presentation.touch, bounds)
        end
    )
    return { presentation = presentation, root = root }
end

function Stateful:present(text: string, active: bool): unit
    self.presentation.text = text
    self.presentation.active = active
end

-- Kept apart from `present` because the two have different owners: the screen
-- says what the capsule is asking for, the router says what the pointer is
-- doing to it, and neither should have to carry the other's argument.
function Stateful:present_touch(touch: button.Touch): unit
    self.presentation.touch = touch
end

function node(text: string, active: bool): ui.Node
    return Stateful.new(text, active).root
end

return { node = node, draw_at = draw_at, height = HEIGHT }
