-- The sealed draw pile every dealt card and table_card flies out of. The stack
-- silhouette thins as the run burns down.
--
-- Its box is the top card. The two shadow cards behind the stack deliberately
-- hang past the box — they are depth, not content, and giving them width would
-- shove the whole board over by six units for a thick deck and not for a thin
-- one.

local box = require("../ui/layout")
local entity = require("./adapter")
local card = require("./card")

const CAPTION_DROP: f64 = 0.0

function intrinsic(): box.Intrinsic
    return box.Intrinsic.fixed(card.width, card.height)
end

function draw_at(surface: entity.Surface, count: i32, x: f64, y: f64): unit
    if count <= 0 then return end
    local graphics = surface.graphics
    if count > 18 then
        card.fill_silhouette(graphics, x + 6.0, y + 6.0, "#111118")
    end
    if count > 6 then
        card.fill_silhouette(graphics, x + 3.0, y + 3.0, "#15151c")
    end
    card.draw_back(surface, x, y, false)
end

type DeckPresentation = { count: i32 }
export type Stateful = { presentation: DeckPresentation, root: entity.Node }

function Stateful.new(count: i32): Stateful
    local presentation: DeckPresentation = { count = count }
    local root: entity.Node = entity.Node.measured(
        function(metrics: entity.Metrics): box.Intrinsic
            return intrinsic()
        end,
        function(surface: entity.Surface, bounds: box.Rect): unit
            draw_at(surface, presentation.count, bounds.x, bounds.y)
        end)
    return { presentation = presentation, root = root }
end

function Stateful:present(count: i32): unit
    self.presentation.count = count
end

function node(count: i32): entity.Node
    return Stateful.new(count).root
end

return {
    node = node,
    draw_at = draw_at,
    caption_drop = CAPTION_DROP,
}
