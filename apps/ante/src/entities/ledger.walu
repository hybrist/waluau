-- The round ledger: every round of this duel, who took it, and which two
-- hands settled it. One row per round, and the rows are a column rather
-- than a running y cursor, so the ledger of a three-round duel and the ledger
-- of an empty one are the same code.

local game = require("../game")
local box = require("../box_layout")
local entity = require("../entity")
local modal = require("./modal")
local label = require("./label")

const ROW_GAP: f64 = 30.0
const ROUND_SIZE: f64 = 13.0
const VERDICT_SIZE: f64 = 13.0
const FORMATION_SIZE: f64 = 10.0
-- The first two columns of a ledger row, wide enough for the longest thing each
-- of them holds so the rows read as a table rather than as ragged lines. These
-- are the columns' own widths; the third takes whatever is left.
const ROUND_WIDTH: f64 = 124.0
const VERDICT_WIDTH: f64 = 180.0

const ROUND_INK: string = "#fbbf24"
const VERDICT_INK: string = "#f8fafc"
const FORMATION_INK: string = "#b5b5bd"

function verdict_text(trick: readonly<game.Trick>): string
    if trick.winner > 0 then return "YOU +" .. tostring(trick.points) end
    if trick.winner < 0 then return "OPPONENT" end
    return "TIE"
end

-- A cell that holds its column's width whatever its own type measures, which
-- is what keeps the three columns lined up down the card. The floor is the
-- column's width, so a short verdict and a long one start the next column in
-- the same place; the line inside still aligns itself left.
function cell(text: string, size: f64, color: string, width: f64): entity.Node
    return label.left(text, size, color):min_width(width)
end

function row(trick: readonly<game.Trick>): entity.Node
    return entity.across({ align = "baseline" }, {
        cell("ROUND " .. tostring(trick.round), ROUND_SIZE, ROUND_INK, ROUND_WIDTH),
        cell(verdict_text(trick), VERDICT_SIZE, VERDICT_INK, VERDICT_WIDTH),
        label.left(
            game.category_name(trick.player_value) .. " VS "
                .. game.category_name(trick.computer_value),
            FORMATION_SIZE, FORMATION_INK),
    })
end

function body(state: game.View): entity.Node
    if #state.history == 0 then
        return modal.column({
            label.left("NO ROUNDS WON YET.", 16.0, "#8a8a92"),
        }, ROW_GAP)
    end
    local rows: {entity.Node} = {}
    for trick in state.history do table.insert(rows, row(trick)) end
    return modal.column(rows, ROW_GAP)
end

function node(state: game.View): entity.Node
    return modal.node(
        "ROUND HISTORY", "H, ESC, OR A CLICK CLOSES THE HISTORY", body(state))
end

return { node = node }
