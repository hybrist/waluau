-- The strip along the bottom of the duel: the way back to the menu stays
-- centred while the player's four ready-ability sockets occupy the lower
-- right. The diamond owns spell identity, affordability, and key hints; this
-- strip only places it against the same board edge on every viewport.

local game = require("../game")
local box = require("../box_layout")
local entity = require("../entity")
local label = require("./label")
local ability_diamond = require("./ability_diamond")

const HINT_SIZE: f64 = 9.0
const CAPTION_PAD_X: f64 = 8.0
const CAPTION_PAD_Y: f64 = 7.0

const QUIET_INK: string = "#8a8a92"

-- Keep the keyboard reminder off the canvas edge and carry its baseline down
-- with the padding so it remains stable inside the taller diamond band.
function padded_caption(caption: entity.Node): entity.Node
    return caption:padded(CAPTION_PAD_X, CAPTION_PAD_Y)
end

function menu(): entity.Node
    return padded_caption(label.centered("M MENU", HINT_SIZE, QUIET_INK))
end

function node(state: game.View): entity.Node
    return entity.layer({
        entity.across(
            { justify = "end", align = "end" },
            { ability_diamond.node(state) }),
        entity.across(
            { justify = "center", align = "end" },
            { menu() }),
    })
end

return {
    node = node,
}
