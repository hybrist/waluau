-- The strip along the bottom of the duel: the player's health and gold occupy
-- the lower left, the way back to the menu stays centred, and the player's four
-- ready-ability sockets occupy the lower right. The diamond owns spell identity,
-- affordability, and key hints; this strip only places it against the same board
-- edge on every viewport.
local game = require("../game")
local run_module = require("../run")
local ui = require("../ui/node")
local label = require("./label")
local ability_diamond = require("./ability_diamond")

const HINT_SIZE: f64 = 9.0
const CAPTION_PAD_X: f64 = 8.0
const CAPTION_PAD_Y: f64 = 7.0

const QUIET_INK: string = "#8a8a92"
const GOLD_INK: string = "#67e8f9"
const HEART_INK: string = "#fb7185"

-- Keep the keyboard reminder off the canvas edge and carry its baseline down
-- with the padding so it remains stable inside the taller diamond band.
function padded_caption(caption: ui.Node): ui.Node
    return caption:padded(CAPTION_PAD_X, CAPTION_PAD_Y)
end

function menu(): ui.Node
    return padded_caption(label.centered("M MENU", HINT_SIZE, QUIET_INK))
end

function stats(state: game.View, run: run_module.View): ui.Node
    return padded_caption(
        ui.Node.down(
            { gap = 4.0, align = "start" },
            {
                label.left(
                    "HEARTS " .. tostring(run.hearts) .. " / " .. tostring(run.max_hearts),
                    HINT_SIZE,
                    HEART_INK
                ),
                label.left("GOLD " .. tostring(state.player_points), HINT_SIZE, GOLD_INK)
            }
        )
    )
end

export type Stateful = {
    hearts: label.Stateful,
    gold: label.Stateful,
    abilities: ability_diamond.Stateful,
    root: ui.Node
}

function Stateful.new(state: game.View, run: run_module.View): Stateful
    local hearts: label.Stateful = label.Stateful.new(
        "HEARTS " .. tostring(run.hearts) .. " / " .. tostring(run.max_hearts),
        HINT_SIZE,
        HEART_INK,
        label.align_left,
        false
    )
    local gold: label.Stateful = label.Stateful.new(
        "GOLD " .. tostring(state.player_points),
        HINT_SIZE,
        GOLD_INK,
        label.align_left,
        false
    )
    local abilities: ability_diamond.Stateful = ability_diamond.Stateful.new(state)
    local stat_root: ui.Node = padded_caption(
        ui.Node.down({ gap = 4.0, align = "start" }, {hearts.root, gold.root})
    )
    local root: ui.Node = ui.Node.layer(
        {
            ui.Node.across({ justify = "start", align = "end" }, {stat_root}),
            ui.Node.across({ justify = "center", align = "end" }, {menu()}),
            ui.Node.across({ justify = "end", align = "end" }, {abilities.root})
        }
    )
    return { hearts = hearts, gold = gold, abilities = abilities, root = root }
end

function Stateful:present(state: game.View, run: run_module.View): unit
    self.hearts:present(
        "HEARTS " .. tostring(run.hearts) .. " / " .. tostring(run.max_hearts),
        HINT_SIZE,
        HEART_INK,
        label.align_left
    )
    self.gold:present(
        "GOLD " .. tostring(state.player_points),
        HINT_SIZE,
        GOLD_INK,
        label.align_left
    )
    self.abilities:present(state)
end

function node(state: game.View, run: run_module.View): ui.Node
    return Stateful.new(state, run).root
end

return { node = node }
