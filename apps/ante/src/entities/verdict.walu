-- The verdict of the duel just fought, read as a moment in the run. Taking it
-- is an intermission — its remaining gold is the stake the next duel opens
-- with — while exhausted hearts or a failed boss finale stop the whole run.
--
-- There are three of those moments and they are branched on the run's own
-- classifier rather than re-decided from the board, so what this screen says
-- and what the run then does are the same answer.
local game = require("../game")
local run_module = require("../run")
local box = require("../ui/layout")
local ui = require("../ui/node")
local modal = require("./modal")
local label = require("./label")

const HEADLINE_SIZE: f64 = 18.0
const FIGURE_SIZE: f64 = 44.0
const NOTE_SIZE: f64 = 13.0
const KEYS_SIZE: f64 = 12.0

const HEADLINE_INK: string = "#67e8f9"
const FIGURE_INK: string = "#f8fafc"
const QUIET_INK: string = "#8a8a92"
const WON_INK: string = "#fbbf24"

const BLOCK_GAP: f64 = 26.0
const FIGURE_GAP: f64 = 18.0

function walks_on(run: run_module.View): bool
    return run_module.outcome_walks_on(run.outcome)
end

function title_of(run: run_module.View): string
    if run_module.outcome_is_loss(run.outcome) then
        return "THE RUN ENDS"
    end
    if run.outcome == "won" then
        return "THE DUEL IS DONE"
    end
    return "DUEL " .. tostring(run.duel) .. " IS YOURS"
end

function subtitle_of(run: run_module.View): string
    if run.outcome == "lost-health" then
        return "YOUR LAST HEART WAS LOST IN DUEL " .. tostring(run.duel)
    end
    if run.outcome == "lost-duel" then
        return "THE BOSS TOOK THE FINAL HAND IN DUEL " .. tostring(run.duel)
    end
    if run.outcome == "won" then
        return "ALL " .. tostring(run.run_length) .. " DUELS WON. THE CITY GOES ON PAST THEM"
    end
    return "THE DUEL IS CLEARED. THE RUN GOES ON"
end

-- One figure under its caption.
function figure(
    caption: string,
    caption_ink: string,
    value: string,
    figure_ink: string,
    caption_size: f64,
    figure_size: f64
): ui.Node
    return modal.column(
        {
            label.middle(caption, caption_size, caption_ink),
            label.middle(value, figure_size, figure_ink)
        },
        FIGURE_GAP
    )
end

-- What the run walks away with. Exhausting its hearts reports how far it got;
-- clearing a duel reports the gold carried into the shop and the next duel.
function tally(state: game.View, run: run_module.View): ui.Node
    if run_module.outcome_is_loss(run.outcome) then
        return figure(
            "DUELS WON",
            HEADLINE_INK,
            tostring(run.cleared),
            FIGURE_INK,
            HEADLINE_SIZE,
            FIGURE_SIZE
        )
    end
    local figure_ink: string = FIGURE_INK
    if run.outcome == "won" then
        figure_ink = WON_INK
    end
    return figure(
        "GOLD CARRIED ON",
        HEADLINE_INK,
        tostring(state.player_points),
        figure_ink,
        HEADLINE_SIZE,
        FIGURE_SIZE
    )
end

function ahead_text(run: run_module.View): string
    local text: string = "NEXT: DUEL " .. tostring(run.duel + 1)
    if run.next_is_boss then
        text = text .. "   CHALLENGE"
    end
    return text
end

-- The next duel is not dealt straight off the verdict: the shop stands
-- between them, spending this pile of gold.
function onward(run: run_module.View): {ui.Node}
    if not walks_on(run) then
        return {
            label.middle(
                "ENTER OR CLICK STARTS A NEW RUN   H OPENS THE LEDGER",
                KEYS_SIZE,
                modal.keys_ink
            )
        }
    end
    local prompt: string = "ENTER OR CLICK VISITS THE SHOP   H OPENS THE HISTORY"
    if run.outcome == "won" then
        prompt = "ENTER OR CLICK WALKS ON INTO THE ENDLESS CITY"
    end
    return {
        label.middle(ahead_text(run), NOTE_SIZE, modal.keys_ink),
        label.middle(prompt, KEYS_SIZE, modal.keys_ink)
    }
end

function body(state: game.View, run: run_module.View): ui.Node
    local lines: {ui.Node} = {tally(state, run), ui.Node.gap(0.0, BLOCK_GAP)}
    for line in onward(run) do
        table.insert(lines, line)
    end
    table.insert(lines, ui.Node.gap(0.0, BLOCK_GAP))
    table.insert(
        lines,
        label.middle("R RESTARTS THE RUN   M RETURNS TO MENU", KEYS_SIZE, QUIET_INK)
    )
    return ui.Node.flow(lines, box.column(BLOCK_GAP * 0.5, "start", "stretch"))
end

function node(state: game.View, run: run_module.View): ui.Node
    return modal.node(title_of(run), subtitle_of(run), body(state, run))
end

return { node = node }
