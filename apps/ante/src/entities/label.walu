-- A line of type as an ui. It measures itself against the font that is
-- actually loaded — the packaged display face once that has arrived, the
-- built-in bitmap font until then — so a row of labels reflows when the real
-- face lands instead of holding a gap sized for a guess.
--
-- The box is the line's own: as wide as the pen travels, as tall as the size,
-- with the baseline at its bottom edge. That is the engine's own convention
-- for where `print` puts a string, so a row of labels aligned on baselines
-- lines up the way reading it says it should.
local box = require("../ui/layout")
local ui = require("../ui/node")
local ink = require("../ink")

const ALIGN_LEFT: i32 = 0
const ALIGN_CENTER: i32 = 1
const ALIGN_RIGHT: i32 = 2

function measure(graphics: ui.Graphics?, value: string, size: f64): box.Intrinsic
    local width: f64 = ui.text_width(graphics, value, size)
    return {
        min_width = width,
        preferred_width = width,
        max_width = width,
        min_height = size,
        preferred_height = size,
        max_height = size,
        baseline = size
    }
end

-- Where the pen starts, given how the line sits in the box layout handed it.
function pen_x(bounds: box.Rect, width: f64, align: i32): f64
    if align == ALIGN_CENTER then
        return bounds.x + (bounds.width - width) * 0.5
    end
    if align == ALIGN_RIGHT then
        return bounds.x + bounds.width - width
    end
    return bounds.x
end

type LabelPresentation = { value: string, size: f64, color: string, align: i32, filling: bool }
export type Stateful = { presentation: LabelPresentation, root: ui.Node }

function Stateful.new(
    value: string,
    size: f64,
    color: string,
    align: i32,
    is_filling: bool
): Stateful
    local presentation: LabelPresentation = {
        value = value,
        size = size,
        color = color,
        align = align,
        filling = is_filling
    }
    local root: ui.Node = ui.Node.measured(
        function(graphics: ui.Graphics?, into: box.Intrinsic): unit
            local width: f64 = ui.text_width(graphics, presentation.value, presentation.size)
            into.min_width = width
            into.preferred_width = width
            into.max_width = width
            if presentation.filling then
                into.max_width = box.unbounded
            end
            into.min_height = presentation.size
            into.preferred_height = presentation.size
            into.max_height = presentation.size
            into.baseline = presentation.size
        end,
        function(surface: ui.Surface, bounds: box.Rect): unit
            local width: f64 = ui.text_width(
                surface.graphics,
                presentation.value,
                presentation.size
            )
            ink.text(
                surface.graphics,
                presentation.value,
                pen_x(bounds, width, presentation.align),
                bounds.y + presentation.size,
                presentation.size,
                presentation.color
            )
        end
    )
    return { presentation = presentation, root = root }
end

function Stateful:present(value: string, size: f64, color: string, align: i32): unit
    self.presentation.value = value
    self.presentation.size = size
    self.presentation.color = color
    self.presentation.align = align
end

function node(value: string, size: f64, color: string, align: i32): ui.Node
    return Stateful.new(value, size, color, align, false).root
end

-- A line that takes whatever width the flow around it stretches it to, and
-- aligns its type inside that. A centred caption needs a box to be centred in;
-- this is how it gets one without a caller measuring the column for it.
function filling(value: string, size: f64, color: string, align: i32): ui.Node
    return Stateful.new(value, size, color, align, true).root
end

function left(value: string, size: f64, color: string): ui.Node
    return node(value, size, color, ALIGN_LEFT)
end

function centered(value: string, size: f64, color: string): ui.Node
    return node(value, size, color, ALIGN_CENTER)
end

function right(value: string, size: f64, color: string): ui.Node
    return node(value, size, color, ALIGN_RIGHT)
end

function middle(value: string, size: f64, color: string): ui.Node
    return filling(value, size, color, ALIGN_CENTER)
end

return {
    node = node,
    middle = middle,
    left = left,
    centered = centered,
    right = right,
    measure = measure,
    align_left = ALIGN_LEFT,
    align_center = ALIGN_CENTER,
    align_right = ALIGN_RIGHT
}
