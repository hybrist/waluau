-- The Astral Sea the duel is fought across: a cosmic, magical expanse of
-- swirling nebulas, ethereal waves, and twinkling starfields.
--
-- When the GPU shader pipeline is live, the backdrop draws through the
-- procedural `ante.effects.astral-sea` fragment shader, which drives domain-warped
-- nebula clouds, celestial ether currents, and twinkling stars with time. A
-- deep cosmic gradient and vignette are retained as a graceful fallback for
-- headless tests or before GPU shaders settle.
local box = require("../ui/layout")
local ui = require("../ui/node")
local plate = require("../plate")
local graphics_module = require("waluau:engine/graphics")

const CLEAR: string = "#06060f"
const FIELD: string = "#0e0d1f"
const RULE: string = "#1a1638"
const RULE_PITCH: f64 = 48.0

const LAMP_CORE: f64 = 1.0
const LAMP_EDGE: f64 = 0.30
const LAMP_DROP: f64 = 0.42
const LAMP_COLUMNS: i32 = 10
const LAMP_ROWS: i32 = 6

const VIGNETTE_DEPTH: f64 = 0.55
const VIGNETTE_BAND: f64 = 0.22

function lamp_at(across: f64, down: f64): f64
    local dx: f64 = (across - 0.5) * 2.0
    local dy: f64 = (down - LAMP_DROP) * 2.0
    local reach: f64 = math.min(1.0, (dx * dx + dy * dy * 0.72))
    return LAMP_CORE + (LAMP_EDGE - LAMP_CORE) * reach
end

function draw_field(graphics: ui.Graphics, bounds: box.Rect): unit
    graphics:set_color(FIELD)
    local cell_width: f64 = bounds.width / (LAMP_COLUMNS::f64)
    local cell_height: f64 = bounds.height / (LAMP_ROWS::f64)
    for row = 0::i32, LAMP_ROWS - 1 do
        local top: f64 = (row::f64) / (LAMP_ROWS::f64)
        local bottom: f64 = ((row + 1)::f64) / (LAMP_ROWS::f64)
        for column = 0::i32, LAMP_COLUMNS - 1 do
            local left: f64 = (column::f64) / (LAMP_COLUMNS::f64)
            local right: f64 = ((column + 1)::f64) / (LAMP_COLUMNS::f64)
            plate.shaded_rectangle(
                graphics,
                bounds.x + left * bounds.width,
                bounds.y + top * bounds.height,
                cell_width,
                cell_height,
                lamp_at(left, top),
                lamp_at(right, top),
                lamp_at(right, bottom),
                lamp_at(left, bottom)
            )
        end
    end
end

const SHAFT_STEPS: i32 = 6

function draw_shafts(graphics: ui.Graphics, bounds: box.Rect): unit
    graphics:set_color(RULE)
    graphics:set_line_width(1.0)
    local columns: i32 = math.ceil(bounds.width / RULE_PITCH)::i32
    local red: f64 = graphics.red
    local green: f64 = graphics.green
    local blue: f64 = graphics.blue
    for column = 0::i32, columns do
        local offset: f64 = (column::f64) * RULE_PITCH
        local from_x: f64 = bounds.x + offset
        local to_x: f64 = bounds.x + bounds.width - offset
        for step = 0::i32, SHAFT_STEPS - 1 do
            local start: f64 = (step::f64) / (SHAFT_STEPS::f64)
            local finish: f64 = ((step + 1)::f64) / (SHAFT_STEPS::f64)
            local middle: f64 = (start + finish) * 0.5
            local at_x: f64 = from_x + (to_x - from_x) * middle
            local lit: f64 = lamp_at((at_x - bounds.x) / bounds.width, middle)
            graphics:set_color_rgba(red * lit, green * lit, blue * lit, 1.0)
            graphics:line(
                from_x + (to_x - from_x) * start,
                bounds.y + bounds.height * start,
                from_x + (to_x - from_x) * finish,
                bounds.y + bounds.height * finish
            )
        end
    end
end

function draw_vignette(graphics: ui.Graphics, bounds: box.Rect): unit
    graphics:set_color(CLEAR)
    local band_x: f64 = bounds.width * VIGNETTE_BAND
    local band_y: f64 = bounds.height * VIGNETTE_BAND
    plate.veil_rectangle(
        graphics,
        bounds.x,
        bounds.y,
        bounds.width,
        band_y,
        VIGNETTE_DEPTH,
        VIGNETTE_DEPTH,
        0.0,
        0.0
    )
    plate.veil_rectangle(
        graphics,
        bounds.x,
        bounds.y + bounds.height - band_y,
        bounds.width,
        band_y,
        0.0,
        0.0,
        VIGNETTE_DEPTH,
        VIGNETTE_DEPTH
    )
    plate.veil_rectangle(
        graphics,
        bounds.x,
        bounds.y,
        band_x,
        bounds.height,
        VIGNETTE_DEPTH,
        0.0,
        0.0,
        VIGNETTE_DEPTH
    )
    plate.veil_rectangle(
        graphics,
        bounds.x + bounds.width - band_x,
        bounds.y,
        band_x,
        bounds.height,
        0.0,
        VIGNETTE_DEPTH,
        VIGNETTE_DEPTH,
        0.0
    )
end

function draw_fallback(graphics: ui.Graphics, bounds: box.Rect): unit
    graphics:clear(CLEAR)
    draw_field(graphics, bounds)
    draw_shafts(graphics, bounds)
    draw_vignette(graphics, bounds)
end

function draw_at(surface: ui.Surface, bounds: box.Rect): unit
    local maybe_shader: graphics_module.Shader? = surface.effects.astral_sea.shader
    if maybe_shader ~= nil then
        local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
        local aspect: f64 = bounds.width / bounds.height
        local binding: graphics_module.ShaderBindingResult = surface.graphics:bind_shader(
            shader,
            {graphics_module.float_parameter("u_aspect", aspect)}
        )
        if binding.ok then
            surface.graphics:set_color("#ffffff")
            surface.graphics:fill_rectangle(bounds.x, bounds.y, bounds.width, bounds.height)
            surface.graphics:use_default_shader()
            return
        end
    end
    draw_fallback(surface.graphics, bounds)
end

function node(): ui.Node
    return ui.Node.measured(
        function(graphics: ui.Graphics?, into: box.Intrinsic): unit
            box.set_fixed(into, 0.0, 0.0)
        end,
        draw_at
    )
end

return { node = node, draw_at = draw_at, lamp_at = lamp_at }
