-- The astral sea the vault opens onto: nebulas drifting behind the table and
-- a field of stars turning slowly through them, closing to black at the
-- board's walls so the eye still settles on the cards.
--
-- The sea is a fragment program (shaders/astral-sea.frag) drawn over the
-- board as one quad, with the board's clock as its phase. It moves on its
-- own — nothing in the game drives it — so a viewer who has asked their
-- browser for reduced motion is shown one fixed moment of it instead. That
-- still is baked once into a render target the size of the board and drawn
-- as a sprite from then on, which also keeps a software rasterizer from
-- paying for the whole sky every frame.
local box = require("../ui/layout")
local ui = require("../ui/node")
local graphics_module = require("waluau:engine/graphics")
local shader_program = require("../shader_program")
local astral_sea_shader = require("../shaders/astral-sea.frag")
local ink = require("../ink")

local sea_still: graphics_module.RenderTarget? = nil
local sea_version: i32 = -1

function release_still(graphics: ui.Graphics): unit
    local still: graphics_module.RenderTarget? = sea_still
    if still ~= nil then
        graphics:release_render_target(still::graphics_module.RenderTarget)
    end
    sea_still = nil
end

local astral_sea_program: shader_program.Program = shader_program.new(
    astral_sea_shader,
    "astral sea",
    false
)

const CLEAR: string = "#09090b"
-- What stands in for the sea until its program has compiled: the deep
-- between the nebulas, so the board is never a different room for a frame.
const DEEP: string = "#05030e"
-- The moment of the sea a viewer who prefers reduced motion sees. Some way
-- into the drift rather than its first second, so the gas has folded.
const STILL_PHASE: f64 = 140.0

function use_sea(surface: ui.Surface, aspect: f64, phase: f64): bool
    return astral_sea_program:bind(
        surface.graphics,
        {
            graphics_module.float_parameter("u_aspect", aspect),
            graphics_module.float_parameter("u_phase", phase)
        }
    )
end

-- The sea at one phase over one rectangle. False while the program is still
-- loading, or has failed, so the caller can stand something in for it.
function draw_sea(surface: ui.Surface, bounds: box.Rect, phase: f64): bool
    local graphics = surface.graphics
    if not use_sea(surface, bounds.width / bounds.height, phase) then
        return false
    end
    graphics:set_color("#ffffffff")
    graphics:fill_rectangle(bounds.x, bounds.y, bounds.width, bounds.height)
    ink.stop_effect(graphics)
    return true
end

function bake_still(surface: ui.Surface, width: i32, height: i32): graphics_module.RenderTarget?
    local graphics = surface.graphics
    local result: graphics_module.RenderTargetResult = graphics:create_render_target(width, height)
    if not result.ok then
        return nil
    end
    local target: graphics_module.RenderTarget = result.target
    if not graphics:set_render_target(target) then
        graphics:release_render_target(target)
        return nil
    end
    graphics:push_identity()
    graphics:clear(CLEAR)
    local drawn: bool = draw_sea(surface, box.rect(0.0, 0.0, width::f64, height::f64), STILL_PHASE)
    graphics:pop()
    graphics:set_screen_target()
    if not drawn then
        graphics:release_render_target(target)
        return nil
    end
    return target
end

-- The still sea at the board's current size, baking it first if the program
-- is ready. A bake at another size is from before a resize and is replaced.
-- As with the card paper, the bake only starts while drawing to the screen:
-- switching targets inside a capture would hand the rest of the capture to
-- the wrong surface.
function still_sea(surface: ui.Surface, bounds: box.Rect): graphics_module.RenderTarget?
    local graphics = surface.graphics
    local width: i32 = math.ceil(bounds.width)::i32
    local height: i32 = math.ceil(bounds.height)::i32
    local version: i32 = astral_sea_program:version(graphics)
    if version < 0 then
        return nil
    end
    if version ~= sea_version then
        release_still(graphics)
        sea_version = version
    end
    local baked: graphics_module.RenderTarget? = sea_still
    if baked ~= nil then
        local still: graphics_module.RenderTarget = baked::graphics_module.RenderTarget
        if still.width == width and still.height == height then
            return still
        end
        graphics:release_render_target(still)
        sea_still = nil
    end
    if graphics.current_target ~= 0 then
        return nil
    end
    local fresh: graphics_module.RenderTarget? = bake_still(surface, width, height)
    sea_still = fresh
    return fresh
end

function draw_at(surface: ui.Surface, bounds: box.Rect): unit
    local graphics = surface.graphics
    graphics:clear(CLEAR)
    if bounds.width <= 0.0 or bounds.height <= 0.0 then
        return
    end
    if surface.reduced_motion then
        local still: graphics_module.RenderTarget? = still_sea(surface, bounds)
        if still ~= nil then
            graphics:set_color("#ffffffff")
            if graphics:draw_render_target(
                still::graphics_module.RenderTarget,
                bounds.x,
                bounds.y,
                bounds.width,
                bounds.height
            ) then
                return
            end
        end
        -- No bake to draw from — inside a capture, say — but the program may
        -- still be ready: the same fixed moment, drawn directly.
        if draw_sea(surface, bounds, STILL_PHASE) then
            return
        end
    elseif draw_sea(surface, bounds, graphics.time) then
        return
    end
    graphics:set_color(DEEP)
    graphics:fill_rectangle(bounds.x, bounds.y, bounds.width, bounds.height)
end

function node(): ui.Node
    return ui.Node.measured(
        function(graphics: ui.Graphics?, into: box.Intrinsic): unit
            box.set_fixed(into, 0.0, 0.0)
        end,
        draw_at
    )
end

return { node = node, draw_at = draw_at }
