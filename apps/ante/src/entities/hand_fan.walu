-- The player's hand: five relics held as an overlapping, tilted fan rather
-- than a row. Each step outward from the middle relic slides sideways, tilts
-- further from upright, and dips along a shallow arc, so the hand reads as
-- something held rather than something laid out.
--
-- The fan is the one row on the board that is not a box flow, and it says so:
-- its slots are an arc, and an arc is not a sequence of rectangles with a gap
-- between them. What it does share with every other entity is the contract —
-- it measures the envelope it needs, including the dip, and it arranges itself
-- inside whatever rectangle it is handed, tightening its pitch when that
-- rectangle is narrower than the hand would like.

local box = require("../box_layout")
local entity = require("../entity")
local card = require("./card")
local card_row = require("./card_row")

-- FAN_PITCH is well under a card width, so relics overlap; because each one
-- covers only its neighbour's right edge, the rank and school in the top-left
-- corner stay readable.
const FAN_MIDDLE: f64 = 2.0
const FAN_PITCH: f64 = 74.0
const FAN_TILT: f64 = 0.075
-- The arc's dip per squared step: the outermost relics of a five-card hand sit
-- 4 * FAN_DROP below the middle one, which approximates a pivot far below the
-- board.
const FAN_DROP: f64 = 2.8
-- How far the fan slides open around the focused relic, in the same steps as
-- everything else here — about a quarter of the gap to its neighbour. This is
-- deliberately short of the ~0.41 steps it would take for FAN_PITCH to clear a
-- card width: relics keep their dealt stacking order, so the focused one still
-- tucks under the relic to its right, and the parting reads as the fan
-- breathing rather than a card climbing out of it.
const FAN_PART: f64 = 0.23
-- A focus of CLOSED — below the first of the relics — closes the fan, leaving
-- every relic at its resting slot. Focus only exists while the cursor can
-- actually move, so cards in flight and a resolving breach both draw the hand
-- closed, which is what keeps animation endpoints honest: the resting slot
-- describes the closed fan.
const CLOSED: i32 = -1

-- Both hand rows are laid out for however many cards they currently hold. The
-- five-card layout is the reference; boss battles start at eleven and shrink
-- after every breach, so the geometry below is parametric on that count.
function middle_of(count: i32): f64
    return ((count - 1)::f64) * 0.5
end

-- How much a larger fan flattens its tilt and dip so its outermost relics keep
-- the reference five-card silhouette instead of curling off the board.
function scale_of(count: i32): f64
    local middle: f64 = middle_of(count)
    if middle <= FAN_MIDDLE then return 1.0 end
    return FAN_MIDDLE / middle
end

-- Where a relic sits along the fan: steps from the middle relic, negative to
-- its left, plus however far the parting has pushed it. This one number is the
-- fan's only degree of freedom — slide, dip, and tilt all read off it — so a
-- parting relic travels along the arc the fan already describes instead of
-- skidding sideways out of the curve.
function step_at(index: i32, part: f64, count: i32): f64
    return (index::f64) - middle_of(count) + part
end

function angle_at(index: i32, part: f64, count: i32): f64
    return step_at(index, part, count) * FAN_TILT * scale_of(count)
end

-- How far the outermost relic dips below the middle one. The fan's box has to
-- carry this on both sides of its centre line, or the arc would push the hand
-- off whatever the layout gave it.
function dip_of(count: i32): f64
    local middle: f64 = middle_of(count)
    local scale: f64 = scale_of(count)
    return middle * middle * FAN_DROP * scale * scale
end

function intrinsic(count: i32): box.Intrinsic
    if count <= 0 then return box.fixed(0.0, 0.0) end
    return box.fixed(
        ((count - 1)::f64) * FAN_PITCH + card.width,
        card.height + dip_of(count) * 2.0)
end

function pitch_in(bounds: box.Rect, count: i32): f64
    return card_row.pitch_for(bounds.width - card.width, count, FAN_PITCH)
end

-- The card box of one relic, in its own tilted frame: the rectangle the relic
-- is drawn into before the fan's rotation about its centre is applied.
function slot_rect(bounds: box.Rect, index: i32, part: f64, count: i32): box.Rect
    local step: f64 = step_at(index, part, count)
    local scale: f64 = scale_of(count)
    return entity.rect(
        bounds.x + bounds.width * 0.5 + step * pitch_in(bounds, count)
            - card.width * 0.5,
        bounds.y + bounds.height * 0.5 + step * step * FAN_DROP * scale * scale
            - card.height * 0.5,
        card.width,
        card.height)
end

-- Where a relic's parting offset is headed: the fan opens around the focused
-- relic, everything left of it sliding left and everything right sliding
-- right, while the focused relic itself holds still. The screen eases each
-- relic toward this rather than reading it straight, so the fan parts over a
-- few frames instead of snapping as the cursor steps along the hand.
function part_target(index: i32, focus: i32): f64
    if focus == CLOSED then return 0.0 end
    if index < focus then return -FAN_PART end
    if index > focus then return FAN_PART end
    return 0.0
end

-- One relic in the fan. Drawing it about its own centre lets the tilt carry
-- everything with it — the bind lift rises along the card's own axis rather
-- than straight up the screen, and the focus edge stays square to the card.
function draw_slot(
    surface: entity.Surface, value: card.Look,
    bounds: box.Rect, index: i32, part: f64, count: i32
): unit
    local slot: box.Rect = slot_rect(bounds, index, part, count)
    local graphics = surface.graphics
    graphics:push()
    graphics:translate(slot.x + card.width * 0.5, slot.y + card.height * 0.5)
    graphics:rotate(angle_at(index, part, count))
    card.draw_at(surface, value, -(card.width * 0.5), -(card.height * 0.5))
    graphics:pop()
end

-- The topmost relic of the fan under a point, or -1. Later slots draw over
-- earlier ones, so the scan runs highest slot first, and each relic's card box
-- is checked in its own tilted frame: the point moves into the card's local
-- space by undoing the same centre/rotation transform the card was drawn with.
function hit(bounds: box.Rect, parts: {f64}, x: f64, y: f64): i32
    for index = #parts - 1, 0::i32, -1::i32 do
        local part: f64 = parts[index]
        local angle: f64 = angle_at(index, part, #parts)
        local slot: box.Rect = slot_rect(bounds, index, part, #parts)
        local dx: f64 = x - (slot.x + card.width * 0.5)
        local dy: f64 = y - (slot.y + card.height * 0.5)
        local local_x: f64 = dx * math.cos(angle) + dy * math.sin(angle)
        local local_y: f64 = dy * math.cos(angle) - dx * math.sin(angle)
        if math.abs(local_x) <= card.width * 0.5
            and math.abs(local_y) <= card.height * 0.5
        then
            return index
        end
    end
    return -1
end

-- The whole hand as one entity. Relics keep the order they were dealt in,
-- focused or not: pulling the focused one to the front would slide it through
-- its neighbours instead of opening a gap for it. The parting alone gives it
-- room.
--
-- `hidden` marks slots a card is currently flying into, which stay empty until
-- the animation lands so state that has already changed is not revealed ahead
-- of it.
function node(looks: {card.Look}, parts: {f64}, hidden: {bool}): entity.Node
    return entity.measured(
        function(metrics: entity.Metrics): box.Intrinsic
            return intrinsic(#looks)
        end,
        function(surface: entity.Surface, bounds: box.Rect): unit
            for index = 0::i32, #looks - 1 do
                if not hidden[index] then
                    draw_slot(
                        surface, looks[index], bounds, index, parts[index], #looks)
                end
            end
        end)
end

return {
    node = node,
    draw_slot = draw_slot,
    slot_rect = slot_rect,
    angle_at = angle_at,
    dip_of = dip_of,
    intrinsic = intrinsic,
    part_target = part_target,
    hit = hit,
    closed = CLOSED,
}
