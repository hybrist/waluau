-- One card color as a swatch: that color's live field running under its
-- own card and name. The help legend is four of these in a row, and it draws
-- them through the card's own field binding rather than a copy of it, so the
-- legend teaches the language the board actually speaks.
local box = require("../ui/layout")
local ui = require("../ui/node")
local ink = require("../ink")
local card = require("./card")

const WIDTH: f64 = 136.0
const HEIGHT: f64 = 76.0
-- Where the card and the color's name sit inside the swatch.
const SIGIL_DROP: f64 = 24.0
const NAME_DROP: f64 = 56.0
const NAME_SIZE: f64 = 12.0
const NAME_INK: string = "#b5b5bd"

local NAMES: {string} = {"RED", "BLUE", "BLACK", "GREEN"}

type TilePresentation = { suit: i32 }
export type Stateful = { presentation: TilePresentation, root: ui.Node }

function Stateful.new(suit: i32): Stateful
    local presentation: TilePresentation = { suit = suit }
    local root: ui.Node = ui.Node.sized(
        WIDTH,
        HEIGHT,
        function(surface: ui.Surface, bounds: box.Rect): unit
            local suit: i32 = presentation.suit
            local graphics = surface.graphics
            local center: f64 = bounds.x + bounds.width * 0.5
            card.use_color_field(surface, suit, false, true, bounds.width / bounds.height)
            graphics:set_color("#17171c")
            graphics:fill_rectangle(bounds.x, bounds.y, bounds.width, bounds.height)
            ink.stop_effect(graphics)
            graphics:set_color(ink.color_ink(suit))
            graphics:set_line_width(1.5)
            graphics:stroke_rectangle(bounds.x, bounds.y, bounds.width, bounds.height)
            card.draw_sigil(surface, suit, center - 11.0, bounds.y + SIGIL_DROP)
            ink.text_centered(
                graphics,
                NAMES[suit + 1],
                center,
                bounds.y + NAME_DROP,
                NAME_SIZE,
                NAME_INK
            )
        end
    )
    return { presentation = presentation, root = root }
end

function Stateful:present(suit: i32): unit
    self.presentation.suit = suit
end

function node(suit: i32): ui.Node
    return Stateful.new(suit).root
end

return { node = node }
