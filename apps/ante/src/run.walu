-- DOM-free run state: the roguelike frame around the heist. A run is a
-- sequence of vaults fought with one mana pool. Clearing a vault carries the
-- mana that survived it into the next one; losing a vault ends the run, and
-- the mana with it.
--
-- This module owns the shape of the sequence — which vault is live, how much
-- mana it opens with, which vaults are boss battles, and the spell loadout
-- every vault is fought with — and nothing about the heist inside a vault.
-- Whether the live vault was won or lost is the rules module's answer, so
-- nothing here duplicates it. What the intermission between vaults sells is the
-- shop's answer; this module only applies the purchase to the run.

local game = require("./game")
local snapshot_data = require("./snapshot")

-- `vault` is 1-based and counts every attempt in the sequence, cleared or
-- live. `mana` is what the live vault was dealt, not what it has left: the
-- rules spend from their own pool, and a cleared vault hands its remainder
-- back here — which is also the purse the intermission between vaults shops
-- from. `spells` is the loadout every vault of the run is fought with, in the
-- order the spells were learned; `start_spell` is the one the menu picked, so a
-- run that ends can start over carrying what it originally set out with rather
-- than what it had bought by the time it died. `rush` is the boss-rush run,
-- where every vault is a boss battle rather than every third.
type State = {
    vault: i32,
    mana: i32,
    cleared: i32,
    spells: {game.Spell},
    start_spell: i32,
    rush: bool
}

-- Every third vault is the boss battle variant, so a run's cadence is two
-- standard heists and then eleven relics with no replacements.
const BOSS_EVERY: i32 = 3
-- Nine vaults is the run the ante table is written for: three acts of two
-- heists and a boss, ending on one. The boss rush is a shorter, steeper sprint
-- rather than nine consecutive eleven-relic battles.
const RUN_LENGTH: i32 = 9
const RUSH_LENGTH: i32 = 5
-- Past the last vault the city keeps going and the table runs out, so the ante
-- takes over on a formula. The step grows with every vault beyond the finish,
-- which is what makes the tail end: a vault pays about eleven and the demand
-- climbs past that immediately and never comes back down.
const ENDLESS_STEP: i32 = 6
-- Two spells are as many as the robbers can hold ready at once — keys 1 and 2
-- in the vault. Learning a third is a trade, not an addition.
const MAX_SPELLS: i32 = 2
-- However cheap a spell is sharpened, a cast is never free.
const MIN_SPELL_COST: i32 = 2
const SNAPSHOT_SCHEMA: string = "ante-run-v2"
const SNAPSHOT_COLLECTION_LIMIT: i32 = 8

-- `rush` starts the boss-rush run instead of the standard cadence; `spell` is
-- the starting spell the run sets out with, and the whole of its opening
-- loadout.
function new(spell: i32, rush: bool): State
    return {
        vault = 1,
        mana = game.starting_mana,
        cleared = 0,
        spells = { game.new_spell(spell) },
        start_spell = spell,
        rush = rush,
    }
end

-- Whether the numbered vault is fought as a boss battle. Vault numbers are
-- 1-based, so the third, sixth, and ninth vaults are the boss cadence.
function boss_at(vault: i32, rush: bool): bool
    if rush then return true end
    return vault % BOSS_EVERY == 0
end

function State:boss(): bool
    return boss_at(self.vault, self.rush)
end

function State:next_is_boss(): bool
    return boss_at(self.vault + 1, self.rush)
end

-- How many vaults the authored curve covers. The run does not stop there — what
-- it marks is where the table ends and the endless formula takes over.
function run_length(rush: bool): i32
    if rush then return RUSH_LENGTH end
    return RUN_LENGTH
end

-- What clearing the numbered vault costs, taken out of the mana the robbers
-- walk out holding. Priced against measured play rather than guessed: a cleared
-- vault pays about eleven mana (see `economy.test.walu`), and the table is
-- built around that number crossing it.
--
-- The first act asks for well under eleven, so a run that is going well banks a
-- surplus. The second holds near it. The third asks for more than a vault can
-- pay, so the pile that took two acts to build is what act three is spent out
-- of — a run arrives at the last vault on fumes, and one that stumbled anywhere
-- along the way does not arrive at all. That is where the difficulty ramps: not
-- in making a breach harder to win, which nothing here touches, but in what
-- winning has to be worth by the time the run is deep.
--
-- Boss vaults take the largest steps, which is what makes the end of an act a
-- mana wall as well as an eleven-relic one.
--
-- The table is written out inside the function rather than held module-side so
-- the values sit next to the reasoning about them.
function ante_at(vault: i32, rush: bool): i32
    local table_values: {i32} = { 3, 5, 8, 12, 16, 21, 25, 29, 34 }
    if rush then table_values = { 5, 10, 16, 23, 30 } end
    local length: i32 = #table_values
    if vault < 1 then return table_values[0] end
    if vault <= length then return table_values[vault - 1] end
    -- Past the table the demand climbs by a step that itself grows, so the gap
    -- between what a vault pays and what it costs to leave widens every time.
    local ante: i32 = table_values[length - 1]
    for step = 1::i32, vault - length do
        ante += ENDLESS_STEP + step
    end
    return ante
end

function State:ante(): i32
    return ante_at(self.vault, self.rush)
end

-- Whether the run is past the vault its table was written for, and walking on
-- for the sake of walking on.
function State:endless(): bool
    return self.vault > run_length(self.rush)
end

-- The verdict of a fought vault, read as a moment in the run. There are two
-- ways to lose a vault and two ways to leave one, and this says which without
-- applying any of them — one classifier, so the screen showing a verdict and
-- the settle that acts on it can never disagree about what happened.
--
-- `OUTCOME_WON` is a milestone rather than a stop: the last vault of the table
-- is cleared exactly the way any other is, and the run walks on into the
-- endless city. Only the two losses end a run.
const OUTCOME_NONE: i32 = 0
const OUTCOME_LOST_VAULT: i32 = 1
const OUTCOME_LOST_ANTE: i32 = 2
const OUTCOME_ADVANCE: i32 = 3
const OUTCOME_WON: i32 = 4

function outcome_of(
    vault: i32, rush: bool, cleared: bool, carried_mana: i32
): i32
    if not cleared then return OUTCOME_LOST_VAULT end
    if carried_mana < ante_at(vault, rush) then return OUTCOME_LOST_ANTE end
    -- The finish line is a moment the run passes through once, not a state it
    -- stays in, so this is the vault the table ends on and no vault after it.
    if vault == run_length(rush) then return OUTCOME_WON end
    return OUTCOME_ADVANCE
end

-- The run as the board reads it: which vault of the sequence this is, how many
-- the robbers have already taken, whether this one and the next are boss
-- battles, the mana the run carried in, what leaving this vault and the next
-- one costs, how far the authored curve runs, and the verdict on the live
-- vault. Read-only, the way game.View is — a screen showing the run must not be
-- able to move it.
--
-- `outcome` is the rules module's answer about a vault this module has not
-- settled yet, so it arrives rather than being re-derived here; a live vault
-- passes OUTCOME_NONE.
type View = {
    vault: i32,
    cleared: i32,
    boss: bool,
    next_is_boss: bool,
    carried_mana: i32,
    ante: i32,
    ante_ahead: i32,
    run_length: i32,
    outcome: i32
}

function view(state: State, outcome: i32): View
    return {
        vault = state.vault,
        cleared = state.cleared,
        boss = state:boss(),
        next_is_boss = state:next_is_boss(),
        carried_mana = state.mana,
        ante = state:ante(),
        ante_ahead = ante_at(state.vault + 1, state.rush),
        run_length = run_length(state.rush),
        outcome = outcome,
    }
end

-- The live vault has been fought to a verdict. Taking it advances the run,
-- charges the vault its ante, and carries what is left into the next one;
-- losing it — to the Arch Mage or to an ante the purse could not cover — ends
-- the run, and what follows is the first vault of a fresh one. A vault the run
-- already spent mana in is never fought twice.
--
-- The verdict is the rules module's answer, passed in rather than re-derived:
-- what a finished heist decided is not this module's to decide again.
function State:settle(cleared: bool, carried_mana: i32): i32
    local outcome: i32 = outcome_of(
        self.vault, self.rush, cleared, carried_mana)
    if outcome == OUTCOME_LOST_VAULT or outcome == OUTCOME_LOST_ANTE then
        self:restart(self.start_spell, self.rush)
        return outcome
    end
    -- Taking the last vault of the table and taking any other one are the same
    -- movement; what differs is only the screen that says so.
    self.mana = carried_mana - self:ante()
    self.cleared += 1
    self.vault += 1
    return outcome
end

function State:restart(spell: i32, rush: bool): unit
    local fresh: State = new(spell, rush)
    self.vault = fresh.vault
    self.mana = fresh.mana
    self.cleared = fresh.cleared
    self.spells = fresh.spells
    self.start_spell = spell
    self.rush = rush
end

-- Whether the loadout already holds that kind of spell, and therefore whether
-- an intermission has anything new to offer in it.
function State:carries(kind: i32): bool
    for spell in self.spells do
        if spell.kind == kind then return true end
    end
    return false
end

function State:spell_count(): i32
    return #self.spells
end

-- Which key that kind of spell answers to, or -1 when the loadout does not
-- carry it. An offer made about a spell names the spell rather than the key, so
-- that a trade moving spells between keys cannot silently redirect it.
function State:slot_of(kind: i32): i32
    for slot, spell in self.spells do
        if spell.kind == kind then return slot end
    end
    return -1
end

-- Spend from the carried pool. Buying between vaults comes out of the same mana
-- the next vault opens with, so a purchase is always a smaller pool to fight in.
function State:spend(mana: i32): bool
    if mana < 0 or mana > self.mana then return false end
    self.mana -= mana
    return true
end

-- Whether the spell in that slot has room left to be sharpened.
function State:can_sharpen(slot: i32): bool
    if slot < 0 or slot >= #self.spells then return false end
    return self.spells[slot].cost > MIN_SPELL_COST
end

function State:sharpen(slot: i32): bool
    if not self:can_sharpen(slot) then return false end
    self.spells[slot].cost -= 1
    return true
end

-- Take on a spell at full price. `slot` past the end appends while the loadout
-- has room, which is how the second spell gets its own key; naming an occupied
-- slot trades that spell away for the new one, which is the only way to take a
-- third.
function State:learn(kind: i32, slot: i32): bool
    if kind <= 0 or kind > game.spell_kind_count or self:carries(kind) then
        return false
    end
    if slot < 0 or slot > #self.spells or slot >= MAX_SPELLS then return false end
    if slot == #self.spells then
        table.insert(self.spells, game.new_spell(kind))
    else
        self.spells[slot] = game.new_spell(kind)
    end
    return true
end

-- The slot a newly learned spell would take by itself: the next number up while
-- the loadout has room, and -1 once it is full and something has to go.
function State:open_slot(): i32
    if #self.spells >= MAX_SPELLS then return -1 end
    return #self.spells
end

function snapshot(state: State): string
    local parts: {string} = { SNAPSHOT_SCHEMA }
    snapshot_data.append_i32(parts, state.vault)
    snapshot_data.append_i32(parts, state.mana)
    snapshot_data.append_i32(parts, state.cleared)
    snapshot_data.append_i32(parts, #state.spells)
    for spell in state.spells do
        snapshot_data.append_i32(parts, spell.kind)
        snapshot_data.append_i32(parts, spell.cost)
    end
    snapshot_data.append_i32(parts, state.start_spell)
    snapshot_data.append_bool(parts, state.rush)
    return table.concat(parts, ",")
end

function restore(snapshot_value: string): State?
    local reader: snapshot_data.Reader = snapshot_data.reader(
        snapshot_value, SNAPSHOT_COLLECTION_LIMIT)
    if reader:next_string() ~= SNAPSHOT_SCHEMA then return nil end
    local vault: i32 = reader:next_i32()
    local mana: i32 = reader:next_i32()
    local cleared: i32 = reader:next_i32()
    local spells: {game.Spell} = {}
    local spell_count: i32 = reader:next_length()
    for _ = 1, spell_count do
        -- TODO(waluau-363i): one token at a time into locals, because a record
        -- literal evaluates its fields in alphabetical order rather than written
        -- order and a kind and a cost are only told apart by their position in
        -- the payload. Inline the reads once the compiler orders them.
        local kind: i32 = reader:next_i32()
        local cost: i32 = reader:next_i32()
        table.insert(spells, { kind = kind, cost = cost })
    end
    local start_spell: i32 = reader:next_i32()
    local rush: bool = reader:next_bool()
    local restored: State = {
        vault = vault,
        mana = mana,
        cleared = cleared,
        spells = spells,
        start_spell = start_spell,
        rush = rush,
    }
    if not reader:complete() then return nil end
    -- No upper bound on the vault: a run past the end of its table is a run
    -- that won and kept walking, not a payload from another build.
    if vault < 1 then return nil end
    -- A run always carries at least the spell it set out with, and never more
    -- than the two the robbers can hold ready.
    if #spells < 1 or #spells > MAX_SPELLS then return nil end
    return restored
end

return {
    new = new,
    view = view,
    boss_at = boss_at,
    ante_at = ante_at,
    run_length = run_length,
    outcome_of = outcome_of,
    snapshot = snapshot,
    restore = restore,
    boss_every = BOSS_EVERY,
    max_spells = MAX_SPELLS,
    min_spell_cost = MIN_SPELL_COST,
    outcome_none = OUTCOME_NONE,
    outcome_lost_vault = OUTCOME_LOST_VAULT,
    outcome_lost_ante = OUTCOME_LOST_ANTE,
    outcome_advance = OUTCOME_ADVANCE,
    outcome_won = OUTCOME_WON,
}
