-- DOM-free run state: the roguelike frame around the duel. A run is a
-- sequence of duels fought with one gold pool and one pool of hearts.
-- Clearing a duel carries both into the next one; every hand the Opponent
-- takes costs a heart, and reaching zero ends the run.
--
-- This module owns the shape of the sequence — which duel is live, how much
-- gold it opens with, which duels are boss battles, and the spell loadout
-- every duel is fought with — and nothing about the duel inside a duel.
-- Whether the live duel was won or lost is the rules module's answer, so
-- nothing here duplicates it. What the intermission between duels sells is the
-- shop's answer; item effects use this module's mutable run state to apply the
-- purchase.

local game = require("./game")
local snapshot_data = require("./snapshot")
local spells = require("./spells/spell")

-- `duel` is 1-based and counts every attempt in the sequence, cleared or
-- live. `gold` is what the live duel was dealt, not what it has left: the
-- rules spend from their own pool, and a cleared duel hands its remainder
-- back here — which is also the purse the intermission between duels shops
-- from. `hearts` is damaged by lost hands and, unlike a duel-local tally,
-- survives every cleared duel. `spells` is the loadout every duel of the run
-- is fought with, in the order the spells were learned; `start_spell` is the one the menu picked, so a
-- run that ends can start over carrying what it originally set out with rather
-- than what it had bought by the time it died. `rush` is the boss-rush run,
-- where every duel is a boss battle rather than every third.
export type State = {
    duel: i32,
    gold: i32,
    hearts: i32,
    cleared: i32,
    spells: {game.Spell},
    start_spell: i32,
    rush: bool
}

-- Every third duel is the boss battle variant, so a run's cadence is two
-- standard heists and then seven cards with no replacements.
const BOSS_EVERY: i32 = 3
-- Nine duels is the run the target table is written for: three acts of two
-- heists and a boss, ending on one. The boss rush is a shorter, steeper sprint
-- rather than nine consecutive seven-card battles.
const RUN_LENGTH: i32 = 9
const RUSH_LENGTH: i32 = 5
-- Past the last duel the city keeps going and the table runs out, so the target
-- takes over on a formula. The step grows with every duel beyond the finish,
-- which is what makes the tail end: the demand climbs past a typical duel's
-- rarity-weighted pay immediately and never comes back down.
const ENDLESS_STEP: i32 = 6
-- Two spells are as many as the player can hold ready at once — keys 1 and 2
-- in the duel. Learning a third is a trade, not an addition.
const MAX_SPELLS: i32 = 2
-- However cheap a spell is upgraded, a cast is never free.
const MIN_SPELL_COST: i32 = 2
-- Three lost hands across the whole run. A won duel repairs nothing: health is
-- run state, just like the purse and loadout it carries through the shop.
const MAX_HEARTS: i32 = 3
const SNAPSHOT_SCHEMA: string = "duel-run-v3"
const SNAPSHOT_COLLECTION_LIMIT: i32 = 8

-- `rush` starts the boss-rush run instead of the standard cadence; `spell` is
-- the starting spell the run sets out with, and the whole of its opening
-- loadout.
function new(spell: i32, rush: bool): State
    return {
        duel = 1,
        gold = game.starting_gold,
        hearts = MAX_HEARTS,
        cleared = 0,
        spells = { game.new_spell(spell) },
        start_spell = spell,
        rush = rush,
    }
end

-- Whether the numbered duel is fought as a boss battle. Duel numbers are
-- 1-based, so the third, sixth, and ninth duels are the boss cadence.
function boss_at(duel: i32, rush: bool): bool
    if rush then return true end
    return duel % BOSS_EVERY == 0
end

function State:boss(): bool
    return boss_at(self.duel, self.rush)
end

function State:next_is_boss(): bool
    return boss_at(self.duel + 1, self.rush)
end

-- How many duels the authored curve covers. The run does not stop there — what
-- it marks is where the table ends and the endless formula takes over.
function run_length(rush: bool): i32
    if rush then return RUSH_LENGTH end
    return RUN_LENGTH
end

-- What clearing the numbered duel costs, taken out of the gold the player
-- walk out holding. Priced against measured play rather than guessed: a cleared
-- standard duel pays about twenty-five gold and a boss about thirty-six (see
-- `economy.test.walu`), and the table is built around those numbers crossing it.
--
-- The first act asks for well under that pay, so a run that is going well banks
-- a surplus. The second holds near it. The third asks more than a typical duel
-- pays, so the pile that took two acts to build is what act three is spent out
-- of — a run arrives at the last duel on fumes, and one that stumbled anywhere
-- along the way does not arrive at all. That is where the difficulty ramps: not
-- in making a round harder to win, which nothing here touches, but in what
-- winning has to be worth by the time the run is deep.
--
-- Boss duels take the largest steps, which is what makes the end of an act a
-- gold wall as well as a seven-card one.
--
-- The table is written out inside the function rather than held module-side so
-- the values sit next to the reasoning about them.
function target_at(duel: i32, rush: bool): i32
    local table_values: {i32} = { 6, 10, 18, 21, 25, 35, 38, 43, 70 }
    if rush then table_values = { 12, 24, 38, 55, 80 } end
    local length: i32 = #table_values
    if duel < 1 then return table_values[0] end
    if duel <= length then return table_values[duel - 1] end
    -- Past the table the demand climbs by a step that itself grows, so the gap
    -- between what a duel pays and what it costs to leave widens every time.
    local target: i32 = table_values[length - 1]
    for step = 1::i32, duel - length do
        target += ENDLESS_STEP + step
    end
    return target
end

function State:target(): i32
    return target_at(self.duel, self.rush)
end

-- Whether the run is past the duel its table was written for, and walking on
-- for the sake of walking on.
function State:endless(): bool
    return self.duel > run_length(self.rush)
end

-- The verdict of a fought duel, read as a moment in the run. Health, the duel,
-- or the target can end it; clearing it either advances or crosses the finish
-- line. This says which without applying any of them — one classifier, so the
-- screen showing a verdict and the settle that acts on it agree.
--
-- "won" is a milestone rather than a stop: the last duel of the table
-- is cleared exactly the way any other is, and the run walks on into the
-- endless city.
export type Outcome =
    "none" | "lost-health" | "lost-vault" | "lost-target" | "advance" | "won"

function outcome_is_loss(outcome: Outcome): bool
    return outcome == "lost-health"
        or outcome == "lost-vault"
        or outcome == "lost-target"
end

function outcome_walks_on(outcome: Outcome): bool
    return outcome == "advance" or outcome == "won"
end

function outcome_of(
    duel: i32, rush: bool, hearts: i32, cleared: bool, carried_gold: i32
): Outcome
    -- Health can end the run during a duel, before its ordinary best-of-three
    -- verdict exists. It therefore outranks both that verdict and the purse.
    if hearts <= 0 then return "lost-health" end
    if not cleared then return "lost-vault" end
    if carried_gold < target_at(duel, rush) then return "lost-target" end
    -- The finish line is a moment the run passes through once, not a state it
    -- stays in, so this is the duel the table ends on and no duel after it.
    if duel == run_length(rush) then return "won" end
    return "advance"
end

-- The run as the board reads it: which duel of the sequence this is, how many
-- the player have already taken, whether this one and the next are boss
-- battles, the gold and hearts the run carried in, what leaving this duel and
-- the next one costs, how far the authored curve runs, and the verdict on the
-- live duel. Read-only, the way game.View is — a screen showing the run must not be
-- able to move it.
--
-- `outcome` is the rules module's answer about a duel this module has not
-- settled yet, so it arrives rather than being re-derived here; a live duel
-- passes "none".
export type View = {
    duel: i32,
    cleared: i32,
    boss: bool,
    next_is_boss: bool,
    carried_gold: i32,
    hearts: i32,
    max_hearts: i32,
    target: i32,
    ante_ahead: i32,
    run_length: i32,
    outcome: Outcome
}

function view(state: State, outcome: Outcome): View
    return {
        duel = state.duel,
        cleared = state.cleared,
        boss = state:boss(),
        next_is_boss = state:next_is_boss(),
        carried_gold = state.gold,
        hearts = state.hearts,
        max_hearts = MAX_HEARTS,
        target = state:target(),
        ante_ahead = target_at(state.duel + 1, state.rush),
        run_length = run_length(state.rush),
        outcome = outcome,
    }
end

-- The live duel has been fought to a verdict. Taking it advances the run,
-- charges the duel its target, and carries what is left into the next one;
-- losing the run — to health, the opponent, or a target the purse could not
-- cover — starts a fresh one. A duel the run already spent gold in is never
-- fought twice.
--
-- The verdict is the rules module's answer, passed in rather than re-derived:
-- what a finished duel decided is not this module's to decide again.
function State:settle(cleared: bool, carried_gold: i32): Outcome
    local outcome: Outcome = outcome_of(
        self.duel, self.rush, self.hearts, cleared, carried_gold)
    if outcome_is_loss(outcome) then
        self:restart(self.start_spell, self.rush)
        return outcome
    end
    -- Taking the last duel of the table and taking any other one are the same
    -- movement; what differs is only the screen that says so.
    self.gold = carried_gold - self:target()
    self.cleared += 1
    self.duel += 1
    return outcome
end

function State:restart(spell: i32, rush: bool): unit
    local fresh: State = new(spell, rush)
    self.duel = fresh.duel
    self.gold = fresh.gold
    self.hearts = fresh.hearts
    self.cleared = fresh.cleared
    self.spells = fresh.spells
    self.start_spell = spell
    self.rush = rush
end

-- Charge exactly one heart for a hand the Opponent took. A terminal reveal
-- may call this before the run is settled, so zero is an observable state,
-- while repeated calls cannot take health negative.
function State:lose_hand(): bool
    if self.hearts > 0 then self.hearts -= 1 end
    return self.hearts == 0
end

-- Whether the loadout already holds that kind of spell, and therefore whether
-- an intermission has anything new to offer in it.
function State:carries(kind: spells.SpellKind): bool
    for spell in self.spells do
        if spell.kind == kind then return true end
    end
    return false
end

function State:spell_count(): i32
    return #self.spells
end

-- Which key that kind of spell answers to, or -1 when the loadout does not
-- carry it. An offer made about a spell names the spell rather than the key, so
-- that a trade moving spells between keys cannot silently redirect it.
function State:slot_of(kind: spells.SpellKind): i32
    for slot, spell in self.spells do
        if spell.kind == kind then return slot end
    end
    return -1
end

-- Spend from the carried pool. Buying between duels comes out of the same gold
-- the next duel opens with, so a purchase is always a smaller pool to fight in.
function State:spend(gold: i32): bool
    if gold < 0 or gold > self.gold then return false end
    self.gold -= gold
    return true
end

-- Whether the spell in that slot has room left to be upgraded.
function State:can_sharpen(slot: i32): bool
    if slot < 0 or slot >= #self.spells then return false end
    return self.spells[slot].cost > MIN_SPELL_COST
end

function State:upgrade(slot: i32): bool
    if not self:can_sharpen(slot) then return false end
    self.spells[slot].cost -= 1
    return true
end

-- Take on a spell at full price. `slot` past the end appends while the loadout
-- has room, which is how the second spell gets its own key; naming an occupied
-- slot trades that spell away for the new one, which is the only way to take a
-- third.
function State:learn(kind: spells.SpellKind, slot: i32): bool
    if self:carries(kind) then
        return false
    end
    if slot < 0 or slot > #self.spells or slot >= MAX_SPELLS then return false end
    if slot == #self.spells then
        table.insert(self.spells, spells.Spell__new(kind))
    else
        self.spells[slot] = spells.Spell__new(kind)
    end
    return true
end

-- The slot a newly learned spell would take by itself: the next number up while
-- the loadout has room, and -1 once it is full and something has to go.
function State:open_slot(): i32
    if #self.spells >= MAX_SPELLS then return -1 end
    return #self.spells
end

function snapshot(state: State): string
    local parts: {string} = { SNAPSHOT_SCHEMA }
    snapshot_data.append_i32(parts, state.duel)
    snapshot_data.append_i32(parts, state.gold)
    snapshot_data.append_i32(parts, state.cleared)
    snapshot_data.append_i32(parts, state.hearts)
    snapshot_data.append_i32(parts, #state.spells)
    for spell in state.spells do
        snapshot_data.append_i32(parts, spell.kind:tonumber()::i32)
        snapshot_data.append_i32(parts, spell.cost)
    end
    snapshot_data.append_i32(parts, state.start_spell)
    snapshot_data.append_bool(parts, state.rush)
    return table.concat(parts, ",")
end

function restore(snapshot_value: string): State?
    local reader: snapshot_data.Reader = snapshot_data.reader(
        snapshot_value, SNAPSHOT_COLLECTION_LIMIT)
    if reader:next_string() ~= SNAPSHOT_SCHEMA then return nil end
    local duel: i32 = reader:next_i32()
    local gold: i32 = reader:next_i32()
    local cleared: i32 = reader:next_i32()
    local hearts: i32 = reader:next_i32()
    local spells: {game.Spell} = {}
    local spell_count: i32 = reader:next_length()
    for _ = 1, spell_count do
        local kind: game.SpellKind? = game.spell_kind_from(reader:next_i32())
        if kind == nil then return nil end
        table.insert(spells, {
            kind = kind::game.SpellKind, cost = reader:next_i32(),
        })
    end
    local start_spell: i32 = reader:next_i32()
    local rush: bool = reader:next_bool()
    local restored: State = {
        duel = duel,
        gold = gold,
        hearts = hearts,
        cleared = cleared,
        spells = spells,
        start_spell = start_spell,
        rush = rush,
    }
    if not reader:complete() then return nil end
    -- No upper selected on the duel: a run past the end of its table is a run
    -- that won and kept walking, not a payload from another build.
    if duel < 1 then return nil end
    -- Zero is the terminal reveal before settle restarts the run; no run can
    -- have more health than it opened with or take damage below zero.
    if hearts < 0 or hearts > MAX_HEARTS then return nil end
    -- A run always carries at least the spell it set out with, and never more
    -- than the two the player can hold ready.
    if #spells < 1 or #spells > MAX_SPELLS then return nil end
    return restored
end

return {
    new = new,
    view = view,
    boss_at = boss_at,
    target_at = target_at,
    run_length = run_length,
    outcome_of = outcome_of,
    outcome_is_loss = outcome_is_loss,
    outcome_walks_on = outcome_walks_on,
    snapshot = snapshot,
    restore = restore,
    boss_every = BOSS_EVERY,
    max_spells = MAX_SPELLS,
    min_spell_cost = MIN_SPELL_COST,
    max_hearts = MAX_HEARTS,
}
