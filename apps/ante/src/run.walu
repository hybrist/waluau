-- DOM-free run state: the roguelike frame around the duel. A run is a
-- sequence of duels fought with one gold pool and one pool of hearts.
-- Clearing a duel carries both into the next one; every hand the Opponent
-- takes costs a heart, and reaching zero ends the run.
--
-- This module owns the shape of the sequence — which duel is live, how much
-- gold it opens with, which duels are boss battles and which boss is standing
-- in the next of them, and the spell loadout every duel is fought with — and
-- nothing about the duel inside a duel.
-- Whether the live duel was cleared is the rules module's answer, so nothing
-- here duplicates it. What the intermission between duels sells is the
-- shop's answer; item effects use this module's mutable run state to apply the
-- purchase.
local bosses = require("./bosses/boss")
local game = require("./game")
local spells = require("./spells/spell")

-- `duel` is 1-based and counts every attempt in the sequence, cleared or
-- live. `gold` is what the live duel was dealt, not what it has left: the
-- rules spend from their own pool, and a cleared duel hands its remainder
-- back here — which is also the purse the intermission between duels shops
-- from. `hearts` is damaged by lost hands and, unlike a duel-local tally,
-- survives every cleared duel. `spells` is the loadout every duel of the run
-- is fought with, in the order the spells were learned; `start_spell` is the one the menu picked, so a
-- run that ends can start over carrying what it originally set out with rather
-- than what it had bought by the time it died. `rush` is the boss-rush run,
-- where every duel is a boss battle rather than every third.
--
-- `next_boss` is who the run's next boss duel is fought against, and it is
-- rolled ahead of that duel rather than when it starts: a run always knows
-- which boss is coming, which is what lets the duels and the fence before it
-- say so. While the cadence is on a boss duel it names the boss standing
-- there; the roll for the one after happens once that duel is behind the run.
-- `boss_pool` is what it is rolled out of — the bosses not drawn since the
-- pool was last filled, so a run works through the whole roster before any
-- boss comes back.
export type State = {
    duel: i32,
    gold: i32,
    hearts: i32,
    cleared: i32,
    spells: {game.Spell},
    start_spell: spells.SpellKind,
    rush: bool,
    boss_pool: {bosses.Kind},
    next_boss: bosses.Kind
}

-- Every third duel is the boss battle variant, so a run's cadence is two
-- standard heists and then a seven-card hand.
const BOSS_EVERY: i32 = 3
-- Nine duels marks a completed run: three acts of two heists and a boss,
-- ending on one. The boss rush is a shorter sprint made entirely of
-- seven-card battles.
const RUN_LENGTH: i32 = 9
const RUSH_LENGTH: i32 = 5
-- Two spells are as many as the player can hold ready at once — keys 1 and 2
-- in the duel. A full loadout cannot take on another kind.
const MAX_SPELLS: i32 = 2
-- Three lost hands across the whole run. A won duel repairs nothing: health is
-- run state, just like the purse and loadout it carries through the shop.
const MAX_HEARTS: i32 = 3
const SNAPSHOT_SCHEMA: string = "duel-run-v6"

-- `rush` starts the boss-rush run instead of the standard cadence; `spell` is
-- the starting spell the run sets out with, and the whole of its opening
-- loadout.
function State.new(spell: spells.SpellKind, rush: bool): State
    -- The opening roll comes out of a full roster and off to the side of the
    -- record, so the run is already carrying its first boss by the time it has
    -- a first duel to fight.
    local pool: {bosses.Kind} = bosses.all()
    local next_boss: bosses.Kind = draw_from(pool)
    return {
        duel = 1,
        gold = game.starting_gold,
        hearts = MAX_HEARTS,
        cleared = 0,
        spells = {spells.Spell.new(spell, 1)},
        start_spell = spell,
        rush = rush,
        boss_pool = pool,
        next_boss = next_boss
    }
end

-- Whether the numbered duel is fought as a boss battle. Duel numbers are
-- 1-based, so the third, sixth, and ninth duels are the boss cadence.
function boss_at(duel: i32, rush: bool): bool
    if rush then
        return true
    end
    return duel % BOSS_EVERY == 0
end

function State:boss(): bool
    return boss_at(self.duel, self.rush)
end

function State:next_is_boss(): bool
    return boss_at(self.duel + 1, self.rush)
end

-- The roster a drained pool is filled from. Every boss goes back in except the
-- one just fought, which is held back so that working through the roster and
-- starting it over cannot hand out the same boss twice running. A roster with
-- nothing else to offer — which is the roster today — hands that boss straight
-- back rather than refilling to nothing: the bias is against a repeat, not a
-- rule that there can never be one.
function refilled_pool(last: bosses.Kind): {bosses.Kind}
    local pool: {bosses.Kind} = bosses.all()
    if #pool < 2 then
        return pool
    end
    for index, kind in pool do
        if kind == last then
            table.remove(pool, index)
            return pool
        end
    end
    return pool
end

-- Take a boss out of the pool, which is what makes the draw one without
-- replacement: what has been rolled is gone until the pool is filled again.
function draw_from(pool: {bosses.Kind}): bosses.Kind
    local index: i32 = math.random(#pool)
    local kind: bosses.Kind = pool[index]
    table.remove(pool, index)
    return kind
end

-- Roll who the next boss duel is fought against. Called once the boss duel
-- that was standing is behind the run, so the boss it just fought is the one
-- the refill holds back.
function State:roll_next_boss(): unit
    if #self.boss_pool == 0 then
        self.boss_pool = refilled_pool(self.next_boss)
    end
    self.next_boss = draw_from(self.boss_pool)
end

-- Which boss the live duel is fought against, or nil when the cadence has not
-- put one there. The boss standing in a live boss duel is the one the run has
-- been carrying since before it: nothing is rolled at the door.
function State:boss_kind(): bosses.Kind?
    if not self:boss() then
        return nil
    end
    return self.next_boss
end

-- How many duels earn the run's victory milestone. The run does not stop
-- there: clearing the milestone carries it into the endless city.
function run_length(rush: bool): i32
    if rush then
        return RUSH_LENGTH
    end
    return RUN_LENGTH
end

-- Whether the run has passed its victory milestone and kept walking.
function State:endless(): bool
    return self.duel > run_length(self.rush)
end

-- The verdict of a fought duel, read as a moment in the run. Exhausting the
-- run's hearts ends it; so does reaching a boss duel's end without winning its
-- final hand. Clearing the duel either advances or crosses the finish line.
-- This says which without applying any of them — one classifier, so the
-- screen showing a verdict and the settle that acts on it agree.
--
-- "won" is a milestone rather than a stop: the last authored duel
-- is cleared exactly the way any other is, and the run walks on into the
-- endless city.
export type Outcome = "none" | "lost-health" | "lost-duel" | "advance" | "won"

function outcome_is_loss(outcome: Outcome): bool
    return outcome == "lost-health" or outcome == "lost-duel"
end

function outcome_walks_on(outcome: Outcome): bool
    return outcome == "advance" or outcome == "won"
end

function outcome_of(duel: i32, rush: bool, hearts: i32, finished: bool, cleared: bool): Outcome
    -- Health can end the run during a duel before the rules report a verdict.
    -- It therefore outranks that verdict.
    if hearts <= 0 then
        return "lost-health"
    end
    if not finished then
        return "none"
    end
    if not cleared then
        return "lost-duel"
    end
    -- The finish line is a moment the run passes through once, not a state it
    -- stays in, so this is the final authored duel and no duel after it.
    if duel == run_length(rush) then
        return "won"
    end
    return "advance"
end

-- The run as the board reads it: which duel of the sequence this is, how many
-- the player have already taken, whether this one and the next are boss
-- battles, the gold and hearts the run carried in, where the victory milestone
-- stands, and the verdict on the live duel. Screens treat this snapshot as
-- presentation data and do not mutate it.
--
-- `outcome` is the rules module's answer about a duel this module has not
-- settled yet, so it arrives rather than being re-derived here; a live duel
-- passes "none".
export type View = {
    duel: i32,
    cleared: i32,
    boss: bool,
    next_is_boss: bool,
    carried_gold: i32,
    hearts: i32,
    max_hearts: i32,
    run_length: i32,
    outcome: Outcome
}

function State:view(outcome: Outcome): View
    return {
        duel = self.duel,
        cleared = self.cleared,
        boss = self:boss(),
        next_is_boss = self:next_is_boss(),
        carried_gold = self.gold,
        hearts = self.hearts,
        max_hearts = MAX_HEARTS,
        run_length = run_length(self.rush),
        outcome = outcome
    }
end

-- The live duel has been fought to a verdict. Taking it advances the run and
-- carries its remaining gold into the next one; losing the run to exhausted
-- hearts or a non-winning boss finale starts a fresh one. A duel the run
-- already spent gold in is never fought twice.
--
-- The verdict is the rules module's answer, passed in rather than re-derived:
-- what a finished duel decided is not this module's to decide again.
function State:settle(finished: bool, cleared: bool, carried_gold: i32): Outcome
    local outcome: Outcome = outcome_of(self.duel, self.rush, self.hearts, finished, cleared)
    if outcome == "none" then
        return outcome
    end
    if outcome_is_loss(outcome) then
        self:restart(self.start_spell, self.rush)
        return outcome
    end
    -- Taking the victory milestone and taking any other duel are the same
    -- movement; what differs is only the screen that says so.
    --
    -- Whether a boss was standing here is read before the duel number moves: a
    -- boss the run has now fought is a boss it needs a fresh roll to replace.
    local fought_boss: bool = self:boss()
    self.gold = carried_gold
    self.cleared += 1
    self.duel += 1
    if fought_boss then
        self:roll_next_boss()
    end
    return outcome
end

function State:restart(spell: spells.SpellKind, rush: bool): unit
    local fresh: State = State.new(spell, rush)
    self.duel = fresh.duel
    self.gold = fresh.gold
    self.hearts = fresh.hearts
    self.cleared = fresh.cleared
    self.spells = fresh.spells
    self.start_spell = spell
    self.rush = rush
    -- A fresh run has fought nobody, so it takes the new run's pool and its
    -- opening roll rather than remembering the roster the dead run had worked
    -- through.
    self.boss_pool = fresh.boss_pool
    self.next_boss = fresh.next_boss
end

-- Charge exactly one heart for a hand the Opponent took. A terminal reveal
-- may call this before the run is settled, so zero is an observable state,
-- while repeated calls cannot take health negative.
function State:lose_hand(): bool
    if self.hearts > 0 then
        self.hearts -= 1
    end
    return self.hearts == 0
end

-- Whether there is damage a potion could undo. A run at full health has
-- nothing to restore, and a run at zero is already over — settle restarts it
-- rather than letting anything buy it back — so neither is a sale the shop
-- should make.
function State:can_heal(): bool
    return self.hearts > 0 and self.hearts < MAX_HEARTS
end

-- Give back hearts a duel took, never past the pool the run opened with. This
-- is the one thing that moves health upward: nothing inside a duel repairs it
-- and clearing one does not either, so health only ever climbs by something
-- bought in the intermission.
function State:heal(hearts: i32): bool
    if hearts < 1 or not self:can_heal() then
        return false
    end
    self.hearts += hearts
    if self.hearts > MAX_HEARTS then
        self.hearts = MAX_HEARTS
    end
    return true
end

-- Whether the loadout already holds that kind of spell, and therefore whether
-- an intermission has anything new to offer in it.
function State:carries(kind: spells.SpellKind): bool
    for spell in self.spells do
        if spell.kind == kind then
            return true
        end
    end
    return false
end

function State:spell_count(): i32
    return #self.spells
end

-- Which key that kind of spell answers to, or -1 when the loadout does not
-- carry it. An offer made about a spell names the spell rather than the key, so
-- that a trade moving spells between keys cannot silently redirect it.
function State:slot_of(kind: spells.SpellKind): i32
    for slot, spell in self.spells do
        if spell.kind == kind then
            return slot - 1
        end
    end
    return -1
end

-- Spend from the carried pool. Buying between duels comes out of the same gold
-- the next duel opens with, so a purchase is always a smaller pool to fight in.
function State:spend(gold: i32): bool
    if gold < 0 or gold > self.gold then
        return false
    end
    self.gold -= gold
    return true
end

function State:can_learn_spell(spell: spells.Spell): bool
    if spell.level < 1 then
        return false
    end
    local slot = self:slot_of(spell.kind)
    if slot ~= -1 then
        return self.spells[slot + 1].level < spell.level
    end
    return #self.spells < MAX_SPELLS
end

function State:learn_spell(spell: spells.Spell): bool
    if not self:can_learn_spell(spell) then
        return false
    end
    local slot = self:slot_of(spell.kind)
    if slot ~= -1 then
        self.spells[slot + 1].level = spell.level
        return true
    end
    table.insert(self.spells, spell)
    return true
end

function State:current_spell_level(kind: spells.SpellKind): i32
    for spell in self.spells do
        if spell.kind == kind then
            return spell.level
        end
    end
    return 0
end

-- Development snapshots ride the built-in JSON codec. The wrapper record
-- carries the schema marker; unpacking already validates the shape, so what
-- restore checks is only the semantics a well-shaped payload can still get
-- wrong.
type Snapshot = { schema: string, state: State }

function State:snapshot(): string
    local payload: Snapshot = { schema = SNAPSHOT_SCHEMA, state = self }
    return json.pack(payload)
end

function State.restore(snapshot_value: string): State?
    local decoded = json.unpack<Snapshot>(snapshot_value)
    if decoded == nil then
        return nil
    end
    if decoded.schema ~= SNAPSHOT_SCHEMA then
        return nil
    end
    local restored: State = decoded.state
    -- No upper bound on the duel: a run past its victory milestone is a run
    -- that won and kept walking, not a payload from another build.
    if restored.duel < 1 then
        return nil
    end
    -- Zero is the terminal reveal before settle restarts the run; no run can
    -- have more health than it opened with or take damage below zero.
    if restored.hearts < 0 or restored.hearts > MAX_HEARTS then
        return nil
    end
    -- A run always carries at least the spell it set out with, and never more
    -- than the two the player can hold ready.
    if #restored.spells < 1 or #restored.spells > MAX_SPELLS then
        return nil
    end
    for index, spell in restored.spells do
        if not spells.SpellKind.valid(spell.kind) then
            return nil
        end
        if spell.level < 1 then
            return nil
        end
        for previous = 1::i32, index - 1 do
            if restored.spells[previous].kind == spell.kind then
                return nil
            end
        end
    end
    if not spells.SpellKind.valid(restored.start_spell) then
        return nil
    end
    -- The pool is a subset of the roster, so it holds known bosses, each at
    -- most once, and never more of them than the roster has.
    if #restored.boss_pool > bosses.count() then
        return nil
    end
    for index, kind in restored.boss_pool do
        if not bosses.Kind.valid(kind) then
            return nil
        end
        for previous = 1::i32, index - 1 do
            if restored.boss_pool[previous] == kind then
                return nil
            end
        end
    end
    if not bosses.Kind.valid(restored.next_boss) then
        return nil
    end
    -- The coming boss was taken out of the pool when it was rolled, so a
    -- payload holding it in both places is one this build could deal twice.
    for kind in restored.boss_pool do
        if kind == restored.next_boss then
            return nil
        end
    end
    return restored
end

return {
    boss_at = boss_at,
    refilled_pool = refilled_pool,
    run_length = run_length,
    outcome_of = outcome_of,
    outcome_is_loss = outcome_is_loss,
    outcome_walks_on = outcome_walks_on,
    boss_every = BOSS_EVERY,
    max_spells = MAX_SPELLS,
    max_hearts = MAX_HEARTS
}
