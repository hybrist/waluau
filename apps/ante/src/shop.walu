-- DOM-free intermission between two vaults of a run: the fence the robbers
-- visit with whatever mana the last vault left standing. It lays out two
-- offers, rolled when the visit opens — sharpening a spell they already carry,
-- or a spell they do not — and both are paid for out of the pool the next vault
-- opens with, so every purchase is a smaller pot to fight in.
--
-- The two offers are the whole stock of a visit. Buying one marks that offer
-- sold and nothing takes its place: what restocks the fence is reaching the next
-- one, not spending mana at this one.
--
-- This module owns what is on offer, what it costs, and which line of the offer
-- the cursor is on. The loadout limits and the purse belong to the run module,
-- which applies every purchase; where the lines are drawn on the screen belongs
-- to shop_render, so a click arrives here as a row number.

local game = require("./game")
local run_module = require("./run")
local snapshot_data = require("./snapshot")

-- One thing this visit has for sale. `kind` names the spell it is about — the
-- one being sharpened, or the one being taught — rather than a loadout slot,
-- because a trade can move a spell off the key it was rolled against and an
-- offer must not follow it. `sold` is what stops a bought offer from being
-- bought twice; the line stays on the screen, spent.
type Offer = { action: i32, kind: i32, sold: bool }
-- `pending` is the offer being asked about while a full loadout decides which
-- spell a new one trades away — the one stage where mana has not changed hands
-- yet. It is -1 the rest of the time.
type State = { open: bool, offers: {Offer}, cursor: i32, pending: i32 }
-- One line of the shop: what it would do, which loadout slot it does it to,
-- the spell ink it wears, its price, whether it has already been bought, and
-- whether the purse and the loadout allow it at all. Input and drawing read the
-- same list, so a greyed-out line and a refused press can never disagree.
type Row = { action: i32, slot: i32, kind: i32, price: i32, sold: bool, available: bool }

const ACTION_SHARPEN: i32 = 1
const ACTION_LEARN: i32 = 2
const ACTION_REPLACE: i32 = 3
const ACTION_CANCEL: i32 = 4
const ACTION_LEAVE: i32 = 5

const RESULT_STAY: i32 = 0
const RESULT_LEAVE: i32 = 1

-- Two lines of stock per visit, however many things the run could in principle
-- be sold.
const MAX_OFFERS: i32 = 2
-- Sharpening gets dearer as the spell gets cheaper: the first mana off a cast
-- is four, the next six, the last eight. A spell learned here always costs the
-- same, because what it is worth is decided by which one the roll offered.
const SHARPEN_PRICE: i32 = 4
const SHARPEN_PRICE_STEP: i32 = 2
const LEARN_PRICE: i32 = 7

const NOTHING_PENDING: i32 = -1
const SNAPSHOT_SCHEMA: string = "ante-shop-v2"
const SNAPSHOT_COLLECTION_LIMIT: i32 = 8

function new(): State
    return { open = false, offers = {}, cursor = 0, pending = NOTHING_PENDING }
end

-- Everything the fence could sell this run, in a stable order: one line per
-- spell it could sharpen, then one per spell it could teach. The roll draws
-- from this.
function stock(run: run_module.State): {Offer}
    local pool: {Offer} = {}
    for slot = 0::i32, #run.spells - 1 do
        if run:can_sharpen(slot) then
            table.insert(pool, {
                action = ACTION_SHARPEN, kind = run.spells[slot].kind, sold = false,
            })
        end
    end
    for kind = 1::i32, game.spell_kind_count do
        if not run:carries(kind) then
            table.insert(pool, { action = ACTION_LEARN, kind = kind, sold = false })
        end
    end
    return pool
end

-- Two of that stock, drawn without replacement, so a visit never lists the same
-- offer twice. A run with less than two things left to buy is simply offered
-- what there is.
function roll_offers(run: run_module.State): {Offer}
    local pool: {Offer} = stock(run)
    local offers: {Offer} = {}
    while #offers < MAX_OFFERS and #pool > 0 do
        local index: i32 = math.random(#pool) - 1
        table.insert(offers, pool[index])
        table.remove(pool, index)
    end
    return offers
end

function open_for(state: State, run: run_module.State): unit
    state.open = true
    state.offers = roll_offers(run)
    state.cursor = 0
    state.pending = NOTHING_PENDING
end

function close(state: State): unit
    state.open = false
    state.offers = {}
    state.cursor = 0
    state.pending = NOTHING_PENDING
end

function choosing(state: State): bool
    return state.pending ~= NOTHING_PENDING
end

-- What sharpening the spell in that slot costs next. Slots the run cannot
-- sharpen any further still answer a price; `rows` is what marks them closed.
function sharpen_price(run: run_module.State, slot: i32): i32
    if slot < 0 or slot >= #run.spells then return SHARPEN_PRICE end
    local taken: i32 = game.spell_cost - run.spells[slot].cost
    return SHARPEN_PRICE + taken * SHARPEN_PRICE_STEP
end

function learn_price(): i32
    return LEARN_PRICE
end

-- One offer as a line: the slot it acts on resolved from the spell it names, its
-- price at the loadout's current state, and whether it can be bought right now.
-- A sold line is never available, and neither is one whose spell has been traded
-- away since the roll.
function offer_row(offer: Offer, run: run_module.State): Row
    if offer.action == ACTION_SHARPEN then
        local slot: i32 = run:slot_of(offer.kind)
        local price: i32 = sharpen_price(run, slot)
        return {
            action = ACTION_SHARPEN,
            slot = slot,
            kind = offer.kind,
            price = price,
            sold = offer.sold,
            available = not offer.sold and run:can_sharpen(slot) and run.mana >= price,
        }
    end
    return {
        action = ACTION_LEARN,
        slot = run:open_slot(),
        kind = offer.kind,
        price = LEARN_PRICE,
        sold = offer.sold,
        available = not offer.sold
            and not run:carries(offer.kind)
            and run.mana >= LEARN_PRICE,
    }
end

-- The lines of the shop as it stands. While a full loadout is being asked which
-- spell to trade away, those are the only lines there are: the sale is already
-- in progress and the other offers would be answering a different question.
function rows(state: State, run: run_module.State): {Row}
    local list: {Row} = {}
    if choosing(state) then
        local offered: i32 = state.offers[state.pending].kind
        for slot = 0::i32, #run.spells - 1 do
            table.insert(list, {
                action = ACTION_REPLACE,
                slot = slot,
                kind = run.spells[slot].kind,
                price = LEARN_PRICE,
                sold = false,
                available = run.mana >= LEARN_PRICE and not run:carries(offered),
            })
        end
        table.insert(list, {
            action = ACTION_CANCEL,
            slot = -1,
            kind = 0,
            price = 0,
            sold = false,
            available = true,
        })
        return list
    end
    for offer in state.offers do table.insert(list, offer_row(offer, run)) end
    table.insert(list, {
        action = ACTION_LEAVE,
        slot = -1,
        kind = 0,
        price = 0,
        sold = false,
        available = true,
    })
    return list
end

function row_count(state: State, run: run_module.State): i32
    return #rows(state, run)
end

function move(state: State, run: run_module.State, delta: i32): unit
    local count: i32 = row_count(state, run)
    state.cursor = (state.cursor + delta + count) % count
end

-- Point the cursor at the row the pointer is over. Dead space between lines
-- leaves the cursor where it was, the way hovering the board does.
function focus(state: State, run: run_module.State, row: i32): unit
    if row < 0 or row >= row_count(state, run) then return end
    state.cursor = row
end

-- Take the offer being asked about into the named slot. The mana leaves the
-- purse only once the loadout accepts the spell, and the offer is marked sold
-- rather than removed: the line stays where it was, spent.
function commit_learn(state: State, run: run_module.State, offer: i32, slot: i32): unit
    if run.mana < LEARN_PRICE then return end
    if not run:learn(state.offers[offer].kind, slot) then return end
    run:spend(LEARN_PRICE)
    state.offers[offer].sold = true
    state.pending = NOTHING_PENDING
    state.cursor = offer
end

-- Buy, or start being asked which spell to trade away, or leave. A line the
-- purse cannot cover — or one already bought — is simply not bought: the cursor
-- stays on it rather than the press falling through to something else.
function activate(state: State, run: run_module.State): i32
    local list: {Row} = rows(state, run)
    if state.cursor < 0 or state.cursor >= #list then return RESULT_STAY end
    local row: Row = list[state.cursor]
    if row.action == ACTION_LEAVE then return RESULT_LEAVE end
    if row.action == ACTION_CANCEL then
        local asked: i32 = state.pending
        state.pending = NOTHING_PENDING
        state.cursor = asked
        return RESULT_STAY
    end
    if not row.available then return RESULT_STAY end
    if row.action == ACTION_REPLACE then
        commit_learn(state, run, state.pending, row.slot)
        return RESULT_STAY
    end
    if row.action == ACTION_SHARPEN then
        if run:can_sharpen(row.slot) and run:spend(row.price) then
            run:sharpen(row.slot)
            state.offers[state.cursor].sold = true
        end
        return RESULT_STAY
    end
    -- Learning: a loadout with room gives the spell the next key by itself, and
    -- a full one has to be asked which of the two it replaces.
    if row.slot >= 0 then
        commit_learn(state, run, state.cursor, row.slot)
    else
        state.pending = state.cursor
        state.cursor = 0
    end
    return RESULT_STAY
end

function keypressed(state: State, run: run_module.State, key: string): i32
    if key == "ArrowUp" or key == "w" or key == "W" then
        move(state, run, -1)
        return RESULT_STAY
    end
    if key == "ArrowDown" or key == "s" or key == "S" then
        move(state, run, 1)
        return RESULT_STAY
    end
    if key == "Enter" or key == " " then return activate(state, run) end
    -- Escape backs out of the replacement question, and otherwise out of the
    -- shop: the next vault is always one press away.
    if key == "Escape" then
        if choosing(state) then
            local asked: i32 = state.pending
            state.pending = NOTHING_PENDING
            state.cursor = asked
            return RESULT_STAY
        end
        return RESULT_LEAVE
    end
    return RESULT_STAY
end

function snapshot(state: State): string
    local parts: {string} = { SNAPSHOT_SCHEMA }
    snapshot_data.append_bool(parts, state.open)
    snapshot_data.append_i32(parts, #state.offers)
    for offer in state.offers do
        snapshot_data.append_i32(parts, offer.action)
        snapshot_data.append_i32(parts, offer.kind)
        snapshot_data.append_bool(parts, offer.sold)
    end
    snapshot_data.append_i32(parts, state.cursor)
    snapshot_data.append_i32(parts, state.pending)
    return table.concat(parts, ",")
end

function restore(snapshot_value: string): State?
    local reader: snapshot_data.Reader = snapshot_data.reader(
        snapshot_value, SNAPSHOT_COLLECTION_LIMIT)
    if reader:next_string() ~= SNAPSHOT_SCHEMA then return nil end
    local open: bool = reader:next_bool()
    local offers: {Offer} = {}
    local offer_count: i32 = reader:next_length()
    for _ = 1, offer_count do
        -- One token at a time into locals: a record literal's fields are not
        -- guaranteed to be evaluated in written order, and these are only told
        -- apart by their position in the payload.
        local action: i32 = reader:next_i32()
        local kind: i32 = reader:next_i32()
        local sold: bool = reader:next_bool()
        table.insert(offers, { action = action, kind = kind, sold = sold })
    end
    local cursor: i32 = reader:next_i32()
    local pending: i32 = reader:next_i32()
    local restored: State = {
        open = open,
        offers = offers,
        cursor = cursor,
        pending = pending,
    }
    if not reader:complete() then return nil end
    if #offers > MAX_OFFERS then return nil end
    for offer in offers do
        if offer.action ~= ACTION_SHARPEN and offer.action ~= ACTION_LEARN then
            return nil
        end
        if offer.kind < 1 or offer.kind > game.spell_kind_count then return nil end
    end
    if cursor < 0 then return nil end
    -- A pending question names one of this visit's offers, or nothing at all.
    if pending < NOTHING_PENDING or pending >= #offers then return nil end
    return restored
end

return {
    new = new,
    open_for = open_for,
    close = close,
    choosing = choosing,
    stock = stock,
    roll_offers = roll_offers,
    rows = rows,
    row_count = row_count,
    move = move,
    focus = focus,
    activate = activate,
    keypressed = keypressed,
    sharpen_price = sharpen_price,
    learn_price = learn_price,
    snapshot = snapshot,
    restore = restore,
    action_sharpen = ACTION_SHARPEN,
    action_learn = ACTION_LEARN,
    action_replace = ACTION_REPLACE,
    action_cancel = ACTION_CANCEL,
    action_leave = ACTION_LEAVE,
    result_stay = RESULT_STAY,
    result_leave = RESULT_LEAVE,
    max_offers = MAX_OFFERS,
}
