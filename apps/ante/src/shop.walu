-- DOM-free intermission between two duels of a run: the shop the player
-- visits with whatever gold the last duel left standing.
--
-- A visit is a row of slots. Each slot draws from one category of goods and
-- holds at most one offer, rolled and priced when the visit opens. Purchases are
-- paid for out of the pool the next duel opens with, so every one of them is a
-- smaller pot to fight in. Buying marks that offer sold and nothing takes its
-- place: what restocks the shop is reaching the next shop, not spending gold at
-- this one.
--
-- What is for sale is a `Goods` value, and each kind of goods carries the
-- metadata that kind has rather than a shared row of fields most of them would
-- leave empty. Its mutation is a separate `Item`: this module selects and
-- commits an offer, while shop_item owns what using it does to the run.
--
-- This module owns what is on offer, what it costs, and which line the cursor is
-- on. The loadout limits and the purse belong to the run module, which applies
-- every purchase; where the lines are drawn on the screen belongs to
-- shop_render, so a click arrives here as a row number.

local game = require("./game")
local run_module = require("./run")
local shop_item = require("./shop_item")
local spells = require("./spells/spell")

-- What a slot has for sale. Both of these name the spell they are about rather
-- than a cast key, because a trade can move a spell off the key it was rolled
-- against and an offer must not follow it.
export type Goods =
    Upgrade({ kind: spells.SpellKind })
  | Spell({ kind: spells.SpellKind })

-- What a slot draws from. A category can offer more than one kind of goods: the
-- spell slots sell both sharpening a spell already carried and teaching a new
-- one, because both are about the same two cast keys.
type Category = "spells"

-- One filled position of the visit: what it draws from, what it is selling, and
-- what that costs. `price` is stamped when the visit rolls the slot, so a line
-- quotes the same number all the way to being pressed. `sold` is what stops a
-- bought offer from being bought twice; the line stays on the screen, spent.
--
-- A category with less stock than it has slots simply fills fewer of them, so an
-- unfilled slot is a slot that is not here rather than one holding nothing.
export type Slot = {
    category: Category,
    goods: Goods,
    item: shop_item.Item,
    price: i32,
    sold: bool
}

-- The question a purchase asks when what it would give the run has nowhere to
-- go: which of `choices` gets displaced. `slot` is the shop slot being bought,
-- and the choices are loadout keys. This is the one stage where gold has not
-- changed hands yet; the rest of the time it is nil.
type Pending = { slot: i32, choices: {i32} }

export type State = { open: bool, slots: {Slot}, cursor: i32, pending: Pending? }

type ShopResult = "stay" | "leave"

-- What one line of the shop would do. Controls are not things for sale, so they
-- are not `Goods`: the two used to share one union, which is what made every new
-- kind of goods a change to navigation as well.
type RowKind = "sale" | "choice" | "leave" | "cancel"

-- One line of the shop: what it would do, which slot or loadout key it does it
-- to, the spell it wears the ink of, what it costs, whether it has already been
-- bought, and whether the purse and the loadout allow it at all. What a sale
-- line is selling stays on the slot; a row names the slot rather than carrying a
-- copy of its goods, so the two cannot drift apart. Input and drawing read the
-- same list, so a greyed-out line and a refused press can never disagree.
export type Row = {
    kind: RowKind,
    slot: i32,
    key: i32,
    spell: spells.SpellKind?,
    price: i32,
    sold: bool,
    available: bool
}

-- Sharpening gets dearer as the spell gets cheaper: the first gold off a cast is
-- four, the next six, the last eight. A spell learned here always costs the
-- same, because what it is worth is decided by which one the roll offered.
const UPGRADE_PRICE: i32 = 4
const UPGRADE_PRICE_STEP: i32 = 2
const LEARN_PRICE: i32 = 7

const SNAPSHOT_SCHEMA: string = "duel-shop-v4"

-- The shape of a visit, written out here so the layout sits next to the
-- categories it names. Two lines of stock, however many things the run could in
-- principle be sold.
function slot_layout(): {Category}
    return { "spells", "spells" }
end

function State.new(): State
    return { open = false, slots = {}, cursor = 0, pending = nil }
end

-- Everything the spell slots could sell this run, in a stable order: one entry
-- per spell the run could upgrade, then one per spell it could be taught. The
-- roll draws from this.
function spell_stock(run: run_module.State): {Goods}
    local pool: {Goods} = {}
    for slot = 0::i32, #run.spells - 1 do
        if run:can_sharpen(slot) then
            table.insert(pool, Upgrade({ kind = run.spells[slot].kind }))
        end
    end
    for _, kind in pairs(spells.SpellKind) do
        if not run:carries(kind) then
            table.insert(pool, Spell({ kind = kind }))
        end
    end
    return pool
end

-- What that category could sell this run. One pool is drawn down across every
-- slot sharing the category, which is what stops two spell slots offering the
-- same spell twice.
function category_stock(category: Category, run: run_module.State): {Goods}
    return spell_stock(run)
end

-- What that goods costs the run as things stand. Priced once, when the visit
-- rolls it: a spell can only be sharpened once at a given shop, so the step it
-- is on cannot move between the roll and the press.
function Goods:price_of(run: run_module.State): i32
    if Upgrade(upgrade) = self then
        local slot: i32 = run:slot_of(upgrade.kind)
        if slot < 0 or slot >= #run.spells then return UPGRADE_PRICE end
        local taken: i32 = game.spell_cost - run.spells[slot].cost
        return UPGRADE_PRICE + taken * UPGRADE_PRICE_STEP
    end
    return LEARN_PRICE
end

-- Whether the run could take that goods on at all, leaving gold out of it: the
-- purse is checked once, where the row is built. A spell traded away since the
-- roll is what closes an upgrade offer that named it.
function Goods:goods_available(run: run_module.State): bool
    if Upgrade(upgrade) = self then
        return run:can_sharpen(run:slot_of(upgrade.kind))
    end
    if Spell(spell) = self then
        return not run:carries(spell.kind)
    end
    return false
end

-- Where the goods would go if it were bought now: the loadout key a new spell
-- takes by itself, and -1 once the loadout is full and something has to go.
function Goods:destination(run: run_module.State): i32
    if self is Spell then return run:open_slot() end
    return 0
end

-- What a full run could trade away to make room for that goods. Empty for goods
-- that always have somewhere to be.
function Goods:choices_for(run: run_module.State): {i32}
    local keys: {i32} = {}
    if self is Spell then
        for slot = 0::i32, #run.spells - 1 do table.insert(keys, slot) end
    end
    return keys
end

-- Pair selection metadata with the independently implemented effect it buys.
-- Restoring a visit uses the same mapping, so executable behavior is rebuilt
-- rather than written into the snapshot.
function Goods:item_for(): shop_item.Item
    if Upgrade(upgrade) = self then
        return shop_item.Item.sharpen(upgrade.kind)
    end
    if Spell(spell) = self then
        return shop_item.Item.learn(spell.kind)
    end
    assert(false)
    return shop_item.Item.new(function(state: shop_item.UseState): unit end)
end

-- Commit payment, then hand the mutation to the item. `key` is the loadout key
-- a new spell takes, which is the open one unless a full loadout has named what
-- it trades away; items that do not need a destination ignore it. Availability
-- is checked before any mutation, so a refused purchase costs nothing.
function Goods:buy(item: shop_item.Item,
    run: run_module.State,
    key: i32,
    price: i32
): bool
    if not self:goods_available(run) then return false end
    if not run:spend(price) then return false end
    item:use({ run = run, key = key })
    return true
end

function Goods:spell_kind(): spells.SpellKind?
    if Upgrade(upgrade) = self then return upgrade.kind end
    if Spell(spell) = self then return spell.kind end
    return nil
end

-- Fill the visit from each category's stock, drawing without replacement so a
-- visit never lists the same goods twice. A category with less stock than it has
-- slots fills fewer of them, and the visit is simply shorter.
function roll_slots(run: run_module.State): {Slot}
    local slots: {Slot} = {}
    local spells: {Goods} = category_stock("spells", run)
    for category in slot_layout() do
        if #spells > 0 then
            local index: i32 = math.random(#spells) - 1
            local goods: Goods = spells[index]
            table.remove(spells, index)
            table.insert(slots, {
                category = category,
                goods = goods,
                item = goods:item_for(),
                price = goods:price_of(run),
                sold = false,
            })
        end
    end
    return slots
end

function State:open_for(run: run_module.State): unit
    self.open = true
    self.slots = roll_slots(run)
    self.cursor = 0
    self.pending = nil
end

function State:close(): unit
    self.open = false
    self.slots = {}
    self.cursor = 0
    self.pending = nil
end

function State:choosing(): bool
    return self.pending ~= nil
end

-- The shop slot a pending question is about, or -1 when nothing is being asked.
function State:pending_slot(): i32
    local pending: Pending? = self.pending
    if pending ~= nil then return pending.slot end
    return -1
end

-- The spell a pending question would hand over, or 0 when nothing is being
-- asked. A screen naming the trade reads this.
function State:pending_spell(): spells.SpellKind?
    local slot: i32 = self:pending_slot()
    if slot < 0 or slot >= #self.slots then return nil end
    return self.slots[slot].goods:spell_kind()
end

-- One slot as a line. A sold line is never available, and neither is one the run
-- can no longer take on or cannot pay for.
function slot_row(index: i32, slot: Slot, run: run_module.State): Row
    return {
        kind = "sale",
        slot = index,
        key = -1,
        spell = slot.goods:spell_kind(),
        price = slot.price,
        sold = slot.sold,
        available = not slot.sold
            and slot.goods:goods_available(run)
            and run.gold >= slot.price,
    }
end

-- The lines a pending question puts up: one per key it could displace, and a way
-- to back out. They all quote the price of the sale that asked, because naming a
-- key is how that sale is paid for.
function choice_rows(asking: Pending, state: State, run: run_module.State): {Row}
    local list: {Row} = {}
    local slot: Slot = state.slots[asking.slot]
    local live: bool = slot.goods:goods_available(run)
    for key in asking.choices do
        table.insert(list, {
            kind = "choice",
            slot = asking.slot,
            key = key,
            spell = run.spells[key].kind,
            price = slot.price,
            sold = false,
            available = live and run.gold >= slot.price,
        })
    end
    table.insert(list, {
        kind = "cancel",
        slot = -1,
        key = -1,
        spell = nil,
        price = 0,
        sold = false,
        available = true,
    })
    return list
end

-- The lines of the shop as it stands. While a purchase is asking what it
-- displaces, those are the only lines there are: the sale is already in progress
-- and the other slots would be answering a different question.
function State:rows(run: run_module.State): {Row}
    local list: {Row} = {}
    local pending: Pending? = self.pending
    if pending ~= nil then return choice_rows(pending, self, run) end
    for index, slot in self.slots do
        table.insert(list, slot_row(index, slot, run))
    end
    table.insert(list, {
        kind = "leave",
        slot = -1,
        key = -1,
        spell = nil,
        price = 0,
        sold = false,
        available = true,
    })
    return list
end

function State:row_count(run: run_module.State): i32
    return #self:rows(run)
end

function State:move(run: run_module.State, delta: i32): unit
    local count: i32 = self:row_count(run)
    self.cursor = (self.cursor + delta + count) % count
end

-- Point the cursor at the row the pointer is over. Dead space between lines
-- leaves the cursor where it was, the way hovering the board does.
function State:focus(run: run_module.State, row: i32): unit
    if row < 0 or row >= self:row_count(run) then return end
    self.cursor = row
end

-- Buy what the named slot is selling into `key`. The slot is marked sold rather
-- than removed, and the cursor comes back to its line: that is also how a
-- purchase which had to ask a question returns to where it started. Slots keep
-- their order and every one of them takes a line, so a slot number is a row
-- number here.
function State:commit(run: run_module.State, slot: i32, key: i32): unit
    if slot < 0 or slot >= #self.slots then return end
    local sale: Slot = self.slots[slot]
    if sale.sold then return end
    if not sale.goods:buy(sale.item, run, key, sale.price) then return end
    sale.sold = true
    self.pending = nil
    self.cursor = slot
end

-- Back out of the question without buying. The offer is still for sale and the
-- cursor is back on it.
function State:cancel(): unit
    local asked: i32 = self:pending_slot()
    if asked < 0 then return end
    self.pending = nil
    self.cursor = asked
end

-- Buy, or start being asked what a purchase displaces, or leave. A line the
-- purse cannot cover — or one already bought — is simply not bought: the cursor
-- stays on it rather than the press falling through to something else.
function State:activate(run: run_module.State): ShopResult
    local list: {Row} = self:rows(run)
    if self.cursor < 0 or self.cursor >= #list then return "stay" end
    local row: Row = list[self.cursor]
    if row.kind == "leave" then return "leave" end
    if row.kind == "cancel" then
        self:cancel()
        return "stay"
    end
    if not row.available then return "stay" end
    if row.kind == "choice" then
        self:commit(run, row.slot, row.key)
        return "stay"
    end
    -- A loadout with room takes the goods by itself; a full one has to be asked
    -- which of what it holds makes way.
    local goods: Goods = self.slots[row.slot].goods
    local key: i32 = goods:destination(run)
    if key < 0 then
        self.pending = { slot = row.slot, choices = goods:choices_for(run) }
        self.cursor = 0
        return "stay"
    end
    self:commit(run, row.slot, key)
    return "stay"
end

function State:keypressed(run: run_module.State, key: string): ShopResult
    if key == "ArrowUp" or key == "w" or key == "W" then
        self:move(run, -1)
        return "stay"
    end
    if key == "ArrowDown" or key == "s" or key == "S" then
        self:move(run, 1)
        return "stay"
    end
    if key == "Enter" or key == " " then return self:activate(run) end
    -- Escape backs out of a pending question, and otherwise out of the shop: the
    -- next duel is always one press away.
    if key == "Escape" then
        if self:choosing() then
            self:cancel()
            return "stay"
        end
        return "leave"
    end
    return "stay"
end

-- What a snapshot writes of one slot. The live Slot also carries its Item,
-- which is behavior rather than data: restore rebuilds it from the goods.
type SnapshotSlot = { category: Category, goods: Goods, price: i32, sold: bool }

-- Development snapshots ride the built-in JSON codec. The wrapper record
-- carries the schema marker, and unpacking already validates the shape, the
-- goods tags included; the category, a literal union that decodes as a plain
-- string, is checked by restore itself.
type Snapshot = {
    schema: string,
    open: bool,
    slots: {SnapshotSlot},
    cursor: i32,
    pending: Pending?
}

function State:snapshot(): string
    local slots: {SnapshotSlot} = {}
    for slot in self.slots do
        table.insert(slots, {
            category = slot.category,
            goods = slot.goods,
            price = slot.price,
            sold = slot.sold,
        })
    end
    local payload: Snapshot = {
        schema = SNAPSHOT_SCHEMA,
        open = self.open,
        slots = slots,
        cursor = self.cursor,
        pending = self.pending,
    }
    return json.pack(payload)
end

function State.restore(snapshot_value: string): State?
    local decoded = json.unpack<Snapshot>(snapshot_value)
    if decoded == nil then return nil end
    if decoded.schema ~= SNAPSHOT_SCHEMA then return nil end
    local decoded_slots: {SnapshotSlot} = decoded.slots
    if #decoded_slots > #slot_layout() then return nil end
    if decoded.cursor < 0 then return nil end
    local slots: {Slot} = {}
    for slot in decoded_slots do
        -- `Category` currently has a single member, which the compiler widens
        -- to a plain string in the decoded shape, so membership is checked
        -- here rather than by the decoder.
        local category_known: bool = false
        for known in slot_layout() do
            if known == slot.category then category_known = true end
        end
        if not category_known then return nil end
        -- A spell kind is bounded by the spells that exist, which is not a
        -- bound the JSON shape carries; a quoted price is never negative.
        local kind: spells.SpellKind? = slot.goods:spell_kind()
        if kind == nil then return nil end
        if not spells.SpellKind.valid(kind::spells.SpellKind) then return nil end
        if slot.price < 0 then return nil end
        table.insert(slots, {
            category = slot.category,
            goods = slot.goods,
            item = slot.goods:item_for(),
            price = slot.price,
            sold = slot.sold,
        })
    end
    local pending: Pending? = decoded.pending
    if pending ~= nil then
        -- A pending question names one of this visit's slots, and the keys it
        -- offers to trade away are keys the loadout could hold.
        local question: Pending = pending::Pending
        if question.slot < 0 or question.slot >= #slots then return nil end
        for key in question.choices do
            if key < 0 or key >= run_module.max_spells then return nil end
        end
    end
    return {
        open = decoded.open,
        slots = slots,
        cursor = decoded.cursor,
        pending = pending,
    }
end

return {
    slot_layout = slot_layout,
    spell_stock = spell_stock,
    category_stock = category_stock,
    roll_slots = roll_slots,
    learn_price = LEARN_PRICE,
}
