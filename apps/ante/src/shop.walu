-- DOM-free shop state. A visit rolls behavior-bearing Items, quotes each once,
-- and knows only the common item operations. Spell-specific teaching and level
-- rules stay in the scroll and run modules.
local run_ = require("./run")
local item_ = require("./items/item")
local item_catalog = require("./items/catalog")
local scroll_ = require("./items/scroll")
local spell_ = require("./spells/spell")

type RunState = run_.State
type Item = item_.Item
type ItemSnapshot = item_.Snapshot

const DEFAULT_SHOP_ITEM_COUNT: i32 = 2
const SNAPSHOT_SCHEMA: string = "duel-shop-v5"

export type Slot = { item: Item, price: i32, sold: bool }
export type State = { open: bool, slots: {Slot}, cursor: i32 }

function all_scroll_items(run: RunState): {Item}
    local scrolls: {Item} = {}
    for _, kind in pairs(spell_.SpellKind) do
        local level: i32 = run:current_spell_level(kind) + 1
        table.insert(scrolls, scroll_.SpellScroll.new(kind, level)::Item)
    end
    return scrolls
end

function roll_slots(run: RunState): {Slot}
    local slots: {Slot} = {}
    local items: {Item} = all_scroll_items(run)
    for _ = 1, DEFAULT_SHOP_ITEM_COUNT do
        local index: i32 = math.random(#items) - 1
        local item: Item = table.remove(items, index + 1)
        table.insert(slots, { item = item, price = item:base_price(run), sold = false })
    end
    return slots
end

function State.new(run: RunState): State
    return { open = true, slots = roll_slots(run), cursor = 0 }
end

function State:open_for(run: RunState): unit
    self.open = true
    self.slots = roll_slots(run)
    self.cursor = 0
end

function State:close(): unit
    self.open = false
    self.slots = {}
    self.cursor = 0
end

function State:slot_available(run: RunState, index: i32): bool
    if index < 0 or index >= #self.slots then
        return false
    end
    local slot: Slot = self.slots[index]
    return not slot.sold and slot.price <= run.gold and slot.item:can_use(run)
end

-- Returns true when the cursor names the way out.
function State:confirm_choice(run: RunState): bool
    if self.cursor < 0 or self.cursor >= #self.slots then
        return true
    end
    if not self:slot_available(run, self.cursor) then
        return false
    end

    local slot: Slot = self.slots[self.cursor]
    if not run:spend(slot.price) then
        return false
    end
    slot.item:use(run)
    slot.sold = true
    return false
end

function State:move(delta: i32): unit
    local count: i32 = #self.slots + 1
    self.cursor = (self.cursor + delta + count) % count
end

-- Returns true when this input wraps up the shopping episode.
function State:keypressed(run: RunState, key: string): bool
    if key == "ArrowUp" or key == "w" or key == "W" then
        self:move(-1)
        return false
    end
    if key == "ArrowDown" or key == "s" or key == "S" then
        self:move(1)
        return false
    end
    if key == "Enter" or key == " " then
        return self:confirm_choice(run)
    end
    return key == "Escape"
end

type SnapshotSlot = { item: ItemSnapshot, price: i32, sold: bool }
type Snapshot = { schema: string, open: bool, slots: {SnapshotSlot}, cursor: i32 }

function State:snapshot(): string
    local slots: {SnapshotSlot} = {}
    for slot in self.slots do
        table.insert(slots, { item = slot.item:snapshot(), price = slot.price, sold = slot.sold })
    end
    local payload: Snapshot = {
        schema = SNAPSHOT_SCHEMA,
        open = self.open,
        slots = slots,
        cursor = self.cursor
    }
    return json.pack(payload)
end

function State.restore(snapshot_value: string): State?
    local decoded: Snapshot? = json.unpack<Snapshot>(snapshot_value)
    if decoded == nil then
        return nil
    end
    local snapshot: Snapshot = decoded::Snapshot
    if snapshot.schema ~= SNAPSHOT_SCHEMA then
        return nil
    end
    if #snapshot.slots > DEFAULT_SHOP_ITEM_COUNT then
        return nil
    end
    if snapshot.cursor < 0 or snapshot.cursor > #snapshot.slots then
        return nil
    end
    if not snapshot.open and (#snapshot.slots > 0 or snapshot.cursor ~= 0) then
        return nil
    end

    local slots: {Slot} = {}
    for saved in snapshot.slots do
        if saved.price < 0 then
            return nil
        end
        local restored: Item? = item_catalog.restore(saved.item)
        if restored == nil then
            return nil
        end
        table.insert(slots, { item = restored::Item, price = saved.price, sold = saved.sold })
    end
    return { open = snapshot.open, slots = slots, cursor = snapshot.cursor }
end

return { DEFAULT_SHOP_ITEM_COUNT = DEFAULT_SHOP_ITEM_COUNT }
