-- The relic, in every state the board can put it in. A card is drawn from a
-- rank, a school, and four flags — sealed, bound, focused, watched — and the
-- combinations are what these stories pin down, one per state, without having
-- to deal a heist that happens to produce them.

local storybook = require("waluau:engine/storybook")
local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local game = require("./game")
local render = require("./render")
local card_warp = require("./card_warp")
local card_draw = require("./card_draw")
local presentation_resources = require("./presentation_resources")

const WIDTH = 420.0
const HEIGHT = 280.0
const SCHOOLS_WIDTH = 560.0
const BACKGROUND = "#0b0b12"

-- The card back, the display font, and the school shaders every story here
-- draws with. One set is loaded for the whole file: Storybook moves between
-- these stories constantly, and the assets do not change between them.
local assets = presentation_resources.new()
-- Loading is asynchronous and happens once, however many times a story is
-- mounted. The clock is a story's own and restarts with it.
local shared = { started = false, clock = 0.0 }

local function load_assets(): i32
    return presentation_resources.load_async(assets)
end

local function load(): unit
    shared.clock = 0.0
    if shared.started then return end
    shared.started = true
    local loader = coroutine.create(load_assets)
    coroutine.resume(loader)
end

local function tick(dt: f64, input: engine.Input): unit
    shared.clock += dt
end

-- Decoded images and fonts become GPU resources on the frame after they
-- arrive, so every story asks for that before it draws anything.
local function ready(graphics: engine.Graphics): unit
    presentation_resources.prepare(assets, graphics)
end

local function card(rank: i32, suit: i32): game.Card
    return { rank = rank, suit = suit }
end

local function centered_x(width: f64): f64
    return (width - render.card_width) * 0.5
end

local function centered_y(): f64
    return (HEIGHT - render.card_height) * 0.5
end

-- Every flag of the board's card renderer, named once so a story reads as the
-- state it is showing rather than as five booleans.
local function draw_state(
    graphics: engine.Graphics,
    subject: game.Card,
    selected: bool,
    focused: bool,
    hidden: bool,
    colored: bool,
    known: bool
): unit
    ready(graphics)
    render.draw_card(
        graphics,
        assets.effects,
        assets.texture,
        subject,
        centered_x(WIDTH),
        centered_y(),
        selected,
        focused,
        hidden,
        colored,
        known
    )
end

local function draw_face_up(graphics: engine.Graphics, alpha: f64): unit
    draw_state(
        graphics,
        card(storybook.arg_i32("rank"), storybook.arg_i32("suit")),
        false,
        false,
        false,
        false,
        false
    )
end

local function draw_face_down(graphics: engine.Graphics, alpha: f64): unit
    draw_state(graphics, card(13, 0), false, false, true, false, false)
end

-- Bound: the card is committed to the formation being built. It lifts, takes
-- its school's edge, and runs that school's pattern.
local function draw_bound(graphics: engine.Graphics, alpha: f64): unit
    draw_state(graphics, card(14, 1), true, false, false, false, false)
end

-- Focused is where the cursor is, which is amber and independent of binding.
local function draw_focused(graphics: engine.Graphics, alpha: f64): unit
    draw_state(graphics, card(7, 3), false, true, false, false, false)
end

-- A contributing card in a finished formation, in full school color.
local function draw_contributing(graphics: engine.Graphics, alpha: f64): unit
    draw_state(graphics, card(12, 2), false, false, false, true, false)
end

-- Watched: the Arch Mage has seen this relic. Sealed and watched at once is
-- the state the player reads through the back.
local function draw_watched(graphics: engine.Graphics, alpha: f64): unit
    draw_state(graphics, card(10, 2), false, false, true, false, true)
end

-- The four schools side by side, in the colored state that makes each one's
-- pattern legible. Nothing else on the board shows them together.
local function draw_schools(graphics: engine.Graphics, alpha: f64): unit
    ready(graphics)
    const GAP = 12.0
    local span = render.card_width * 4.0 + GAP * 3.0
    local x = (SCHOOLS_WIDTH - span) * 0.5
    for suit = 0::i32, 3::i32 do
        render.draw_card(
            graphics,
            assets.effects,
            assets.texture,
            card(11 + suit, suit),
            x + (suit::f64) * (render.card_width + GAP),
            centered_y(),
            false,
            false,
            false,
            true,
            false
        )
    end
end

-- The turn itself, looping: the same flip the board plays when a relic is
-- revealed, off a clock this story owns.
const FLIP_PERIOD = 1.7

local function draw_turning(graphics: engine.Graphics, alpha: f64): unit
    ready(graphics)
    local clock = shared.clock - math.floor(shared.clock / FLIP_PERIOD) * FLIP_PERIOD
    render.draw_flipping_card(
        graphics,
        assets.effects,
        assets.texture,
        card(14, 0),
        centered_x(WIDTH),
        centered_y(),
        clock,
        0.35,
        false
    )
end

-- The player's fan, which is where a relic is normally seen: tilted, lifted
-- when bound, and amber where the cursor sits.
const FAN_COUNT: i32 = 5

local function draw_fan(graphics: engine.Graphics, alpha: f64): unit
    ready(graphics)
    local hand = {
        card(14, 0), card(13, 1), card(9, 2), card(6, 3), card(3, 0)
    }
    for index = 0, FAN_COUNT - 1 do
        render.draw_hand_card(
            graphics,
            assets.effects,
            assets.texture,
            hand[index],
            index,
            1.0,
            FAN_COUNT,
            index == 1,
            index == 2,
            false,
            false
        )
    end
end

-- The draw: a sealed card thrown off the deck, up off the surface, turned
-- over past its own leading edge and dropped onto its spot. The card is a
-- sheet of geometry here rather than a rectangle, so what happens to it is a
-- corner leaving ahead of the rest of the card and the rest of the card
-- answering for it.
const DRAW_WIDTH = 760.0
const DRAW_HEIGHT = 480.0
-- Fine enough that a bend across the sheet is a curve and not a crease. Every
-- cell is two triangles, so this is 1152 vertices — one batch.
const DRAW_COLUMNS: i32 = 12
const DRAW_ROWS: i32 = 16
const DECK_X = 168.0
const DECK_Y = 322.0
const CAUGHT_X = 505.0
const CAUGHT_Y = 196.0
-- The card the deck gives up. It is sealed the whole way out of the stack and
-- has turned over by the time it is caught.
const DRAWN_RANK: i32 = 14
const DRAWN_SUIT: i32 = 1

-- The card as two surfaces and one grid, all three of which outlive every
-- frame. A card being deformed sixty times a second should not be sixty
-- render targets.
local sheet: {
    mesh: card_warp.Mesh,
    back: graphics_module.RenderTarget?,
    face: graphics_module.RenderTarget?,
    captured: bool
} = {
    mesh = card_warp.new_mesh(DRAW_COLUMNS, DRAW_ROWS),
    back = nil,
    face = nil,
    captured = false
}

local function drawn_card(): game.Card
    return card(DRAWN_RANK, DRAWN_SUIT)
end

-- Both faces of the card, captured once. Until the packaged card back has
-- arrived there is nothing worth capturing, so this simply waits.
local function capture(graphics: engine.Graphics): bool
    if sheet.captured then return true end
    local card_back = assets.texture
    if card_back == nil then return false end
    local back = render.capture_card(
        graphics, assets.effects, card_back, drawn_card(), false, false, true)
    local face = render.capture_card(
        graphics, assets.effects, card_back, drawn_card(), false, false, false)
    if back == nil or face == nil then return false end
    sheet.back = back
    sheet.face = face
    sheet.captured = true
    return true
end

local function draw_pose(
    graphics: engine.Graphics,
    pose: card_warp.Pose,
    face_up: bool,
    alpha: f64
): unit
    card_warp.build(sheet.mesh, pose)
    local target = sheet.back
    if face_up then target = sheet.face end
    if target == nil then return end
    local texture: graphics_module.Texture = graphics:texture_from_render_target(
        target)
    -- Seen from behind, a card's face reads the wrong way round unless its
    -- source region is taken right to left.
    local source_x = 0.0
    local source_width = render.card_width
    if face_up then
        source_x = render.card_width
        source_width = -render.card_width
    end
    graphics:set_color_rgba(1.0, 1.0, 1.0, alpha)
    graphics:draw_sprite_mesh(
        texture,
        DRAW_COLUMNS,
        DRAW_ROWS,
        sheet.mesh.xs,
        sheet.mesh.ys,
        sheet.mesh.shades,
        source_x,
        0.0,
        source_width,
        render.card_height
    )
end

-- The stack the card comes out of. A pull needs something to be pulled from,
-- and the thinning silhouette is the same one the board's draw pile uses.
local function draw_deck(graphics: engine.Graphics): unit
    local x = DECK_X - render.card_width * 0.5
    local y = DECK_Y - render.card_height * 0.5
    render.panel(graphics, x + 6.0, y + 6.0, render.card_width, render.card_height, "#17171c", "#3f3f46")
    render.panel(graphics, x + 3.0, y + 3.0, render.card_width, render.card_height, "#17171c", "#3f3f46")
    render.panel(graphics, x, y, render.card_width, render.card_height, "#17171c", "#52525b")
    render.draw_card_back(graphics, assets.texture, x, y, false)
end

-- Whatever is holding the card up, seen only as what it does to the air. It
-- arrives with the catch, which is the moment the card stops being thrown and
-- starts being held.
local function draw_hold(graphics: engine.Graphics, pose: card_warp.Pose, strength: f64): unit
    if strength <= 0.0 then return end
    -- Enough rings, faint enough, that the falloff is a glow rather than the
    -- set of circles it is made of.
    graphics:set_blend_mode("add")
    for ring = 0, 11 do
        local spread = 40.0 + ring * 9.0
        local weight = strength * 0.022 * (1.0 - ring / 12.0)
        graphics:set_color_rgba(0.36, 0.55, 0.95, weight)
        graphics:fill_circle(pose.center_x, pose.center_y, spread)
    end
    graphics:set_blend_mode("alpha")
end

-- Where the story's clock is: running, or held wherever the scrub control put
-- it. Scrubbing is what a beat this short is actually judged in — which is
-- also why the scrub does not cover the whole loop. Everything worth stepping
-- through happens before the card has settled, and a slider that spent three
-- quarters of its travel on the hover would be a slider that cannot reach
-- the turn.
const SCRUB_TAIL = 0.35

local function draw_clock(): f64
    if storybook.arg_i32("playback") == 1 then
        local scrubbed = card_draw.land_end + SCRUB_TAIL
        return scrubbed * (storybook.arg_i32("phase")::f64) / 100.0
    end
    local total = card_draw.total_seconds()
    return shared.clock - math.floor(shared.clock / total) * total
end

local function drawing(): card_draw.Draw
    return {
        from_x = DECK_X,
        from_y = DECK_Y,
        to_x = CAUGHT_X,
        to_y = CAUGHT_Y,
        width = render.card_width,
        height = render.card_height,
        stretch_limit = (storybook.arg_i32("stretch")::f64) / 100.0,
        overshoot = (storybook.arg_i32("overshoot")::f64) / 100.0,
        rise = storybook.arg_i32("rise")::f64,
        arc = storybook.arg_i32("arc")
    }
end

local function draw_drawing(graphics: engine.Graphics, alpha: f64): unit
    ready(graphics)
    draw_deck(graphics)
    if not capture(graphics) then return end
    local draw = drawing()
    local clock = draw_clock()

    -- The heart of the flight is the only stretch fast enough to leave
    -- anything behind it, and the ghosts are earlier states of the same sheet
    -- rather than smears of the last frame — a stretched card trailing an
    -- unstretched copy of itself is what gives the deformation away.
    if card_draw.trails(clock) then
        local offsets = card_draw.ghost_offsets()
        for index = 0, #offsets - 1 do
            local past = clock - offsets[index]
            if card_draw.ghost_visible(past) then
                draw_pose(
                    graphics,
                    card_draw.pose_at(draw, past),
                    card_draw.shows_face(draw, past),
                    0.16 + 0.1 * (index::f64)
                )
            end
        end
    end

    local pose = card_draw.pose_at(draw, clock)
    local hold = 0.0
    if clock >= card_draw.flight_end then hold = 1.0 end
    draw_hold(graphics, pose, hold)
    draw_pose(graphics, pose, card_draw.shows_face(draw, clock), 1.0)
end

-- A card story is one card on one small canvas; only the fan needs the board's
-- own geometry, because that is the space its slots are laid out in.
local function card_scene(draw: (engine.Graphics, f64) -> unit): storybook.Scene
    return {
        draw = draw,
        load = load,
        update = tick,
        width = WIDTH::u32,
        height = HEIGHT::u32,
        background = BACKGROUND
    }
end

storybook.publish({
    storybook.story("Face up", card_scene(draw_face_up), {
        storybook.select("suit", 0, { "Red", "Blue", "Black", "Green" }),
        storybook.range("rank", 13, 2, 14, 1),
    }),
    storybook.story("Face down", card_scene(draw_face_down)),
    storybook.story("Bound", card_scene(draw_bound)),
    storybook.story("Focused", card_scene(draw_focused)),
    storybook.story("Contributing", card_scene(draw_contributing)),
    storybook.story("Watched", card_scene(draw_watched)),
    storybook.story("Turning over", card_scene(draw_turning)),
    storybook.story("Every school", {
        draw = draw_schools,
        load = load,
        update = tick,
        width = SCHOOLS_WIDTH::u32,
        height = HEIGHT::u32,
        background = BACKGROUND
    }),
    storybook.story("Drawn from the deck", {
        draw = draw_drawing,
        load = load,
        update = tick,
        width = DRAW_WIDTH::u32,
        height = DRAW_HEIGHT::u32,
        background = BACKGROUND
    }, {
        storybook.select("playback", 0, { "Loop", "Scrub" }),
        storybook.range("phase", 0, 0, 100, 1),
        -- The one number that decides whether this reads as a card with
        -- weight or as a rubber toy.
        storybook.range("stretch", 160, 100, 200, 1),
        -- How far past its spot the throw carries the card, in hundredths of
        -- the whole journey. Zero pulls up exactly on the mark.
        storybook.range("overshoot", 30, 0, 40, 1),
        -- The top of the arc, in logical pixels of depth toward the viewer.
        storybook.range("rise", 270, 0, 400, 10),
        -- When that top comes. The options are card_draw's arc shapes, in
        -- the same order it declares them.
        storybook.select("arc", 2, { "Even", "Late", "Very late", "Early" }),
    }),
    storybook.story("In the fan", {
        draw = draw_fan,
        load = load,
        update = tick,
        width = 960,
        height = 600,
        background = BACKGROUND
    }),
})
