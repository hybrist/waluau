-- DOM-free rules for Duel Magic. The presentation treats suits as
-- colors, cards as cards, and the computer as the Opponent; the underlying
-- five-card hand, exchange, wager, and trick rules remain unchanged.

local snapshot_data = require("./snapshot")

type Card = { rank: i32, suit: i32 }
type PairChoice = { first: i32, second: i32, value: i32 }
type SwapChoice = { hand_indices: {i32}, middle_indices: {i32}, community_value: i32, hand_value: i32 }
type FeintOutcome = {
    winner: i32,
    hand_indices: {i32},
    middle_indices: {i32},
    outgoing: {Card},
    incoming: {Card}
}
-- One slot of a hand: the card sitting there, plus whether the opponent has
-- watched it. `known` is set when the card arrived from the middle, which
-- both sides were looking at, so it is no longer secret; cards drawn off the
-- deck are secret, and only an exchange leaks one. Keeping the mark on the
-- slot means removal, sorting, and snapshots can never desynchronize a card
-- from its mark.
type HandSlot = { card: Card, known: bool }
-- One spell the player carry, with the gold a single cast of it burns. The
-- cost travels with the spell rather than being a constant of the kind: a run
-- can upgrade the same spell between duels, and two player carrying Firebolt
-- do not necessarily pay the same for it.
type Spell = { kind: i32, cost: i32 }
type Trick = { round: i32, middle: {Card}, frozen_middle: {bool}, player_hand: {HandSlot}, computer_hand: {HandSlot}, player_cards: {Card}, computer_cards: {Card}, player_first: i32, player_second: i32, computer_first: i32, computer_second: i32, player_value: i32, computer_value: i32, winner: i32, points: i32, pot: i32, player_wager: i32, computer_wager: i32, swap_winner: i32, swap_count: i32 }
-- `boss` selects the boss battle variant: both sides start with eleven cards
-- instead of five and never draw replacements, so the hands shrink by two each
-- round and the fifth round is fought from a three-card hand.
-- `spells` is the loadout the player brought into this duel, in the order
-- they learned the spells; a cast names a slot of it. `cast_kind` is the kind
-- of the last cast these rules charged for, which is what decides whether a
-- burn finishing on the board owes a Firebolt replacement. `player_points` is
-- their gold, both the wager stake and the resource each cast burns. Both the
-- loadout and the gold are dealt in rather than fixed, so a run can hand one
-- duel what the previous one left standing and whatever it bought since.
opaque type State = { deck: {Card}, player_hand: {HandSlot}, computer_hand: {HandSlot}, middle: {Card}, frozen_middle: {bool}, history: {Trick}, round: i32, player_points: i32, player_tricks: i32, computer_tricks: i32, last_player_value: i32, last_computer_value: i32, last_winner: i32, swap_open: bool, pot: i32, player_wager: i32, computer_wager: i32, swap_winner: i32, swap_count: i32, swap_hand_indices: {i32}, swap_middle_indices: {i32}, finished: bool, boss: bool, spells: {Spell}, cast_kind: i32 }
type View = {
    deck_count: i32,
    player_hand: {HandSlot},
    computer_hand: {HandSlot},
    middle: {Card},
    frozen_middle: {bool},
    history: {Trick},
    round: i32,
    player_points: i32,
    player_tricks: i32,
    computer_tricks: i32,
    swap_open: bool,
    pot: i32,
    player_wager: i32,
    computer_wager: i32,
    swap_winner: i32,
    swap_count: i32,
    swap_hand_indices: {i32},
    swap_middle_indices: {i32},
    finished: bool,
    spells: {Spell}
}
-- The pair one side committed to a resolved trick, the hand slots it left,
-- and that side's full revealed hand — see trick_side.
type TrickSide = {
    cards: {Card},
    first: i32,
    second: i32,
    value: i32,
    hand: {HandSlot}
}
const MIN_RANK: i32 = 2
const MAX_RANK: i32 = 14
const MIN_SUIT: i32 = 0
const MAX_SUIT: i32 = 3
const ZERO: i32 = 0
const ONE: i32 = 1
const TWO: i32 = 2
const MAX_ROUNDS: i32 = 5
const ARCH_MAGE_WINS_TO_END: i32 = 3
const HAND_SIZE: i32 = 5
const BOSS_HAND_SIZE: i32 = 11
-- The gold a duel is fought with when nothing carried into it. A run hands
-- the next duel whatever the last one left standing instead.
const STARTING_MANA: i32 = 10
-- The four starting spells, in menu order. Presentation owns their launch and
-- card treatments; rules own gameplay state such as frozen table cards and Firebolt
-- replacing a destroyed table_card.
const SPELL_FIREBOLT: i32 = 1
const SPELL_FREEZE_RAY: i32 = 2
const SPELL_RAISE_CARD: i32 = 3
const SPELL_CLONE: i32 = 4
-- The kinds are 1..SPELL_KIND_COUNT, so anything picking a spell at random —
-- the shop's offer, say — enumerates them without a second catalog.
const SPELL_KIND_COUNT: i32 = 4
-- What a freshly learned spell charges per cast, before a run sharpens it.
const SPELL_COST: i32 = 5
const SNAPSHOT_SCHEMA: string = "duel-state-v6"
const SNAPSHOT_COLLECTION_LIMIT: i32 = 256

-- A spell as it is first learned: full price until something reduces it.
function new_spell(kind: i32): Spell
    return { kind = kind, cost = SPELL_COST }
end

-- A loadout the caller cannot reach into afterwards. A duel is dealt the
-- run's spells the way it is dealt its gold — as a reading of them, not as the
-- run's own records — so nothing inside a duel can upgrade a spell.
function clone_spells(spells: {Spell}): {Spell}
    local copy: {Spell} = {}
    for spell in spells do
        table.insert(copy, { kind = spell.kind, cost = spell.cost })
    end
    return copy
end

function make_deck(): {Card}
    local deck: {Card} = {}
    for suit = MIN_SUIT, MAX_SUIT do
        for rank = MIN_RANK, MAX_RANK do
            table.insert(deck, { rank = rank, suit = suit })
        end
    end
    return deck
end

function shuffle(deck: {Card}): unit
    local i: i32 = #deck - ONE
    while i >= ONE do
        local j: i32 = math.random(i + ONE) - ONE
        local card: Card = deck[i]
        deck[i] = deck[j]
        deck[j] = card
        i -= ONE
    end
end

function draw(deck: {Card}): Card
    local card: Card = deck[#deck - ONE]
    table.remove(deck)
    return card
end

-- A freshly dealt slot: replacements come off the sealed deck, so neither
-- side has seen them yet.
function deal_slot(deck: {Card}): HandSlot
    return { card = draw(deck), known = false }
end

-- The bare cards of a hand, for the card-identity scoring and AI functions,
-- which have no business knowing about watched marks.
function hand_cards(slots: {HandSlot}): {Card}
    local cards: {Card} = {}
    for slot in slots do table.insert(cards, slot.card) end
    return cards
end

-- Slot copies for a Trick: the live slots keep mutating (marks, removal,
-- refills) after the trick resolves, so history must hold its own records.
-- Cards themselves are immutable and safe to share.
function clone_slots(slots: {HandSlot}): {HandSlot}
    local copy: {HandSlot} = {}
    for slot in slots do table.insert(copy, { card = slot.card, known = slot.known }) end
    return copy
end

-- Scores are packed as base-SCORE_RADIX digits: the category occupies the
-- most significant digit, five kicker components the rest. CATEGORY_DIVISOR
-- is SCORE_RADIX^5, spelled out because top-level constants require literal
-- initializers; category_of and score_component are the pack inverses.
const SCORE_RADIX: i32 = 15
const CATEGORY_DIVISOR: i32 = 759375

function pack(category: i32, a: i32, b: i32, c: i32, d: i32, e: i32): i32
    local value: i32 = category
    value = value * SCORE_RADIX + a
    value = value * SCORE_RADIX + b
    value = value * SCORE_RADIX + c
    value = value * SCORE_RADIX + d
    return value * SCORE_RADIX + e
end

function category_of(value: i32): i32
    return value // CATEGORY_DIVISOR
end

-- Return a lexicographically sortable score for exactly five cards. Category
-- occupies the most significant base-15 digit, followed by poker kickers.
function swap_if_lower(ranks: {i32}, left: i32, right: i32): unit
    if ranks[left] < ranks[right] then
        local value: i32 = ranks[left]
        ranks[left] = ranks[right]
        ranks[right] = value
    end
end

function rank_five(cards: {Card}): i32
    assert(#cards == 5)
    local ranks: {i32} = { cards[0].rank, cards[1].rank, cards[2].rank, cards[3].rank, cards[4].rank }
    -- A fixed five-item bubble sorting network avoids allocating comparator
    -- closures and keeps the evaluator straightforward.
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 2, 3)
    swap_if_lower(ranks, 3, 4)
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 2, 3)
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 0, 1)

    local flush: bool = cards[0].suit == cards[1].suit and cards[0].suit == cards[2].suit and cards[0].suit == cards[3].suit and cards[0].suit == cards[4].suit
    local straight_high: i32 = 0
    if ranks[0] - ranks[4] == 4 and ranks[0] > ranks[1] and ranks[1] > ranks[2] and ranks[2] > ranks[3] and ranks[3] > ranks[4] then
        straight_high = ranks[0]
    elseif ranks[0] == 14 and ranks[1] == 5 and ranks[2] == 4 and ranks[3] == 3 and ranks[4] == 2 then
        straight_high = 5
    end

    if flush and straight_high > 0 then
        return pack(8, straight_high, 0, 0, 0, 0)
    elseif ranks[0] == ranks[3] then
        return pack(7, ranks[0], ranks[4], 0, 0, 0)
    elseif ranks[1] == ranks[4] then
        return pack(7, ranks[1], ranks[0], 0, 0, 0)
    elseif ranks[0] == ranks[2] and ranks[3] == ranks[4] then
        return pack(6, ranks[0], ranks[3], 0, 0, 0)
    elseif ranks[0] == ranks[1] and ranks[2] == ranks[4] then
        return pack(6, ranks[2], ranks[0], 0, 0, 0)
    elseif flush then
        return pack(5, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4])
    elseif straight_high > 0 then
        return pack(4, straight_high, 0, 0, 0, 0)
    elseif ranks[0] == ranks[2] then
        return pack(3, ranks[0], ranks[3], ranks[4], 0, 0)
    elseif ranks[1] == ranks[3] then
        return pack(3, ranks[1], ranks[0], ranks[4], 0, 0)
    elseif ranks[2] == ranks[4] then
        return pack(3, ranks[2], ranks[0], ranks[1], 0, 0)
    elseif ranks[0] == ranks[1] and ranks[2] == ranks[3] then
        return pack(2, ranks[0], ranks[2], ranks[4], 0, 0)
    elseif ranks[0] == ranks[1] and ranks[3] == ranks[4] then
        return pack(2, ranks[0], ranks[3], ranks[2], 0, 0)
    elseif ranks[1] == ranks[2] and ranks[3] == ranks[4] then
        return pack(2, ranks[1], ranks[3], ranks[0], 0, 0)
    elseif ranks[0] == ranks[1] then
        return pack(1, ranks[0], ranks[2], ranks[3], ranks[4], 0)
    elseif ranks[1] == ranks[2] then
        return pack(1, ranks[1], ranks[0], ranks[3], ranks[4], 0)
    elseif ranks[2] == ranks[3] then
        return pack(1, ranks[2], ranks[0], ranks[1], ranks[4], 0)
    elseif ranks[3] == ranks[4] then
        return pack(1, ranks[3], ranks[0], ranks[1], ranks[2], 0)
    end
    return pack(0, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4])
end

function value_for_pair(hand: {Card}, middle: {Card}, first: i32, second: i32): i32
    return rank_five({ middle[0], middle[1], middle[2], hand[first], hand[second] })
end

function best_pair(hand: {Card}, middle: {Card}): PairChoice
    local best: PairChoice = { first = 0, second = 1, value = value_for_pair(hand, middle, 0, 1) }
    for first = ZERO, #hand - TWO do
        for second = first + ONE, #hand - ONE do
            local value: i32 = value_for_pair(hand, middle, first, second)
            if value > best.value then
                best.first = first
                best.second = second
                best.value = value
            end
        end
    end
    return best
end

function clone_cards(cards: {Card}): {Card}
    local copy: {Card} = {}
    for card in cards do table.insert(copy, card) end
    return copy
end

-- The card-level exchange best_swap and proposed_swap score against: it runs
-- over throwaway clones, so no watched marks are involved.
function exchange(hand: {Card}, middle: {Card}, hand_indices: {i32}, middle_indices: {i32}): unit
    assert(#hand_indices == #middle_indices)
    for i = ZERO, #hand_indices - ONE do
        local card: Card = hand[hand_indices[i]]
        hand[hand_indices[i]] = middle[middle_indices[i]]
        middle[middle_indices[i]] = card
    end
end

-- The same exchange against a live hand. Every slot it touches now holds a
-- card that was face up in the middle a moment ago, so the opponent knows all
-- of them: the replacement slot is born marked, and whatever secrecy the old
-- slot still had leaves with its card.
function exchange_live(hand: {HandSlot}, middle: {Card}, hand_indices: {i32}, middle_indices: {i32}): unit
    assert(#hand_indices == #middle_indices)
    for i = ZERO, #hand_indices - ONE do
        local outgoing: Card = hand[hand_indices[i]].card
        hand[hand_indices[i]] = { card = middle[middle_indices[i]], known = true }
        middle[middle_indices[i]] = outgoing
    end
end

-- Three-card poker ordering used only to break equal swap wagers:
-- straight flush > three of a kind > straight > flush > pair > high card.
function rank_three(cards: {Card}): i32
    assert(#cards == 3)
    local ranks: {i32} = { cards[0].rank, cards[1].rank, cards[2].rank }
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 0, 1)
    local flush: bool = cards[0].suit == cards[1].suit and cards[0].suit == cards[2].suit
    local straight_high: i32 = 0
    if ranks[0] - ranks[2] == 2 and ranks[0] > ranks[1] and ranks[1] > ranks[2] then
        straight_high = ranks[0]
    elseif ranks[0] == 14 and ranks[1] == 3 and ranks[2] == 2 then
        straight_high = 3
    end
    if flush and straight_high > 0 then return pack(5, straight_high, 0, 0, 0, 0) end
    if ranks[0] == ranks[2] then return pack(4, ranks[0], 0, 0, 0, 0) end
    if straight_high > 0 then return pack(3, straight_high, 0, 0, 0, 0) end
    if flush then return pack(2, ranks[0], ranks[1], ranks[2], 0, 0) end
    if ranks[0] == ranks[1] then return pack(1, ranks[0], ranks[2], 0, 0, 0) end
    if ranks[1] == ranks[2] then return pack(1, ranks[1], ranks[0], 0, 0, 0) end
    return pack(0, ranks[0], ranks[1], ranks[2], 0, 0)
end

function swap_priority(player_wager: i32, player_community: i32, computer_wager: i32, computer_community: i32): i32
    if player_wager <= 0 and computer_wager <= 0 then return 0 end
    if player_wager > computer_wager then return 1 end
    if computer_wager > player_wager then return -1 end
    if player_community > computer_community then return 1 end
    if computer_community > player_community then return -1 end
    return 0
end

function proposed_swap(hand: {Card}, middle: {Card}, hand_indices: {i32}, middle_indices: {i32}): SwapChoice
    local proposed_hand: {Card} = clone_cards(hand)
    local proposed_middle: {Card} = clone_cards(middle)
    exchange(proposed_hand, proposed_middle, hand_indices, middle_indices)
    return {
        hand_indices = hand_indices,
        middle_indices = middle_indices,
        community_value = rank_three(proposed_middle),
        hand_value = best_pair(proposed_hand, proposed_middle).value,
    }
end

-- Every way to pull one, two, or three cards out of a hand of `count` cards.
-- The five-card hand's twenty-five options used to be a literal table; boss
-- battle hands run up to eleven cards, so the options are enumerated instead.
function swap_hand_options(count: i32): {{i32}}
    local options: {{i32}} = {}
    for first = ZERO, count - ONE do
        table.insert(options, { first })
    end
    for first = ZERO, count - TWO do
        for second = first + ONE, count - ONE do
            table.insert(options, { first, second })
        end
    end
    for first = ZERO, count - TWO - ONE do
        for second = first + ONE, count - TWO do
            for third = second + ONE, count - ONE do
                table.insert(options, { first, second, third })
            end
        end
    end
    return options
end

function best_available_swap(hand: {Card}, middle: {Card}, frozen_middle: {bool}): SwapChoice
    local baseline: i32 = best_pair(hand, middle).value
    local best: SwapChoice = { hand_indices = {}, middle_indices = {}, community_value = rank_three(middle), hand_value = baseline }
    local hand_options: {{i32}} = swap_hand_options(#hand)
    local middle_options: {{i32}} = { { 0 }, { 1 }, { 2 }, { 0, 1 }, { 0, 2 }, { 1, 2 }, { 0, 1, 2 } }
    for hand_indices in hand_options do
        for middle_indices in middle_options do
            local available: bool = true
            for index in middle_indices do
                if frozen_middle[index] then available = false end
            end
            if available and #hand_indices == #middle_indices then
                local candidate: SwapChoice = proposed_swap(hand, middle, hand_indices, middle_indices)
                if candidate.hand_value > best.hand_value or (candidate.hand_value == best.hand_value and candidate.community_value > best.community_value) then
                    best.hand_indices = candidate.hand_indices
                    best.middle_indices = candidate.middle_indices
                    best.community_value = candidate.community_value
                    best.hand_value = candidate.hand_value
                end
            end
        end
    end
    if best.hand_value <= baseline then
        best.hand_indices = {}
        best.middle_indices = {}
        best.community_value = rank_three(middle)
    end
    return best
end

function best_swap(hand: {Card}, middle: {Card}): SwapChoice
    return best_available_swap(hand, middle, { false, false, false })
end

-- Spend two slots of a hand; the watched marks travel inside their slots.
function remove_pair(hand: {HandSlot}, first: i32, second: i32): unit
    if first > second then
        table.remove(hand, first)
        table.remove(hand, second)
    else
        table.remove(hand, second)
        table.remove(hand, first)
    end
end

function State:reveal_middle(): unit
    self.middle = { draw(self.deck), draw(self.deck), draw(self.deck) }
end

-- Replace only table cards that are free to rotate. A post-swap Freeze Ray keeps
-- its table_card in the same slot for the next round while the other slots turn.
function State:rotate_middle(): unit
    for index = 0::i32, #self.middle - ONE do
        if not self.frozen_middle[index] then self.middle[index] = draw(self.deck) end
    end
end

function State:clear_frozen(): unit
    self.frozen_middle = { false, false, false }
end

function State:middle_indices_available(indices: {i32}): bool
    for index in indices do
        if index < 0 or index >= #self.middle or self.frozen_middle[index] then return false end
    end
    return true
end

-- Reorder the player's cards without touching what they are: sorting is a
-- presentation courtesy, so the watched marks travel with their cards and the
-- deck, table cards, and history never notice. by_color groups the fan by color
-- in deck order with strong ranks first; otherwise the whole fan runs
-- strongest rank to weakest, with colors breaking ties. Returns the applied
-- permutation as order[new_slot] = old_slot so the caller can carry its
-- cursor and pending picks across to the cards they were naming.
function State:sort_player_hand(by_color: bool): {i32}
    local order: {i32} = {}
    local keys: {i32} = {}
    for index, slot in self.player_hand do
        table.insert(order, index)
        if by_color then
            table.insert(keys, slot.card.suit * 15 + (MAX_RANK - slot.card.rank))
        else
            table.insert(keys, (MAX_RANK - slot.card.rank) * 4 + slot.card.suit)
        end
    end
    -- A tiny selection sort over the parallel slot/key lists: five cards
    -- never justify comparator closures, matching rank_five's fixed network.
    for i = ZERO, #order - TWO do
        local smallest: i32 = i
        for j = i + ONE, #order - ONE do
            if keys[j] < keys[smallest] then smallest = j end
        end
        if smallest ~= i then
            local key: i32 = keys[i]
            keys[i] = keys[smallest]
            keys[smallest] = key
            local slot: i32 = order[i]
            order[i] = order[smallest]
            order[smallest] = slot
        end
    end
    local sorted_hand: {HandSlot} = {}
    for slot in order do
        table.insert(sorted_hand, self.player_hand[slot])
    end
    self.player_hand = sorted_hand
    return order
end

-- Transmute the three table cards followed by the first two player cards into the
-- five cards the scoring rules combine. Red color is suit zero, so the final
-- hand is 10-J-Q-K-A of red regardless of the hand that was dealt.
-- The changed cards are known because the Opponent watches the miracle too.
function State:divine_intervention(target: i32): bool
    if target >= 0 and target < 3 then
        self.middle[target] = { rank = 10 + target, suit = 0 }
        return true
    end
    local hand_index: i32 = target - 3
    if hand_index >= 0 and hand_index < 2 and hand_index < #self.player_hand then
        self.player_hand[hand_index] = {
            card = { rank = 13 + hand_index, suit = 0 },
            known = true,
        }
        return true
    end
    return false
end

function State:resolve_swap(hand_indices: {i32}, middle_indices: {i32}): FeintOutcome?
    if self.finished or not self.swap_open then return nil end
    local player_wager: i32 = #hand_indices
    local valid_player_swap: bool = player_wager <= 3
        and player_wager <= self.player_points
        and player_wager == #middle_indices
        and self:middle_indices_available(middle_indices)
    if not valid_player_swap then return nil end

    local computer: SwapChoice = best_available_swap(
        hand_cards(self.computer_hand), self.middle, self.frozen_middle)
    local player_community: i32 = 0
    if valid_player_swap then
        player_community = proposed_swap(hand_cards(self.player_hand), self.middle, hand_indices, middle_indices).community_value
    end

    self.player_wager = player_wager
    self.computer_wager = #computer.hand_indices
    self.player_points -= self.player_wager
    self.pot = self.player_wager + self.computer_wager
    self.swap_winner = swap_priority(self.player_wager, player_community, self.computer_wager, computer.community_value)
    self.swap_count = 0
    -- The executed exchange, slot by slot, so the presentation can animate
    -- exactly which cards and table cards traded places (the Opponent's picks
    -- are otherwise invisible outside this module).
    self.swap_hand_indices = {}
    self.swap_middle_indices = {}
    if self.swap_winner > 0 then
        exchange_live(self.player_hand, self.middle, hand_indices, middle_indices)
        self.swap_count = #hand_indices
        self.swap_hand_indices = hand_indices
        self.swap_middle_indices = middle_indices
    elseif self.swap_winner < 0 then
        exchange_live(self.computer_hand, self.middle, computer.hand_indices, computer.middle_indices)
        self.swap_count = #computer.hand_indices
        self.swap_hand_indices = computer.hand_indices
        self.swap_middle_indices = computer.middle_indices
    end
    self.swap_open = false
    self:clear_frozen()
    local outgoing: {Card} = {}
    local incoming: {Card} = {}
    if self.swap_winner ~= 0 then
        for k = 0::i32, self.swap_count - 1 do
            local hand_index: i32 = self.swap_hand_indices[k]
            local middle_index: i32 = self.swap_middle_indices[k]
            table.insert(outgoing, self.middle[middle_index])
            if self.swap_winner > 0 then table.insert(incoming, self.player_hand[hand_index].card)
            else table.insert(incoming, self.computer_hand[hand_index].card) end
        end
    end
    return {
        winner = self.swap_winner,
        hand_indices = self.swap_hand_indices,
        middle_indices = self.swap_middle_indices,
        outgoing = outgoing,
        incoming = incoming,
    }
end

function State:play(first: i32, second: i32): Trick?
    if self.finished or self.swap_open or first == second or first < 0 or second < 0 or first >= #self.player_hand or second >= #self.player_hand then
        return nil
    end

    local computer: PairChoice = best_pair(hand_cards(self.computer_hand), self.middle)
    self.last_player_value = value_for_pair(hand_cards(self.player_hand), self.middle, first, second)
    self.last_computer_value = computer.value
    self.last_winner = 0
    local trick_points: i32 = 0
    if self.last_player_value > self.last_computer_value then
        self.player_points += self.round + self.pot
        self.player_tricks += 1
        self.last_winner = 1
        trick_points = self.round + self.pot
    elseif self.last_computer_value > self.last_player_value then
        self.computer_tricks += 1
        self.last_winner = -1
    else
        -- No trick winner means no pot winner; return the player's wager.
        self.player_points += self.player_wager
    end

    local trick: Trick = {
        round = self.round,
        middle = { self.middle[0], self.middle[1], self.middle[2] },
        frozen_middle = {
            self.frozen_middle[0], self.frozen_middle[1], self.frozen_middle[2]
        },
        -- Resolution runs after the live hands have been compacted and
        -- refilled. Copy every original slot and its watched mark so
        -- replacement cards do not appear until their deal animation starts.
        player_hand = clone_slots(self.player_hand),
        computer_hand = clone_slots(self.computer_hand),
        player_cards = { self.player_hand[first].card, self.player_hand[second].card },
        computer_cards = { self.computer_hand[computer.first].card, self.computer_hand[computer.second].card },
        -- Hand slots both sides played, so the presentation can resolve the
        -- trick in place on the board after the hands have been refilled.
        player_first = first,
        player_second = second,
        computer_first = computer.first,
        computer_second = computer.second,
        player_value = self.last_player_value,
        computer_value = self.last_computer_value,
        winner = self.last_winner,
        points = trick_points,
        pot = self.pot,
        player_wager = self.player_wager,
        computer_wager = self.computer_wager,
        swap_winner = self.swap_winner,
        swap_count = self.swap_count,
    }
    table.insert(self.history, trick)

    remove_pair(self.player_hand, first, second)
    remove_pair(self.computer_hand, computer.first, computer.second)
    -- Boss battles never replace spent cards: the opening eleven are the
    -- whole run, so both hands shrink toward the three-card final round.
    if not self.boss then
        for _ = 1, 2 do
            table.insert(self.player_hand, deal_slot(self.deck))
            table.insert(self.computer_hand, deal_slot(self.deck))
        end
    end

    if self.computer_tricks >= ARCH_MAGE_WINS_TO_END or self.round >= MAX_ROUNDS then
        self.middle = {}
        self.finished = true
    else
        self.round += 1
        self:rotate_middle()
        self.swap_open = true
        self.pot = 0
        self.player_wager = 0
        self.computer_wager = 0
        self.swap_winner = 0
        self.swap_count = 0
        self.swap_hand_indices = {}
        self.swap_middle_indices = {}
    end
    self:clear_frozen()
    return trick
end

-- Development snapshots intentionally use a small, explicit schema instead of
-- reflecting arbitrary tables. That keeps incompatibility a normal false
-- result when the rules state changes, rather than turning this into a
-- long-lived save-game format.
function append_cards(parts: {string}, cards: {Card}): unit
    snapshot_data.append_i32(parts, #cards)
    for card in cards do
        snapshot_data.append_i32(parts, card.rank)
        snapshot_data.append_i32(parts, card.suit)
    end
end

function append_slots(parts: {string}, slots: {HandSlot}): unit
    snapshot_data.append_i32(parts, #slots)
    for slot in slots do
        snapshot_data.append_i32(parts, slot.card.rank)
        snapshot_data.append_i32(parts, slot.card.suit)
        snapshot_data.append_bool(parts, slot.known)
    end
end

function append_spells(parts: {string}, spells: {Spell}): unit
    snapshot_data.append_i32(parts, #spells)
    for spell in spells do
        snapshot_data.append_i32(parts, spell.kind)
        snapshot_data.append_i32(parts, spell.cost)
    end
end

function append_flags(parts: {string}, flags: {bool}): unit
    snapshot_data.append_i32(parts, #flags)
    for flag in flags do snapshot_data.append_bool(parts, flag) end
end

function append_trick(parts: {string}, trick: Trick): unit
    snapshot_data.append_i32(parts, trick.round)
    append_cards(parts, trick.middle)
    append_flags(parts, trick.frozen_middle)
    append_slots(parts, trick.player_hand)
    append_slots(parts, trick.computer_hand)
    append_cards(parts, trick.player_cards)
    append_cards(parts, trick.computer_cards)
    snapshot_data.append_i32(parts, trick.player_first)
    snapshot_data.append_i32(parts, trick.player_second)
    snapshot_data.append_i32(parts, trick.computer_first)
    snapshot_data.append_i32(parts, trick.computer_second)
    snapshot_data.append_i32(parts, trick.player_value)
    snapshot_data.append_i32(parts, trick.computer_value)
    snapshot_data.append_i32(parts, trick.winner)
    snapshot_data.append_i32(parts, trick.points)
    snapshot_data.append_i32(parts, trick.pot)
    snapshot_data.append_i32(parts, trick.player_wager)
    snapshot_data.append_i32(parts, trick.computer_wager)
    snapshot_data.append_i32(parts, trick.swap_winner)
    snapshot_data.append_i32(parts, trick.swap_count)
end

function snapshot(state: State): string
    local parts: {string} = { SNAPSHOT_SCHEMA }
    append_cards(parts, state.deck)
    append_slots(parts, state.player_hand)
    append_slots(parts, state.computer_hand)
    append_cards(parts, state.middle)
    append_flags(parts, state.frozen_middle)
    snapshot_data.append_i32(parts, #state.history)
    for trick in state.history do append_trick(parts, trick) end
    snapshot_data.append_i32(parts, state.round)
    snapshot_data.append_i32(parts, state.player_points)
    snapshot_data.append_i32(parts, state.player_tricks)
    snapshot_data.append_i32(parts, state.computer_tricks)
    snapshot_data.append_i32(parts, state.last_player_value)
    snapshot_data.append_i32(parts, state.last_computer_value)
    snapshot_data.append_i32(parts, state.last_winner)
    snapshot_data.append_bool(parts, state.swap_open)
    snapshot_data.append_i32(parts, state.pot)
    snapshot_data.append_i32(parts, state.player_wager)
    snapshot_data.append_i32(parts, state.computer_wager)
    snapshot_data.append_i32(parts, state.swap_winner)
    snapshot_data.append_i32(parts, state.swap_count)
    snapshot_data.append_indices(parts, state.swap_hand_indices)
    snapshot_data.append_indices(parts, state.swap_middle_indices)
    snapshot_data.append_bool(parts, state.finished)
    snapshot_data.append_bool(parts, state.boss)
    append_spells(parts, state.spells)
    snapshot_data.append_i32(parts, state.cast_kind)
    return table.concat(parts, ",")
end

function next_cards(reader: snapshot_data.Reader): {Card}
    local cards: {Card} = {}
    local length: i32 = reader:next_length()
    for _ = 1, length do
        table.insert(cards, { rank = reader:next_i32(), suit = reader:next_i32() })
    end
    return cards
end

function next_slots(reader: snapshot_data.Reader): {HandSlot}
    local slots: {HandSlot} = {}
    local length: i32 = reader:next_length()
    for _ = 1, length do
        table.insert(slots, {
            card = { rank = reader:next_i32(), suit = reader:next_i32() },
            known = reader:next_bool(),
        })
    end
    return slots
end

function next_spells(reader: snapshot_data.Reader): {Spell}
    local spells: {Spell} = {}
    local length: i32 = reader:next_length()
    for _ = 1, length do
        table.insert(spells, {
            kind = reader:next_i32(), cost = reader:next_i32(),
        })
    end
    return spells
end

function next_flags(reader: snapshot_data.Reader): {bool}
    local flags: {bool} = {}
    local length: i32 = reader:next_length()
    for _ = 1, length do table.insert(flags, reader:next_bool()) end
    return flags
end

function next_trick(reader: snapshot_data.Reader): Trick
    local round: i32 = reader:next_i32()
    local middle: {Card} = next_cards(reader)
    local frozen_middle: {bool} = next_flags(reader)
    local player_hand: {HandSlot} = next_slots(reader)
    local computer_hand: {HandSlot} = next_slots(reader)
    local player_cards: {Card} = next_cards(reader)
    local computer_cards: {Card} = next_cards(reader)
    local player_first: i32 = reader:next_i32()
    local player_second: i32 = reader:next_i32()
    local computer_first: i32 = reader:next_i32()
    local computer_second: i32 = reader:next_i32()
    local player_value: i32 = reader:next_i32()
    local computer_value: i32 = reader:next_i32()
    local winner: i32 = reader:next_i32()
    local points: i32 = reader:next_i32()
    local pot: i32 = reader:next_i32()
    local player_wager: i32 = reader:next_i32()
    local computer_wager: i32 = reader:next_i32()
    local swap_winner: i32 = reader:next_i32()
    local swap_count: i32 = reader:next_i32()
    return {
        round = round,
        middle = middle,
        frozen_middle = frozen_middle,
        player_hand = player_hand,
        computer_hand = computer_hand,
        player_cards = player_cards,
        computer_cards = computer_cards,
        player_first = player_first,
        player_second = player_second,
        computer_first = computer_first,
        computer_second = computer_second,
        player_value = player_value,
        computer_value = computer_value,
        winner = winner,
        points = points,
        pot = pot,
        player_wager = player_wager,
        computer_wager = computer_wager,
        swap_winner = swap_winner,
        swap_count = swap_count,
    }
end

function restore(snapshot_value: string): State?
    local reader: snapshot_data.Reader = snapshot_data.reader(snapshot_value, SNAPSHOT_COLLECTION_LIMIT)
    if reader:next_string() ~= SNAPSHOT_SCHEMA then return nil end
    local deck: {Card} = next_cards(reader)
    local player_hand: {HandSlot} = next_slots(reader)
    local computer_hand: {HandSlot} = next_slots(reader)
    local middle: {Card} = next_cards(reader)
    local frozen_middle: {bool} = next_flags(reader)
    local history: {Trick} = {}
    local history_length: i32 = reader:next_length()
    for _ = 1, history_length do table.insert(history, next_trick(reader)) end
    local round: i32 = reader:next_i32()
    local player_points: i32 = reader:next_i32()
    local player_tricks: i32 = reader:next_i32()
    local computer_tricks: i32 = reader:next_i32()
    local last_player_value: i32 = reader:next_i32()
    local last_computer_value: i32 = reader:next_i32()
    local last_winner: i32 = reader:next_i32()
    local swap_open: bool = reader:next_bool()
    local pot: i32 = reader:next_i32()
    local player_wager: i32 = reader:next_i32()
    local computer_wager: i32 = reader:next_i32()
    local swap_winner: i32 = reader:next_i32()
    local swap_count: i32 = reader:next_i32()
    local swap_hand_indices: {i32} = reader:next_indices()
    local swap_middle_indices: {i32} = reader:next_indices()
    local finished: bool = reader:next_bool()
    local boss: bool = reader:next_bool()
    local spells: {Spell} = next_spells(reader)
    local cast_kind: i32 = reader:next_i32()
    if not reader:complete() then return nil end
    local restored: State = {
        deck = deck,
        player_hand = player_hand,
        computer_hand = computer_hand,
        middle = middle,
        frozen_middle = frozen_middle,
        history = history,
        round = round,
        player_points = player_points,
        player_tricks = player_tricks,
        computer_tricks = computer_tricks,
        last_player_value = last_player_value,
        last_computer_value = last_computer_value,
        last_winner = last_winner,
        swap_open = swap_open,
        pot = pot,
        player_wager = player_wager,
        computer_wager = computer_wager,
        swap_winner = swap_winner,
        swap_count = swap_count,
        swap_hand_indices = swap_hand_indices,
        swap_middle_indices = swap_middle_indices,
        finished = finished,
        boss = boss,
        spells = spells,
        cast_kind = cast_kind,
    }
    return restored
end

function new(boss: bool, spells: {Spell}, gold: i32): State
    local deck: {Card} = make_deck()
    shuffle(deck)
    local state: State = {
        deck = deck,
        player_hand = {},
        computer_hand = {},
        middle = {},
        frozen_middle = { false, false, false },
        history = {},
        round = 1,
        player_points = gold,
        player_tricks = 0,
        computer_tricks = 0,
        last_player_value = 0,
        last_computer_value = 0,
        last_winner = 0,
        swap_open = true,
        pot = 0,
        player_wager = 0,
        computer_wager = 0,
        swap_winner = 0,
        swap_count = 0,
        swap_hand_indices = {},
        swap_middle_indices = {},
        finished = false,
        boss = boss,
        spells = clone_spells(spells),
        cast_kind = 0,
    }
    local hand_size: i32 = HAND_SIZE
    if boss then hand_size = BOSS_HAND_SIZE end
    for _ = 1, hand_size do
        table.insert(state.player_hand, deal_slot(state.deck))
        table.insert(state.computer_hand, deal_slot(state.deck))
    end
    state:reveal_middle()
    return state
end

function view(state: State): View
    return {
        deck_count = #state.deck,
        player_hand = state.player_hand,
        computer_hand = state.computer_hand,
        middle = state.middle,
        frozen_middle = state.frozen_middle,
        history = state.history,
        round = state.round,
        player_points = state.player_points,
        player_tricks = state.player_tricks,
        computer_tricks = state.computer_tricks,
        swap_open = state.swap_open,
        pot = state.pot,
        player_wager = state.player_wager,
        computer_wager = state.computer_wager,
        swap_winner = state.swap_winner,
        swap_count = state.swap_count,
        swap_hand_indices = state.swap_hand_indices,
        swap_middle_indices = state.swap_middle_indices,
        finished = state.finished,
        spells = state.spells,
    }
end

-- The deterministic rules adapter used by tests. Representation mutation
-- stays in this defining module; scenario tests cross the same opaque seam as
-- production and can only arrange the states named here.
function test_fresh_slots(cards: {Card}): {HandSlot}
    local slots: {HandSlot} = {}
    for card in cards do
        table.insert(slots, { card = { rank = card.rank, suit = card.suit }, known = false })
    end
    return slots
end

function test_arrange_breach(
    state: State,
    middle: {Card},
    player_hand: {Card},
    computer_hand: {Card}
): unit
    state.middle = clone_cards(middle)
    state.player_hand = test_fresh_slots(player_hand)
    state.computer_hand = test_fresh_slots(computer_hand)
end

function test_arrange_arch_mage(
    state: State,
    middle: {Card},
    computer_hand: {Card}
): unit
    state.middle = clone_cards(middle)
    state.computer_hand = test_fresh_slots(computer_hand)
end

function test_arrange_player(
    state: State,
    player_hand: {Card},
    player_known: {bool}
): unit
    local slots: {HandSlot} = test_fresh_slots(player_hand)
    for index, known in player_known do slots[index].known = known end
    state.player_hand = slots
end

function test_set_player_points(state: State, points: i32): unit
    state.player_points = points
end

function test_finish(state: State, computer_tricks: i32): unit
    state.finished = true
    state.computer_tricks = computer_tricks
end

function test_set_swap_trace(
    state: State,
    hand_indices: {i32},
    middle_indices: {i32}
): unit
    state.swap_hand_indices = hand_indices
    state.swap_middle_indices = middle_indices
end

function test_next_draw(state: State): Card
    return state.deck[#state.deck - 1]
end

function State:is_finished(): bool
    return self.finished
end

-- The verdict of a finished duel, asked the same way of live rules and of a
-- board view: the Opponent ends the duel by holding three table cards, and any
-- other finish means the duel opened.
function held_by_arch_mage(computer_tricks: i32): bool
    return computer_tricks >= ARCH_MAGE_WINS_TO_END
end

function State:is_victory(): bool
    return self.finished and not held_by_arch_mage(self.computer_tricks)
end

function view_cleared(view: View): bool
    return view.finished and not held_by_arch_mage(view.computer_tricks)
end

function State:is_boss(): bool
    return self.boss
end

function State:hand_size(): i32
    return #self.player_hand
end

function State:feint_open(): bool
    return self.swap_open
end

function State:gold(): i32
    return self.player_points
end

function State:spell_count(): i32
    return #self.spells
end

-- The kind and price of one loadout slot. A slot the loadout does not have
-- answers kind zero and a price of zero, which `can_cast` refuses either way:
-- the input layer binds a fixed key per slot, so asking about an empty one is
-- ordinary rather than a caller error.
function State:spell_kind(slot: i32): i32
    if slot < 0 or slot >= #self.spells then return 0 end
    return self.spells[slot].kind
end

function State:spell_cost(slot: i32): i32
    if slot < 0 or slot >= #self.spells then return 0 end
    return self.spells[slot].cost
end

function State:is_frozen(table_card: i32): bool
    return table_card >= 0 and table_card < #self.frozen_middle and self.frozen_middle[table_card]
end

-- Whether the spell in that loadout slot could be cast right now: the run is
-- live, the slot holds a spell, and the player can pay its price. Where in the
-- turn a cast is allowed is the input layer's decision; affordability is the
-- rule this module owns.
function State:can_cast(slot: i32): bool
    if self.finished or self:spell_kind(slot) == 0 then return false end
    return self.player_points >= self.spells[slot].cost
end

-- Pay for one cast of the spell in that slot. Returns false — charging
-- nothing — when the slot is empty or the spell unaffordable, so a confirmed
-- target only spends gold once this accepts.
function State:cast_spell(slot: i32, table_card: i32): bool
    if not self:can_cast(slot) or table_card < 0 or table_card >= #self.middle then return false end
    local spell: Spell = self.spells[slot]
    self.player_points -= spell.cost
    self.cast_kind = spell.kind
    if spell.kind == SPELL_FREEZE_RAY then self.frozen_middle[table_card] = true end
    return true
end

-- Finish Firebolt's board effect after presentation has burned the targeted
-- table_card away. The discarded card is returned to the screen choreography,
-- which owns the neutral discard-pile ledger; the replacement is immediately
-- part of the live rules state and comes off the same sealed deck as a deal.
-- Only a Firebolt these rules charged for can burn a table_card away, whichever
-- loadout slot it was cast from.
function State:resolve_firebolt(target: i32): Card?
    if self.finished or self.cast_kind ~= SPELL_FIREBOLT then return nil end
    if target < 0 or target >= #self.middle or #self.deck == 0 then return nil end
    local discarded: Card = self.middle[target]
    self.middle[target] = draw(self.deck)
    return discarded
end

function State:last_trick(): Trick?
    if #self.history == 0 then return nil end
    return self.history[#self.history - 1]
end

-- One side of a resolved trick, selected by owner: 1 is the player, -1 the
-- Opponent, and trick.winner / -trick.winner name the winning and losing
-- side of a decisive trick. Consumers resolve "the winner's pair" or "the
-- loser's slots" once instead of re-selecting player_/computer_ fields at
-- every use. owner 0 names no side and is a caller error.
function trick_side(trick: Trick, owner: i32): TrickSide
    assert(owner ~= 0)
    if owner > 0 then
        return {
            cards = trick.player_cards,
            first = trick.player_first,
            second = trick.player_second,
            value = trick.player_value,
            hand = trick.player_hand,
        }
    end
    return {
        cards = trick.computer_cards,
        first = trick.computer_first,
        second = trick.computer_second,
        value = trick.computer_value,
        hand = trick.computer_hand,
    }
end

-- The same owner selection over a live board view: the side's current hand,
-- each slot carrying its own watched mark.
function view_side(view: View, owner: i32): {HandSlot}
    assert(owner ~= 0)
    if owner > 0 then return view.player_hand end
    return view.computer_hand
end

-- Start over as the given variant: the mode, loadout, and opening gold are
-- arguments rather than carried-over fields so the next deal can also be a mode
-- or spell switch from the menu, or the next duel of a run fought with the
-- gold the last one left and whatever it bought between duels.
function State:reset(boss: bool, spells: {Spell}, gold: i32): unit
    local fresh: State = new(boss, spells, gold)
    self.boss = fresh.boss
    self.spells = fresh.spells
    self.cast_kind = fresh.cast_kind
    self.deck = fresh.deck
    self.player_hand = fresh.player_hand
    self.computer_hand = fresh.computer_hand
    self.middle = fresh.middle
    self.frozen_middle = fresh.frozen_middle
    self.history = fresh.history
    self.round = fresh.round
    self.player_points = fresh.player_points
    self.player_tricks = fresh.player_tricks
    self.computer_tricks = fresh.computer_tricks
    self.last_player_value = fresh.last_player_value
    self.last_computer_value = fresh.last_computer_value
    self.last_winner = fresh.last_winner
    self.swap_open = fresh.swap_open
    self.pot = fresh.pot
    self.player_wager = fresh.player_wager
    self.computer_wager = fresh.computer_wager
    self.swap_winner = fresh.swap_winner
    self.swap_count = fresh.swap_count
    self.swap_hand_indices = fresh.swap_hand_indices
    self.swap_middle_indices = fresh.swap_middle_indices
    self.finished = fresh.finished
end

function rank_name(rank: i32): string
    if rank == 14 then return "A" end
    if rank == 13 then return "K" end
    if rank == 12 then return "Q" end
    if rank == 11 then return "J" end
    return tostring(rank)
end

function card_name(card: Card): string
    local color: string = "Red"
    if card.suit == 1 then color = "Blue"
    elseif card.suit == 2 then color = "Black"
    elseif card.suit == 3 then color = "Green"
    end
    return rank_name(card.rank) .. " of " .. color
end

function category_name(value: i32): string
    local category: i32 = category_of(value)
    if category == 8 then return "straight flush" end
    if category == 7 then return "four of a kind" end
    if category == 6 then return "full house" end
    if category == 5 then return "flush" end
    if category == 4 then return "straight" end
    if category == 3 then return "three of a kind" end
    if category == 2 then return "two pair" end
    if category == 1 then return "pair" end
    return "high card"
end

-- Kicker component `index` of a packed score, most significant first.
function score_component(value: i32, index: i32): i32
    local divisor: i32 = CATEGORY_DIVISOR // SCORE_RADIX
    for _ = 1, index do divisor //= SCORE_RADIX end
    if divisor < 1 then divisor = 1 end
    local quotient: i32 = value // divisor
    return quotient - (quotient // SCORE_RADIX) * SCORE_RADIX
end

function made_components_match(value: i32, other_value: i32, count: i32): bool
    for index = 0::i32, count - 1 do
        if score_component(value, index) ~= score_component(other_value, index) then return false end
    end
    return true
end

function formation_cards(cards: {Card}, value: i32): {bool}
    assert(#cards == 5)
    local category: i32 = category_of(value)
    if category == 8 or category == 5 or category == 4 then
        return { true, true, true, true, true }
    end
    local made_components: i32 = 1
    if category == 6 or category == 2 then made_components = 2 end
    local marked_ranks: {i32} = {}
    for index = 0::i32, made_components - 1 do
        table.insert(marked_ranks, score_component(value, index))
    end
    local marked: {bool} = {}
    for card in cards do
        local active: bool = false
        for rank in marked_ranks do
            if card.rank == rank then active = true end
        end
        table.insert(marked, active)
    end
    return marked
end

-- Mark the cards that visibly explain why a winning five-card hand won. The
-- made hand is always included; when both hands made the same hand,
-- include kickers through the first score component that breaks the tie.
function scoring_cards(cards: {Card}, value: i32, other_value: i32): {bool}
    assert(#cards == 5)
    local marked_ranks: {i32} = {}
    local category: i32 = category_of(value)
    local other_category: i32 = category_of(other_value)

    if category == 8 or category == 5 or category == 4 then
        return { true, true, true, true, true }
    end

    local made_components: i32 = 1
    if category == 6 or category == 2 then made_components = 2 end
    if category == 0 then made_components = 0 end
    for index = 0::i32, made_components - 1 do
        table.insert(marked_ranks, score_component(value, index))
    end

    local made_tied: bool = category == other_category and made_components_match(value, other_value, made_components)
    if made_tied then
        local first_kicker: i32 = made_components
        for index = first_kicker, 4::i32 do
            local rank: i32 = score_component(value, index)
            if rank == 0 then break end
            table.insert(marked_ranks, rank)
            if rank ~= score_component(other_value, index) then break end
        end
    end

    local marked: {bool} = {}
    for card in cards do
        local active: bool = false
        for rank in marked_ranks do
            if card.rank == rank then active = true end
        end
        table.insert(marked, active)
    end
    return marked
end

return {
    new = new,
    view = view,
    view_cleared = view_cleared,
    view_side = view_side,
    trick_side = trick_side,
    hand_cards = hand_cards,
    make_deck = make_deck,
    rank_five = rank_five,
    value_for_pair = value_for_pair,
    best_pair = best_pair,
    rank_three = rank_three,
    swap_priority = swap_priority,
    proposed_swap = proposed_swap,
    best_swap = best_swap,
    rank_name = rank_name,
    card_name = card_name,
    category_name = category_name,
    formation_cards = formation_cards,
    scoring_cards = scoring_cards,
    snapshot = snapshot,
    restore = restore,
    new_spell = new_spell,
    clone_spells = clone_spells,
    test_arrange_breach = test_arrange_breach,
    test_arrange_arch_mage = test_arrange_arch_mage,
    test_arrange_player = test_arrange_player,
    test_set_player_points = test_set_player_points,
    test_finish = test_finish,
    test_set_swap_trace = test_set_swap_trace,
    test_next_draw = test_next_draw,
    spell_firebolt = SPELL_FIREBOLT,
    spell_freeze_ray = SPELL_FREEZE_RAY,
    spell_raise_card = SPELL_RAISE_CARD,
    spell_clone = SPELL_CLONE,
    spell_kind_count = SPELL_KIND_COUNT,
    spell_cost = SPELL_COST,
    starting_mana = STARTING_MANA,
}
