-- Shared framing and primitive validation for Ante Magic development
-- snapshots. Rules and presentation modules keep ownership of their fields;
-- this module owns the token format both use.

type Reader = { tokens: {string}, index: i32, ok: bool, collection_limit: i32 }

function append_i32(parts: {string}, value: i32): unit
    table.insert(parts, tostring(value))
end

-- An enum-like field: a literal union member (or nominal enum) boxed into
-- `unknown`. How such a value is spelled in the token stream is this module's
-- business, not the serializing module's. Tokens are comma-joined, so the
-- rendered member must not contain the separator — member spellings satisfy
-- this by construction.
function append_enum(parts: {string}, value: unknown): unit
    local token: string = tostring(value)
    assert(string.find(token, ",") == nil)
    table.insert(parts, token)
end

function append_bool(parts: {string}, value: bool): unit
    if value then table.insert(parts, "1") else table.insert(parts, "0") end
end

function append_f64(parts: {string}, value: f64): unit
    table.insert(parts, tostring(value))
end

function append_indices(parts: {string}, values: {i32}): unit
    append_i32(parts, #values)
    for value in values do append_i32(parts, value) end
end

function append_f64s(parts: {string}, values: {f64}): unit
    append_i32(parts, #values)
    for value in values do append_f64(parts, value) end
end

function reader(value: string, collection_limit: i32): Reader
    return {
        tokens = string.split(value, ","),
        index = 0,
        ok = true,
        collection_limit = collection_limit,
    }
end

function Reader:next_string(): string
    if not self.ok or self.index >= #self.tokens then
        self.ok = false
        return ""
    end
    local value: string = self.tokens[self.index]
    self.index += 1
    return value
end

function Reader:next_f64(): f64
    local text: string = self:next_string()
    if not self.ok then return 0.0 end
    local parsed: f64? = tonumber(text)
    if parsed == nil then
        self.ok = false
        return 0.0
    end
    return parsed::f64
end

function Reader:next_i32(): i32
    local decimal: f64 = self:next_f64()
    local value: i32 = decimal::i32
    if self.ok and (value::f64) ~= decimal then self.ok = false end
    return value
end

function Reader:next_bool(): bool
    local value: i32 = self:next_i32()
    if not self.ok then return false end
    if value == 1 then return true end
    if value ~= 0 then self.ok = false end
    return false
end

function Reader:next_length(): i32
    local length: i32 = self:next_i32()
    if length < 0 or length > self.collection_limit then
        self.ok = false
        return 0
    end
    return length
end

function Reader:next_indices(): {i32}
    local values: {i32} = {}
    local length: i32 = self:next_length()
    for _ = 1, length do table.insert(values, self:next_i32()) end
    return values
end

function Reader:next_f64s(): {f64}
    local values: {f64} = {}
    local length: i32 = self:next_length()
    for _ = 1, length do table.insert(values, self:next_f64()) end
    return values
end

function Reader:complete(): bool
    return self.ok and self.index == #self.tokens
end

-- Hot replacement carries several independently versioned payloads: the live
-- screen marker plus one section per state module. Keeping the framing here
-- makes restore atomic without making any section understand the others'
-- schemas.
function frame(schema: string, sections: {string}): string
    local parts: {string} = { schema }
    for section in sections do table.insert(parts, section) end
    return table.concat(parts, "|")
end

-- Sections only when the value carries exactly `count` of them under `schema`.
-- A payload framed by a differently shaped build is a normal nil result, not an
-- error: the sections it holds are not the ones this build would restore.
function unframe(value: string, schema: string, count: i32): {string}?
    local sections: {string} = string.split(value, "|")
    if #sections ~= count + 1 or sections[0] ~= schema then return nil end
    local payloads: {string} = {}
    for index = 1::i32, count do table.insert(payloads, sections[index]) end
    return payloads
end

return {
    append_i32 = append_i32,
    append_enum = append_enum,
    append_bool = append_bool,
    append_f64 = append_f64,
    append_indices = append_indices,
    append_f64s = append_f64s,
    reader = reader,
    frame = frame,
    unframe = unframe,
}
