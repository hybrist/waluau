require("waluau:vitest")

local run_ = require("./run")
local shop_ = require("./shop_new")
local spell_ = require("./spells/spell")
local scroll_ = require("./items/scroll")
local item_ = require("./items/item")

type RunState = run_.State
type ShopState = shop_.State
type SpellKind = spell_.SpellKind
type SpellScroll = scroll_.SpellScroll
type Item = item_.Item

local function shopping_run(spell: SpellKind, gold: i32)
    local run = RunState.new(spell, false)
    run:settle(true, gold + run:target())

    local shop = ShopState.new(run)

    return run, shop
end

describe(
    "Shop",
    function()
        it(
            "opens on a full row of slots and a way into the duel",
            function()
                math.randomseed(101)
                local _, shop = shopping_run(SpellKind.Firebolt, 30)
                expect(shop.open):toBe(true)
                expect(shop.cursor):toBe(0)
                expect(#shop.slots):toBe(shop_.DEFAULT_SHOP_ITEM_COUNT)
            end
        )

        it(
            "marks a bought offer as sold",
            function()
                math.randomseed(109)
                local run, shop = shopping_run(SpellKind.Firebolt, 40)
                expect(shop:confirm_choice(run)):toBe(false)
                expect(run.gold):toBe(36)

                expect(shop.slots[0].sold):toBe(true)
            end
        )

        it(
            "stocks the next level for known spells and level one for new spells",
            function()
                math.randomseed(127)
                local run, shop = shopping_run(SpellKind.Firebolt, 40)
                expect(shop:confirm_choice(run)):toBe(false)
                if run:spell_count() == 1 then
                    expect(run.spells[0].level):toBe(2)
                else
                    expect(run:spell_count()):toBe(2)
                    expect(run.spells[0].level):toBe(1)
                    expect(run.spells[1].level):toBe(1)
                end
            end
        )

        it(
            "learns a new spell and upgrades a known one without losing its cast price",
            function()
                local run = RunState.new(SpellKind.Firebolt, false)
                expect(run:upgrade(0)):toBe(true)

                local learn: SpellScroll = SpellScroll.new(SpellKind.Clone, 1)
                expect(learn:can_use(run)):toBe(true)
                learn:use(run)
                expect(run.spells[1].kind):toBe(SpellKind.Clone)
                expect(run.spells[1].level):toBe(1)

                local upgrade: SpellScroll = SpellScroll.new(SpellKind.Firebolt, 2)
                expect(upgrade:can_use(run)):toBe(true)
                upgrade:use(run)
                expect(run.spells[0].level):toBe(2)
                expect(run.spells[0].cost):toBe(spell_.DEFAULT_SPELL_COST - 1)
            end
        )

        it(
            "refuses redundant upgrades and new spells when the loadout is full",
            function()
                local run = RunState.new(SpellKind.Firebolt, false)
                expect(run:learn(SpellKind.Clone, 1)):toBe(true)

                local same_level: SpellScroll = SpellScroll.new(SpellKind.Firebolt, 1)
                local new_spell: SpellScroll = SpellScroll.new(SpellKind.FreezeRay, 1)
                expect(same_level:can_use(run)):toBe(false)
                expect(new_spell:can_use(run)):toBe(false)

                local shop = ShopState.new(run)
                shop.slots = {
                    { item = same_level::Item, price = 4, sold = false },
                    { item = new_spell::Item, price = 4, sold = false }
                }
                local before_gold: i32 = run.gold
                expect(shop:confirm_choice(run)):toBe(false)
                expect(shop.slots[0].sold):toBe(false)
                expect(run.gold):toBe(before_gold)

                same_level:use(run)
                new_spell:use(run)
                expect(run.spells[0].level):toBe(1)
                expect(run:spell_count()):toBe(2)
                expect(run:carries(SpellKind.FreezeRay)):toBe(false)
            end
        )
    end
)
