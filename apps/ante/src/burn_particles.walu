-- Shared shader-backed ash and ember primitives. Card destruction and the
-- Firebolt carrier both use this module, so shader binding and deterministic
-- particle shapes have one implementation without coupling either caller to
-- the other's choreography.
local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local shader_program = require("./shader_program")
local card_burn_shader = require("./shaders/card-burn.frag")

type Graphics = engine.Graphics
local card_burn_program: shader_program.Program = shader_program.new(
    card_burn_shader,
    "card burn",
    false
)

function bind(graphics: Graphics, progress: f64, seed: i32, aspect: f64, particle_mode: f64): bool
    return card_burn_program:bind(
        graphics,
        {
            graphics_module.float_parameter("u_progress", progress),
            graphics_module.float_parameter("u_seed", seed::f64),
            graphics_module.float_parameter("u_aspect", aspect),
            graphics_module.float_parameter("u_particle_mode", particle_mode)
        }
    )
end

function use(graphics: Graphics, seed: i32, ember: bool): bool
    local kind: f64 = 0.0
    if ember then
        kind = 1.0
    end
    return bind(graphics, kind, seed, 1.0, 1.0)
end

function use_sheet(graphics: Graphics, progress: f64, seed: i32, aspect: f64): bool
    return bind(graphics, progress, seed, aspect, 0.0)
end

function stop(graphics: Graphics): unit
    graphics:use_default_shader()
end

-- A stable little hash keeps every fragment's path lively without consuming
-- gameplay randomness or changing from frame to frame.
function hash(id: i32, channel: f64): f64
    local wave: f64 = math.sin((id::f64) * 12.9898 + channel * 78.233) * 43758.5453
    return wave - math.floor(wave)
end

function alpha(progress: f64): string
    if progress < 0.42 then
        return "ff"
    end
    if progress < 0.68 then
        return "c0"
    end
    if progress < 0.84 then
        return "78"
    end
    return "30"
end

-- Particle quads are only carriers for the burn shader: its noisy alpha mask
-- cuts every side away before the fleck reaches the screen. The ellipse is a
-- shader-less fallback, so an optional-program failure never exposes a square
-- or a triangle in the fire.
function draw(
    graphics: Graphics,
    x: f64,
    y: f64,
    width: f64,
    height: f64,
    rotation: f64,
    color: string,
    shader_ok: bool
): unit
    graphics:push()
    graphics:translate(x, y)
    graphics:rotate(rotation)
    graphics:set_color(color)
    if shader_ok then
        graphics:fill_rectangle(-width * 0.5, -height * 0.5, width, height)
    else
        graphics:scale(width, height)
        graphics:fill_circle(0.0, 0.0, 0.5)
    end
    graphics:pop()
end

return { use = use, use_sheet = use_sheet, stop = stop, hash = hash, alpha = alpha, draw = draw }
