-- Intrinsic, DOM-free box layout for presentation code. Leaves bring their
-- own min/preferred/max measurements to this module; flows derive theirs from
-- their children, then solve the whole tree into the rectangles drawing, hit
-- testing, and animation can share.
--
-- Nothing here knows how a leaf is drawn or measured. A card can report the
-- size its renderer owns, text can report browser-derived font metrics, and a
-- test can use plain numbers. The seam stays between presentation meaning and
-- geometry rather than growing into a second renderer.
export type Rect = { x: f64, y: f64, width: f64, height: f64 }
export type Edges = { left: f64, top: f64, right: f64, bottom: f64 }
export type Intrinsic = {
    min_width: f64,
    preferred_width: f64,
    max_width: f64,
    min_height: f64,
    preferred_height: f64,
    max_height: f64,
    -- Distance down from the top edge. A negative value means this leaf has
    -- no meaningful text baseline.
    baseline: f64
}
export type Axis = "row" | "column"
export type Justify = "start" | "center" | "end" | "space-between"
export type Align = "start" | "center" | "end" | "stretch" | "baseline"
export type Style = { axis: Axis, gap: f64, justify: Justify, align: Align, padding: Edges }
export type Tree = {
    kind: "leaf" | "flow",
    key: i32,
    intrinsic: Intrinsic,
    children: {Tree},
    style: Style,
    grow: f64,
    shrink: f64
}
export type Frame = { key: i32, rect: Rect, baseline: f64 }
export type Result = { frames: {Frame}, content: Rect, overflow_x: f64, overflow_y: f64, overflowed: bool }
type Extents = { set: bool, left: f64, top: f64, right: f64, bottom: f64 }

-- Large enough to mean "no authored cap" for game-space geometry without
-- allowing infinities into distribution arithmetic.
const UNBOUNDED: f64 = 1000000000000.0
const EPSILON: f64 = 0.000001

const ZERO_INTRINSIC: Intrinsic = {
    min_width = 0.0,
    preferred_width = 0.0,
    max_width = 0.0,
    min_height = 0.0,
    preferred_height = 0.0,
    max_height = 0.0,
    baseline = -1.0
}

const LEAF_STYLE: Style = {
    axis = "row",
    gap = 0.0,
    justify = "start",
    align = "start",
    padding = { left = 0.0, top = 0.0, right = 0.0, bottom = 0.0 }
}

function valid_number(value: f64): bool
    return value == value and value >= -UNBOUNDED and value <= UNBOUNDED
end

function validate_intrinsic(value: Intrinsic): unit
    assert(valid_number(value.min_width) and value.min_width >= 0.0)
    assert(valid_number(value.preferred_width) and value.preferred_width >= value.min_width)
    assert(valid_number(value.max_width) and value.max_width >= value.preferred_width)
    assert(valid_number(value.min_height) and value.min_height >= 0.0)
    assert(valid_number(value.preferred_height) and value.preferred_height >= value.min_height)
    assert(valid_number(value.max_height) and value.max_height >= value.preferred_height)
    assert(valid_number(value.baseline))
    assert(value.baseline < 0.0 or value.baseline <= value.min_height)
end

function validate_edges(value: Edges): unit
    assert(valid_number(value.left) and value.left >= 0.0)
    assert(valid_number(value.top) and value.top >= 0.0)
    assert(valid_number(value.right) and value.right >= 0.0)
    assert(valid_number(value.bottom) and value.bottom >= 0.0)
end

function validate_style(value: Style): unit
    -- Negative gaps intentionally express overlap; flex pressure changes item
    -- sizes without silently changing that authored relationship.
    assert(valid_number(value.gap))
    assert(value.axis == "row" or value.align ~= "baseline")
    validate_edges(value.padding)
end

function Intrinsic.fixed(width: f64, height: f64): Intrinsic
    local value: Intrinsic = {
        min_width = width,
        preferred_width = width,
        max_width = width,
        min_height = height,
        preferred_height = height,
        max_height = height,
        baseline = -1.0
    }
    validate_intrinsic(value)
    return value
end

function Tree.leaf(key: i32, intrinsic: Intrinsic): Tree
    validate_intrinsic(intrinsic)
    return {
        kind = "leaf",
        key = key,
        intrinsic = intrinsic,
        children = {},
        style = LEAF_STYLE,
        grow = 0.0,
        shrink = 1.0
    }
end

function Tree.flow(key: i32, children: {Tree}, style: Style): Tree
    validate_style(style)
    local owned: {Tree} = {}
    for child in children do
        table.insert(owned, child)
    end
    return {
        kind = "flow",
        key = key,
        intrinsic = ZERO_INTRINSIC,
        children = owned,
        style = style,
        grow = 0.0,
        shrink = 1.0
    }
end

-- Flex factors belong to a node's relationship with its parent. Construction
-- is the only mutable phase; measure and solve never change the tree.
function Tree:flex(grow: f64, shrink: f64): Tree
    assert(valid_number(grow) and grow >= 0.0)
    assert(valid_number(shrink) and shrink >= 0.0)
    self.grow = grow
    self.shrink = shrink
    return self
end

function cap(value: f64): f64
    if value > UNBOUNDED then
        return UNBOUNDED
    end
    return value
end

function nonnegative(value: f64): f64
    if value < 0.0 then
        return 0.0
    end
    return value
end

function child_baseline(value: Intrinsic): f64
    if value.baseline >= 0.0 then
        return value.baseline
    end
    return value.preferred_height
end

function baseline_at_height(value: Intrinsic, height: f64): f64
    if value.baseline >= 0.0 then
        return value.baseline
    end
    return height
end

-- Bottom-up intrinsic measurement. A subtree is itself measurable content,
-- useful both to its parent flow and to callers choosing an available region.
function Tree:measure(): Intrinsic
    if self.kind == "leaf" then
        return self.intrinsic
    end

    local horizontal: bool = self.style.axis == "row"
    local min_main: f64 = 0.0
    local preferred_main: f64 = 0.0
    local max_main: f64 = 0.0
    local min_cross: f64 = 0.0
    local preferred_cross: f64 = 0.0
    local max_cross: f64 = 0.0
    local baseline: f64 = -1.0
    local min_ascent: f64 = 0.0
    local preferred_ascent: f64 = 0.0
    local max_ascent: f64 = 0.0
    local min_descent: f64 = 0.0
    local preferred_descent: f64 = 0.0
    local max_descent: f64 = 0.0

    for child in self.children do
        local child_tree: Tree = child
        local value: Intrinsic = child_tree:measure()
        if horizontal then
            min_main += value.min_width
            preferred_main += value.preferred_width
            max_main = cap(max_main + value.max_width)
            min_cross = math.max(min_cross, value.min_height)
            preferred_cross = math.max(preferred_cross, value.preferred_height)
            max_cross = math.max(max_cross, value.max_height)
            baseline = math.max(baseline, child_baseline(value))
            if self.style.align == "baseline" then
                local min_child_baseline: f64 = baseline_at_height(value, value.min_height)
                local preferred_child_baseline: f64 = child_baseline(value)
                local max_child_baseline: f64 = baseline_at_height(value, value.max_height)
                min_ascent = math.max(min_ascent, min_child_baseline)
                preferred_ascent = math.max(preferred_ascent, preferred_child_baseline)
                max_ascent = math.max(max_ascent, max_child_baseline)
                min_descent = math.max(min_descent, value.min_height - min_child_baseline)
                preferred_descent = math.max(
                    preferred_descent,
                    value.preferred_height - preferred_child_baseline
                )
                max_descent = math.max(max_descent, value.max_height - max_child_baseline)
            end
        else
            min_main += value.min_height
            preferred_main += value.preferred_height
            max_main = cap(max_main + value.max_height)
            min_cross = math.max(min_cross, value.min_width)
            preferred_cross = math.max(preferred_cross, value.preferred_width)
            max_cross = math.max(max_cross, value.max_width)
            if baseline < 0.0 then
                baseline = child_baseline(value)
            end
        end
    end

    if horizontal and self.style.align == "baseline" then
        min_cross = min_ascent + min_descent
        preferred_cross = preferred_ascent + preferred_descent
        max_cross = cap(max_ascent + max_descent)
        baseline = preferred_ascent
    end

    local gaps: f64 = 0.0
    if #self.children > 1 then
        gaps = self.style.gap * ((#self.children - 1)::f64)
    end
    min_main = nonnegative(min_main + gaps)
    preferred_main = math.max(min_main, preferred_main + gaps)
    max_main = math.max(preferred_main, cap(max_main + gaps))

    local padding_main: f64 = 0.0
    local padding_cross: f64 = 0.0
    if horizontal then
        padding_main = self.style.padding.left + self.style.padding.right
        padding_cross = self.style.padding.top + self.style.padding.bottom
    else
        padding_main = self.style.padding.top + self.style.padding.bottom
        padding_cross = self.style.padding.left + self.style.padding.right
    end
    min_main += padding_main
    preferred_main += padding_main
    max_main = cap(max_main + padding_main)
    min_cross += padding_cross
    preferred_cross += padding_cross
    max_cross = cap(max_cross + padding_cross)
    if baseline >= 0.0 then
        baseline += self.style.padding.top
    end

    if horizontal then
        return {
            min_width = min_main,
            preferred_width = preferred_main,
            max_width = max_main,
            min_height = min_cross,
            preferred_height = preferred_cross,
            max_height = max_cross,
            baseline = baseline
        }
    end
    return {
        min_width = min_cross,
        preferred_width = preferred_cross,
        max_width = max_cross,
        min_height = min_main,
        preferred_height = preferred_main,
        max_height = max_main,
        baseline = baseline
    }
end

function main_min(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.min_width
    end
    return value.min_height
end

function main_preferred(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.preferred_width
    end
    return value.preferred_height
end

function main_max(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.max_width
    end
    return value.max_height
end

function cross_min(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.min_height
    end
    return value.min_width
end

function cross_preferred(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.preferred_height
    end
    return value.preferred_width
end

function cross_max(value: Intrinsic, horizontal: bool): f64
    if horizontal then
        return value.max_height
    end
    return value.max_width
end

function clamp(value: f64, low: f64, high: f64): f64
    if value < low then
        return low
    end
    if value > high then
        return high
    end
    return value
end

function distribute_grow(
    children: {Tree},
    measurements: {Intrinsic},
    sizes: {f64},
    horizontal: bool,
    extra: f64
): f64
    local remaining: f64 = extra
    for _ = 1::i32, #children do
        local total_weight: f64 = 0.0
        for index = 0::i32, #children - 1 do
            local node: Tree = children[index]
            if node.grow > 0.0 and sizes[index] < main_max(
                measurements[index],
                horizontal
            ) - EPSILON then
                total_weight += node.grow
            end
        end
        if total_weight <= 0.0 then
            break
        end
        local spent: f64 = 0.0
        for index = 0::i32, #children - 1 do
            local node: Tree = children[index]
            if node.grow > 0.0 then
                local room: f64 = main_max(measurements[index], horizontal) - sizes[index]
                if room > EPSILON then
                    local share: f64 = remaining * node.grow / total_weight
                    local applied: f64 = math.min(room, share)
                    sizes[index] += applied
                    spent += applied
                end
            end
        end
        if spent <= EPSILON then
            break
        end
        remaining -= spent
        if remaining <= EPSILON then
            return 0.0
        end
    end
    return remaining
end

function distribute_shrink(
    children: {Tree},
    measurements: {Intrinsic},
    sizes: {f64},
    horizontal: bool,
    deficit: f64
): f64
    local remaining: f64 = deficit
    for _ = 1::i32, #children do
        local total_weight: f64 = 0.0
        for index = 0::i32, #children - 1 do
            local node: Tree = children[index]
            if node.shrink > 0.0 and sizes[index] > main_min(
                measurements[index],
                horizontal
            ) + EPSILON then
                total_weight += node.shrink * sizes[index]
            end
        end
        if total_weight <= 0.0 then
            break
        end
        local reduced: f64 = 0.0
        for index = 0::i32, #children - 1 do
            local node: Tree = children[index]
            local weight: f64 = node.shrink * sizes[index]
            if weight > 0.0 then
                local room: f64 = sizes[index] - main_min(measurements[index], horizontal)
                if room > EPSILON then
                    local share: f64 = remaining * weight / total_weight
                    local applied: f64 = math.min(room, share)
                    sizes[index] -= applied
                    reduced += applied
                end
            end
        end
        if reduced <= EPSILON then
            break
        end
        remaining -= reduced
        if remaining <= EPSILON then
            return 0.0
        end
    end
    return remaining
end

function include(extents: Extents, rect: Rect): unit
    local right: f64 = rect.x + rect.width
    local bottom: f64 = rect.y + rect.height
    if not extents.set then
        extents.set = true
        extents.left = rect.x
        extents.top = rect.y
        extents.right = right
        extents.bottom = bottom
        return
    end
    extents.left = math.min(extents.left, rect.x)
    extents.top = math.min(extents.top, rect.y)
    extents.right = math.max(extents.right, right)
    extents.bottom = math.max(extents.bottom, bottom)
end

function append_frame(frames: {Frame}, key: i32, rect: Rect, baseline: f64): unit
    if key < 0 then
        return
    end
    for item in frames do
        assert(item.key ~= key)
    end
    table.insert(frames, { key = key, rect = rect, baseline = baseline })
end

function arrange_node(node: Tree, bounds: Rect, frames: {Frame}, extents: Extents): unit
    local own_measure: Intrinsic = node:measure()
    include(extents, bounds)
    local absolute_baseline: f64 = -1.0
    if own_measure.baseline >= 0.0 then
        absolute_baseline = bounds.y + own_measure.baseline
    end
    append_frame(frames, node.key, bounds, absolute_baseline)
    if node.kind == "leaf" or #node.children == 0 then
        return
    end

    local horizontal: bool = node.style.axis == "row"
    local padding: Edges = node.style.padding
    local inner: Rect = {
        x = bounds.x + padding.left,
        y = bounds.y + padding.top,
        width = nonnegative(bounds.width - padding.left - padding.right),
        height = nonnegative(bounds.height - padding.top - padding.bottom)
    }
    local available_main: f64 = inner.width
    local available_cross: f64 = inner.height
    if not horizontal then
        available_main = inner.height
        available_cross = inner.width
    end

    local measurements: {Intrinsic} = {}
    local sizes: {f64} = {}
    local used: f64 = 0.0
    for child in node.children do
        local child_tree: Tree = child
        local value: Intrinsic = child_tree:measure()
        table.insert(measurements, value)
        local size: f64 = main_preferred(value, horizontal)
        table.insert(sizes, size)
        used += size
    end
    local gap: f64 = node.style.gap
    if #node.children > 1 then
        used += gap * ((#node.children - 1)::f64)
    end

    local free: f64 = available_main - used
    if free > EPSILON then
        free = distribute_grow(node.children, measurements, sizes, horizontal, free)
    elseif free < -EPSILON then
        local remaining: f64 = distribute_shrink(
            node.children,
            measurements,
            sizes,
            horizontal,
            -free
        )
        free = -remaining
    else
        free = 0.0
    end

    local offset: f64 = 0.0
    if node.style.justify == "center" then
        offset = free * 0.5
    elseif node.style.justify == "end" then
        offset = free
    elseif node.style.justify == "space-between" and free > 0.0 and #node.children > 1 then
        gap += free / ((#node.children - 1)::f64)
        free = 0.0
    end

    local row_baseline: f64 = 0.0
    if horizontal and node.style.align == "baseline" then
        for value in measurements do
            row_baseline = math.max(row_baseline, child_baseline(value))
        end
    end

    local cursor: f64 = offset
    for index = 0::i32, #node.children - 1 do
        local child: Tree = node.children[index]
        local value: Intrinsic = measurements[index]
        local child_cross: f64 = cross_preferred(value, horizontal)
        if node.style.align == "stretch" then
            child_cross = clamp(
                available_cross,
                cross_min(value, horizontal),
                cross_max(value, horizontal)
            )
        end
        local cross_offset: f64 = 0.0
        if node.style.align == "center" then
            cross_offset = (available_cross - child_cross) * 0.5
        elseif node.style.align == "end" then
            cross_offset = available_cross - child_cross
        elseif horizontal and node.style.align == "baseline" then
            cross_offset = row_baseline - child_baseline(value)
        end

        local child_rect: Rect = { x = 0.0, y = 0.0, width = 0.0, height = 0.0 }
        if horizontal then
            child_rect = {
                x = inner.x + cursor,
                y = inner.y + cross_offset,
                width = sizes[index],
                height = child_cross
            }
        else
            child_rect = {
                x = inner.x + cross_offset,
                y = inner.y + cursor,
                width = child_cross,
                height = sizes[index]
            }
        end
        arrange_node(child, child_rect, frames, extents)
        cursor += sizes[index] + gap
    end
end

function Tree:solve(bounds: Rect): Result
    assert(valid_number(bounds.x) and valid_number(bounds.y))
    assert(valid_number(bounds.width) and bounds.width >= 0.0)
    assert(valid_number(bounds.height) and bounds.height >= 0.0)
    local frames: {Frame} = {}
    local extents: Extents = { set = false, left = 0.0, top = 0.0, right = 0.0, bottom = 0.0 }
    arrange_node(self, bounds, frames, extents)
    local content: Rect = {
        x = extents.left,
        y = extents.top,
        width = extents.right - extents.left,
        height = extents.bottom - extents.top
    }
    local overflow_x: f64 = math.max(
        0.0,
        bounds.x - extents.left
    ) + math.max(0.0, extents.right - (bounds.x + bounds.width))
    local overflow_y: f64 = math.max(
        0.0,
        bounds.y - extents.top
    ) + math.max(0.0, extents.bottom - (bounds.y + bounds.height))
    return {
        frames = frames,
        content = content,
        overflow_x = overflow_x,
        overflow_y = overflow_y,
        overflowed = overflow_x > EPSILON or overflow_y > EPSILON
    }
end

function Result:frame(key: i32): Frame?
    for item in self.frames do
        if item.key == key then
            return item
        end
    end
    return nil
end

-- Frames are emitted in paint order: containers before descendants and
-- siblings in child order. Reverse lookup therefore gives overlapping content
-- the same winner drawing gives it.
function Result:hit(x: f64, y: f64): i32
    for index = #self.frames - 1, 0::i32, -1::i32 do
        local item: Frame = self.frames[index]
        local rect: Rect = item.rect
        if x >= rect.x and x <= rect.x + rect.width and y >= rect.y and y <= rect.y + rect.height then
            return item.key
        end
    end
    return -1
end

return {
    unbounded = UNBOUNDED
}
