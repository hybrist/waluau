-- The shop's screen: the intermission between two duels, drawn as one
-- cursor-driven list of offers in the duel's own panel chrome. The shop module
-- owns what the lines are and what they cost; this module owns where they sit,
-- which is also why the pointer's row lookup lives here.
--
-- The list stands on the city map, at the vendor the route has reached, and
-- keeps to a column so the map beside it can be read at the same time. Every
-- colour it draws goes through `alpha`: arriving at a shop and leaving one are
-- dissolves the map runs, and the offers travel with it.

local engine = require("waluau:engine")
local game = require("./game")
local ink = require("./ink")
local spell_launch = require("./spell_launch")
local run_module = require("./run")
local shop = require("./shop")
local layout = require("./layout")

-- The offers keep to a column down the left so the right of the screen stays
-- the city map: where the run has got to and which house is next are as much
-- of this screen as the prices are.
const PANEL_X: f64 = 44.0
const PANEL_W: f64 = 540.0
const PANEL_CENTER: f64 = 314.0

const ROW_X: f64 = 76.0
const ROW_W: f64 = 476.0
const ROW_H: f64 = 54.0
const ROW_PITCH: f64 = 64.0

-- The panel opens a share of the live height down the screen, and its header
-- — title, subtitle, and the gold readout — takes a fixed band before the
-- first offer line.
const PANEL_TOP_SHARE: f64 = 0.1133333333
const PANEL_HEADER_H: f64 = 128.0

function panel_top(viewport: layout.State): f64
    return viewport.height * PANEL_TOP_SHARE
end

function row_top(viewport: layout.State, index: i32): f64
    return panel_top(viewport) + PANEL_HEADER_H + (index::f64) * ROW_PITCH
end

-- The offer line under a point, or -1. The gaps between lines are dead space,
-- so a pointer between two offers leaves the cursor on whichever it was.
function row_at(viewport: layout.State, x: f64, y: f64, count: i32): i32
    if x < ROW_X or x > ROW_X + ROW_W then return -1 end
    for index = 0::i32, count - 1 do
        local top: f64 = row_top(viewport, index)
        if y >= top and y <= top + ROW_H then return index end
    end
    return -1
end

-- What one line says on its left. Prices are the right-hand column, so nothing
-- here repeats them. A spent line drops the detail it used to carry: the numbers
-- it quoted were the ones it has already changed.
function row_label(row: shop.Row, run: run_module.State, offer: i32): string
    if row.action == shop.action_sharpen then
        local name: string = spell_launch.name(row.kind)
        if row.sold then return "UPGRADED " .. name end
        -- The spell an offer named can leave the loadout: the other offer of the
        -- same visit may have traded it away.
        if row.slot < 0 then return "UPGRADE " .. name .. "   TRADED AWAY" end
        local spell: game.Spell = run.spells[row.slot]
        if not run:can_sharpen(row.slot) then
            return "UPGRADE " .. name .. "   AS CHEAP AS IT GETS"
        end
        return "UPGRADE " .. name
            .. "   USE " .. tostring(spell.cost)
            .. " TO " .. tostring(spell.cost - 1) .. " GOLD"
    end
    if row.action == shop.action_learn then
        local name: string = spell_launch.name(row.kind)
        if row.sold then
            return "LEARNED " .. name
                .. "   KEY " .. tostring(run:slot_of(row.kind) + 1)
        end
        if row.slot < 0 then
            return "LEARN " .. name .. "   TRADES A SPELL AWAY"
        end
        return "LEARN " .. name .. "   KEY " .. tostring(row.slot + 1)
    end
    if row.action == shop.action_replace then
        return "TRADE " .. spell_launch.name(row.kind)
            .. " FOR " .. spell_launch.name(offer)
    end
    if row.action == shop.action_cancel then return "KEEP BOTH SPELLS" end
    local duel: string = "ENTER DUEL " .. tostring(run.duel)
    if run:boss() then duel = duel .. "   CHALLENGE" end
    return duel .. "   TARGET " .. tostring(run:target())
end

-- Idle ink: an offer about a spell wears that spell's colour the way the menu's
-- selection list does, and a line the purse cannot cover goes dark whether it
-- names a spell or not.
function row_ink(row: shop.Row): string
    if not row.available then return "#52525b" end
    if row.kind ~= 0 then return spell_launch.color(row.kind) end
    return "#d4d4d8"
end

function draw_row(
    graphics: engine.Graphics,
    viewport: layout.State,
    row: shop.Row,
    label: string,
    index: i32,
    focused: bool,
    alpha: f64
): unit
    local top: f64 = row_top(viewport, index)
    local edge: string = "#3f3f46"
    local tone: string = row_ink(row)
    local price_ink: string = "#52525b"
    if row.available and row.price > 0 then price_ink = "#fbbf24" end
    if focused then
        edge = "#fbbf24"
        if row.available then tone = "#fbbf24" end
    end
    ink.panel(
        graphics, ROW_X, top, ROW_W, ROW_H,
        ink.fade("#17171c", alpha), ink.fade(edge, alpha))
    ink.text(
        graphics, label, ROW_X + 22.0, top + 33.0, 13, ink.fade(tone, alpha))
    -- A bought line keeps its place with its price struck off: the stock of a
    -- visit is two offers, and one of them is now spent.
    if row.sold then
        ink.text_right(
            graphics, "SOLD", ROW_X + ROW_W - 22.0, top + 33.0, 13,
            ink.fade("#52525b", alpha))
    elseif row.price > 0 then
        ink.text_right(
            graphics, tostring(row.price) .. " GOLD",
            ROW_X + ROW_W - 22.0, top + 33.0, 13, ink.fade(price_ink, alpha))
    end
end

-- `run` is read only here: every purchase has already been applied by the time
-- a frame is drawn, so this module never asks the run to change. The backdrop
-- is the city map the entry module has already drawn, so the panel is laid over
-- the street the vendor is standing on rather than over a board.
function draw(
    state: shop.State,
    run: run_module.State,
    viewport: layout.State,
    graphics: engine.Graphics,
    alpha: f64
): unit
    if alpha <= 0.0 then return end
    local panel_y: f64 = panel_top(viewport)
    local panel_h: f64 = viewport.height - panel_y - 56.0
    local choosing: bool = shop.choosing(state)
    ink.panel(
        graphics, PANEL_X, panel_y, PANEL_W, panel_h,
        ink.fade("#09090b", alpha * 0.94), ink.fade("#a1a1aa", alpha))
    ink.text(graphics, "THE SHOP", 78.0, panel_y + 49.0, 24, ink.fade("#fbbf24", alpha))
    local subtitle: string = "GOLD SPENT HERE WILL NOT ENTER DUEL " .. tostring(run.duel)
    local offered: i32 = 0
    if choosing then
        offered = state.offers[state.pending].kind
        subtitle = "ONLY TWO SPELLS TRAVEL AT ONCE. WHICH ONE GOES?"
    end
    ink.text(graphics, subtitle, 78.0, panel_y + 77.0, 11, ink.fade("#a1a1aa", alpha))
    ink.text_right(
        graphics, tostring(run.gold), 550.0, panel_y + 54.0, 24, ink.fade("#67e8f9", alpha))
    ink.text_right(
        graphics, "GOLD ON HAND", 550.0, panel_y + 77.0, 9, ink.fade("#155e75", alpha))
    -- What the duel beyond this list will cost to walk out of, under the purse
    -- it will be paid from. The shop informs rather than refuses — the target is
    -- charged on the way out and there is a whole duel in between to earn it —
    -- but it cannot inform once the gold is already spent.
    ink.text_right(
        graphics, "TARGET " .. tostring(run:target()) .. " TO CLEAR IT",
        550.0, panel_y + 95.0, 9, ink.fade("#b45309", alpha))

    local rows: {shop.Row} = shop.rows(state, run)
    for index, row in rows do
        draw_row(
            graphics, viewport, row, row_label(row, run, offered),
            index, index == state.cursor, alpha)
    end
    if not choosing then
        -- Two offers are the whole stock of a visit, so say what the list is
        -- rather than leaving the player waiting for it to refill.
        ink.text_centered(
            graphics, "TWO OFFERS PER VISIT. THE NEXT SHOP HAS ITS OWN",
            PANEL_CENTER, row_top(viewport, #rows) + 33.0, 11, ink.fade("#8a8a92", alpha))
    end
    ink.text_centered(
        graphics, "ARROWS MOVE   ENTER OR CLICK BUYS   ESC ENTERS THE DUEL",
        PANEL_CENTER, viewport.height - 34.0, 11, ink.fade("#a1a1aa", alpha))
end

return {
    draw = draw,
    row_at = row_at,
}
