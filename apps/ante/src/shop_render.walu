-- The shop's retained screen tree. Three stable row nodes cover both the
-- ordinary two-offer list plus exit and the modal trade-choice list. Presenting
-- refreshes their row data and availability; geometry, focus, hover, and click
-- routing remain owned here instead of being duplicated in the game screen.

local game = require("./game")
local ink = require("./ink")
local spell_launch = require("./spell_launch")
local run_module = require("./run")
local shop = require("./shop")
local spells = require("./spells/spell")
local viewport_layout = require("./layout")
local ui = require("./ui/node")
local ui_layout = require("./ui/layout")
local interaction = require("./ui/interaction")

const PANEL_X: f64 = 44.0
const PANEL_W: f64 = 540.0
const PANEL_CENTER: f64 = 314.0
const ROW_X: f64 = 76.0
const ROW_W: f64 = 476.0
const ROW_H: f64 = 54.0
const ROW_PITCH: f64 = 64.0
const PANEL_TOP_SHARE: f64 = 0.1133333333
const PANEL_HEADER_H: f64 = 128.0
const ROW_CAPACITY: i32 = 3

export type FenceAction = shop.ShopResult
type Presentation = {
    state: shop.State,
    run: run_module.State,
    viewport: viewport_layout.State,
    rows: {shop.Row},
    alpha: f64,
    pending_action: FenceAction,
}
export type View = {
    presentation: Presentation,
    root: ui.Node,
    list: ui.Node,
    row_nodes: {ui.Node},
    router: interaction.Router,
    scope: i32,
    targets: {interaction.Target},
}

function panel_top(viewport: viewport_layout.State): f64
    return viewport.height * PANEL_TOP_SHARE
end

function list_style(viewport: viewport_layout.State): ui_layout.Style
    return ui_layout.style(
        "column", ROW_PITCH - ROW_H, "start", "start",
        ui_layout.edges(ROW_X, panel_top(viewport) + PANEL_HEADER_H, 0.0, 0.0))
end

function goods_label(goods: shop.Goods, sold: bool, run: run_module.State): string
    if Upgrade(upgrade) = goods then
        local name: string = spell_launch.name(upgrade.kind)
        if sold then return "UPGRADED " .. name end
        local key: i32 = run:slot_of(upgrade.kind)
        if key < 0 then return "UPGRADE " .. name .. "   TRADED AWAY" end
        if not run:can_sharpen(key) then
            return "UPGRADE " .. name .. "   AS CHEAP AS IT GETS"
        end
        local spell: game.Spell = run.spells[key]
        return "UPGRADE " .. name
            .. "   USE " .. tostring(spell.cost)
            .. " TO " .. tostring(spell.cost - 1) .. " GOLD"
    end
    if Spell(offered) = goods then
        local name: string = spell_launch.name(offered.kind)
        if sold then
            return "LEARNED " .. name
                .. "   KEY " .. tostring(run:slot_of(offered.kind) + 1)
        end
        local key: i32 = run:open_slot()
        if key < 0 then return "LEARN " .. name .. "   TRADES A SPELL AWAY" end
        return "LEARN " .. name .. "   KEY " .. tostring(key + 1)
    end
    return ""
end

function row_label(
    state: shop.State, row: shop.Row, run: run_module.State,
    offered: spells.SpellKind?
): string
    if row.kind == "sale" then
        local slot: shop.Slot = state.slots[row.slot]
        return goods_label(slot.goods, row.sold, run)
    end
    if row.kind == "choice" then
        local carried: spells.SpellKind? = row.spell
        if carried == nil then return "" end
        if offered == nil then return "" end
        local old_kind: spells.SpellKind = carried::spells.SpellKind
        local new_kind: spells.SpellKind = offered::spells.SpellKind
        return "TRADE " .. spell_launch.name(old_kind)
            .. " FOR " .. spell_launch.name(new_kind)
    end
    if row.kind == "cancel" then return "KEEP BOTH SPELLS" end
    local duel: string = "ENTER DUEL " .. tostring(run.duel)
    if run:boss() then duel ..= "   CHALLENGE" end
    return duel .. "   TARGET " .. tostring(run:target())
end

function row_ink(row: shop.Row): string
    if not row.available then return "#52525b" end
    if row.spell ~= nil then return spell_launch.color(row.spell::spells.SpellKind) end
    return "#d4d4d8"
end

function draw_row(
    presentation: Presentation,
    surface: ui.Surface,
    bounds: ui_layout.Rect,
    index: i32
): unit
    if presentation.alpha <= 0.0 or index >= #presentation.rows then return end
    local row: shop.Row = presentation.rows[index]
    local graphics = surface.graphics
    local alpha: f64 = presentation.alpha
    local edge: string = "#3f3f46"
    local tone: string = row_ink(row)
    local price_ink: string = "#52525b"
    if row.available and row.price > 0 then price_ink = "#fbbf24" end
    if index == presentation.state.cursor then
        edge = "#fbbf24"
        if row.available then tone = "#fbbf24" end
    end
    ink.panel(
        graphics, bounds.x, bounds.y, bounds.width, bounds.height,
        ink.fade("#17171c", alpha), ink.fade(edge, alpha))
    ink.text(
        graphics,
        row_label(
            presentation.state, row, presentation.run,
            presentation.state:pending_spell()),
        bounds.x + 22.0, bounds.y + 33.0, 13, ink.fade(tone, alpha))
    if row.sold then
        ink.text_right(
            graphics, "SOLD", bounds.x + bounds.width - 22.0, bounds.y + 33.0,
            13, ink.fade("#52525b", alpha))
    elseif row.price > 0 then
        ink.text_right(
            graphics, tostring(row.price) .. " GOLD",
            bounds.x + bounds.width - 22.0, bounds.y + 33.0,
            13, ink.fade(price_ink, alpha))
    end
end

function draw_chrome(
    presentation: Presentation, surface: ui.Surface, bounds: ui_layout.Rect
): unit
    local alpha: f64 = presentation.alpha
    if alpha <= 0.0 then return end
    local viewport: viewport_layout.State = presentation.viewport
    local state: shop.State = presentation.state
    local run: run_module.State = presentation.run
    local graphics = surface.graphics
    local panel_y: f64 = panel_top(viewport)
    local panel_h: f64 = viewport.height - panel_y - 56.0
    local choosing: bool = state:choosing()
    ink.panel(
        graphics, PANEL_X, panel_y, PANEL_W, panel_h,
        ink.fade("#09090b", alpha * 0.94), ink.fade("#a1a1aa", alpha))
    ink.text(graphics, "THE SHOP", 78.0, panel_y + 49.0, 24, ink.fade("#fbbf24", alpha))
    local subtitle: string = "GOLD SPENT HERE WILL NOT ENTER DUEL " .. tostring(run.duel)
    if choosing then subtitle = "ONLY TWO SPELLS TRAVEL AT ONCE. WHICH ONE GOES?" end
    ink.text(graphics, subtitle, 78.0, panel_y + 77.0, 11, ink.fade("#a1a1aa", alpha))
    ink.text_right(
        graphics, tostring(run.gold), 550.0, panel_y + 54.0, 24, ink.fade("#67e8f9", alpha))
    ink.text_right(
        graphics, "GOLD ON HAND", 550.0, panel_y + 77.0, 9, ink.fade("#155e75", alpha))
    ink.text_right(
        graphics, "TARGET " .. tostring(run:target()) .. " TO CLEAR IT",
        550.0, panel_y + 95.0, 9, ink.fade("#b45309", alpha))
    if not choosing then
        ink.text_centered(
            graphics, "TWO OFFERS PER VISIT. THE NEXT SHOP HAS ITS OWN",
            PANEL_CENTER,
            panel_y + PANEL_HEADER_H + (#presentation.rows::f64) * ROW_PITCH + 33.0,
            11, ink.fade("#8a8a92", alpha))
    end
    ink.text_centered(
        graphics, "ARROWS MOVE   ENTER OR CLICK BUYS   ESC ENTERS THE DUEL",
        PANEL_CENTER, viewport.height - 34.0, 11, ink.fade("#a1a1aa", alpha))
end

function row_handlers(
    presentation: Presentation, index: i32
): interaction.Handlers
    local callbacks: interaction.Handlers = interaction.handlers()
    callbacks.on_focus = function(): unit presentation.state.cursor = index end
    callbacks.on_activate = function(): unit
        presentation.state.cursor = index
        presentation.pending_action = presentation.state:activate(presentation.run)
    end
    return callbacks
end

function View.new(state: shop.State, run: run_module.State): View
    local presentation: Presentation = {
        state = state,
        run = run,
        viewport = viewport_layout.current(),
        rows = {},
        alpha = 0.0,
        pending_action = "stay",
    }
    local rows: {ui.Node} = {}
    for index = 0::i32, ROW_CAPACITY - 1 do
        table.insert(rows, ui.Node.sized(ROW_W, ROW_H,
            function(surface: ui.Surface, bounds: ui_layout.Rect): unit
                draw_row(presentation, surface, bounds, index)
            end))
    end
    local chrome: ui.Node = ui.Node.measured(
        function(graphics: ui.Graphics?, into: ui_layout.Intrinsic): unit end,
        function(surface: ui.Surface, bounds: ui_layout.Rect): unit
            draw_chrome(presentation, surface, bounds)
        end)
    local list: ui.Node = ui.Node.flow(rows, list_style(presentation.viewport))
    local root: ui.Node = ui.Node.layer({ chrome, list })
    local router: interaction.Router = interaction.Router.new(root)
    local scope: i32 = router:add_scope("column", true)
    local targets: {interaction.Target} = {}
    for index, node in rows do
        table.insert(targets,
            router:add(node, scope, true, row_handlers(presentation, index)))
    end
    router:activate_scope(scope)
    return {
        presentation = presentation,
        root = root,
        list = list,
        row_nodes = rows,
        router = router,
        scope = scope,
        targets = targets,
    }
end

function View:sync(): unit
    local presentation: Presentation = self.presentation
    presentation.rows = presentation.state:rows(presentation.run)
    assert(#presentation.rows <= ROW_CAPACITY)
    for index, target in self.targets do
        target:set_visible(index < #presentation.rows)
    end
    if #presentation.rows == 0 then
        self.router:clear_focus()
        return
    end
    if presentation.state.cursor < 0 or presentation.state.cursor >= #presentation.rows then
        presentation.state.cursor = 0
    end
    self.router:focus(self.targets[presentation.state.cursor].key)
end

function View:take_action(): FenceAction
    local action: FenceAction = self.presentation.pending_action
    self.presentation.pending_action = "stay"
    return action
end

function View:draw(viewport: viewport_layout.State, surface: ui.Surface, alpha: f64): unit
    self.presentation.viewport = viewport
    self.presentation.alpha = alpha
    self.list:present_style(list_style(viewport))
    self:sync()
    self.root:draw(surface, 0.0, 0.0, viewport.width, viewport.height)
end

function View:keypressed(key: string): FenceAction
    self:sync()
    if key == "Escape" then
        if self.presentation.state:choosing() then
            self.presentation.state:cancel()
            self:sync()
            return "stay"
        end
        return "leave"
    end
    local routed: string = key
    if key == "w" or key == "W" then routed = "ArrowUp" end
    if key == "s" or key == "S" then routed = "ArrowDown" end
    self.router:key_pressed(routed)
    self:sync()
    return self:take_action()
end

function View:mousemoved(x: f64, y: f64): unit
    local hit: i32 = self.router:pointer_move(x, y)
    if hit >= 0 then self.router:focus(hit) end
end

function View:mousepressed(x: f64, y: f64, button: i32): unit
    if button ~= 1 then return end
    self.router:pointer_down(x, y, button)
end

function View:mousereleased(x: f64, y: f64, button: i32): FenceAction
    if button ~= 1 then return "stay" end
    self.router:pointer_up(x, y, button)
    self:sync()
    return self:take_action()
end

function View:pointer_leave(): unit
    self.router:pointer_leave()
end

return {
    row_label = row_label,
    row_ink = row_ink,
}
