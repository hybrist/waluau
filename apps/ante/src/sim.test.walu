-- Deterministic, DOM-free checks for Duel Magic.

require("waluau:vitest")

local game = require("./game")
local game_fixture = require("../test/game_fixture")
local run = require("./run")
local flow = require("./flow")
local snapshot_data = require("./snapshot")

const FIRST_ROUND: i32 = 1
const LAST_ROUND: i32 = 5

local function card(rank: i32, suit: i32): game.Card
    return { rank = rank, suit = suit }
end

-- The loadout a duel that is not about spells is dealt: the one spell a fresh
-- run sets out with, at full price.
local function starter_loadout(): {game.Spell}
    return { game.new_spell(game.spell_firebolt) }
end

local function loadout_of(kind: i32): {game.Spell}
    return { game.new_spell(kind) }
end

local function force_player_win(state: game.State): unit
    game_fixture.arrange_breach(
        state,
        { card(10, 0), card(11, 0), card(12, 0) },
        { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) },
        { card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2) }
    )
end

local function force_computer_win(state: game.State): unit
    game_fixture.arrange_breach(
        state,
        { card(10, 0), card(11, 0), card(12, 0) },
        { card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2) },
        { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
    )
end

local function force_stalemate(state: game.State): unit
    game_fixture.arrange_breach(
        state,
        { card(7, 3), card(2, 3), card(8, 2) },
        { card(13, 0), card(13, 1), card(4, 0), card(5, 1), card(6, 0) },
        { card(13, 2), card(13, 3), card(4, 2), card(5, 3), card(6, 2) }
    )
end

describe("Duel Magic scoring", function()
    it("orders every five-card hand category", function()
        local straight_flush: i32 = game.rank_five({ card(10, 3), card(11, 3), card(12, 3), card(13, 3), card(14, 3) })
        local four_kind: i32 = game.rank_five({ card(9, 0), card(9, 1), card(9, 2), card(9, 3), card(2, 0) })
        local full_house: i32 = game.rank_five({ card(8, 0), card(8, 1), card(8, 2), card(4, 0), card(4, 1) })
        local flush: i32 = game.rank_five({ card(14, 2), card(10, 2), card(7, 2), card(5, 2), card(2, 2) })
        local straight: i32 = game.rank_five({ card(9, 0), card(8, 1), card(7, 2), card(6, 3), card(5, 0) })
        local three_kind: i32 = game.rank_five({ card(7, 0), card(7, 1), card(7, 2), card(12, 3), card(2, 0) })
        local two_pair: i32 = game.rank_five({ card(14, 0), card(14, 1), card(3, 0), card(3, 1), card(8, 2) })
        local one_pair: i32 = game.rank_five({ card(13, 0), card(13, 1), card(10, 0), card(6, 1), card(2, 2) })
        local high_card: i32 = game.rank_five({ card(14, 0), card(11, 1), card(8, 0), card(5, 1), card(2, 2) })

        expect(straight_flush):toBeGreaterThan(four_kind)
        expect(four_kind):toBeGreaterThan(full_house)
        expect(full_house):toBeGreaterThan(flush)
        expect(flush):toBeGreaterThan(straight)
        expect(straight):toBeGreaterThan(three_kind)
        expect(three_kind):toBeGreaterThan(two_pair)
        expect(two_pair):toBeGreaterThan(one_pair)
        expect(one_pair):toBeGreaterThan(high_card)
    end)

    it("marks the made hand and only tie-breaking kickers", function()
        local winning_pair_cards: {game.Card} = { card(13, 0), card(13, 1), card(14, 2), card(7, 3), card(4, 0) }
        local losing_pair_cards: {game.Card} = { card(13, 2), card(13, 3), card(12, 0), card(7, 1), card(4, 2) }
        local winning_pair_value: i32 = game.rank_five(winning_pair_cards)
        local losing_pair_value: i32 = game.rank_five(losing_pair_cards)
        local pair_marks: {bool} = game.scoring_cards(winning_pair_cards, winning_pair_value, losing_pair_value)
        local lower_pair_value: i32 = game.rank_five({ card(12, 1), card(12, 2), card(14, 3), card(9, 0), card(8, 1) })
        local made_pair_marks: {bool} = game.scoring_cards(winning_pair_cards, winning_pair_value, lower_pair_value)
        local formation_marks: {bool} = game.formation_cards(winning_pair_cards, winning_pair_value)

        expect(pair_marks[0]):toBe(true)
        expect(pair_marks[1]):toBe(true)
        expect(pair_marks[2]):toBe(true)
        expect(pair_marks[3]):toBe(false)
        expect(pair_marks[4]):toBe(false)
        expect(made_pair_marks[0]):toBe(true)
        expect(made_pair_marks[1]):toBe(true)
        expect(made_pair_marks[2]):toBe(false)
        expect(made_pair_marks[3]):toBe(false)
        expect(made_pair_marks[4]):toBe(false)
        expect(formation_marks[0]):toBe(true)
        expect(formation_marks[1]):toBe(true)
        expect(formation_marks[2]):toBe(false)
        expect(formation_marks[3]):toBe(false)
        expect(formation_marks[4]):toBe(false)
    end)

    it("treats the wheel as a five-high straight", function()
        local wheel: i32 = game.rank_five({ card(14, 0), card(2, 1), card(3, 2), card(4, 3), card(5, 0) })
        local six_high: i32 = game.rank_five({ card(2, 0), card(3, 1), card(4, 2), card(5, 3), card(6, 0) })

        expect(six_high):toBeGreaterThan(wheel)
    end)

    it("ranks three-card bids and resolves their priority", function()
        local three_straight_flush: i32 = game.rank_three({ card(10, 2), card(11, 2), card(12, 2) })
        local three_kind: i32 = game.rank_three({ card(8, 0), card(8, 1), card(8, 2) })
        local three_straight: i32 = game.rank_three({ card(4, 0), card(5, 1), card(6, 2) })
        local three_flush: i32 = game.rank_three({ card(14, 3), card(9, 3), card(3, 3) })
        local three_pair: i32 = game.rank_three({ card(7, 0), card(7, 1), card(2, 2) })

        expect(three_straight_flush):toBeGreaterThan(three_kind)
        expect(three_kind):toBeGreaterThan(three_straight)
        expect(three_straight):toBeGreaterThan(three_flush)
        expect(three_flush):toBeGreaterThan(three_pair)
        expect(game.swap_priority(3, three_pair, 2, three_straight_flush)):toBe(1)
        expect(game.swap_priority(2, three_straight, 2, three_pair)):toBe(1)
        expect(game.swap_priority(2, three_pair, 2, three_straight)):toBe(-1)
    end)
end)

describe("Duel Magic swaps", function()
    it("exchanges a winning proposal once without consuming the deck", function()
        math.randomseed(7)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        game_fixture.arrange_arch_mage(
            state,
            { card(10, 0), card(11, 0), card(12, 0) },
            { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
        )
        state:play(0, 1)
        expect(#game.view(state).history):toBe(0)
        local old_hand = game.view(state).player_hand[0].card
        local old_middle = game.view(state).middle[0]
        local old_deck_size: i32 = game.view(state).deck_count
        local outcome: game.SwapOutcome? = state:resolve_swap({ 0 }, { 0 })
        assert(outcome ~= nil)
        local won_feint: game.SwapOutcome = outcome::game.SwapOutcome
        local outcome_winner: i32 = won_feint.winner
        local outcome_hand_count: i32 = #won_feint.hand_indices
        local outcome_hand_index: i32 = won_feint.hand_indices[0]
        local outcome_middle_count: i32 = #won_feint.middle_indices
        local outcome_middle_index: i32 = won_feint.middle_indices[0]
        local outcome_outgoing_rank: i32 = won_feint.outgoing[0].rank
        local outcome_incoming_rank: i32 = won_feint.incoming[0].rank

        expect(game.view(state).swap_open):toBe(false)
        expect(outcome_winner):toBe(1)
        expect(outcome_hand_count):toBe(1)
        expect(outcome_hand_index):toBe(0)
        expect(outcome_middle_count):toBe(1)
        expect(outcome_middle_index):toBe(0)
        expect(outcome_outgoing_rank):toBe(old_hand.rank)
        expect(outcome_incoming_rank):toBe(old_middle.rank)
        expect(game.view(state).swap_winner):toBe(1)
        expect(game.view(state).swap_count):toBe(1)
        expect(#game.view(state).swap_hand_indices):toBe(1)
        expect(game.view(state).swap_hand_indices[0]):toBe(0)
        expect(#game.view(state).swap_middle_indices):toBe(1)
        expect(game.view(state).swap_middle_indices[0]):toBe(0)
        expect(game.view(state).player_points):toBe(9)
        expect(game.view(state).pot):toBe(1)
        expect(game.view(state).player_hand[0].card.rank):toBe(old_middle.rank)
        expect(game.view(state).player_hand[0].card.suit):toBe(old_middle.suit)
        expect(game.view(state).middle[0].rank):toBe(old_hand.rank)
        expect(game.view(state).middle[0].suit):toBe(old_hand.suit)
        expect(game.view(state).deck_count):toBe(old_deck_size)
        local visible_deck_count: i32 = game.view(state).deck_count
        expect(visible_deck_count):toBe(old_deck_size)
        expect(game.view(state).player_hand[0].known):toBe(true)
        expect(game.view(state).player_hand[1].known):toBe(false)
        expect(game.view(state).player_hand[2].known):toBe(false)
        expect(game.view(state).player_hand[3].known):toBe(false)
        expect(game.view(state).player_hand[4].known):toBe(false)
        for i = 0::i32, 4::i32 do expect(game.view(state).computer_hand[i].known):toBe(false) end

        state:resolve_swap({ 1 }, { 1 })
        expect(game.view(state).player_wager):toBe(1)
        expect(game.view(state).swap_count):toBe(1)
    end)

    it("re-packs watched marks with the hand after a trick", function()
        math.randomseed(46)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        game_fixture.arrange_arch_mage(
            state,
            { card(10, 0), card(11, 0), card(12, 0) },
            { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
        )
        local marked_card = game.view(state).middle[0]
        state:resolve_swap({ 3 }, { 0 })
        expect(game.view(state).swap_winner):toBe(1)
        expect(game.view(state).player_hand[3].known):toBe(true)
        local played: game.Trick? = state:play(0, 1)
        assert(played ~= nil)

        expect(#game.view(state).player_hand):toBe(5)
        expect(#game.view(state).player_hand):toBe(5)
        local trick = game.view(state).history[0]
        local played_round: i32 = (played::game.Trick).round
        expect(played_round):toBe(trick.round)
        expect(trick.player_hand[3].known):toBe(true)
        expect(trick.player_hand[1].known):toBe(false)
        expect(trick.player_hand[3].card.rank):toBe(marked_card.rank)
        expect(trick.player_hand[3].card.suit):toBe(marked_card.suit)
        expect(game.view(state).player_hand[1].known):toBe(true)
        expect(game.view(state).player_hand[0].known):toBe(false)
        expect(game.view(state).player_hand[1].card.rank):toBe(marked_card.rank)
        expect(game.view(state).player_hand[1].card.suit):toBe(marked_card.suit)
        expect(game.view(state).player_hand[2].known):toBe(false)
        expect(game.view(state).player_hand[3].known):toBe(false)
        expect(game.view(state).player_hand[4].known):toBe(false)
    end)

    it("sorts cards and watched marks without mutating the deal", function()
        math.randomseed(48)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        game_fixture.arrange_player(
            state,
            { card(3, 2), card(14, 1), card(3, 1), card(9, 2), card(14, 3) },
            { false, true, false, false, false }
        )
        local deck_size: i32 = game.view(state).deck_count
        local rank_order = state:sort_player_hand(false)

        expect(#rank_order):toBe(5)
        expect(rank_order[0]):toBe(1)
        expect(rank_order[1]):toBe(4)
        expect(rank_order[2]):toBe(3)
        expect(rank_order[3]):toBe(2)
        expect(rank_order[4]):toBe(0)
        expect(game.view(state).player_hand[0].card.rank):toBe(14)
        expect(game.view(state).player_hand[0].card.suit):toBe(1)
        expect(game.view(state).player_hand[1].card.rank):toBe(14)
        expect(game.view(state).player_hand[1].card.suit):toBe(3)
        expect(game.view(state).player_hand[2].card.rank):toBe(9)
        expect(game.view(state).player_hand[2].card.suit):toBe(2)
        expect(game.view(state).player_hand[3].card.rank):toBe(3)
        expect(game.view(state).player_hand[3].card.suit):toBe(1)
        expect(game.view(state).player_hand[4].card.rank):toBe(3)
        expect(game.view(state).player_hand[4].card.suit):toBe(2)
        expect(game.view(state).player_hand[0].known):toBe(true)
        expect(game.view(state).player_hand[1].known):toBe(false)
        expect(game.view(state).player_hand[2].known):toBe(false)
        expect(game.view(state).player_hand[3].known):toBe(false)
        expect(game.view(state).player_hand[4].known):toBe(false)

        local color_order = state:sort_player_hand(true)
        expect(color_order[0]):toBe(0)
        expect(color_order[1]):toBe(3)
        expect(color_order[2]):toBe(2)
        expect(color_order[3]):toBe(4)
        expect(color_order[4]):toBe(1)
        expect(game.view(state).player_hand[0].card.rank):toBe(14)
        expect(game.view(state).player_hand[0].card.suit):toBe(1)
        expect(game.view(state).player_hand[1].card.rank):toBe(3)
        expect(game.view(state).player_hand[1].card.suit):toBe(1)
        expect(game.view(state).player_hand[2].card.rank):toBe(9)
        expect(game.view(state).player_hand[2].card.suit):toBe(2)
        expect(game.view(state).player_hand[3].card.rank):toBe(3)
        expect(game.view(state).player_hand[3].card.suit):toBe(2)
        expect(game.view(state).player_hand[4].card.rank):toBe(14)
        expect(game.view(state).player_hand[4].card.suit):toBe(3)
        expect(game.view(state).player_hand[0].known):toBe(true)
        expect(game.view(state).player_hand[1].known):toBe(false)
        expect(game.view(state).deck_count):toBe(deck_size)
        expect(#game.view(state).middle):toBe(3)
        expect(#game.view(state).computer_hand):toBe(5)
    end)

    it("uses proposed cards as the wager and rejects unaffordable proposals", function()
        local two_card_state = game.new(false, starter_loadout(), game.starting_gold)
        game_fixture.arrange_arch_mage(
            two_card_state,
            { card(10, 0), card(11, 0), card(12, 0) },
            { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
        )
        two_card_state:resolve_swap({ 0, 1 }, { 0, 1 })
        expect(game.view(two_card_state).player_wager):toBe(2)
        expect(game.view(two_card_state).player_points):toBe(8)
        expect(game.view(two_card_state).pot):toBe(2)

        local unaffordable_state = game.new(false, starter_loadout(), game.starting_gold)
        game_fixture.set_player_points(unaffordable_state, 1)
        unaffordable_state:resolve_swap({ 0, 1 }, { 0, 1 })
        expect(game.view(unaffordable_state).swap_open):toBe(true)
        expect(game.view(unaffordable_state).player_wager):toBe(0)
    end)

    it("lets the Opponent make an unrestricted three-card swap", function()
        local state = game.new(false, starter_loadout(), game.starting_gold)
        game_fixture.arrange_arch_mage(
            state,
            { card(2, 1), card(4, 2), card(6, 3) },
            { card(10, 0), card(11, 0), card(12, 0), card(13, 0), card(14, 0) }
        )
        local swap = game.best_swap(game.hand_cards(game.view(state).computer_hand), game.view(state).middle)
        expect(#swap.hand_indices):toBe(3)
        expect(#swap.middle_indices):toBe(3)
        state:resolve_swap({}, {})

        expect(game.view(state).computer_wager):toBe(3)
        expect(game.view(state).pot):toBe(3)
        expect(game.view(state).swap_winner):toBe(-1)
        expect(game.view(state).player_points):toBe(10)
        for index in swap.hand_indices do expect(game.view(state).computer_hand[index].known):toBe(true) end
        local marked_slots: i32 = 0
        for i = 0::i32, 4::i32 do
            if game.view(state).computer_hand[i].known then marked_slots += 1 end
            expect(game.view(state).player_hand[i].known):toBe(false)
        end
        expect(marked_slots):toBe(3)
    end)

    it("chooses the pair that completes the strongest hand", function()
        local middle: {game.Card} = { card(2, 2), card(7, 2), card(11, 2) }
        local hand: {game.Card} = { card(14, 0), card(14, 1), card(5, 2), card(13, 2), card(9, 0) }
        local choice = game.best_pair(hand, middle)

        expect(choice.first):toBe(2)
        expect(choice.second):toBe(3)
    end)
end)

describe("Duel Magic development snapshots", function()
    it("round-trips the complete rules state and rejects incompatible data", function()
        math.randomseed(49)
        local state: game.State = game.new(false, starter_loadout(), game.starting_gold)
        state:resolve_swap({ 0 }, { 1 })
        force_player_win(state)
        state:play(0, 1)
        state:resolve_swap({}, {})
        game_fixture.set_swap_trace(state, { 2 }, { 0 })

        local encoded: string = game.snapshot(state)
        local restored: game.State? = game.restore(encoded)
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            expect(game.snapshot(restored)):toBe(encoded)
            expect(#game.view(restored).history):toBe(1)
            expect(game.view(restored).history[0].player_value):toBe(game.view(state).history[0].player_value)
            expect(game.view(restored).player_hand[0].known):toBe(game.view(state).player_hand[0].known)
            expect(game.view(restored).computer_hand[0].known):toBe(game.view(state).computer_hand[0].known)
            expect(game.view(restored).swap_hand_indices[0]):toBe(2)
            expect(game.view(restored).swap_middle_indices[0]):toBe(0)
        end

        expect(game.restore("duel-state-v0,0") == nil):toBe(true)
        expect(game.restore(encoded .. ",unexpected") == nil):toBe(true)
    end)

    it("frames screen, run, rules, flow, and presentation payloads atomically", function()
        local run_state: run.State = run.new(game.spell_clone, false)
        local rules: game.State = game.new(false, starter_loadout(), game.starting_gold)
        local ui: flow.State = flow.new()
        ui.modal = flow.modal_help

        local encoded_flow: string = flow.snapshot(ui)
        local framed: string = snapshot_data.frame("target-test-frame", {
            "1",
            run.snapshot(run_state),
            game.snapshot(rules),
            encoded_flow,
            "presentation",
        })
        local sections: {string}? = snapshot_data.unframe(framed, "target-test-frame", 5)
        expect(sections == nil):toBe(false)
        if sections ~= nil then
            local payloads: {string} = sections
            expect(payloads[0]):toBe("1")
            local restored_run: run.State? = run.restore(payloads[1])
            local restored_rules: game.State? = game.restore(payloads[2])
            local restored_ui: flow.State? = flow.restore(payloads[3])
            expect(restored_run == nil):toBe(false)
            expect(restored_rules == nil):toBe(false)
            expect(restored_ui == nil):toBe(false)
            expect(payloads[4]):toBe("presentation")
            if restored_run ~= nil then
                expect(restored_run.spells[0].kind):toBe(game.spell_clone)
            end
            if restored_ui ~= nil then expect(restored_ui.modal):toBe(flow.modal_help) end
        end

        expect(snapshot_data.unframe(framed, "wrong-schema", 5) == nil):toBe(true)
        expect(snapshot_data.unframe(framed, "target-test-frame", 4) == nil):toBe(true)
        expect(snapshot_data.unframe(framed .. "|extra", "target-test-frame", 5) == nil):toBe(true)
    end)
end)

describe("Duel Magic duel flow", function()
    it("applies the same modal and animation gates to both input adapters", function()
        local keyboard: flow.State = flow.new()
        local mouse: flow.State = flow.new()
        keyboard.modal = flow.modal_help
        mouse.modal = flow.modal_help

        expect(flow.gate(keyboard, false, false, false, flow.command_advance)):toBe(flow.result_consumed)
        expect(flow.gate(mouse, false, false, false, flow.command_primary)):toBe(flow.result_consumed)
        expect(keyboard.modal):toBe(flow.modal_none)
        expect(mouse.modal):toBe(flow.modal_none)

        expect(flow.gate(keyboard, false, true, false, flow.command_advance)):toBe(flow.result_skip)
        expect(flow.gate(mouse, false, true, false, flow.command_primary)):toBe(flow.result_skip)
    end)

    it("finishes a reveal before advancing to round cleanup", function()
        local ui: flow.State = flow.new()
        flow.begin_reveal(ui)

        expect(flow.gate(ui, false, false, false, flow.command_advance)):toBe(flow.result_finish_reveal)
        expect(ui.revealing):toBe(true)
        expect(flow.gate(ui, false, false, true, flow.command_advance)):toBe(flow.result_refill)
        expect(ui.revealing):toBe(false)

        flow.begin_reveal(ui)
        expect(flow.gate(ui, true, false, false, flow.command_primary)):toBe(flow.result_finish_reveal)
        expect(flow.gate(ui, true, false, true, flow.command_primary)):toBe(flow.result_consumed)
        expect(ui.modal):toBe(flow.modal_final)
    end)
end)

describe("Duel Magic game flow", function()
    it("plays all five rounds after three player wins", function()
        math.randomseed(42)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        expect(game.view(state).deck_count):toBe(39)
        expect(#game.view(state).middle):toBe(3)
        expect(game.view(state).player_points):toBe(10)
        expect(game.view(state).swap_open):toBe(true)
        expect(#game.view(state).player_hand):toBe(5)
        expect(#game.view(state).computer_hand):toBe(5)
        for i = 0::i32, 4::i32 do
            expect(game.view(state).player_hand[i].known):toBe(false)
            expect(game.view(state).computer_hand[i].known):toBe(false)
        end

        for expected_round = FIRST_ROUND, LAST_ROUND do
            expect(game.view(state).round):toBe(expected_round)
            expect(game.view(state).finished):toBe(false)
            expect(#game.view(state).player_hand):toBe(5)
            expect(#game.view(state).computer_hand):toBe(5)
            state:resolve_swap({}, {})
            expect(game.view(state).swap_open):toBe(false)
            force_player_win(state)
            state:play(0, 1)
            expect(#game.view(state).history):toBe(expected_round)
            expect(game.view(state).player_tricks):toBe(expected_round)
            local trick = game.view(state).history[expected_round - 1]
            expect(trick.round):toBe(expected_round)
            expect(trick.winner):toBe(1)
            expect(trick.pot):toBe(trick.player_wager + trick.computer_wager)
            expect(trick.points):toBe(expected_round + trick.pot)
            expect(#trick.middle):toBe(3)
            expect(#trick.player_cards):toBe(2)
            expect(#trick.computer_cards):toBe(2)
            expect(#trick.player_hand):toBe(5)
            expect(#trick.computer_hand):toBe(5)
            expect(trick.player_hand[2].card.rank):toBe(2)
            expect(trick.player_hand[2].card.suit):toBe(1)
            expect(game.view(state).player_hand[2].card.rank):toBe(6)
            expect(game.view(state).player_hand[2].card.suit):toBe(3)
            if expected_round < LAST_ROUND then expect(game.view(state).finished):toBe(false) end
        end

        expect(game.view(state).finished):toBe(true)
        expect(game.view(state).player_tricks):toBe(5)
        expect(game.view(state).computer_tricks):toBe(0)
        expect(game.view(state).deck_count):toBe(7)
        expect(#game.view(state).middle):toBe(0)
        expect(#game.view(state).history):toBe(5)
        local final_points: i32 = game.view(state).player_points
        state:play(0, 1)
        expect(game.view(state).player_points):toBe(final_points)
    end)

    it("ends immediately on the Opponent's third win", function()
        math.randomseed(43)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        for expected_round = FIRST_ROUND, 3 do
            state:resolve_swap({}, {})
            force_computer_win(state)
            state:play(0, 1)
            local trick = game.view(state).history[expected_round - 1]
            expect(trick.winner):toBe(-1)
            expect(trick.points):toBe(0)
            if expected_round < 3 then expect(game.view(state).finished):toBe(false) end
        end

        expect(game.view(state).finished):toBe(true)
        expect(game.view(state).computer_tricks):toBe(3)
        expect(game.view(state).player_tricks):toBe(0)
        expect(#game.view(state).history):toBe(3)
        expect(#game.view(state).middle):toBe(0)
    end)

    it("keeps a stalemate open and refunds its wager", function()
        math.randomseed(44)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        state:resolve_swap({}, {})
        force_stalemate(state)
        local points: i32 = game.view(state).player_points
        state:play(0, 1)

        expect(game.view(state).history[0].winner):toBe(0)
        expect(game.view(state).history[0].points):toBe(0)
        expect(game.view(state).player_tricks):toBe(0)
        expect(game.view(state).computer_tricks):toBe(0)
        expect(game.view(state).player_points):toBe(points)
        expect(game.view(state).finished):toBe(false)
        expect(game.view(state).round):toBe(2)
    end)

    it("does not count a stalemate as a third Opponent hold", function()
        math.randomseed(45)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        for _ = 1, 2 do
            state:resolve_swap({}, {})
            force_computer_win(state)
            state:play(0, 1)
        end
        state:resolve_swap({}, {})
        force_stalemate(state)
        state:play(0, 1)

        expect(#game.view(state).history):toBe(3)
        expect(game.view(state).history[2].winner):toBe(0)
        expect(game.view(state).computer_tricks):toBe(2)
        expect(game.view(state).player_tricks):toBe(0)
        expect(game.view(state).finished):toBe(false)
        expect(game.view(state).round):toBe(4)
    end)
end)

-- Challenge hands shrink between rounds, so a forced win is sized to
-- whatever the hands currently hold: the player keeps a royal pair against
-- the fixed table_card row while the Opponent holds a ladder that never beats it.
local function force_boss_player_win(state: game.State): unit
    local count: i32 = #game.view(state).player_hand
    local player: {game.Card} = { card(13, 0), card(14, 0) }
    for rank = 2, count - 1 do table.insert(player, card(rank, 1)) end
    local computer: {game.Card} = {}
    for rank = 2, count + 1 do table.insert(computer, card(rank, 2)) end
    game_fixture.arrange_breach(
        state, { card(10, 0), card(11, 0), card(12, 0) }, player, computer)
end

describe("Duel Magic boss battle", function()
    it("deals eleven cards and never replaces a spent one", function()
        math.randomseed(50)
        local state = game.new(true, starter_loadout(), game.starting_gold)
        expect(state:is_boss()):toBe(true)
        expect(game.view(state).deck_count):toBe(27)
        expect(#game.view(state).player_hand):toBe(11)
        expect(#game.view(state).computer_hand):toBe(11)
        expect(#game.view(state).middle):toBe(3)
        expect(game.view(state).player_points):toBe(10)
        expect(game.view(state).swap_open):toBe(true)

        for expected_round = FIRST_ROUND, LAST_ROUND do
            expect(game.view(state).round):toBe(expected_round)
            expect(game.view(state).finished):toBe(false)
            local expected_hand: i32 = 13 - expected_round * 2
            expect(#game.view(state).player_hand):toBe(expected_hand)
            expect(#game.view(state).computer_hand):toBe(expected_hand)
            local deck_before: i32 = game.view(state).deck_count
            state:resolve_swap({}, {})
            force_boss_player_win(state)
            state:play(0, 1)
            local trick = game.view(state).history[expected_round - 1]
            expect(trick.winner):toBe(1)
            expect(#trick.player_hand):toBe(expected_hand)
            expect(#trick.computer_hand):toBe(expected_hand)
            -- Only the next table_card row leaves the deck: spent cards are never
            -- replaced, and the terminal round reveals no further table cards.
            if expected_round < LAST_ROUND then
                expect(game.view(state).deck_count):toBe(deck_before - 3)
            else
                expect(game.view(state).deck_count):toBe(deck_before)
            end
        end

        expect(game.view(state).finished):toBe(true)
        expect(game.view(state).player_tricks):toBe(5)
        expect(#game.view(state).player_hand):toBe(1)
        expect(#game.view(state).computer_hand):toBe(1)
        expect(#game.view(state).middle):toBe(0)
        expect(game.view(state).deck_count):toBe(15)
    end)

    it("keeps the standard game's five-card deal and replacements", function()
        math.randomseed(52)
        local state = game.new(false, starter_loadout(), game.starting_gold)
        expect(state:is_boss()):toBe(false)
        state:resolve_swap({}, {})
        force_player_win(state)
        state:play(0, 1)
        expect(#game.view(state).player_hand):toBe(5)
        expect(#game.view(state).computer_hand):toBe(5)
    end)

    it("searches the whole eleven-card hand for the best swap", function()
        local middle: {game.Card} = { card(9, 2), card(5, 0), card(6, 1) }
        local hand: {game.Card} = {
            card(2, 0), card(3, 1), card(4, 2), card(7, 3), card(8, 0),
            card(2, 1), card(3, 2), card(4, 3),
            card(9, 3), card(9, 0), card(9, 1),
        }
        -- Two of the hand's three nines must stay home while a third joins
        -- the table cards, so every fourfold-circle swap binds an index past the
        -- old five-card option table.
        local choice = game.best_swap(hand, middle)
        expect(game.category_name(choice.hand_value)):toBe("four of a kind")
        local high_index: i32 = 0
        for index in choice.hand_indices do
            if index > high_index then high_index = index end
        end
        expect(high_index >= 5):toBe(true)
    end)

    it("round-trips the variant through development snapshots", function()
        math.randomseed(51)
        local state = game.new(true, starter_loadout(), game.starting_gold)
        local encoded: string = game.snapshot(state)
        local restored: game.State? = game.restore(encoded)
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            expect(restored:is_boss()):toBe(true)
            expect(#game.view(restored).player_hand):toBe(11)
            expect(game.snapshot(restored)):toBe(encoded)
        end

        local standard: game.State = game.new(false, starter_loadout(), game.starting_gold)
        local restored_standard: game.State? = game.restore(game.snapshot(standard))
        expect(restored_standard == nil):toBe(false)
        if restored_standard ~= nil then
            expect(restored_standard:is_boss()):toBe(false)
        end
    end)

    it("restarts as the variant, loadout, and gold the reset asks for", function()
        math.randomseed(53)
        local state = game.new(false, loadout_of(game.spell_firebolt), game.starting_gold)
        state:reset(true, loadout_of(game.spell_clone), 23)
        expect(state:is_boss()):toBe(true)
        expect(state:hand_size()):toBe(11)
        expect(state:spell_kind(0)):toBe(game.spell_clone)
        expect(state:gold()):toBe(23)
        -- A duel dealt a pair of spells is fought with both, each on its own
        -- key and at its own price.
        state:reset(false, {
            game.new_spell(game.spell_freeze_ray),
            { kind = game.spell_clone, cost = 3 },
        }, game.starting_gold)
        expect(state:is_boss()):toBe(false)
        expect(state:hand_size()):toBe(5)
        expect(state:spell_count()):toBe(2)
        expect(state:spell_kind(0)):toBe(game.spell_freeze_ray)
        expect(state:spell_cost(0)):toBe(game.spell_cost)
        expect(state:spell_kind(1)):toBe(game.spell_clone)
        expect(state:spell_cost(1)):toBe(3)
        expect(state:gold()):toBe(game.starting_gold)
    end)
end)

describe("Duel Magic spell casting", function()
    it("charges each spell its own price and refuses the rest", function()
        math.randomseed(57)
        local state = game.new(false, loadout_of(game.spell_raise_card), game.starting_gold)
        expect(state:spell_count()):toBe(1)
        expect(state:spell_kind(0)):toBe(game.spell_raise_card)
        expect(state:spell_cost(0)):toBe(game.spell_cost)
        expect(state:gold()):toBe(10)
        expect(state:can_cast(0)):toBe(true)
        expect(state:cast_spell(0, 0)):toBe(true)
        expect(state:gold()):toBe(5)
        expect(state:cast_spell(0, 1)):toBe(true)
        expect(state:gold()):toBe(0)
        -- The third cast is unaffordable: nothing is charged and the caller
        -- hears a refusal instead of a launch.
        expect(state:can_cast(0)):toBe(false)
        expect(state:cast_spell(0, 2)):toBe(false)
        expect(state:gold()):toBe(0)
    end)

    it("casts either spell of a pair at the price on its own key", function()
        math.randomseed(58)
        local state = game.new(false, {
            game.new_spell(game.spell_freeze_ray),
            { kind = game.spell_clone, cost = 2 },
        }, 4)
        -- Four gold covers the upgraded spell on key 2 but not the full-price
        -- one on key 1, and a slot the loadout does not have is never castable.
        expect(state:can_cast(0)):toBe(false)
        expect(state:can_cast(1)):toBe(true)
        expect(state:can_cast(2)):toBe(false)
        expect(state:cast_spell(2, 0)):toBe(false)
        expect(state:cast_spell(1, 0)):toBe(true)
        expect(state:gold()):toBe(2)
        -- The cheap cast was a Clone, so the table_card it hit is not frozen; the
        -- Freeze Ray on key 1 is affordable again and does freeze one.
        expect(state:is_frozen(0)):toBe(false)
        expect(state:cast_spell(0, 1)):toBe(false)
        state:reset(false, {
            game.new_spell(game.spell_freeze_ray),
            { kind = game.spell_clone, cost = 2 },
        }, game.spell_cost)
        expect(state:cast_spell(0, 1)):toBe(true)
        expect(state:is_frozen(1)):toBe(true)
        expect(state:gold()):toBe(0)
    end)

    it("keeps the dealt loadout through development snapshots", function()
        math.randomseed(59)
        local state = game.new(false, {
            game.new_spell(game.spell_freeze_ray),
            { kind = game.spell_firebolt, cost = 3 },
        }, game.starting_gold)
        state:cast_spell(0, 2)
        local restored: game.State? = game.restore(game.snapshot(state))
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            expect(restored:spell_count()):toBe(2)
            expect(restored:spell_kind(0)):toBe(game.spell_freeze_ray)
            expect(restored:spell_kind(1)):toBe(game.spell_firebolt)
            expect(restored:spell_cost(1)):toBe(3)
            expect(restored:is_frozen(2)):toBe(true)
            -- The last cast was the Freeze Ray, so a burn landing after a
            -- reload still has no Firebolt to resolve.
            expect(restored:resolve_firebolt(1) == nil):toBe(true)
        end
    end)

    it("keeps frozen table cards out of both sides' feints and thaws after resolution", function()
        local state = game.new(false, loadout_of(game.spell_freeze_ray), game.starting_gold)
        game_fixture.arrange_arch_mage(
            state,
            { card(2, 1), card(4, 2), card(6, 3) },
            { card(10, 0), card(11, 0), card(12, 0), card(13, 0), card(14, 0) }
        )
        expect(state:cast_spell(0, 0)):toBe(true)
        expect(state:is_frozen(0)):toBe(true)

        -- A player proposal that names the frozen table_card does not resolve the
        -- swap or clear the condition.
        expect(state:resolve_swap({ 0 }, { 0 }) == nil):toBe(true)
        expect(state:swap_open()):toBe(true)
        expect(state:is_frozen(0)):toBe(true)

        local outcome: game.SwapOutcome? = state:resolve_swap({}, {})
        assert(outcome ~= nil)
        local resolved: game.SwapOutcome = outcome::game.SwapOutcome
        expect(#resolved.middle_indices):toBe(2)
        for table_card in resolved.middle_indices do expect(table_card == 0):toBe(false) end
        expect(state:is_frozen(0)):toBe(false)
        expect(state:swap_open()):toBe(false)
    end)

    it("retains a table_card frozen after the swap for exactly one more round", function()
        math.randomseed(61)
        local state = game.new(false, loadout_of(game.spell_freeze_ray), game.starting_gold)
        state:resolve_swap({}, {})
        local retained = game.view(state).middle[1]
        local replaced_left = game.view(state).middle[0]
        local replaced_right = game.view(state).middle[2]
        local deck_size: i32 = game.view(state).deck_count

        expect(state:cast_spell(0, 1)):toBe(true)
        local trick: game.Trick? = state:play(0, 1)
        assert(trick ~= nil)
        local resolved: game.Trick = trick::game.Trick

        expect(resolved.frozen_middle[0]):toBe(false)
        expect(resolved.frozen_middle[1]):toBe(true)
        expect(resolved.frozen_middle[2]):toBe(false)
        expect(game.view(state).middle[1].rank):toBe(retained.rank)
        expect(game.view(state).middle[1].suit):toBe(retained.suit)
        expect(game.view(state).middle[0].rank == replaced_left.rank and game.view(state).middle[0].suit == replaced_left.suit):toBe(false)
        expect(game.view(state).middle[2].rank == replaced_right.rank and game.view(state).middle[2].suit == replaced_right.suit):toBe(false)
        expect(game.view(state).deck_count):toBe(deck_size - 6)
        expect(state:is_frozen(1)):toBe(false)
    end)

    it("replaces a Firebolt target from the deck and returns the burned card", function()
        math.randomseed(61)
        local state = game.new(false, loadout_of(game.spell_firebolt), game.starting_gold)
        expect(state:cast_spell(0, 1)):toBe(true)
        local deck_before: i32 = game.view(state).deck_count
        local burned: game.Card = game.view(state).middle[1]
        local replacement: game.Card = game.test_next_draw(state)

        local discarded: game.Card? = state:resolve_firebolt(1)

        expect(discarded == nil):toBe(false)
        if discarded ~= nil then
            expect((discarded::game.Card).rank):toBe(burned.rank)
            expect((discarded::game.Card).suit):toBe(burned.suit)
        end
        expect(game.view(state).middle[1].rank):toBe(replacement.rank)
        expect(game.view(state).middle[1].suit):toBe(replacement.suit)
        expect(game.view(state).deck_count):toBe(deck_before - 1)
    end)

    it("leaves the board unchanged for invalid Firebolt targets", function()
        math.randomseed(63)
        local state = game.new(false, loadout_of(game.spell_firebolt), game.starting_gold)
        expect(state:cast_spell(0, 1)):toBe(true)
        local before: string = game.snapshot(state)

        expect(state:resolve_firebolt(-1) == nil):toBe(true)
        expect(state:resolve_firebolt(3) == nil):toBe(true)
        expect(game.snapshot(state)):toBe(before)
    end)

    it("burns a table_card only for a Firebolt this duel actually paid for", function()
        math.randomseed(67)
        local state = game.new(false, {
            game.new_spell(game.spell_freeze_ray),
            game.new_spell(game.spell_firebolt),
        }, game.starting_gold)
        -- Carrying Firebolt is not casting it: nothing burns until the gold for
        -- one has changed hands.
        expect(state:resolve_firebolt(1) == nil):toBe(true)
        expect(state:cast_spell(0, 1)):toBe(true)
        expect(state:resolve_firebolt(1) == nil):toBe(true)
        expect(state:cast_spell(1, 1)):toBe(true)
        expect(state:resolve_firebolt(1) == nil):toBe(false)
    end)
end)
