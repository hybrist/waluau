-- Deterministic, DOM-free checks for Arcane Heist.

require("waluau:vitest")

local game = require("./game")
local game_fixture = require("./game_fixture")
local flow = require("./flow")
local snapshot_data = require("./snapshot")

const FIRST_ROUND: i32 = 1
const LAST_ROUND: i32 = 5

local function card(rank: i32, suit: i32): game.Card
    return { rank = rank, suit = suit }
end

local function force_player_win(state: game.State): unit
    game_fixture.arrange_breach(
        state,
        { card(10, 0), card(11, 0), card(12, 0) },
        { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) },
        { card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2) }
    )
end

local function force_computer_win(state: game.State): unit
    game_fixture.arrange_breach(
        state,
        { card(10, 0), card(11, 0), card(12, 0) },
        { card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2) },
        { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
    )
end

local function force_stalemate(state: game.State): unit
    game_fixture.arrange_breach(
        state,
        { card(7, 3), card(2, 3), card(8, 2) },
        { card(13, 0), card(13, 1), card(4, 0), card(5, 1), card(6, 0) },
        { card(13, 2), card(13, 3), card(4, 2), card(5, 3), card(6, 2) }
    )
end

describe("Arcane Heist scoring", function()
    it("orders every five-card hand category", function()
        local straight_flush: i32 = game.rank_five({ card(10, 3), card(11, 3), card(12, 3), card(13, 3), card(14, 3) })
        local four_kind: i32 = game.rank_five({ card(9, 0), card(9, 1), card(9, 2), card(9, 3), card(2, 0) })
        local full_house: i32 = game.rank_five({ card(8, 0), card(8, 1), card(8, 2), card(4, 0), card(4, 1) })
        local flush: i32 = game.rank_five({ card(14, 2), card(10, 2), card(7, 2), card(5, 2), card(2, 2) })
        local straight: i32 = game.rank_five({ card(9, 0), card(8, 1), card(7, 2), card(6, 3), card(5, 0) })
        local three_kind: i32 = game.rank_five({ card(7, 0), card(7, 1), card(7, 2), card(12, 3), card(2, 0) })
        local two_pair: i32 = game.rank_five({ card(14, 0), card(14, 1), card(3, 0), card(3, 1), card(8, 2) })
        local one_pair: i32 = game.rank_five({ card(13, 0), card(13, 1), card(10, 0), card(6, 1), card(2, 2) })
        local high_card: i32 = game.rank_five({ card(14, 0), card(11, 1), card(8, 0), card(5, 1), card(2, 2) })

        expect(straight_flush):toBeGreaterThan(four_kind)
        expect(four_kind):toBeGreaterThan(full_house)
        expect(full_house):toBeGreaterThan(flush)
        expect(flush):toBeGreaterThan(straight)
        expect(straight):toBeGreaterThan(three_kind)
        expect(three_kind):toBeGreaterThan(two_pair)
        expect(two_pair):toBeGreaterThan(one_pair)
        expect(one_pair):toBeGreaterThan(high_card)
    end)

    it("marks the made hand and only tie-breaking kickers", function()
        local winning_pair_cards: {game.Card} = { card(13, 0), card(13, 1), card(14, 2), card(7, 3), card(4, 0) }
        local losing_pair_cards: {game.Card} = { card(13, 2), card(13, 3), card(12, 0), card(7, 1), card(4, 2) }
        local winning_pair_value: i32 = game.rank_five(winning_pair_cards)
        local losing_pair_value: i32 = game.rank_five(losing_pair_cards)
        local pair_marks: {bool} = game.scoring_cards(winning_pair_cards, winning_pair_value, losing_pair_value)
        local lower_pair_value: i32 = game.rank_five({ card(12, 1), card(12, 2), card(14, 3), card(9, 0), card(8, 1) })
        local made_pair_marks: {bool} = game.scoring_cards(winning_pair_cards, winning_pair_value, lower_pair_value)
        local formation_marks: {bool} = game.formation_cards(winning_pair_cards, winning_pair_value)

        expect(pair_marks[0]):toBe(true)
        expect(pair_marks[1]):toBe(true)
        expect(pair_marks[2]):toBe(true)
        expect(pair_marks[3]):toBe(false)
        expect(pair_marks[4]):toBe(false)
        expect(made_pair_marks[0]):toBe(true)
        expect(made_pair_marks[1]):toBe(true)
        expect(made_pair_marks[2]):toBe(false)
        expect(made_pair_marks[3]):toBe(false)
        expect(made_pair_marks[4]):toBe(false)
        expect(formation_marks[0]):toBe(true)
        expect(formation_marks[1]):toBe(true)
        expect(formation_marks[2]):toBe(false)
        expect(formation_marks[3]):toBe(false)
        expect(formation_marks[4]):toBe(false)
    end)

    it("treats the wheel as a five-high straight", function()
        local wheel: i32 = game.rank_five({ card(14, 0), card(2, 1), card(3, 2), card(4, 3), card(5, 0) })
        local six_high: i32 = game.rank_five({ card(2, 0), card(3, 1), card(4, 2), card(5, 3), card(6, 0) })

        expect(six_high):toBeGreaterThan(wheel)
    end)

    it("ranks three-card bids and resolves their priority", function()
        local three_straight_flush: i32 = game.rank_three({ card(10, 2), card(11, 2), card(12, 2) })
        local three_kind: i32 = game.rank_three({ card(8, 0), card(8, 1), card(8, 2) })
        local three_straight: i32 = game.rank_three({ card(4, 0), card(5, 1), card(6, 2) })
        local three_flush: i32 = game.rank_three({ card(14, 3), card(9, 3), card(3, 3) })
        local three_pair: i32 = game.rank_three({ card(7, 0), card(7, 1), card(2, 2) })

        expect(three_straight_flush):toBeGreaterThan(three_kind)
        expect(three_kind):toBeGreaterThan(three_straight)
        expect(three_straight):toBeGreaterThan(three_flush)
        expect(three_flush):toBeGreaterThan(three_pair)
        expect(game.swap_priority(3, three_pair, 2, three_straight_flush)):toBe(1)
        expect(game.swap_priority(2, three_straight, 2, three_pair)):toBe(1)
        expect(game.swap_priority(2, three_pair, 2, three_straight)):toBe(-1)
    end)
end)

describe("Arcane Heist swaps", function()
    it("exchanges a winning proposal once without consuming the deck", function()
        math.randomseed(7)
        local state = game.new()
        game_fixture.arrange_arch_mage(
            state,
            { card(10, 0), card(11, 0), card(12, 0) },
            { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
        )
        state:play(0, 1)
        expect(#state.history):toBe(0)
        local old_hand = state.player_hand[0]
        local old_middle = state.middle[0]
        local old_deck_size: i32 = #state.deck
        local outcome: game.FeintOutcome? = state:resolve_swap({ 0 }, { 0 })
        assert(outcome ~= nil)
        local won_feint: game.FeintOutcome = outcome::game.FeintOutcome
        local outcome_winner: i32 = won_feint.winner
        local outcome_hand_count: i32 = #won_feint.hand_indices
        local outcome_hand_index: i32 = won_feint.hand_indices[0]
        local outcome_middle_count: i32 = #won_feint.middle_indices
        local outcome_middle_index: i32 = won_feint.middle_indices[0]
        local outcome_outgoing_rank: i32 = won_feint.outgoing[0].rank
        local outcome_incoming_rank: i32 = won_feint.incoming[0].rank

        expect(state.swap_open):toBe(false)
        expect(outcome_winner):toBe(1)
        expect(outcome_hand_count):toBe(1)
        expect(outcome_hand_index):toBe(0)
        expect(outcome_middle_count):toBe(1)
        expect(outcome_middle_index):toBe(0)
        expect(outcome_outgoing_rank):toBe(old_hand.rank)
        expect(outcome_incoming_rank):toBe(old_middle.rank)
        expect(state.swap_winner):toBe(1)
        expect(state.swap_count):toBe(1)
        expect(#state.swap_hand_indices):toBe(1)
        expect(state.swap_hand_indices[0]):toBe(0)
        expect(#state.swap_middle_indices):toBe(1)
        expect(state.swap_middle_indices[0]):toBe(0)
        expect(state.player_points):toBe(9)
        expect(state.pot):toBe(1)
        expect(state.player_hand[0].rank):toBe(old_middle.rank)
        expect(state.player_hand[0].suit):toBe(old_middle.suit)
        expect(state.middle[0].rank):toBe(old_hand.rank)
        expect(state.middle[0].suit):toBe(old_hand.suit)
        expect(#state.deck):toBe(old_deck_size)
        local visible_deck_count: i32 = game.view(state).deck_count
        expect(visible_deck_count):toBe(old_deck_size)
        expect(state.player_known[0]):toBe(true)
        expect(state.player_known[1]):toBe(false)
        expect(state.player_known[2]):toBe(false)
        expect(state.player_known[3]):toBe(false)
        expect(state.player_known[4]):toBe(false)
        for i = 0::i32, 4::i32 do expect(state.computer_known[i]):toBe(false) end

        state:resolve_swap({ 1 }, { 1 })
        expect(state.player_wager):toBe(1)
        expect(state.swap_count):toBe(1)
    end)

    it("re-packs watched marks with the hand after a trick", function()
        math.randomseed(46)
        local state = game.new()
        game_fixture.arrange_arch_mage(
            state,
            { card(10, 0), card(11, 0), card(12, 0) },
            { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
        )
        local marked_card = state.middle[0]
        state:resolve_swap({ 3 }, { 0 })
        expect(state.swap_winner):toBe(1)
        expect(state.player_known[3]):toBe(true)
        local played: game.Trick? = state:play(0, 1)
        assert(played ~= nil)

        expect(#state.player_known):toBe(5)
        expect(#state.player_hand):toBe(5)
        local trick = state.history[0]
        local played_round: i32 = (played::game.Trick).round
        expect(played_round):toBe(trick.round)
        expect(trick.player_known[3]):toBe(true)
        expect(trick.player_known[1]):toBe(false)
        expect(trick.player_hand[3].rank):toBe(marked_card.rank)
        expect(trick.player_hand[3].suit):toBe(marked_card.suit)
        expect(state.player_known[1]):toBe(true)
        expect(state.player_known[0]):toBe(false)
        expect(state.player_hand[1].rank):toBe(marked_card.rank)
        expect(state.player_hand[1].suit):toBe(marked_card.suit)
        expect(state.player_known[2]):toBe(false)
        expect(state.player_known[3]):toBe(false)
        expect(state.player_known[4]):toBe(false)
    end)

    it("sorts relics and watched marks without mutating the deal", function()
        math.randomseed(48)
        local state = game.new()
        game_fixture.arrange_player(
            state,
            { card(3, 2), card(14, 1), card(3, 1), card(9, 2), card(14, 3) },
            { false, true, false, false, false }
        )
        local deck_size: i32 = #state.deck
        local rank_order = state:sort_player_hand(false)

        expect(#rank_order):toBe(5)
        expect(rank_order[0]):toBe(1)
        expect(rank_order[1]):toBe(4)
        expect(rank_order[2]):toBe(3)
        expect(rank_order[3]):toBe(2)
        expect(rank_order[4]):toBe(0)
        expect(state.player_hand[0].rank):toBe(14)
        expect(state.player_hand[0].suit):toBe(1)
        expect(state.player_hand[1].rank):toBe(14)
        expect(state.player_hand[1].suit):toBe(3)
        expect(state.player_hand[2].rank):toBe(9)
        expect(state.player_hand[2].suit):toBe(2)
        expect(state.player_hand[3].rank):toBe(3)
        expect(state.player_hand[3].suit):toBe(1)
        expect(state.player_hand[4].rank):toBe(3)
        expect(state.player_hand[4].suit):toBe(2)
        expect(state.player_known[0]):toBe(true)
        expect(state.player_known[1]):toBe(false)
        expect(state.player_known[2]):toBe(false)
        expect(state.player_known[3]):toBe(false)
        expect(state.player_known[4]):toBe(false)

        local school_order = state:sort_player_hand(true)
        expect(school_order[0]):toBe(0)
        expect(school_order[1]):toBe(3)
        expect(school_order[2]):toBe(2)
        expect(school_order[3]):toBe(4)
        expect(school_order[4]):toBe(1)
        expect(state.player_hand[0].rank):toBe(14)
        expect(state.player_hand[0].suit):toBe(1)
        expect(state.player_hand[1].rank):toBe(3)
        expect(state.player_hand[1].suit):toBe(1)
        expect(state.player_hand[2].rank):toBe(9)
        expect(state.player_hand[2].suit):toBe(2)
        expect(state.player_hand[3].rank):toBe(3)
        expect(state.player_hand[3].suit):toBe(2)
        expect(state.player_hand[4].rank):toBe(14)
        expect(state.player_hand[4].suit):toBe(3)
        expect(state.player_known[0]):toBe(true)
        expect(state.player_known[1]):toBe(false)
        expect(#state.deck):toBe(deck_size)
        expect(#state.middle):toBe(3)
        expect(#state.computer_hand):toBe(5)
    end)

    it("uses proposed cards as the wager and rejects unaffordable proposals", function()
        local two_card_state = game.new()
        game_fixture.arrange_arch_mage(
            two_card_state,
            { card(10, 0), card(11, 0), card(12, 0) },
            { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
        )
        two_card_state:resolve_swap({ 0, 1 }, { 0, 1 })
        expect(two_card_state.player_wager):toBe(2)
        expect(two_card_state.player_points):toBe(8)
        expect(two_card_state.pot):toBe(2)

        local unaffordable_state = game.new()
        game_fixture.set_player_points(unaffordable_state, 1)
        unaffordable_state:resolve_swap({ 0, 1 }, { 0, 1 })
        expect(unaffordable_state.swap_open):toBe(true)
        expect(unaffordable_state.player_wager):toBe(0)
    end)

    it("lets the Arch Mage make an unrestricted three-card feint", function()
        local state = game.new()
        game_fixture.arrange_arch_mage(
            state,
            { card(2, 1), card(4, 2), card(6, 3) },
            { card(10, 0), card(11, 0), card(12, 0), card(13, 0), card(14, 0) }
        )
        local swap = game.best_swap(state.computer_hand, state.middle)
        expect(#swap.hand_indices):toBe(3)
        expect(#swap.middle_indices):toBe(3)
        state:resolve_swap({}, {})

        expect(state.computer_wager):toBe(3)
        expect(state.pot):toBe(3)
        expect(state.swap_winner):toBe(-1)
        expect(state.player_points):toBe(10)
        for index in swap.hand_indices do expect(state.computer_known[index]):toBe(true) end
        local marked_slots: i32 = 0
        for i = 0::i32, 4::i32 do
            if state.computer_known[i] then marked_slots += 1 end
            expect(state.player_known[i]):toBe(false)
        end
        expect(marked_slots):toBe(3)
    end)

    it("chooses the pair that completes the strongest formation", function()
        local middle: {game.Card} = { card(2, 2), card(7, 2), card(11, 2) }
        local hand: {game.Card} = { card(14, 0), card(14, 1), card(5, 2), card(13, 2), card(9, 0) }
        local choice = game.best_pair(hand, middle)

        expect(choice.first):toBe(2)
        expect(choice.second):toBe(3)
    end)
end)

describe("Arcane Heist development snapshots", function()
    it("round-trips the complete rules state and rejects incompatible data", function()
        math.randomseed(49)
        local state: game.State = game.new()
        state:resolve_swap({ 0 }, { 1 })
        force_player_win(state)
        state:play(0, 1)
        state:resolve_swap({}, {})
        game_fixture.set_swap_trace(state, { 2 }, { 0 })

        local encoded: string = game.snapshot(state)
        local restored: game.State? = game.restore(encoded)
        expect(restored == nil):toBe(false)
        if restored ~= nil then
            expect(game.snapshot(restored)):toBe(encoded)
            expect(#restored.history):toBe(1)
            expect(restored.history[0].player_value):toBe(state.history[0].player_value)
            expect(restored.player_known[0]):toBe(state.player_known[0])
            expect(restored.computer_known[0]):toBe(state.computer_known[0])
            expect(restored.swap_hand_indices[0]):toBe(2)
            expect(restored.swap_middle_indices[0]):toBe(0)
        end

        expect(game.restore("ante-state-v0,0") == nil):toBe(true)
        expect(game.restore(encoded .. ",unexpected") == nil):toBe(true)
    end)

    it("frames rules, flow, and presentation payloads atomically", function()
        local rules: game.State = game.new()
        local ui: flow.State = flow.new()
        ui.modal = flow.modal_help

        local encoded_flow: string = flow.snapshot(ui)
        local framed: string = snapshot_data.frame3(
            "ante-test-frame", game.snapshot(rules), encoded_flow, "presentation")
        local sections: {string}? = snapshot_data.unframe3(framed, "ante-test-frame")
        expect(sections == nil):toBe(false)
        if sections ~= nil then
            local payloads: {string} = sections
            local restored_rules: game.State? = game.restore(payloads[0])
            local restored_ui: flow.State? = flow.restore(payloads[1])
            expect(restored_rules == nil):toBe(false)
            expect(restored_ui == nil):toBe(false)
            expect(payloads[2]):toBe("presentation")
            if restored_ui ~= nil then expect(restored_ui.modal):toBe(flow.modal_help) end
        end

        expect(snapshot_data.unframe3(framed, "wrong-schema") == nil):toBe(true)
        expect(snapshot_data.unframe3(framed .. "|extra", "ante-test-frame") == nil):toBe(true)
    end)
end)

describe("Arcane Heist heist flow", function()
    it("applies the same modal and animation gates to both input adapters", function()
        local keyboard: flow.State = flow.new()
        local mouse: flow.State = flow.new()
        keyboard.modal = flow.modal_help
        mouse.modal = flow.modal_help

        expect(flow.gate(keyboard, false, false, flow.command_advance)):toBe(flow.result_consumed)
        expect(flow.gate(mouse, false, false, flow.command_primary)):toBe(flow.result_consumed)
        expect(keyboard.modal):toBe(flow.modal_none)
        expect(mouse.modal):toBe(flow.modal_none)

        expect(flow.gate(keyboard, false, true, flow.command_advance)):toBe(flow.result_skip)
        expect(flow.gate(mouse, false, true, flow.command_primary)):toBe(flow.result_skip)
    end)

    it("finishes a reveal before advancing to breach cleanup", function()
        local ui: flow.State = flow.new()
        flow.begin_reveal(ui)

        expect(flow.gate(ui, false, false, flow.command_advance)):toBe(flow.result_consumed)
        expect(ui.revealing):toBe(true)
        expect(flow.gate(ui, false, false, flow.command_advance)):toBe(flow.result_refill)
        expect(ui.revealing):toBe(false)

        flow.begin_reveal(ui)
        expect(flow.gate(ui, true, false, flow.command_primary)):toBe(flow.result_consumed)
        expect(flow.gate(ui, true, false, flow.command_primary)):toBe(flow.result_consumed)
        expect(ui.modal):toBe(flow.modal_final)
    end)
end)

describe("Arcane Heist game flow", function()
    it("plays all five rounds after three player wins", function()
        math.randomseed(42)
        local state = game.new()
        expect(#state.deck):toBe(39)
        expect(#state.middle):toBe(3)
        expect(state.player_points):toBe(10)
        expect(state.swap_open):toBe(true)
        expect(#state.player_known):toBe(5)
        expect(#state.computer_known):toBe(5)
        for i = 0::i32, 4::i32 do
            expect(state.player_known[i]):toBe(false)
            expect(state.computer_known[i]):toBe(false)
        end

        for expected_round = FIRST_ROUND, LAST_ROUND do
            expect(state.round):toBe(expected_round)
            expect(state.finished):toBe(false)
            expect(#state.player_hand):toBe(5)
            expect(#state.computer_hand):toBe(5)
            state:resolve_swap({}, {})
            expect(state.swap_open):toBe(false)
            force_player_win(state)
            state:play(0, 1)
            expect(#state.history):toBe(expected_round)
            expect(state.player_tricks):toBe(expected_round)
            local trick = state.history[expected_round - 1]
            expect(trick.round):toBe(expected_round)
            expect(trick.winner):toBe(1)
            expect(trick.pot):toBe(trick.player_wager + trick.computer_wager)
            expect(trick.points):toBe(expected_round + trick.pot)
            expect(#trick.middle):toBe(3)
            expect(#trick.player_cards):toBe(2)
            expect(#trick.computer_cards):toBe(2)
            expect(#trick.player_hand):toBe(5)
            expect(#trick.computer_hand):toBe(5)
            expect(trick.player_hand[2].rank):toBe(2)
            expect(trick.player_hand[2].suit):toBe(1)
            expect(state.player_hand[2].rank):toBe(6)
            expect(state.player_hand[2].suit):toBe(3)
            if expected_round < LAST_ROUND then expect(state.finished):toBe(false) end
        end

        expect(state.finished):toBe(true)
        expect(state.player_tricks):toBe(5)
        expect(state.computer_tricks):toBe(0)
        expect(#state.deck):toBe(7)
        expect(#state.middle):toBe(0)
        expect(#state.history):toBe(5)
        local final_points: i32 = state.player_points
        state:play(0, 1)
        expect(state.player_points):toBe(final_points)
    end)

    it("ends immediately on the Arch Mage's third win", function()
        math.randomseed(43)
        local state = game.new()
        for expected_round = FIRST_ROUND, 3 do
            state:resolve_swap({}, {})
            force_computer_win(state)
            state:play(0, 1)
            local trick = state.history[expected_round - 1]
            expect(trick.winner):toBe(-1)
            expect(trick.points):toBe(0)
            if expected_round < 3 then expect(state.finished):toBe(false) end
        end

        expect(state.finished):toBe(true)
        expect(state.computer_tricks):toBe(3)
        expect(state.player_tricks):toBe(0)
        expect(#state.history):toBe(3)
        expect(#state.middle):toBe(0)
    end)

    it("keeps a stalemate open and refunds its wager", function()
        math.randomseed(44)
        local state = game.new()
        state:resolve_swap({}, {})
        force_stalemate(state)
        local points: i32 = state.player_points
        state:play(0, 1)

        expect(state.history[0].winner):toBe(0)
        expect(state.history[0].points):toBe(0)
        expect(state.player_tricks):toBe(0)
        expect(state.computer_tricks):toBe(0)
        expect(state.player_points):toBe(points)
        expect(state.finished):toBe(false)
        expect(state.round):toBe(2)
    end)

    it("does not count a stalemate as a third Arch Mage hold", function()
        math.randomseed(45)
        local state = game.new()
        for _ = 1, 2 do
            state:resolve_swap({}, {})
            force_computer_win(state)
            state:play(0, 1)
        end
        state:resolve_swap({}, {})
        force_stalemate(state)
        state:play(0, 1)

        expect(#state.history):toBe(3)
        expect(state.history[2].winner):toBe(0)
        expect(state.computer_tricks):toBe(2)
        expect(state.player_tricks):toBe(0)
        expect(state.finished):toBe(false)
        expect(state.round):toBe(4)
    end)
end)
