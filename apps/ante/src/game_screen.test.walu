-- Deterministic coverage for run state that the live duel screen updates.
require("waluau:vitest")

local game = require("./game")
local game_fixture = require("../test/game_fixture")
local run = require("./run")
local city_map = require("./city_map")
local game_screen = require("./game_screen")
local render = require("./render")
local spells = require("./spells/spell")

local function card(rank: i32, suit: i32): game.Card
    return { rank = rank, suit = suit }
end

local function finish_swap_phase(state: game.State): unit
    while state:swap_open() do
        assert(state:resolve_swap({}, {}) ~= nil)
    end
end

describe(
    "Ante Magic run health wiring",
    function()
        it(
            "forfeits immediately during the opening deal and restarts from the loss screen",
            function(): unit
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(105)
                screen:deal_vault()
                expect(screen.presentation:is_animating()):toBe(true)

                screen:keypressed(city, "k")

                expect(screen.run.hearts):toBe(0)
                expect(tostring(screen:run_outcome())):toBe("lost-health")
                expect(tostring(screen.ui.modal)):toBe("final")
                expect(screen.presentation:is_animating()):toBe(false)
                screen:keypressed(city, "Enter")
                expect(screen.run.hearts):toBe(run.max_hearts)
                expect(screen.run.duel):toBe(1)
                expect(tostring(screen.ui.modal)):toBe("none")
            end
        )

        it(
            "lets uppercase K interrupt overlays, targeting, reveals and spell effects",
            function(): unit
                local city: city_map.State = city_map.State.new(106)
                for phase = 1, 6 do
                    local screen: game_screen.State = game_screen.State.new()
                    if phase == 1 then
                        screen.ui.modal = "help"
                    elseif phase == 2 then
                        screen.ui.modal = "history"
                    elseif phase == 3 then
                        screen:arm_spell(0)
                    elseif phase == 4 then
                        screen.ui:begin_reveal()
                    elseif phase == 5 then
                        screen:confirm_cast(0, 0)
                    else
                        screen.intervention.active = true
                    end

                    screen:keypressed(city, "K")
                    screen:update(city, 10.0)

                    expect(tostring(screen:run_outcome())):toBe("lost-health")
                    expect(tostring(screen.ui.modal)):toBe("final")
                    expect(screen.ui.revealing):toBe(false)
                    expect(screen.ui.cast_slot == nil):toBe(true)
                    expect(screen.presentation:firebolt_pending()):toBe(false)
                    expect(screen.intervention.active):toBe(false)
                end
            end
        )

        it(
            "applies retained board actions to domain selection and commit",
            function(): unit
                math.randomseed(103)
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(103)
                finish_swap_phase(screen.rules)
                screen.presentation:skip()

                local first: render.BoardAction = { kind = "hand", index = 1 }
                local second: render.BoardAction = { kind = "hand", index = 3 }
                screen:perform_board_action(city, first)
                screen:perform_board_action(city, second)
                expect(#screen.ui.play_picks):toBe(2)
                expect(screen.ui.play_picks[1]):toBe(1)
                expect(screen.ui.play_picks[2]):toBe(3)

                screen:perform_board_action(city, { kind = "commit", index = 0 })
                expect(screen.ui.revealing):toBe(true)
            end
        )

        it(
            "turns the last lost hand into a run-ending verdict and fresh run",
            function()
                math.randomseed(101)
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(101)
                -- One lost hand drains the last heart before the duel is cleared.
                screen.run.rush = true
                screen:deal_vault()
                screen.run.health = 1

                finish_swap_phase(screen.rules)
                game_fixture.arrange_breach(
                    screen.rules,
                    {card(10, 0), card(11, 0), card(12, 0), card(2, 1), card(3, 2)},
                    {card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2)},
                    {card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3)}
                )
                screen.presentation:skip()
                screen.ui.play_picks = {0, 1}

                screen:keypressed(city, "Enter")

                expect(screen.run.health):toBe(0)
                expect(screen.rules:is_finished()):toBe(false)
                expect(screen.ui.revealing):toBe(true)

                screen.presentation:finish_reveal()
                screen:keypressed(city, "Enter")
                expect(tostring(screen.ui.modal)):toBe("final")

                screen:keypressed(city, "Enter")
                expect(screen.run.health):toBe(run.max_health)
                expect(screen.run.duel):toBe(1)
                expect(tostring(screen.ui.modal)):toBe("none")
            end
        )

        it(
            "ends the run when a boss's final hand is lost with hearts remaining",
            function()
                math.randomseed(102)
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(102)
                screen.run.rush = true
                screen:deal_vault()

                finish_swap_phase(screen.rules)
                -- Three cards are the boss's final playable hand. Spending its
                -- pair leaves one card and therefore no next hand.
                game_fixture.arrange_breach(
                    screen.rules,
                    {card(10, 0), card(11, 0), card(12, 0), card(2, 1), card(3, 2)},
                    {card(2, 1), card(3, 2), card(4, 3)},
                    {card(13, 0), card(14, 0), card(2, 2)}
                )
                screen.presentation:skip()
                screen.ui.play_picks = {0, 1}

                screen:keypressed(city, "Enter")

                expect(screen.run.health):toBe(run.max_health - run.health_per_heart)
                expect(screen.rules:is_finished()):toBe(true)
                expect(screen.rules:is_victory()):toBe(false)
                expect(screen.ui.revealing):toBe(true)

                screen.presentation:finish_reveal()
                screen:keypressed(city, "Enter")
                expect(tostring(screen.ui.modal)):toBe("final")
                expect(tostring(screen:run_outcome())):toBe("lost-duel")

                screen:keypressed(city, "Enter")
                expect(screen.run.health):toBe(run.max_health)
                expect(screen.run.duel):toBe(1)
                expect(tostring(screen.ui.modal)):toBe("none")
            end
        )

        it(
            "charges a heart for a lost boss hand before the finale",
            function()
                math.randomseed(104)
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(104)
                screen.run.rush = true
                screen:deal_vault()

                finish_swap_phase(screen.rules)
                -- Five cards model the second boss hand: after this pair is
                -- spent, three remain and the duel must continue.
                game_fixture.arrange_breach(
                    screen.rules,
                    {card(10, 0), card(11, 0), card(12, 0), card(2, 1), card(3, 2)},
                    {card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2)},
                    {card(13, 0), card(14, 0), card(2, 2), card(4, 2), card(6, 3)}
                )
                screen.presentation:skip()
                screen.ui.play_picks = {0, 1}

                screen:keypressed(city, "Enter")

                expect(screen.run.health):toBe(run.max_health - run.health_per_heart)
                expect(screen.rules:is_finished()):toBe(false)
                expect(#screen.rules:view().player_hand):toBe(3)
                expect(#screen.rules:view().computer_hand):toBe(3)
            end
        )
    end
)

describe(
    "Ante Magic shop screen wiring",
    function()
        it(
            "carries a cleared run through the shop into the next duel",
            function(): unit
                math.randomseed(151)
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(151)
                game_fixture.clear(screen.rules)
                screen.ui.modal = "final"

                screen:keypressed(city, "Enter")
                expect(screen.run.duel):toBe(2)
                expect(screen.shop.open):toBe(true)
                expect(screen:on_map()):toBe(true)

                screen:keypressed(city, "Escape")
                expect(screen:on_map()):toBe(false)
                expect(screen.rules:is_finished()):toBe(false)
                expect(screen.rules:gold()):toBe(screen.run.gold)
                expect(screen.presentation:is_animating()):toBe(true)

                -- The offers remain painted over the map's dissolve, then close
                -- once the newly dealt duel has taken over the screen.
                screen:place_city(city)
                screen:update(city, 0.0)
                expect(screen.shop.open):toBe(false)
            end
        )

        it(
            "closes a shop left during the pull-out that opened it",
            function(): unit
                math.randomseed(151)
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(151)
                game_fixture.clear(screen.rules)
                screen.ui.modal = "final"

                -- A verdict is read from inside the duel's house, so put the
                -- camera there first. The case above instead sets the map down
                -- with place_city after the gestures, which is a snapshot being
                -- restored rather than a run being played: it hands the camera
                -- its destination for free and so cannot see a dissolve that
                -- fails to run. Here the map has to move, and the two gestures
                -- are one frame apart, which is what an impatient player does.
                screen:place_city(city)
                expect(city:visible()):toBe(false)

                screen:keypressed(city, "Enter")
                screen:steer_city(city)
                city:update(1.0 / 60.0)
                screen:keypressed(city, "Escape")

                for _ = 1, 300 do
                    screen:steer_city(city)
                    screen:update(city, 1.0 / 60.0)
                    city:update(1.0 / 60.0)
                end
                expect(screen.shop.open):toBe(false)
                expect(city:visible()):toBe(false)
            end
        )

        it(
            "starts closed and restores an open item visit",
            function()
                math.randomseed(149)
                local screen: game_screen.State = game_screen.State.new()
                expect(screen.shop.open):toBe(false)
                expect(#screen.shop.slots):toBe(0)

                screen.shop:open_for(screen.run)
                screen.shop.cursor = 1
                screen.shop.slots[1].sold = true
                local sections: {string} = screen:snapshot()
                local restored: game_screen.State? = game_screen.State.restore(
                    sections[1],
                    sections[2],
                    sections[3],
                    sections[4],
                    sections[5]
                )
                expect(restored == nil):toBe(false)
                if restored ~= nil then
                    local live: game_screen.State = restored::game_screen.State
                    expect(live.shop.open):toBe(true)
                    expect(live.shop.cursor):toBe(1)
                    expect(live.shop.slots[1].sold):toBe(true)
                    expect(live.shop:snapshot()):toBe(sections[5])
                end
            end
        )
    end
)

describe(
    "Information controls during spell resolution",
    function(): unit
        it(
            "blocks retained help and ledger actions but preserves restart",
            function(): unit
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(181)
                screen.presentation:skip()
                screen:confirm_cast(0, 0)
                expect(screen:information_ready()):toBe(false)
                screen:perform_board_action(city, { kind = "help", index = 0 })
                expect(tostring(screen.ui.modal)):toBe("none")
                screen:perform_board_action(city, { kind = "history", index = 0 })
                expect(tostring(screen.ui.modal)):toBe("none")
                screen:keypressed(city, "?")
                screen:keypressed(city, "h")
                expect(tostring(screen.ui.modal)):toBe("none")
                expect(screen.presentation:firebolt_pending()):toBe(true)
                screen:perform_board_action(city, { kind = "restart", index = 0 })
                expect(screen.presentation:firebolt_pending()):toBe(false)
                expect(screen.spell_feedback):toBe("No spell cast.")
                screen.presentation:skip()
                expect(screen:information_ready()):toBe(true)
                screen:perform_board_action(city, { kind = "help", index = 0 })
                expect(tostring(screen.ui.modal)):toBe("help")
                screen:consume_gate(city, "advance")
                screen:perform_board_action(city, { kind = "history", index = 0 })
                expect(tostring(screen.ui.modal)):toBe("history")
            end
        )

        it(
            "burns and refills every table card a levelled Firebolt reached",
            function(): unit
                math.randomseed(107)
                local screen: game_screen.State = game_screen.State.new()
                local city: city_map.State = city_map.State.new(107)
                -- A bolt sharpened to three, aimed at the middle of the row:
                -- the aimed card and one neighbour on each side. The duel is
                -- redealt with that loadout, since a spell's level is dealt in
                -- rather than set on a live board.
                screen.rules:reset(
                    false,
                    {spells.Spell.new(spells.SpellKind.Firebolt, 3)},
                    game.starting_gold
                )
                finish_swap_phase(screen.rules)
                screen.presentation:skip()
                -- Copies, not the row itself: what the burn replaced has to
                -- survive the replacement to be compared against.
                local before: {game.Card} = {}
                for dealt in screen.rules:view().middle do
                    table.insert(before, card(dealt.rank, dealt.suit))
                end
                local deck_before: i32 = screen.rules:view().deck_count

                screen:confirm_cast(0, 2)
                expect(screen.spell_feedback):toBe("Firebolt completed on table cards 3, 4 and 2.")
                -- One tick past the whole burn hands all three slots back at
                -- once, and the replacements are on the board before the deal
                -- that shows them arriving has begun.
                screen:update(city, 10.0)

                local after: {game.Card} = screen.rules:view().middle
                expect(screen.rules:view().deck_count):toBe(deck_before - 3)
                for index = 1::i32, 5::i32 do
                    local same: bool = after[index].rank == before[index].rank and after[index].suit == before[index].suit
                    -- Slots 2, 3 and 4 — the aim and its neighbours — changed;
                    -- the two the level never reached did not.
                    expect(same):toBe(index == 1 or index == 5)
                end
                expect(#screen.presentation.session.discards):toBe(3)
            end
        )
    end
)
