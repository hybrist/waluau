-- Deterministic, DOM-free checks for the generated city map: its streets, the
-- route the duel walks through them, and the pans and dissolves that carry the
-- picture from one screen to the next.
require("waluau:vitest")

local city_map = require("./city_map")

-- Whether a point on the route is inside the rectangle the camera is showing.
-- Following a stop means putting it on the screen, which is a weaker and more
-- honest claim than a camera pinned to a coordinate the city edges can clamp.
function on_screen(state: city_map.State, point: city_map.Point): bool
    local screen_x: f64 = state.anchor_x + (point.x - state.camera_x) * state.zoom
    local screen_y: f64 = state.anchor_y + (point.y - state.camera_y) * state.zoom
    return screen_x >= 0.0 and screen_x <= state.view_width and screen_y >= 0.0 and screen_y <= state.view_height
end

function step_seconds(state: city_map.State, seconds: f64): unit
    local ticks: i32 = math.floor(seconds * 60.0)::i32
    for _ = 1, ticks do
        state:update(1.0 / 60.0)
    end
end

describe(
    "city map",
    function()
        it(
            "shares one seeded city between the camera route and renderer",
            function()
                local first = city_map.State.new(41)
                local second = city_map.State.new(41)
                expect(#first.route.city.buildings):toBeGreaterThan(0)
                expect(#second.route.city.nodes):toBe(#first.route.city.nodes)
                for index = 1::i32, #first.route.city.nodes do
                    expect(second.route.city.nodes[index].x):toBe(first.route.city.nodes[index].x)
                    expect(second.route.city.nodes[index].y):toBe(first.route.city.nodes[index].y)
                end
                for index = 1::i32, first:stop_count() do
                    expect(
                        second.route.stops[index].building
                    ):toBe(first.route.stops[index].building)
                    expect(second.route.stops[index].x):toBe(first.route.stops[index].x)
                    expect(second.route.stops[index].y):toBe(first.route.stops[index].y)
                end
                first:regenerate()
                expect(first.scenery_seed == second.scenery_seed):toBe(false)
                expect(first.route.city.options.seed):toBe(first.scenery_seed)
                expect(first.travel):toBe(0.0)
            end
        )

        it(
            "numbers the route so duels and the fences before them agree",
            function()
                expect(city_map.shop_stop(1)):toBe(0)
                expect(city_map.duel_stop(1)):toBe(1)
                expect(city_map.shop_stop(3)):toBe(4)
                expect(city_map.duel_stop(3)):toBe(5)
                expect(city_map.stop_duel(0)):toBe(1)
                expect(city_map.stop_duel(1)):toBe(1)
                expect(city_map.stop_duel(4)):toBe(3)
                expect(city_map.stop_duel(5)):toBe(3)

                -- Following a duel the route has not been walked out to still finds a
                -- stop there: the map extends itself rather than ending.
                local city: city_map.State = city_map.State.new(23)
                city:follow(city_map.duel_stop(40))
                expect(city:stop_count()):toBeGreaterThan(city_map.duel_stop(40))
            end
        )

        it(
            "pans slowly within the generated map while no route is followed",
            function()
                local city: city_map.State = city_map.State.new(52)
                city:resize(1050.0, 600.0)
                local start_x: f64 = city.camera_x
                local start_y: f64 = city.camera_y
                step_seconds(city, 10.0)

                expect(city.camera_x):toBeGreaterThan(start_x)
                expect(city.camera_y):toBeGreaterThan(start_y)
                -- The visible rectangle never runs off the generated city.
                expect(city.camera_x - city.anchor_x / city.zoom):toBeGreaterThanOrEqual(0.0)
                expect(
                    city.camera_x + (city.view_width - city.anchor_x) / city.zoom
                ):toBeLessThanOrEqual(city_map.width)
                expect(city.camera_y - city.anchor_y / city.zoom):toBeGreaterThanOrEqual(0.0)
                expect(
                    city.camera_y + (city.view_height - city.anchor_y) / city.zoom
                ):toBeLessThanOrEqual(city_map.height)
            end
        )

        it(
            "exposes additional city when the logical viewport grows",
            function()
                local city: city_map.State = city_map.State.new(53)
                city:resize(1200.0, 800.0)

                expect(city.view_width):toBe(1200.0)
                expect(city.view_height):toBe(800.0)
                step_seconds(city, 10.0)
                expect(city.camera_x - city.anchor_x / city.zoom):toBeGreaterThanOrEqual(0.0)
                expect(
                    city.camera_x + (city.view_width - city.anchor_x) / city.zoom
                ):toBeLessThanOrEqual(city_map.width)
                expect(city.camera_y - city.anchor_y / city.zoom):toBeGreaterThanOrEqual(0.0)
                expect(
                    city.camera_y + (city.view_height - city.anchor_y) / city.zoom
                ):toBeLessThanOrEqual(city_map.height)
            end
        )

        it(
            "walks to a followed stop instead of jumping to it",
            function()
                local city: city_map.State = city_map.State.new(64)
                city:resize(1050.0, 600.0)
                city:follow(4)

                city:update(1.0 / 60.0)
                expect(city.travel):toBeGreaterThan(0.0)
                expect(city.travel):toBeLessThan(4.0)

                step_seconds(city, 12.0)
                expect(city.travel):toBe(4.0)
                expect(on_screen(city, city:position())):toBe(true)

                -- The menu's drifting view and the first vendor are the same map, so
                -- aiming at the vendor moves the camera rather than replacing the
                -- picture.
                city:drift()
                step_seconds(city, 4.0)
                city:follow(city_map.shop_stop(1))
                step_seconds(city, 12.0)
                expect(city.travel):toBe(0.0)
                expect(on_screen(city, city:position())):toBe(true)
            end
        )

        it(
            "sets a restarted route down without walking the city back to it",
            function()
                local city: city_map.State = city_map.State.new(77)
                city:resize(1050.0, 600.0)
                city:follow(6)
                step_seconds(city, 12.0)

                city:warp(city_map.shop_stop(1))
                expect(city.travel):toBe(0.0)
                expect(on_screen(city, city:position())):toBe(true)
            end
        )

        it(
            "goes into the house before handing the screen to the duel",
            function()
                local city: city_map.State = city_map.State.new(88)
                city:warp(city_map.duel_stop(1))
                expect(city.cover):toBe(1.0)
                expect(city.zoom):toBe(1.0)
                expect(city:visible()):toBe(true)

                -- The first half of the dive is the camera closing on the house, with
                -- the map still holding the whole screen. A push in nobody can see is
                -- the cut this exists to avoid.
                city:hide()
                step_seconds(city, 0.25)
                expect(city.zoom):toBeGreaterThan(1.5)
                expect(city.cover):toBe(1.0)

                -- Then the duel takes over, and by the time it has the door is wide
                -- enough to be the frame around it.
                step_seconds(city, 0.3)
                expect(city.cover):toBeLessThan(1.0)
                expect(city.cover):toBeGreaterThan(0.0)
                expect(city:visible()):toBe(true)
                local midway: f64 = city.zoom

                step_seconds(city, 0.6)
                expect(city.cover):toBe(0.0)
                expect(city:visible()):toBe(false)
                expect(city.zoom):toBeGreaterThan(midway)
                -- Close enough that a map marker is the whole screen.
                expect(city.zoom):toBeGreaterThan(20.0)

                -- Coming back out runs the same movement backwards: the map has the
                -- screen again well before the camera has finished opening up.
                city:show()
                step_seconds(city, 0.45)
                expect(city.cover):toBe(1.0)
                expect(city.zoom):toBeGreaterThan(1.0)
                step_seconds(city, 0.5)
                expect(city.zoom):toBe(1.0)
            end
        )

        it(
            "walks to the door and dives in afterwards, never both at once",
            function()
                local city: city_map.State = city_map.State.new(31)
                city:warp(city_map.shop_stop(1))

                -- Asking for the next duel while standing at its shop is a walk
                -- first: the camera cannot go into a house the duel has not reached.
                city:follow(city_map.duel_stop(1))
                city:hide()
                step_seconds(city, 0.3)
                expect(city.travel):toBeGreaterThan(0.0)
                expect(city.travel):toBeLessThan(1.0)
                expect(city.zoom):toBe(1.0)
                expect(city.cover):toBe(1.0)

                step_seconds(city, 0.5)
                expect(city.travel):toBe(1.0)
                expect(city.zoom):toBeGreaterThan(1.0)
                step_seconds(city, 1.0)
                expect(city.zoom):toBeGreaterThan(20.0)

                -- And coming out of a duel the camera opens up before anyone steps
                -- into the street.
                city:follow(city_map.shop_stop(2))
                city:show()
                step_seconds(city, 0.4)
                expect(city.travel):toBe(1.0)
                expect(city.zoom):toBeGreaterThan(1.0)
                step_seconds(city, 1.4)
                expect(city.zoom):toBe(1.0)
                expect(city.travel):toBe(2.0)
            end
        )

        it(
            "turns around mid-dive instead of standing still",
            function()
                local city: city_map.State = city_map.State.new(57)
                city:warp(city_map.duel_stop(1))
                city:hide()
                step_seconds(city, 1.2)
                expect(city:visible()):toBe(false)

                -- Taking the verdict opens the shop before the next duel, so the
                -- camera starts back out onto that street.
                city:follow(city_map.shop_stop(2))
                city:show()
                step_seconds(city, 0.05)
                expect(city.dive):toBeLessThan(1.0)
                expect(city.dive):toBeGreaterThan(0.0)

                -- Leaving that shop before the pull-out has finished asks for a
                -- house the walk has not reached. The camera owes an exit and a
                -- walk and a dive, and it still gets through all three.
                city:follow(city_map.duel_stop(2))
                city:hide()
                step_seconds(city, 4.0)
                expect(city.travel):toBe(3.0)
                expect(city.cover):toBe(0.0)
                expect(city:visible()):toBe(false)
            end
        )

        it(
            "settles a dissolve that has nothing to play for",
            function()
                local city: city_map.State = city_map.State.new(99)
                city:resize(1050.0, 600.0)
                city:follow(5)
                city:hide()
                city:settle()

                expect(city.cover):toBe(0.0)
                expect(city.travel):toBe(5.0)
                expect(on_screen(city, city:position())):toBe(true)
            end
        )

        it(
            "does not consume gameplay randomness while it animates",
            function()
                math.randomseed(91)
                local seed: i32 = math.random(2147483646)
                local expected_next: i32 = math.random(2147483646)

                math.randomseed(91)
                local city: city_map.State = city_map.State.new(math.random(2147483646))
                city:update(2.0)
                city:follow(city_map.duel_stop(6))
                city:update(9.0)
                expect(math.random(2147483646)):toBe(expected_next)
                -- Keep the sampled seed live so the compiler also pins its type.
                expect(seed):toBeGreaterThan(0)
            end
        )
    end
)
