require("waluau:vitest")

local choreography = require("./choreography")
local spells = require("./spells/spell")

describe("Ante Magic presentation choreography", function()
    it("resets duel presentation through one initializer and retains scratch geometry", function()
        local state: choreography.State = choreography.new()
        local baseline: string = choreography.snapshot(state)

        state.fan_parts = { 0.2, 0.4 }
        state.sheet.xs[0] = 321.0
        choreography.apply_power(state, spells.SpellKind.Firebolt, 1)
        choreography.finish_reveal(state)

        expect(choreography.snapshot(state) == baseline):toBe(false)
        expect(choreography.firebolt_pending(state)):toBe(true)
        expect(choreography.reveal_finished(state)):toBe(true)

        choreography.reset(state)

        expect(choreography.snapshot(state)):toBe(baseline)
        expect(#state.fan_parts):toBe(5)
        expect(choreography.firebolt_pending(state)):toBe(false)
        expect(choreography.reveal_finished(state)):toBe(false)
        expect(state.sheet.xs[0]):toBe(321.0)
    end)


    it("rejects invalid restored spell conditions", function()
        -- The same body with the condition intact restores, so each rejection
        -- below is the condition failing and not a malformed snapshot.
        local state: choreography.State = choreography.new()
        choreography.apply_power(state, spells.SpellKind.Firebolt, 1)
        local encoded: string = choreography.snapshot(state)
        expect(choreography.restore(encoded) == nil):toBe(false)
        -- A spell that does not exist, and a target past the community row.
        local unknown_kind: string = string.gsub(encoded, '"kind":%d+', '"kind":9')
        expect(choreography.restore(unknown_kind) == nil):toBe(true)
        local far_target: string = string.gsub(encoded, '"target":%d+', '"target":5')
        expect(choreography.restore(far_target) == nil):toBe(true)
    end)

    it("does not index a community slot after the board has cleared", function()
        local state: choreography.State = choreography.new()

        expect(choreography.update_power(state, 0, 0.016)):toBe(-1)
    end)

    it("clears a turn or river condition before drawing the next flop", function()
        local state: choreography.State = choreography.new()
        local baseline: string = choreography.snapshot(state)
        choreography.apply_power(state, spells.SpellKind.RaiseCard, 4)

        expect(choreography.snapshot(state) == baseline):toBe(false)
        expect(choreography.update_power(state, 3, 0.016)):toBe(-1)
        expect(choreography.snapshot(state)):toBe(baseline)
    end)
end)
