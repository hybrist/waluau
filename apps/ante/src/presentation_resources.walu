-- Resource lifetime and failure policy for Ante Magic presentation assets.
-- Engine callbacks ask this module to load, prepare, unlock, play, diagnose,
-- and dispose; source/GPU ownership no longer leaks across the entry module.
local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local resources = require("waluau:engine/resources")
local audio = require("waluau:engine/audio")
local assets = require("waluau:assets")
local shader_program = require("./shader_program")
local failure = require("./presentation/failure")
local ui = require("./ui/node")
local layout = require("./layout")
local ink = require("./ink")

export type State = {
    bundle: assets.Bundle?,
    texture: graphics_module.Texture?,
    suit_texture: graphics_module.Texture?,
    face_texture: graphics_module.Texture?,
    noise_texture: graphics_module.Texture?,
    font: graphics_module.Font?,
    graphics: engine.Graphics?,
    load_finished: bool,
    audio_unlocked: bool,
    fatal_shader_error: string,
    fatal_audio_code: string,
    fatal_audio_message: string,
    -- Resource failures are historical; shader diagnostics instead describe
    -- only the current live revision so a valid HMR edit can clear them.
    warnings: string,
    shader_warnings: string,
    reduced_motion: bool
}

const SOUND_PATH: string = "assets/card-flip.wav"
const FLIP_SOUND_VOLUME: f64 = 0.62

function State.new(): State
    return {
        bundle = nil,
        texture = nil,
        suit_texture = nil,
        face_texture = nil,
        noise_texture = nil,
        font = nil,
        graphics = nil,
        load_finished = false,
        audio_unlocked = false,
        fatal_shader_error = "",
        fatal_audio_code = "",
        fatal_audio_message = "",
        warnings = "",
        shader_warnings = "",
        -- Read once: the preference is the viewer's, not the frame's, and a
        -- change mid-session takes effect with the next load.
        reduced_motion = engine.prefers_reduced_motion()
    }
end

function State:append_warning(warning: string): unit
    if #self.warnings > 0 then
        self.warnings ..= "; "
    end
    self.warnings ..= warning
end

function State:fatal_audio(code: string, message: string): unit
    if #self.fatal_audio_code > 0 then
        return
    end
    self.fatal_audio_code = code
    self.fatal_audio_message = message
end

function State:load_async(): i32
    local result: assets.LoadResult = assets.load()
    self.bundle = result.bundle
    self.load_finished = true
    for _, error in result.errors do
        if error.path == SOUND_PATH then
            self:fatal_audio(error.code, error.message)
        else
            self:append_warning(error.code .. ": " .. error.message)
        end
    end
    return 0
end

function State:prepare(graphics: engine.Graphics): unit
    self.graphics = graphics
    local shader_diagnostics: shader_program.Diagnostics = shader_program.compile(graphics)
    self.fatal_shader_error = shader_diagnostics.fatal_error
    if shader_diagnostics.warnings ~= self.shader_warnings then
        self.shader_warnings = shader_diagnostics.warnings
        if #self.shader_warnings > 0 then
            print("ante: optional shader warning: " .. self.shader_warnings)
        end
    end
    local maybe_bundle: assets.Bundle? = self.bundle
    if maybe_bundle ~= nil then
        local bundle: assets.Bundle = maybe_bundle::assets.Bundle
        local maybe_image: resources.ImageResource? = bundle.card_back
        if maybe_image ~= nil then
            local source: resources.ImageResource = maybe_image::resources.ImageResource
            local result: graphics_module.TextureResult = graphics:texture_from_image(source)
            resources.release_image(source)
            bundle.card_back = nil
            if result.ok then
                self.texture = result.texture
            else
                self:append_warning(result.error.code .. ": " .. result.error.message)
            end
        end
        local maybe_suits: resources.ImageResource? = bundle.suit_symbols
        if maybe_suits ~= nil then
            local source: resources.ImageResource = maybe_suits::resources.ImageResource
            local result: graphics_module.TextureResult = graphics:texture_from_image(source)
            resources.release_image(source)
            bundle.suit_symbols = nil
            if result.ok then
                self.suit_texture = result.texture
            else
                self:append_warning(result.error.code .. ": " .. result.error.message)
            end
        end
        local maybe_faces: resources.ImageResource? = bundle.face_cards
        if maybe_faces ~= nil then
            local source: resources.ImageResource = maybe_faces::resources.ImageResource
            local result: graphics_module.TextureResult = graphics:texture_from_image(source)
            resources.release_image(source)
            bundle.face_cards = nil
            if result.ok then
                self.face_texture = result.texture
            else
                self:append_warning(result.error.code .. ": " .. result.error.message)
            end
        end
        local maybe_noise: resources.ImageResource? = bundle.ice_noise
        if maybe_noise ~= nil then
            local source: resources.ImageResource = maybe_noise::resources.ImageResource
            local result: graphics_module.TextureResult = graphics:texture_from_image(source)
            resources.release_image(source)
            bundle.ice_noise = nil
            if result.ok then
                self.noise_texture = result.texture
            else
                self:append_warning(result.error.code .. ": " .. result.error.message)
            end
        end
        local maybe_font_source: resources.FontResource? = bundle.vault_font
        if maybe_font_source ~= nil then
            local source: resources.FontResource = maybe_font_source::resources.FontResource
            local result: graphics_module.FontResult = graphics:font_from_typed_resource(source)
            resources.release_font(source)
            bundle.vault_font = nil
            if result.ok then
                self.font = result.font
            else
                self:append_warning(result.error.code .. ": " .. result.error.message)
            end
        end
    end

    local maybe_font: graphics_module.Font? = self.font
    local custom_font_ready: bool = false
    if maybe_font ~= nil then
        custom_font_ready = graphics:set_font_resource(maybe_font::graphics_module.Font, 14.0)
    end
    if not custom_font_ready then
        graphics:use_builtin_font()
    end
end

function State:unlock_audio(): bool
    if self.audio_unlocked then
        return true
    end
    if not audio.unlock() then
        self:fatal_audio("unavailable", "the audio host could not unlock its playback device")
        return false
    end
    self.audio_unlocked = true
    return true
end

function State:play_flip(): unit
    if #self.fatal_audio_code > 0 then
        return
    end
    local maybe_bundle: assets.Bundle? = self.bundle
    if maybe_bundle == nil then
        self:fatal_audio("invalid_handle", "decoded card flip sound has no resource handle")
        return
    end
    local maybe_sound: resources.SoundResource? = (maybe_bundle::assets.Bundle).card_flip
    if maybe_sound == nil then
        self:fatal_audio("invalid_handle", "decoded card flip sound has no resource handle")
        return
    end
    if not audio.play_sound(maybe_sound::resources.SoundResource, false, FLIP_SOUND_VOLUME) then
        print("ante: the audio host refused to start decoded sound playback")
    end
end

function State:can_update(): bool
    return #self.fatal_audio_code == 0 and self.load_finished and self.audio_unlocked
end

-- The surface every entity draws on: live graphics and the packaged textures
-- that have arrived. Shader imports live in their rendering modules instead.
function State:surface(graphics: engine.Graphics): ui.Surface
    return {
        graphics = graphics,
        card_back = self.texture,
        suit_symbols = self.suit_texture,
        face_cards = self.face_texture,
        ice_noise = self.noise_texture,
        reduced_motion = self.reduced_motion
    }
end

local function draw_loading(graphics: engine.Graphics, viewport: layout.State): unit
    graphics:set_color("#fbbf24")
    graphics:fill_rectangle(viewport.center_x - 36.0, viewport.center_y - 1.0, 72.0, 2.0)
    ink.text_centered(
        graphics,
        "PREPARING THE DUEL",
        viewport.center_x,
        viewport.center_y + 28.0,
        11.0,
        "#a1a1aa"
    )
end

-- Covers the game until its first complete presentation can be drawn. Shader
-- compilation and font upload happen in prepare immediately before this call,
-- so clearing the gate guarantees the menu never appears in the fallback font.
function State:draw_status(graphics: engine.Graphics): bool
    local board: ui.Surface = self:surface(graphics)
    local viewport: layout.State = layout.current()
    if #self.fatal_shader_error > 0 then
        failure.shader(board, viewport, self.fatal_shader_error)
        return true
    end
    if #self.fatal_audio_code > 0 then
        failure.audio(board, viewport, SOUND_PATH, self.fatal_audio_code, self.fatal_audio_message)
        return true
    end
    if not self.load_finished then
        draw_loading(graphics, viewport)
        return true
    end
    return false
end

function State:dispose(): unit
    local maybe_graphics: engine.Graphics? = self.graphics
    if maybe_graphics ~= nil then
        local graphics: engine.Graphics = maybe_graphics::engine.Graphics
        local maybe_texture: graphics_module.Texture? = self.texture
        if maybe_texture ~= nil then
            graphics:release_texture(maybe_texture::graphics_module.Texture)
            self.texture = nil
        end
        local maybe_suits: graphics_module.Texture? = self.suit_texture
        if maybe_suits ~= nil then
            graphics:release_texture(maybe_suits::graphics_module.Texture)
            self.suit_texture = nil
        end
        local maybe_faces: graphics_module.Texture? = self.face_texture
        if maybe_faces ~= nil then
            graphics:release_texture(maybe_faces::graphics_module.Texture)
            self.face_texture = nil
        end
        local maybe_noise: graphics_module.Texture? = self.noise_texture
        if maybe_noise ~= nil then
            graphics:release_texture(maybe_noise::graphics_module.Texture)
            self.noise_texture = nil
        end
        local maybe_font: graphics_module.Font? = self.font
        if maybe_font ~= nil then
            graphics:release_font(maybe_font::graphics_module.Font)
            self.font = nil
        end
        self.graphics = nil
    end
    local maybe_bundle: assets.Bundle? = self.bundle
    if maybe_bundle ~= nil then
        resources.release_owner((maybe_bundle::assets.Bundle).owner)
        self.bundle = nil
    end
end
