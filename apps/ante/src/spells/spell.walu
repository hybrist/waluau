-- What a freshly learned spell charges per cast, before a run sharpens it.
const DEFAULT_SPELL_COST: i32 = 5

export enum SpellKind { Firebolt, FreezeRay, RaiseCard, Clone, DrainLife, SecondWind, Wither }

function SpellKind.from(value: i32): SpellKind?
    if value == 1 then
        return SpellKind.Firebolt
    end
    if value == 2 then
        return SpellKind.FreezeRay
    end
    if value == 3 then
        return SpellKind.RaiseCard
    end
    if value == 4 then
        return SpellKind.Clone
    end
    if value == 5 then
        return SpellKind.DrainLife
    end
    if value == 6 then
        return SpellKind.SecondWind
    end
    if value == 7 then
        return SpellKind.Wither
    end
    return nil
end

-- Whether a value that arrived through a decoder names a spell this build
-- knows. JSON unpacking checks an enum's shape (an integer), not its domain,
-- so a restore asks this before trusting a kind.
function SpellKind.valid(value: SpellKind): bool
    for _, member in pairs(SpellKind) do
        if value == member then
            return true
        end
    end
    return false
end

function SpellKind:__tostring(): string
    if self == SpellKind.Firebolt then
        return "Firebolt"
    elseif self == SpellKind.FreezeRay then
        return "Freeze Ray"
    elseif self == SpellKind.RaiseCard then
        return "Raise Card"
    elseif self == SpellKind.Clone then
        return "Clone"
    elseif self == SpellKind.DrainLife then
        return "Drain Life"
    elseif self == SpellKind.SecondWind then
        return "Second Wind"
    elseif self == SpellKind.Wither then
        return "Wither"
    else
        return "Unknown Spell"
    end
end

-- Only these four are offered when starting a run; shops use the full enum.
const STARTING_SPELL_COUNT: i32 = 4

function SpellKind:targets_hand(): bool
    return self == SpellKind.DrainLife or self == SpellKind.SecondWind
end

function SpellKind:description(): string
    if self == SpellKind.DrainLife then
        return "Hand ranks -1 (min 2); heal 1 heart. Needs missing health."
    elseif self == SpellKind.SecondWind then
        return "Weakest hand card +level ranks (max Ace)."
    elseif self == SpellKind.Wither then
        return "Table card -level ranks (min 2)."
    end
    return ""
end

export type Spell = { kind: SpellKind, cost: i32, level: i32 }

function Spell.new(kind: SpellKind, level: i32): Spell
    return { kind = kind, cost = DEFAULT_SPELL_COST, level = level }
end

return { DEFAULT_SPELL_COST = DEFAULT_SPELL_COST, starting_spell_count = STARTING_SPELL_COUNT }
