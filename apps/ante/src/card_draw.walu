-- A card being drawn off the deck, as one throw and a landing.
--
-- The shape of the card at any instant is card_warp's business; this module
-- decides what that shape should be at a given moment, which is the whole of
-- the animation. The draw is one flight rather than a chain of beats handing
-- off to each other: progress toward the target, height off the surface and
-- the turn are each a single eased curve over the same clock, so the card
-- never stops to change its mind mid-air. It sweeps off the deck rising
-- toward the viewer, turns over past its leading edge as it crosses its
-- destination, overshoots the spot by a little, and drops the last of the
-- way nearly straight down onto it.
--
-- The beats:
--
--   flight   the whole throw: sweep, rise, turn, overshoot, drop
--   land     the card has hit; it pays for the stop and recovers
--   hover    it is held there, breathing, by whatever caught it
--
-- Nothing in here draws, so where the beats sit in time can be read off the
-- source instead of inferred from a canvas.
local card_warp = require("./card_warp")

-- Beat boundaries, in seconds from the start of the draw.
const FLIGHT_END: f64 = 0.58
const LAND_END: f64 = 0.70
-- How long the card hovers before the story starts over.
const HOVER_SECONDS: f64 = 1.9

-- The sweep: ease_out_back of part^FLIGHT_ATTACK. The attack keeps the card
-- from teleporting out of the deck — it leaves from rest — and the back ease
-- carries it past the mark near the end and settles it back on. The overshoot
-- is what replaced being stopped short and carried the rest of the way: a
-- thrown card does not pause outside its destination, it arrives with the
-- momentum it was thrown with and gives the excess back. How far past the
-- mark it goes is the draw's own dial, not a constant here.
const FLIGHT_ATTACK: f64 = 1.8

-- The turn, as part^FLIP_ATTACK of a half turn. Negative, so the leading
-- edge sweeps toward the viewer — the card turns over the way it is already
-- moving, not against it. The power keeps it to a lean while the card is
-- climbing, brings it edge on just past the target, and leaves the second
-- half of the turn to happen on the way down, which is what makes the drop
-- read as the turn slamming shut rather than as a separate landing.
const FLIP_ATTACK: f64 = 2.4

-- The corner a hand would take for this throw: nearest the direction the
-- card leaves in. Pulling the bottom right corner was the first thing tried,
-- and it reads as the card being dragged across itself.
const GRAB_U: f64 = 1.0
const GRAB_V: f64 = 0.0
-- How far the held corner gets ahead of the sheet at the height of the pull,
-- in logical pixels. The stretch limit is what actually decides how much of
-- this reaches the card.
const PULL_REACH: f64 = 78.0
-- The share of the flight the corner's lead lives in. The lead is an arc
-- over this window — nothing at either end — and it is over before the turn
-- takes the card, so the sheet the flip gets is a clean one.
const PULL_SPAN: f64 = 0.6

-- How hard travel stretches the sheet into its own direction, per unit of
-- screen speed measured against the whole sweep's distance. The stretch
-- follows the actual velocity of the flight, so it grows through the middle
-- where the card is fastest and is gone by the time it lands.
const STRETCH_GAIN: f64 = 0.06
const STRETCH_LIMIT: f64 = 1.18

-- The landing, paid for across the direction the card arrived along and in
-- a little overall size — a card stopped flat against a surface has nowhere
-- to squash to but outward.
const LAND_SQUASH: f64 = 0.1
const LAND_SPLAT: f64 = 0.045

-- The two turns the hover breathes with, at periods that do not divide into
-- each other, so the loop never lands where the eye can find it.
const HOVER_TILT_PERIOD: f64 = 3.1
const HOVER_FLIP_PERIOD: f64 = 4.7
const HOVER_RISE_PERIOD: f64 = 2.3
const HOVER_TILT: f64 = 0.085
const HOVER_FLIP: f64 = 0.11
const HOVER_RISE: f64 = 2.6

-- Which beat a clock is in, and how far through it. Past the end everything
-- reads as the hover, because the hover is where the animation lives once it
-- has finished happening.
type BeatIndex = "flight" | "land" | "hover"

type Beat = { index: BeatIndex, part: f64 }

function span(clock: f64, from: f64, to: f64): f64
    local part: f64 = (clock - from) / (to - from)
    if part < 0.0 then
        return 0.0
    end
    if part > 1.0 then
        return 1.0
    end
    return part
end

function beat_at(clock: f64): Beat
    if clock < FLIGHT_END then
        return { index = "flight", part = span(clock, 0.0, FLIGHT_END) }
    end
    if clock < LAND_END then
        return { index = "land", part = span(clock, FLIGHT_END, LAND_END) }
    end
    return { index = "hover", part = clock - LAND_END }
end

function total_seconds(): f64
    return LAND_END + HOVER_SECONDS
end

-- Out and back: nothing at either end, everything in the middle. The pull's
-- lead and the landing's squash are both this shape, because both are a
-- departure from a pose that has to return to it.
function ease_arc(t: f64): f64
    return math.sin(t * math.pi)
end

-- A settling overshoot: past the mark and back to it. This is the far end of
-- the sweep — the difference between arriving and being parked. The
-- coefficient decides how far past; zero of it is a plain cubic ease out.
function ease_out_back(t: f64, back: f64): f64
    local past: f64 = t - 1.0
    return 1.0 + (back + 1.0) * past * past * past + back * past * past
end

-- How far past the mark a given coefficient carries the curve, at the top of
-- its excursion. The curve's own turning point, evaluated.
function back_excess(back: f64): f64
    local turning: f64 = -2.0 * back / (3.0 * (back + 1.0))
    return (back + 1.0) * turning * turning * turning + back * turning * turning
end

-- The coefficient for a wanted excess. The dial the animation is tuned by is
-- the honest number — how far past its spot the card may go, as a share of
-- the journey — and the coefficient grows with it but not linearly, with no
-- closed form the other way. Bisection instead: the excess is monotone in
-- the coefficient, and two dozen halvings pin it far inside what a pixel can
-- show.
function back_coefficient(overshoot: f64): f64
    if overshoot <= 0.0 then
        return 0.0
    end
    local low: f64 = 0.0
    local high: f64 = 8.0
    for _ = 1, 24 do
        local middle: f64 = (low + high) * 0.5
        if back_excess(middle) < overshoot then
            low = middle
        else
            high = middle
        end
    end
    return (low + high) * 0.5
end

-- Where the deck sits and where the card lands, both as the card's centre —
-- and the dials of the throw itself, carried with it so a story can put
-- sliders on them.
export type Arc = "even" | "late" | "very-late" | "early"

export type Draw = {
    from_x: f64,
    from_y: f64,
    to_x: f64,
    to_y: f64,
    width: f64,
    height: f64,
    stretch_limit: f64,
    -- How far past its landing spot the sweep may carry the card, as a share
    -- of the whole journey. Zero is a card that pulls up exactly on the mark.
    overshoot: f64,
    -- How high the card gets off the surface at the top of its arc, in
    -- logical pixels of depth toward the viewer — against the pose's 900
    -- pixel focal length, 270 reads as about two fifths larger. The rise is
    -- a half sine over the flight: leaving the surface is the first thing
    -- the card does and falling back to it is the last, and because the
    -- sweep has all but arrived by then, the final approach is nearly all
    -- descent.
    rise: f64,
    -- When the top of the arc comes: one of the arc_* shapes below.
    arc: Arc
}

-- The shapes the arc can take. The height is always a half sine — off the
-- surface first thing, back onto it last — but the clock that sine runs on
-- can be warped, which moves the apex in time without touching the ends.
-- Even is the plain sine, whose middle reads nearly linear. Late and very
-- late hold the card low while it accelerates and lob it up just before the
-- turn — the rise easing in — and pay for the late apex with a steeper
-- drop, which is where the slam lives. Early throws the card high at once
-- and lets it drift down.
function arc_warp(arc: Arc, part: f64): f64
    if arc == "late" then
        return part * part
    end
    if arc == "very-late" then
        return part * part * part
    end
    if arc == "early" then
        local inverse: f64 = 1.0 - part
        return 1.0 - inverse * inverse
    end
    return part
end

type Point3 = { x: f64, y: f64, z: f64 }

-- Where the card is at a moment of the flight, in all three dimensions:
-- the sweep across the screen and the arc off the surface, one point.
function Draw:flight_at(part: f64): Point3
    local swept: f64 = ease_out_back(part ^ FLIGHT_ATTACK, back_coefficient(self.overshoot))
    return {
        x = self.from_x + (self.to_x - self.from_x) * swept,
        y = self.from_y + (self.to_y - self.from_y) * swept,
        z = self.rise * ease_arc(arc_warp(self.arc, part))
    }
end

-- The flight's velocity, in logical pixels per unit of flight, by sampling
-- the curve either side of the moment. Everything the sheet does — which way
-- the corner leads, which way the stretch runs, how hard — is read off this,
-- which is what makes the deformation follow the momentum instead of being
-- choreographed beside it.
const SPEED_EPSILON: f64 = 0.01

function Draw:velocity_at(part: f64): Point3
    local before: f64 = part - SPEED_EPSILON
    local after: f64 = part + SPEED_EPSILON
    if before < 0.0 then
        before = 0.0
    end
    if after > 1.0 then
        after = 1.0
    end
    if after <= before then
        return { x = 0.0, y = 0.0, z = 0.0 }
    end
    local a: Point3 = self:flight_at(before)
    local b: Point3 = self:flight_at(after)
    local window: f64 = after - before
    return { x = (b.x - a.x) / window, y = (b.y - a.y) / window, z = (b.z - a.z) / window }
end

-- How far the sheet has caught up with the held corner, over the pull's own
-- window. It starts well behind — the corner accelerates away and the body
-- has inertia — draws level partway through, whips past as the lead begins
-- to die, and is exactly level again as the lead reaches zero. One quadratic
-- through those three states, no seams.
function follow_at(w: f64): f64
    return 0.3 + 2.4 * w - 1.7 * w * w
end

-- The whole pose, at one moment. The hover is not a fourth beat so much as
-- what the card does once there is nothing left to do to it.
function Draw:pose_at(clock: f64): card_warp.Pose
    local beat: Beat = beat_at(clock)
    local pose: card_warp.Pose = card_warp.Pose.rest(self.width, self.height, self.to_x, self.to_y)
    pose.grab_u = GRAB_U
    pose.grab_v = GRAB_V
    pose.stretch_limit = self.stretch_limit

    if beat.index == "flight" then
        local here: Point3 = self:flight_at(beat.part)
        pose.center_x = here.x
        pose.center_y = here.y
        pose.rise = here.z
        pose.flip = -math.pi * (beat.part ^ FLIP_ATTACK)

        local vel: Point3 = self:velocity_at(beat.part)
        local speed: f64 = math.sqrt(vel.x * vel.x + vel.y * vel.y + vel.z * vel.z)

        -- The corner's lead, along the direction the card is actually going —
        -- off the surface included, which is most of the direction at first.
        local w: f64 = beat.part / PULL_SPAN
        if w > 1.0 then
            w = 1.0
        end
        local reach: f64 = PULL_REACH * ease_arc(w)
        pose.follow = follow_at(w)
        if speed > 0.0 and reach > 0.0 then
            pose.pull_x = vel.x / speed * reach
            pose.pull_y = vel.y / speed * reach
            pose.pull_z = vel.z / speed * reach
        end

        -- Travel's stretch, along the screen part of the motion and sized by
        -- it. The z part of the momentum already shapes the sheet through the
        -- pull; the in-plane stretch answers to the in-plane speed.
        local run_x: f64 = self.to_x - self.from_x
        local run_y: f64 = self.to_y - self.from_y
        local run: f64 = math.sqrt(run_x * run_x + run_y * run_y)
        local flat: f64 = math.sqrt(vel.x * vel.x + vel.y * vel.y)
        if run > 0.0 and flat > 0.0 then
            pose.axis_x = vel.x
            pose.axis_y = vel.y
            local stretched: f64 = 1.0 + STRETCH_GAIN * flat / run
            if stretched > STRETCH_LIMIT then
                stretched = STRETCH_LIMIT
            end
            pose.axial = stretched
        end

        -- Leaning into the throw while the pull has the card, and out of it
        -- as the lead dies — from there the turn is the only rotation.
        local lean: f64 = reach / PULL_REACH
        pose.roll = 0.14 * lean
        pose.tilt = -0.2 * lean
    elseif beat.index == "land" then
        pose.flip = -math.pi
        local hit: f64 = ease_arc(beat.part)
        pose.axis_x = self.to_x - self.from_x
        pose.axis_y = self.to_y - self.from_y
        pose.axial = 1.0 - LAND_SQUASH * hit
        pose.scale = 1.0 + LAND_SPLAT * hit
    else
        local held: f64 = beat.part
        pose.tilt = HOVER_TILT * math.sin(held * math.pi * 2.0 / HOVER_TILT_PERIOD)
        pose.flip = -math.pi + HOVER_FLIP * math.sin(held * math.pi * 2.0 / HOVER_FLIP_PERIOD)
        pose.center_y = self.to_y + HOVER_RISE * math.sin(held * math.pi * 2.0 / HOVER_RISE_PERIOD)
        -- A card held in the air is never quite still and never quite the same
        -- size, because whatever is holding it is not a hand.
        pose.scale = 1.0 + 0.012 * math.sin(held * math.pi * 2.0 / HOVER_FLIP_PERIOD)
    end
    return pose
end

-- Whether the card at this moment shows the face the deck was hiding. The
-- pose knows how far it has turned; this is only about which texture goes on
-- the sheet.
function Draw:shows_face(clock: f64): bool
    return not self:pose_at(clock):facing_front()
end

-- How far back the ghosts of the flying card are, in seconds. Two frames and
-- change: far enough back to read as speed, near enough that they are still
-- the same card and not a second one left behind at the deck.
function ghost_offsets(): {f64}
    return {0.032, 0.016}
end

-- The window of the flight fast enough to leave anything behind it: after
-- the card has properly left the deck and before the overshoot has given its
-- momentum back. A ghost only belongs to the card if the moment it echoes is
-- inside that window too.
const TRAIL_FROM: f64 = 0.1
const TRAIL_UNTIL: f64 = 0.5

function trails(clock: f64): bool
    return clock > TRAIL_FROM and clock < TRAIL_UNTIL
end

function ghost_visible(clock: f64): bool
    return clock > TRAIL_FROM * 0.5 and clock < TRAIL_UNTIL
end

return {
    beat_at = beat_at,
    trails = trails,
    ghost_offsets = ghost_offsets,
    ghost_visible = ghost_visible,
    total_seconds = total_seconds,
    flight_end = FLIGHT_END,
    land_end = LAND_END
}
