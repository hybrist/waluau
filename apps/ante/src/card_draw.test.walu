-- Where the drawn card is, beat by beat. The shape of the card is checked in
-- card_warp.test.walu; what this file is about is the path, because a card
-- that arrives at the right pose by way of the wrong route still looks wrong.

require("waluau:vitest")

local card_draw = require("./card_draw")
local card_warp = require("./card_warp")

const DECK_X: f64 = 168.0
const DECK_Y: f64 = 322.0
const CAUGHT_X: f64 = 505.0
const CAUGHT_Y: f64 = 196.0
const CARD_W: f64 = 104.0
const CARD_H: f64 = 128.0
const SAMPLES: i32 = 240
-- How far the middle of the card is allowed to slip backwards between two
-- samples, in logical pixels. It is not zero because the perspective divide
-- is not linear: the flip and the rise both move the projected centre a
-- little without the travel knowing anything about it, and that residue
-- measures a couple of pixels while the backtracking this test is here to
-- catch measured about twenty.
const BACKSTEP: f64 = 2.5

function thrown(overshoot: f64, rise: f64): card_draw.Draw
    return {
        from_x = DECK_X,
        from_y = DECK_Y,
        to_x = CAUGHT_X,
        to_y = CAUGHT_Y,
        width = CARD_W,
        height = CARD_H,
        stretch_limit = 1.26,
        overshoot = overshoot,
        rise = rise,
        arc = card_draw.arc_very_late
    }
end

function drawing(): card_draw.Draw
    return thrown(0.3, 270.0)
end

-- Where the card actually appears to be: the middle of the shape on screen,
-- not the pose's centre. The two are only the same because the pull is
-- centroid-free, and it is exactly that difference this file is here to
-- watch — a deformation that drags the card along with it moves the card
-- without the travel knowing anything about it.
const COLUMNS: i32 = 10
const ROWS: i32 = 14

function seen_at(clock: f64): card_warp.Mesh
    local mesh: card_warp.Mesh = card_warp.new_mesh(COLUMNS, ROWS)
    card_warp.build(mesh, card_draw.pose_at(drawing(), clock))
    return mesh
end

function journey_length(): f64
    local run_x: f64 = CAUGHT_X - DECK_X
    local run_y: f64 = CAUGHT_Y - DECK_Y
    return math.sqrt(run_x * run_x + run_y * run_y)
end

-- How far along the deck-to-landing line the card has got. The throw leaves
-- at an angle to that line, so this is not the whole story of where the card
-- is — but it is the axis the whole animation is a journey along, and a card
-- that goes backwards along it before it has arrived is a card that has
-- backtracked.
function progress(clock: f64): f64
    local mesh: card_warp.Mesh = seen_at(clock)
    local count: i32 = card_warp.point_count(COLUMNS, ROWS)
    local middle_x: f64 = 0.0
    local middle_y: f64 = 0.0
    for index = 0::i32, count - 1 do
        middle_x += mesh.xs[index]
        middle_y += mesh.ys[index]
    end
    middle_x /= count::f64
    middle_y /= count::f64
    local run_x: f64 = CAUGHT_X - DECK_X
    local run_y: f64 = CAUGHT_Y - DECK_Y
    return ((middle_x - DECK_X) * run_x + (middle_y - DECK_Y) * run_y)
        / journey_length()
end

function pose(clock: f64): card_warp.Pose
    return card_draw.pose_at(drawing(), clock)
end

describe("the card's path out of the deck", function(): unit
    -- The overshoot is allowed to carry the card past its destination and
    -- back; what is never allowed is losing ground short of it. The card
    -- used to creep along the drag as the pull grew and slide back as it
    -- relaxed, so it left, returned to where it came from, and left again.
    it("never loses ground it has not yet arrived over", function(): unit
        local length: f64 = journey_length()
        local furthest: f64 = -BACKSTEP
        for step = 0::i32, SAMPLES do
            local clock: f64 = card_draw.land_end * (step::f64) / (SAMPLES::f64)
            local reached: f64 = progress(clock)
            if reached > length then reached = length end
            expect(reached):toBeGreaterThanOrEqual(furthest)
            furthest = reached - BACKSTEP
        end
    end)

    -- Being stopped short and carried the last of the way is what the throw
    -- replaced: the card arrives with its momentum, passes the spot, and
    -- gives the excess back.
    it("overshoots where it is going and settles back onto it", function(): unit
        local length: f64 = journey_length()
        local beyond: f64 = 0.0
        for step = 0::i32, SAMPLES do
            local clock: f64 = card_draw.flight_end * (step::f64) / (SAMPLES::f64)
            local past: f64 = progress(clock) - length
            if past > beyond then beyond = past end
        end
        expect(beyond):toBeGreaterThan(4.0)
        expect(pose(card_draw.land_end).center_x):toBeCloseTo(CAUGHT_X, 6)
        expect(pose(card_draw.land_end).center_y):toBeCloseTo(CAUGHT_Y, 6)
    end)

    -- The dial is the honest number: it promises the excess itself, as a
    -- share of the journey, not some curvature constant that merely grows
    -- with it. Measured off the pose's centre, where the sweep lives.
    it("overshoots by as much as it is asked to", function(): unit
        local length: f64 = journey_length()
        local asked: card_draw.Draw = thrown(0.1, 190.0)
        local beyond: f64 = 0.0
        for step = 0::i32, SAMPLES do
            local clock: f64 = card_draw.flight_end * (step::f64) / (SAMPLES::f64)
            local centre: card_warp.Pose = card_draw.pose_at(asked, clock)
            local run_x: f64 = CAUGHT_X - DECK_X
            local run_y: f64 = CAUGHT_Y - DECK_Y
            local past: f64 = ((centre.center_x - DECK_X) * run_x
                + (centre.center_y - DECK_Y) * run_y) / length - length
            if past > beyond then beyond = past end
        end
        expect(beyond):toBeGreaterThan(length * 0.098)
        expect(beyond):toBeLessThan(length * 0.102)
    end)

    it("pulls up exactly on the mark when asked not to overshoot", function(): unit
        local parked: card_draw.Draw = thrown(0.0, 190.0)
        local length: f64 = journey_length()
        for step = 0::i32, SAMPLES do
            local clock: f64 = card_draw.land_end * (step::f64) / (SAMPLES::f64)
            local centre: card_warp.Pose = card_draw.pose_at(parked, clock)
            local run_x: f64 = CAUGHT_X - DECK_X
            local run_y: f64 = CAUGHT_Y - DECK_Y
            local reached: f64 = ((centre.center_x - DECK_X) * run_x
                + (centre.center_y - DECK_Y) * run_y) / length
            expect(reached):toBeLessThanOrEqual(length + 0.000001)
        end
    end)

    it("leaves the deck from rest, exactly where the deck is", function(): unit
        expect(pose(0.0).center_x):toBeCloseTo(DECK_X, 6)
        expect(pose(0.0).center_y):toBeCloseTo(DECK_Y, 6)
        expect(pose(0.0).rise):toBeCloseTo(0.0, 6)
    end)

    it("is being held by the corner nearest the direction it is thrown", function(): unit
        expect(pose(0.2).grab_u):toBe(1.0)
        expect(pose(0.2).grab_v):toBe(0.0)
    end)
end)

describe("the card's arc off the surface", function(): unit
    it("rises toward the viewer and comes all the way back down", function(): unit
        expect(pose(card_draw.flight_end * 0.5).rise):toBeGreaterThan(100.0)
        expect(pose(card_draw.flight_end).rise):toBeCloseTo(0.0, 4)
        expect(pose(card_draw.land_end).rise):toBeCloseTo(0.0, 6)
    end)

    -- The rise dial is the apex itself. On the even arc that apex sits at
    -- the exact middle of the flight, where the unwarped half sine tops out.
    it("tops out at exactly the height it is asked for", function(): unit
        local high: card_draw.Draw = thrown(0.05, 320.0)
        high.arc = card_draw.arc_even
        local apex: f64 = card_draw.pose_at(high, card_draw.flight_end * 0.5).rise
        expect(apex):toBeCloseTo(320.0, 6)
        local flat: card_draw.Draw = thrown(0.05, 0.0)
        expect(card_draw.pose_at(flat, card_draw.flight_end * 0.5).rise):toBeCloseTo(0.0, 9)
    end)

    -- The arc dial only moves the apex in time. A late arc is still low at
    -- the middle of the flight and near its full height past it; an early
    -- one has already been up and is on its way down by the middle.
    it("puts the top of the arc where the dial asks", function(): unit
        local late: card_draw.Draw = thrown(0.05, 270.0)
        late.arc = card_draw.arc_late
        expect(card_draw.pose_at(late, card_draw.flight_end * 0.7).rise)
            :toBeGreaterThan(card_draw.pose_at(late, card_draw.flight_end * 0.5).rise)
        local early: card_draw.Draw = thrown(0.05, 270.0)
        early.arc = card_draw.arc_early
        expect(card_draw.pose_at(early, card_draw.flight_end * 0.3).rise)
            :toBeGreaterThan(card_draw.pose_at(early, card_draw.flight_end * 0.5).rise)
    end)

    -- The end of the flight is the slam: the sweep has all but arrived, so
    -- what is left of the motion is the drop.
    it("spends the last of the flight falling rather than travelling", function(): unit
        local late: f64 = card_draw.flight_end * 0.9
        local dropped: f64 = math.abs(
            pose(late).rise - pose(card_draw.flight_end).rise)
        local dx: f64 = pose(card_draw.flight_end).center_x - pose(late).center_x
        local dy: f64 = pose(card_draw.flight_end).center_y - pose(late).center_y
        local slid: f64 = math.sqrt(dx * dx + dy * dy)
        expect(dropped):toBeGreaterThan(slid * 2.0)
    end)
end)

describe("the card's turn", function(): unit
    -- The turn goes with the throw, not against it: the card is moving right,
    -- so the right edge is the one that comes toward the viewer. In the
    -- pose's terms that is a negative flip.
    it("turns over the way it is moving", function(): unit
        local mid: f64 = pose(card_draw.flight_end * 0.6).flip
        expect(mid):toBeLessThan(0.0)
        expect(mid):toBeGreaterThan(-math.pi)
        expect(pose(card_draw.flight_end).flip):toBeCloseTo(-math.pi, 6)
    end)

    -- Nearer is taller under the projection, so early in the turn the right
    -- edge of the mesh — the leading one — must be the taller of the two.
    it("sweeps its leading edge toward the viewer", function(): unit
        local mesh: card_warp.Mesh = seen_at(0.29)
        local left_top: i32 = 0
        local left_bottom: i32 = ROWS * (COLUMNS + 1)
        local right_top: i32 = COLUMNS
        local right_bottom: i32 = ROWS * (COLUMNS + 1) + COLUMNS
        local left: f64 = math.abs(mesh.ys[left_bottom] - mesh.ys[left_top])
        local right: f64 = math.abs(mesh.ys[right_bottom] - mesh.ys[right_top])
        expect(right):toBeGreaterThan(left)
    end)

    it("leaves the deck sealed and lands face up", function(): unit
        expect(card_draw.shows_face(drawing(), 0.0)):toBe(false)
        expect(card_draw.shows_face(drawing(), 0.2)):toBe(false)
        expect(card_draw.shows_face(drawing(), card_draw.land_end)):toBe(true)
    end)

    it("keeps the face up for the whole hover", function(): unit
        for step = 0::i32, 40::i32 do
            local clock: f64 = card_draw.land_end
                + (card_draw.total_seconds() - card_draw.land_end) * (step::f64) / 40.0
            expect(card_draw.shows_face(drawing(), clock)):toBe(true)
        end
    end)
end)
