-- Whole-screen appearance fixtures use the production screen renderers. The
-- scene owns a seeded run and an explicit presentation clock; no gameplay
-- test imports this module or depends on its resource barrier.
local engine = require("waluau:engine")
local storybook = require("waluau:engine/storybook")
local ui = require("./ui/node")
local box = require("./ui/layout")
local ui_story = require("./ui/story")
local layout = require("./layout")
local menu = require("./menu")
local game_screen = require("./game_screen")
local city_map = require("./city_map")
local city_map_render = require("./city_map_render")
local presentation_resources = require("./presentation_resources")
local ink = require("./ink")
local spells = require("./spells/spell")

type Mode = "menu" | "vendor" | "help" | "board" | "targeting" | "firebolt" | "loading" | "fatal"

local book = ui_story.Book.new()

function screen_scene(mode: Mode, width: f64, height: f64): storybook.Scene
    local city_view = city_map_render.State.new()
    local city = city_map.State.new(41)
    local options = menu.State.new()
    local duel = game_screen.State.new()
    local diagnostic = presentation_resources.State.new()

    local function load(): unit
        math.randomseed(12345.0)
        city = city_map.State.new(41)
        options = menu.State.new()
        duel = game_screen.State.new()
        diagnostic = presentation_resources.State.new()
        layout.update(width, height)
        local viewport = layout.current()
        city:resize(viewport.width, viewport.height)
        if mode == "vendor" then
            options:keypressed("Enter")
        end
        if mode == "menu" or mode == "vendor" then
            options:update(city, 0.0)
            city:settle()
        elseif mode == "fatal" then
            diagnostic:fatal_audio("http_error", "HTTP 404 while loading the required sound")
        elseif mode ~= "loading" then
            duel:reset(city, false, spells.SpellKind.Firebolt)
            duel.presentation:skip()
            if mode == "help" then
                duel:keypressed(city, "?")
            elseif mode == "targeting" then
                duel:arm_spell(0)
            elseif mode == "firebolt" then
                duel:arm_spell(0)
                duel:confirm_cast(0, 1)
            end
        end
    end

    local function update(dt: f64, input: engine.Input): unit
        if mode == "menu" or mode == "vendor" then
            options:update(city, dt)
            city:update(dt)
        elseif mode ~= "loading" and mode ~= "fatal" then
            duel:update(city, dt)
        end
    end

    local function paint(surface: ui.Surface, bounds: box.Rect): unit
        local graphics = surface.graphics
        layout.update(width, height)
        local viewport = layout.current()
        graphics:push()
        graphics:scale(viewport.scale, viewport.scale)
        if mode == "loading" or mode == "fatal" then
            if mode == "loading" then
                -- The live loading gate precedes the display-font upload.
                graphics:use_builtin_font()
            end
            diagnostic:draw_status(graphics)
        elseif mode == "menu" or mode == "vendor" then
            city_view:draw(city, graphics)
            options:draw(viewport, surface)
        else
            duel:draw_vault(surface)
        end
        graphics:pop()
    end

    local function node(): ui.Node
        return ui.Node.sized(width, height, paint)
    end

    return book:scene(
        {
            node = node,
            load = load,
            update = update,
            width = width,
            height = height,
            scale = 1.0,
            background = "#09090b"
        }
    )
end

storybook.publish(
    {
        storybook.story("Main menu", screen_scene("menu", 1200.0, 600.0)),
        storybook.story("Starting vendor", screen_scene("vendor", 1200.0, 600.0)),
        storybook.story("Help", screen_scene("help", 1000.0, 750.0)),
        storybook.story("Wide duel", screen_scene("board", 1200.0, 600.0)),
        storybook.story("Tall duel", screen_scene("board", 600.0, 800.0)),
        storybook.story("Targeting", screen_scene("targeting", 1000.0, 750.0)),
        storybook.story("Firebolt", screen_scene("firebolt", 1000.0, 750.0)),
        storybook.story("Loading", screen_scene("loading", 1000.0, 750.0)),
        storybook.story("Fatal audio", screen_scene("fatal", 1000.0, 750.0))
    }
)
