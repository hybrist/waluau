-- Deterministic test adapter for the deep rules module. Production enters
-- through shuffled deals; tests enter through explicit card and table_card layouts
-- without spreading mutable State setup across every scenario.

local game = require("../src/game")

function arrange_breach(
    state: game.State,
    middle: {game.Card},
    player_hand: {game.Card},
    computer_hand: {game.Card}
): unit
    game.test_arrange_round(state, middle, player_hand, computer_hand)
end

function arrange_arch_mage(
    state: game.State,
    middle: {game.Card},
    computer_hand: {game.Card}
): unit
    game.test_arrange_opponent(state, middle, computer_hand)
end

function arrange_player(
    state: game.State,
    player_hand: {game.Card},
    player_known: {bool}
): unit
    game.test_arrange_player(state, player_hand, player_known)
end

function set_player_points(state: game.State, points: i32): unit
    game.test_set_player_points(state, points)
end

-- Force a finished duel holding the given number of table cards for the Opponent,
-- so run-level tests reach a verdict without playing five rounds out.
function finish(state: game.State, computer_tricks: i32): unit
    game.test_finish(state, computer_tricks)
end

function set_swap_trace(
    state: game.State,
    hand_indices: {i32},
    middle_indices: {i32}
): unit
    game.test_set_swap_trace(state, hand_indices, middle_indices)
end

return {
    arrange_breach = arrange_breach,
    arrange_arch_mage = arrange_arch_mage,
    arrange_player = arrange_player,
    set_player_points = set_player_points,
    set_swap_trace = set_swap_trace,
    finish = finish,
}
