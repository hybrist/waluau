-- Deterministic test adapter for the deep rules module. Production enters
-- through shuffled deals; tests enter through explicit relic and ward layouts
-- without spreading mutable State setup across every scenario.

local game = require("../src/game")

function clone_cards(cards: {game.Card}): {game.Card}
    local copy: {game.Card} = {}
    for card in cards do table.insert(copy, { rank = card.rank, suit = card.suit }) end
    return copy
end

-- Hand slots for freshly arranged cards: nothing arranged this way has been
-- watched by the opponent yet.
function fresh_slots(cards: {game.Card}): {game.HandSlot}
    local slots: {game.HandSlot} = {}
    for card in cards do
        table.insert(slots, { card = { rank = card.rank, suit = card.suit }, known = false })
    end
    return slots
end

function arrange_breach(
    state: game.State,
    middle: {game.Card},
    player_hand: {game.Card},
    computer_hand: {game.Card}
): unit
    state.middle = clone_cards(middle)
    state.player_hand = fresh_slots(player_hand)
    state.computer_hand = fresh_slots(computer_hand)
end

function arrange_arch_mage(
    state: game.State,
    middle: {game.Card},
    computer_hand: {game.Card}
): unit
    state.middle = clone_cards(middle)
    state.computer_hand = fresh_slots(computer_hand)
end

function arrange_player(
    state: game.State,
    player_hand: {game.Card},
    player_known: {bool}
): unit
    local slots: {game.HandSlot} = fresh_slots(player_hand)
    for index, known in player_known do slots[index].known = known end
    state.player_hand = slots
end

function set_player_points(state: game.State, points: i32): unit
    state.player_points = points
end

function set_swap_trace(
    state: game.State,
    hand_indices: {i32},
    middle_indices: {i32}
): unit
    state.swap_hand_indices = hand_indices
    state.swap_middle_indices = middle_indices
end

return {
    arrange_breach = arrange_breach,
    arrange_arch_mage = arrange_arch_mage,
    arrange_player = arrange_player,
    set_player_points = set_player_points,
    set_swap_trace = set_swap_trace,
}
