-- Demo suite for the walu-test bridge: busted-style structure with
-- vitest-style matchers, compiled and run in the browser by vitest itself.
-- The describe/it/expect declarations come from externs/vitest.walu, which
-- the walu-test vite plugin appends to every *.test.walu file.

function add(a: i32, b: i32): i32
    return a + b
end

function greet(name: string): string
    return "hello " .. name
end

function clamp(value: f64, low: f64, high: f64): f64
    if value < low then return low end
    if value > high then return high end
    return value
end

describe("arithmetic", function(): unit
    it("adds integers", function(): unit
        expect(add(2, 2)):toBe(4)
        expect(add(-1, 1)):toBe(0)
    end)

    it("compares numbers", function(): unit
        expect(3.5):toBeGreaterThan(3)
        expect(2):toBeLessThanOrEqual(2)
        expect(0.1 + 0.2):toBeCloseTo(0.3)
        expect(add(20, 3)):notToBe(24)
    end)

    describe("clamp", function(): unit
        it("passes values inside the range through", function(): unit
            expect(clamp(0.5, 0, 1)):toBe(0.5)
        end)

        it("clamps values outside the range", function(): unit
            expect(clamp(-2, 0, 1)):toBe(0)
            expect(clamp(9, 0, 1)):toBe(1)
        end)
    end)
end)

describe("strings", function(): unit
    it("concatenates", function(): unit
        expect(greet("walu")):toBe("hello walu")
        expect(greet("walu")):toContain("walu")
        expect(greet("walu")):notToContain("goodbye")
        expect(greet("walu")):toHaveLength(10)
    end)
end)

describe("booleans", function(): unit
    it("checks truthiness", function(): unit
        expect(add(1, 1) == 2):toBeTruthy()
        expect(add(1, 1) == 3):toBeFalsy()
        expect(true):toBe(true)
        expect(false):toBe(false)
    end)
end)

describe("lifecycle hooks", function(): unit
    local counter: i32 = 0

    before_each(function(): unit
        counter = counter + 1
    end)

    it("runs before_each before the first test", function(): unit
        expect(counter):toBeGreaterThanOrEqual(1)
    end)

    it("runs before_each again for the next test", function(): unit
        expect(counter):toBeGreaterThanOrEqual(2)
    end)

    todo("after_all teardown assertions")
end)

xdescribe("skipped suite", function(): unit
    it("never runs", function(): unit
        expect(1):toBe(2)
    end)
end)

xit("skipped test never runs", function(): unit
    expect(1):toBe(2)
end)
