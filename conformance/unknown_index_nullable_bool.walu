-- Dynamic indexing over a `{bool?}` array held as `unknown`. A present element
-- must rebox through `$boxed_bool` (the canonical `unknown` form for booleans)
-- rather than leaking the typed nullable box or the raw i31 payload, so it
-- compares equal to a `true`/`false` literal.
--
-- `bool?` shares the i32 nullable box with `i32?`/`u32?`, whose array wrappers
-- canonicalize to the same wasm type (waluau-drtq), so this file deliberately
-- holds only one such array type.

function get(v, i)
    return v[i]
end

-- `{ true, nil, false }` does not infer as `{bool?}` yet (waluau-riyx), so the
-- nullable bool elements are produced by a helper instead.
function flag(present: bool, on: bool): bool?
    if present then
        return on
    end
    return nil
end

local flags: {bool?} = { flag(true, true), flag(false, false), flag(true, false) }
assert(#flags == 3)
assert(get(flags, 0) == true)
assert(get(flags, 2) == false)

local missing_flag: bool? = get(flags, 1)
assert(missing_flag == nil)
local present_flag: bool? = get(flags, 0)
assert(present_flag ~= nil)
assert(present_flag == true)
