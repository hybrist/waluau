-- Dynamic indexing over a `{bool?}` array held as `unknown`. A present element
-- must rebox through `$boxed_bool` (the canonical `unknown` form for booleans)
-- rather than leaking the typed nullable box or the raw i31 payload, so it
-- compares equal to a `true`/`false` literal.
--
-- `bool?` shares the i32 nullable box with `i32?`/`u32?`; the mixed collision
-- coverage lives in unknown_index_nullable_primitives.walu, while this fixture
-- keeps the bool boxing behavior focused.
function get(v, i)
    return v[i]
end

local flags: {bool?} = {true, nil, false}
assert(#flags == 3)
assert(get(flags, 1) == true)
assert(get(flags, 3) == false)

local missing_flag: bool? = get(flags, 2)
assert(missing_flag == nil)
local present_flag: bool? = get(flags, 1)
assert(present_flag ~= nil)
assert(present_flag == true)
