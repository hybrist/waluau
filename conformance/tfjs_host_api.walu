local tf = require("tfjs")

declare function record_tfjs_async(value: f64): unit

local scalar: Tensor = tf.scalar(7.5)
assert(tf.dtype(scalar) == "float32")
assert(tf.shape_rank(scalar) == 0)
assert(tf.scalar_value(scalar) == 7.5)

local vector_data: TensorData = tf.data_empty(3)
tf.data_set_f64(vector_data, 0, 1.0)
tf.data_set_f64(vector_data, 1, 2.0)
tf.data_set_f64(vector_data, 2, 3.0)
local vector: Tensor = tf.tensor1d(vector_data)
assert(tf.shape_rank(vector) == 1)
assert(tf.shape_dim(vector, 0) == 3)

local vector_readback: TensorData = tf.data_sync(vector)
assert(tf.data_len(vector_readback) == 3)
assert(tf.data_get_f64(vector_readback, 0) == 1.0)
assert(tf.data_get_f64(vector_readback, 2) == 3.0)

local matrix_data: TensorData = tf.data_empty(4)
tf.data_set_f64(matrix_data, 0, 1.0)
tf.data_set_f64(matrix_data, 1, 2.0)
tf.data_set_f64(matrix_data, 2, 3.0)
tf.data_set_f64(matrix_data, 3, 4.0)
local matrix: Tensor = tf.tensor2d(matrix_data, 2, 2)
assert(tf.shape_rank(matrix) == 2)
assert(tf.shape_dim(matrix, 0) == 2)
assert(tf.shape_dim(matrix, 1) == 2)

local identity: Tensor = tf.eye(2)
local product: Tensor = tf.matmul(matrix, identity)
local product_data: TensorData = tf.data_sync(product)
assert(tf.data_get_f64(product_data, 0) == 1.0)
assert(tf.data_get_f64(product_data, 3) == 4.0)

local ones: Tensor = tf.ones(1, 3)
local incremented: Tensor = tf.add(vector, ones)
local multiplier: Tensor = tf.scalar(2.0)
local doubled: Tensor = tf.mul(incremented, multiplier)
local doubled_data: TensorData = tf.data_sync(doubled)
assert(tf.data_get_f64(doubled_data, 0) == 4.0)
assert(tf.data_get_f64(doubled_data, 2) == 8.0)

local before_dispose: i32 = tf.memory_num_tensors()
local disposable: Tensor = tf.scalar_i32(42)
local after_create: i32 = tf.memory_num_tensors()
assert(after_create == before_dispose + 1)
tf.dispose(disposable)
assert(tf.memory_num_tensors() == before_dispose)

tf.dispose(scalar)
tf.dispose(vector)
tf.dispose(matrix)
tf.dispose(identity)
tf.dispose(product)
tf.dispose(ones)
tf.dispose(incremented)
tf.dispose(multiplier)
tf.dispose(doubled)

function run_lifetime_checks(): unit
    local lifetime_tf = require("tfjs")

    local before_tidy: i32 = lifetime_tf.memory_num_tensors()
    local tidy_result: Tensor = lifetime_tf.tidy(function(): extern
        local a: Tensor = lifetime_tf.scalar(2.0)
        local b: Tensor = lifetime_tf.scalar(3.0)
        local c: Tensor = lifetime_tf.add(a, b)
        return c::extern
    end)
    assert(lifetime_tf.scalar_value(tidy_result) == 5.0)
    assert(lifetime_tf.memory_num_tensors() == before_tidy + 1)
    lifetime_tf.dispose(tidy_result)
    assert(lifetime_tf.memory_num_tensors() == before_tidy)

    local before_keep: i32 = lifetime_tf.memory_num_tensors()
    local kept: Tensor = lifetime_tf.tidy(function(): extern
        local value: Tensor = lifetime_tf.scalar(9.0)
        local kept_value: Tensor = lifetime_tf.keep(value)
        local temporary: Tensor = lifetime_tf.scalar(100.0)
        assert(lifetime_tf.scalar_value(temporary) == 100.0)
        return kept_value::extern
    end)
    assert(lifetime_tf.scalar_value(kept) == 9.0)
    assert(lifetime_tf.memory_num_tensors() == before_keep + 1)
    lifetime_tf.dispose(kept)
    assert(lifetime_tf.memory_num_tensors() == before_keep)
end

function run_async_readback(): unit
    local async_tf = require("tfjs")
    local co: thread = coroutine.create(function(): i32
        local async_scalar: Tensor = async_tf.scalar(13.0)
        local pending_data: Promise<TensorData> = async_tf.data(async_scalar)
        local data: TensorData = promise.await(pending_data)
        record_tfjs_async(async_tf.data_get_f64(data, 0))
        return 0
    end)
    coroutine.resume(co)
end
