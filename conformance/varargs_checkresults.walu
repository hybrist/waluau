-- Mirrors the Luau pcall suite's checkresults helper. Exercises table.pack over
-- forwarded varargs, `.n`, `#` on an unknown parameter, dynamic indexing of
-- both the packed table and the expected-results table, and dynamic equality.
function checkresults(e, ...)
    local t = table.pack(...)
    assert(t.n == #e)
    for i = 1, t.n do
        assert(t[i] == e[i])
    end
end

checkresults({true, 1, 2, 42}, true, 1, 2, 42)
checkresults({"a", "b"}, "a", "b")
checkresults({3.5}, 3.5)

function forward(e, ...)
    checkresults(e, ...)
end

forward({"x", 7}, "x", 7)

function ordinary_pair()
    return "left", 7
end

function protected_value(): i32
    return 42
end

-- A statically sized multi-result expands in the final argument position and
-- survives another variadic forwarding hop before table.pack consumes it.
forward({"left", 7}, ordinary_pair())
forward({true, 42}, pcall(protected_value))

-- The same multi-result collapses to its first value before a later argument.
forward({"left", "tail"}, ordinary_pair(), "tail")
