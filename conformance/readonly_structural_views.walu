-- `readonly<T>` is a zero-cost structural view. Mutable storage projects into
-- it without a clone, reads propagate through nested records and arrays, and a
-- mutable alias may still update the same storage behind the view. Projection
-- is one-way: no read-only alias converts back to mutable storage or erases to
-- `unknown`. Every reachable storage type must be statically projectable, so
-- dynamic, unconstrained generic, function, and tagged-union fields are
-- rejected instead of silently producing a shallow view. Extern values remain
-- governed by their declared DOM/host API; readonly protects Waluau structural
-- storage rather than changing host-object effects.
type Item = { value: i32 }
type State = { items: {Item}, labels: {string} }
type View = readonly<State>
type Values = readonly<{i32}>

function view(state: State): View
    return state
end

function count(view: readonly<State>): i32
    return table.getn(view.items)
end

function first(values: Values): i32
    return table.unpack(values, 0, 0)
end

local state: State = {
    items = { { value = 20::i32 } },
    labels = { "before" },
}
local projected: View = view(state)

assert(projected.items[0].value == 20)
assert(#projected.items == 1)
assert(table.getn(projected.items) == 1)
assert(count(projected) == 1)
assert(first({ 9::i32 }) == 9)
assert(table.concat(projected.labels) == "before")

state.items[0].value = 42
table.insert(state.items, { value = 7::i32 })
state.labels[0] = "after"

assert(projected.items[0].value == 42)
assert(projected.items[1].value == 7)
assert(#projected.items == 2)
assert(table.concat(projected.labels) == "after")

local sum: i32 = 0
for item in projected.items do sum += item.value end
assert(sum == 49)
