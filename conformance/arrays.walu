function length(): i32
    local xs: {number} = {10, 20, 30, 40}
    return #xs
end

function read_first(): number
    local xs: {number} = {100, 200, 300}
    return xs[0]
end

function sum_three(): i32
    local xs: {i32} = {1, 2, 3}
    return xs[0] + xs[1] + xs[2]
end

function sum_after_mutation(): i32
    local xs: {i32} = {1, 2, 3}
    xs[1] = 10
    return xs[0] + xs[1] + xs[2]
end

assert(length() == 4)
assert(read_first() == 100)
assert(sum_three() == 6)
assert(sum_after_mutation() == 14)
