assert(1 < 2)
assert(not (2 < 1))
assert(3 > 2)
assert(not (2 > 3))

assert(2 == 2)
assert(not (2 == 3))

assert(true)
assert(not false)
assert(true == true)
assert(false == false)
assert(not (true == false))

assert((1 < 2) and (2 < 3))
assert(not ((1 < 2) and (3 < 2)))
assert((1 > 2) or (2 < 3))
assert(not ((1 > 2) or (3 < 2)))

assert(not not true)

assert(not (false and (1 / 0 == 0)))
assert(true or (1 / 0 == 0))
