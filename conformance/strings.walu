-- String support: literals materialize via host imports as externref values.

function string_param(s: string): bool
    return s == "hello"
end

function string_local(): bool
    local s: string = "hello"
    return s == "hello"
end

function string_concat(): bool
    return ("foo" .. "bar") == "foobar"
end

function string_array(): i32
    local arr: {string} = {"a", "b", "c"}
    return #arr
end

assert(string_param("hello"))
assert(string_local())
assert(string_concat())
assert(string_array() == 3)
