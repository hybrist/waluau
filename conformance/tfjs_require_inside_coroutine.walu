-- `require("tfjs")` inside a coroutine callback must retain TFJS externs.
local co: thread = coroutine.create(function(): i32
    local tf = require("tfjs")
    local values: TensorData = tf.data_empty(4)
    tf.data_set_f64(values, 0, 1.0)
    tf.data_set_f64(values, 1, 2.0)
    tf.data_set_f64(values, 2, 3.0)
    tf.data_set_f64(values, 3, 4.0)

    local matrix: Tensor = tf.tensor2d(values, 2, 2)
    local product: Tensor = tf.add(matrix, matrix)
    local data: TensorData = tf.data_sync(product)
    assert(tf.data_get_f64(data, 3) == 8.0)

    tf.dispose(matrix)
    tf.dispose(product)
    return 0
end)

local ok: bool, _value: unknown = coroutine.resume(co)
assert(ok)
