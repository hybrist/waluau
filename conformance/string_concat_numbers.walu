enum SpellKind { Firebolt, FreezeRay, RaiseCard, Clone }

function SpellKind:__tostring(): string
    if self == SpellKind.Firebolt then
        return "Firebolt"
    elseif self == SpellKind.FreezeRay then
        return "Freeze Ray"
    elseif self == SpellKind.RaiseCard then
        return "Raise Card"
    elseif self == SpellKind.Clone then
        return "Clone"
    else
        return "Unknown Spell"
    end
end

assert("Hello " .. SpellKind.Firebolt::number == "Hello 0")
assert("Hello " .. SpellKind.Firebolt::i32 == "Hello 0")
assert("Hello " .. tostring(SpellKind.Firebolt) == "Hello Firebolt")
assert(12::i32 .. " monkeys" == "12 monkeys")

local label = "count="
label ..= 42::i32
assert(label == "count=42")

type Greeting = { text: string }

function Greeting:__concat(suffix: string): string
    return self.text .. suffix
end

local greeting: Greeting = { text = "Hello" }
assert(greeting .. "!" == "Hello!")
