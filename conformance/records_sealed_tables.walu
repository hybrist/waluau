function point_sum(seed: i32): i32
    local point: { x: i32, y: i32 } = { x = seed, y = seed + 1 }
    return point.x + point.y
end

function point_mutation(seed: i32): i32
    local point: { x: i32, y: i32 } = { x = seed, y = seed + 1 }
    point.x = point.x + 40
    point.y = point.y + 2
    return point.x + point.y
end

function nested_record(seed: i32): i32
    local wrapper: { inner: { x: i32 }, z: i32 } = {
        inner = { x = seed },
        z = seed + 10,
    }
    local inner = wrapper.inner
    inner.x = inner.x + 3
    return inner.x + wrapper.z
end

function alias_mutation(seed: i32): i32
    local vec: { x: i32, y: i32 } = { x = seed, y = seed + 1 }
    local alias = vec
    alias.y = alias.y + 5
    vec.x = vec.x + 9
    return alias.x + vec.y
end

assert(point_sum(2) == 5)
assert(point_mutation(2) == 47)
assert(nested_record(4) == 21)
assert(alias_mutation(1) == 17)

function vec(x: i32, y: i32): { x: i32, y: i32 }
    local new_vec = { x = x, y = y }
    return new_vec
end

function sqlen_vec(v: { x: i32, y: i32 }): i32
    return v.x * v.x + v.y * v.y
end

function make_incremental_record(seed: i32): { x: i32, y: i32 }
    local t = {}
    t.x = seed
    t.y = seed + 1
    return t
end

local my_v = vec(2, 4)
assert(my_v.x == 2)
assert(my_v.y == 4)
assert(sqlen_vec(my_v) == 20)

local incremental = make_incremental_record(10)
assert(incremental.x == 10)
assert(incremental.y == 11)

local alias_vec = { x = 1::i32, y = 2::i32 }
local alias_ref = alias_vec
alias_ref.y = alias_ref.y + 5
alias_vec.x = alias_vec.x + 9
assert(alias_ref.x == 10)
assert(alias_vec.y == 7)

-- '#' applies directly to arrays reached through record fields, including in
-- contexts that expect a number (waluau-lhia regression).
function tail_value(state: { items: {i32}, score: i32 }): i32
    return state.items[#state.items - 1] + state.score
end

local state: { items: {i32}, score: i32 } = { items = {10, 20, 30}, score = 7 }
assert(#state.items == 3)
local doubled = #state.items * 2
assert(doubled == 6)
assert(tail_value(state) == 37)
table.insert(state.items, 40)
assert(#state.items == 4)
table.remove(state.items)
table.remove(state.items)
assert(#state.items + 1 == 3)

local nested: { inner: { items: {string} } } = { inner = { items = {"a", "b"} } }
assert(#nested.inner.items == 2)

-- Record types accept a trailing comma after the last field.
type Vec2d = {
    x: i32,
    y: i32,
}
local trailing: Vec2d = { x = 4, y = 5 }
assert(trailing.x + trailing.y == 9)
