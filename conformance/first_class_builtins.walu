-- Declared browser-host functions are ordinary typed values when referenced
-- outside direct-call position. Their wrappers must retain the host signature
-- and use the same Wasm-GC closure representation as authored functions.
local output: (string) -> unit = print
assert(string.find(tostring(output), "function:"))

local render: (unknown) -> string = tostring
assert(render(5) == "5")

local abs: (f64) -> f64 = math.abs
assert(abs(-4.5) == 4.5)

local function apply(fn: (f64) -> f64, value: f64): f64
    return fn(value)
end

assert(apply(abs, -9.25) == 9.25)

local function captured_abs(value: f64): f64
    return abs(value)
end

assert(captured_abs(-6.25) == 6.25)

local ok, protected = pcall(abs, -3.5)
assert(ok and protected == 3.5)

local invert: (u32) -> u32 = bit32.bnot
assert(invert(0) == 4294967295)

local bit_order: (u32, u32) -> bool = bit32.btest
local bits: {u32} = {0, 1}
table.sort(bits, bit_order)

local found, _find_error = pcall(string.find, "a", "(.")
assert(not found)

-- Compiler intrinsics take the same route: a value reference synthesizes a
-- private adapter whose body is the ordinary intrinsic lowering, while direct
-- calls keep lowering as intrinsics.
local upper: (string) -> string = string.upper
local length: (string) -> i32 = string.len
local slice: (string, i32, i32) -> string = string.sub
local repeat_text: (string, i32) -> string = string.rep
local flip: (string) -> string = string.reverse
assert(upper("ab") == "AB")
assert(length("abc") == 3)
assert(slice("abcdef", 2, 3) == "bc")
assert(repeat_text("ab", 2) == "abab")
assert(flip("abc") == "cba")

-- An intrinsic with exactly one signature needs no annotation.
local shrink = string.lower
assert(shrink("AB") == "ab")

local insert: ({string}, string) -> unit = table.insert
local join: ({string}, string) -> string = table.concat
local size: ({string}) -> i32 = table.getn
local drop: ({string}) -> string = table.remove
local words: {string} = {}
insert(words, "a")
insert(words, "b")
assert(size(words) == 2)
assert(join(words, ",") == "a,b")
assert(drop(words) == "b")

-- As a callback: `string.upper` is the replacement of a `string.gsub`.
assert(
    string.gsub("um (dois) tres (quatro)", "(%(%w+%))", string.upper) == "um (DOIS) tres (QUATRO)"
)

-- Captured in a closure.
local function shout(text: string): string
    return upper(text)
end
assert(shout("hi") == "HI")

local function apply_text(fn: (string) -> string, value: string): string
    return fn(value)
end
assert(apply_text(string.reverse, "abc") == "cba")

-- Protected calls select the signature from their argument list.
local repeated_ok, repeated = pcall(string.rep, "a", 3)
assert(repeated_ok)

local inserted_ok, _inserted = pcall(table.insert, words, "c")
assert(inserted_ok and size(words) == 2)

local asserted_ok, _asserted = pcall(assert, false)
assert(not asserted_ok)

local raised_ok, _raised = pcall(error, "boom")
assert(not raised_ok)
