-- table.create and table.unpack on growable arrays. Bounds and indices are
-- 0-based like all Waluau array indexing, so table.unpack defaults to
-- elements 0 through #a - 1. Only statically-knowable unpack arities are
-- supported: literal bounds, a statically sized array argument (an array
-- literal or a direct table.create call with a literal count), or an
-- expected multi-value arity such as an annotated multi-binding declaration.
-- table.create(count, value) fills every element with the value.
local filled: {i32} = table.create(3, 7)
assert(#filled == 3)
assert(filled[0] == 7)
assert(filled[1] == 7)
assert(filled[2] == 7)

-- The result is a normal growable array.
table.insert(filled, 9)
assert(#filled == 4)
assert(filled[3] == 9)

-- Count zero produces an empty array.
local empty_filled: {string} = table.create(0, "x")
assert(#empty_filled == 0)

-- The count may be a runtime value of any numeric type.
local n: i32 = 5
local runtime: {f64} = table.create(n, 1.5)
assert(#runtime == 5)
assert(runtime[0] == 1.5)
assert(runtime[4] == 1.5)

-- table.create(count) is an empty array: the capacity hint has no effect on
-- growable arrays.
local hinted: {string} = table.create(8)
assert(#hinted == 0)
table.insert(hinted, "grown")
assert(#hinted == 1)
assert(hinted[0] == "grown")

-- table.unpack spreads a statically sized array literal into a call.
assert(string.format("%d-%d-%d", table.unpack({7, 8, 9})) == "7-8-9")

-- A direct table.create argument is statically sized too.
assert(string.format("%s%s", table.unpack(table.create(2, "hi"))) == "hihi")

-- Literal 0-based bounds select a subrange of an array whose length is not
-- statically known.
local ys: {i32} = {10, 20, 30, 40, 50}
assert(string.format("%d+%d+%d", table.unpack(ys, 1, 3)) == "20+30+40")

-- An empty literal range unpacks to no values.
assert(string.format("%s", "solo", table.unpack(ys, 3, 2)) == "solo")

-- An annotated multi-binding declaration supplies the expected arity when
-- the array length is not statically known.
local fourth: i32, fifth: i32 = table.unpack(ys, 3)
assert(fourth == 40)
assert(fifth == 50)

-- Extra elements beyond the expected arity are dropped, following Lua's
-- adjustment rules.
local first: i32, second: i32, third: i32 = table.unpack(ys)
assert(first == 10)
assert(second == 20)
assert(third == 30)

-- string.char accepts unpacked character codes like any other multi-value
-- argument.
assert(string.char(table.unpack({104::i32, 105::i32})) == "hi")
