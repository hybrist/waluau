-- Independent coroutine instances created from the same function keep their
-- own suspension points when resumed in interleaved order.

function helper(): ()
    coroutine_yield(1)
    coroutine_yield(2)
end

function counter_job(): i32
    helper()
    return 3
end

local co1 = coroutine_create(counter_job)
local co2 = coroutine_create(counter_job)

assert(coroutine_status(co1))
assert(coroutine_status(co2))
assert(coroutine_resume(co1) == 1)
assert(coroutine_resume(co2) == 1)
assert(coroutine_status(co1))
assert(coroutine_status(co2))
assert(coroutine_resume(co1) == 2)
assert(coroutine_resume(co2) == 2)
assert(coroutine_status(co1))
assert(coroutine_status(co2))
assert(coroutine_resume(co1) == 3)
assert(coroutine_resume(co2) == 3)
