-- Independent coroutine instances created from the same function keep their
-- own suspension points when resumed in interleaved order.
function helper(): ()
    coroutine.yield(1::i32)
    coroutine.yield(2::i32)
end

function counter_job(): i32
    helper()
    return 3
end

local co1: thread = coroutine.create(counter_job)
local co2: thread = coroutine.create(counter_job)

local a1: bool, x1: unknown = coroutine.resume(co1)
local b1: bool, y1: unknown = coroutine.resume(co2)
assert(a1)
assert(b1)
assert(x1::i32 == 1)
assert(y1::i32 == 1)

local a2: bool, x2: unknown = coroutine.resume(co1)
local b2: bool, y2: unknown = coroutine.resume(co2)
assert(a2)
assert(b2)
assert(x2::i32 == 2)
assert(y2::i32 == 2)

local a3: bool, x3: unknown = coroutine.resume(co1)
local b3: bool, y3: unknown = coroutine.resume(co2)
assert(a3)
assert(b3)
assert(x3::i32 == 3)
assert(y3::i32 == 3)
