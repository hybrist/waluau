--
-- conformance: untriaged: first blocker is a 'function' statement inside a nested block (waluau-jehg), but the chunk asserts Lua's 'stack overflow' message and Wasm stack exhaustion may not be able to produce it at all
-- This chunk contains only pcall.luau checks that currently fail in Waluau.
-- Remove this directive when the chunk passes.
--
-- Split from conformance/luau/pcall.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
print("testing pcall")

do
		function stackover() return pcall(stackover) end
		local res = {pcall(stackover)}
		assert(#res == 10000) -- stack limit (LUAI_MAXCALLS is 20000 and we use 2 calls per recursion)
end
