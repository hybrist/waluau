--
-- Split from conformance/luau/ifelseexpr.walu in original source order.
-- Upstream source lines 80-84.
-- Required upstream helper setup from line 16-22 is repeated for standalone execution.

function True()
  return true
end

function False()
  return false
end
-- Test nesting of if-else expressions inside the condition of an if-else expression
assert((if (if True() then false else true) then 10 else 20) == 20)
assert((if if True() then false else true then 10 else 20) == 20)


