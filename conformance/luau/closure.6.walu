--
-- conformance: out-of-scope: strict-bool
-- This chunk contains only closure.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/closure.walu. Common setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- testing closure x break x return x errors

local b
function f(x)
  local first = 1
  while 1 do
    if x == 3 and not first then return end
    local a = 'xuxu'
    b = function (op, y)
          if op == 'set' then
            a = x+y
          else
            return a
          end
        end
    if x == 1 then do break end
    elseif x == 2 then return
    else if x ~= 3 then error() end
    end
    first = nil
  end
end

for i=1,3 do
  f(i)
  assert(b('get') == 'xuxu')
  b('set', 10); assert(b('get') == 10+i)
  b = nil
end

pcall(f, 4);
assert(b('get') == 'xuxu')
b('set', 10); assert(b('get') == 14)
