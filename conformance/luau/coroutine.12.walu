-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/coroutine.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: static-names
-- This chunk contains only coroutine.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/coroutine.walu. Common setup is repeated
-- as needed so each numbered chunk is independently discoverable by the
-- conformance runner.

if not limitedstack then
  -- infinite recursion of coroutines
  a = function(a) coroutine.wrap(a)(a) end
  assert(not pcall(a, a))
  a = nil
end
