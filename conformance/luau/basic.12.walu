print("testing language/library basics")

function concat(head, ...)
    if select('#', ...) == 0 then
        return tostring(head)
    else
        return tostring(head) .. "," .. concat(...)
    end
end
assert((function() local a = nil a = not a return a end)() == true)

assert((function() return #_G end)() == 0)
