--
-- conformance: out-of-scope: typed-coroutine
-- This chunk contains only iter.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/iter.walu.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
-- This file is based on Lua 5.x tests -- https://github.com/lua/lua/tree/master/testes
print('testing iteration')
-- yielding generalized iteration: empty iteration (iterator returns nil immediately)
do
  local function empty_iter()
    coroutine.yield("before")
    return nil
  end

  local co = coroutine.create(function()
    local count = 0
    for v in empty_iter do
      count += 1
    end
    return count
  end)

  local ok, val = coroutine.resume(co)
  assert(ok and val == "before")

  local ok, val = coroutine.resume(co)
  assert(ok and val == 0)
end

