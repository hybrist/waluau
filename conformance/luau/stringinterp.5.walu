-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/stringinterp.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/stringinterp.walu in original source order.
-- Upstream source lines 43-49.
-- Required upstream helper setup from lines 12-19 and 33 is repeated for standalone execution.

local function assertEq(left, right)
	assert(typeof(left) == "string", "left is a " .. typeof(left))
	assert(typeof(right) == "string", "right is a " .. typeof(right))

	if left ~= right then
		error(string.format("%q ~= %q", left, right))
	end
end
local name = "Luau"
assertEq(`Welcome to \
{name}!`, "Welcome to \nLuau!")

assertEq(`empty`, "empty")

assertEq(`Escaped brace: \{}`, "Escaped brace: {}")
assertEq(`Escaped brace \{} with {"expression"}`, "Escaped brace {} with expression")
