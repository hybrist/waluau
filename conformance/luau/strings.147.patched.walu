-- Adapted from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/strings.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- This is a PATCHED companion to strings.147.walu (which stays verbatim and
-- pending): string.split itself is implemented, but the chunk's eq helper
-- reads the arrays with Lua's 1-based indices, which trap under Waluau's
-- documented 0-based array indexing. The only edit shifts those reads to
-- 0-based; the string.split check is otherwise unchanged.
--
-- Split from conformance/luau/strings.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- string.split
do
  local function eq(a, b)
    if #a ~= #b then
      return false
    end
    for i=1,#a do
      -- PATCHED: 1-based reads -> 0-based.
      if a[i-1] ~= b[i-1] then
        return false
      end
    end
    return true
  end

  assert(eq(string.split("abc", "c"), {'ab', ''}))
end
