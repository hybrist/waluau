--
-- conformance: untriaged: interpolates a buffer into a string template; same open question as strings.87 about what tostring should produce for a reference value, tracked by waluau-nsp4
-- This chunk contains only native.luau checks that currently fail in Waluau.
-- Remove this directive when the whole chunk passes.
--
-- Split from conformance/luau/native.walu. Each numbered chunk preserves a
-- contiguous section of the original test body so the conformance runner can
-- classify currently passing and pending native checks separately.

function valueTrackingIssue1()
  local b = buffer.create(1)
  buffer.writeu8(b, 0, 0)
  local v1

  local function closure()
    assert(type(b) == "buffer") -- b is the first upvalue
    v1 = nil -- v1 is the second upvalue

    -- prevent inlining
    for i = 1, 100 do print(`{b} is {b}`) end
  end

  closure()
end

valueTrackingIssue1()
