-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/bitwise.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: pending
-- Waluau does not infer negative numeric values passed through this
-- unannotated pcall/noinline helper as u32 bit patterns.
--
-- Split from conformance/luau/bitwise.11.walu. Helper setup is repeated so the
-- chunk remains independently discoverable by the conformance runner.

local function noinline(x, ...) local s, r = pcall(function(y) return y end, x) return r end

assert(bit32.replace(noinline(0), -1, 4) == 2^4)
assert(bit32.replace(noinline(-1), 0, 31) == 2^31 - 1)
assert(bit32.replace(noinline(-1), 0, 1, 2) == 2^32 - 7)
