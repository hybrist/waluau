-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/math.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/math.walu. This contiguous direct math-library
-- range (former math.2 lines 12-17) is preserved verbatim and independently runnable.

do
  local a,b = math.modf(3.5)
  assert(a == 3 and b == 0.5)
  assert(math.huge > 10e30)
  assert(-math.huge < -10e30)
end
