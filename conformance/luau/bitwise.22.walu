-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/bitwise.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: pending
-- Typed bit32 function values are supported, but Waluau rejects these invalid
-- argument types and arities statically instead of deferring them to pcall.
--
-- Split from conformance/luau/bitwise.9.walu.

assert(not pcall(bit32.band, {}))
assert(not pcall(bit32.bnot, "a"))
assert(not pcall(bit32.lshift, 45))
assert(not pcall(bit32.lshift, 45, print))
assert(not pcall(bit32.rshift, 45, print))
