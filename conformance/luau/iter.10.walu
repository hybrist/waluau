print('testing iteration')
-- generic for with __iter (tables)
do
  local f = {}
  setmetatable(f, { __iter = function(x)
    assert(f == x)
    return next, {1, 2, 3, 4}
  end })

  local x = 0
  for n in f do
    x += n
  end
  assert(x == 10)
end

