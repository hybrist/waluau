--
-- conformance: pending
-- This chunk contains only coroutine.luau checks that currently fail in Waluau.
-- Remove this directive when the whole chunk passes.
--
-- Split from conformance/luau/coroutine.walu. Common setup is repeated
-- as needed so each numbered chunk is independently discoverable by the
-- conformance runner.

-- unyieldable C call
do
  local function f (c)
          assert(not coroutine.isyieldable())
          return c .. c
        end

  local co = coroutine.wrap(function (c)
               assert(coroutine.isyieldable())
               local s = string.gsub("a", ".", f)
               return s
             end)
  assert(co() == "aa")
end
