--
-- conformance: out-of-scope: heterogeneous-values
-- This chunk contains only constructs.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/constructs.walu. Helper setup is repeated as
-- needed so each numbered chunk is independently discoverable by the conformance runner.

local f = function (i)
  if i < 10 then return 'a'
  elseif i < 20 then return 'b'
  elseif i < 30 then return 'c'
  else return 8
  end
end

local a, b = nil, 23
x = {f(100)*2+3 or a, a or b+2}
assert(x[1] == 19 and x[2] == 25)
