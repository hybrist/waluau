--
-- conformance: pending
-- This chunk contains only strings.luau checks that currently fail in Waluau.
-- Remove this directive when the whole chunk passes.
-- Still failing: string.split itself now works, but the eq helper's 1-based
-- array reads trap under Waluau's documented 0-based array indexing. See the
-- passing PATCHED companion strings.145.patched.walu.
--
-- Split from conformance/luau/strings.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- string.split
do
  local function eq(a, b)
    if #a ~= #b then
      return false
    end
    for i=1,#a do
      if a[i] ~= b[i] then
        return false
      end
    end
    return true
  end

  assert(eq(string.split("abc", "b"), {'a', 'c'}))
end
