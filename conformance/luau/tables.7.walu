-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/tables.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/tables.walu. Top-level do scope wrappers
-- are flattened in tail chunks where needed so each numbered chunk is
-- independently discoverable by the conformance runner.

  local t = { x = 1 }
  local a = (t)
  a.x = 99
  assert(t.x == 99)
  local t = {x = 1}
  local u = {y = t}
  u.y.x = 99
  assert(t.x == 99)
