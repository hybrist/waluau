-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/datetime.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: browser-clocks-and-calendars
-- Browser os.date always returns a formatted string, so the "*t" calendar
-- table has no typed signature. Requesting it raises rather than silently
-- formatting the literal text. See DEVIATIONS.md, "Browser clocks and
-- calendar values". Remove this directive only if that decision changes.
--
-- Split from conformance/luau/datetime.walu in original source order.
-- Upstream source line 15. The preceding os.time() binding is repeated as
-- setup so the chunk runs standalone.

local t = os.time()
D = os.date("*t", t)
