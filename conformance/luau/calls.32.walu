-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/calls.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/calls.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

local function g (z)
  local function f (a,b,c,d)
    return function (x,y) return a+b+c+d+a+x+y+z end
  end
  return f(z,z+1,z+2,z+3)
end

f = g(10)
assert(f(9, 16) == 10+11+12+13+10+9+16+10)
