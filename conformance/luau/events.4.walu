-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/events.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: static-names
-- This chunk contains only checks from events.luau that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/events.walu. The original test body is split into
-- contiguous numbered chunks so each part is independently discoverable by the
-- conformance runner.

local res,err = pcall(tostring, a)
assert(not res and err == "'__tostring' must return a string")
-- cannot change a protected metatable
assert(pcall(setmetatable, a, {}) == false)
a.name = "gororoba"
assert(tostring(a) == "gororoba")

