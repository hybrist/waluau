-- conformance: pending
-- This chunk contains only coroutine.luau checks that currently fail in Waluau.
-- Remove this directive when the whole chunk passes.
--
-- Split from conformance/luau/coroutine.walu. Common setup is repeated
-- as needed so each numbered chunk is independently discoverable by the
-- conformance runner.

-- attempt to resume 'normal' coroutine
local co1, co2
co1 = coroutine.create(function () return co2() end)
co2 = coroutine.wrap(function ()
        assert(coroutine.status(co1) == 'normal')
        assert(not coroutine.resume(co1))
        coroutine.yield(3)
      end)

a,b = coroutine.resume(co1)
assert(a and b == 3)
assert(coroutine.status(co1) == 'dead')
