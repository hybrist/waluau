--
-- conformance: untriaged: recursive range returns a runtime-variable number of values spread into string.char; same waluau-zxju versus heterogeneous-values question as calls.33
-- This chunk contains only pm.luau checks that currently fail in Waluau.
-- Remove this directive when the chunk passes.
--
-- Split from conformance/luau/pm.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

local function range (i, j)
  if i <= j then
    return i, range(i+1, j)
  end
end

local abc = string.char(range(0, 255));

assert(string.len(abc) == 256)

function strset (p)
  local res = {s=''}
  string.gsub(abc, p, function (c) res.s = res.s .. c end)
  return res.s
end;

assert(strset('.') == strset('[\1-\255%z]'))
print('+');
