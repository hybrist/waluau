--
-- conformance: out-of-scope: static-names
-- This chunk contains only checks from errors.luau that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
-- Split from conformance/luau/errors.walu. Common setup is repeated
-- as needed so each numbered chunk is independently discoverable by the
-- conformance runner.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
-- This file is based on Lua 5.x tests -- https://github.com/lua/lua/tree/master/testes
local syntaxdepth = if limitedstack then 200 else 500
local function testrep (init, rep)
  local s = "local a; "..init .. string.rep(rep, syntaxdepth)
  local a,b = loadstring(s)
  assert(not a) -- and string.find(b, "syntax levels"))
end

testrep("", "do ")
