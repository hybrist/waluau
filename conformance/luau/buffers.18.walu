-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/buffers.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/buffers.walu. The untyped table-parameter
-- checks from this upstream block remain in buffers.18_untyped_table.walu;
-- this chunk covers the independently supported buffer behavior.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
print("testing byte buffer library")

local function misc()
  local native_check = is_native_if_supported()
  local b = buffer.create(1000)

  assert(select('#', buffer.writei32(b, 10, 40)) == 0)
  assert(select('#', buffer.writef32(b, 20, 40.0)) == 0)

  buffer.writeu8(b, 100, 0xff)
  buffer.writeu8(b, 110, 0x80)
  assert(buffer.readu32(b, 100) == 255)
  assert(buffer.readu32(b, 110) == 128)
  buffer.writeu16(b, 200, 0xffff)
  buffer.writeu16(b, 210, 0x8000)
  assert(buffer.readu32(b, 200) == 65535)
  assert(buffer.readu32(b, 210) == 32768)

  assert(not native_check or is_native_if_supported())
end

misc()
