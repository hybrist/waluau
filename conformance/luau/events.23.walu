-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/events.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: static-type-errors
-- This chunk contains only checks from events.luau that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/events.walu. The original test body is split into
-- contiguous numbered chunks so each part is independently discoverable by the
-- conformance runner.

-- verify that NaN/nil keys are passed to __newindex even though table assignment with them anywhere in the chain fails
do
  assert(pcall(function() local t = {} t[nil] = 5 end) == false)
  assert(pcall(function() local t = {} setmetatable(t, { __newindex = {} }) t[nil] = 5 end) == false)
  assert(pcall(function() local t = {} setmetatable(t, { __newindex = function() end }) t[nil] = 5 end) == true)

  assert(pcall(function() local t = {} t[0/0] = 5 end) == false)
  assert(pcall(function() local t = {} setmetatable(t, { __newindex = {} }) t[0/0] = 5 end) == false)
  assert(pcall(function() local t = {} setmetatable(t, { __newindex = function() end }) t[0/0] = 5 end) == true)
end

