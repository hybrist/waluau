-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/pcall.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/pcall.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
print("testing pcall")

-- protected and regular calls without C stack limit
do
	local function regularadd(depth: number, a: number, b: number): number
		if depth == 0 then return 1 end

		return a + regularadd(depth - 1, b, a + b)
	end

	local function protectedadd(depth: number, a: number, b: number): number
		if depth == 0 then return 1 end

		local result, s = pcall(protectedadd, depth - 1, b, a + b)
		assert(result)
		return a + s
	end

	assert(regularadd(2000, 0, 1) == protectedadd(2000, 0, 1))
end

return 'OK'
