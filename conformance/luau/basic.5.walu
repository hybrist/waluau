--
-- Split from conformance/luau/basic.walu. Common helper setup is repeated
-- so each numbered chunk is independently discoverable by the conformance runner.

print("testing language/library basics")

function concat(head, ...)
    if select('#', ...) == 0 then
        return tostring(head)
    else
        return tostring(head) .. "," .. concat(...)
    end
end

-- make sure that negative zero is preserved by bytecode compiler
assert(tostring(0) == "0")
