--
-- conformance: out-of-scope: heterogeneous-values
-- This chunk contains only calls.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/calls.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

local pack = table.pack
local unpack = table.unpack
function unlpack (t, i)
  i = i or 1
  if (i <= table.getn(t)) then
    return t[i], unlpack(t, i+1)
  end
end

function equaltab (t1, t2)
  assert(table.getn(t1) == table.getn(t2))
  for i,v1 in ipairs(t1) do
    assert(v1 == t2[i])
  end
end

function f() return 1,2,30,4 end
function ret2 (a,b) return a,b end
local a,b,c,d
a = {1,2,3,4,false,10,'alo',false,assert}
equaltab(pack(unlpack(a)), a)
