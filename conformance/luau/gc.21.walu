--
-- conformance: pending
-- This chunk contains only gc.luau checks that currently fail in Waluau.
-- Remove this directive when the chunk passes.
--
-- Split from conformance/luau/gc.walu. Common setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- create many threads with self-references and open upvalues
do
  local thread_id = 0
  local threads = {}

  function fn(thread)
      local x = {}
      threads[thread_id] = function()
                               thread = x
                           end
      coroutine.yield()
  end

  while thread_id < 1000 do
      local thread = coroutine.create(fn)
      coroutine.resume(thread, thread)
      thread_id = thread_id + 1
  end

  collectgarbage()

  -- ensure that we no longer have a lot of reachable threads for subsequent tests
  threads = {}
end
