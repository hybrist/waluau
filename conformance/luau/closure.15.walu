--
-- conformance: out-of-scope: typed-coroutine
-- This chunk contains only closure.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/closure.walu. Common setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- sieve
function gen (n)
  return coroutine.wrap(function ()
    for i=2,n do coroutine.yield(i) end
  end)
end


function filter (p, g)
  return coroutine.wrap(function ()
    while 1 do
      local n = g()
      if n == nil then return end
      if n%p ~= 0 then coroutine.yield(n) end
    end
  end)
end

local x = gen(100)
local a = {}
while 1 do
  local n = x()
  if n == nil then break end
  table.insert(a, n)
  x = filter(n, x)
end

assert(table.getn(a) == 25 and a[table.getn(a)] == 97)
