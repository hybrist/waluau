-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/strings.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/strings.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- string.split
do
  local function eq(a, b)
    if #a ~= #b then
      return false
    end
    for i=1,#a do
      if a[i] ~= b[i] then
        return false
      end
    end
    return true
  end

  assert(eq(string.split("abc", "c"), {'ab', ''}))
end
