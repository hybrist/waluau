-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/math.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/math.walu. The upstream assertion body is
-- preserved from former math.13 lines 17-27; only repeated helper setup is typed.

local function eq(a: f64, b: f64): bool
  return math.abs(a-b) <= 10E-10
end

assert(eq(math.sqrt(10)^2, 10))
assert(eq(math.log10(2), math.log(2)/math.log(10)))
assert(eq(math.log(2, 2), 1))
assert(eq(math.log(9, 3), 2))
assert(eq(math.log(100, 10), 2))
assert(eq(math.exp(0), 1))
assert(eq(math.sin(10), math.sin(10%(2*math.pi))))
local v,e = math.frexp(math.pi)
assert(eq(math.ldexp(v,e), math.pi))

assert(eq(math.tanh(3.5), math.sinh(3.5)/math.cosh(3.5)))
