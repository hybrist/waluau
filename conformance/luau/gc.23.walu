--
-- conformance: pending
-- This chunk contains only gc.luau checks that currently fail in Waluau.
-- Remove this directive when the chunk passes.
--
-- Split from conformance/luau/gc.walu. Common setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- create threads that die together with their unmarked upvalues
do
  local t = {}

  for i = 1,100 do
    local c = coroutine.wrap(function()
      local uv = {i + 1}
      local function f()
        return uv[1] * 10
      end
      coroutine.yield(uv[1])
      uv = {i + 2}
      coroutine.yield(f())
    end)

    assert(c() == i + 1)
    table.insert(t, c)
  end

  for i = 1,100 do
    t[i] = nil
  end

  collectgarbage()
end
