-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/native.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: native-jit-register-layout
-- This chunk contains only native.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/native.walu. Each numbered chunk preserves a
-- contiguous section of the original test body so the conformance runner can
-- classify currently passing and pending native checks separately.

local function bufferboundsmerge1(b12: buffer, a: number, ...)
  local r1 = buffer.readi32(b12, a + 8) + buffer.readi32(b12, a + 4) + buffer.readi32(b12, a + 0)
  assert(r1 == 0)

  assert(is_native())
end

bufferboundsmerge1(buffer.create(12), 0)
