--
-- Split from former math.17 lines 112-118; this contiguous body is preserved.

local inf = math.huge * 2
local nan = 0 / 0

-- sign
assert(math.sign(0) == 0)
assert(math.sign(42) == 1)
assert(math.sign(-42) == -1)
assert(math.sign(inf) == 1)
assert(math.sign(-inf) == -1)
assert(math.sign(nan) == 0)
