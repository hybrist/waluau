--
-- conformance: untriaged: needs error{msg='x'} to raise a non-string value; waluau-844l decides whether Waluau carries an unknown-typed error payload or keeps a deliberate string-only error channel, which would make this out-of-scope
-- This chunk contains only checks from errors.luau that currently fail in Waluau.
-- Remove this directive when the whole chunk passes.
-- Split from conformance/luau/errors.walu. Common setup is repeated
-- as needed so each numbered chunk is independently discoverable by the
-- conformance runner.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
-- This file is based on Lua 5.x tests -- https://github.com/lua/lua/tree/master/testes

-- non string messages
function f() error{msg='x'} end
res, msg = xpcall(f, function (r) return {msg=r.msg..'y'} end)
assert(msg.msg == 'xy')
