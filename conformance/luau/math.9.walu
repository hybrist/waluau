-- Split from conformance/luau/math.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

assert(not('a'>'a') and not('a'>'b') and ('b'>'a'))
assert((1>=1) and not(1>=2) and (2>=1))
assert(('a'>='a') and not('a'>='b') and ('b'>='a'))
assert((unk and unk > 0) == nil) -- validate precedence between and and >

