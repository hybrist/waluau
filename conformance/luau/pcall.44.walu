print("testing pcall")

function checkerror(...)
	local t = table.pack(...)
	assert(t.n == 2)
	assert(t[1] == false)
	assert(type(t[2]) == "string")
end

local calllimit = 20000
function recurse(n)
	return n <= 1 and 1 or recurse(n-1) + 1
end

function yieldandrecurse(n)
	coroutine.yield()
	recurse(n)
end

checkerror(pcall(recurse, calllimit - 2))
