print('testing iteration')
-- all extra variables should be set to nil during builtin traversal
do
  local x = 0
  for k,v,a,b,c,d,e in {1, 2, 3, 4, 5} do
    x += k
    assert(a == nil and b == nil and c == nil and d == nil and e == nil)
  end
  assert(x == 15)
end

