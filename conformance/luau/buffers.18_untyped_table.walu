-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/buffers.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: pending
-- Waluau does not refine an unannotated function parameter from its call
-- sites: `t16` remains `unknown`, so array mutation and length are rejected.
-- This is a broad static-typing deviation tracked by waluau-2dow, not missing
-- buffer behavior or a reason to add sparse/mixed tables.
-- Split from buffers.18.walu so its independent buffer checks can run.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
print("testing byte buffer library")

local function misc(t16)
  local native_check = is_native_if_supported()
  local b = buffer.create(1000)

  -- some extra operation to place '#t16' into a linear block
  t16[1] = 10
  t16[15] = 20

  buffer.writei32(b, #t16, 10)
  assert(buffer.readi32(b, 16) == 10)

  assert(not native_check or is_native_if_supported())
end

misc(table.create(16, 0))
