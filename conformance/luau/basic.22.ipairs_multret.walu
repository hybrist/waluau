-- Split from conformance/luau/basic.22.walu so the dense-array iterator target
-- produced as the first result of a multi-return call is independently tested.
-- Upstream source line 283.

assert((function() local function f() return {5,6,7},8,9,0 end local a = '' for k,v in ipairs(f()) do a = a .. v end return a end)() == "567")
