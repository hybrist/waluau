local function fuzzfail22(...)
  local _ = {false,},true,...,l0
  while _ do
  _ = true,{unpack(0,_),},l0
  _.n126 = nil
  _ = {not _,_=not _,n0=_,_,n0=not _,},_ < _
  return _ > _
  end
  return `""`
end

assert(pcall(fuzzfail22) == false)
