print('testing yields from C functions')
-- Multiple yields from a C function
do
    local co = coroutine.wrap(multipleYields)
    assert(co(10) == 11)
    assert(co() == 12)
    assert(co() == 13)
    assert(co() == 14)
end

-- Multiple yields from a C function (unused extra arguments)
do
    local co = coroutine.wrap(multipleYields)
    assert(co(10, -1) == 11)
    assert(co(-1, -2) == 12)
    assert(co(-1, -2) == 13)
    assert(co(-1, -2) == 14)
end
