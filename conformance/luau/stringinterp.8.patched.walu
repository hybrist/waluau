-- Adapted from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/stringinterp.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- This is a PATCHED companion to the verbatim chunk stringinterp.8.walu
-- (upstream source lines 61-67), which stays pending because Waluau reserves
-- the primitive type name `string` as a keyword, so an ordinary binding cannot
-- shadow it. The interpolation behavior the upstream range actually exercises
-- -- one untyped parameter interpolated after being called with both a string
-- and a number -- is supported, so it is kept here with the parameter renamed.
--
-- Required upstream helper setup from line 12-19 is repeated for standalone
-- execution.

local function assertEq(left, right)
	assert(typeof(left) == "string", "left is a " .. typeof(left))
	assert(typeof(right) == "string", "right is a " .. typeof(right))

	if left ~= right then
		error(string.format("%q ~= %q", left, right))
	end
end
-- PATCHED: upstream names this parameter `string` to test shadowing the
-- `string` library; `string` is a reserved type keyword in Waluau.
local function shadowsString(value)
	return `Value is {value}`
end

assertEq(shadowsString("hello"), "Value is hello")
assertEq(shadowsString(1), "Value is 1")
