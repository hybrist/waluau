--
-- conformance: pending
-- This chunk contains only closure.luau checks that currently fail in Waluau.
-- Remove this directive when the chunk passes.
--
-- Split from conformance/luau/closure.walu. Common setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

a = {}
for i, k in pairs{'a', 'b'} do
  a[i] = {set = function(x, y) i=x; k=y end,
          get = function () return i, k end}
  if i == 2 then break end
end
a[1].set(10, 20)
local r,s = a[2].get()
assert(r == 2 and s == 'b')
r,s = a[1].get()
assert(r == 10 and s == 20)
a[2].set('a', 'b')
r,s = a[2].get()
assert(r == "a" and s == "b")
