-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/math.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from former math.17 lines 216-227; this contiguous body is preserved.

-- math constants
assert(math.pi * 2 == math.tau)
assert(math.sqrt(2) == math.sqrt2)
assert(math.exp(1) == math.e)
assert(((1 + math.sqrt(5)) / 2) == math.phi)
assert(math.nan ~= math.nan)
assert(math.isnan(math.nan))

-- isnan, isinf, isfinite
assert(math.isnan(0/0))
assert(math.isnan(10) == false)
assert(math.isnan(math.huge) == false)
