-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/constructs.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- Split from conformance/luau/constructs.walu. Helper setup is repeated as
-- needed so each numbered chunk is independently discoverable by the conformance runner.

local f = function (i)
  if i < 10 then return 'a';
  elseif i < 20 then return 'b';
  elseif i < 30 then return 'c';
  end;
end

assert(f(3) == 'a' and f(12) == 'b' and f(26) == 'c' and f(100) == nil)
