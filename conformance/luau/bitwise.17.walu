-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/bitwise.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: pending
-- Waluau does not infer a negative numeric value passed through this
-- unannotated pcall/noinline helper as the u32 bit pattern expected by bit32.
--
-- Split from conformance/luau/bitwise.8.walu. Helper setup is repeated so the
-- chunk remains independently discoverable by the conformance runner.

local function noinline(x, ...) local s, r = pcall(function(y) return y end, x) return r end

assert(bit32.arshift(noinline(-1), 1) == 0xffffffff)
assert(bit32.arshift(noinline(-1), 24) == 0xffffffff)
assert(bit32.arshift(noinline(-1), 32) == 0xffffffff)
assert(bit32.arshift(noinline(-1), -1) == (-1 * 2) % 2^32)
