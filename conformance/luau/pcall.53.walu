-- tests/conformance/pcall.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: typed-coroutine
-- This chunk contains only pcall.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/pcall.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
print("testing pcall")

function checkresults(e, ...)
	local t = table.pack(...)
	assert(t.n == #e)
	for i=1,t.n do
		assert(t[i] == e[i])
	end
end

local calllimit = 20000
function recurse(n)
	return n <= 1 and 1 or recurse(n-1) + 1
end

function yieldandrecurse(n)
	coroutine.yield()
	recurse(n)
end

-- Same tests as above are performed using the pcall continuation
local yieldwithsameresult = coroutine.wrap(function()
		-- however, if xpcall handler itself runs out of extra stack space, we get "error in error handling"
		checkresults({ false, "error in error handling" }, xpcall(yieldandrecurse, function() return recurse(calllimit) end, calllimit - 2))

	return 1
end)

while yieldwithsameresult() ~= 1 do end
