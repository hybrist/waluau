-- conformance: pending
-- This chunk contains only checks from tables.luau that currently fail in
-- Waluau. Remove this directive when the whole chunk passes.
-- Split from conformance/luau/tables.walu. Top-level do scope wrappers
-- are flattened in tail chunks where needed so each numbered chunk is
-- independently discoverable by the conformance runner.

  local function foo(u) u.y.x = 99 end
  local t = {x = 1}
  local u = {y = t}
  foo(u)
  assert(t.x == 99)
  local mt = { __add = function(t, _) t.x = 99 end }
  local t = { x = 1 }
  setmetatable(t, mt)
  local _ = t + 1
  assert(t.x == 99)
  local t = {x = 1}
  (if true then t else t)['x'] = 99
  assert(t.x == 99);
  (if false then t else t)['x'] = 1000
  assert(t.x == 1000)
  local function mutate(x) x.a = 99 end
  local t = { a = 1 }
  mutate(t and t)
  assert(t.a == 99)
  local function mutate(x) x.a = 99 end
  local t = { a = 1 }
  local x = t or false
  mutate(x)
  assert(t.a == 99)
