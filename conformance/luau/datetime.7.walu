-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/datetime.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: browser-clocks-and-calendars
-- Every check here starts from os.date("*t") or os.date("!*t") calendar
-- tables, mutates their fields, and feeds them back to os.time. Browser os.*
-- has no calendar-table value and reports no isdst, because it does not model
-- a local timezone with daylight saving. See DEVIATIONS.md, "Browser clocks
-- and calendar values".
--
-- Split from conformance/luau/datetime.walu in original source order.
-- Upstream source lines 72-98.

do
  local D = os.date("*t")
  local t = os.time(D)
  if D.isdst == nil then
    print("no daylight saving information")
  else
    assert(type(D.isdst) == 'boolean')
  end
  D.isdst = nil
  local t1 = os.time(D)
  assert(t == t1)   -- if isdst is absent uses correct default
end

local D = os.date("*t")
t = os.time(D)
D.year = D.year-1;
local t1 = os.time(D)
-- allow for leap years
assert(math.abs(os.difftime(t,t1)/(24*3600) - 365) < 2)

-- should not take more than 1 second to execute these two lines
t = os.time()
t1 = os.time(os.date("!*t"))
local diff = os.difftime(t1,t)
assert(0 <= diff and diff <= 1)
diff = os.difftime(t,t1)
assert(-1 <= diff and diff <= 0)
