-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/tpack.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: binary-packing
-- This chunk contains only tpack.luau checks that currently fail in Waluau.
-- This is a documented deliberate difference, not scheduled work; see DEVIATIONS.md.
--
-- Split from conformance/luau/tpack.walu. Common setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
-- This file is based on Lua 5.x tests -- https://github.com/lua/lua/tree/master/testes
local pack = string.pack
local packsize = string.packsize
local unpack = string.unpack

-- testing multiple types and sequence
do
  local x = pack("<b h b f d f n i", 1, 2, 3, 4, 5, 6, 7, 8)
  assert(#x == packsize("<b h b f d f n i"))
  local a, b, c, d, e, f, g, h = unpack("<b h b f d f n i", x)
  assert(a == 1 and b == 2 and c == 3 and d == 4 and e == 5 and f == 6 and
         g == 7 and h == 8) 
end