--
-- conformance: untriaged: needs Luau's 'any' type name; 'unknown' is checked where 'any' is not, so aliasing them may be wrong and the rejection may be a deliberate difference rather than waluau-jehg
-- This chunk contains only checks from tables.luau that currently fail in
-- Waluau. Remove this directive when the whole chunk passes.
-- Split from conformance/luau/tables.walu. Top-level do scope wrappers
-- are flattened in tail chunks where needed so each numbered chunk is
-- independently discoverable by the conformance runner.

  local t1 = { a = 1 }
  local t2 = { b = 2 }
  assert(not (t1 == t2))
  assert(t1 ~= t2)
	local t = { a = 1 }
	local x = t or false
	t.a = 99
	assert(x.a == 99)
  local function incnext(t, key)
    local k, v = next(t, key)
    if k ~= nil then t[k] = v + 1 end
    return k, v
  end
  local t = { a = 1 }
  for k, v in incnext, t do end
  assert(t.a == 2)
  local function mutate(x) x.a = 99 end
  local t = { a = 1 }
  mutate((t))
  assert(t.a == 99)
  local function mutate(x) x.a = 99 end
  local t = { a = 1 }
  mutate(t :: any)
  assert(t.a == 99)
