-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/datetime.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: pending
-- These checks pass os.date and os.time as values into a dynamic pcall with a
-- forwarded vararg list. os.date is an overload set, so using it as a value
-- needs an explicit function type, exactly as math.log does; that is the first
-- reported error. The untyped checkerr helper is the dynamic-call/inference
-- gap waluau-9f8d, and the final os.time check additionally needs the
-- calendar-table argument documented in DEVIATIONS.md, "Browser clocks and
-- calendar values".
--
-- Split from conformance/luau/datetime.walu in original source order.
-- Upstream source lines 5-8 and 65-70; the checkerr helper is the setup the
-- calls need.

local function checkerr (msg, f, ...)
  local stat, err = pcall(f, ...)
  assert(not stat and string.find(err, msg, 1, true))
end

checkerr("invalid conversion specifier", os.date, "%9")
checkerr("invalid conversion specifier", os.date, "%O")
checkerr("invalid conversion specifier", os.date, "%E")
checkerr("invalid conversion specifier", os.date, "%Ea")

checkerr("missing", os.time, {hour = 12})   -- missing date
