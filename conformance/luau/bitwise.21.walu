-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/bitwise.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: pending
-- The wide implicit global is inferred as f64; Waluau does not dynamically
-- truncate arbitrary numeric values to u32 at a typed bit32 boundary.
--
-- Split from conformance/luau/bitwise.13.walu.

-- bit32.bor(n, 0) must clear top bits
-- we check this obscuring the constant through a global to make sure this gets evaluated fully
high32 = 0x42_1234_5678
assert(bit32.bor(high32, 0) == 0x1234_5678)
