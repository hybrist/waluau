-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/pm.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: pending
-- This chunk contains only pm.luau checks that currently fail in Waluau.
-- Remove this directive when the chunk passes.
--
-- Split from conformance/luau/pm.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

function f1(s, p)
  p = string.gsub(p, "%%([0-9])", function (s) return "%" .. (s+1) end)
  p = string.gsub(p, "^(^?)", "%1()", 1)
  p = string.gsub(p, "($?)$", "()%1", 1)
  local t = {string.match(s, p)}
  return string.sub(s, t[1], t[#t] - 1)
end

assert(f1('alo alx 123 b\0o b\0o', '(..*) %1') == "b\0o b\0o")
