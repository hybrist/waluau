-- conformance: pending
-- This chunk contains only calls.luau checks that currently fail in Waluau.
-- Remove this directive when the chunk passes.
--
-- Split from conformance/luau/calls.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

do
  local a = {x=0}
  function a:add (x) self.x, a.y = self.x+x, 20; return self end
  assert(a:add(10):add(20):add(30).x == 60 and a.y == 20)
end
