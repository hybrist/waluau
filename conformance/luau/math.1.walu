--
-- conformance: pending
-- This chunk contains only math.luau checks that currently fail in Waluau.
-- Remove this directive when the whole chunk passes.
--
-- Split from conformance/luau/math.walu. Helper setup is repeated as needed
-- so each numbered chunk is independently discoverable by the conformance runner.

-- This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
-- This file is based on Lua 5.x tests -- https://github.com/lua/lua/tree/master/testes
print("testing numbers and math lib")

do
  local a,b,c = "2", " 3e0 ", " 10  "
  assert(a+b == 5 and -b == -3 and b+"2" == 5 and "10"-c == 0)
  assert(type(a) == 'string' and type(b) == 'string' and type(c) == 'string')
  assert(a == "2" and b == " 3e0 " and c == " 10  " and -c == -"  10 ")
  assert(c%a == 0 and a^b == 8)
end
