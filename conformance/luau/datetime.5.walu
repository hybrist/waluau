-- Imported verbatim from the Luau conformance suite (luau-lang/luau),
-- tests/conformance/datetime.luau at commit 86d2a9d.
-- See README.md and LICENSE in this directory for provenance and licensing.
--
-- conformance: out-of-scope: browser-clocks-and-calendars
-- checkDateTable round-trips os.date("!*t") through os.time. Browser os.date
-- returns a formatted string and browser os.time takes no calendar table, so
-- neither side of the round trip exists. See DEVIATIONS.md, "Browser clocks
-- and calendar values". The untyped helper parameter is separately an
-- inference gap (waluau-9f8d).
--
-- Split from conformance/luau/datetime.walu in original source order.
-- Upstream source lines 49-63.

local function checkDateTable (t)
  local D = os.date("!*t", t)
  assert(os.time(D) == t)
  local DC = os.date("!%Y %m %d %H %M %S %w %j"):split(" ")
  assert(D.year == tonumber(DC[1]))
  assert(D.month == tonumber(DC[2]))
  assert(D.day == tonumber(DC[3]))
  assert(D.hour == tonumber(DC[4]))
  assert(D.min == tonumber(DC[5]))
  assert(D.sec == tonumber(DC[6]))
  assert(D.wday == tonumber(DC[7]) + 1)
  assert(D.yday == tonumber(DC[8]))
end

checkDateTable(os.time())
