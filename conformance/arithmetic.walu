assert(1 + 2 == 3)
assert(10 - 4 == 6)
assert(3 * 4 == 12)
assert(20 / 8 == 2.5)

assert(2 + 3 * 4 == 14)
assert((2 + 3) * 4 == 20)
assert(2 * 3 + 4 == 10)

assert(-5 + 2 == -3)
assert(-5 * -2 == 10)
assert(0 - 7 == -7)

assert(7 // 2 == 3)
assert(-7 // 3 == -3)
assert(7 % 3 == 1)
assert(-7 % 3 == 2)

assert(1 + 8 // 3 * 2 % 5 == 5)
