-- Tagged-union methods must use the same variant discriminants as constructors
-- lowered in other functions.
type Value = Num(i32) | Flag(i32)

function Value:as_flag(): i32
    if self is Flag then
        return self.value
    end
    return 0
end

local a: Value = Num(42)
assert(a:as_flag() == 0)

local f: Value = Flag(7)
assert(f:as_flag() == 7)
