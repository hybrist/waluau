-- A variadic pack survives a function return and expands again when it is the
-- trailing expression of another return, call, or table constructor.

function concat(head, ...)
    if select('#', ...) == 0 then
        return tostring(head)
    end
    return tostring(head) .. "," .. concat(...)
end

function passthrough(...)
    return ...
end

function relay(...)
    return passthrough(...)
end

assert(concat(relay(1, "two", false)) == "1,two,false")

function prefixed(head: i32, ...)
    return head + 10, ...
end

function relay_prefixed(head: i32, ...)
    return prefixed(head, ...)
end

assert(concat(relay_prefixed(1, 2, 3)) == "11,2,3")

function describe(a, b, ...)
    return tostring(a) .. "/" .. tostring(b) .. "/" .. tostring(select('#', ...))
end

function describe_forwarded(...)
    return describe(passthrough(...))
end

assert(describe_forwarded("a", "b", "c", "d") == "a/b/2")

function collect_returned(...)
    return {passthrough(...)}
end

local collected = collect_returned(4, 5, 6)
assert(#collected == 3)
assert(collected[0] == 4)
assert(collected[1] == 5)
assert(collected[2] == 6)
