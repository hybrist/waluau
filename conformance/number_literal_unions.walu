type Volume = 0 | 1 | 2
type Direction = -1 | 1
type Speed = 0.5 | 1.0 | 2.0
type BigId = 1 | 5000000000

function louder(volume: Volume): Volume
    if volume < 2 then
        return ((volume + 1)::Volume)
    end
    return volume
end

local volume: Volume = 1
assert(volume == 1)
assert(volume < 2)
local as_number: f64 = volume
assert(as_number == 1)
local sum: i32 = volume + 5
assert(sum == 6)
assert(louder(volume) == 2)
assert(louder(2) == 2)

local direction: Direction = -1
assert(direction == -1)
assert(tostring(direction) == "-1")
local reversed: Direction = ((-direction)::Direction)
assert(reversed == 1)

local speed: Speed = 0.5
local doubled: f64 = speed * 2
assert(doubled == 1.0)

local id: BigId = 5000000000
local wide: i64 = id
assert(wide == 5000000000)
