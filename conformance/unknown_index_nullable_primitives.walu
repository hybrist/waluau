-- Dynamic indexing (`t[i]` where `t` is `unknown`) over arrays of nullable
-- primitives. Elements are typed nullable boxes: a nil slot must come back as
-- the `unknown` nil, and a present slot must be unwrapped from its box and
-- reboxed into the canonical `unknown` representation (i31 / boxed f64) so it
-- compares equal to the same value written literally.
--
-- The nullable i32, u32, and bool wrappers have structurally identical storage.
-- Their stored element-kind tags must keep dynamic dispatch from selecting the
-- first matching Wasm GC type and applying the wrong unknown-boxing rule.
function get(v, i)
    return v[i]
end

function len_of(v)
    return #v
end

local ints: {i32?} = {1, nil, 3}
assert(len_of(ints) == 3)
assert(get(ints, 1) == 1)
assert(get(ints, 3) == 3)

-- Reading a nil slot back through `unknown` yields nil, not a stray box.
local missing_int: i32? = get(ints, 2)
assert(missing_int == nil)
local present_int: i32? = get(ints, 1)
assert(present_int ~= nil)
assert(present_int == 1)

local uints: {u32?} = {4, nil, 6}
assert(len_of(uints) == 3)
assert(get(uints, 1) == 4)
assert(get(uints, 3) == 6)
local missing_uint: u32? = get(uints, 2)
assert(missing_uint == nil)

local flags: {bool?} = {true, nil, false}
assert(len_of(flags) == 3)
assert(get(flags, 1) == true)
assert(get(flags, 3) == false)
local missing_flag: bool? = get(flags, 2)
assert(missing_flag == nil)

local reals: {f64?} = {1.5, nil}
assert(len_of(reals) == 2)
assert(get(reals, 1) == 1.5)
local missing_real: f64? = get(reals, 2)
assert(missing_real == nil)
local present_real: f64? = get(reals, 1)
assert(present_real ~= nil)
assert(present_real == 1.5)
