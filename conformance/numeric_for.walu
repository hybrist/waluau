function sum_even_to(limit: i32): i32
    local acc: i32 = 0
    for i = 2::i32, limit, 2::i32 do
        acc += i
    end
    return acc
end

function countdown_sum(start: i32): i32
    local acc: i32 = 0
    for i = start, 1::i32, -1::i32 do
        acc += i
    end
    return acc
end

function default_step_sum(limit: i32): i32
    local acc: i32 = 0
    for i = 1::i32, limit do
        acc += i
    end
    return acc
end

assert(sum_even_to(6) == 12)
assert(countdown_sum(4) == 10)
assert(default_step_sum(4) == 10)
