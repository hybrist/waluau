local point = { x = 10::i32, y = 3::i32 }

function point:sum_with(delta: i32): i32
    return self.x + self.y + delta
end

function point:scaled_sum(scale: i32): i32
    return (self.x + self.y) * scale
end

function point:bump_x(delta: i32): i32
    self.x = self.x + delta
    return self.x
end

function point:identity<T>(value: T): T
    local _sum: i32 = self.x + self.y
    return value
end

assert(point:sum_with(5::i32) == 18::i32)
assert(point:scaled_sum(2::i32) == 26::i32)
assert(point:sum_with(1::i32) == 14::i32)
assert(point:bump_x(4::i32) == 14::i32)
assert(point.x == 14::i32)
assert(point:sum_with(1::i32) == 18::i32)

local n: i32 = point:identity<i32>(41::i32)
local b: bool = point:identity<bool>(true)

assert(n == 41::i32)
assert(b == true)

type Point = { x: i32, y: i32 }

function Point:sum_with(delta: i32): i32
    return self.x + self.y + delta
end

function Point:translated(dx: i32, dy: i32): Point
    return { x = (self.x + dx)::i32, y = (self.y + dy)::i32 }
end

local a: Point = { x = 2::i32, y = 4::i32 }
local c: Point = { x = 10::i32, y = 1::i32 }
local moved: Point = a:translated(5::i32, 7::i32)

assert(a:sum_with(3::i32) == 9::i32)
assert(c:sum_with(3::i32) == 14::i32)
assert(moved:sum_with(0::i32) == 18::i32)
