function job_one(): i32
    return 7
end

function job_two(): i32
    return 11
end

local first_co: thread = coroutine.create(job_one)
local ok1: bool, v1: i32 = coroutine.resume(first_co)
assert(ok1)
assert(v1 == 7)

local second_co: thread = coroutine.create(job_two)
local ok2: bool, v2: i32 = coroutine.resume(second_co)
assert(ok2)
assert(v2 == 11)

-- Resuming a finished coroutine reports (false, 0) instead of trapping.
local ok3: bool, v3: i32 = coroutine.resume(first_co)
assert(not ok3)
assert(v3 == 0)

-- Closing a finished coroutine is a no-op that reports success.
assert(coroutine.close(first_co))
