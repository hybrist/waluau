-- Coroutine suspension and resumption with `coroutine_yield`.

function counter_job(): i32
    coroutine_yield(1)
    coroutine_yield(2)
    return 3
end

local co: thread = coroutine_create(counter_job)

local o1: bool, a: i32 = coroutine_resume(co)
assert(o1)
assert(a == 1)
local o2: bool, b: i32 = coroutine_resume(co)
assert(o2)
assert(b == 2)
local o3: bool, c: i32 = coroutine_resume(co)
assert(o3)
assert(c == 3)

-- Resuming after the body returns reports (false, 0).
local o4: bool, d: i32 = coroutine_resume(co)
assert(not o4)
assert(d == 0)

-- Yield should also work through normal calls, not only when the yield call
-- appears directly in the coroutine entry function.
function emit_three_values(): ()
    coroutine_yield(10)
    coroutine_yield(20)
end

function delegated_job(): i32
    emit_three_values()
    return 30
end

local delegated: thread = coroutine_create(delegated_job)

local e1: bool, e: i32 = coroutine_resume(delegated)
assert(e1)
assert(e == 10)
local e2: bool, f: i32 = coroutine_resume(delegated)
assert(e2)
assert(f == 20)
local e3: bool, g: i32 = coroutine_resume(delegated)
assert(e3)
assert(g == 30)
