-- A top-level `local NAME <const> = <literal>` is a module constant: unlike
-- plain top-level locals, it is also visible inside function bodies (the
-- linker inlines the literal at each use).

local CELL_SIZE <const>: f64 = 16.0
local COLS <const>: i32 = 21
local TITLE <const> = "snake"
local WRAP <const> = false

function cell_px(v: i32): f64
    return v::f64 * CELL_SIZE
end

function board_width(): f64
    return cell_px(COLS)
end

-- Lexical shadowing still applies: params and locals win over the constant.
function shadowed(CELL_SIZE: f64): f64
    return CELL_SIZE * 2.0
end

function shadowed_local(): f64
    local CELL_SIZE: f64 = 3.0
    return CELL_SIZE
end

assert(CELL_SIZE == 16.0)
assert(cell_px(2) == 32.0)
assert(board_width() == 336.0)
assert(shadowed(5.0) == 10.0)
assert(shadowed_local() == 3.0)
assert(TITLE == "snake")
assert(not WRAP)
