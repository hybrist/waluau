-- Calls may omit a trailing suffix of nullable parameters. The callee still
-- receives a value for every fixed parameter, with nil filling omitted slots.
function choose(fallback: string, value: string?): string
    if value == nil then
        return fallback
    end
    return value
end

assert(choose("ten") == "ten")
assert(choose("ten", "twenty") == "twenty")

function choose_two(fallback: string, first: string?, second: string?): string
    if second ~= nil then
        return second
    end
    if first ~= nil then
        return first
    end
    return fallback
end

assert(choose_two("one") == "one")
assert(choose_two("one", "two") == "two")
assert(choose_two("one", "two", "three") == "three")

type Counter = { base: string }

function Counter:add(delta: string?): string
    if delta == nil then
        return self.base
    end
    return delta
end

local counter: Counter = { base = "four" }
assert(counter:add() == "four")
assert(counter:add("seven") == "seven")

local indirect: (string, string?) -> string = choose
assert(indirect("eight") == "eight")

local ok, protected = pcall(indirect, "nine")
assert(ok)
assert(protected == "nine")

function optional_vararg(value: string?, ...): string
    if value == nil then
        return tostring(select('#', ...))
    end
    return value
end

assert(optional_vararg() == "0")
assert(optional_vararg("six") == "six")

-- Options records may themselves be nullable. Nullable fields can be omitted
-- from a record literal and are materialized as nil, including nullable arrays.
type Child = { name: string }
type Options = { id: string?, class: string?, children: {Child}? }

function render(opts: Options?): string
    if opts == nil then
        return "default"
    end
    if opts.id ~= nil then
        return opts.id
    end
    if opts.class ~= nil then
        return opts.class
    end
    if opts.children ~= nil then
        return tostring(#opts.children)
    end
    return "empty"
end

assert(render() == "default")
assert(render { id = "my-el" } == "my-el")
assert(render { class = "hero" } == "hero")
assert(render { children = {{ name = "child" }} } == "1")
