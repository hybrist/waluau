function test_string_find(): bool
    local haystack: string = "hello world"
    local needle: string = "world"
    
    local result: u32? = string_find(haystack, needle)
    if result then
        print("Found at position: " .. tostring(result))
        return true
    else
        print("Not found")
        return false
    end
end

assert(test_string_find())