function test_string_find(): bool
    local haystack: string = "hello world"
    local needle: string = "world"
    
    local result: i32 = string_find(haystack, needle)
    if result > -1 then
        print("Found at position")
        return result == 6  -- "world" should start at index 6 in "hello world"
    else
        print("Not found")
        return false
    end
end

function test_string_find_not_found(): bool
    local haystack: string = "hello world"
    local needle: string = "xyz"
    
    local result: i32 = string_find(haystack, needle)
    return result == -1
end

assert(test_string_find())
assert(test_string_find_not_found())