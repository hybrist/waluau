-- Conformance fixture for the portable GPU material/capability slice.
local engine = require("../../engine/browser")
local graphics_module = require("../../engine/graphics")
local input_module = require("../../engine/input")

function install_gpu_material_fixture(): unit
    local function load(): unit
    end
    local function update(dt: f64, input: input_module.Input): unit
    end
    local function draw(graphics: graphics_module.Graphics, alpha: f64): unit
        assert(graphics:supports("gpu"))
        assert(graphics:supports("named-materials"))
        assert(graphics:supports("blend-modes"))
        assert(graphics:supports("textures"))
        assert(graphics:supports("sprite-batches"))
        assert(graphics:supports("render-targets"))
        assert(not graphics:supports("custom-shaders"))

        local missing: graphics_module.MaterialResult = graphics:create_material("missing")
        assert(not missing.ok and missing.error.code == "unknown_material")
        local custom: graphics_module.MaterialResult = graphics:create_custom_material("invalid")
        assert(not custom.ok and custom.error.code == "unsupported")
        local created: graphics_module.MaterialResult = graphics:create_material("nature")
        assert(created.ok)
        assert(graphics:use_material(created.material))

        graphics:clear("#000000")
        graphics:set_color("#40ff40")
        graphics:fill_rectangle(24.0, 24.0, 80.0, 48.0)
        assert(graphics:set_blend_mode("add"))
        graphics:set_material("plain")
        graphics:set_color("#40004080")
        graphics:fill_rectangle(48.0, 40.0, 80.0, 48.0)
        assert(graphics:set_blend_mode("alpha"))

        graphics:release_material(created.material)
        assert(not graphics:use_material(created.material))
    end
    local function keypressed(key: string): unit end
    local function keyreleased(key: string): unit end

    engine.start({
        title = "GPU material conformance", width = 160, height = 100,
        update_hz = 60.0, max_frame_seconds = 0.25, background = "#000000",
    }, {
        load = load, update = update, draw = draw,
        keypressed = keypressed, keyreleased = keyreleased,
    })
end

install_gpu_material_fixture()
