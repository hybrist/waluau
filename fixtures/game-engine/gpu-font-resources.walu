-- Real browser contract for packaged image/font readiness, GPU copies,
-- safe load failure, and explicit released-resource diagnostics.
local engine = require("../../engine/browser")
local graphics_module = require("../../engine/graphics")
local input_module = require("../../engine/input")
local resources = require("../../engine/resources")

declare function record_gpu_font_step(step: string): unit

type FixtureState = {
    image: resources.Resource,
    font: resources.Resource,
    loaded: bool,
    rendered: bool
}

function install_gpu_font_fixture(): unit
    local state: FixtureState = {
        image = { handle = 0, kind = "image", path = "assets/card-back.svg" },
        font = { handle = 0, kind = "font", path = "assets/Cinzel-SemiBold.ttf" },
        loaded = false,
        rendered = false,
    }

    local function load_async(): i32
        local image_result: resources.LoadResult = resources.await_image("assets/card-back.svg")
        local font_result: resources.LoadResult = resources.await_font("assets/Cinzel-SemiBold.ttf", "Arcane Vault Test")
        local missing: resources.LoadResult = resources.await_image("assets/missing.svg")
        assert(image_result.ok and font_result.ok)
        assert(not missing.ok and missing.error.code == "not_found")
        state.image = image_result.resource
        state.font = font_result.resource
        state.loaded = true
        record_gpu_font_step("ready-and-failure")
        return 0
    end

    local function load(): unit
        local co: thread = coroutine.create(load_async)
        coroutine.resume(co)
    end
    local function update(dt: f64, input: input_module.Input): unit end
    local function draw(graphics: graphics_module.Graphics, alpha: f64): unit
        if not state.loaded or state.rendered then return end
        assert(graphics:supports("textures") and graphics:supports("custom-fonts"))

        local texture_result: graphics_module.TextureResult = graphics:texture_from_resource(state.image)
        local font_result: graphics_module.FontResult = graphics:font_from_resource(state.font)
        resources.release(state.image)
        resources.release(state.font)
        assert(texture_result.ok and font_result.ok)
        local texture: graphics_module.Texture = texture_result.texture
        local custom_font: graphics_module.Font = font_result.font
        assert(graphics:texture_error(texture).code == "")
        assert(graphics:font_error(custom_font).code == "")

        graphics:clear("#101018")
        graphics:set_color("#ffffff")
        assert(graphics:draw_sprite(texture, 8.0, 8.0, 32.0, 32.0, 0.0, 0.0, texture.width::f64, texture.height::f64))
        assert(graphics:set_font_resource(custom_font, 24.0))
        graphics:set_color("#40ffff")
        graphics:print("VAULT", 52.0, 35.0)
        graphics:flush()
        record_gpu_font_step("rendered")

        graphics:release_font(custom_font)
        graphics:release_font(custom_font)
        assert(graphics:font_error(custom_font).code == "released")
        assert(not graphics:set_font_resource(custom_font, 24.0))
        graphics:release_texture(texture)
        graphics:release_texture(texture)
        assert(graphics:texture_error(texture).code == "released")
        assert(not graphics:draw_image(texture, 0.0, 0.0))
        record_gpu_font_step("released")
        state.rendered = true
    end
    local function keypressed(key: string): unit end
    local function keyreleased(key: string): unit end
    engine.start({
        title = "GPU font resources", width = 220, height = 64,
        update_hz = 60.0, max_frame_seconds = 0.25, background = "#101018",
    }, {
        load = load, update = update, draw = draw,
        keypressed = keypressed, keyreleased = keyreleased,
    })
end

install_gpu_font_fixture()
