-- Browser-session fixture whose exported controls let the conformance host
-- model two independently instantiated Wasm generations in one document.
local engine = require("waluau:engine")

local session: engine.Session? = nil
local active_graphics: engine.Graphics? = nil
local draws: i32 = 0
local keypresses: i32 = 0
local activations: i32 = 0
local focused: string = ""
local modal: bool = false
local selected: bool = false

local function accessibility(): engine.AccessibleState
    if modal then
        return {
            heading = "Confirmation",
            status = "Review your choice",
            dialog = "confirmation",
            dismiss = "close",
            items = {{ key = "close", kind = "button", label = "Close confirmation" }}
        }
    end
    return {
        heading = "Choose a card",
        status = "Ready",
        items = {
            { key = "hand", kind = "group", label = "Your hand" },
            {
                key = "card",
                parent = "hand",
                kind = "button",
                label = "Ace of hearts",
                description = "A red card",
                selected = selected
            },
            { key = "open", kind = "button", label = "Open confirmation" },
            { key = "unavailable", kind = "button", label = "Unavailable", disabled = true }
        }
    }
end

local function activate(key: string): unit
    if key == "card" and not modal then
        selected = not selected
        activations += 1
    elseif key == "open" and not modal then
        modal = true
        activations += 1
    elseif key == "close" and modal then
        modal = false
        activations += 1
    end
end

local function load(): unit
end

local function update(dt: f64, input: engine.Input): unit
end

local function draw(graphics: engine.Graphics, alpha: f64): unit
    active_graphics = graphics
    draws += 1
    graphics:clear("#0f172a")
end

local function keypressed(key: string): unit
    keypresses += 1
end

session = engine.start(
    {
        title = "Engine session lifecycle",
        width = 160,
        height = 90,
        update_hz = 60.0,
        max_frame_seconds = 0.25,
        background = "#0f172a"
    },
    {
        load = load,
        update = update,
        draw = draw,
        keypressed = keypressed,
        keyreleased = nil,
        mousepressed = nil,
        mousereleased = nil,
        mousemoved = nil,
        accessibility = accessibility,
        accessibility_activate = activate,
        accessibility_focus = function(key: string): unit
            focused = key
        end
    }
)

export function draw_count(): i32
    return draws
end

export function keypress_count(): i32
    return keypresses
end

export function bind_render_target(): bool
    local graphics: engine.Graphics? = active_graphics
    if graphics == nil then
        return false
    end
    local running: engine.Graphics = graphics::engine.Graphics
    local result = running:create_render_target(16, 16)
    return result.ok and running:set_render_target(result.target)
end

export function suspend_game(): unit
    local running: engine.Session? = session
    if running ~= nil then
        (running::engine.Session).suspend()
    end
end

export function stop_game(): unit
    local running: engine.Session? = session
    if running ~= nil then
        (running::engine.Session).stop()
        session = nil
    end
end

export function activation_count(): i32
    return activations
end

export function focused_key(): string
    return focused
end
