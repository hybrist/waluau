-- Arcane Heist: Poker Tricks hosted by the 2D game engine. The rules remain
-- host-independent; this module translates keyboard input into game actions.

local engine = require("../../engine/browser")
local input_module = require("../../engine/input")
local graphics_module = require("../../engine/graphics")
local game = require("./game")
local render = require("./render")

type Ui = {
    hand_cursor: i32,
    ward_cursor: i32,
    cursor_area: i32,
    play_picks: {i32},
    swap_hand: {i32},
    swap_wards: {i32},
    modal: i32,
    revealing: bool,
    reveal_clock: f64,
    message: string
}

local MODAL_NONE <const>: i32 = 0
local MODAL_HISTORY <const>: i32 = 1
local MODAL_HELP <const>: i32 = 2
local MODAL_FINAL <const>: i32 = 4
-- Both staggered flips finish before the first continue press advances play.
local BOARD_REVEAL_SECONDS <const>: f64 = 1.6

function contains(picks: {i32}, value: i32): bool
    for pick in picks do
        if pick == value then return true end
    end
    return false
end

function toggle(picks: {i32}, value: i32, limit: i32): unit
    for index, pick in picks do
        if pick == value then
            table.remove(picks, index)
            return
        end
    end
    if #picks < limit then table.insert(picks, value) end
end

function clear_picks(ui: Ui): unit
    ui.play_picks = {}
    ui.swap_hand = {}
    ui.swap_wards = {}
    ui.cursor_area = 0
    ui.hand_cursor = 0
    ui.ward_cursor = 0
end

function reset_run(state: game.State, ui: Ui): unit
    state:reset()
    clear_picks(ui)
    ui.modal = MODAL_HELP
    ui.revealing = false
    ui.reveal_clock = 0.0
    ui.message = "Choose a school relic to begin the breach."
end

function install_arcane_heist(): unit
    local state: game.State = game.new()
    local ui: Ui = {
        hand_cursor = 0,
        ward_cursor = 0,
        cursor_area = 0,
        play_picks = {},
        swap_hand = {},
        swap_wards = {},
        modal = MODAL_HELP,
        revealing = false,
        reveal_clock = 0.0,
        message = "Choose a school relic to begin the breach.",
    }

    local function load(): unit
        -- No reseed: the host seeds math.random per instance, so each run
        -- deals a different shuffle. sim.walu pins its own seeds for tests.
        reset_run(state, ui)
    end

    local function update(dt: f64, input: input_module.Input): unit
        -- Turns are discrete; the clock only drives the board reveal flip.
        if ui.revealing then
            ui.reveal_clock += dt
            if ui.reveal_clock >= BOARD_REVEAL_SECONDS then
                ui.reveal_clock = BOARD_REVEAL_SECONDS
            end
        end
    end

    local function draw(graphics: graphics_module.Graphics, alpha: f64): unit
        render.draw(graphics, state, ui.hand_cursor, ui.ward_cursor, ui.cursor_area,
            ui.play_picks, ui.swap_hand, ui.swap_wards, ui.modal, ui.revealing, ui.reveal_clock, ui.message)
    end

    local function close_modal(): unit
        if ui.modal ~= MODAL_FINAL then
            ui.modal = MODAL_NONE
        end
    end

    local function submit_swap(): unit
        if #ui.swap_hand == 0 and #ui.swap_wards == 0 then
            state:resolve_swap({}, {})
            clear_picks(ui)
            ui.message = "Both plans are revealed. Select two relics for the breach."
        elseif #ui.swap_hand ~= #ui.swap_wards then
            ui.message = "Mark the same number of relics and wards."
        elseif #ui.swap_hand > state.player_points then
            ui.message = "You lack enough sparks for that wager."
        else
            state:resolve_swap(ui.swap_hand, ui.swap_wards)
            clear_picks(ui)
            if state.swap_winner > 0 then
                ui.message = "Your feint pierced the wards. Select two relics."
            elseif state.swap_winner < 0 then
                ui.message = "The Arch Mage anticipated the feint. Select two relics."
            else
                ui.message = "The feints canceled. Select two relics."
            end
        end
    end

    local function submit_breach(): unit
        if #ui.play_picks ~= 2 then
            ui.message = "Bind exactly two relics before breaching."
            return
        end
        state:play(ui.play_picks[0], ui.play_picks[1])
        clear_picks(ui)
        ui.modal = MODAL_NONE
        ui.revealing = true
        ui.reveal_clock = 0.0
        ui.message = ""
    end

    local function keypressed(key: string): unit
        if ui.revealing then
            -- The first press completes the animation; a later press advances.
            if key == "Enter" or key == " " or key == "Escape" then
                if ui.reveal_clock < BOARD_REVEAL_SECONDS then
                    ui.reveal_clock = BOARD_REVEAL_SECONDS
                else
                    ui.revealing = false
                    if state.finished then ui.modal = MODAL_FINAL
                    else ui.message = "Choose a school relic to begin the next feint." end
                end
            elseif key == "r" or key == "R" then
                reset_run(state, ui)
            end
            return
        end
        if key == "r" or key == "R" then
            reset_run(state, ui)
            return
        elseif key == "h" or key == "H" then
            if ui.modal == MODAL_HISTORY then ui.modal = MODAL_NONE else ui.modal = MODAL_HISTORY end
            return
        elseif key == "?" or key == "/" then
            if ui.modal == MODAL_HELP then ui.modal = MODAL_NONE else ui.modal = MODAL_HELP end
            return
        end

        if ui.modal ~= MODAL_NONE then
            if key == "Escape" or key == "Enter" or key == " " then close_modal() end
            return
        end

        if key == "ArrowLeft" or key == "a" then
            if ui.cursor_area == 0 then
                ui.hand_cursor -= 1
                if ui.hand_cursor < 0 then ui.hand_cursor = 4 end
            else
                ui.ward_cursor -= 1
                if ui.ward_cursor < 0 then ui.ward_cursor = 2 end
            end
        elseif key == "ArrowRight" or key == "d" then
            if ui.cursor_area == 0 then
                ui.hand_cursor = (ui.hand_cursor + 1) % 5
            else
                ui.ward_cursor = (ui.ward_cursor + 1) % 3
            end
        elseif state.swap_open and (key == "ArrowUp" or key == "ArrowDown" or key == "w" or key == "s") then
            ui.cursor_area = 1 - ui.cursor_area
        elseif key == " " then
            if state.swap_open then
                if ui.cursor_area == 0 then toggle(ui.swap_hand, ui.hand_cursor, 3)
                else toggle(ui.swap_wards, ui.ward_cursor, 3) end
            else
                toggle(ui.play_picks, ui.hand_cursor, 2)
            end
        elseif key == "p" or key == "P" then
            if state.swap_open then
                ui.swap_hand = {}
                ui.swap_wards = {}
                submit_swap()
            end
        elseif key == "Enter" then
            if state.swap_open then submit_swap() else submit_breach() end
        end
    end

    local function keyreleased(key: string): unit end

    engine.start({
        title = "Arcane Heist",
        width = 960,
        height = 600,
        update_hz = 60.0,
        max_frame_seconds = 0.25,
        background = "#09090b",
    }, {
        load = load,
        update = update,
        draw = draw,
        keypressed = keypressed,
        keyreleased = keyreleased,
    })
end

install_arcane_heist()
