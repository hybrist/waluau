-- Interactive browser UI for Poker Tricks.

local game = require("./game")
local window = require("dom:window")

function make_element(document: Document, tag: string, class_name: string): Element
    local element: Element = document:create_element(tag)
    element.class_name = class_name
    return element
end

function card_rank(card: game.Card): string
    if card.rank == 14 then return "A" end
    if card.rank == 13 then return "K" end
    if card.rank == 12 then return "Q" end
    if card.rank == 11 then return "J" end
    return tostring(card.rank)
end

function card_suit(card: game.Card): string
    if card.suit == 1 then return "♦" end
    if card.suit == 2 then return "♥" end
    if card.suit == 3 then return "♠" end
    return "♣"
end

function card_color(card: game.Card): string
    if card.suit == 1 or card.suit == 2 then return "pt-card-red" end
    return "pt-card-black"
end

function append_card_face(document: Document, element: Element, card: game.Card): unit
    local color: string = card_color(card)
    local corner: Element = make_element(document, "span", "pt-card-corner " .. color)
    corner.text_content = card_rank(card) .. "\n" .. card_suit(card)
    element:append_child(corner)
    local pip: Element = make_element(document, "span", "pt-card-pip " .. color)
    pip.text_content = card_suit(card)
    element:append_child(pip)
    local bottom: Element = make_element(document, "span", "pt-card-corner pt-card-corner-bottom " .. color)
    bottom.text_content = card_rank(card) .. "\n" .. card_suit(card)
    element:append_child(bottom)
end

function make_showdown_card(document: Document, card: game.Card, delay: i32): Element
    local card_element: Element = make_element(document, "div", "pt-card pt-card-static pt-reveal-card")
    card_element:set_attribute("role", "img")
    card_element:set_attribute("aria-label", game.card_name(card))
    card_element:set_attribute("style", "animation-delay: " .. tostring(delay) .. "ms")
    append_card_face(document, card_element, card)
    return card_element
end

function append_showdown_cards(document: Document, row: Element, cards: {game.Card}, first_delay: i32): unit
    local delay: i32 = first_delay
    for card in cards do
        row:append_child(make_showdown_card(document, card, delay))
        delay += 90
    end
end

function install_poker_styles(document: Document, body: HTMLElement): unit
    if document:get_element_by_id("poker-tricks-style") ~= nil then return end
    local style: Element = make_element(document, "style", "")
    style.id = "poker-tricks-style"
    style.text_content = "#app{min-height:100vh;padding:1rem;background:radial-gradient(circle at 50% 0%,#174f45 0%,#062c29 42%,#020b12 100%);color:#ecfdf5;font-family:Inter,ui-sans-serif,system-ui,sans-serif}.pt-table{position:relative;isolation:isolate;box-sizing:border-box;display:flex;max-width:64rem;margin:auto;padding:2rem;flex-direction:column;align-items:center;gap:1.25rem;border:10px solid #3f2415;border-radius:2rem;background:radial-gradient(ellipse at center,#116149 0%,#084332 68%,#052b24 100%);box-shadow:0 32px 90px #0009,inset 0 0 0 2px #f5d87926,inset 0 0 80px #001b14}.pt-table:before{content:'';position:absolute;inset:10px;border:1px solid #f6d98530;border-radius:1.4rem;pointer-events:none;z-index:-1}.pt-eyebrow,.pt-section-label,.pt-community-label{margin:0;text-transform:uppercase;font-size:.68rem;font-weight:900;letter-spacing:.28em;color:#d1fae5b8}.pt-eyebrow{color:#fde68aab;letter-spacing:.42em}.pt-title{margin:-.65rem 0 0;font-family:Georgia,serif;font-size:clamp(2.35rem,7vw,4rem);font-weight:900;letter-spacing:.12em;line-height:1;text-transform:uppercase;color:#f7d774;text-shadow:0 3px 0 #623f13,0 10px 28px #0008}.pt-rules{max-width:42rem;margin:0;text-align:center;font-size:.82rem;line-height:1.6;color:#d1fae5c7}.pt-score{margin:0;padding:.6rem 1.25rem;border:1px solid #fde68a33;border-radius:999px;background:#001b1499;color:#fef3c7;font-family:ui-monospace,monospace;font-size:.8rem;font-weight:800;box-shadow:0 0 40px #f6d36530}.pt-opponent-row,.pt-card-row{display:flex;justify-content:center;gap:.75rem}.pt-community{box-sizing:border-box;width:100%;max-width:46rem;padding:1.25rem;border:1px solid #fde68a1f;border-radius:1.75rem;background:#001b1444;box-shadow:inset 0 8px 32px #00150e55}.pt-community-label{margin-bottom:1rem;text-align:center;color:#fde68acc}.pt-status{box-sizing:border-box;min-height:3rem;max-width:42rem;margin:0;padding:.75rem 1.25rem;border:1px solid #fff2;border-radius:1rem;background:#001b1477;color:#fef3c7;text-align:center;font-size:.88rem;font-weight:700;line-height:1.5}.pt-controls{display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem}.pt-button{padding:.78rem 1.35rem;border-radius:.8rem;font-weight:900;transition:transform .18s,box-shadow .18s,filter .18s}.pt-button-primary{border:0;background:linear-gradient(#fde68a,#d99b26);color:#052e2b;box-shadow:0 8px 18px #0005}.pt-button-secondary{border:1px solid #d1fae533;background:#001b1499;color:#ecfdf5}.pt-button:hover{transform:translateY(-2px);filter:brightness(1.08)}.pt-button:active{transform:translateY(1px)}.pt-history{box-sizing:border-box;width:100%;padding:1rem;border:1px solid #fff2;border-radius:1rem;background:#001b1455}.pt-history-title{margin:0 0 .75rem;text-align:center;text-transform:uppercase;font-size:.75rem;font-weight:900;letter-spacing:.25em;color:#fde68acc}.pt-reveal{box-sizing:border-box;width:100%;max-width:48rem;padding:1.5rem;border:1px solid #fde68a44;border-radius:1.5rem;color:#ecfdf5;background:#020617e8;box-shadow:0 24px 50px #0008}.pt-reveal-eyebrow,.pt-show-label{margin:0;text-align:center;text-transform:uppercase;font-size:.65rem;font-weight:900;letter-spacing:.28em;color:#fde68ab8}.pt-reveal-title{margin:.3rem 0 0;text-align:center;font-family:Georgia,serif;font-size:1.8rem;color:#fef3c7}.pt-showdown{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.25rem;margin-top:1.25rem}.pt-show-group{display:flex;flex-direction:column;align-items:center;gap:.55rem}.pt-show-row{display:flex;justify-content:center;gap:.45rem}.pt-player-pair{margin:0;padding:.8rem 1rem;border:1px solid #a7f3d044;border-radius:.8rem;background:#052e2be6;font-family:Georgia,serif;font-size:1.25rem;font-weight:900;letter-spacing:.15em;color:#ecfdf5}.pt-reveal-points{margin:1.25rem 0 0;text-align:center;font-size:.82rem;font-weight:800;color:#fde68a}.pt-card{position:relative;display:block;width:clamp(3.75rem,11vw,5.75rem);aspect-ratio:0.69;overflow:hidden;border-radius:.8rem;border:2px solid #fff;background:linear-gradient(145deg,#fffef8,#e9e5d9);box-shadow:0 10px 22px #00150e80,0 1px 0 #fff inset;transform-style:preserve-3d;transition:transform .22s cubic-bezier(.2,.8,.2,1),box-shadow .22s,border-color .22s;white-space:pre-line}.pt-card-button{cursor:pointer}.pt-card-button:hover{transform:translateY(-10px) rotate(-1deg);box-shadow:0 20px 28px #00150e99,0 0 0 2px #f5d87955}.pt-card-button:focus-visible{outline:3px solid #f8d568;outline-offset:4px}.pt-card-selected{transform:translateY(-16px)!important;border-color:#f8d568!important;box-shadow:0 22px 32px #00150ebb,0 0 0 4px #f8d56855,0 0 30px #fbbf2470!important}.pt-card-corner{position:absolute;left:.48rem;top:.4rem;font-family:Georgia,serif;font-size:clamp(.7rem,2.6vw,1rem);font-weight:900;line-height:.8;text-align:center}.pt-card-corner-bottom{left:auto;right:.48rem;top:auto;bottom:.4rem;transform:rotate(180deg)}.pt-card-pip{position:absolute;inset:0;display:grid;place-items:center;font-family:Georgia,serif;font-size:clamp(2rem,7vw,3.35rem);filter:drop-shadow(0 2px 0 #fff)}.pt-card-red{color:#c51f3b}.pt-card-black{color:#111827}.pt-card-back{background-color:#111827;background-image:linear-gradient(45deg,#f6d36518 25%,transparent 25%),linear-gradient(-45deg,#f6d36518 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#f6d36518 75%),linear-gradient(-45deg,transparent 75%,#f6d36518 75%);background-size:12px 12px;background-position:0 0,0 6px,6px -6px,-6px 0;border:3px solid #f5e7bf;box-shadow:0 8px 18px #00150e88,inset 0 0 0 3px #172554,inset 0 0 0 5px #f5d87966}.pt-card-back:after{content:'PT';position:absolute;inset:16%;display:grid;place-items:center;border:1px solid #f5d87988;border-radius:50%;color:#f5d879;font-family:Georgia,serif;font-size:clamp(.8rem,2.8vw,1.25rem);font-weight:900;letter-spacing:.08em;text-shadow:0 2px 8px #000}.pt-card-static{width:clamp(3rem,8vw,4.5rem);border-width:1px;box-shadow:0 8px 16px #0007}.pt-reveal-card{opacity:0;transform:perspective(700px) rotateY(180deg) translateY(16px);animation:pt-flip .72s cubic-bezier(.2,.75,.2,1) forwards}.pt-card>*{pointer-events:none}@keyframes pt-flip{0%{opacity:0;transform:perspective(700px) rotateY(180deg) translateY(16px) scale(.88)}45%{opacity:1}100%{opacity:1;transform:perspective(700px) rotateY(0) translateY(0) scale(1)}}@media(max-width:640px){#app{padding:.4rem}.pt-table{padding:1.5rem .6rem;gap:1rem;border-width:6px}.pt-card-row{gap:.35rem}.pt-opponent-row{gap:.2rem}.pt-rules{font-size:.72rem}.pt-score{font-size:.68rem;padding:.5rem .75rem}.pt-reveal{padding:1rem}.pt-showdown{grid-template-columns:1fr;gap:1rem}}@media(prefers-reduced-motion:reduce){.pt-card,.pt-button{transition:none}.pt-reveal-card{animation:none;opacity:1;transform:none}}"
    style.text_content = style.text_content .. ".pt-card-selected{animation:pt-select-pop .38s cubic-bezier(.2,1.45,.35,1) both}.pt-score{position:relative}.pt-score-reward:after{content:attr(data-reward);position:absolute;left:50%;top:50%;z-index:3;padding:.32rem .58rem;border:1px solid #fde68a88;border-radius:999px;background:#f7d774;color:#052e2b;font-size:.72rem;white-space:nowrap;box-shadow:0 8px 25px #0008;opacity:0;animation:pt-score-feed .8s 1.55s cubic-bezier(.2,.8,.2,1) both}.pt-score-player-win{animation:pt-score-player .7s 1.62s ease-out both}.pt-score-house-win{animation:pt-score-house .55s 1.62s ease-out both}.pt-score-tie{animation:pt-score-tie .65s 1.62s ease-out both}.pt-reveal{position:relative;transition:border-color .3s,box-shadow .3s}.pt-outcome-player{border-color:#f7d77488;box-shadow:0 24px 50px #0008,0 0 42px #fbbf2438;animation:pt-reveal-player .75s 1.48s ease-out both}.pt-outcome-house{border-color:#fb718566;box-shadow:0 24px 50px #0008,0 0 36px #9f123938;animation:pt-reveal-house .38s 1.48s ease-out both}.pt-outcome-tie{border-color:#93c5fd66;box-shadow:0 24px 50px #0008,0 0 32px #60a5fa30;animation:pt-reveal-tie .7s 1.48s ease-out both}.pt-result-impact{opacity:0;animation:pt-result-impact .48s 1.28s cubic-bezier(.16,1.4,.35,1) both}.pt-outcome-player .pt-result-impact{color:#f7d774;text-shadow:0 0 24px #fbbf2477}.pt-outcome-house .pt-result-impact{color:#fda4af;text-shadow:0 0 20px #e11d4877}.pt-outcome-tie .pt-result-impact{color:#bfdbfe;text-shadow:0 0 20px #60a5fa66}.pt-hand-winner{animation:pt-hand-winner .7s 1.2s ease-out both}.pt-hand-loser{animation:pt-hand-loser .55s 1.2s ease-out both}.pt-hand-tie{animation:pt-hand-tie .7s 1.2s ease-out both}.pt-hand-winner .pt-show-label{color:#f7d774}.pt-hand-loser .pt-show-label{color:#94a3b8}.pt-hand-tie .pt-show-label{color:#bfdbfe}.pt-reward-motion{position:relative;height:3.2rem;margin:.65rem auto -.3rem;max-width:28rem;overflow:visible}.pt-reward-chip{position:absolute;left:50%;top:.45rem;width:1.5rem;height:1.5rem;margin-left:-.75rem;display:grid;place-items:center;border:3px dashed #7c2d12;border-radius:50%;background:#f7d774;color:#7c2d12;font-size:.65rem;box-shadow:0 3px 0 #92400e,0 8px 18px #0008;opacity:0}.pt-reward-badge{position:absolute;left:50%;top:.55rem;padding:.35rem .65rem;border:1px solid #fde68a66;border-radius:999px;background:#001b14e8;color:#fde68a;font-size:.72rem;font-weight:900;white-space:nowrap;opacity:0}.pt-reward-player .pt-reward-chip{animation:pt-chip-player .9s 1.25s cubic-bezier(.2,.8,.2,1) both}.pt-reward-house .pt-reward-chip{animation:pt-chip-house .9s 1.25s cubic-bezier(.2,.8,.2,1) both}.pt-reward-player .pt-reward-badge{animation:pt-badge-player .65s 1.62s ease-out both}.pt-reward-house .pt-reward-badge{animation:pt-badge-house .65s 1.62s ease-out both}.pt-reward-tie .pt-reward-chip-left{animation:pt-chip-refund-left .8s 1.25s ease-out both}.pt-reward-tie .pt-reward-chip-right{animation:pt-chip-refund-right .8s 1.25s ease-out both}.pt-reward-tie .pt-reward-badge{animation:pt-badge-tie .65s 1.55s ease-out both}@keyframes pt-select-pop{0%{transform:translateY(0) scale(1);filter:brightness(1)}58%{transform:translateY(-22px) scale(1.07);filter:brightness(1.16)}78%{transform:translateY(-12px) scale(.99)}100%{transform:translateY(-16px) scale(1);filter:brightness(1)}}@keyframes pt-result-impact{0%{opacity:0;transform:translateY(-10px) scale(.72);letter-spacing:.02em}65%{opacity:1;transform:translateY(2px) scale(1.08)}100%{opacity:1;transform:none}}@keyframes pt-hand-winner{0%{filter:brightness(1);transform:scale(1)}55%{filter:brightness(1.38) drop-shadow(0 0 16px #fbbf2477);transform:scale(1.045)}100%{filter:brightness(1.15) drop-shadow(0 0 10px #fbbf2455);transform:scale(1.02)}}@keyframes pt-hand-loser{from{opacity:1;filter:none}to{opacity:.42;filter:saturate(.3) brightness(.7)}}@keyframes pt-hand-tie{50%{filter:brightness(1.2) drop-shadow(0 0 12px #60a5fa66);transform:translateY(-3px)}100%{filter:brightness(1.08);transform:none}}@keyframes pt-reveal-player{50%{box-shadow:0 24px 50px #0008,0 0 65px #fbbf2470;transform:scale(1.012)}}@keyframes pt-reveal-house{25%{transform:translateX(-4px)}50%{transform:translateX(4px)}75%{transform:translateX(-2px)}}@keyframes pt-reveal-tie{50%{box-shadow:0 24px 50px #0008,0 0 50px #60a5fa55}}@keyframes pt-chip-player{0%{opacity:0;transform:translate(-50%,0) rotate(0) scale(.6)}20%{opacity:1}100%{opacity:1;transform:translate(8.5rem,-.2rem) rotate(420deg) scale(1)}}@keyframes pt-chip-house{0%{opacity:0;transform:translate(-50%,0) rotate(0) scale(.6)}20%{opacity:1}100%{opacity:1;transform:translate(-10rem,-.2rem) rotate(-420deg) scale(1)}}@keyframes pt-chip-refund-left{0%{opacity:0;transform:translate(-50%,0) scale(.6)}25%{opacity:1}100%{opacity:.85;transform:translate(-8rem,0) scale(.9)}}@keyframes pt-chip-refund-right{0%{opacity:0;transform:translate(-50%,0) scale(.6)}25%{opacity:1}100%{opacity:.85;transform:translate(6.5rem,0) scale(.9)}}@keyframes pt-badge-player{0%{opacity:0;transform:translate(-50%,8px) scale(.7)}100%{opacity:1;transform:translate(3.4rem,0) scale(1)}}@keyframes pt-badge-house{0%{opacity:0;transform:translate(-50%,8px) scale(.7)}100%{opacity:1;transform:translate(-9.8rem,0) scale(1)}}@keyframes pt-badge-tie{0%{opacity:0;transform:translate(-50%,8px) scale(.7)}100%{opacity:1;transform:translate(-50%,0) scale(1)}}@keyframes pt-score-feed{0%{opacity:0;transform:translate(-50%,20px) scale(.65)}45%{opacity:1;transform:translate(-50%,-22px) scale(1.08)}100%{opacity:0;transform:translate(-50%,-38px) scale(.9)}}@keyframes pt-score-player{50%{border-color:#fde68acc;box-shadow:0 0 36px #fbbf2470;transform:scale(1.04)}}@keyframes pt-score-house{35%{border-color:#fb718599;box-shadow:0 0 28px #e11d4855;transform:translateX(-3px)}70%{transform:translateX(3px)}}@keyframes pt-score-tie{50%{border-color:#93c5fbaa;box-shadow:0 0 28px #60a5fa55}}@media(max-width:640px){.pt-reward-motion{max-width:18rem}.pt-reward-player .pt-reward-chip{animation-name:pt-chip-player-mobile}.pt-reward-house .pt-reward-chip{animation-name:pt-chip-house-mobile}@keyframes pt-chip-player-mobile{0%{opacity:0;transform:translate(-50%,0) rotate(0) scale(.6)}100%{opacity:1;transform:translate(5.2rem,0) rotate(360deg)}}@keyframes pt-chip-house-mobile{0%{opacity:0;transform:translate(-50%,0) rotate(0) scale(.6)}100%{opacity:1;transform:translate(-6.7rem,0) rotate(-360deg)}}}@media(prefers-reduced-motion:reduce){.pt-card-selected,.pt-result-impact,.pt-hand-winner,.pt-hand-loser,.pt-hand-tie,.pt-score-reward,.pt-score-reward:after,.pt-reward-chip,.pt-reward-badge,.pt-outcome-player,.pt-outcome-house,.pt-outcome-tie{animation:none!important}.pt-card-selected{transform:translateY(-16px)!important}.pt-result-impact{opacity:1}.pt-hand-winner{filter:brightness(1.15) drop-shadow(0 0 10px #fbbf2455);transform:scale(1.02)}.pt-hand-loser{opacity:.42;filter:saturate(.3) brightness(.7)}.pt-reward-chip{opacity:1}.pt-reward-player .pt-reward-chip{transform:translateX(5rem)}.pt-reward-house .pt-reward-chip{transform:translateX(-6.5rem)}.pt-reward-tie .pt-reward-chip-left{transform:translateX(-5rem)}.pt-reward-tie .pt-reward-chip-right{transform:translateX(3.5rem)}.pt-reward-badge{opacity:1;transform:translateX(-50%)}}"
    body:append_child(style)
end

function pick_count(picks: {i32}): i32
    if #picks > 2 and picks[2] >= 0 then return 3 end
    if picks[1] >= 0 then return 2 end
    if picks[0] >= 0 then return 1 end
    return 0
end

function toggle_play_pick(picks: {i32}, index: i32): unit
    if picks[0] == index then
        picks[0] = picks[1]
        picks[1] = -1
        return
    end
    if picks[1] == index then picks[1] = -1 return end
    if picks[0] < 0 then picks[0] = index return end
    if picks[1] < 0 then picks[1] = index end
end

function toggle_swap_pick(picks: {i32}, index: i32): unit
    if picks[0] == index then
        picks[0] = picks[1]
        picks[1] = picks[2]
        picks[2] = -1
        return
    end
    if picks[1] == index then
        picks[1] = picks[2]
        picks[2] = -1
        return
    end
    if picks[2] == index then picks[2] = -1 return end
    if picks[0] < 0 then picks[0] = index return end
    if picks[1] < 0 then picks[1] = index return end
    if picks[2] < 0 then picks[2] = index end
end

function swap_history_text(trick: game.Trick): string
    if trick.player_wager == 0 and trick.computer_wager == 0 then return "both passed" end
    local wagers: string = " after wagers " .. tostring(trick.player_wager) .. "–" .. tostring(trick.computer_wager) .. "; pot " .. tostring(trick.pot)
    if trick.swap_winner > 0 then return "you swapped " .. tostring(trick.swap_count) .. wagers end
    if trick.swap_winner < 0 then return "computer swapped " .. tostring(trick.swap_count) .. wagers end
    return "equal proposals; no swap" .. wagers
end

function append_trick_reveal(document: Document, table_area: Element, trick: game.Trick): unit
    local outcome_name: string = "tie"
    if trick.winner > 0 then outcome_name = "player"
    elseif trick.winner < 0 then outcome_name = "house"
    end
    local reveal: Element = make_element(document, "section", "pt-reveal pt-outcome-" .. outcome_name .. " w-full max-w-3xl overflow-hidden rounded-3xl border border-amber-200/30 p-5 shadow-2xl shadow-black/60 backdrop-blur")
    reveal.id = "trick-reveal"
    reveal:set_attribute("aria-live", "polite")
    reveal:set_attribute("data-outcome", outcome_name)
    table_area:append_child(reveal)
    local reveal_eyebrow: Element = make_element(document, "p", "pt-reveal-eyebrow")
    reveal_eyebrow.text_content = "Showdown · Trick " .. tostring(trick.round)
    reveal:append_child(reveal_eyebrow)
    local reveal_title: Element = make_element(document, "h2", "pt-reveal-title pt-result-impact")
    reveal_title:set_attribute("data-result-impact", outcome_name)
    if trick.winner > 0 then
        reveal_title.text_content = "You take the trick"
    elseif trick.winner < 0 then
        reveal_title.text_content = "The house takes it"
    else
        reveal_title.text_content = "A dead heat"
    end
    reveal:append_child(reveal_title)

    local showdown: Element = make_element(document, "div", "pt-showdown")
    reveal:append_child(showdown)

    local computer_result: string = "pt-hand-tie"
    if trick.winner > 0 then computer_result = "pt-hand-loser"
    elseif trick.winner < 0 then computer_result = "pt-hand-winner"
    end
    local computer_show: Element = make_element(document, "div", "pt-show-group " .. computer_result)
    if trick.winner == 0 then computer_show:set_attribute("data-hand-result", "tie")
    elseif trick.winner < 0 then computer_show:set_attribute("data-hand-result", "winner")
    else computer_show:set_attribute("data-hand-result", "loser")
    end
    local computer_show_label: Element = make_element(document, "p", "pt-show-label")
    computer_show_label.text_content = "House · " .. game.category_name(trick.computer_value)
    computer_show:append_child(computer_show_label)
    local computer_show_cards: Element = make_element(document, "div", "pt-show-row")
    append_showdown_cards(document, computer_show_cards, trick.computer_cards, 0)
    computer_show:append_child(computer_show_cards)
    showdown:append_child(computer_show)

    local board_show: Element = make_element(document, "div", "pt-show-group")
    board_show:set_attribute("data-hand-result", "shared")
    local board_show_label: Element = make_element(document, "p", "pt-show-label")
    board_show_label.text_content = "Board"
    board_show:append_child(board_show_label)
    local board_show_cards: Element = make_element(document, "div", "pt-show-row")
    append_showdown_cards(document, board_show_cards, trick.middle, 180)
    board_show:append_child(board_show_cards)
    showdown:append_child(board_show)

    local player_result: string = "pt-hand-tie"
    if trick.winner > 0 then player_result = "pt-hand-winner"
    elseif trick.winner < 0 then player_result = "pt-hand-loser"
    end
    local player_show: Element = make_element(document, "div", "pt-show-group " .. player_result)
    if trick.winner == 0 then player_show:set_attribute("data-hand-result", "tie")
    elseif trick.winner > 0 then player_show:set_attribute("data-hand-result", "winner")
    else player_show:set_attribute("data-hand-result", "loser")
    end
    local player_show_label: Element = make_element(document, "p", "pt-show-label")
    player_show_label.text_content = "You · " .. game.category_name(trick.player_value)
    player_show:append_child(player_show_label)
    local player_show_cards: Element = make_element(document, "div", "pt-show-row")
    append_showdown_cards(document, player_show_cards, trick.player_cards, 450)
    player_show:append_child(player_show_cards)
    showdown:append_child(player_show)

    local reward: Element = make_element(document, "div", "pt-reward-motion pt-reward-" .. outcome_name)
    reward:set_attribute("aria-hidden", "true")
    reward:set_attribute("data-reward-motion", outcome_name)
    if trick.winner == 0 then
        local left_refund: Element = make_element(document, "span", "pt-reward-chip pt-reward-chip-left")
        left_refund.text_content = "PT"
        reward:append_child(left_refund)
        local right_refund: Element = make_element(document, "span", "pt-reward-chip pt-reward-chip-right")
        right_refund.text_content = "PT"
        reward:append_child(right_refund)
    else
        local reward_chip: Element = make_element(document, "span", "pt-reward-chip")
        reward_chip.text_content = "PT"
        reward:append_child(reward_chip)
    end
    local reward_badge: Element = make_element(document, "span", "pt-reward-badge")
    if trick.winner > 0 then
        reward_badge.text_content = "+" .. tostring(trick.points) .. " to you"
    elseif trick.winner < 0 then
        reward_badge.text_content = "+" .. tostring(trick.points) .. " to house"
    else
        reward_badge.text_content = "Pot returned"
    end
    reward:append_child(reward_badge)
    reveal:append_child(reward)

    local reveal_points: Element = make_element(document, "p", "pt-reveal-points")
    reveal_points.text_content = "Pot " .. tostring(trick.pot) .. " · Trick value " .. tostring(trick.points) .. " point(s)"
    reveal:append_child(reveal_points)
end

function render_poker_tricks(state: game.State, play_selection: {i32}, swap_hand: {i32}, swap_middle: {i32}, reveal_trick: bool): unit
    local document: Document = window.document
    local body: HTMLElement = document.body
    install_poker_styles(document, body)
    local existing: Element? = document:get_element_by_id("app")
    if existing ~= nil then body:remove_child(existing) end

    local root: Element = make_element(document, "main", "min-h-screen overflow-hidden p-3 text-emerald-50 sm:p-6")
    root.id = "app"
    body:append_child(root)

    local table_area: Element = make_element(document, "section", "pt-table mx-auto flex max-w-5xl flex-col items-center gap-4 rounded-[2rem] border-[10px] border-amber-950/80 px-4 py-6 sm:gap-5 sm:px-8 sm:py-8")
    table_area.id = "poker-table"
    root:append_child(table_area)

    local eyebrow: Element = make_element(document, "p", "pt-eyebrow")
    eyebrow.text_content = "The house presents"
    table_area:append_child(eyebrow)
    local heading: Element = make_element(document, "h1", "pt-title")
    heading.text_content = "Poker Tricks"
    table_area:append_child(heading)

    local rules: Element = make_element(document, "p", "pt-rules")
    rules.text_content = "Exchange up to three hand cards with the same number of community cards, wagering one point per card, or pass. Then choose two cards for the five-card poker trick."
    table_area:append_child(rules)

    local score: Element = make_element(document, "p", "pt-score")
    score.id = "poker-score"
    table_area:append_child(score)

    local computer_label: Element = make_element(document, "h2", "pt-section-label")
    computer_label.text_content = "◆  The House"
    table_area:append_child(computer_label)
    local computer_row: Element = make_element(document, "div", "pt-opponent-row")
    computer_row.id = "computer-hand"
    table_area:append_child(computer_row)
    local computer_cards: {Element} = {}
    for i = 0, 4 do
        local back: Element = make_element(document, "span", "pt-card pt-card-back pt-card-static")
        back:set_attribute("data-card-index", tostring(i))
        computer_row:append_child(back)
        table.insert(computer_cards, back)
    end

    local community_stage: Element = make_element(document, "section", "pt-community")
    community_stage.id = "community-stage"
    table_area:append_child(community_stage)
    local middle_label: Element = make_element(document, "h2", "pt-community-label")
    middle_label.text_content = "The Community"
    community_stage:append_child(middle_label)
    local middle_row: Element = make_element(document, "div", "pt-card-row")
    middle_row.id = "middle-cards"
    community_stage:append_child(middle_row)
    local middle_cards: {Element} = {}
    local visible_middle: {game.Card} = state.middle
    if state.finished and #state.history > 0 then visible_middle = state.history[#state.history - 1].middle end
    for i = 0, 2 do
        local card: Element = make_element(document, "button", "pt-card pt-card-button")
        card.id = "middle-card-" .. tostring(i)
        card:set_attribute("type", "button")
        card:set_attribute("aria-label", "Select community card " .. tostring(i + 1) .. ": " .. game.card_name(visible_middle[i]))
        card:set_attribute("data-card-index", tostring(i))
        append_card_face(document, card, visible_middle[i])
        middle_row:append_child(card)
        table.insert(middle_cards, card)
    end

    local player_label: Element = make_element(document, "h2", "pt-section-label")
    if state.swap_open then
        player_label.text_content = "Your hand — select up to three to swap"
    else
        player_label.text_content = "Your hand — pick two for the trick"
    end
    table_area:append_child(player_label)
    local player_row: Element = make_element(document, "div", "pt-card-row")
    player_row.id = "player-hand"
    table_area:append_child(player_row)
    local player_cards: {Element} = {}

    local status: Element = make_element(document, "p", "pt-status")
    status.id = "poker-status"
    table_area:append_child(status)

    if reveal_trick and #state.history > 0 then append_trick_reveal(document, table_area, state.history[#state.history - 1]) end

    local controls: Element = make_element(document, "div", "pt-controls")
    table_area:append_child(controls)
    if state.swap_open then
        local submit_swap: Element = make_element(document, "button", "pt-button pt-button-primary")
        submit_swap.id = "submit-swap"
        submit_swap:set_attribute("type", "button")
        local selected_count: i32 = pick_count(swap_hand)
        submit_swap.text_content = "Attempt swap · Wager " .. tostring(selected_count)
        controls:append_child(submit_swap)
        local pass_swap: Element = make_element(document, "button", "pt-button pt-button-secondary")
        pass_swap.id = "pass-swap"
        pass_swap:set_attribute("type", "button")
        pass_swap.text_content = "Pass"
        controls:append_child(pass_swap)
    else
        local play_button: Element = make_element(document, "button", "pt-button pt-button-primary")
        play_button.id = "play-trick"
        play_button:set_attribute("type", "button")
        play_button.text_content = "Play selected cards"
        controls:append_child(play_button)
    end
    local restart_button: Element = make_element(document, "button", "pt-button pt-button-secondary")
    restart_button.id = "new-game"
    restart_button:set_attribute("type", "button")
    restart_button.text_content = "New game"
    controls:append_child(restart_button)

    local history_section: Element = make_element(document, "section", "pt-history")
    history_section.id = "trick-history"
    table_area:append_child(history_section)
    local history_heading: Element = make_element(document, "h2", "pt-history-title")
    history_heading.text_content = "Tricks so far"
    history_section:append_child(history_heading)
    local history_list: Element = make_element(document, "div", "flex flex-col gap-2")
    history_section:append_child(history_list)
    if #state.history == 0 then
        local empty_history: Element = make_element(document, "p", "text-center text-sm text-emerald-300")
        empty_history.id = "trick-history-empty"
        empty_history.text_content = "No tricks played yet."
        history_list:append_child(empty_history)
    else
        for trick in state.history do
            local outcome: string = "Tie · no points"
            if trick.winner > 0 then
                outcome = "You won " .. tostring(trick.points) .. " point(s)"
            elseif trick.winner < 0 then
                outcome = "Computer won " .. tostring(trick.points) .. " point(s)"
            end
            local swap_outcome: string = swap_history_text(trick)
            local board: string = game.card_name(trick.middle[0]) .. " " .. game.card_name(trick.middle[1]) .. " " .. game.card_name(trick.middle[2])
            local player_pair: string = game.card_name(trick.player_cards[0]) .. " " .. game.card_name(trick.player_cards[1])
            local computer_pair: string = game.card_name(trick.computer_cards[0]) .. " " .. game.card_name(trick.computer_cards[1])
            local entry: Element = make_element(document, "article", "trick-history-entry rounded-xl border border-emerald-100/10 bg-emerald-950/40 p-3 text-xs leading-relaxed text-emerald-50/80 sm:text-sm")
            entry:set_attribute("data-round", tostring(trick.round))
            entry.text_content = "Trick " .. tostring(trick.round) .. " · Swap: " .. swap_outcome .. " · " .. outcome .. " · Board: " .. board .. " · You: " .. player_pair .. " (" .. game.category_name(trick.player_value) .. ") · Computer: " .. computer_pair .. " (" .. game.category_name(trick.computer_value) .. ")"
            history_list:append_child(entry)
        end
    end

    local function update(state: game.State): unit
        local shown_round: i32 = state.round
        score.text_content = "Round " .. tostring(shown_round) .. " · You " .. tostring(state.player_points) .. " (" .. tostring(state.player_tricks) .. " tricks) · Computer " .. tostring(state.computer_points) .. " (" .. tostring(state.computer_tricks) .. " tricks) · Deck " .. tostring(#state.deck)
        if reveal_trick and #state.history > 0 then
            local latest: game.Trick = state.history[#state.history - 1]
            score.class_name = "pt-score pt-score-reward pt-score-tie"
            score:set_attribute("data-score-outcome", "tie")
            score:set_attribute("data-reward", "Pot returned")
            if latest.winner > 0 then
                score.class_name = "pt-score pt-score-reward pt-score-player-win"
                score:set_attribute("data-score-outcome", "player")
                score:set_attribute("data-reward", "+" .. tostring(latest.points) .. " you")
            elseif latest.winner < 0 then
                score.class_name = "pt-score pt-score-reward pt-score-house-win"
                score:set_attribute("data-score-outcome", "house")
                score:set_attribute("data-reward", "+" .. tostring(latest.points) .. " house")
            end
        end

        for i, element in player_cards do
            if (state.swap_open and (swap_hand[0] == i or swap_hand[1] == i or swap_hand[2] == i)) or ((not state.swap_open) and (play_selection[0] == i or play_selection[1] == i)) then
                element.class_name = "pt-card pt-card-button pt-card-selected border-4 border-amber-300"
                element:set_attribute("aria-pressed", "true")
                element:set_attribute("data-selection-state", "selected")
            else
                element.class_name = "pt-card pt-card-button border-2 border-white"
                element:set_attribute("aria-pressed", "false")
                element:set_attribute("data-selection-state", "idle")
            end
        end

        if state.finished then
            for element in middle_cards do element.class_name = "pt-card opacity-50 grayscale" end
            if state.player_points > state.computer_points then
                status.text_content = "Deck empty — you win " .. tostring(state.player_points) .. " to " .. tostring(state.computer_points) .. "!"
            elseif state.computer_points > state.player_points then
                status.text_content = "Deck empty — computer wins " .. tostring(state.computer_points) .. " to " .. tostring(state.player_points) .. "."
            else
                status.text_content = "Deck empty — the game is a draw."
            end
        else
            for i, element in middle_cards do
                if state.swap_open and (swap_middle[0] == i or swap_middle[1] == i or swap_middle[2] == i) then
                    element.class_name = "pt-card pt-card-button pt-card-selected border-4 border-amber-200"
                    element:set_attribute("aria-pressed", "true")
                    element:set_attribute("data-selection-state", "selected")
                else
                    element.class_name = "pt-card pt-card-button border-2 border-white"
                    element:set_attribute("aria-pressed", "false")
                    element:set_attribute("data-selection-state", "idle")
                end
            end
            if state.swap_open then
                status.text_content = "Swap phase: select the same number of hand and community cards (1-3). Your wager equals the number selected, or you can pass."
            elseif state.player_wager == 0 and state.computer_wager == 0 then
                status.text_content = "Both players passed. Choose two cards; this trick is worth " .. tostring(state.round) .. " point(s)."
            elseif state.swap_winner > 0 then
                status.text_content = "You won swap priority and exchanged " .. tostring(state.swap_count) .. " card(s). Pot " .. tostring(state.pot) .. ". Now choose two cards."
            elseif state.swap_winner < 0 then
                status.text_content = "Computer won swap priority and exchanged " .. tostring(state.swap_count) .. " card(s). Pot " .. tostring(state.pot) .. ". Now choose two cards."
            else
                status.text_content = "Swap proposals tied, so no swap happened. Pot " .. tostring(state.pot) .. ". Now choose two cards."
            end
        end
    end

    -- One delegated listener owns the authoritative game state. Registering
    -- separate callback captures for each button would give each capture its
    -- own record value; click bubbling lets every control share this one.
    local function handle_interaction(event: Event): unit
        if Element(target) = event.target then
            if target.id == "new-game" then
                state:reset()
                render_poker_tricks(state, { -1, -1 }, { -1, -1, -1 }, { -1, -1, -1 }, false)
            elseif target.id == "pass-swap" and state.swap_open then
                state:resolve_swap({}, {})
                render_poker_tricks(state, { -1, -1 }, { -1, -1, -1 }, { -1, -1, -1 }, false)
            elseif target.id == "submit-swap" and state.swap_open then
                local hand_count: i32 = pick_count(swap_hand)
                local middle_count: i32 = pick_count(swap_middle)
                if hand_count < 1 or hand_count ~= middle_count then
                    status.text_content = "Select the same number of hand and community cards (1-3)."
                elseif hand_count > state.player_points then
                    status.text_content = "You need one point per selected card. Select fewer cards or pass."
                else
                    local hand_indices: {i32} = {}
                    local middle_indices: {i32} = {}
                    for index in swap_hand do if index >= 0 then table.insert(hand_indices, index) end end
                    for index in swap_middle do if index >= 0 then table.insert(middle_indices, index) end end
                    state:resolve_swap(hand_indices, middle_indices)
                    render_poker_tricks(state, { -1, -1 }, { -1, -1, -1 }, { -1, -1, -1 }, false)
                end
            elseif target.id == "play-trick" and not state.finished and not state.swap_open then
                if play_selection[0] >= 0 and play_selection[1] >= 0 then
                    state:play(play_selection[0], play_selection[1])
                    render_poker_tricks(state, { -1, -1 }, { -1, -1, -1 }, { -1, -1, -1 }, true)
                else
                    status.text_content = "Select exactly two cards first."
                end
            elseif not state.finished and state.swap_open then
                local hand_index: i32 = -1
                local middle_index: i32 = -1
                if target.id == "player-card-0" then hand_index = 0
                elseif target.id == "player-card-1" then hand_index = 1
                elseif target.id == "player-card-2" then hand_index = 2
                elseif target.id == "player-card-3" then hand_index = 3
                elseif target.id == "player-card-4" then hand_index = 4
                elseif target.id == "middle-card-0" then middle_index = 0
                elseif target.id == "middle-card-1" then middle_index = 1
                elseif target.id == "middle-card-2" then middle_index = 2
                end
                if hand_index >= 0 then toggle_swap_pick(swap_hand, hand_index) end
                if middle_index >= 0 then toggle_swap_pick(swap_middle, middle_index) end
                if hand_index >= 0 or middle_index >= 0 then
                    render_poker_tricks(state, play_selection, swap_hand, swap_middle, false)
                end
            elseif not state.finished then
                local index: i32 = -1
                if target.id == "player-card-0" then index = 0
                elseif target.id == "player-card-1" then index = 1
                elseif target.id == "player-card-2" then index = 2
                elseif target.id == "player-card-3" then index = 3
                elseif target.id == "player-card-4" then index = 4
                end
                if index >= 0 then
                    toggle_play_pick(play_selection, index)
                    render_poker_tricks(state, play_selection, swap_hand, swap_middle, false)
                end
            end
        end
    end

    local function add_player_card(index: i32): unit
        local card_button: Element = make_element(document, "button", "")
        card_button.id = "player-card-" .. tostring(index)
        card_button:set_attribute("type", "button")
        card_button:set_attribute("aria-label", "Select card " .. tostring(index + 1) .. ": " .. game.card_name(state.player_hand[index]))
        append_card_face(document, card_button, state.player_hand[index])
        player_row:append_child(card_button)
        table.insert(player_cards, card_button)
    end
    add_player_card(0)
    add_player_card(1)
    add_player_card(2)
    add_player_card(3)
    add_player_card(4)

    table_area:add_event_listener("click", handle_interaction)
    update(state)
end

window:requestAnimationFrame(function(timestamp: f64): unit
    math.randomseed(timestamp)
    render_poker_tricks(game.new(), { -1, -1 }, { -1, -1, -1 }, { -1, -1, -1 }, false)
end)
