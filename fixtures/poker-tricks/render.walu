-- Engine-rendered presentation for Arcane Heist. Everything visible to the
-- player lives on this one logical canvas, including secondary modal screens.

local engine = require("waluau:engine")
local graphics_module = require("waluau:engine/graphics")
local game = require("./game")

type Graphics = engine.Graphics
type EffectShaders = {
    gold_shimmer: graphics_module.Shader?,
    red_fire: graphics_module.Shader?,
    blue_caustics: graphics_module.Shader?,
    black_hole: graphics_module.Shader?,
    green_growth: graphics_module.Shader?
}

const WIDTH: f64 = 960.0
const HEIGHT: f64 = 600.0
const CARD_W: f64 = 104.0
const CARD_H: f64 = 128.0
const MODAL_HISTORY: i32 = 1
const MODAL_HELP: i32 = 2
const MODAL_FINAL: i32 = 4
const FLIP_SECONDS: f64 = 0.55
const TOTAL_ROUNDS: i32 = 5
const SELECTION_HIGHLIGHT: string = "#fbbf24"

-- Arcane Heist owns its visual effects. The engine supplies the shared 2D
-- vertex contract and standard u_time/u_pixel_scale/u_texture uniforms, while
-- this game supplies both GLSL stages and its school-specific parameters.

local EFFECT_VERTEX_SOURCE <const>: string = [[
attribute vec2 a_position;
attribute vec4 a_color;
attribute vec2 a_uv;
attribute float a_textured;
varying vec4 v_color;
varying vec2 v_uv;
varying float v_textured;
void main() {
    gl_Position = vec4(a_position, 0.0, 1.0);
    v_color = a_color;
    v_uv = a_uv;
    v_textured = a_textured;
}
]]

-- The winning formation sits over one continuous field of golden light.
-- Narrow luminous filaments, hard-edged specular sweeps and sparse star
-- glints keep the halo crisp without turning its underlay into a solid plate.
local GOLD_SHIMMER_PIXEL_SOURCE <const>: string = [[
precision mediump float;
varying vec4 v_color;
varying vec2 v_uv;
varying float v_textured;
uniform float u_time;
uniform sampler2D u_texture;
uniform float u_aspect;
uniform float u_strength;

float line_band(float phase, float inner, float outer) {
    float distance_to_line = abs(fract(phase) - 0.5);
    return 1.0 - smoothstep(inner, outer, distance_to_line);
}

float hash21(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void main() {
    vec2 p = vec2(v_uv.x * u_aspect, v_uv.y);
    vec2 centred = (v_uv - 0.5) * 2.0;
    centred.x *= u_aspect;
    float radius = length(centred);
    float angle = atan(centred.y, centred.x);

    // Fine opposing filaments move at different speeds. Their narrow,
    // well-defined intersections give the light a lively woven shimmer.
    float etch_a = line_band(p.x * 1.65 + p.y * 2.4 - u_time * 0.34, 0.014, 0.035);
    float etch_b = line_band(p.x * 1.05 - p.y * 3.1 + u_time * 0.23, 0.009, 0.026);
    float filaments = max(etch_a * 0.72, etch_b * 0.48);
    float crossing = etch_a * etch_b;

    // A travelling reflection has a bright knife-edge followed by a broader
    // gold face, like one beam sweeping across the completed formation.
    float sweep_phase = fract(v_uv.x * 0.88 + v_uv.y * 0.28 - u_time * 0.105);
    float sweep_distance = abs(sweep_phase - 0.5);
    float sweep_face = 1.0 - smoothstep(0.055, 0.105, sweep_distance);
    float sweep_edge = 1.0 - smoothstep(0.006, 0.019, sweep_distance);

    // Sparse four-point glints belong to the same coordinate field, so they
    // travel cleanly through the gaps instead of restarting on every card.
    vec2 glint_grid = vec2(p.x * 1.15 - u_time * 0.12, p.y * 4.0);
    vec2 glint_cell = fract(glint_grid) - 0.5;
    vec2 glint_id = floor(glint_grid);
    float glint_gate = step(0.76, hash21(glint_id));
    float glint_core = 1.0 - smoothstep(0.015, 0.050, length(glint_cell));
    float glint_h = (1.0 - smoothstep(0.018, 0.050, abs(glint_cell.y)))
        * (1.0 - smoothstep(0.05, 0.25, abs(glint_cell.x)));
    float glint_v = (1.0 - smoothstep(0.018, 0.050, abs(glint_cell.x)))
        * (1.0 - smoothstep(0.05, 0.22, abs(glint_cell.y)));
    float glint = glint_gate * max(glint_core, max(glint_h, glint_v));

    // The completed hand throws a crisp sunburst beyond its silhouette.
    // Alternating spoke widths keep the rays irregular and celebratory, while
    // two travelling rings make the whole formation pulse outward.
    float spoke_phase = angle * 15.0
        + sin(angle * 5.0 - u_time * 0.42) * 0.58
        + u_time * 0.18;
    float narrow_spokes = 1.0 - smoothstep(0.935, 0.985, abs(sin(spoke_phase)));
    float fine_spokes = 1.0 - smoothstep(
        0.965,
        0.994,
        abs(sin(spoke_phase * 1.73 + 1.4))
    );
    float radial_fade = 1.0 - smoothstep(1.45, u_aspect, radius);
    float burst = max(narrow_spokes * 0.72, fine_spokes * 0.50) * radial_fade;

    float ring_radius_a = 0.72 + fract(u_time * 0.19) * 1.55;
    float ring_radius_b = 0.72 + fract(u_time * 0.19 + 0.50) * 1.55;
    float ring_a = (1.0 - smoothstep(0.020, 0.058, abs(radius - ring_radius_a)))
        * (1.0 - fract(u_time * 0.19));
    float ring_b = (1.0 - smoothstep(0.020, 0.058, abs(radius - ring_radius_b)))
        * (1.0 - fract(u_time * 0.19 + 0.50));
    float rings = max(ring_a, ring_b);

    // The drawing primitive is rectangular, but the light is a long capsule
    // around the hand. Rounded ends and a generous vertical falloff erase the
    // quad's footprint while keeping one coordinate field through every gap.
    float capsule_x = max(abs(centred.x) - (u_aspect - 0.78), 0.0);
    float capsule_distance = length(vec2(capsule_x, centred.y));
    float envelope = 1.0 - smoothstep(0.43, 1.0, capsule_distance);

    vec3 warm_gold = vec3(1.0, 0.60, 0.055);
    vec3 bright_gold = vec3(1.0, 0.82, 0.25);
    vec3 pale_gold = vec3(1.0, 0.97, 0.72);
    float brilliance = clamp(
        filaments * 0.45 + sweep_face * 0.30 + sweep_edge * 0.72
            + crossing * 0.38 + glint + burst * 0.38 + rings * 0.70,
        0.0,
        1.0
    );
    vec3 color = mix(warm_gold, bright_gold, 0.32 + brilliance * 0.48);
    color = mix(color, pale_gold, sweep_edge * 0.56 + glint * 0.82);

    // Only the moving light has substantial opacity. The faint base ties the
    // gaps together without laying an amber slab beneath the cards.
    float light = 0.012 + filaments * 0.28 + sweep_face * 0.15
        + sweep_edge * 0.52 + crossing * 0.22 + glint * 0.78
        + burst * 0.42 + rings * 0.68;
    float alpha = v_color.a * u_strength * envelope * min(light, 0.95);
    vec4 output_color = vec4(color, alpha);
    if (v_textured > 0.5) output_color *= texture2D(u_texture, v_uv);
    gl_FragColor = output_color;
}
]]

-- Red burns upward from the bottom centre in card-local space. Every visible
-- value is the exact school red multiplied by one brightness scalar: the
-- tongues, embers and flicker introduce no yellow or orange tint.
local RED_FIRE_PIXEL_SOURCE <const>: string = [[
precision mediump float;
varying vec4 v_color;
varying vec2 v_uv;
varying float v_textured;
uniform float u_time;
uniform sampler2D u_texture;
uniform float u_aspect;
uniform float u_selected;
uniform float u_colored;

float tongue(vec2 p, float center, float width, float height, float phase, float speed) {
    float rise = clamp(p.y / height, 0.0, 1.0);
    float sway = sin(p.y * 9.0 + phase - u_time * speed) * width * (0.10 + rise * 0.24);
    sway += sin(p.y * 21.0 - phase * 1.7 + u_time * speed * 1.6) * width * rise * 0.07;
    float taper = width * (1.0 - pow(rise, 0.72));
    float side = 1.0 - smoothstep(taper * 0.54, taper, abs(p.x - center - sway));
    float dancing_tip = height + sin(u_time * speed * 1.35 + phase) * 0.055
        + sin(u_time * speed * 2.7 - phase) * 0.022;
    float cap = 1.0 - smoothstep(dancing_tip - 0.11, dancing_tip, p.y);
    return side * cap * smoothstep(0.0, 0.045, p.y);
}

void main() {
    // UV y runs top-to-bottom, so this makes y=0 the flame's bottom edge.
    vec2 p = vec2((v_uv.x - 0.5) * 2.0 * u_aspect, 1.0 - v_uv.y);

    float core = tongue(p, 0.0, 0.42, 0.96, 0.4, 3.0);
    float left = tongue(p, -0.28, 0.30, 0.69, 2.2, 3.7);
    float right = tongue(p, 0.30, 0.27, 0.76, 4.5, 3.3);
    float inner = tongue(p, 0.04, 0.20, 0.57, 5.7, 4.4);
    float flame = max(core, max(left, right));

    // Rising bands make brightness race up through the silhouette while a
    // tighter inner tongue flashes independently near the origin.
    float flow = 0.5 + 0.5 * sin(
        p.y * 25.0 - u_time * 8.5
        + sin(p.x * 8.0 + u_time * 2.1) * 1.25
    );
    flow *= flow;
    float base_glow = exp(-p.x * p.x * 4.6) * exp(-p.y * 4.0);
    float flicker = 0.90
        + 0.07 * sin(u_time * 13.0)
        + 0.03 * sin(u_time * 23.0 + 1.7);
    float brightness = 0.075 + base_glow * 0.24;
    brightness += flame * (0.22 + flow * 0.43) * flicker;
    brightness += inner * (0.14 + 0.10 * sin(u_time * 17.0 + p.y * 12.0));
    brightness += u_selected * 0.10 * flame;

    vec3 school_red = vec3(0.937255, 0.266667, 0.266667);
    vec3 tint = mix(vec3(0.82), school_red, u_colored);
    vec4 output_color = vec4(tint * brightness, v_color.a);
    if (v_textured > 0.5) output_color *= texture2D(u_texture, v_uv);
    gl_FragColor = output_color;
}
]]

-- Blue is light refracting through deep water: several independently warped
-- ridges cross into a drifting caustic mesh, while sparse rings expand softly
-- through it. The whole field remains one blue hue at different brightnesses.
local BLUE_CAUSTICS_PIXEL_SOURCE <const>: string = [[
precision mediump float;
varying vec4 v_color;
varying vec2 v_uv;
varying float v_textured;
uniform float u_time;
uniform sampler2D u_texture;
uniform float u_aspect;
uniform float u_selected;
uniform float u_colored;

float caustic_ridge(float wave) {
    float distance_to_light = 1.0 - abs(sin(wave));
    return distance_to_light * distance_to_light * distance_to_light
        * distance_to_light * distance_to_light;
}

float expanding_ripple(vec2 p, vec2 origin, float phase) {
    float cycle = fract(u_time * 0.115 + phase);
    float radius = cycle * 1.22;
    float ring_distance = abs(length(p - origin) - radius);
    float ring = 1.0 - smoothstep(0.020, 0.070, ring_distance);
    return ring * sin(cycle * 3.141593) * (1.0 - cycle);
}

void main() {
    vec2 p = vec2((v_uv.x - 0.5) * 2.0 * u_aspect, (v_uv.y - 0.5) * 2.0);

    // Two slow refraction currents distort the coordinate field before any
    // light ridges are measured, producing curved cells instead of stripes.
    vec2 q = p;
    q.x += sin(p.y * 3.1 + u_time * 0.47) * 0.105;
    q.x += sin(p.y * 6.7 - u_time * 0.31) * 0.040;
    q.y += sin(p.x * 2.8 - u_time * 0.39) * 0.090;
    q.y += sin(p.x * 5.9 + u_time * 0.28) * 0.035;

    float ridge1 = caustic_ridge(q.x * 7.2 + q.y * 2.8 + u_time * 0.82
        + sin(q.y * 5.0 - u_time * 0.43) * 1.15);
    float ridge2 = caustic_ridge(-q.x * 4.9 + q.y * 8.1 - u_time * 0.66
        + sin(q.x * 5.7 + u_time * 0.37) * 1.05);
    float ridge3 = caustic_ridge(q.x * 5.4 + q.y * 6.3 + u_time * 0.51
        + sin((q.x - q.y) * 4.2 - u_time * 0.29) * 0.82);
    float network = max(ridge1, max(ridge2, ridge3));
    float intersections = max(ridge1 * ridge2, max(ridge2 * ridge3, ridge1 * ridge3));

    float ripple1 = expanding_ripple(p, vec2(-0.38, 0.18), 0.08);
    float ripple2 = expanding_ripple(p, vec2(0.46, -0.32), 0.59);
    float depth = 0.5 + 0.5 * sin(p.y * 2.2 + u_time * 0.24);
    float shimmer = 0.90 + 0.10 * sin(u_time * 2.0 + p.x * 3.4 - p.y * 2.1);
    float brightness = 0.065 + depth * 0.035;
    brightness += network * 0.34 * shimmer;
    brightness += intersections * 0.22;
    brightness += (ripple1 + ripple2) * 0.15;
    brightness += u_selected * 0.08 * network;
    brightness = clamp(brightness, 0.055, 0.82);

    vec3 school_blue = vec3(0.219608, 0.741176, 0.972549);
    vec3 tint = mix(vec3(0.82), school_blue, u_colored);
    vec4 output_color = vec4(tint * brightness, v_color.a);
    if (v_textured > 0.5) output_color *= texture2D(u_texture, v_uv);
    gl_FragColor = output_color;
}
]]

-- Green grows a small living canopy from the bottom centre. Branches and
-- pointed leaves share one school-green brightness field, while wind, leaf
-- breathing and rising sap pulses keep the plant in constant gentle motion.
local GREEN_GROWTH_PIXEL_SOURCE <const>: string = [[
precision mediump float;
varying vec4 v_color;
varying vec2 v_uv;
varying float v_textured;
uniform float u_time;
uniform sampler2D u_texture;
uniform float u_aspect;
uniform float u_selected;
uniform float u_colored;

float branch(vec2 p, vec2 a, vec2 b, float width) {
    vec2 stem = b - a;
    float along = clamp(dot(p - a, stem) / dot(stem, stem), 0.0, 1.0);
    float distance_to_stem = length(p - (a + stem * along));
    float taper = width * (1.0 - along * 0.48);
    return 1.0 - smoothstep(taper, taper + 0.014, distance_to_stem);
}

vec2 leaf_fields(vec2 p, vec2 center, vec2 direction, float length, float width, float phase) {
    vec2 axis = normalize(direction);
    vec2 side = vec2(-axis.y, axis.x);
    float breathing = 0.86 + 0.14 * (0.5 + 0.5 * sin(u_time * 1.15 + phase));
    float longitudinal = dot(p - center, axis) / (length * breathing);
    float lateral = dot(p - center, side);
    float profile = width * breathing * pow(max(0.0, 1.0 - longitudinal * longitudinal), 0.72);
    float body = (1.0 - smoothstep(profile, profile + 0.014, abs(lateral)))
        * (1.0 - smoothstep(0.91, 1.0, abs(longitudinal)));
    float midrib = body * (1.0 - smoothstep(0.008, 0.020, abs(lateral)));
    return vec2(body, midrib);
}

void main() {
    vec2 p = vec2((v_uv.x - 0.5) * 2.0 * u_aspect, 1.0 - v_uv.y);

    // A shared wind displacement preserves every attachment while the crown
    // sways farther than the rooted base.
    float wind = (
        sin(u_time * 0.85 + p.y * 4.2) * 0.030
        + sin(u_time * 1.43 - p.y * 7.0) * 0.012
    ) * p.y * p.y;
    p.x -= wind;

    float trunk_curve = sin(p.y * 4.6 + u_time * 0.34) * 0.035 * p.y;
    float trunk_width = mix(0.058, 0.020, clamp(p.y, 0.0, 1.0));
    float trunk = (1.0 - smoothstep(trunk_width, trunk_width + 0.015, abs(p.x - trunk_curve)))
        * (1.0 - smoothstep(0.91, 0.98, p.y));

    float stems = trunk;
    stems = max(stems, branch(p, vec2(0.00, 0.25), vec2(-0.34, 0.48), 0.043));
    stems = max(stems, branch(p, vec2(0.01, 0.39), vec2(0.39, 0.65), 0.040));
    stems = max(stems, branch(p, vec2(-0.01, 0.53), vec2(-0.32, 0.75), 0.034));
    stems = max(stems, branch(p, vec2(0.00, 0.66), vec2(0.25, 0.88), 0.030));
    stems = max(stems, branch(p, vec2(-0.17, 0.62), vec2(-0.48, 0.66), 0.022));
    stems = max(stems, branch(p, vec2(0.20, 0.52), vec2(0.48, 0.48), 0.022));

    vec2 leaf1 = leaf_fields(p, vec2(-0.42, 0.52), vec2(-0.82, 0.58), 0.17, 0.080, 0.2);
    vec2 leaf2 = leaf_fields(p, vec2(0.47, 0.69), vec2(0.78, 0.63), 0.18, 0.085, 1.3);
    vec2 leaf3 = leaf_fields(p, vec2(-0.38, 0.79), vec2(-0.76, 0.65), 0.17, 0.082, 2.5);
    vec2 leaf4 = leaf_fields(p, vec2(0.29, 0.91), vec2(0.58, 0.82), 0.16, 0.075, 3.7);
    vec2 leaf5 = leaf_fields(p, vec2(-0.54, 0.66), vec2(-0.98, 0.18), 0.14, 0.067, 4.6);
    vec2 leaf6 = leaf_fields(p, vec2(0.54, 0.48), vec2(0.98, -0.08), 0.14, 0.067, 5.4);
    vec2 leaf7 = leaf_fields(p, vec2(-0.14, 0.37), vec2(-0.72, 0.69), 0.13, 0.061, 6.2);
    vec2 leaf8 = leaf_fields(p, vec2(0.16, 0.56), vec2(0.70, 0.71), 0.13, 0.061, 0.9);

    float leaves = max(max(max(leaf1.x, leaf2.x), max(leaf3.x, leaf4.x)),
        max(max(leaf5.x, leaf6.x), max(leaf7.x, leaf8.x)));
    float veins = max(max(max(leaf1.y, leaf2.y), max(leaf3.y, leaf4.y)),
        max(max(leaf5.y, leaf6.y), max(leaf7.y, leaf8.y)));

    // Brightness climbs from roots to tips like sap moving through the plant.
    float sap = 0.5 + 0.5 * sin(p.y * 20.0 - u_time * 3.4);
    sap *= sap;
    float root_glow = exp(-p.x * p.x * 6.0) * exp(-p.y * 5.0);
    float leaf_breath = 0.90 + 0.10 * sin(u_time * 1.3 + p.x * 5.0 + p.y * 3.0);
    float brightness = 0.065 + root_glow * 0.20;
    brightness += stems * (0.22 + sap * 0.30);
    brightness += leaves * (0.26 + sap * 0.17) * leaf_breath;
    brightness += veins * 0.22;
    brightness += u_selected * 0.09 * max(stems, leaves);

    vec3 school_green = vec3(0.290196, 0.870588, 0.501961);
    vec3 tint = mix(vec3(0.82), school_green, u_colored);
    vec4 output_color = vec4(tint * brightness, v_color.a);
    if (v_textured > 0.5) output_color *= texture2D(u_texture, v_uv);
    gl_FragColor = output_color;
}
]]

-- Black gets a purpose-built local-space effect instead of another branch in
-- the shared screen-space shader. Filled rectangles provide normalized UVs,
-- so the singularity stays centred on a tilted card as its CPU transform
-- changes the geometry around it.
local BLACK_HOLE_PIXEL_SOURCE <const>: string = [[
precision mediump float;
varying vec4 v_color;
varying vec2 v_uv;
varying float v_textured;
uniform float u_time;
uniform sampler2D u_texture;
uniform float u_aspect;
uniform float u_selected;
uniform float u_colored;
void main() {
    vec2 p = (v_uv - 0.5) * 2.0;
    p.x *= u_aspect;
    float radius = length(p);
    float angle = atan(p.y, p.x);
    float pulse = 0.92 + 0.08 * sin(u_time * 3.1);
    float spin = angle * 3.0 - radius * 11.0
        + 2.5 / (radius + 0.16) + u_time * 2.0;
    float arm_phase = spin + sin(angle * 2.0 + u_time) * 0.7;
    float filaments = 1.0 - smoothstep(0.045, 0.145, abs(sin(arm_phase)));
    float fine_filaments = 1.0 - smoothstep(
        0.030, 0.105,
        abs(sin(arm_phase * 1.7 + radius * 5.0 - u_time * 0.45))
    );
    float disk_mask = smoothstep(0.27, 0.34, radius)
        * (1.0 - smoothstep(0.82, 1.02, radius));
    filaments *= disk_mask;
    fine_filaments *= disk_mask * (1.0 - smoothstep(0.62, 0.92, radius));

    float lens_ring = 1.0 - smoothstep(0.012, 0.045, abs(radius - 0.335));
    float outer_ring = 1.0 - smoothstep(0.018, 0.060, abs(radius - 0.68));
    float wisp_phase = angle * 7.0 - radius * 18.0 + u_time * 1.7;
    float sharp_wisps = (1.0 - smoothstep(0.040, 0.125, abs(sin(wisp_phase))))
        * smoothstep(0.37, 0.46, radius)
        * (1.0 - smoothstep(0.68, 0.80, radius));
    float intensity = 0.88 * pulse + u_selected * 0.30;

    vec3 color = v_color.rgb * 0.07 + vec3(0.008, 0.0, 0.020);
    color += vec3(0.11, 0.008, 0.30) * disk_mask * 0.30;
    color += vec3(0.54, 0.08, 0.96) * filaments * intensity;
    color += vec3(0.34, 0.035, 0.72) * fine_filaments * intensity * 0.72;
    color += vec3(0.48, 0.08, 0.88) * sharp_wisps * 0.62;
    color += vec3(0.78, 0.34, 0.94) * lens_ring * (0.82 + u_selected * 0.24);
    color += vec3(0.34, 0.06, 0.72) * outer_ring * 0.42;

    // Narrow lensing lines frame a hard, truly black event horizon.
    float outside_void = smoothstep(0.22, 0.275, radius);
    color *= outside_void;
    color += vec3(0.008, 0.0, 0.018) * smoothstep(0.25, 0.18, radius);
    float grayscale = dot(color, vec3(0.299, 0.587, 0.114));
    color = mix(vec3(grayscale), color, u_colored);

    vec4 output_color = vec4(color, v_color.a);
    if (v_textured > 0.5) output_color *= texture2D(u_texture, v_uv);
    gl_FragColor = output_color;
}
]]

function create_gold_shimmer_shader(graphics: Graphics): graphics_module.ShaderResult
    return graphics:create_shader(EFFECT_VERTEX_SOURCE, GOLD_SHIMMER_PIXEL_SOURCE)
end

function create_red_fire_shader(graphics: Graphics): graphics_module.ShaderResult
    return graphics:create_shader(EFFECT_VERTEX_SOURCE, RED_FIRE_PIXEL_SOURCE)
end

function create_blue_caustics_shader(graphics: Graphics): graphics_module.ShaderResult
    return graphics:create_shader(EFFECT_VERTEX_SOURCE, BLUE_CAUSTICS_PIXEL_SOURCE)
end

function create_green_growth_shader(graphics: Graphics): graphics_module.ShaderResult
    return graphics:create_shader(EFFECT_VERTEX_SOURCE, GREEN_GROWTH_PIXEL_SOURCE)
end

function create_black_hole_shader(graphics: Graphics): graphics_module.ShaderResult
    return graphics:create_shader(EFFECT_VERTEX_SOURCE, BLACK_HOLE_PIXEL_SOURCE)
end

function use_gold_shimmer(graphics: Graphics, effects: EffectShaders, strength: f64, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.gold_shimmer
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local strength_ok: bool = graphics:set_uniform_float("u_strength", strength)
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    return strength_ok and aspect_ok
end

function use_red_fire(graphics: Graphics, effects: EffectShaders, selected: bool, colored: bool, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.red_fire
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local selected_value: f64 = 0.0
    if selected then selected_value = 1.0 end
    local colored_value: f64 = 0.0
    if colored then colored_value = 1.0 end
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    local selected_ok: bool = graphics:set_uniform_float("u_selected", selected_value)
    local colored_ok: bool = graphics:set_uniform_float("u_colored", colored_value)
    return aspect_ok and selected_ok and colored_ok
end

function use_blue_caustics(graphics: Graphics, effects: EffectShaders, selected: bool, colored: bool, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.blue_caustics
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local selected_value: f64 = 0.0
    if selected then selected_value = 1.0 end
    local colored_value: f64 = 0.0
    if colored then colored_value = 1.0 end
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    local selected_ok: bool = graphics:set_uniform_float("u_selected", selected_value)
    local colored_ok: bool = graphics:set_uniform_float("u_colored", colored_value)
    return aspect_ok and selected_ok and colored_ok
end

function use_green_growth(graphics: Graphics, effects: EffectShaders, selected: bool, colored: bool, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.green_growth
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local selected_value: f64 = 0.0
    if selected then selected_value = 1.0 end
    local colored_value: f64 = 0.0
    if colored then colored_value = 1.0 end
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    local selected_ok: bool = graphics:set_uniform_float("u_selected", selected_value)
    local colored_ok: bool = graphics:set_uniform_float("u_colored", colored_value)
    return aspect_ok and selected_ok and colored_ok
end

function use_black_hole(graphics: Graphics, effects: EffectShaders, selected: bool, colored: bool, aspect: f64): bool
    local maybe_shader: graphics_module.Shader? = effects.black_hole
    if maybe_shader == nil then return false end
    local shader: graphics_module.Shader = maybe_shader::graphics_module.Shader
    if not graphics:use_shader(shader) then return false end
    local selected_value: f64 = 0.0
    if selected then selected_value = 1.0 end
    local colored_value: f64 = 0.0
    if colored then colored_value = 1.0 end
    local aspect_ok: bool = graphics:set_uniform_float("u_aspect", aspect)
    local selected_ok: bool = graphics:set_uniform_float("u_selected", selected_value)
    local colored_ok: bool = graphics:set_uniform_float("u_colored", colored_value)
    return aspect_ok and selected_ok and colored_ok
end

function stop_effect(graphics: Graphics): unit
    graphics:use_default_shader()
end

-- Once both flips have landed, the winner's pair flies out of its row and
-- joins the three wards, so the whole five-card formation stands together in
-- the middle of the board. FLY_START leaves a beat after the second flip
-- (which finishes at 0.2 + FLIP_SECONDS * 1.7), and the second card trails
-- the first by FLY_STAGGER so the pair arrives as two beats rather than a
-- block slide.
const FLY_START: f64 = 1.3
const FLY_SECONDS: f64 = 0.45
const FLY_STAGGER: f64 = 0.12
-- Where the pair lands: one flank on each side of the wards, extending their
-- 116-pitch row to a five-card formation that stays centred on the board.
const ROW_LEFT_X: f64 = 186.0
const ROW_RIGHT_X: f64 = 650.0
const ROW_Y: f64 = 292.0
const ROW_CENTER_X: f64 = 470.0
const ROW_CENTER_Y: f64 = 356.0
const WIN_LIFT_SCALE: f64 = 1.14
const WIN_LIFT_Y: f64 = 10.0

-- Once the second card has landed, a single animated gold halo ignites
-- beneath the completed row and brightens over WIN_GLOW_FADE. It extends a
-- little beyond the cards, while its uninterrupted centre remains visible in
-- the four gaps. The cards themselves are drawn later over the light field.
const WIN_GLOW_FADE: f64 = 0.35
const SHIMMER_MARGIN: f64 = 64.0

-- The three outcomes a resolved breach can have. The help legend draws the
-- same orbs from these, so a colour only ever means one thing on screen.
const ORB_ROBBERS_EDGE: string = "#cffafe"
const ORB_ROBBERS_FILL: string = "#22d3ee"
const ORB_ARCH_MAGE_EDGE: string = "#fecaca"
const ORB_ARCH_MAGE_FILL: string = "#f87171"
const ORB_STALEMATE_EDGE: string = "#e4e4e7"
const ORB_STALEMATE_FILL: string = "#a1a1aa"

-- The watched-relic mark, in parchment ink rather than either side's colour:
-- the same eye means the same thing on both rows, and it must not be mistaken
-- for a SELECTION_HIGHLIGHT focus edge or a school-coloured bind. The mark says
-- something about the card itself, not about what the cursor is doing.
const EYE_INK: string = "#e8dfbd"
const EYE_GROUND: string = "#0b0b10"
-- The eye rides the middle of a card's top edge, centred on the edge itself so
-- half of it stands clear of the card: it reads as a tag pinned to the relic
-- rather than part of the artwork, and it stays off the rank, the school and
-- the seal's ward. The card's middle rather than a corner: the fan tucks every
-- relic's right edge under its neighbour, so a mark out there is invisible on
-- four of the five, and the left corner already carries the rank. FAN_PITCH is
-- how much of a fanned relic stays uncovered, and the eye sits well inside it.
const EYE_HALF_W: f64 = 7.0
const EYE_LID: f64 = 4.6
-- Board anchors card animations travel between. main.walu mirrors these ids
-- when it builds animations, the same way it mirrors the modal ids above.
const SLOT_PLAYER: i32 = 0
const SLOT_COMPUTER: i32 = 1
const SLOT_MIDDLE: i32 = 2
const SLOT_DECK: i32 = 3
const SLOT_ASIDE: i32 = 4

-- The player holds their five relics in a fan rather than a row: each step
-- outward from the middle relic slides FAN_PITCH sideways, tilts FAN_TILT
-- further from upright, and dips along a shallow arc. FAN_PITCH is well under
-- CARD_W, so relics overlap; because each one covers only its neighbour's
-- right edge, the rank and school in the top-left corner stay readable. The
-- Arch Mage's sealed row and the wards keep their flat layout.
const FAN_MIDDLE: f64 = 2.0
const FAN_PITCH: f64 = 74.0
const FAN_TILT: f64 = 0.075
-- The arc's dip per squared step: the outermost relics sit 4 * FAN_DROP below
-- the middle one, which approximates a pivot far below the board.
const FAN_DROP: f64 = 2.8
const FAN_CENTER_X: f64 = 480.0
const FAN_CENTER_Y: f64 = 509.0
-- How far the fan slides open around the focused relic, in the same steps as
-- everything else here — about a quarter of the gap to its neighbour. This is
-- deliberately short of the ~0.41 steps it would take for FAN_PITCH to clear
-- CARD_W: relics keep their dealt stacking order, so the focused one still
-- tucks under the relic to its right, and the parting reads as the fan
-- breathing rather than a card climbing out of it.
const FAN_PART: f64 = 0.23
-- A focus of FAN_CLOSED — below the first of the five relics — closes the
-- fan, leaving every relic at its resting slot. Focus only exists while the
-- cursor can actually move, so cards in flight and a resolving breach both draw
-- the hand closed, which is what keeps animation endpoints honest: slot_x and
-- slot_y describe the closed fan.
const FAN_CLOSED: i32 = -1

-- Faces an animated card shows along its flight: stay sealed, stay revealed,
-- or flip between the two mid-flight. main.walu mirrors these values too.
const FACES_DOWN: i32 = 0
const FACES_UP: i32 = 1
const FACES_FLIP_UP: i32 = 2
const FACES_FLIP_DOWN: i32 = 3
const EASE_OUT_QUINT: i32 = 0
const EASE_IN_CUBIC: i32 = 1
const EASE_IN_OUT_CUBIC: i32 = 2
const EASE_OUT_BACK: i32 = 3

-- One leg of a card's journey across the board. The card renders at x0/y0
-- until start, travels to x1/y1 over duration, and only exists on screen
-- inside [appear, vanish) — outside that window an adjacent leg or the real
-- board slot owns the card. The card also turns from angle0 to angle1, which
-- is how a relic joins or leaves the player's tilted fan without snapping
-- upright at either end. Legs whose dest_kind names a board slot keep that
-- slot empty until they vanish, so state that already changed is not revealed
-- ahead of the animation. `known` matches the slot the card is headed for, so a
-- ward crossing into a hand carries its eye the whole way rather than sprouting
-- one the instant it lands.
type Anim = {
    card: game.Card,
    faces: i32,
    known: bool,
    x0: f64,
    y0: f64,
    x1: f64,
    y1: f64,
    angle0: f64,
    angle1: f64,
    easing: i32,
    start: f64,
    duration: f64,
    appear: f64,
    vanish: f64,
    dest_kind: i32,
    dest_index: i32
}

function ease_in_out_cubic(t: f64): f64
    if t < 0.5 then return 4.0 * t * t * t end
    local back: f64 = -2.0 * t + 2.0
    return 1.0 - back * back * back * 0.5
end

function ease_out_quint(t: f64): f64
    local back: f64 = 1.0 - t
    local squared: f64 = back * back
    return 1.0 - squared * squared * back
end

function ease_out_back(t: f64): f64
    local c1: f64 = 1.70158
    local c3: f64 = c1 + 1.0
    local back: f64 = t - 1.0
    return 1.0 + c3 * back * back * back + c1 * back * back
end

function ease_progress(t: f64, easing: i32): f64
    if easing == EASE_IN_CUBIC then return t * t * t end
    if easing == EASE_IN_OUT_CUBIC then return ease_in_out_cubic(t) end
    if easing == EASE_OUT_BACK then return ease_out_back(t) end
    return ease_out_quint(t)
end

-- Where a relic sits along the fan: steps from the middle relic, negative to
-- its left, plus however far the parting has pushed it. This one number is the
-- fan's only degree of freedom — slide, dip, and tilt all read off it — so a
-- parting relic travels along the arc the fan already describes instead of
-- skidding sideways out of the curve.
function hand_step(index: i32, part: f64): f64
    return (index::f64) - FAN_MIDDLE + part
end

function hand_angle(index: i32, part: f64): f64
    return hand_step(index, part) * FAN_TILT
end

-- Top-left of a relic's card box, in its own tilted frame.
function hand_x(index: i32, part: f64): f64
    return FAN_CENTER_X + hand_step(index, part) * FAN_PITCH - CARD_W * 0.5
end

function hand_y(index: i32, part: f64): f64
    local step: f64 = hand_step(index, part)
    return FAN_CENTER_Y + step * step * FAN_DROP - CARD_H * 0.5
end

-- Where a relic's parting offset is headed: the fan opens around the focused
-- relic, everything left of it sliding left and everything right sliding right,
-- while the focused relic itself holds still. main.walu eases each relic toward
-- its target rather than reading this straight, so the fan parts over a few
-- frames instead of snapping as the cursor steps along the hand.
function hand_part_target(index: i32, focus: i32): f64
    if focus == FAN_CLOSED then return 0.0 end
    if index < focus then return -FAN_PART end
    if index > focus then return FAN_PART end
    return 0.0
end

function slot_x(kind: i32, index: i32): f64
    if kind == SLOT_PLAYER then return hand_x(index, 0.0) end
    if kind == SLOT_COMPUTER then return 190.0 + (index::f64) * 116.0 end
    if kind == SLOT_MIDDLE then return 302.0 + (index::f64) * 116.0 end
    if kind == SLOT_DECK then return 56.0 end
    return 800.0 + (index::f64) * 4.0
end

function slot_y(kind: i32, index: i32): f64
    if kind == SLOT_PLAYER then return hand_y(index, 0.0) end
    if kind == SLOT_COMPUTER then return 116.0 end
    if kind == SLOT_ASIDE then return 292.0 + (index::f64) * 12.0 end
    return 292.0
end

function slot_hidden(anims: {Anim}, clock: f64, kind: i32, index: i32): bool
    for anim in anims do
        if anim.dest_kind == kind and anim.dest_index == index and clock < anim.vanish then
            return true
        end
    end
    return false
end

function text(graphics: Graphics, value: string, x: f64, y: f64, size: f64, color: string): unit
    graphics:set_color(color)
    graphics:set_font(tostring(size) .. "px monospace")
    graphics:print(value, x, y)
end

function text_centered(graphics: Graphics, value: string, center_x: f64, y: f64, size: f64, color: string): unit
    graphics:set_color(color)
    graphics:set_font(tostring(size) .. "px monospace")
    graphics:print_aligned(value, center_x, y, "center")
end

function text_right(graphics: Graphics, value: string, right_x: f64, y: f64, size: f64, color: string): unit
    graphics:set_color(color)
    graphics:set_font(tostring(size) .. "px monospace")
    graphics:print_aligned(value, right_x, y, "right")
end

function panel(graphics: Graphics, x: f64, y: f64, width: f64, height: f64, fill: string, edge: string): unit
    graphics:set_color(fill)
    graphics:fill_rectangle(x, y, width, height)
    graphics:set_color(edge)
    graphics:set_line_width(2.0)
    graphics:stroke_rectangle(x, y, width, height)
end

function school_color(suit: i32): string
    if suit == 0 then return "#ef4444" end
    if suit == 1 then return "#38bdf8" end
    if suit == 2 then return "#a855f7" end
    return "#4ade80"
end

function rank_name(rank: i32): string
    if rank == 14 then return "A" end
    if rank == 13 then return "K" end
    if rank == 12 then return "Q" end
    if rank == 11 then return "J" end
    return tostring(rank)
end

function is_picked(picks: {i32}, value: i32): bool
    for pick in picks do if pick == value then return true end end
    return false
end

function draw_sigil(graphics: Graphics, suit: i32, x: f64, y: f64): unit
    -- Every school mark sits on the same compact ink seal. Active shaders can
    -- become bright directly beneath a line, so relying on contrast from the
    -- card field alone would let the colored symbol disappear frame-to-frame.
    graphics:set_color("#09090b")
    graphics:fill_circle(x + 11.0, y + 3.0, 18.0)
    graphics:set_color(school_color(suit))
    graphics:set_line_width(3.0)
    if suit == 0 then
        -- Red school: a cut gem — flat crown, girdle line, pointed pavilion.
        graphics:line(x + 5.0, y - 9.0, x + 17.0, y - 9.0)
        graphics:line(x + 17.0, y - 9.0, x + 22.0, y - 1.0)
        graphics:line(x + 22.0, y - 1.0, x + 11.0, y + 17.0)
        graphics:line(x + 11.0, y + 17.0, x, y - 1.0)
        graphics:line(x, y - 1.0, x + 5.0, y - 9.0)
        graphics:line(x, y - 1.0, x + 22.0, y - 1.0)
    elseif suit == 1 then
        graphics:fill_circle(x + 11.0, y + 3.0, 12.0)
        graphics:set_color("#111827")
        graphics:fill_circle(x + 11.0, y - 1.0, 6.0)
    elseif suit == 2 then
        graphics:fill_rectangle(x, y - 9.0, 22.0, 22.0)
        graphics:set_color("#09090b")
        graphics:fill_rectangle(x + 6.0, y - 3.0, 10.0, 10.0)
    else
        -- Green school: a leaf blade with a midrib and two side veins.
        graphics:line(x, y + 16.0, x + 22.0, y - 9.0)
        graphics:line(x + 7.0, y + 8.0, x + 12.0, y + 13.0)
        graphics:line(x + 14.0, y, x + 19.0, y + 5.0)
    end
end

-- The mark a relic carries once the other side has watched it come off the
-- wards: an open eye, drawn about its own centre on its own dark ground so it
-- reads over both a card's face and its seal. Both quadratic lids share one
-- path and use control points twice their centre offset so the curve peaks at
-- EYE_LID halfway across.
function draw_eye(graphics: Graphics, x: f64, y: f64): unit
    graphics:set_color(EYE_GROUND)
    graphics:fill_circle(x, y, 9.0)
    graphics:set_color(EYE_INK)
    graphics:set_line_width(1.3)
    graphics:begin_path()
    graphics:move_to(x - EYE_HALF_W, y)
    graphics:quadratic_curve_to(x, y - EYE_LID * 2.0, x + EYE_HALF_W, y)
    graphics:move_to(x - EYE_HALF_W, y)
    graphics:quadratic_curve_to(x, y + EYE_LID * 2.0, x + EYE_HALF_W, y)
    graphics:stroke()
    graphics:fill_circle(x, y, 2.4)
end

-- One quad backs the entire winning formation. Because it is drawn before all
-- five cards, the cards mask its centre while the same continuous shimmer
-- remains visible around the perimeter and through every inter-card gap.
function draw_winning_shimmer(graphics: Graphics, effects: EffectShaders, x: f64, y: f64, width: f64, height: f64, strength: f64): unit
    if strength <= 0.0 then return end
    local quad_width: f64 = width + SHIMMER_MARGIN * 2.0
    local quad_height: f64 = height + SHIMMER_MARGIN * 2.0
    if not use_gold_shimmer(graphics, effects, strength, quad_width / quad_height) then return end
    graphics:set_color("#ffffffff")
    graphics:fill_rectangle(x - SHIMMER_MARGIN, y - SHIMMER_MARGIN, quad_width, quad_height)
    stop_effect(graphics)
end

-- The packaged image is the card back. While it is unavailable, retain only a
-- sealed dark silhouette rather than maintaining a second procedural design.
function draw_card_back(graphics: Graphics, card_back: graphics_module.Texture?, x: f64, y: f64, veiled: bool): unit
    local maybe_texture: graphics_module.Texture? = card_back
    if maybe_texture ~= nil then
        local texture: graphics_module.Texture = maybe_texture::graphics_module.Texture
        if veiled then graphics:set_color("#ffffff80") else graphics:set_color("#ffffffff") end
        if graphics:draw_sprite(texture, x, y, CARD_W, CARD_H, 0.0, 0.0, texture.width::f64, texture.height::f64) then
            return
        end
    end
    local fill: string = "#111118"
    if veiled then fill = "#11111880" end
    panel(graphics, x, y, CARD_W, CARD_H, fill, "#3f3f46")
end

function draw_card_face(graphics: Graphics, effects: EffectShaders, card: game.Card, x: f64, y: f64, selected: bool, colored: bool): unit
    -- Suit marks always keep their school color. Selection activates the
    -- school's grayscale pattern; contributing cards use its colored variant.
    if card.suit == 0 and (colored or selected) then
        use_red_fire(graphics, effects, selected, colored, (CARD_W - 4.0) / (CARD_H - 4.0))
    elseif card.suit == 1 and (colored or selected) then
        use_blue_caustics(graphics, effects, selected, colored, (CARD_W - 4.0) / (CARD_H - 4.0))
    elseif card.suit == 2 and (colored or selected) then
        use_black_hole(graphics, effects, selected, colored, (CARD_W - 4.0) / (CARD_H - 4.0))
    elseif card.suit == 3 and (colored or selected) then
        use_green_growth(graphics, effects, selected, colored, (CARD_W - 4.0) / (CARD_H - 4.0))
    end
    graphics:set_color("#17171c")
    graphics:fill_rectangle(x + 2.0, y + 2.0, CARD_W - 4.0, CARD_H - 4.0)
    if colored or selected then stop_effect(graphics) end
    local accent: string = school_color(card.suit)
    graphics:set_color(accent)
    graphics:fill_rectangle(x + 7.0, y + 7.0, 5.0, CARD_H - 14.0)
    text(graphics, rank_name(card.rank), x + 20.0, y + 31.0, 24, "#f8fafc")
    -- The school never appears in words on a card: the accent stripe and the
    -- sigil carry it, the same pairing the help legend teaches.
    draw_sigil(graphics, card.suit, x + 42.0, y + 82.0)
    if selected then text_centered(graphics, "BOUND", x + CARD_W * 0.5, y + 119.0, 9, SELECTION_HIGHLIGHT) end
end

-- `known` says the opponent has seen this card, which the eye announces on
-- either face. A sealed card that is also known is drawn face first and then
-- veiled by its own seal, so the player reads the Arch Mage's relic through the
-- back instead of having to remember it.
function draw_card(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, card: game.Card, x: f64, y: f64, selected: bool, focused: bool, hidden: bool, colored: bool, known: bool): unit
    local offset: f64 = 0.0
    if selected then offset = -10.0 end
    y += offset
    local edge: string = "#52525b"
    if focused then edge = SELECTION_HIGHLIGHT elseif selected then edge = school_color(card.suit) end
    panel(graphics, x, y, CARD_W, CARD_H, "#17171c", edge)
    if hidden then
        if known then draw_card_face(graphics, effects, card, x, y, false, false) end
        draw_card_back(graphics, card_back, x, y, known)
    else
        draw_card_face(graphics, effects, card, x, y, selected, colored)
    end
    if known then draw_eye(graphics, x + CARD_W * 0.5, y) end
end

-- A relic sitting in the player's fan. Drawing it about its own centre lets
-- the tilt carry everything with it — the bind lift rises along the card's own
-- axis rather than straight up the screen, and the focus edge stays square to
-- the card.
function draw_hand_card(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, card: game.Card, index: i32, part: f64, selected: bool, focused: bool, colored: bool, known: bool): unit
    graphics:push()
    graphics:translate(hand_x(index, part) + CARD_W * 0.5, hand_y(index, part) + CARD_H * 0.5)
    graphics:rotate(hand_angle(index, part))
    draw_card(graphics, effects, card_back, card, -(CARD_W * 0.5), -(CARD_H * 0.5), selected, focused, false, colored, known)
    graphics:pop()
end

-- Fakes a card picked up off the table and turned over midair: cos
-- collapses the width (back, edge-on, then face) while sin lifts the card
-- toward the viewer — rising and growing around mid-flip — so the rotation
-- happens in the air instead of sweeping through the table surface. A
-- slight sin-driven skew tilts the silhouette for perspective. Everything
-- inherits the transform stack, so the regular card renderer draws both
-- halves of the flip.
function draw_flipping_card(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, card: game.Card, x: f64, y: f64, clock: f64, delay: f64, colored: bool): unit
    local progress: f64 = (clock - delay) / FLIP_SECONDS
    if progress < 0.0 then progress = 0.0 end
    if progress > 1.0 then progress = 1.0 end
    local turn: f64 = ease_in_out_cubic(progress)
    local angle: f64 = turn * math.pi
    local flat: f64 = math.cos(angle)
    local depth: f64 = math.sin(angle)
    local hidden: bool = flat >= 0.0
    local width_scale: f64 = flat
    if not hidden then width_scale = -flat end
    local lift: f64 = 1.0 + 0.14 * depth
    graphics:push()
    graphics:translate(x + CARD_W * 0.5, y + CARD_H * 0.5 - 10.0 * depth)
    graphics:apply_transform(width_scale * lift, 0.18 * depth, 0.0, lift, 0.0, 0.0)
    -- A card being turned over is on its way to public: whether the other side
    -- knew it a moment ago stops mattering the instant it lands face up, so no
    -- eye rides the flip.
    draw_card(graphics, effects, card_back, card, -(CARD_W * 0.5), -(CARD_H * 0.5), false, false, hidden, colored, false)
    graphics:pop()
end

-- The sealed draw pile every dealt relic and ward flies out of. The stack
-- silhouette thins as the run burns down; the label tracks the exact count.
function draw_deck(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, count: i32): unit
    if count <= 0 then return end
    local x: f64 = slot_x(SLOT_DECK, 0)
    local y: f64 = slot_y(SLOT_DECK, 0)
    if count > 18 then panel(graphics, x + 6.0, y + 6.0, CARD_W, CARD_H, "#17171c", "#3f3f46") end
    if count > 6 then panel(graphics, x + 3.0, y + 3.0, CARD_W, CARD_H, "#17171c", "#3f3f46") end
    panel(graphics, x, y, CARD_W, CARD_H, "#17171c", "#52525b")
    draw_card_back(graphics, card_back, x, y, false)
    text_centered(graphics, tostring(count) .. " SEALED", x + CARD_W * 0.5, y + CARD_H + 26.0, 10, "#8a8a92")
end

-- The spent pile opposite the draw pile, at the same anchor the feint already
-- sets displaced wards aside on: every resolved formation is scooped onto it
-- face up, so the pile always shows the last card that landed — spent cards
-- are public history, unlike the sealed run. It mirrors the deck — the
-- stack's shadow steps out to the left instead of the right, and the label
-- right-aligns under the card — so the two piles bracket the board as source
-- and sink. count is how many cards have visibly landed; the top card is
-- read from the same ledger, so a scoop still in the air leaves both the
-- thickness and the face showing exactly what the table last saw.
function draw_discard(graphics: Graphics, effects: EffectShaders, discards: {game.Card}, count: i32): unit
    if count <= 0 then return end
    local x: f64 = slot_x(SLOT_ASIDE, 0)
    local y: f64 = slot_y(SLOT_ASIDE, 0)
    if count > 18 then panel(graphics, x - 6.0, y + 6.0, CARD_W, CARD_H, "#17171c", "#3f3f46") end
    if count > 6 then panel(graphics, x - 3.0, y + 3.0, CARD_W, CARD_H, "#17171c", "#3f3f46") end
    panel(graphics, x, y, CARD_W, CARD_H, "#17171c", "#52525b")
    draw_card_face(graphics, effects, discards[count - 1], x, y, false, false)
    graphics:set_color("#8a8a92")
    graphics:set_font("10px monospace")
    graphics:print_aligned(tostring(count) .. " SPENT", x + CARD_W - 10.0, y + CARD_H + 26.0, "right")
end

-- How many discarded cards have actually arrived: the ledger's total minus
-- every card still flying a leg that lands on the pile, so the stack only
-- thickens when a card visibly reaches it. The feint's aside legs pass the
-- same anchor as a waypoint, but they carry dest_kind -1 and stay uncounted.
function discard_landed(discards: {game.Card}, anims: {Anim}, clock: f64): i32
    local pending: i32 = 0
    for anim in anims do
        if anim.dest_kind == SLOT_ASIDE and clock < anim.vanish then pending += 1 end
    end
    return #discards - pending
end

-- A card mid-deal or mid-swap: eased travel between two board anchors with
-- an optional mid-flight flip, turning to meet the tilt of wherever it lands
-- and lifted slightly toward the viewer while it moves (matching the reveal
-- flip's midair feel).
function draw_anim_card(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, anim: Anim, clock: f64): unit
    if clock < anim.appear or clock >= anim.vanish then return end
    local t: f64 = 1.0
    if anim.duration > 0.0 then t = (clock - anim.start) / anim.duration end
    if t < 0.0 then t = 0.0 end
    if t > 1.0 then t = 1.0 end
    local ease: f64 = ease_progress(t, anim.easing)
    local x: f64 = anim.x0 + (anim.x1 - anim.x0) * ease
    local y: f64 = anim.y0 + (anim.y1 - anim.y0) * ease
    local hidden: bool = anim.faces == FACES_DOWN
    local width_scale: f64 = 1.0
    local turn: f64 = ease_in_out_cubic(t)
    if anim.faces == FACES_FLIP_UP or anim.faces == FACES_FLIP_DOWN then
        local flat: f64 = math.cos(turn * math.pi)
        if anim.faces == FACES_FLIP_UP then hidden = flat >= 0.0 else hidden = flat < 0.0 end
        width_scale = flat
        if width_scale < 0.0 then width_scale = -width_scale end
    end
    local depth: f64 = math.sin(turn * math.pi)
    local lift: f64 = 1.0 + 0.08 * depth
    graphics:push()
    graphics:translate(x + CARD_W * 0.5, y + CARD_H * 0.5 - 8.0 * depth)
    graphics:rotate(anim.angle0 + (anim.angle1 - anim.angle0) * ease)
    graphics:apply_transform(width_scale * lift, 0.0, 0.0, lift, 0.0, 0.0)
    draw_card(graphics, effects, card_back, anim.card, -(CARD_W * 0.5), -(CARD_H * 0.5), false, false, hidden, false, anim.known)
    graphics:pop()
end

function draw_anims(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, anims: {Anim}, clock: f64): unit
    for anim in anims do
        draw_anim_card(graphics, effects, card_back, anim, clock)
    end
end

function draw_backdrop(graphics: Graphics): unit
    graphics:clear("#09090b")
    graphics:set_color("#111114")
    graphics:fill_rectangle(0.0, 0.0, WIDTH, HEIGHT)
    graphics:set_color("#1e1e24")
    graphics:set_line_width(1.0)
    for x = 0, 960, 48 do graphics:line(x::f64, 0.0, WIDTH - (x::f64), HEIGHT) end
end

function draw_orb(graphics: Graphics, x: f64, y: f64, edge: string, fill: string, played: bool): unit
    graphics:set_color(edge)
    graphics:fill_circle(x, y, 10.0)
    graphics:set_color(fill)
    graphics:fill_circle(x, y, 7.0)
    if played then
        graphics:set_color("#ffffff")
        graphics:fill_circle(x - 2.5, y - 2.5, 1.5)
    end
end

function draw_round_orbs(graphics: Graphics, state: game.State): unit
    for round = 0::i32, TOTAL_ROUNDS - 1 do
        local x: f64 = 412.0 + (round::f64) * 34.0
        local edge: string = "#52525b"
        local fill: string = "#17171c"
        local played: bool = round < #state.history
        if played then
            local winner: i32 = state.history[round].winner
            if winner > 0 then
                edge = ORB_ROBBERS_EDGE
                fill = ORB_ROBBERS_FILL
            elseif winner < 0 then
                edge = ORB_ARCH_MAGE_EDGE
                fill = ORB_ARCH_MAGE_FILL
            else
                -- A stalemate is not a ward hold: it does not count toward the
                -- Arch Mage's three wins, so it must not wear the lost colour
                -- or the run looks like it should have ended early.
                edge = ORB_STALEMATE_EDGE
                fill = ORB_STALEMATE_FILL
            end
        end
        if round == state.round - 1 then
            graphics:set_color(SELECTION_HIGHLIGHT)
            graphics:fill_circle(x, 52.0, 12.0)
        end
        draw_orb(graphics, x, 52.0, edge, fill, played)
    end
end

function draw_hud(graphics: Graphics, state: game.State): unit
    text(graphics, "ARCANE HEIST", 32.0, 47.0, 22, "#fbbf24")
    draw_round_orbs(graphics, state)
    local score: string = tostring(state.player_points)
    graphics:set_font("22px monospace")
    graphics:set_color("#67e8f9")
    graphics:print_aligned(score, WIDTH - 32.0, 47.0, "right")
end

function draw_footer(graphics: Graphics): unit
    text_right(graphics, "? HELP", WIDTH - 17.0, 582.0, 10, "#8a8a92")
end

-- A stronger cubic acceleration/deceleration gives the winner's flight a
-- deliberate launch and a decisive landing, while remaining exactly bounded.
function fly_ease(clock: f64, delay: f64): f64
    local t: f64 = (clock - delay) / FLY_SECONDS
    if t < 0.0 then return 0.0 end
    if t > 1.0 then t = 1.0 end
    return ease_in_out_cubic(t)
end

-- One winner card travelling from its revealed pose to a flank of the ward
-- row: the centre lerps, the source tilt unwinds to flat, and the same
-- sin-driven lift the other flights use keeps it airborne in between. ease 0
-- means the flight has not begun and the card still sits in its row, so
-- nothing is drawn.
function draw_winner_flight(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, card: game.Card, sx: f64, sy: f64, sangle: f64, dest_x: f64, ease: f64, colored: bool): unit
    if ease <= 0.0 then return end
    local x: f64 = sx + (dest_x + CARD_W * 0.5 - sx) * ease
    local y: f64 = sy + (ROW_Y + CARD_H * 0.5 - sy) * ease
    local depth: f64 = math.sin(ease * math.pi)
    local lift: f64 = 1.0 + 0.08 * depth
    graphics:push()
    graphics:translate(x, y - 8.0 * depth)
    graphics:rotate(sangle * (1.0 - ease))
    graphics:apply_transform(lift, 0.0, 0.0, lift, 0.0, 0.0)
    draw_card(graphics, effects, card_back, card, -(CARD_W * 0.5), -(CARD_H * 0.5), false, false, false, colored, false)
    graphics:pop()
end

function trick_scoring(trick: game.Trick): {bool}
    if trick.winner > 0 then
        return game.scoring_cards({ trick.middle[0], trick.middle[1], trick.middle[2], trick.player_cards[0], trick.player_cards[1] }, trick.player_value, trick.computer_value)
    elseif trick.winner < 0 then
        return game.scoring_cards({ trick.middle[0], trick.middle[1], trick.middle[2], trick.computer_cards[0], trick.computer_cards[1] }, trick.computer_value, trick.player_value)
    end
    return { false, false, false, false, false }
end

function draw_resolution_board(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, state: game.State, fan_parts: {f64}, reveal_clock: f64, discards: {game.Card}): unit
    local trick: game.Trick = state.history[#state.history - 1]
    draw_hud(graphics, state)
    draw_deck(graphics, effects, card_back, #state.deck)
    -- No cards are in flight while a breach resolves, so the pile is settled.
    draw_discard(graphics, effects, discards, #discards)
    local scoring: {bool} = trick_scoring(trick)
    -- Flight progress for the winner's two cards; a stalemate has no winner,
    -- so nothing takes off and both played pairs stay where they revealed.
    local fly0: f64 = 0.0
    local fly1: f64 = 0.0
    if trick.winner ~= 0 then
        fly0 = fly_ease(reveal_clock, FLY_START)
        fly1 = fly_ease(reveal_clock, FLY_START + FLY_STAGGER)
    end
    -- The shimmer waits for the second card to land, then ramps to full.
    -- reveal_clock holds at its cap once the reveal is over, so the settled
    -- shimmer stays live instead of resetting. A stalemate completes no
    -- formation, so nothing ignites.
    local glow: f64 = 0.0
    local lift_progress: f64 = 0.0
    if trick.winner ~= 0 then
        local glow_time: f64 = (reveal_clock - (FLY_START + FLY_STAGGER + FLY_SECONDS)) / WIN_GLOW_FADE
        if glow_time < 0.0 then glow_time = 0.0 end
        if glow_time > 1.0 then glow_time = 1.0 end
        glow = ease_out_quint(glow_time)
        lift_progress = ease_out_back(glow_time)
    end
    if trick.winner > 0 then text_centered(graphics, "DEFENSE BREACHED +" .. tostring(trick.points), WIDTH * 0.5, 103.0, 14, "#67e8f9")
    elseif trick.winner < 0 then text_centered(graphics, "THE WARDS HOLD", WIDTH * 0.5, 103.0, 14, "#fca5a5")
    else text_centered(graphics, "MAGICS CANCEL", WIDTH * 0.5, 103.0, 14, "#fbbf24") end
    text_centered(graphics, game.category_name(trick.player_value) .. "  VS  " .. game.category_name(trick.computer_value), WIDTH * 0.5, 252.0, 11, "#d4d4d8")

    -- The played Arch Mage cards flip in their original slots, then fly to
    -- the ward row if the wards held; a slot goes empty the moment its card
    -- takes off. Everything else stays sealed, so only the winning formation
    -- gains suit color.
    for i = 0::i32, 4::i32 do
        local x: f64 = 190.0 + (i::f64) * 116.0
        if i == trick.computer_first then
            if trick.winner >= 0 or fly0 <= 0.0 then
                draw_flipping_card(graphics, effects, card_back, trick.computer_cards[0], x, 116.0, reveal_clock, 0.2, trick.winner < 0 and scoring[3])
            end
        elseif i == trick.computer_second then
            if trick.winner >= 0 or fly1 <= 0.0 then
                draw_flipping_card(graphics, effects, card_back, trick.computer_cards[1], x, 116.0, reveal_clock, 0.2 + FLIP_SECONDS * 0.7, trick.winner < 0 and scoring[4])
            end
        else
            draw_card(graphics, effects, card_back, trick.computer_hand[i], x, 116.0, false, false, true, false, trick.computer_known[i])
        end
    end

    -- The panel marks the landing zone. Before the halo ignites, the three
    -- wards remain part of this ordinary table layer; once the formation is
    -- complete, they move into the foreground layer with the winning pair.
    panel(graphics, 160.0, 258.0, 620.0, 148.0, "#101013", "#3f3f46")
    if glow <= 0.0 then
        for i = 0::i32, 2::i32 do
            draw_card(graphics, effects, card_back, trick.middle[i], 302.0 + (i::f64) * 116.0, 292.0, false, false, false, trick.winner ~= 0 and scoring[i], false)
        end
    end

    text_centered(graphics, "ENTER CONTINUE", WIDTH * 0.5, 442.0, 12, "#fbbf24")
    -- The cursor is not live while a breach resolves, so the fan is already
    -- easing shut; it settles closed behind the flips. The committed relics
    -- stay bound and lifted until their flight begins, so it stays clear
    -- which cards faced the Arch Mage; after takeoff their fan slots simply
    -- stand empty, the way a spent relic's would.
    for i = 0::i32, 4::i32 do
        if i == trick.player_first then
            if trick.winner <= 0 or fly0 <= 0.0 then
                draw_hand_card(graphics, effects, card_back, trick.player_cards[0], i, fan_parts[i], true, false, trick.winner > 0 and scoring[3], false)
            end
        elseif i == trick.player_second then
            if trick.winner <= 0 or fly1 <= 0.0 then
                draw_hand_card(graphics, effects, card_back, trick.player_cards[1], i, fan_parts[i], true, false, trick.winner > 0 and scoring[4], false)
            end
        else
            draw_hand_card(graphics, effects, card_back, trick.player_hand[i], i, fan_parts[i], false, false, false, trick.player_known[i])
        end
    end
    draw_footer(graphics)

    -- Once complete, the entire winning formation becomes a foreground layer:
    -- it eases toward the viewer around its shared centre, rises slightly, and
    -- draws after every remaining UI element. The larger halo shares this
    -- transform, so its beams and rings can wash over the table while the five
    -- cards remain crisp on top of it.
    local foreground: bool = glow > 0.0
    if foreground then
        local scale: f64 = 1.0 + (WIN_LIFT_SCALE - 1.0) * lift_progress
        graphics:push()
        graphics:translate(ROW_CENTER_X, ROW_CENTER_Y - WIN_LIFT_Y * lift_progress)
        graphics:apply_transform(scale, 0.0, 0.0, scale, 0.0, 0.0)
        graphics:translate(-ROW_CENTER_X, -ROW_CENTER_Y)
        draw_winning_shimmer(graphics, effects, ROW_LEFT_X, ROW_Y, ROW_RIGHT_X + CARD_W - ROW_LEFT_X, CARD_H, glow)
        for i = 0::i32, 2::i32 do
            draw_card(graphics, effects, card_back, trick.middle[i], 302.0 + (i::f64) * 116.0, 292.0, false, false, false, scoring[i], false)
        end
    end

    -- The winner's pair sails over whatever it passes, then joins the same
    -- transformed foreground layer as the wards. The fan pose folds the bind
    -- lift into the start centre — rotate (0, -10) by the relic's tilt — so
    -- takeoff continues the lift instead of snapping back down to the slot.
    if trick.winner < 0 then
        draw_winner_flight(graphics, effects, card_back, trick.computer_cards[0],
            190.0 + (trick.computer_first::f64) * 116.0 + CARD_W * 0.5, 116.0 + CARD_H * 0.5, 0.0,
            ROW_LEFT_X, fly0, scoring[3])
        draw_winner_flight(graphics, effects, card_back, trick.computer_cards[1],
            190.0 + (trick.computer_second::f64) * 116.0 + CARD_W * 0.5, 116.0 + CARD_H * 0.5, 0.0,
            ROW_RIGHT_X, fly1, scoring[4])
    elseif trick.winner > 0 then
        local angle0: f64 = hand_angle(trick.player_first, fan_parts[trick.player_first])
        local angle1: f64 = hand_angle(trick.player_second, fan_parts[trick.player_second])
        draw_winner_flight(graphics, effects, card_back, trick.player_cards[0],
            hand_x(trick.player_first, fan_parts[trick.player_first]) + CARD_W * 0.5 + math.sin(angle0) * 10.0,
            hand_y(trick.player_first, fan_parts[trick.player_first]) + CARD_H * 0.5 - math.cos(angle0) * 10.0,
            angle0, ROW_LEFT_X, fly0, scoring[3])
        draw_winner_flight(graphics, effects, card_back, trick.player_cards[1],
            hand_x(trick.player_second, fan_parts[trick.player_second]) + CARD_W * 0.5 + math.sin(angle1) * 10.0,
            hand_y(trick.player_second, fan_parts[trick.player_second]) + CARD_H * 0.5 - math.cos(angle1) * 10.0,
            angle1, ROW_RIGHT_X, fly1, scoring[4])
    end
    if foreground then graphics:pop() end
end

-- One relic of the fan, unless a card bound for that slot is still in flight.
function draw_hand_slot(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, state: game.State, index: i32, focus: i32, parts: {f64}, play_picks: {i32}, swap_hand: {i32}, anims: {Anim}, anim_clock: f64): unit
    if slot_hidden(anims, anim_clock, SLOT_PLAYER, index) then return end
    local selected: bool = is_picked(play_picks, index)
    if state.swap_open then selected = is_picked(swap_hand, index) end
    draw_hand_card(graphics, effects, card_back, state.player_hand[index], index, parts[index], selected, index == focus,
        false, state.player_known[index])
end

-- hand_focus is the relic the cursor holds, or FAN_CLOSED when nothing does;
-- fan_parts carries each relic's eased parting offset. main.walu owns both, so
-- the fan's motion survives a frame and the focus edge and the parting can
-- never disagree about which relic is active.
function draw_playfield(graphics: Graphics, effects: EffectShaders, card_back: graphics_module.Texture?, state: game.State, hand_focus: i32, fan_parts: {f64}, ward_cursor: i32, cursor_area: i32, play_picks: {i32}, swap_hand: {i32}, swap_wards: {i32}, revealing: bool, reveal_clock: f64, anims: {Anim}, anim_clock: f64, discards: {game.Card}): unit
    if revealing and #state.history > 0 then
        draw_resolution_board(graphics, effects, card_back, state, fan_parts, reveal_clock, discards)
        return
    end
    draw_hud(graphics, state)
    draw_deck(graphics, effects, card_back, #state.deck)
    draw_discard(graphics, effects, discards, discard_landed(discards, anims, anim_clock))
    -- Slots claimed by an in-flight card stay empty until it lands, so the
    -- already-updated game state cannot leak ahead of the animation.
    for i = 0::i32, 4::i32 do
        if not slot_hidden(anims, anim_clock, SLOT_COMPUTER, i) then
            draw_card(graphics, effects, card_back, state.computer_hand[i], slot_x(SLOT_COMPUTER, i), slot_y(SLOT_COMPUTER, i), false, false, true, false, state.computer_known[i])
        end
    end
    if not state.swap_open and #play_picks == 2 then
        local preview_value: i32 = game.value_for_pair(state.player_hand, state.middle, play_picks[0], play_picks[1])
        text_centered(graphics, "OFFER: " .. game.category_name(preview_value), WIDTH * 0.5, 252.0, 11, "#d4d4d8")
    end
    panel(graphics, 278.0, 258.0, 404.0, 148.0, "#101013", "#3f3f46")
    for i = 0::i32, #state.middle - 1 do
        local selected: bool = state.swap_open and is_picked(swap_wards, i)
        local focused: bool = state.swap_open and cursor_area == 1 and ward_cursor == i
        if not slot_hidden(anims, anim_clock, SLOT_MIDDLE, i) then
            -- A ward at rest is face up for both sides to read, so it never
            -- carries an eye: the mark only says something about a hand. One
            -- crossing into a hand does wear it, but that card is an
            -- animation leg rather than this slot.
            draw_card(graphics, effects, card_back, state.middle[i], slot_x(SLOT_MIDDLE, i), slot_y(SLOT_MIDDLE, i), selected, focused, false, false, false)
        end
    end
    if state.swap_open then text_centered(graphics, "FEINT: BIND MATCHING RELICS + WARDS (UP/DOWN)", WIDTH * 0.5, 430.0, 12, "#fbbf24")
    else text_centered(graphics, "BREACH: BIND TWO RELICS", WIDTH * 0.5, 430.0, 12, "#fbbf24") end
    -- Relics keep the order they were dealt in, focused or not: pulling the
    -- focused one to the front would slide it through its neighbours instead of
    -- opening a gap for it. The parting alone gives it room.
    for i = 0::i32, 4::i32 do
        draw_hand_slot(graphics, effects, card_back, state, i, hand_focus, fan_parts, play_picks, swap_hand, anims, anim_clock)
    end
    draw_footer(graphics)
    draw_anims(graphics, effects, card_back, anims, anim_clock)
end

function modal_shell(graphics: Graphics, title: string, subtitle: string): unit
    graphics:set_color("#09090b")
    graphics:fill_rectangle(92.0, 68.0, 776.0, 476.0)
    graphics:set_color("#a1a1aa")
    graphics:set_line_width(3.0)
    graphics:stroke_rectangle(92.0, 68.0, 776.0, 476.0)
    text(graphics, title, 126.0, 117.0, 24, "#fbbf24")
    text(graphics, subtitle, 126.0, 145.0, 11, "#a1a1aa")
end

function draw_help(graphics: Graphics, effects: EffectShaders): unit
    -- "Three ward holds" read as though a stalemate counted; only breaches the
    -- Arch Mage actually wins end the run early.
    modal_shell(graphics, "THE JOB", "SURVIVE FIVE BREACHES. THREE ARCH MAGE WINS END THE HEIST")
    -- Four equal school tiles form one row centred on the modal. Each dark
    -- field uses that school's live shader before its ordinary sigil and name
    -- are drawn on top, so the help legend demonstrates both halves of the
    -- visual language used by contributing and selected cards.
    local school_names: {string} = { "RED", "BLUE", "BLACK", "GREEN" }
    local tile_width: f64 = 136.0
    local tile_gap: f64 = 16.0
    local row_width: f64 = tile_width * 4.0 + tile_gap * 3.0
    local row_left: f64 = WIDTH * 0.5 - row_width * 0.5
    for suit = 0::i32, 3::i32 do
        local tile_x: f64 = row_left + (suit::f64) * (tile_width + tile_gap)
        local center: f64 = tile_x + tile_width * 0.5
        if suit == 0 then
            use_red_fire(graphics, effects, false, true, tile_width / 76.0)
        elseif suit == 1 then
            use_blue_caustics(graphics, effects, false, true, tile_width / 76.0)
        elseif suit == 2 then
            use_black_hole(graphics, effects, false, true, tile_width / 76.0)
        elseif suit == 3 then
            use_green_growth(graphics, effects, false, true, tile_width / 76.0)
        end
        graphics:set_color("#17171c")
        graphics:fill_rectangle(tile_x, 164.0, tile_width, 76.0)
        stop_effect(graphics)
        graphics:set_color(school_color(suit))
        graphics:set_line_width(1.5)
        graphics:stroke_rectangle(tile_x, 164.0, tile_width, 76.0)
        draw_sigil(graphics, suit, center - 11.0, 188.0)
        graphics:set_font("12px monospace")
        graphics:set_color("#b5b5bd")
        graphics:print_aligned(school_names[suit], center, 220.0, "center")
    end
    text(graphics, "1. FEINT", 126.0, 270.0, 16, "#67e8f9")
    text(graphics, "BIND UP TO 3 RELICS AND THE SAME NUMBER OF WARDS.", 126.0, 296.0, 11, "#d4d4d8")
    text(graphics, "EACH CARD RISKS 1 SPARK. PRESS P TO PASS.", 126.0, 318.0, 11, "#d4d4d8")
    text(graphics, "2. BREACH", 126.0, 356.0, 16, "#67e8f9")
    text(graphics, "BIND 2 RELICS. THE STRONGEST FIVE-SIGIL FORMATION WINS.", 126.0, 382.0, 11, "#d4d4d8")
    text(graphics, "LATER BREACHES ARE WORTH MORE SPARKS.", 126.0, 404.0, 11, "#d4d4d8")
    draw_orb(graphics, 133.0, 436.0, ORB_ROBBERS_EDGE, ORB_ROBBERS_FILL, true)
    text(graphics, "WIN", 148.0, 440.0, 11, "#d4d4d8")
    draw_orb(graphics, 225.0, 436.0, ORB_ARCH_MAGE_EDGE, ORB_ARCH_MAGE_FILL, true)
    text(graphics, "LOSS", 240.0, 440.0, 11, "#d4d4d8")
    draw_orb(graphics, 330.0, 436.0, ORB_STALEMATE_EDGE, ORB_STALEMATE_FILL, true)
    text(graphics, "TIE", 345.0, 440.0, 11, "#d4d4d8")
    text(graphics, "ARROWS MOVE   SPACE BIND   ENTER COMMIT   H HISTORY", 126.0, 474.0, 11, "#fbbf24")
    text(graphics, "C SORT BY COLOR   V SORT BY RANK", 126.0, 498.0, 11, "#fbbf24")
end

function draw_history(graphics: Graphics, state: game.State): unit
    modal_shell(graphics, "BREACH LEDGER", "H OR ESC CLOSES THE LEDGER")
    if #state.history == 0 then
        text(graphics, "NO DEFENSES BREACHED YET.", 126.0, 220.0, 16, "#8a8a92")
        return
    end
    local y: f64 = 188.0
    for trick in state.history do
        local winner: string = "STALEMATE"
        if trick.winner > 0 then winner = "ROBBERS +" .. tostring(trick.points)
        elseif trick.winner < 0 then winner = "ARCH MAGE" end
        text(graphics, "BREACH " .. tostring(trick.round), 126.0, y, 13, "#fbbf24")
        text(graphics, winner, 250.0, y, 13, "#f8fafc")
        text(graphics, game.category_name(trick.player_value) .. " VS " .. game.category_name(trick.computer_value), 430.0, y, 10, "#b5b5bd")
        y += 54.0
    end
end

function draw_final(graphics: Graphics, state: game.State): unit
    local title: string = "THE VAULT IS YOURS"
    local subtitle: string = "FIVE BREACHES COMPLETE"
    if state.computer_tricks >= 3 then
        title = "THE ARCH MAGE PREVAILS"
        subtitle = "THREE WARDS HELD. THE HEIST IS OVER"
    end
    modal_shell(graphics, title, subtitle)
    text_centered(graphics, "SPARKS STOLEN", WIDTH * 0.5, 250.0, 18, "#67e8f9")
    text_centered(graphics, tostring(state.player_points), WIDTH * 0.5, 325.0, 44, "#f8fafc")
    text_centered(graphics, "BREACHES WON " .. tostring(state.player_tricks) .. " / 5", WIDTH * 0.5, 376.0, 13, "#d4d4d8")
    text_centered(graphics, "R RESTARTS THE HEIST   H OPENS THE LEDGER", WIDTH * 0.5, 482.0, 12, "#fbbf24")
end

function draw(graphics: Graphics, effects: EffectShaders, state: game.State, hand_focus: i32, fan_parts: {f64}, ward_cursor: i32, cursor_area: i32, play_picks: {i32}, swap_hand: {i32}, swap_wards: {i32}, modal: i32, revealing: bool, reveal_clock: f64, anims: {Anim}, anim_clock: f64, card_back: graphics_module.Texture?, discards: {game.Card}): unit
    draw_backdrop(graphics)
    -- The terminal breach still flips on the board, so keep the playfield up
    -- while a reveal is running even after the game finishes.
    if not state.finished or revealing then
        draw_playfield(graphics, effects, card_back, state, hand_focus, fan_parts, ward_cursor, cursor_area, play_picks, swap_hand, swap_wards, revealing, reveal_clock, anims, anim_clock, discards)
    else
        draw_hud(graphics, state)
    end
    if modal == MODAL_HISTORY then draw_history(graphics, state)
    elseif modal == MODAL_HELP then draw_help(graphics, effects)
    elseif modal == MODAL_FINAL then draw_final(graphics, state) end
end

return {
    draw = draw,
    create_gold_shimmer_shader = create_gold_shimmer_shader,
    create_red_fire_shader = create_red_fire_shader,
    create_blue_caustics_shader = create_blue_caustics_shader,
    create_black_hole_shader = create_black_hole_shader,
    create_green_growth_shader = create_green_growth_shader,
    slot_x = slot_x,
    slot_y = slot_y,
    hand_angle = hand_angle,
    hand_x = hand_x,
    hand_y = hand_y,
    hand_part_target = hand_part_target,
    -- Anchors of the resolved five-card row, exported so main.walu can start
    -- the scoop legs exactly where the reveal left the cards.
    row_left_x = ROW_LEFT_X,
    row_right_x = ROW_RIGHT_X,
    row_y = ROW_Y,
}
