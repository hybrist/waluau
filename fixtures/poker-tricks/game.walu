-- Host-independent rules for Arcane Heist. The presentation treats suits as
-- schools, cards as relics, and the computer as the Arch Mage; the underlying
-- five-card formation, exchange, wager, and trick rules remain unchanged.

type Card = { rank: i32, suit: i32 }
type PairChoice = { first: i32, second: i32, value: i32 }
type SwapChoice = { hand_indices: {i32}, middle_indices: {i32}, community_value: i32, hand_value: i32 }
type Trick = { round: i32, middle: {Card}, player_hand: {Card}, computer_hand: {Card}, player_known: {bool}, computer_known: {bool}, player_cards: {Card}, computer_cards: {Card}, player_first: i32, player_second: i32, computer_first: i32, computer_second: i32, player_value: i32, computer_value: i32, winner: i32, points: i32, pot: i32, player_wager: i32, computer_wager: i32, swap_winner: i32, swap_count: i32 }
-- player_known and computer_known run parallel to the hands: slot i is marked
-- when the card sitting there arrived from the middle, which both sides were
-- looking at, and so is no longer secret from the opponent. Cards drawn off the
-- deck are secret; only an exchange leaks one.
type State = { deck: {Card}, player_hand: {Card}, computer_hand: {Card}, player_known: {bool}, computer_known: {bool}, middle: {Card}, history: {Trick}, round: i32, player_points: i32, player_tricks: i32, computer_tricks: i32, last_player_value: i32, last_computer_value: i32, last_winner: i32, swap_open: bool, pot: i32, player_wager: i32, computer_wager: i32, swap_winner: i32, swap_count: i32, swap_hand_indices: {i32}, swap_middle_indices: {i32}, finished: bool }

const MIN_RANK: i32 = 2
const MAX_RANK: i32 = 14
const MIN_SUIT: i32 = 0
const MAX_SUIT: i32 = 3
const ZERO: i32 = 0
const ONE: i32 = 1
const TWO: i32 = 2
const MAX_ROUNDS: i32 = 5
const ARCH_MAGE_WINS_TO_END: i32 = 3

function make_deck(): {Card}
    local deck: {Card} = {}
    for suit = MIN_SUIT, MAX_SUIT do
        for rank = MIN_RANK, MAX_RANK do
            table.insert(deck, { rank = rank, suit = suit })
        end
    end
    return deck
end

function shuffle(deck: {Card}): unit
    local i: i32 = #deck - ONE
    while i >= ONE do
        local j: i32 = math.random(i + ONE) - ONE
        local card: Card = deck[i]
        deck[i] = deck[j]
        deck[j] = card
        i -= ONE
    end
end

function draw(deck: {Card}): Card
    local card: Card = deck[#deck - ONE]
    table.remove(deck)
    return card
end

function pack(category: i32, a: i32, b: i32, c: i32, d: i32, e: i32): i32
    local value: i32 = category
    value = value * 15 + a
    value = value * 15 + b
    value = value * 15 + c
    value = value * 15 + d
    return value * 15 + e
end

-- Return a lexicographically sortable score for exactly five cards. Category
-- occupies the most significant base-15 digit, followed by poker kickers.
function swap_if_lower(ranks: {i32}, left: i32, right: i32): unit
    if ranks[left] < ranks[right] then
        local value: i32 = ranks[left]
        ranks[left] = ranks[right]
        ranks[right] = value
    end
end

function rank_five(cards: {Card}): i32
    assert(#cards == 5)
    local ranks: {i32} = { cards[0].rank, cards[1].rank, cards[2].rank, cards[3].rank, cards[4].rank }
    -- A fixed five-item bubble sorting network avoids allocating comparator
    -- closures and keeps the evaluator straightforward.
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 2, 3)
    swap_if_lower(ranks, 3, 4)
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 2, 3)
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 0, 1)

    local flush: bool = cards[0].suit == cards[1].suit and cards[0].suit == cards[2].suit and cards[0].suit == cards[3].suit and cards[0].suit == cards[4].suit
    local straight_high: i32 = 0
    if ranks[0] - ranks[4] == 4 and ranks[0] > ranks[1] and ranks[1] > ranks[2] and ranks[2] > ranks[3] and ranks[3] > ranks[4] then
        straight_high = ranks[0]
    elseif ranks[0] == 14 and ranks[1] == 5 and ranks[2] == 4 and ranks[3] == 3 and ranks[4] == 2 then
        straight_high = 5
    end

    if flush and straight_high > 0 then
        return pack(8, straight_high, 0, 0, 0, 0)
    elseif ranks[0] == ranks[3] then
        return pack(7, ranks[0], ranks[4], 0, 0, 0)
    elseif ranks[1] == ranks[4] then
        return pack(7, ranks[1], ranks[0], 0, 0, 0)
    elseif ranks[0] == ranks[2] and ranks[3] == ranks[4] then
        return pack(6, ranks[0], ranks[3], 0, 0, 0)
    elseif ranks[0] == ranks[1] and ranks[2] == ranks[4] then
        return pack(6, ranks[2], ranks[0], 0, 0, 0)
    elseif flush then
        return pack(5, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4])
    elseif straight_high > 0 then
        return pack(4, straight_high, 0, 0, 0, 0)
    elseif ranks[0] == ranks[2] then
        return pack(3, ranks[0], ranks[3], ranks[4], 0, 0)
    elseif ranks[1] == ranks[3] then
        return pack(3, ranks[1], ranks[0], ranks[4], 0, 0)
    elseif ranks[2] == ranks[4] then
        return pack(3, ranks[2], ranks[0], ranks[1], 0, 0)
    elseif ranks[0] == ranks[1] and ranks[2] == ranks[3] then
        return pack(2, ranks[0], ranks[2], ranks[4], 0, 0)
    elseif ranks[0] == ranks[1] and ranks[3] == ranks[4] then
        return pack(2, ranks[0], ranks[3], ranks[2], 0, 0)
    elseif ranks[1] == ranks[2] and ranks[3] == ranks[4] then
        return pack(2, ranks[1], ranks[3], ranks[0], 0, 0)
    elseif ranks[0] == ranks[1] then
        return pack(1, ranks[0], ranks[2], ranks[3], ranks[4], 0)
    elseif ranks[1] == ranks[2] then
        return pack(1, ranks[1], ranks[0], ranks[3], ranks[4], 0)
    elseif ranks[2] == ranks[3] then
        return pack(1, ranks[2], ranks[0], ranks[1], ranks[4], 0)
    elseif ranks[3] == ranks[4] then
        return pack(1, ranks[3], ranks[0], ranks[1], ranks[2], 0)
    end
    return pack(0, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4])
end

function value_for_pair(hand: {Card}, middle: {Card}, first: i32, second: i32): i32
    return rank_five({ middle[0], middle[1], middle[2], hand[first], hand[second] })
end

function best_pair(hand: {Card}, middle: {Card}): PairChoice
    local best: PairChoice = { first = 0, second = 1, value = value_for_pair(hand, middle, 0, 1) }
    for first = ZERO, #hand - TWO do
        for second = first + ONE, #hand - ONE do
            local value: i32 = value_for_pair(hand, middle, first, second)
            if value > best.value then
                best.first = first
                best.second = second
                best.value = value
            end
        end
    end
    return best
end

function clone_cards(cards: {Card}): {Card}
    local copy: {Card} = {}
    for card in cards do table.insert(copy, card) end
    return copy
end

function exchange(hand: {Card}, middle: {Card}, hand_indices: {i32}, middle_indices: {i32}): unit
    assert(#hand_indices == #middle_indices)
    for i = ZERO, #hand_indices - ONE do
        local card: Card = hand[hand_indices[i]]
        hand[hand_indices[i]] = middle[middle_indices[i]]
        middle[middle_indices[i]] = card
    end
end

-- Every slot an exchange touched now holds a card that was face up in the
-- middle a moment ago, so the opponent knows all of them. Whatever the slot
-- held before is gone, and with it any secrecy it still had. Kept apart from
-- exchange itself, which also runs over the throwaway clones best_swap scores.
function mark_known(known: {bool}, hand_indices: {i32}): unit
    for index in hand_indices do known[index] = true end
end

-- Three-card poker ordering used only to break equal swap wagers:
-- straight flush > three of a kind > straight > flush > pair > high card.
function rank_three(cards: {Card}): i32
    assert(#cards == 3)
    local ranks: {i32} = { cards[0].rank, cards[1].rank, cards[2].rank }
    swap_if_lower(ranks, 0, 1)
    swap_if_lower(ranks, 1, 2)
    swap_if_lower(ranks, 0, 1)
    local flush: bool = cards[0].suit == cards[1].suit and cards[0].suit == cards[2].suit
    local straight_high: i32 = 0
    if ranks[0] - ranks[2] == 2 and ranks[0] > ranks[1] and ranks[1] > ranks[2] then
        straight_high = ranks[0]
    elseif ranks[0] == 14 and ranks[1] == 3 and ranks[2] == 2 then
        straight_high = 3
    end
    if flush and straight_high > 0 then return pack(5, straight_high, 0, 0, 0, 0) end
    if ranks[0] == ranks[2] then return pack(4, ranks[0], 0, 0, 0, 0) end
    if straight_high > 0 then return pack(3, straight_high, 0, 0, 0, 0) end
    if flush then return pack(2, ranks[0], ranks[1], ranks[2], 0, 0) end
    if ranks[0] == ranks[1] then return pack(1, ranks[0], ranks[2], 0, 0, 0) end
    if ranks[1] == ranks[2] then return pack(1, ranks[1], ranks[0], 0, 0, 0) end
    return pack(0, ranks[0], ranks[1], ranks[2], 0, 0)
end

function swap_priority(player_wager: i32, player_community: i32, computer_wager: i32, computer_community: i32): i32
    if player_wager <= 0 and computer_wager <= 0 then return 0 end
    if player_wager > computer_wager then return 1 end
    if computer_wager > player_wager then return -1 end
    if player_community > computer_community then return 1 end
    if computer_community > player_community then return -1 end
    return 0
end

function proposed_swap(hand: {Card}, middle: {Card}, hand_indices: {i32}, middle_indices: {i32}): SwapChoice
    local proposed_hand: {Card} = clone_cards(hand)
    local proposed_middle: {Card} = clone_cards(middle)
    exchange(proposed_hand, proposed_middle, hand_indices, middle_indices)
    return {
        hand_indices = hand_indices,
        middle_indices = middle_indices,
        community_value = rank_three(proposed_middle),
        hand_value = best_pair(proposed_hand, proposed_middle).value,
    }
end

function best_swap(hand: {Card}, middle: {Card}): SwapChoice
    local baseline: i32 = best_pair(hand, middle).value
    local best: SwapChoice = { hand_indices = {}, middle_indices = {}, community_value = rank_three(middle), hand_value = baseline }
    local hand_options: {{i32}} = {
        { 0 }, { 1 }, { 2 }, { 3 }, { 4 },
        { 0, 1 }, { 0, 2 }, { 0, 3 }, { 0, 4 }, { 1, 2 }, { 1, 3 }, { 1, 4 }, { 2, 3 }, { 2, 4 }, { 3, 4 },
        { 0, 1, 2 }, { 0, 1, 3 }, { 0, 1, 4 }, { 0, 2, 3 }, { 0, 2, 4 }, { 0, 3, 4 }, { 1, 2, 3 }, { 1, 2, 4 }, { 1, 3, 4 }, { 2, 3, 4 },
    }
    local middle_options: {{i32}} = { { 0 }, { 1 }, { 2 }, { 0, 1 }, { 0, 2 }, { 1, 2 }, { 0, 1, 2 } }
    for hand_indices in hand_options do
        for middle_indices in middle_options do
            if #hand_indices == #middle_indices then
                local candidate: SwapChoice = proposed_swap(hand, middle, hand_indices, middle_indices)
                if candidate.hand_value > best.hand_value or (candidate.hand_value == best.hand_value and candidate.community_value > best.community_value) then
                    best.hand_indices = candidate.hand_indices
                    best.middle_indices = candidate.middle_indices
                    best.community_value = candidate.community_value
                    best.hand_value = candidate.hand_value
                end
            end
        end
    end
    if best.hand_value <= baseline then
        best.hand_indices = {}
        best.middle_indices = {}
        best.community_value = rank_three(middle)
    end
    return best
end

function remove_pair(hand: {Card}, first: i32, second: i32): unit
    if first > second then
        table.remove(hand, first)
        table.remove(hand, second)
    else
        table.remove(hand, second)
        table.remove(hand, first)
    end
end

-- The same removal against a hand's parallel marks. Spending two cards shifts
-- every slot above them down, and the marks have to shift with them or they
-- start describing the wrong cards.
function remove_pair_known(known: {bool}, first: i32, second: i32): unit
    if first > second then
        table.remove(known, first)
        table.remove(known, second)
    else
        table.remove(known, second)
        table.remove(known, first)
    end
end

function State:reveal_middle(): unit
    self.middle = { draw(self.deck), draw(self.deck), draw(self.deck) }
end

-- Reorder the player's relics without touching what they are: sorting is a
-- presentation courtesy, so the watched marks travel with their cards and the
-- deck, wards, and history never notice. by_school groups the fan by school
-- in deck order with strong ranks first; otherwise the whole fan runs
-- strongest rank to weakest, with schools breaking ties. Returns the applied
-- permutation as order[new_slot] = old_slot so the caller can carry its
-- cursor and pending picks across to the relics they were naming.
function State:sort_player_hand(by_school: bool): {i32}
    local order: {i32} = {}
    local keys: {i32} = {}
    for index, card in self.player_hand do
        table.insert(order, index)
        if by_school then
            table.insert(keys, card.suit * 15 + (MAX_RANK - card.rank))
        else
            table.insert(keys, (MAX_RANK - card.rank) * 4 + card.suit)
        end
    end
    -- A tiny selection sort over the parallel slot/key lists: five relics
    -- never justify comparator closures, matching rank_five's fixed network.
    for i = ZERO, #order - TWO do
        local smallest: i32 = i
        for j = i + ONE, #order - ONE do
            if keys[j] < keys[smallest] then smallest = j end
        end
        if smallest ~= i then
            local key: i32 = keys[i]
            keys[i] = keys[smallest]
            keys[smallest] = key
            local slot: i32 = order[i]
            order[i] = order[smallest]
            order[smallest] = slot
        end
    end
    local sorted_hand: {Card} = {}
    local sorted_known: {bool} = {}
    for slot in order do
        table.insert(sorted_hand, self.player_hand[slot])
        table.insert(sorted_known, self.player_known[slot])
    end
    self.player_hand = sorted_hand
    self.player_known = sorted_known
    return order
end

function State:resolve_swap(hand_indices: {i32}, middle_indices: {i32}): unit
    if self.finished or not self.swap_open then return end
    local player_wager: i32 = #hand_indices
    local valid_player_swap: bool = player_wager <= 3 and player_wager <= self.player_points and player_wager == #middle_indices
    if not valid_player_swap then return end

    local computer: SwapChoice = best_swap(self.computer_hand, self.middle)
    local player_community: i32 = 0
    if valid_player_swap then
        player_community = proposed_swap(self.player_hand, self.middle, hand_indices, middle_indices).community_value
    end

    self.player_wager = player_wager
    self.computer_wager = #computer.hand_indices
    self.player_points -= self.player_wager
    self.pot = self.player_wager + self.computer_wager
    self.swap_winner = swap_priority(self.player_wager, player_community, self.computer_wager, computer.community_value)
    self.swap_count = 0
    -- The executed exchange, slot by slot, so the presentation can animate
    -- exactly which relics and wards traded places (the Arch Mage's picks
    -- are otherwise invisible outside this module).
    self.swap_hand_indices = {}
    self.swap_middle_indices = {}
    if self.swap_winner > 0 then
        exchange(self.player_hand, self.middle, hand_indices, middle_indices)
        mark_known(self.player_known, hand_indices)
        self.swap_count = #hand_indices
        self.swap_hand_indices = hand_indices
        self.swap_middle_indices = middle_indices
    elseif self.swap_winner < 0 then
        exchange(self.computer_hand, self.middle, computer.hand_indices, computer.middle_indices)
        mark_known(self.computer_known, computer.hand_indices)
        self.swap_count = #computer.hand_indices
        self.swap_hand_indices = computer.hand_indices
        self.swap_middle_indices = computer.middle_indices
    end
    self.swap_open = false
end

function State:play(first: i32, second: i32): unit
    if self.finished or self.swap_open or first == second or first < 0 or second < 0 or first >= #self.player_hand or second >= #self.player_hand then
        return
    end

    local computer: PairChoice = best_pair(self.computer_hand, self.middle)
    self.last_player_value = value_for_pair(self.player_hand, self.middle, first, second)
    self.last_computer_value = computer.value
    self.last_winner = 0
    local trick_points: i32 = 0
    if self.last_player_value > self.last_computer_value then
        self.player_points += self.round + self.pot
        self.player_tricks += 1
        self.last_winner = 1
        trick_points = self.round + self.pot
    elseif self.last_computer_value > self.last_player_value then
        self.computer_tricks += 1
        self.last_winner = -1
    else
        -- No trick winner means no pot winner; return the player's wager.
        self.player_points += self.player_wager
    end

    table.insert(self.history, {
        round = self.round,
        middle = { self.middle[0], self.middle[1], self.middle[2] },
        -- Resolution runs after the live hands have been compacted and
        -- refilled. Preserve every original slot and its watched mark so
        -- replacement cards do not appear until their deal animation starts.
        player_hand = { self.player_hand[0], self.player_hand[1], self.player_hand[2], self.player_hand[3], self.player_hand[4] },
        computer_hand = { self.computer_hand[0], self.computer_hand[1], self.computer_hand[2], self.computer_hand[3], self.computer_hand[4] },
        player_known = { self.player_known[0], self.player_known[1], self.player_known[2], self.player_known[3], self.player_known[4] },
        computer_known = { self.computer_known[0], self.computer_known[1], self.computer_known[2], self.computer_known[3], self.computer_known[4] },
        player_cards = { self.player_hand[first], self.player_hand[second] },
        computer_cards = { self.computer_hand[computer.first], self.computer_hand[computer.second] },
        -- Hand slots both sides played, so the presentation can resolve the
        -- trick in place on the board after the hands have been refilled.
        player_first = first,
        player_second = second,
        computer_first = computer.first,
        computer_second = computer.second,
        player_value = self.last_player_value,
        computer_value = self.last_computer_value,
        winner = self.last_winner,
        points = trick_points,
        pot = self.pot,
        player_wager = self.player_wager,
        computer_wager = self.computer_wager,
        swap_winner = self.swap_winner,
        swap_count = self.swap_count,
    })

    remove_pair(self.player_hand, first, second)
    remove_pair(self.computer_hand, computer.first, computer.second)
    remove_pair_known(self.player_known, first, second)
    remove_pair_known(self.computer_known, computer.first, computer.second)
    -- Replacements come off the sealed deck, so neither side has seen them.
    for _ = 1, 2 do
        table.insert(self.player_hand, draw(self.deck))
        table.insert(self.computer_hand, draw(self.deck))
        table.insert(self.player_known, false)
        table.insert(self.computer_known, false)
    end

    if self.computer_tricks >= ARCH_MAGE_WINS_TO_END or self.round >= MAX_ROUNDS then
        self.middle = {}
        self.finished = true
    else
        self.round += 1
        self:reveal_middle()
        self.swap_open = true
        self.pot = 0
        self.player_wager = 0
        self.computer_wager = 0
        self.swap_winner = 0
        self.swap_count = 0
        self.swap_hand_indices = {}
        self.swap_middle_indices = {}
    end
end

function new(): State
    local deck: {Card} = make_deck()
    shuffle(deck)
    local state: State = {
        deck = deck,
        player_hand = {},
        computer_hand = {},
        player_known = {},
        computer_known = {},
        middle = {},
        history = {},
        round = 1,
        player_points = 10,
        player_tricks = 0,
        computer_tricks = 0,
        last_player_value = 0,
        last_computer_value = 0,
        last_winner = 0,
        swap_open = true,
        pot = 0,
        player_wager = 0,
        computer_wager = 0,
        swap_winner = 0,
        swap_count = 0,
        swap_hand_indices = {},
        swap_middle_indices = {},
        finished = false,
    }
    for _ = 1, 5 do
        table.insert(state.player_hand, draw(state.deck))
        table.insert(state.computer_hand, draw(state.deck))
        table.insert(state.player_known, false)
        table.insert(state.computer_known, false)
    end
    state:reveal_middle()
    return state
end

function State:reset(): unit
    local fresh: State = new()
    self.deck = fresh.deck
    self.player_hand = fresh.player_hand
    self.computer_hand = fresh.computer_hand
    self.player_known = fresh.player_known
    self.computer_known = fresh.computer_known
    self.middle = fresh.middle
    self.history = fresh.history
    self.round = fresh.round
    self.player_points = fresh.player_points
    self.player_tricks = fresh.player_tricks
    self.computer_tricks = fresh.computer_tricks
    self.last_player_value = fresh.last_player_value
    self.last_computer_value = fresh.last_computer_value
    self.last_winner = fresh.last_winner
    self.swap_open = fresh.swap_open
    self.pot = fresh.pot
    self.player_wager = fresh.player_wager
    self.computer_wager = fresh.computer_wager
    self.swap_winner = fresh.swap_winner
    self.swap_count = fresh.swap_count
    self.swap_hand_indices = fresh.swap_hand_indices
    self.swap_middle_indices = fresh.swap_middle_indices
    self.finished = fresh.finished
end

function rank_name(rank: i32): string
    if rank == 14 then return "A" end
    if rank == 13 then return "K" end
    if rank == 12 then return "Q" end
    if rank == 11 then return "J" end
    return tostring(rank)
end

function card_name(card: Card): string
    local school: string = "Red"
    if card.suit == 1 then school = "Blue"
    elseif card.suit == 2 then school = "Black"
    elseif card.suit == 3 then school = "Green"
    end
    return rank_name(card.rank) .. " of " .. school
end

function category_name(value: i32): string
    local category: i32 = value // 759375
    if category == 8 then return "perfect convergence" end
    if category == 7 then return "fourfold circle" end
    if category == 6 then return "bound trinity" end
    if category == 5 then return "school chorus" end
    if category == 4 then return "arcane sequence" end
    if category == 3 then return "triune seal" end
    if category == 2 then return "twin pacts" end
    if category == 1 then return "bound pair" end
    return "lone spark"
end

function score_component(value: i32, index: i32): i32
    local divisor: i32 = 1
    if index == 0 then divisor = 50625
    elseif index == 1 then divisor = 3375
    elseif index == 2 then divisor = 225
    elseif index == 3 then divisor = 15 end
    local quotient: i32 = value // divisor
    return quotient - (quotient // 15) * 15
end

function made_components_match(value: i32, other_value: i32, count: i32): bool
    for index = 0::i32, count - 1 do
        if score_component(value, index) ~= score_component(other_value, index) then return false end
    end
    return true
end

function formation_cards(cards: {Card}, value: i32): {bool}
    assert(#cards == 5)
    local category: i32 = value // 759375
    if category == 8 or category == 5 or category == 4 then
        return { true, true, true, true, true }
    end
    local made_components: i32 = 1
    if category == 6 or category == 2 then made_components = 2 end
    local marked_ranks: {i32} = {}
    for index = 0::i32, made_components - 1 do
        table.insert(marked_ranks, score_component(value, index))
    end
    local marked: {bool} = {}
    for card in cards do
        local active: bool = false
        for rank in marked_ranks do
            if card.rank == rank then active = true end
        end
        table.insert(marked, active)
    end
    return marked
end

-- Mark the cards that visibly explain why a winning five-card hand won. The
-- made formation is always included; when both hands made the same formation,
-- include kickers through the first score component that breaks the tie.
function scoring_cards(cards: {Card}, value: i32, other_value: i32): {bool}
    assert(#cards == 5)
    local marked_ranks: {i32} = {}
    local category: i32 = value // 759375
    local other_category: i32 = other_value // 759375

    if category == 8 or category == 5 or category == 4 then
        return { true, true, true, true, true }
    end

    local made_components: i32 = 1
    if category == 6 or category == 2 then made_components = 2 end
    if category == 0 then made_components = 0 end
    for index = 0::i32, made_components - 1 do
        table.insert(marked_ranks, score_component(value, index))
    end

    local made_tied: bool = category == other_category and made_components_match(value, other_value, made_components)
    if made_tied then
        local first_kicker: i32 = made_components
        for index = first_kicker, 4::i32 do
            local rank: i32 = score_component(value, index)
            if rank == 0 then break end
            table.insert(marked_ranks, rank)
            if rank ~= score_component(other_value, index) then break end
        end
    end

    local marked: {bool} = {}
    for card in cards do
        local active: bool = false
        for rank in marked_ranks do
            if card.rank == rank then active = true end
        end
        table.insert(marked, active)
    end
    return marked
end

return {
    new = new,
    make_deck = make_deck,
    rank_five = rank_five,
    value_for_pair = value_for_pair,
    best_pair = best_pair,
    rank_three = rank_three,
    swap_priority = swap_priority,
    proposed_swap = proposed_swap,
    best_swap = best_swap,
    card_name = card_name,
    category_name = category_name,
    formation_cards = formation_cards,
    scoring_cards = scoring_cards,
}
