-- Deterministic, DOM-free checks for Poker Tricks.
--
--     cargo run -p waluau-cli -- fixtures/poker-tricks/sim.walu -o sim.wasm

local game = require("./game")

local FIRST_ROUND <const>: i32 = 1
local LAST_ROUND <const>: i32 = 5

function card(rank: i32, suit: i32): game.Card
    return { rank = rank, suit = suit }
end

-- Every major hand category sorts above the category below it.
local straight_flush: i32 = game.rank_five({ card(10, 3), card(11, 3), card(12, 3), card(13, 3), card(14, 3) })
local four_kind: i32 = game.rank_five({ card(9, 0), card(9, 1), card(9, 2), card(9, 3), card(2, 0) })
local full_house: i32 = game.rank_five({ card(8, 0), card(8, 1), card(8, 2), card(4, 0), card(4, 1) })
local flush: i32 = game.rank_five({ card(14, 2), card(10, 2), card(7, 2), card(5, 2), card(2, 2) })
local straight: i32 = game.rank_five({ card(9, 0), card(8, 1), card(7, 2), card(6, 3), card(5, 0) })
local three_kind: i32 = game.rank_five({ card(7, 0), card(7, 1), card(7, 2), card(12, 3), card(2, 0) })
local two_pair: i32 = game.rank_five({ card(14, 0), card(14, 1), card(3, 0), card(3, 1), card(8, 2) })
local one_pair: i32 = game.rank_five({ card(13, 0), card(13, 1), card(10, 0), card(6, 1), card(2, 2) })
local high_card: i32 = game.rank_five({ card(14, 0), card(11, 1), card(8, 0), card(5, 1), card(2, 2) })
assert(straight_flush > four_kind and four_kind > full_house and full_house > flush)
assert(flush > straight and straight > three_kind and three_kind > two_pair)
assert(two_pair > one_pair and one_pair > high_card)

-- Result emphasis includes the made hand and only the kickers needed to break
-- a same-category tie. Here the pair of kings ties and the ace decides it.
local winning_pair_cards: {game.Card} = { card(13, 0), card(13, 1), card(14, 2), card(7, 3), card(4, 0) }
local losing_pair_cards: {game.Card} = { card(13, 2), card(13, 3), card(12, 0), card(7, 1), card(4, 2) }
local winning_pair_value: i32 = game.rank_five(winning_pair_cards)
local losing_pair_value: i32 = game.rank_five(losing_pair_cards)
local pair_marks: {bool} = game.scoring_cards(winning_pair_cards, winning_pair_value, losing_pair_value)
assert(pair_marks[0] and pair_marks[1] and pair_marks[2])
assert(not pair_marks[3] and not pair_marks[4])
local lower_pair_value: i32 = game.rank_five({ card(12, 1), card(12, 2), card(14, 3), card(9, 0), card(8, 1) })
local made_pair_marks: {bool} = game.scoring_cards(winning_pair_cards, winning_pair_value, lower_pair_value)
assert(made_pair_marks[0] and made_pair_marks[1])
assert(not made_pair_marks[2] and not made_pair_marks[3] and not made_pair_marks[4])
local formation_marks: {bool} = game.formation_cards(winning_pair_cards, winning_pair_value)
assert(formation_marks[0] and formation_marks[1])
assert(not formation_marks[2] and not formation_marks[3] and not formation_marks[4])

-- The wheel is a five-high straight, below a six-high straight.
local wheel: i32 = game.rank_five({ card(14, 0), card(2, 1), card(3, 2), card(4, 3), card(5, 0) })
local six_high: i32 = game.rank_five({ card(2, 0), card(3, 1), card(4, 2), card(5, 3), card(6, 0) })
assert(six_high > wheel)

-- Three-card poker ranks equal swap bids, and wager size takes precedence.
local three_straight_flush: i32 = game.rank_three({ card(10, 2), card(11, 2), card(12, 2) })
local three_kind: i32 = game.rank_three({ card(8, 0), card(8, 1), card(8, 2) })
local three_straight: i32 = game.rank_three({ card(4, 0), card(5, 1), card(6, 2) })
local three_flush: i32 = game.rank_three({ card(14, 3), card(9, 3), card(3, 3) })
local three_pair: i32 = game.rank_three({ card(7, 0), card(7, 1), card(2, 2) })
assert(three_straight_flush > three_kind and three_kind > three_straight)
assert(three_straight > three_flush and three_flush > three_pair)
assert(game.swap_priority(3, three_pair, 2, three_straight_flush) == 1)
assert(game.swap_priority(2, three_straight, 2, three_pair) == 1)
assert(game.swap_priority(2, three_pair, 2, three_straight) == -1)

-- When the Arch Mage already holds its best five-card formation, a valid
-- player proposal wins the feint and exchanges cards without consuming deck.
math.randomseed(7)
local swap_state = game.new()
swap_state.middle = { card(10, 0), card(11, 0), card(12, 0) }
swap_state.computer_hand = { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
swap_state:play(0, 1)
assert(#swap_state.history == 0) -- the trick cannot start before swap resolution
local old_hand = swap_state.player_hand[0]
local old_middle = swap_state.middle[0]
local old_deck_size: i32 = #swap_state.deck
swap_state:resolve_swap({ 0 }, { 0 })
assert(not swap_state.swap_open and swap_state.swap_winner == 1 and swap_state.swap_count == 1)
-- The executed exchange is recorded slot by slot for the presentation.
assert(#swap_state.swap_hand_indices == 1 and swap_state.swap_hand_indices[0] == 0)
assert(#swap_state.swap_middle_indices == 1 and swap_state.swap_middle_indices[0] == 0)
assert(swap_state.player_points == 9 and swap_state.pot == 1)
assert(swap_state.player_hand[0].rank == old_middle.rank and swap_state.player_hand[0].suit == old_middle.suit)
assert(swap_state.middle[0].rank == old_hand.rank and swap_state.middle[0].suit == old_hand.suit)
assert(#swap_state.deck == old_deck_size)
swap_state:resolve_swap({ 1 }, { 1 })
assert(swap_state.player_wager == 1 and swap_state.swap_count == 1) -- only one resolution per round

-- Wagers are the number of cards proposed, rather than an independent choice.
local two_card_state = game.new()
two_card_state.middle = { card(10, 0), card(11, 0), card(12, 0) }
two_card_state.computer_hand = { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
two_card_state:resolve_swap({ 0, 1 }, { 0, 1 })
assert(two_card_state.player_wager == 2 and two_card_state.player_points == 8 and two_card_state.pot == 2)

local unaffordable_state = game.new()
unaffordable_state.player_points = 1
unaffordable_state:resolve_swap({ 0, 1 }, { 0, 1 })
assert(unaffordable_state.swap_open and unaffordable_state.player_wager == 0)

-- The Arch Mage has no spark balance limiting its feint. When all five cards
-- in its hand form a convergence, it can move three of them into the wards.
local unlimited_state = game.new()
unlimited_state.computer_hand = { card(10, 0), card(11, 0), card(12, 0), card(13, 0), card(14, 0) }
unlimited_state.middle = { card(2, 1), card(4, 2), card(6, 3) }
local unlimited_swap = game.best_swap(unlimited_state.computer_hand, unlimited_state.middle)
assert(#unlimited_swap.hand_indices == 3 and #unlimited_swap.middle_indices == 3)
unlimited_state:resolve_swap({}, {})
assert(unlimited_state.computer_wager == 3 and unlimited_state.pot == 3)
assert(unlimited_state.swap_winner == -1 and unlimited_state.player_points == 10)

-- With three hearts in the middle, the computer finds the two hearts that
-- complete a flush instead of an unrelated high pair.
local middle: {game.Card} = { card(2, 2), card(7, 2), card(11, 2) }
local hand: {game.Card} = { card(14, 0), card(14, 1), card(5, 2), card(13, 2), card(9, 0) }
local choice = game.best_pair(hand, middle)
assert(choice.first == 2 and choice.second == 3)

function force_player_win(state: game.State): unit
    state.middle = { card(10, 0), card(11, 0), card(12, 0) }
    state.player_hand = { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
    state.computer_hand = { card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2) }
end

function force_computer_win(state: game.State): unit
    state.middle = { card(10, 0), card(11, 0), card(12, 0) }
    state.player_hand = { card(2, 1), card(3, 2), card(4, 3), card(6, 1), card(8, 2) }
    state.computer_hand = { card(13, 0), card(14, 0), card(2, 1), card(4, 2), card(6, 3) }
end

-- Reaching three player wins does not end the run: all five increasingly
-- valuable breaches play out so the player can maximize sparks.
math.randomseed(42)
local state = game.new()
assert(#state.deck == 39 and #state.middle == 3)
assert(state.player_points == 10 and state.swap_open)
for expected_round = FIRST_ROUND, LAST_ROUND do
    assert(state.round == expected_round and not state.finished)
    assert(#state.player_hand == 5 and #state.computer_hand == 5)
    state:resolve_swap({}, {})
    assert(not state.swap_open)
    force_player_win(state)
    state:play(0, 1)
    assert(#state.history == expected_round and state.player_tricks == expected_round)
    local trick = state.history[expected_round - 1]
    assert(trick.round == expected_round and trick.winner == 1)
    assert(trick.pot == trick.player_wager + trick.computer_wager)
    assert(trick.points == expected_round + trick.pot)
    assert(#trick.middle == 3 and #trick.player_cards == 2 and #trick.computer_cards == 2)
    if expected_round < LAST_ROUND then assert(not state.finished) end
end
assert(state.finished and state.player_tricks == 5 and state.computer_tricks == 0)
assert(#state.deck == 7 and #state.middle == 0 and #state.history == 5)
local final_points: i32 = state.player_points
state:play(0, 1)
assert(state.player_points == final_points)

-- The Arch Mage's third round win ends the run immediately, even when fewer
-- than five breaches have been played.
math.randomseed(43)
local loss_state = game.new()
for expected_round = FIRST_ROUND, 3 do
    loss_state:resolve_swap({}, {})
    force_computer_win(loss_state)
    loss_state:play(0, 1)
    local trick = loss_state.history[expected_round - 1]
    assert(trick.winner == -1 and trick.points == 0)
    if expected_round < 3 then assert(not loss_state.finished) end
end
assert(loss_state.finished and loss_state.computer_tricks == 3)
assert(loss_state.player_tricks == 0 and #loss_state.history == 3 and #loss_state.middle == 0)

-- Identical formations cancel: the ward is not held and no relic is taken, so
-- both sides keep their counters and the wager comes back.
function force_stalemate(state: game.State): unit
    state.middle = { card(7, 3), card(2, 3), card(8, 2) }
    state.player_hand = { card(13, 0), card(13, 1), card(4, 0), card(5, 1), card(6, 0) }
    state.computer_hand = { card(13, 2), card(13, 3), card(4, 2), card(5, 3), card(6, 2) }
end

math.randomseed(44)
local tie_state = game.new()
tie_state:resolve_swap({}, {})
force_stalemate(tie_state)
local tie_points: i32 = tie_state.player_points
tie_state:play(0, 1)
assert(tie_state.history[0].winner == 0 and tie_state.history[0].points == 0)
assert(tie_state.player_tricks == 0 and tie_state.computer_tricks == 0)
assert(tie_state.player_points == tie_points and not tie_state.finished)
assert(tie_state.round == 2)

-- Two ward holds plus a stalemate is not three ward holds, so the heist runs
-- on. The HUD used to paint all three of these orbs red, which made a correct
-- run look like it should have ended early.
math.randomseed(45)
local mixed_state = game.new()
for _ = 1, 2 do
    mixed_state:resolve_swap({}, {})
    force_computer_win(mixed_state)
    mixed_state:play(0, 1)
end
mixed_state:resolve_swap({}, {})
force_stalemate(mixed_state)
mixed_state:play(0, 1)
assert(#mixed_state.history == 3 and mixed_state.history[2].winner == 0)
assert(mixed_state.computer_tricks == 2 and mixed_state.player_tricks == 0)
assert(not mixed_state.finished and mixed_state.round == 4)
