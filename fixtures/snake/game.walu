-- Core snake rules: grid state, movement, food, and collisions. No DOM or
-- canvas access in this module, so the rules can be exercised headlessly.

-- The state record alias; render.walu imports it as `game.State`.
export type State = { cols: i32, rows: i32, snake: {{ x: i32, y: i32 }}, dir: { x: i32, y: i32 }, next_dir: { x: i32, y: i32 }, food: { x: i32, y: i32 }, score: i32, alive: bool }

function State.new(cols: i32, rows: i32): State
    local state: State = {
        cols = cols,
        rows = rows,
        snake = {},
        dir = { x = 1, y = 0 },
        next_dir = { x = 1, y = 0 },
        food = { x = 0, y = 0 },
        score = 0,
        alive = true,
    }
    state:reset()
    return state
end

function State:occupied(x: i32, y: i32): bool
    for seg in self.snake do
        if seg.x == x and seg.y == y then
            return true
        end
    end
    return false
end

function State:spawn_food(): unit
    local max_attempts: i32 = self.cols * self.rows
    for _ = 1, max_attempts do
        local fx: i32 = math.random(self.cols) - 1
        local fy: i32 = math.random(self.rows) - 1
        if not self:occupied(fx, fy) then
            self.food.x = fx
            self.food.y = fy
            return
        end
    end
    -- Rejection sampling gave up; the board is (almost) full. Treat it as the
    -- end of the run rather than looping forever.
    self.alive = false
end

function State:reset(): unit
    local cx: i32 = self.cols // 2
    local cy: i32 = self.rows // 2
    -- Head first: the head lives at index 0 and moves right at start.
    self.snake = { { x = cx, y = cy }, { x = cx - 1, y = cy }, { x = cx - 2, y = cy } }
    self.dir.x = 1
    self.dir.y = 0
    self.next_dir.x = 1
    self.next_dir.y = 0
    self.score = 0
    self.alive = true
    self:spawn_food()
end

-- Queue a direction change for the next tick, ignoring 180-degree reversals.
function State:turn(dx: i32, dy: i32): unit
    if dx == -self.dir.x and dy == -self.dir.y then
        return
    end
    self.next_dir.x = dx
    self.next_dir.y = dy
end

-- Advance the game by one tick.
function State:step(): unit
    if not self.alive then
        return
    end

    -- Copy fields instead of `self.dir = self.next_dir`: assigning the
    -- record itself would alias next_dir and let a later turn() rewrite the
    -- direction we are already moving in.
    self.dir.x = self.next_dir.x
    self.dir.y = self.next_dir.y

    local head = self.snake[0]
    local nx: i32 = head.x + self.dir.x
    local ny: i32 = head.y + self.dir.y

    if nx < 0 or nx >= self.cols or ny < 0 or ny >= self.rows then
        self.alive = false
        return
    end

    if self:occupied(nx, ny) then
        self.alive = false
        return
    end

    table.insert(self.snake, 0, { x = nx, y = ny })
    if nx == self.food.x and ny == self.food.y then
        self.score += 1
        self:spawn_food()
    else
        table.remove(self.snake)
    end
end

return {
    new = State.new,
}
