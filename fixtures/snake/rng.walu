-- Deterministic pseudo-random number generator for the snake fixture.
--
-- TODO(waluau-6i00): Waluau's math builtins stop at abs/min/max/sqrt and the
-- rounding family; there is no math.random or math.randomseed. Until the math
-- builtins are externalized (which itself waits on extern overloading,
-- waluau-6kcc) we hand-roll a 31-bit linear congruential generator and thread
-- its state record through every call site.

function next_i32(rng: { seed: i32 }): i32
    rng.seed = (rng.seed * 1103515245 + 12345) % 2147483647
    return rng.seed
end

-- Returns a value in [0, bound).
function next_below(rng: { seed: i32 }, bound: i32): i32
    return next_i32(rng) % bound
end

return {
    next_i32 = next_i32,
    next_below = next_below,
}
