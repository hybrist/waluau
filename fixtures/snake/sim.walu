-- Headless, DOM-free sanity harness for the snake rules. This entry never
-- touches the canvas or DOM externs, so it can be compiled and executed in
-- any wasm host to check game.walu behavior deterministically (food
-- placement is pinned by the math.randomseed(42) call below).
--
--     cargo run -p waluau-cli -- fixtures/snake/sim.walu -o sim.wasm
local game = require("./game")

-- Seed the host PRNG so food placement (the only randomness in the rules)
-- is reproducible across runs.
math.randomseed(42)

local state = game.new(9, 9)
assert(state.alive)
assert(state.score == 0)

-- The snake starts as three segments with the head at the grid center,
-- moving right.
assert(#state.snake == 3)
local head = state.snake[0]
assert(head.x == 4 and head.y == 4)

-- Food never spawns on top of the snake.
local food = state.food
assert(food.x >= 0 and food.x < 9)
assert(food.y >= 0 and food.y < 9)

state:step()
state:step()
assert(state.alive)

-- Steer down and walk into the bottom wall: the run must end.
state:turn(0, 1)
for _ = 1, 9 do
    state:step()
end
assert(not state.alive)

-- Stepping a dead game is a no-op.
state:step()
assert(not state.alive)

-- Restart brings the board back to the initial shape.
state:reset()
assert(state.alive)
assert(state.score == 0)
assert(#state.snake == 3)

-- A 180-degree reversal is ignored: moving right, turning left must not
-- apply, so the next step still moves the head to the right.
state:turn(-1, 0)
state:step()
local reset_head = state.snake[0]
assert(reset_head.x == 5 and reset_head.y == 4)
