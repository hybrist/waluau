-- Engine Graphics rendering for Snake. This module never touches the DOM:
-- rectangles, circles, and text are submitted to the engine's GPU renderer.

local graphics_module = require("../../engine/graphics")
local game = require("./game")

type Graphics = graphics_module.Graphics
type State = game.State

local CELL_SIZE <const>: f64 = 16.0

function cell_px(v: i32): f64
    return v::f64 * CELL_SIZE
end

function draw(graphics: Graphics, state: State): unit
    local width: f64 = cell_px(state.cols)
    local height: f64 = cell_px(state.rows)

    graphics:clear("#0f172a")

    graphics:set_color("#f8fafc")
    graphics:set_line_width(2.0)
    graphics:stroke_rectangle(1.0, 1.0, width - 2.0, height - 2.0)

    graphics:set_color("#dc2626")
    graphics:fill_circle(
        cell_px(state.food.x) + CELL_SIZE / 2.0,
        cell_px(state.food.y) + CELL_SIZE / 2.0,
        CELL_SIZE / 2.0 - 2.0
    )

    for i, segment in state.snake do
        if i == 0 then
            graphics:set_color("#4ade80")
        else
            graphics:set_color("#16a34a")
        end
        graphics:fill_rectangle(
            cell_px(segment.x) + 1.0,
            cell_px(segment.y) + 1.0,
            CELL_SIZE - 2.0,
            CELL_SIZE - 2.0
        )
    end

    graphics:set_color("#f8fafc")
    graphics:set_font("12px monospace")
    graphics:print("Score " .. tostring(state.score), 6.0, 14.0)

    if not state.alive then
        graphics:set_font("20px monospace")
        graphics:print("GAME OVER", width / 2.0 - 54.0, height / 2.0 - 4.0)
        graphics:set_font("12px monospace")
        graphics:print("press R", width / 2.0 - 25.0, height / 2.0 + 14.0)
    end
end

return {
    draw = draw,
}
