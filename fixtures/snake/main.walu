-- Snake, rendered into a <canvas> by Waluau. Entry point: builds the DOM
-- shell, wires input, and drives the game loop off requestAnimationFrame.

local game = require("./game")
local render = require("./render")
local window = require("dom:window")

function make_button(document: Document, id: string, label: string): Element
    local button: Element = document:create_element("button")
    button.id = id
    button.class_name = "snake-button rounded-md bg-slate-700 px-3 py-2 text-sm font-medium text-white hover:bg-slate-600"
    button:set_attribute("type", "button")
    button.text_content = label
    return button
end

function install_snake(): unit
    local document: Document = window.document
    local body: HTMLElement = document.body

    local existing_root: Element? = document:get_element_by_id("app")
    if existing_root ~= nil then
        body:remove_child(existing_root)
    end

    local root: Element = document:create_element("div")
    root.id = "app"
    root.class_name = "flex flex-col items-center gap-3 bg-slate-950 p-4 text-slate-100"
    body:append_child(root)

    local heading: Element = document:create_element("h1")
    heading.class_name = "text-lg font-semibold"
    heading.text_content = "Waluau Snake"
    root:append_child(heading)

    local cols: i32 = 21
    local rows: i32 = 21

    local element: Element = document:create_element("canvas")
    element.id = "snake-canvas"
    root:append_child(element)

    if HTMLCanvasElement(canvas) = element then
        local width_px: f64 = render.CELL_SIZE * cols::f64
        local height_px: f64 = render.CELL_SIZE * rows::f64
        -- 336 = 21 cols/rows * 16px cells (render.CELL_SIZE); the width/
        -- height properties are u32 so the literal is spelled out here.
        canvas.width = 336
        canvas.height = 336
        local style: CSSStyleProperties = canvas.style
        style:setProperty("width", tostring(width_px) .. "px")
        style:setProperty("height", tostring(height_px) .. "px")
        -- The playfield backdrop: render.walu clears the canvas to transparent
        -- pixels each frame, so plain CSS background-color on the element
        -- shows through as the board color.
        style:setProperty("background-color", "#0f172a")
        style:setProperty("image-rendering", "pixelated")

        local context: CanvasRenderingContext2D? = canvas:get_context("2d")
        assert(context ~= nil)
        local ctx: CanvasRenderingContext2D = context::CanvasRenderingContext2D

        local state = game.new(cols, rows)

        -- Input: arrow keys / WASD via a document-level "keydown" listener
        -- (the Event is downcast to KeyboardEvent to read .key), plus an
        -- on-screen d-pad for pointer/touch play.
        local controls: Element = document:create_element("div")
        controls.id = "snake-controls"
        controls.class_name = "flex gap-2"
        root:append_child(controls)

        local function handle_control_event(event: Event): unit
            if event.type == "click" then
                if Element(target) = event.target then
                    if target.id == "snake-up" then
                        game.turn(state, 0, -1)
                    elseif target.id == "snake-down" then
                        game.turn(state, 0, 1)
                    elseif target.id == "snake-left" then
                        game.turn(state, -1, 0)
                    elseif target.id == "snake-right" then
                        game.turn(state, 1, 0)
                    elseif target.id == "snake-restart" then
                        game.reset(state)
                    end
                end
            end
        end

        local button_defs: {{ id: string, label: string }} = {
            { id = "snake-up", label = "Up" },
            { id = "snake-down", label = "Down" },
            { id = "snake-left", label = "Left" },
            { id = "snake-right", label = "Right" },
            { id = "snake-restart", label = "Restart" },
        }
        for def in button_defs do
            local button: Element = make_button(document, def.id, def.label)
            button:add_event_listener("click", handle_control_event)
            controls:append_child(button)
        end

        document:add_event_listener("keydown", function(event: Event): unit
            if KeyboardEvent(kev) = event then
                local key: string = kev.key
                if key == "ArrowUp" or key == "w" then
                    game.turn(state, 0, -1)
                elseif key == "ArrowDown" or key == "s" then
                    game.turn(state, 0, 1)
                elseif key == "ArrowLeft" or key == "a" then
                    game.turn(state, -1, 0)
                elseif key == "ArrowRight" or key == "d" then
                    game.turn(state, 1, 0)
                elseif key == "r" then
                    game.reset(state)
                end
            end
        end)

        -- Game loop: a self-rescheduling requestAnimationFrame callback that
        -- steps the game once per fixed tick interval.
        local tick_ms: f64 = 140.0
        local started: bool = false
        local last_step: f64 = 0.0
        local function frame(timestamp: f64): unit
            if not started then
                started = true
                -- First frame: seed the PRNG from the timestamp so runs differ.
                math.randomseed(timestamp)
                last_step = timestamp
            elseif timestamp - last_step >= tick_ms then
                last_step = timestamp
                game.step(state)
                render.draw(ctx, state)
            end
            window:requestAnimationFrame(frame)
        end
        window:requestAnimationFrame(frame)

        -- Paint the initial board before the first tick fires.
        render.draw(ctx, state)
    else
        error("document.create_element(\"canvas\") did not return an HTMLCanvasElement")
    end
end

install_snake()
