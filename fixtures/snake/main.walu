-- Snake hosted by the 2D game engine. Game code owns only rules and drawing;
-- the engine owns the DOM, WebGL canvas, input events, and fixed-step loop.
local engine = require("../../engine/browser")
local input_module = require("../../engine/input")
local graphics_module = require("../../engine/graphics")
local game = require("./game")
local render = require("./render")

local COLS <const>: i32 = 21
local ROWS <const>: i32 = 21
local BOARD_SIZE <const>: u32 = 336

function install_snake(): unit
    local state = game.new(COLS, ROWS)

    local function load(): unit
        -- TODO(waluau-qr53): Seed from an engine entropy service once games
        -- can vary runs without reaching through the platform abstraction.
        math.randomseed(42)
        state:reset()
    end

    local function update(dt: f64, input: input_module.Input): unit
        state:step()
    end

    local function draw(graphics: graphics_module.Graphics, alpha: f64): unit
        render.draw(graphics, state)
    end

    local function keypressed(key: string): unit
        if key == "ArrowUp" or key == "w" then
            state:turn(0, -1)
        elseif key == "ArrowDown" or key == "s" then
            state:turn(0, 1)
        elseif key == "ArrowLeft" or key == "a" then
            state:turn(-1, 0)
        elseif key == "ArrowRight" or key == "d" then
            state:turn(1, 0)
        elseif key == "r" then
            state:reset()
        end
    end

    local function keyreleased(key: string): unit
    -- Required by the initial engine API; Snake only uses key presses.
    end

    -- TODO(waluau-chsb): Restore touch/on-screen controls when the engine
    -- exposes pointer and touch input without requiring DOM access here.
    engine.start(
        {
            title = "Waluau Snake",
            width = BOARD_SIZE,
            height = BOARD_SIZE,
            update_hz = 1000.0 / 140.0,
            max_frame_seconds = 0.28,
            background = "#0f172a"
        },
        {
            load = load,
            update = update,
            draw = draw,
            keypressed = keypressed,
            keyreleased = keyreleased,
            mousepressed = nil,
            mousereleased = nil,
            mousemoved = nil
        }
    )
end

install_snake()
