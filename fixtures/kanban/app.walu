-- Client-side Kanban demo for the playground DOM output.
-- Waluau owns DOM rendering, browser events, filtering, and localStorage
-- persistence through deterministic string fields.

function install_kanban(_run_once: i32): unit
    local window = require("dom:window")
    local document: Document = window.document
    local storage: Storage = window.local_storage
    local body: HTMLElement = document.body

    local existing_root: Element? = document:get_element_by_id("app")
    if existing_root ~= nil then
        body:remove_child(existing_root)
    end

    local root: Element = document:create_element("div")
    root.id = "app"
    body:append_child(root)

    local shell: Element = document:create_element("div")
    shell.class_name = "flex flex-col bg-slate-100 text-slate-950"
    root:append_child(shell)

    local header: Element = document:create_element("header")
    header.class_name = "flex flex-col gap-3 border-b border-slate-200 bg-white px-6 py-4 md:flex-row md:items-center md:justify-between"
    shell:append_child(header)

    local title_group: Element = document:create_element("div")
    title_group.class_name = "space-y-1"
    header:append_child(title_group)

    local heading: Element = document:create_element("h1")
    heading.class_name = "text-xl font-semibold text-slate-950"
    heading.text_content = "Waluau Kanban"
    title_group:append_child(heading)

    local subtitle: Element = document:create_element("p")
    subtitle.class_name = "text-sm text-slate-600"
    subtitle.text_content = "Client-side board rendered, filtered, and persisted by Waluau"
    title_group:append_child(subtitle)

    local actions: Element = document:create_element("div")
    actions.class_name = "flex flex-col gap-2 md:flex-row"
    header:append_child(actions)

    local filter_input: Element = document:create_element("input")
    filter_input.id = "kanban-filter"
    filter_input.class_name = "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 outline-none focus:border-teal-600"
    filter_input:set_attribute("placeholder", "Filter text or tag")
    actions:append_child(filter_input)

    local add_button: Element = document:create_element("button")
    add_button.id = "kanban-add-card"
    add_button.class_name = "rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800"
    add_button:set_attribute("type", "button")
    add_button.text_content = "Add card"
    actions:append_child(add_button)

    local board: Element = document:create_element("main")
    board.id = "kanban-board"
    board.class_name = "grid grid-cols-1 gap-4 p-4 md:grid-cols-3"
    shell:append_child(board)

    local backlog: Element = document:create_element("section")
    backlog.class_name = "kanban-column flex flex-col rounded-md border border-slate-200 bg-slate-50"
    backlog:set_attribute("data-column", "backlog")
    local backlog_header: Element = document:create_element("div")
    backlog_header.class_name = "border-b border-slate-200 px-4 py-3"
    local backlog_title: Element = document:create_element("h2")
    backlog_title.class_name = "text-sm font-semibold text-slate-900"
    backlog_title.text_content = "Backlog"
    backlog_header:append_child(backlog_title)
    backlog:append_child(backlog_header)
    local backlog_list: Element = document:create_element("div")
    backlog_list.id = "kanban-backlog-list"
    backlog_list.class_name = "flex flex-col gap-3 p-3"
    backlog:append_child(backlog_list)
    board:append_child(backlog)

    local doing: Element = document:create_element("section")
    doing.class_name = "kanban-column flex flex-col rounded-md border border-slate-200 bg-slate-50"
    doing:set_attribute("data-column", "doing")
    local doing_header: Element = document:create_element("div")
    doing_header.class_name = "border-b border-slate-200 px-4 py-3"
    local doing_title: Element = document:create_element("h2")
    doing_title.class_name = "text-sm font-semibold text-slate-900"
    doing_title.text_content = "Doing"
    doing_header:append_child(doing_title)
    doing:append_child(doing_header)
    local doing_list: Element = document:create_element("div")
    doing_list.id = "kanban-doing-list"
    doing_list.class_name = "flex flex-col gap-3 p-3"
    doing:append_child(doing_list)
    board:append_child(doing)

    local done: Element = document:create_element("section")
    done.class_name = "kanban-column flex flex-col rounded-md border border-slate-200 bg-slate-50"
    done:set_attribute("data-column", "done")
    local done_header: Element = document:create_element("div")
    done_header.class_name = "border-b border-slate-200 px-4 py-3"
    local done_title: Element = document:create_element("h2")
    done_title.class_name = "text-sm font-semibold text-slate-900"
    done_title.text_content = "Done"
    done_header:append_child(done_title)
    done:append_child(done_header)
    local done_list: Element = document:create_element("div")
    done_list.id = "kanban-done-list"
    done_list.class_name = "flex flex-col gap-3 p-3"
    done:append_child(done_list)
    board:append_child(done)

    local activity_panel: Element = document:create_element("aside")
    activity_panel.id = "kanban-activity"
    activity_panel.class_name = "border-t border-slate-200 bg-white px-6 py-3"
    shell:append_child(activity_panel)

    local activity_title: Element = document:create_element("h2")
    activity_title.class_name = "text-xs font-semibold uppercase text-slate-500"
    activity_title.text_content = "Activity"
    activity_panel:append_child(activity_title)

    local activity_log: Element = document:create_element("div")
    activity_log.id = "kanban-activity-log"
    activity_log.class_name = "mt-2 flex flex-wrap gap-2"
    activity_panel:append_child(activity_log)

    local saved_activity: string? = storage:get_item("waluau-kanban:activity:0")
    if saved_activity ~= nil then
        activity_log.text_content = saved_activity
    else
        activity_log.text_content = "No activity yet"
    end

    local seed_backlog: Element = document:create_element("article")
    seed_backlog.class_name = "kanban-card rounded-md border border-slate-200 bg-white p-3 shadow-sm"
    seed_backlog:set_attribute("data-card-id", "seed-2")
    seed_backlog:set_attribute("data-status", "backlog")
    seed_backlog.text_content = "Persist board state Store the board in localStorage using Waluau string fields. Medium priority storage"
    backlog_list:append_child(seed_backlog)

    local seed_doing: Element = document:create_element("article")
    seed_doing.class_name = "kanban-card rounded-md border border-slate-200 bg-white p-3 shadow-sm"
    seed_doing:set_attribute("data-card-id", "seed-1")
    seed_doing:set_attribute("data-status", "doing")
    seed_doing.text_content = "Expose DOM callbacks Render cards and respond to browser events from Waluau. High priority dom events"
    doing_list:append_child(seed_doing)

    local seed_done: Element = document:create_element("article")
    seed_done.class_name = "kanban-card rounded-md border border-slate-200 bg-white p-3 shadow-sm"
    seed_done:set_attribute("data-card-id", "seed-3")
    seed_done:set_attribute("data-status", "done")
    seed_done.text_content = "Ship Kanban preset Load this demo from the playground preset toolbar. Low priority demo"
    done_list:append_child(seed_done)

    local editor: Element = document:create_element("article")
    editor.id = "kanban-editor"
    editor.class_name = "rounded-md border border-teal-300 bg-white p-3 shadow-sm"

    local title_input: Element = document:create_element("input")
    title_input.id = "kanban-edit-title"
    title_input.class_name = "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-950"
    title_input:set_attribute("value", "New task")
    editor:append_child(title_input)

    local description_input: Element = document:create_element("textarea")
    description_input.id = "kanban-edit-description"
    description_input.class_name = "mt-2 min-h-24 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-950"
    editor:append_child(description_input)

    local priority_input: Element = document:create_element("input")
    priority_input.id = "kanban-edit-priority"
    priority_input.class_name = "mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-950"
    priority_input:set_attribute("value", "Medium")
    editor:append_child(priority_input)

    local tags_input: Element = document:create_element("input")
    tags_input.id = "kanban-edit-tags"
    tags_input.class_name = "mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-950"
    tags_input:set_attribute("value", "client")
    editor:append_child(tags_input)

    local editor_controls: Element = document:create_element("div")
    editor_controls.class_name = "mt-3 flex justify-end gap-2"
    editor:append_child(editor_controls)

    local save_button: Element = document:create_element("button")
    save_button.id = "kanban-save-card"
    save_button.class_name = "rounded bg-teal-700 px-3 py-2 text-sm font-medium text-white"
    save_button:set_attribute("type", "button")
    save_button.text_content = "Save"
    editor_controls:append_child(save_button)

    local card_node: Element = document:create_element("article")
    card_node.id = "kanban-card-1"
    card_node.class_name = "kanban-card rounded-md border border-slate-200 bg-white p-3 shadow-sm"
    card_node:set_attribute("data-card-id", "card-1")

    local card_controls: Element = document:create_element("div")
    card_controls.class_name = "mt-3 flex justify-between gap-2"

    local edit_button: Element = document:create_element("button")
    edit_button.id = "kanban-edit-card"
    edit_button.class_name = "rounded border border-slate-300 px-2 py-1 text-xs text-slate-700"
    edit_button:set_attribute("type", "button")
    edit_button.text_content = "Edit"
    card_controls:append_child(edit_button)

    local delete_button: Element = document:create_element("button")
    delete_button.id = "kanban-delete-card"
    delete_button.class_name = "rounded border border-rose-200 px-2 py-1 text-xs text-rose-700 hover:bg-rose-50"
    delete_button:set_attribute("type", "button")
    delete_button.text_content = "Delete"
    card_controls:append_child(delete_button)

    local next_button: Element = document:create_element("button")
    next_button.id = "kanban-next-card"
    next_button.class_name = "rounded border border-slate-300 px-2 py-1 text-xs text-slate-700"
    next_button:set_attribute("type", "button")
    next_button.text_content = "Next"
    card_controls:append_child(next_button)

    local editor_visible: bool = false
    local card_visible: bool = false
    local card_status: string = "backlog"
    local card_title: string = ""
    local card_description: string = ""
    local card_priority: string = "Medium"
    local card_tags: string = ""
    local seed_backlog_visible: bool = true
    local seed_doing_visible: bool = true
    local seed_done_visible: bool = true

    local saved_title: string? = storage:get_item("waluau-kanban:card:0:title")
    if saved_title ~= nil then
        local saved_description: string? = storage:get_item("waluau-kanban:card:0:description")
        local saved_priority: string? = storage:get_item("waluau-kanban:card:0:priority")
        local saved_tags: string? = storage:get_item("waluau-kanban:card:0:tags")
        local saved_status: string? = storage:get_item("waluau-kanban:card:0:status")
        card_title = saved_title
        if saved_description ~= nil then
            card_description = saved_description
        end
        if saved_priority ~= nil then
            card_priority = saved_priority
        end
        if saved_tags ~= nil then
            card_tags = saved_tags
        end
        if saved_status ~= nil then
            card_status = saved_status
        end
        card_node:set_attribute("data-status", card_status)
        card_node.text_content = card_title .. " " .. card_description .. " " .. card_priority .. " priority " .. card_tags
        card_node:append_child(card_controls)
        if card_status == "doing" then
            doing_list:append_child(card_node)
        elseif card_status == "done" then
            done_list:append_child(card_node)
        else
            backlog_list:append_child(card_node)
        end
        card_visible = true
    end

    add_button:on_click(function(_event: Event): unit
        if editor_visible == false then
            title_input:set_attribute("value", "New task")
            description_input.text_content = ""
            priority_input:set_attribute("value", "Medium")
            tags_input:set_attribute("value", "client")
            backlog_list:append_child(editor)
            editor_visible = true
        end
    end)

    edit_button:on_click(function(_event: Event): unit
        if editor_visible == false then
            backlog_list:append_child(editor)
            editor_visible = true
        end
    end)

    save_button:on_click(function(_event: Event): unit
        if HTMLInputElement(title) = title_input then
            if HTMLTextAreaElement(description) = description_input then
                if HTMLInputElement(priority) = priority_input then
                    if HTMLInputElement(tags) = tags_input then
                        card_title = title.value
                        card_description = description.value
                        card_priority = priority.value
                        card_tags = tags.value
                        if card_title == "" then
                            card_title = "Untitled card"
                        end
                        if card_priority == "" then
                            card_priority = "Medium"
                        end

                        card_status = "backlog"
                        card_node:set_attribute("data-status", "backlog")
                        card_node.text_content = card_title .. " " .. card_description .. " " .. card_priority .. " priority " .. card_tags
                        card_node:append_child(card_controls)
                        backlog_list:append_child(card_node)
                        card_visible = true

                        storage:set_item("waluau-kanban:card:0:id", "card-1")
                        storage:set_item("waluau-kanban:card:0:title", card_title)
                        storage:set_item("waluau-kanban:card:0:description", card_description)
                        storage:set_item("waluau-kanban:card:0:priority", card_priority)
                        storage:set_item("waluau-kanban:card:0:tags", card_tags)
                        storage:set_item("waluau-kanban:card:0:status", card_status)
                        storage:set_item("waluau-kanban:activity:0", "Updated " .. card_title)
                        activity_log.text_content = "Updated " .. card_title
                    end
                end
            end
        end
    end)

    next_button:on_click(function(_event: Event): unit
        if card_visible then
            if card_status == "backlog" then
                backlog_list:remove_child(card_node)
                card_status = "doing"
                card_node:set_attribute("data-status", "doing")
                doing_list:append_child(card_node)
                storage:set_item("waluau-kanban:card:0:status", "doing")
                storage:set_item("waluau-kanban:activity:0", "Moved " .. card_title .. " to Doing")
                activity_log.text_content = "Moved " .. card_title .. " to Doing"
            elseif card_status == "doing" then
                doing_list:remove_child(card_node)
                card_status = "done"
                card_node:set_attribute("data-status", "done")
                done_list:append_child(card_node)
                storage:set_item("waluau-kanban:card:0:status", "done")
                storage:set_item("waluau-kanban:activity:0", "Moved " .. card_title .. " to Done")
                activity_log.text_content = "Moved " .. card_title .. " to Done"
            end
        end
    end)

    delete_button:on_click(function(_event: Event): unit
        if card_visible then
            if card_status == "doing" then
                doing_list:remove_child(card_node)
            elseif card_status == "done" then
                done_list:remove_child(card_node)
            else
                backlog_list:remove_child(card_node)
            end
            card_visible = false
            storage:remove_item("waluau-kanban:card:0:id")
            storage:remove_item("waluau-kanban:card:0:title")
            storage:remove_item("waluau-kanban:card:0:description")
            storage:remove_item("waluau-kanban:card:0:priority")
            storage:remove_item("waluau-kanban:card:0:tags")
            storage:remove_item("waluau-kanban:card:0:status")
            storage:set_item("waluau-kanban:activity:0", "Deleted " .. card_title)
            activity_log.text_content = "Deleted " .. card_title
        end
    end)

    filter_input:on_input(function(event: Event): unit
        if HTMLInputElement(target) = event.target then
            local value: string = target.value
            if value == "" then
                if seed_backlog_visible == false then
                    backlog_list:append_child(seed_backlog)
                    seed_backlog_visible = true
                end
                if seed_doing_visible == false then
                    doing_list:append_child(seed_doing)
                    seed_doing_visible = true
                end
                if seed_done_visible == false then
                    done_list:append_child(seed_done)
                    seed_done_visible = true
                end
            else
                if seed_backlog_visible then
                    backlog_list:remove_child(seed_backlog)
                    seed_backlog_visible = false
                end
                if seed_doing_visible then
                    doing_list:remove_child(seed_doing)
                    seed_doing_visible = false
                end
                if seed_done_visible then
                    done_list:remove_child(seed_done)
                    seed_done_visible = false
                end
            end
            storage:set_item("waluau-kanban:filter", value)
        end
    end)
end

install_kanban(0::i32)
