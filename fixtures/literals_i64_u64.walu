function return_u64_small(): u64
    local x: u64 = 42
    return x
end

function return_i64_small(): i64
    local x: i64 = 42
    return x
end

function return_u64_max(): u64
    local x: u64 = 18446744073709551615
    return x
end

function return_i64_max(): i64
    local x: i64 = 9223372036854775807
    return x
end
