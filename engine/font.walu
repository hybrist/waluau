-- Built-in 5x7 bitmap font for the GPU text path. Glyph rows are stored as
-- '#'/'.' characters so the data stays reviewable in source; graphics.walu
-- renders set pixels as colored quads. Text is uppercased before lookup, and
-- characters outside the table advance the pen without drawing.
local GLYPH_WIDTH <const>: i32 = 5
local GLYPH_HEIGHT <const>: i32 = 7
-- Every pixel row below is GLYPH_WIDTH characters plus its terminating
-- newline; a glyph is GLYPH_HEIGHT consecutive rows.
local ROW_STRIDE <const>: i32 = 6
local GLYPH_STRIDE <const>: i32 = 42

local GLYPHS <const> = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 /.:,-!?+()'"

-- One glyph per 7 lines, in GLYPHS order (A-Z, 0-9, space, /.:,-!?+()').
local PIXELS <const> = [[
