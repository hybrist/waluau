assert(#PIXELS == #GLYPHS * GLYPH_STRIDE)

-- 0-based glyph slot for a character code, or -1 when the font has no glyph.
function glyph_index(code: i32): i32
    for index = 1::i32, #GLYPHS do
        if string.byte(GLYPHS, index) == code then
            return index - 1
        end
    end
    return -1
end

-- Whether the font pixel at (row, column) of a glyph slot is set.
function pixel(slot: i32, row: i32, column: i32): bool
    local offset: i32 = slot * GLYPH_STRIDE + row * ROW_STRIDE + column
    return string.byte(PIXELS, offset + 1) == 35
end

function width(): i32
    return GLYPH_WIDTH
end

function height(): i32
    return GLYPH_HEIGHT
end

return { width = width, height = height, glyph_index = glyph_index, pixel = pixel }
