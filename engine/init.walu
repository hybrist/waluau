-- Stable aggregate package facade. The linker embeds this module and its
-- subsystem dependencies, so consumers never need repository-relative paths.
local browser = require("waluau:engine/v1/browser")
local input_module = require("waluau:engine/v1/input")
local graphics_module = require("waluau:engine/v1/graphics")
local particles_module = require("waluau:engine/v1/particles")

export type Config = browser.Config
export type Game = browser.Game
export type Session = browser.Session
export type Input = input_module.Input
export type Graphics = graphics_module.Graphics
export type ParticleSystem = particles_module.ParticleSystem
export type ParticleColor = particles_module.Color
export type ParticleQuad = particles_module.Quad

local VERSION <const>: string = "1.6.0"

return {
    VERSION = VERSION,
    start = browser.start,
    -- Particle emitters are a graphics-adjacent subsystem rather than part of
    -- the renderer, so the facade exposes their constructor directly.
    new_particle_system = particles_module.new,
    particle_color = particles_module.color,
    particle_hex = particles_module.hex,
    particle_quad = particles_module.quad
}
