-- Decoded and streaming audio resources, reached through host imports so game
-- code never touches Web Audio directly. Loading is safe to start before a user
-- gesture; play() reports whether playback could be started, allowing a game to
-- retry from its next input callback.
local resources = require("./resources")

declare function game_audio_load_sound(path: string): extern
declare function game_audio_load_stream(path: string): extern
declare function game_audio_unlock(): bool
declare function game_audio_play(handle: i32, looped: bool, volume: f64): bool
declare function game_audio_pause(handle: i32): unit
declare function game_audio_stop(handle: i32): unit
declare function game_audio_is_playing(handle: i32): bool

function load_sound(path: string): extern
    return game_audio_load_sound(path)
end

function finish_sound(handle: i32, path: string): resources.LoadResult
    return resources.from_handle(handle, "sound", path)
end

function await_sound(path: string): resources.LoadResult
    local handle: i32 = coroutine.await_promise(load_sound(path))::i32
    return finish_sound(handle, path)
end

function await_typed_sound(path: string): resources.SoundLoadResult
    local handle: i32 = coroutine.await_promise(load_sound(path))::i32
    return resources.typed_sound_from_handle(handle, path)
end

function load_stream(path: string): extern
    return game_audio_load_stream(path)
end

function finish_stream(handle: i32, path: string): resources.LoadResult
    return resources.from_handle(handle, "stream", path)
end

function await_stream(path: string): resources.LoadResult
    local handle: i32 = coroutine.await_promise(load_stream(path))::i32
    return finish_stream(handle, path)
end

-- Ask the host to resume its audio device from a user-input callback. Browser
-- autoplay policies require this gesture even when decoding completed earlier.
function unlock(): bool
    return game_audio_unlock()
end

function play(resource: resources.Resource, looped: bool, volume: f64): bool
    assert(resource.kind == "sound" or resource.kind == "stream")
    return game_audio_play(resource.handle, looped, volume)
end

function pause(resource: resources.Resource): unit
    assert(resource.kind == "stream")
    game_audio_pause(resource.handle)
end

function stop(resource: resources.Resource): unit
    assert(resource.kind == "sound" or resource.kind == "stream")
    game_audio_stop(resource.handle)
end

function is_playing(resource: resources.Resource): bool
    assert(resource.kind == "sound" or resource.kind == "stream")
    return game_audio_is_playing(resource.handle)
end

function play_sound(resource: resources.SoundResource, looped: bool, volume: f64): bool
    return game_audio_play(resources.sound_handle(resource), looped, volume)
end

function stop_sound(resource: resources.SoundResource): unit
    game_audio_stop(resources.sound_handle(resource))
end

function is_sound_playing(resource: resources.SoundResource): bool
    return game_audio_is_playing(resources.sound_handle(resource))
end

return {
    load_sound = load_sound,
    finish_sound = finish_sound,
    await_sound = await_sound,
    await_typed_sound = await_typed_sound,
    load_stream = load_stream,
    finish_stream = finish_stream,
    await_stream = await_stream,
    unlock = unlock,
    play = play,
    pause = pause,
    stop = stop,
    is_playing = is_playing,
    play_sound = play_sound,
    stop_sound = stop_sound,
    is_sound_playing = is_sound_playing
}
