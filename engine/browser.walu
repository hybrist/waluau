-- The engine's DOM host: owns canvas setup, keyboard events and the animation
-- loop. This module and graphics.walu are the only ones that import DOM
-- externs, which is what keeps game code free of them.
local input_module = require("./input")
local graphics_module = require("./graphics")
local time_module = require("./time")
local window = require("dom:window")

local GAME_ROOT_ID <const>: string = "walua-game"
local GAME_TITLE_ID <const>: string = "walua-game-title"
local GAME_CANVAS_ID <const>: string = "walua-game-canvas"
local SURFACE_HANDOFF_ATTRIBUTE <const>: string = "data-waluau-surface-handoff"
local SURFACE_HOST_ATTRIBUTE <const>: string = "data-waluau-surface-host"
local SURFACE_VERSION_ATTRIBUTE <const>: string = "data-waluau-surface-version"
local SURFACE_GENERATION_ATTRIBUTE <const>: string = "data-waluau-surface-generation"
local SURFACE_VERSION <const>: string = "1"

export type Config = {
    title: string,
    -- The fixed logical viewport. Left out, the engine measures the
    -- browser's available space instead — the natural pairing with
    -- canvas_sizing, where the canvas has no one true size to be given.
    width: u32?,
    height: u32?,
    update_hz: f64,
    max_frame_seconds: f64,
    background: string,
    -- True lets the canvas occupy all space available in the browser and
    -- uses its current CSS dimensions as the game's logical viewport. Games
    -- can then derive semantic placement from that live space. Omitted keeps
    -- the fixed logical viewport above.
    canvas_sizing: bool?,
    -- The id of an element to put the game inside. A game that owns the page
    -- leaves this out and the document body hosts it; a host that already owns
    -- the page — Storybook's preview, a docs page — names its own element, and
    -- the engine then styles only what it mounted.
    mount: string?
}

-- A player-visible snapshot of the active screen. Groups precede their children;
-- keys identify controls across frames. A dialog snapshot contains only that
-- dialog's content. Omit selected for ordinary buttons, set it for toggles.
export type AccessibleItem = {
    key: string,
    kind: "button" | "group" | "text",
    parent: string?,
    label: string,
    description: string?,
    disabled: bool?,
    selected: bool?
}

export type AccessibleState = {
    heading: string,
    status: string,
    items: {AccessibleItem},
    dialog: string?,
    dismiss: string?
}

export type Game = {
    load: () -> unit,
    update: (f64, input_module.Input) -> unit,
    draw: (graphics_module.Graphics, f64) -> unit,
    keypressed: (string) -> unit,
    keyreleased: ((string) -> unit)?,
    -- Every pointing device the DOM reports — mouse, pen, and touch — arrives
    -- through these callbacks, in logical canvas coordinates and with
    -- Love2D-style button numbers (1 = left, 2 = right, 3 = middle); a finger
    -- or a pen tip presses button 1. mousemoved carries the move's delta in
    -- the same space.
    mousepressed: ((f64, f64, i32) -> unit)?,
    mousereleased: ((f64, f64, i32) -> unit)?,
    mousemoved: ((f64, f64, f64, f64) -> unit)?,
    -- The browser renders these as native controls. Activation must validate
    -- current game state; a snapshot can be older than an input event.
    accessibility: (() -> AccessibleState)?,
    accessibility_activate: ((string) -> unit)?,
    accessibility_focus: ((string) -> unit)?
}

-- A running browser game owns animation-frame and DOM listener registrations.
-- Development hot replacement suspends after capturing state so the old Wasm
-- instance no longer receives input or schedules frames. The replacement
-- adopts the marked canvas, preserving its WebGL2 context across instances.
export type Session = {
    stop: () -> unit,
    -- Change the logical viewport of a running game. A host that keeps one
    -- canvas across scenes of different sizes — Storybook's preview moving
    -- between stories — resizes rather than starts over, so GPU resources
    -- built against this renderer stay valid.
    resize: (u32, u32) -> unit,
    -- Stop callbacks and make the mounted canvas available to the next engine
    -- instance. Development hot replacement uses this to retain the DOM canvas
    -- and its WebGL2 context across Wasm modules.
    suspend: () -> unit
}

type Surface = { root: Element, heading: Element, canvas: HTMLCanvasElement, generation: string }

-- Browsers number pointer buttons 0/1/2 = left/middle/right, and a finger or
-- pen tip reports 0 like a left click; game code sees the Love2D-style
-- 1/2/3 = left/right/middle numbering instead.
function mouse_button_number(dom_button: i32): i32
    if dom_button == 0 then
        return 1
    end
    if dom_button == 2 then
        return 2
    end
    if dom_button == 1 then
        return 3
    end
    return dom_button + 1
end

-- Canvas dimensions are device pixels, while CSS dimensions and game
-- coordinates are logical pixels. Keeping those spaces separate avoids the
-- browser upscaling a low-resolution WebGL buffer on high-density displays.
-- DOM test hosts do not perform layout, so fall back to the configured logical
-- size when clientWidth/clientHeight are unavailable.
function sync_canvas_size(
    canvas: HTMLCanvasElement,
    fallback_width: u32,
    fallback_height: u32,
    fluid: bool
): bool
    local inset: i32 = 16
    if fluid then
        inset = 0
    end
    local available_width: f64 = (window.innerWidth - inset)::f64
    local available_height: f64 = (window.innerHeight - inset)::f64
    if available_width < 1.0 then
        available_width = 1.0
    end
    if available_height < 1.0 then
        available_height = 1.0
    end
    local display_width: i32 = math.floor(available_width + 0.5)::i32
    local display_height: i32 = math.floor(available_height + 0.5)::i32
    if not fluid then
        local display_scale: f64 = 1.0
        local width_scale: f64 = available_width / (fallback_width::f64)
        local height_scale: f64 = available_height / (fallback_height::f64)
        if width_scale < display_scale then
            display_scale = width_scale
        end
        if height_scale < display_scale then
            display_scale = height_scale
        end
        display_width = math.floor((fallback_width::f64) * display_scale + 0.5)::i32
        display_height = math.floor((fallback_height::f64) * display_scale + 0.5)::i32
    end
    local css_width: i32 = canvas.clientWidth
    local css_height: i32 = canvas.clientHeight
    if css_width ~= display_width or css_height ~= display_height then
        local style: CSSStyleProperties = canvas.style
        style:setProperty("width", tostring(display_width) .. "px")
        style:setProperty("height", tostring(display_height) .. "px")
        css_width = canvas.clientWidth
        css_height = canvas.clientHeight
    end
    if css_width <= 0 then
        css_width = fallback_width::i32
    end
    if css_height <= 0 then
        css_height = fallback_height::i32
    end

    local pixel_ratio: f64 = window.devicePixelRatio
    if pixel_ratio <= 0.0 then
        pixel_ratio = 1.0
    end
    local pixel_width: u32 = math.floor((css_width::f64) * pixel_ratio + 0.5)::u32
    local pixel_height: u32 = math.floor((css_height::f64) * pixel_ratio + 0.5)::u32
    local changed: bool = canvas.width ~= pixel_width or canvas.height ~= pixel_height
    if changed then
        canvas.width = pixel_width
        canvas.height = pixel_height
    end
    return changed
end

-- A suspended engine instance leaves one versioned surface in the DOM. A
-- replacement claims that exact root and canvas; anything else is an invalid
-- lifecycle transition, which the development host handles with a page reload.
-- Ordinary starts still create their own surface.
function acquire_surface(document: Document, host: Element, host_key: string): Surface
    local previous_root: Element? = document:get_element_by_id(GAME_ROOT_ID)
    if previous_root ~= nil then
        local retained_root: Element = previous_root::Element
        local retained_generation: string? = retained_root:get_attribute(
            SURFACE_GENERATION_ATTRIBUTE
        )
        if retained_root:get_attribute(
            SURFACE_VERSION_ATTRIBUTE
        ) ~= SURFACE_VERSION or retained_generation == nil or retained_root:get_attribute(
            SURFACE_HANDOFF_ATTRIBUTE
        ) ~= retained_generation or retained_root:get_attribute(
            SURFACE_HOST_ATTRIBUTE
        ) ~= host_key then
            error("game engine found an active or incompatible canvas")
        end

        assert(retained_generation ~= nil)
        local generation_text: string = retained_generation::string
        local generation: string = generation_text .. "."

        local retained_heading: Element? = document:query_selector(
            "#" .. GAME_ROOT_ID .. " > #" .. GAME_TITLE_ID
        )
        local retained_element: Element? = document:query_selector(
            "#" .. GAME_ROOT_ID .. " > #" .. GAME_CANVAS_ID
        )
        if retained_heading == nil or retained_element == nil then
            error("game engine could not adopt the suspended canvas")
        end
        assert(retained_heading ~= nil)
        assert(retained_element ~= nil)
        local heading: Element = retained_heading::Element
        local canvas_element: Element = retained_element::Element
        if HTMLCanvasElement(retained_canvas) = canvas_element then
            retained_root:remove_attribute(SURFACE_HANDOFF_ATTRIBUTE)
            retained_root:set_attribute(SURFACE_GENERATION_ATTRIBUTE, generation)
            return {
                root = retained_root,
                heading = heading,
                canvas = retained_canvas,
                generation = generation
            }
        end
        error("game engine suspended surface does not contain a canvas")
    end

    local root: Element = document:create_element("main")
    root.id = GAME_ROOT_ID
    root:set_attribute(SURFACE_HOST_ATTRIBUTE, host_key)
    root:set_attribute(SURFACE_VERSION_ATTRIBUTE, SURFACE_VERSION)
    root:set_attribute(SURFACE_GENERATION_ATTRIBUTE, "1")
    host:append_child(root)

    local heading: Element = document:create_element("h1")
    heading.id = GAME_TITLE_ID
    root:append_child(heading)

    local element: Element = document:create_element("canvas")
    element.id = GAME_CANVAS_ID
    root:append_child(element)
    if HTMLCanvasElement(canvas) = element then
        return { root = root, heading = heading, canvas = canvas, generation = "1" }
    end
    error("game engine could not create a WebGL2 canvas")
    -- `error` never returns at runtime; this unreachable value keeps the
    -- current static return checker aware that every path returns a Surface.
    return acquire_surface(document, host, host_key)
end

type AccessibleNode = {
    key: string,
    kind: "button" | "group" | "text",
    element: Element,
    label: Element?,
    click: (Event) -> unit,
    focus: (Event) -> unit
}

type AccessiblePanel = { refresh: () -> unit, dispose: () -> unit }

function focus_element(element: Element): unit
    if HTMLElement(html) = element then
        html:focus_element()
    end
end

function element_within(element: Element?, ancestor: Element): bool
    if element ~= nil then
        local current: Element = element::Element
        if current == ancestor then
            return true
        end
        return element_within(current.parentElement, ancestor)
    end
    return false
end

type InertElement = { element: Element, value: string? }

function inert_siblings(sibling: Node?, branch: Element, saved: {InertElement}): unit
    if sibling ~= nil then
        local child: Node = sibling::Node
        if Element(element) = child then
            if element ~= branch then
                table.insert(saved, { element = element, value = element:get_attribute("inert") })
                element:set_attribute("inert", "")
            end
        end
        inert_siblings(child.nextSibling, branch, saved)
    end
end

function inert_outside(branch: Element, body: Element, saved: {InertElement}): unit
    local parent: Element? = branch.parentElement
    if parent ~= nil then
        local container: Element = parent::Element
        inert_siblings(container.firstChild, branch, saved)
        if container ~= body then
            inert_outside(container, body, saved)
        end
    end
end

function accessible_attribute(element: Element, name: string, value: string): unit
    if element:get_attribute(name) ~= value then
        element:set_attribute(name, value)
    end
end

function remove_accessible_attribute(element: Element, name: string): unit
    if element:get_attribute(name) ~= nil then
        element:remove_attribute(name)
    end
end

-- Keep DOM identities across animation frames: replacing buttons would discard
-- keyboard focus and a screen reader's place. Only changed text is announced.
function accessible_panel(
    document: Document,
    root: Element,
    canvas: HTMLCanvasElement,
    game: Game
): AccessiblePanel
    local read_state = game.accessibility
    if read_state == nil then
        return {
            refresh = function(): unit
            end,
            dispose = function(): unit
            end
        }
    end
    local snapshot: () -> AccessibleState = read_state::(() -> AccessibleState)
    local wrapper: Element = document:create_element("section")
    accessible_attribute(wrapper, "aria-label", "Game text controls")
    accessible_attribute(
        wrapper,
        "style",
        "position:fixed;z-index:20;left:8px;top:8px;max-width:calc(100vw - 16px);width:max-content;max-height:calc(100dvh - 16px);overflow:auto;border:1px solid #64748b;border-radius:8px;background:#0f172a;color:#f8fafc;padding:8px;box-sizing:border-box;font:16px/1.5 system-ui;"
    )
    root:append_child(wrapper)
    local toggle: Element = document:create_element("button")
    toggle.text_content = "Text controls"
    accessible_attribute(toggle, "type", "button")
    accessible_attribute(toggle, "aria-expanded", "false")
    accessible_attribute(toggle, "aria-controls", "walua-text-controls")
    accessible_attribute(toggle, "style", "font:inherit;min-height:44px;padding:8px 12px;")
    wrapper:append_child(toggle)
    local panel: Element = document:create_element("div")
    panel.id = "walua-text-controls"
    panel:set_attribute("hidden", "")
    wrapper:append_child(panel)
    -- One passive reading surface stays in the accessibility tree while the
    -- action panel is closed. It never takes focus or opens a modal.
    local feedback: Element = document:create_element("section")
    feedback:set_attribute("aria-label", "Game feedback")
    wrapper:append_child(feedback)
    local title: Element = document:create_element("h2")
    title.id = "walua-text-controls-title"
    title:set_attribute("tabindex", "-1")
    feedback:append_child(title)
    local status: Element = document:create_element("p")
    status:set_attribute("role", "status")
    status:set_attribute("aria-atomic", "true")
    feedback:append_child(status)
    local observations: Element = document:create_element("div")
    feedback:append_child(observations)
    accessible_attribute(
        feedback,
        "style",
        "position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;"
    )
    local content: Element = document:create_element("div")
    panel:append_child(content)
    local nodes: {AccessibleNode} = {}
    local state: AccessibleState = snapshot()
    local expanded: bool = false
    local disposed: bool = false
    local previous_dialog: string = ""
    local inert_elements: {InertElement} = {}
    local modal_active: bool = false
    local focus_history: {{ scope: string, key: string }} = {}

    local function find_node(key: string): Element?
        for _, node in nodes do
            if node.key == key then
                return node.element
            end
        end
        return nil
    end
    local function set_modal(): unit
        local modal: bool = expanded and state.dialog ~= nil
        if modal ~= modal_active then
            if modal then
                inert_outside(wrapper, document.body, inert_elements)
            else
                for _, saved in inert_elements do
                    if saved.value ~= nil then
                        accessible_attribute(saved.element, "inert", saved.value::string)
                    else
                        remove_accessible_attribute(saved.element, "inert")
                    end
                end
                inert_elements = {}
            end
            modal_active = modal
        end
        if modal then
            accessible_attribute(wrapper, "role", "dialog")
            accessible_attribute(wrapper, "aria-modal", "true")
            accessible_attribute(wrapper, "aria-labelledby", title.id)
        else
            remove_accessible_attribute(wrapper, "role")
            remove_accessible_attribute(wrapper, "aria-modal")
            remove_accessible_attribute(wrapper, "aria-labelledby")
        end
    end
    local function set_expanded(value: bool): unit
        expanded = value
        if expanded then
            panel:insertBefore(feedback, content)
            remove_accessible_attribute(feedback, "style")
            accessible_attribute(observations, "hidden", "")
            accessible_attribute(
                wrapper,
                "style",
                "position:fixed;z-index:20;left:8px;top:8px;width:360px;max-width:calc(100vw - 16px);max-height:calc(100dvh - 16px);overflow:auto;border:1px solid #64748b;border-radius:8px;background:#0f172a;color:#f8fafc;padding:8px;box-sizing:border-box;font:16px/1.5 system-ui;"
            )
            panel:remove_attribute("hidden")
            accessible_attribute(toggle, "aria-expanded", "true")
        else
            wrapper:append_child(feedback)
            remove_accessible_attribute(observations, "hidden")
            accessible_attribute(
                feedback,
                "style",
                "position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;"
            )
            accessible_attribute(
                wrapper,
                "style",
                "position:fixed;z-index:20;left:8px;top:8px;width:max-content;max-width:calc(100vw - 16px);border:1px solid #64748b;border-radius:8px;background:#0f172a;color:#f8fafc;padding:4px;font:16px/1.5 system-ui;"
            )
            panel:set_attribute("hidden", "")
            accessible_attribute(toggle, "aria-expanded", "false")
            focus_element(toggle)
        end
        set_modal()
    end
    local function on_toggle(event: Event): unit
        set_expanded(not expanded)
    end
    toggle:add_event_listener("click", on_toggle)

    local function new_node(item: AccessibleItem): AccessibleNode
        local tag: string = "p"
        if item.kind == "button" then
            tag = "button"
        end
        if item.kind == "group" then
            tag = "div"
        end
        local element: Element = document:create_element(tag)
        local key: string = item.key
        local label: Element? = nil
        accessible_attribute(element, "data-game-control", key)
        if item.kind == "button" then
            accessible_attribute(element, "type", "button")
            accessible_attribute(
                element,
                "style",
                "font:inherit;display:block;min-height:44px;width:100%;margin:6px 0;padding:8px;text-align:left;white-space:normal;"
            )
        elseif item.kind == "group" then
            local heading: Element = document:create_element("h3")
            element:append_child(heading)
            label = heading
            accessible_attribute(element, "role", "group")
            accessible_attribute(
                element,
                "style",
                "border-top:1px solid #64748b;margin-top:12px;padding-top:8px;"
            )
        end
        local function on_click(event: Event): unit
            event:stopPropagation()
            local activate = game.accessibility_activate
            if disposed then
                return
            end
            if activate ~= nil then
                activate(key)
            end
        end
        local function on_focus(event: Event): unit
            local focus = game.accessibility_focus
            if disposed then
                return
            end
            if focus ~= nil then
                focus(key)
            end
        end
        element:add_event_listener("click", on_click)
        element:add_event_listener("focus", on_focus)
        return {
            key = key,
            kind = item.kind,
            element = element,
            label = label,
            click = on_click,
            focus = on_focus
        }
    end
    local function retain_node(item: AccessibleItem): AccessibleNode
        for _, node in nodes do
            if node.key == item.key and node.kind == item.kind then
                return node
            end
        end
        return new_node(item)
    end
    local function remove_node(node: AccessibleNode): unit
        node.element:remove_event_listener("click", node.click)
        node.element:remove_event_listener("focus", node.focus)
        local parent = node.element.parentElement
        if parent ~= nil then
            parent:remove_child(node.element)
        end
    end
    local function refresh(): unit
        if disposed then
            return
        end
        state = snapshot()
        local dialog: string = state.dialog or ""
        local focused: Element? = document.activeElement
        local was_inside: bool = element_within(focused, panel)
        if dialog ~= previous_dialog and was_inside then
            local focused_key: string = ""
            for _, node in nodes do
                if node.element == focused then
                    focused_key = node.key
                end
            end
            local saved: bool = false
            for _, entry in focus_history do
                if entry.scope == previous_dialog then
                    entry.key = focused_key
                    saved = true
                end
            end
            if not saved then
                table.insert(focus_history, { scope = previous_dialog, key = focused_key })
            end
        end
        if title.text_content ~= state.heading then
            title.text_content = state.heading
        end
        if status.text_content ~= state.status then
            status.text_content = state.status
        end
        local reading: {string} = {}
        for _, item in state.items do
            if item.kind == "text" then
                table.insert(reading, item.label)
            end
        end
        local reading_text: string = table.concat(reading, " ")
        if observations.text_content ~= reading_text then
            observations.text_content = reading_text
        end
        local next_nodes: {AccessibleNode} = {}
        for _, item in state.items do
            local node: AccessibleNode = retain_node(item)
            local element: Element = node.element
            local description: string = item.description or ""
            if item.kind == "group" then
                accessible_attribute(element, "aria-label", item.label)
                local heading: Element? = node.label
                if heading ~= nil then
                    if heading.text_content ~= item.label then
                        heading.text_content = item.label
                    end
                end
            else
                local text: string = item.label
                if description ~= "" then
                    text = text .. " — " .. description
                end
                if element.text_content ~= text then
                    element.text_content = text
                end
                if item.kind == "button" then
                    accessible_attribute(element, "aria-label", item.label)
                end
            end
            if item.disabled == true then
                accessible_attribute(element, "disabled", "")
            else
                remove_accessible_attribute(element, "disabled")
            end
            if item.kind == "button" then
                local colors: string = "background:#f8fafc;color:#0f172a;border:2px solid #cbd5e1;"
                if item.selected == true then
                    colors = "background:#164e63;color:#fff;border:2px solid #22d3ee;"
                end
                if item.disabled == true then
                    colors = "background:#334155;color:#cbd5e1;border:2px solid #64748b;"
                end
                accessible_attribute(
                    element,
                    "style",
                    "font:inherit;display:block;min-height:44px;width:100%;margin:6px 0;padding:8px;text-align:left;white-space:normal;" .. colors
                )
            end
            if item.selected ~= nil then
                accessible_attribute(element, "aria-pressed", tostring(item.selected::bool))
            else
                remove_accessible_attribute(element, "aria-pressed")
            end
            if description ~= "" then
                accessible_attribute(element, "aria-description", description)
            else
                remove_accessible_attribute(element, "aria-description")
            end
            local parent: Element = content
            if item.parent ~= nil then
                for _, earlier in next_nodes do
                    if earlier.key == item.parent then
                        parent = earlier.element
                    end
                end
            end
            -- Move only controls whose relative order changed. Appending each
            -- frame would discard native focus even for unchanged controls.
            local preceding: Element? = nil
            for _, earlier in next_nodes do
                if earlier.element.parentElement == parent then
                    preceding = earlier.element
                end
            end
            local insertion: Node? = parent.firstChild
            if parent ~= content then
                for _, earlier in next_nodes do
                    if earlier.element == parent then
                        local group_heading: Element? = earlier.label
                        if group_heading ~= nil then
                            insertion = group_heading.nextSibling
                        end
                    end
                end
            end
            if preceding ~= nil then
                insertion = (preceding::Element).nextSibling
            end
            if insertion ~= element then
                parent:insertBefore(element, insertion)
            end
            table.insert(next_nodes, node)
        end
        for _, node in nodes do
            local keep: bool = false
            for _, next_node in next_nodes do
                if next_node.element == node.element then
                    keep = true
                end
            end
            if not keep then
                remove_node(node)
            end
        end
        nodes = next_nodes
        set_modal()
        if expanded and dialog ~= previous_dialog then
            local restore_key: string = ""
            for _, entry in focus_history do
                if entry.scope == dialog then
                    restore_key = entry.key
                end
            end
            local restore: Element? = find_node(restore_key)
            if restore ~= nil then
                focus_element(restore::Element)
            else
                focus_element(title)
            end
        elseif expanded and was_inside then
            if focused ~= nil then
                if not focused.isConnected or focused:get_attribute("disabled") ~= nil then
                    focus_element(title)
                elseif document.activeElement ~= focused then
                    focus_element(focused)
                end
            end
        end
        previous_dialog = dialog
    end
    local function on_key(event: Event): unit
        if KeyboardEvent(key) = event then
            if key.key == "Escape" and expanded then
                event:preventDefault()
                local activate = game.accessibility_activate
                local dismiss: string? = state.dismiss
                if dismiss ~= nil then
                    if activate ~= nil then
                        activate(dismiss)
                    end
                else
                    set_expanded(false)
                end
            elseif key.key == "Tab" and expanded and state.dialog ~= nil then
                local buttons: {Element} = {toggle}
                for _, node in nodes do
                    if node.kind == "button" and node.element:get_attribute("disabled") == nil then
                        table.insert(buttons, node.element)
                    end
                end
                local active: Element? = document.activeElement
                if key.shiftKey and (active == buttons[1] or active == title) then
                    event:preventDefault()
                    focus_element(buttons[#buttons])
                elseif not key.shiftKey and active == buttons[#buttons] then
                    event:preventDefault()
                    focus_element(buttons[1])
                end
            end
            event:stopPropagation()
        end
    end
    wrapper:add_event_listener("keydown", on_key)
    refresh()
    return {
        refresh = refresh,
        dispose = function(): unit
            if disposed then
                return
            end
            disposed = true
            expanded = false
            set_modal()
            toggle:remove_event_listener("click", on_toggle)
            wrapper:remove_event_listener("keydown", on_key)
            for _, node in nodes do
                remove_node(node)
            end
            root:remove_child(wrapper)
        end
    }
end

function start(config: Config, game: Game): Session
    local document: Document = window.document
    local body: HTMLElement = document.body
    -- Whichever element hosts the game owns the page's background and the
    -- root's sizing. A named mount that has gone missing falls back to the
    -- body rather than dropping the canvas on the floor.
    local host: Element = body
    local host_key: string = ""
    local mount_id: string? = config.mount
    if mount_id ~= nil then
        local mounted_host: Element? = document:get_element_by_id(mount_id::string)
        if mounted_host ~= nil then
            host = mounted_host::Element
            host_key = mount_id::string
        end
    end
    local owns_page: bool = host == body
    local fluid: bool = config.canvas_sizing == true
    -- A config without a viewport falls back to the browser's own space, so
    -- a fluid game never has to invent a size just to satisfy the record.
    local page_width: u32 = 1
    local page_height: u32 = 1
    if window.innerWidth > 0 then
        page_width = window.innerWidth::u32
    end
    if window.innerHeight > 0 then
        page_height = window.innerHeight::u32
    end
    local config_width: u32 = config.width or page_width
    local config_height: u32 = config.height or page_height
    if owns_page then
        -- overscroll-behavior stops a swipe that misses the canvas from
        -- rubber-banding or pull-to-refreshing the page out from under a game
        -- that fills the window. The vh pair is a fallback and its dvh
        -- successor: see the note on root_box below for what dvh buys.
        body:set_attribute(
            "style",
            "margin:0;min-height:100vh;min-height:100dvh;overflow:hidden;overscroll-behavior:none;background:" .. config.background .. ";"
        )
    end
    local surface: Surface = acquire_surface(document, host, host_key)
    local root: Element = surface.root
    root.class_name = "flex min-h-screen w-full flex-col items-center justify-center gap-2 overflow-hidden bg-slate-950 p-2 text-slate-100"
    -- A game that owns the page paints its own backdrop around the canvas. A
    -- mounted game paints nothing outside the canvas: the host's page keeps
    -- its own background, and the canvas stays a measurable box on it.
    -- Heights are dvh with a vh fallback. A mobile browser's vh is the height
    -- the page would have with the browser's own bars collapsed, so while they
    -- are showing a 100vh root is taller than the space there is: the canvas
    -- is sized from window.innerHeight and centred, so it would sit low in an
    -- oversized root with its bottom clipped away. dvh is the height that is
    -- actually there, and it follows the bars as they come and go.
    local root_box: string = "width:100vw;min-height:100vh;min-height:100dvh;padding:8px;background:" .. config.background .. ";"
    if fluid then
        root_box = "width:100vw;height:100vh;height:100dvh;padding:0;background:" .. config.background .. ";"
    end
    if not owns_page then
        root_box = "width:100%;min-height:100%;padding:0;"
    end
    root:set_attribute(
        "style",
        "box-sizing:border-box;display:flex;" .. root_box .. "align-items:center;justify-content:center;overflow:hidden;"
    )
    local heading: Element = surface.heading
    heading.class_name = "sr-only"
    heading:set_attribute(
        "style",
        "position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;"
    )
    heading.text_content = config.title

    local game_canvas: HTMLCanvasElement = surface.canvas
    game_canvas:set_attribute("tabindex", "0")
    game_canvas:set_attribute("aria-label", config.title .. " canvas")
    do
        local style: CSSStyleProperties = game_canvas.style
        style:setProperty("width", tostring(config_width) .. "px")
        style:setProperty("height", tostring(config_height) .. "px")
        if not fluid then
            style:setProperty(
                "aspect-ratio",
                tostring(config_width) .. " / " .. tostring(config_height)
            )
        end
        style:setProperty("display", "block")
        style:setProperty("background-color", config.background)
        style:setProperty("image-rendering", "pixelated")
        -- The canvas is the game, so it keeps every gesture that lands on it
        -- rather than letting the browser read one as page navigation.
        -- touch-action also retires the tap delay browsers otherwise hold to
        -- see whether a tap was the first half of a double-tap zoom; the rest
        -- suppress the text selection, callout menu and tap flash a long press
        -- on a canvas would otherwise raise.
        style:setProperty("touch-action", "none")
        style:setProperty("user-select", "none")
        style:setProperty("-webkit-user-select", "none")
        style:setProperty("-webkit-touch-callout", "none")
        style:setProperty("-webkit-tap-highlight-color", "transparent")

        -- The logical viewport is config's to begin with and the session's
        -- from then on, so a resize is what the frame loop reads next.
        sync_canvas_size(game_canvas, config_width, config_height, fluid)
        local viewport_width: u32 = config_width
        local viewport_height: u32 = config_height
        if fluid and game_canvas.clientWidth > 0 and game_canvas.clientHeight > 0 then
            viewport_width = game_canvas.clientWidth::u32
            viewport_height = game_canvas.clientHeight::u32
        end
        local viewport: {
            width: u32,
            height: u32
        } = { width = viewport_width, height = viewport_height }

        local maybe_gl: WebGL2RenderingContext? = game_canvas:get_context_webgl2()
        assert(maybe_gl ~= nil)
        local gl: WebGL2RenderingContext = maybe_gl::WebGL2RenderingContext
        local graphics: graphics_module.Graphics = graphics_module.new(
            gl,
            viewport.width::f64,
            viewport.height::f64
        )
        local input: input_module.Input = input_module.new()
        local clock: time_module.Clock = time_module.new(config.update_hz, config.max_frame_seconds)

        local function on_keydown(event: Event): unit
            -- Native controls own their keyboard behavior. Page-level canvas
            -- shortcuts apply only with the canvas or empty document focused.
            local active: Element? = document.activeElement
            if active ~= nil and active ~= body and active ~= game_canvas then
                return
            end
            if KeyboardEvent(key_event) = event then
                local was_down: bool = input:is_down(key_event.key)
                input:set_key(key_event.key, true)
                if not was_down then
                    game.keypressed(key_event.key)
                end
            end
        end
        local function on_keyup(event: Event): unit
            if KeyboardEvent(key_event) = event then
                local was_down: bool = input:is_down(key_event.key)
                input:set_key(key_event.key, false)
                if was_down then
                    local keyreleased: ((string) -> unit)? = game.keyreleased
                    if keyreleased ~= nil then
                        keyreleased(key_event.key)
                    end
                end
            end
        end
        document:add_event_listener("keydown", on_keydown)
        document:add_event_listener("keyup", on_keyup)

        -- Pointer events carry mouse, pen and touch contacts on one stream, and
        -- a PointerEvent is a MouseEvent, so one set of handlers serves every
        -- device. offsetX/offsetY are CSS pixels relative to the canvas, so
        -- scaling by the logical-to-CSS ratio lands in game coordinates no
        -- matter how the canvas is currently fitted to the viewport. DOM test
        -- hosts do no layout, so a zero clientWidth falls back to the unscaled
        -- offset.
        local function mouse_logical_x(mouse_event: MouseEvent): f64
            local css_width: f64 = game_canvas.clientWidth::f64
            if css_width <= 0.0 then
                return mouse_event.offsetX
            end
            return mouse_event.offsetX * (viewport.width::f64) / css_width
        end
        local function mouse_logical_y(mouse_event: MouseEvent): f64
            local css_height: f64 = game_canvas.clientHeight::f64
            if css_height <= 0.0 then
                return mouse_event.offsetY
            end
            return mouse_event.offsetY * (viewport.height::f64) / css_height
        end

        local function on_pointerdown(event: Event): unit
            game_canvas:focus_element()
            if MouseEvent(pointer_event) = event then
                local x: f64 = mouse_logical_x(pointer_event)
                local y: f64 = mouse_logical_y(pointer_event)
                local button: i32 = mouse_button_number(pointer_event.button)
                input:set_mouse_position(x, y)
                input:set_mouse_button(button, true)
                local mousepressed: ((f64, f64, i32) -> unit)? = game.mousepressed
                if mousepressed ~= nil then
                    mousepressed(x, y, button)
                end
            end
        end
        local function on_pointerup(event: Event): unit
            if MouseEvent(pointer_event) = event then
                local x: f64 = mouse_logical_x(pointer_event)
                local y: f64 = mouse_logical_y(pointer_event)
                local button: i32 = mouse_button_number(pointer_event.button)
                input:set_mouse_position(x, y)
                input:set_mouse_button(button, false)
                local mousereleased: ((f64, f64, i32) -> unit)? = game.mousereleased
                if mousereleased ~= nil then
                    mousereleased(x, y, button)
                end
            end
        end
        local function on_pointermove(event: Event): unit
            if MouseEvent(pointer_event) = event then
                local x: f64 = mouse_logical_x(pointer_event)
                local y: f64 = mouse_logical_y(pointer_event)
                -- Input keeps the pointer's last place, so the previous
                -- position does not need a second home just for the delta.
                local dx: f64 = x - input.mouse_x
                local dy: f64 = y - input.mouse_y
                input:set_mouse_position(x, y)
                local mousemoved: ((f64, f64, f64, f64) -> unit)? = game.mousemoved
                if mousemoved ~= nil then
                    mousemoved(x, y, dx, dy)
                end
            end
        end
        -- A cancelled gesture has no release to report — the browser took the
        -- contact away rather than the player lifting it — so the buttons are
        -- put back up without a game callback. A press that never came back up
        -- would otherwise read as held for the rest of the session.
        local function on_pointercancel(event: Event): unit
            for button = 1::i32, 3::i32 do
                input:set_mouse_button(button, false)
            end
        end
        game_canvas:add_event_listener("pointerdown", on_pointerdown)
        game_canvas:add_event_listener("pointerup", on_pointerup)
        game_canvas:add_event_listener("pointermove", on_pointermove)
        game_canvas:add_event_listener("pointercancel", on_pointercancel)

        game.load()
        local accessibility: AccessiblePanel = accessible_panel(document, root, game_canvas, game)
        local stopped: bool = false
        local frame_handle: u32 = 0
        local function frame(timestamp_ms: f64): unit
            if stopped then
                return
            end
            local canvas_changed: bool = sync_canvas_size(
                game_canvas,
                viewport.width,
                viewport.height,
                fluid
            )
            if fluid and game_canvas.clientWidth > 0 and game_canvas.clientHeight > 0 then
                local next_width: u32 = game_canvas.clientWidth::u32
                local next_height: u32 = game_canvas.clientHeight::u32
                if next_width ~= viewport.width or next_height ~= viewport.height then
                    viewport.width = next_width
                    viewport.height = next_height
                    graphics:set_logical_size(next_width::f64, next_height::f64)
                    canvas_changed = true
                end
            end
            if canvas_changed then
                graphics:resize()
            end
            local steps: i32 = clock:advance(timestamp_ms)
            for _ = 1, steps do
                game.update(clock.step, input)
                input:end_step()
            end
            graphics:set_time(timestamp_ms / 1000.0)
            game.draw(graphics, clock:alpha())
            graphics:present()
            accessibility.refresh()
            frame_handle = window:requestAnimationFrame(frame)
        end
        frame_handle = window:requestAnimationFrame(frame)

        local suspended_for_handoff: bool = false
        local function stop_session(remove_root: bool): unit
            if not stopped then
                stopped = true
                window:cancelAnimationFrame(frame_handle)
                document:remove_event_listener("keydown", on_keydown)
                document:remove_event_listener("keyup", on_keyup)
                game_canvas:remove_event_listener("pointerdown", on_pointerdown)
                game_canvas:remove_event_listener("pointerup", on_pointerup)
                game_canvas:remove_event_listener("pointermove", on_pointermove)
                game_canvas:remove_event_listener("pointercancel", on_pointercancel)
                accessibility.dispose()
                graphics:dispose()
            end
            if remove_root then
                -- stop() after suspend() may run before a replacement claims
                -- the surface, in which case this session still owns it. Once
                -- claimed, the removed marker prevents the old session from
                -- tearing down its successor's canvas.
                local still_owned: bool = not suspended_for_handoff or root:get_attribute(
                    SURFACE_HANDOFF_ATTRIBUTE
                ) == surface.generation
                local mounted_root: Element? = document:get_element_by_id(root.id)
                if still_owned then
                    graphics:release_imported_shaders()
                end
                if still_owned and mounted_root == root then
                    host:remove_child(root)
                end
            else
                suspended_for_handoff = true
                root:set_attribute(SURFACE_HANDOFF_ATTRIBUTE, surface.generation)
            end
        end
        local function resize_viewport(width: u32, height: u32): unit
            if width == viewport.width and height == viewport.height then
                return
            end
            viewport.width = width
            viewport.height = height
            style:setProperty("width", tostring(width) .. "px")
            style:setProperty("height", tostring(height) .. "px")
            style:setProperty("aspect-ratio", tostring(width) .. " / " .. tostring(height))
            graphics:set_logical_size(width::f64, height::f64)
            sync_canvas_size(game_canvas, width, height, fluid)
            graphics:resize()
        end

        return {
            stop = function(): unit
                stop_session(true)
            end,
            suspend = function(): unit
                stop_session(false)
            end,
            resize = resize_viewport
        }
    end
    error("game engine could not start")
    -- `error` never returns at runtime; this unreachable value keeps the
    -- current static return checker aware that every path has a Session.
    return {
        stop = function(): unit
        end,
        suspend = function(): unit
        end,
        resize = function(width: u32, height: u32): unit
        end
    }
end

-- Whether the person at the browser has asked for less motion. Decoration
-- that moves on its own — a drifting background, an idle shimmer — should
-- hold still for them; motion that carries meaning, a card being dealt, is not
-- what the preference is about. Read from the live media query, so a game that
-- asks each frame follows a setting changed mid-session.
function prefers_reduced_motion(): bool
    return window:matchMedia("(prefers-reduced-motion: reduce)").matches
end

return { start = start, prefers_reduced_motion = prefers_reduced_motion }
