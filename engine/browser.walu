-- The engine's DOM host: owns canvas setup, keyboard events and the animation
-- loop. This module and graphics.walu are the only ones that import DOM
-- externs, which is what keeps game code free of them.
local input_module = require("./input")
local graphics_module = require("./graphics")
local time_module = require("./time")
local window = require("dom:window")

export type Config = {
    title: string,
    -- The fixed logical viewport. Left out, the engine measures the
    -- browser's available space instead — the natural pairing with
    -- canvas_sizing, where the canvas has no one true size to be given.
    width: u32?,
    height: u32?,
    update_hz: f64,
    max_frame_seconds: f64,
    background: string,
    -- True lets the canvas occupy all space available in the browser and
    -- uses its current CSS dimensions as the game's logical viewport. Games
    -- can then derive semantic placement from that live space. Omitted keeps
    -- the fixed logical viewport above.
    canvas_sizing: bool?,
    -- The id of an element to put the game inside. A game that owns the page
    -- leaves this out and the document body hosts it; a host that already owns
    -- the page — Storybook's preview, a docs page — names its own element, and
    -- the engine then styles only what it mounted.
    mount: string?
}

export type Game = {
    load: () -> unit,
    update: (f64, input_module.Input) -> unit,
    draw: (graphics_module.Graphics, f64) -> unit,
    keypressed: (string) -> unit,
    keyreleased: ((string) -> unit)?,
    -- Mouse callbacks receive logical canvas coordinates and Love2D-style
    -- button numbers (1 = left, 2 = right, 3 = middle); mousemoved carries
    -- the move's delta in the same space.
    mousepressed: ((f64, f64, i32) -> unit)?,
    mousereleased: ((f64, f64, i32) -> unit)?,
    mousemoved: ((f64, f64, f64, f64) -> unit)?
}

-- A running browser game owns animation-frame and DOM listener registrations.
-- Development hot replacement suspends after capturing state so the old Wasm
-- instance no longer receives input or schedules frames while its canvas stays
-- mounted for the replacement handoff.
export type Session = {
    stop: () -> unit,
    -- Change the logical viewport of a running game. A host that keeps one
    -- canvas across scenes of different sizes — Storybook's preview moving
    -- between stories — resizes rather than starts over, so GPU resources
    -- built against this renderer stay valid.
    resize: (u32, u32) -> unit,
    -- Stop callbacks but leave the last rendered canvas mounted. Development
    -- hot replacement uses this while the next instance prepares its first
    -- frame, avoiding a black handoff between Wasm modules.
    suspend: () -> unit
}

-- Browsers number mouse buttons 0/1/2 = left/middle/right; game code sees
-- the Love2D-style 1/2/3 = left/right/middle numbering instead.
function mouse_button_number(dom_button: i32): i32
    if dom_button == 0 then
        return 1
    end
    if dom_button == 2 then
        return 2
    end
    if dom_button == 1 then
        return 3
    end
    return dom_button + 1
end

-- Canvas dimensions are device pixels, while CSS dimensions and game
-- coordinates are logical pixels. Keeping those spaces separate avoids the
-- browser upscaling a low-resolution WebGL buffer on high-density displays.
-- DOM test hosts do not perform layout, so fall back to the configured logical
-- size when clientWidth/clientHeight are unavailable.
function sync_canvas_size(
    canvas: HTMLCanvasElement,
    fallback_width: u32,
    fallback_height: u32,
    fluid: bool
): bool
    local inset: i32 = 16
    if fluid then
        inset = 0
    end
    local available_width: f64 = (window.innerWidth - inset)::f64
    local available_height: f64 = (window.innerHeight - inset)::f64
    if available_width < 1.0 then
        available_width = 1.0
    end
    if available_height < 1.0 then
        available_height = 1.0
    end
    local display_width: i32 = math.floor(available_width + 0.5)::i32
    local display_height: i32 = math.floor(available_height + 0.5)::i32
    if not fluid then
        local display_scale: f64 = 1.0
        local width_scale: f64 = available_width / (fallback_width::f64)
        local height_scale: f64 = available_height / (fallback_height::f64)
        if width_scale < display_scale then
            display_scale = width_scale
        end
        if height_scale < display_scale then
            display_scale = height_scale
        end
        display_width = math.floor((fallback_width::f64) * display_scale + 0.5)::i32
        display_height = math.floor((fallback_height::f64) * display_scale + 0.5)::i32
    end
    local css_width: i32 = canvas.clientWidth
    local css_height: i32 = canvas.clientHeight
    if css_width ~= display_width or css_height ~= display_height then
        local style: CSSStyleProperties = canvas.style
        style:setProperty("width", tostring(display_width) .. "px")
        style:setProperty("height", tostring(display_height) .. "px")
        css_width = canvas.clientWidth
        css_height = canvas.clientHeight
    end
    if css_width <= 0 then
        css_width = fallback_width::i32
    end
    if css_height <= 0 then
        css_height = fallback_height::i32
    end

    local pixel_ratio: f64 = window.devicePixelRatio
    if pixel_ratio <= 0.0 then
        pixel_ratio = 1.0
    end
    local pixel_width: u32 = math.floor((css_width::f64) * pixel_ratio + 0.5)::u32
    local pixel_height: u32 = math.floor((css_height::f64) * pixel_ratio + 0.5)::u32
    local changed: bool = canvas.width ~= pixel_width or canvas.height ~= pixel_height
    if changed then
        canvas.width = pixel_width
        canvas.height = pixel_height
    end
    return changed
end

function start(config: Config, game: Game): Session
    local document: Document = window.document
    local body: HTMLElement = document.body
    -- Whichever element hosts the game owns the page's background and the
    -- root's sizing. A named mount that has gone missing falls back to the
    -- body rather than dropping the canvas on the floor.
    local host: Element = body
    local mount_id: string? = config.mount
    if mount_id ~= nil then
        host = document:get_element_by_id(mount_id::string) or body
    end
    local owns_page: bool = host == body
    local fluid: bool = config.canvas_sizing == true
    -- A config without a viewport falls back to the browser's own space, so
    -- a fluid game never has to invent a size just to satisfy the record.
    local page_width: u32 = 1
    local page_height: u32 = 1
    if window.innerWidth > 0 then
        page_width = window.innerWidth::u32
    end
    if window.innerHeight > 0 then
        page_height = window.innerHeight::u32
    end
    local config_width: u32 = config.width or page_width
    local config_height: u32 = config.height or page_height
    if owns_page then
        body:set_attribute(
            "style",
            "margin:0;min-height:100vh;overflow:hidden;background:" .. config.background .. ";"
        )
    end
    local previous_root: Element? = document:get_element_by_id("walua-game")

    local root: Element = document:create_element("main")
    if previous_root == nil then
        root.id = "walua-game"
    else
        root.id = "walua-game-pending"
    end
    root.class_name = "flex min-h-screen w-full flex-col items-center justify-center gap-2 overflow-hidden bg-slate-950 p-2 text-slate-100"
    -- A game that owns the page paints its own backdrop around the canvas. A
    -- mounted game paints nothing outside the canvas: the host's page keeps
    -- its own background, and the canvas stays a measurable box on it.
    local root_box: string = "width:100vw;min-height:100vh;padding:8px;background:" .. config.background .. ";"
    if fluid then
        root_box = "width:100vw;height:100vh;padding:0;background:" .. config.background .. ";"
    end
    if not owns_page then
        root_box = "width:100%;min-height:100%;padding:0;"
    end
    root:set_attribute(
        "style",
        "box-sizing:border-box;display:flex;" .. root_box .. "align-items:center;justify-content:center;overflow:hidden;"
    )
    host:append_child(root)

    local heading: Element = document:create_element("h1")
    heading.class_name = "sr-only"
    heading:set_attribute(
        "style",
        "position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;"
    )
    heading.text_content = config.title
    root:append_child(heading)

    local element: Element = document:create_element("canvas")
    element.id = "walua-game-canvas"
    root:append_child(element)

    if HTMLCanvasElement(canvas) = element then
        -- Give the pattern-bound handle an ordinary local before capturing it
        -- in the animation-frame closure.
        local game_canvas: HTMLCanvasElement = canvas
        game_canvas.width = config_width
        game_canvas.height = config_height
        local style: CSSStyleProperties = game_canvas.style
        style:setProperty("width", tostring(config_width) .. "px")
        style:setProperty("height", tostring(config_height) .. "px")
        if not fluid then
            style:setProperty(
                "aspect-ratio",
                tostring(config_width) .. " / " .. tostring(config_height)
            )
        end
        style:setProperty("display", "block")
        style:setProperty("background-color", config.background)
        style:setProperty("image-rendering", "pixelated")

        -- The logical viewport is config's to begin with and the session's
        -- from then on, so a resize is what the frame loop reads next.
        sync_canvas_size(game_canvas, config_width, config_height, fluid)
        local viewport_width: u32 = config_width
        local viewport_height: u32 = config_height
        if fluid and game_canvas.clientWidth > 0 and game_canvas.clientHeight > 0 then
            viewport_width = game_canvas.clientWidth::u32
            viewport_height = game_canvas.clientHeight::u32
        end
        local viewport: {
            width: u32,
            height: u32
        } = { width = viewport_width, height = viewport_height }

        local maybe_gl: WebGL2RenderingContext? = game_canvas:get_context_webgl2()
        assert(maybe_gl ~= nil)
        local gl: WebGL2RenderingContext = maybe_gl::WebGL2RenderingContext
        local graphics: graphics_module.Graphics = graphics_module.new(
            gl,
            viewport.width::f64,
            viewport.height::f64
        )
        local input: input_module.Input = input_module.new()
        local clock: time_module.Clock = time_module.new(config.update_hz, config.max_frame_seconds)

        local function on_keydown(event: Event): unit
            if KeyboardEvent(key_event) = event then
                local was_down: bool = input:is_down(key_event.key)
                input:set_key(key_event.key, true)
                if not was_down then
                    game.keypressed(key_event.key)
                end
            end
        end
        local function on_keyup(event: Event): unit
            if KeyboardEvent(key_event) = event then
                local was_down: bool = input:is_down(key_event.key)
                input:set_key(key_event.key, false)
                if was_down then
                    local keyreleased: ((string) -> unit)? = game.keyreleased
                    if keyreleased ~= nil then
                        keyreleased(key_event.key)
                    end
                end
            end
        end
        document:add_event_listener("keydown", on_keydown)
        document:add_event_listener("keyup", on_keyup)

        -- offsetX/offsetY are CSS pixels relative to the canvas, so scaling
        -- by the logical-to-CSS ratio lands in game coordinates no matter how
        -- the canvas is currently fitted to the viewport. DOM test hosts do
        -- no layout, so a zero clientWidth falls back to the unscaled offset.
        local function mouse_logical_x(mouse_event: MouseEvent): f64
            local css_width: f64 = game_canvas.clientWidth::f64
            if css_width <= 0.0 then
                return mouse_event.offsetX
            end
            return mouse_event.offsetX * (viewport.width::f64) / css_width
        end
        local function mouse_logical_y(mouse_event: MouseEvent): f64
            local css_height: f64 = game_canvas.clientHeight::f64
            if css_height <= 0.0 then
                return mouse_event.offsetY
            end
            return mouse_event.offsetY * (viewport.height::f64) / css_height
        end

        local function on_mousedown(event: Event): unit
            if MouseEvent(mouse_event) = event then
                local x: f64 = mouse_logical_x(mouse_event)
                local y: f64 = mouse_logical_y(mouse_event)
                local button: i32 = mouse_button_number(mouse_event.button)
                input:set_mouse_position(x, y)
                input:set_mouse_button(button, true)
                local mousepressed: ((f64, f64, i32) -> unit)? = game.mousepressed
                if mousepressed ~= nil then
                    mousepressed(x, y, button)
                end
            end
        end
        local function on_mouseup(event: Event): unit
            if MouseEvent(mouse_event) = event then
                local x: f64 = mouse_logical_x(mouse_event)
                local y: f64 = mouse_logical_y(mouse_event)
                local button: i32 = mouse_button_number(mouse_event.button)
                input:set_mouse_position(x, y)
                input:set_mouse_button(button, false)
                local mousereleased: ((f64, f64, i32) -> unit)? = game.mousereleased
                if mousereleased ~= nil then
                    mousereleased(x, y, button)
                end
            end
        end
        local function on_mousemove(event: Event): unit
            if MouseEvent(mouse_event) = event then
                local x: f64 = mouse_logical_x(mouse_event)
                local y: f64 = mouse_logical_y(mouse_event)
                -- Input keeps the pointer's last place, so the previous
                -- position does not need a second home just for the delta.
                local dx: f64 = x - input.mouse_x
                local dy: f64 = y - input.mouse_y
                input:set_mouse_position(x, y)
                local mousemoved: ((f64, f64, f64, f64) -> unit)? = game.mousemoved
                if mousemoved ~= nil then
                    mousemoved(x, y, dx, dy)
                end
            end
        end
        game_canvas:add_event_listener("mousedown", on_mousedown)
        game_canvas:add_event_listener("mouseup", on_mouseup)
        game_canvas:add_event_listener("mousemove", on_mousemove)

        game.load()
        local stopped: bool = false
        local frame_handle: u32 = 0
        local function frame(timestamp_ms: f64): unit
            if stopped then
                return
            end
            local canvas_changed: bool = sync_canvas_size(
                game_canvas,
                viewport.width,
                viewport.height,
                fluid
            )
            if fluid and game_canvas.clientWidth > 0 and game_canvas.clientHeight > 0 then
                local next_width: u32 = game_canvas.clientWidth::u32
                local next_height: u32 = game_canvas.clientHeight::u32
                if next_width ~= viewport.width or next_height ~= viewport.height then
                    viewport.width = next_width
                    viewport.height = next_height
                    graphics:set_logical_size(next_width::f64, next_height::f64)
                    canvas_changed = true
                end
            end
            if canvas_changed then
                graphics:resize()
            end
            local steps: i32 = clock:advance(timestamp_ms)
            for _ = 1, steps do
                game.update(clock.step, input)
                input:end_step()
            end
            graphics:set_time(timestamp_ms / 1000.0)
            game.draw(graphics, clock:alpha())
            graphics:present()
            if root.id == "walua-game-pending" then
                local mounted_root: Element? = document:get_element_by_id("walua-game")
                if mounted_root ~= nil then
                    host:remove_child(mounted_root)
                end
                root.id = "walua-game"
            end
            frame_handle = window:requestAnimationFrame(frame)
        end
        frame_handle = window:requestAnimationFrame(frame)

        local function stop_session(remove_root: bool): unit
            if not stopped then
                stopped = true
                window:cancelAnimationFrame(frame_handle)
                document:remove_event_listener("keydown", on_keydown)
                document:remove_event_listener("keyup", on_keyup)
                game_canvas:remove_event_listener("mousedown", on_mousedown)
                game_canvas:remove_event_listener("mouseup", on_mouseup)
                game_canvas:remove_event_listener("mousemove", on_mousemove)
            end
            if remove_root then
                local mounted_root: Element? = document:get_element_by_id(root.id)
                if mounted_root == root then
                    host:remove_child(root)
                end
            end
        end
        local function resize_viewport(width: u32, height: u32): unit
            if width == viewport.width and height == viewport.height then
                return
            end
            viewport.width = width
            viewport.height = height
            style:setProperty("width", tostring(width) .. "px")
            style:setProperty("height", tostring(height) .. "px")
            style:setProperty("aspect-ratio", tostring(width) .. " / " .. tostring(height))
            graphics:set_logical_size(width::f64, height::f64)
            sync_canvas_size(game_canvas, width, height, fluid)
            graphics:resize()
        end

        return {
            stop = function(): unit
                stop_session(true)
            end,
            suspend = function(): unit
                stop_session(false)
            end,
            resize = resize_viewport
        }
    else
        error("game engine could not create a WebGL2 canvas")
    end
    error("game engine could not start")
    -- `error` never returns at runtime; this unreachable value keeps the
    -- current static return checker aware that every path has a Session.
    return {
        stop = function(): unit
        end,
        suspend = function(): unit
        end,
        resize = function(width: u32, height: u32): unit
        end
    }
end

return { start = start }
