-- Small keyboard and pointer state machine. It is deliberately string-keyed
-- rather than a closed enum, so a game can query any key the DOM reports
-- ("ArrowLeft", "a", "Space", ...) without an engine change. The mouse fields
-- carry whichever pointing device the player is using — browser.walu feeds
-- mouse, pen and touch contacts into them alike — using the Love2D-style
-- button numbering it translates to: 1 = left, 2 = right, 3 = middle, and a
-- finger or pen tip on button 1.
type Button = { key: string, down: bool, pressed: bool, released: bool }
export type Input = { buttons: {Button}, mouse_buttons: {Button}, mouse_x: f64, mouse_y: f64 }

function find_button(list: {Button}, key: string): i32
    for i, button in list do
        if button.key == key then
            return i
        end
    end
    return -1
end

function ensure_button(list: {Button}, key: string): i32
    local index: i32 = find_button(list, key)
    if index >= 1 then
        return index
    end
    table.insert(list, { key = key, down = false, pressed = false, released = false })
    return #list
end

function set_button(list: {Button}, key: string, down: bool): unit
    local index: i32 = ensure_button(list, key)
    local button = list[index]
    if down and not button.down then
        button.pressed = true
    elseif not down and button.down then
        button.released = true
    end
    button.down = down
end

function Input.new(): Input
    return { buttons = {}, mouse_buttons = {}, mouse_x = 0.0, mouse_y = 0.0 }
end

function Input:index_of(key: string): i32
    return find_button(self.buttons, key)
end

function Input:ensure(key: string): i32
    return ensure_button(self.buttons, key)
end

function Input:set_key(key: string, down: bool): unit
    set_button(self.buttons, key, down)
end

function Input:is_down(key: string): bool
    local index: i32 = find_button(self.buttons, key)
    return index >= 1 and self.buttons[index].down
end

function Input:was_pressed(key: string): bool
    local index: i32 = find_button(self.buttons, key)
    return index >= 1 and self.buttons[index].pressed
end

function Input:was_released(key: string): bool
    local index: i32 = find_button(self.buttons, key)
    return index >= 1 and self.buttons[index].released
end

-- The pointer's last known place, in logical canvas coordinates.
function Input:set_mouse_position(x: f64, y: f64): unit
    self.mouse_x = x
    self.mouse_y = y
end

function Input:set_mouse_button(button: i32, down: bool): unit
    set_button(self.mouse_buttons, tostring(button), down)
end

function Input:is_mouse_down(button: i32): bool
    local index: i32 = find_button(self.mouse_buttons, tostring(button))
    return index >= 1 and self.mouse_buttons[index].down
end

function Input:was_mouse_pressed(button: i32): bool
    local index: i32 = find_button(self.mouse_buttons, tostring(button))
    return index >= 1 and self.mouse_buttons[index].pressed
end

function Input:was_mouse_released(button: i32): bool
    local index: i32 = find_button(self.mouse_buttons, tostring(button))
    return index >= 1 and self.mouse_buttons[index].released
end

-- Edge transitions last until one simulation update consumes them.
function Input:end_step(): unit
    for button in self.buttons do
        button.pressed = false
        button.released = false
    end
    for button in self.mouse_buttons do
        button.pressed = false
        button.released = false
    end
end

return { new = Input.new }
