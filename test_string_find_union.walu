type StringFindResult = NotFound(unit) | Found(u32)

function test_string_find(): bool
    local haystack: string = "hello world"
    local needle: string = "world"
    
    local result: StringFindResult = string_find(haystack, needle)
    if Found(pos) = result then
        print("Found at position: " .. tostring(pos))
        return true
    end
    if NotFound(dummy) = result then
        print("Not found")
        return false
    end
    
    return false
end

assert(test_string_find())