{
  "name": "waluau-monorepo",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build:ante": "pnpm --filter ante build",
    "build:playground": "pnpm --filter playground build",
    "dev:ante": "pnpm --filter ante dev",
    "dev:game-project": "pnpm --filter ante exec vite ../../examples/game-project --config ../../examples/game-project/vite.config.mjs",
    "dev": "pnpm --filter playground dev",
    "generate:dom-externs": "node tools/dom-idl/generate-dom-externs.mjs",
    "test:dom-externs": "node --test tools/dom-idl/generate-dom-externs.test.mjs",
    "test:playground": "pnpm --filter playground test",
    "test:ante": "pnpm --filter ante test",
    "test:conformance-browser": "pnpm --filter conformance-runner test:browser",
    "test:vite-plugin": "node --test packages/vite-plugin-waluau/*.test.js"
  },
  "devDependencies": {
    "@webref/idl": "^3.80.0",
    "webidl2": "^24.5.0"
  }
}
