#!/usr/bin/env bash
set -euo pipefail

run() {
  printf '\n==> %s\n' "$1"
  shift
  "$@"
}

run "Checking formatting" pnpm format:check
run "Checking Luau pending inventory" node conformance/luau/check-pending-inventory.mjs
run "Checking compilation" cargo check --workspace --all-targets
run "Running tests" cargo test --workspace
run "Running clippy" cargo clippy --workspace --all-targets -- -D warnings
