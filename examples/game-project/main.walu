-- Minimal standalone project using only the embedded stable engine package.
local engine = require("waluau:engine")
local hot = require("waluau:engine/hot")

local x: f64 = 24.0
local session: engine.Session? = nil

local function load(): unit
end

local function update(dt: f64, input: engine.Input): unit
    if input:is_down("ArrowRight") then
        x = x + 60.0 * dt
    end
end

local function draw(graphics: engine.Graphics, alpha: f64): unit
    -- Clear old pixels so a restored position is immediately visible.
    graphics:clear("#0f172a")
    graphics:set_color("#38bdf8")
    graphics:fill_rectangle(x, 24.0, 32.0, 32.0)
    graphics:set_color("#f8fafc")
    graphics:print("WALUA ENGINE " .. engine.VERSION, 16.0, 80.0)
end

local function keypressed(key: string): unit
    if key == "d" then
        x = x + 24.0
    end
end

session = engine.start(
    {
        title = "Waluau Engine Package",
        width = 320,
        height = 180,
        update_hz = 60.0,
        max_frame_seconds = 0.25,
        background = "#0f172a"
    },
    { load = load, update = update, draw = draw, keypressed = keypressed, keyreleased = nil }
)

-- The snapshot is deliberately a self-contained string with an
-- application-owned schema marker; returning false asks Vite to fall back to
-- a full reload.
hot.register(
    {
        snapshot = function(): string
            return "moving-square:v1:" .. tostring(x)
        end,
        restore = function(snapshot: string): bool
            const prefix: string = "moving-square:v1:"
            if string.sub(snapshot, 1, #prefix) ~= prefix then
                return false
            end
            local restored: f64? = tonumber(string.sub(snapshot, #prefix + 1))
            if restored == nil then
                return false
            end
            x = restored::f64
            return true
        end,
        dispose = function(): unit
            local running: engine.Session? = session
            if running ~= nil then
                running.suspend()
                session = nil
            end
        end
    }
)
